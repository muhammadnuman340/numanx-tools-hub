    "@imgly/background-removal": "^1.7.0",
    "@splinetool/runtime": "^1.12.97",
    "@tailwindcss/vite": "^4.3.0",
    "@upscalerjs/default-model": "^1.0.0",
    "astro": "^6.4.2",
    "astro-eslint-parser": "^1.4.0",
    "bwip-js": "^4.11.4",
    "cron-parser": "^5.5.0",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "fflate": "^0.8.3",
    "googleapis": "^173.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
