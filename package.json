    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "upscaler": "^1.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "sharp": "^0.34.5",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.95.0"
