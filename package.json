    "submit:indexnow": "node scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.2.8",
