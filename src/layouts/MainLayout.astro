---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Sidebar from '../components/Sidebar.astro';
import AIAssistant from '../components/AIAssistant.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import SearchBar from '../components/SearchBar.astro';
import BackToTop from '../components/BackToTop.astro';
import Analytics from '../components/Analytics.astro';
import AdSense from '../components/AdSense.astro';
import Toast from '../components/ui/Toast.astro';
import FeedbackButton from '../components/FeedbackButton.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import ClientRouter from 'astro/components/ClientRouter.astro';

const GA_ID = import.meta.env.PUBLIC_GA_ID || '';
const ADSENSE_ID = import.meta.env.PUBLIC_ADSENSE_ID || '';

const {
  title,
  description,
  keywords,
  canonical,
  image,
  noindex,
  faq,
  breadcrumbs,
  toolSchema,
  articleSchema,
  publishedTime,
  modifiedTime,
  tags,
  type,
} = Astro.props;
---

<html lang="en" data-theme="dark">
  <head>
    <script>
      !(function () {
        var t =
          localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme:light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- ─── Resource Hints ─── -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    {ADSENSE_ID && <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />}

    <!-- ─── Font Loading: preload + stylesheet with display=optional ─── -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=optional"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=optional"
      media="print"
      onload="this.media='all'"
    />

    <SEO
      {title}
      {description}
      {keywords}
      {canonical}
      {image}
      {noindex}
      {faq}
      {breadcrumbs}
      {toolSchema}
      {articleSchema}
      {publishedTime}
      {modifiedTime}
      {tags}
      type={type}
    />

    {GA_ID && <Analytics id={GA_ID} />}
    <AdSense />

    <!-- Google Tag Manager (lazy, after interaction) -->
    <script>
      var gt = document.documentElement;
      ['touchstart', 'click', 'keydown', 'scroll'].forEach(function (e) {
        gt.addEventListener(
          e,
          function () {
            setTimeout(function () {
              var w = window,
                d = document,
                s = 'script',
                l = 'dataLayer',
                i = 'GTM-TBXFNLDB';
              w[l] = w[l] || [];
              w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
              var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s),
                dl = l != 'dataLayer' ? '&l=' + l : '';
              j.async = true;
              j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
              f.parentNode.insertBefore(j, f);
            }, 1e3);
          },
          { once: true },
        );
      });
    </script>

    <ClientRouter fallback="animate" />
    <slot name="head" />
  </head>

  <body class="antialiased selection:bg-purple-500/30 selection:text-white">
    <!-- Skip to main content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[999] focus:px-4 focus:py-2 focus:bg-purple-600 focus:text-white focus:rounded-xl focus:text-sm focus:font-semibold focus:outline-none"
    >
      Skip to main content
    </a>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TBXFNLDB"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <!-- Top Scroll Progress Bar -->
    <div
      id="scroll-progress"
      class="fixed top-0 left-0 h-[2.5px] bg-gradient-to-r from-purple-500 via-pink-500 to-blue-500 z-[300] w-0 transition-all duration-75 pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <!-- Custom Studio Cursor -->
    <div
      id="custom-cursor-dot"
      class="fixed w-1.5 h-1.5 bg-white rounded-full pointer-events-none z-[999] opacity-0 mix-blend-difference transition-opacity duration-300 hidden lg:block"
      aria-hidden="true"
    >
    </div>
    <div
      id="custom-cursor-ring"
      class="fixed w-8 h-8 border border-purple-500/30 rounded-full pointer-events-none z-[998] opacity-0 transition-opacity duration-300 hidden lg:block -translate-x-1/2 -translate-y-1/2"
      aria-hidden="true"
    >
    </div>

    <!-- Ambient Background -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div
        class="absolute -top-48 -left-48 w-[500px] h-[500px] rounded-full bg-purple-600/8 blur-[120px] animate-[breathe_8s_ease-in-out_infinite]"
      >
      </div>
      <div
        class="absolute -bottom-48 -right-48 w-[600px] h-[600px] rounded-full bg-blue-600/6 blur-[140px] animate-[breathe_12s_ease-in-out_2s_infinite]"
      >
      </div>
      <div
        class="absolute top-1/3 left-2/3 w-[400px] h-[400px] rounded-full bg-emerald-500/4 blur-[100px] animate-[breathe_10s_ease-in-out_4s_infinite]"
      >
      </div>
      <div
        class="absolute top-2/3 right-1/4 w-[300px] h-[300px] rounded-full bg-amber-500/3 blur-[80px] animate-[breathe_15s_ease-in-out_1s_infinite]"
      >
      </div>
      <div
        class="absolute inset-0 bg-[image:repeating-linear-gradient(0deg,transparent,transparent_40px,rgba(255,255,255,0.012)_40px,rgba(255,255,255,0.012)_41px),repeating-linear-gradient(90deg,transparent,transparent_40px,rgba(255,255,255,0.012)_40px,rgba(255,255,255,0.012)_41px)]"
      >
      </div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_30%,rgba(0,0,0,0.3)_100%)]"></div>
    </div>

    <Navbar />
    <Sidebar />
    <div id="main-content" class="sidebar-content transition-all duration-300" transition:animate="slide">
      <slot />
    </div>
    <Footer />
    <BackToTop />
    <FeedbackButton />
    <SearchBar />
    <Toast />
    <InstallPrompt />
    <AIAssistant />

    <script>
      // 1. Scroll Progress
      (function () {
        var p = document.getElementById('scroll-progress');
        if (p)
          window.addEventListener(
            'scroll',
            function () {
              var s = window.scrollY,
                h = document.documentElement.scrollHeight - window.innerHeight;
              p.style.width = (h > 0 ? (s / h) * 100 : 0) + '%';
            },
            { passive: true },
          );
      })();

      // 2. Custom Cursor & Spotlight Glow
      (function () {
        if (!window.matchMedia('(min-width:1024px)').matches) return;
        var d = document.getElementById('custom-cursor-dot'),
          r = document.getElementById('custom-cursor-ring');
        
        var mx = 0, my = 0, rx = 0, ry = 0, v = false;
        
        // Add interactive morphing style to ring
        var style = document.createElement('style');
        style.innerHTML = `
          .cursor-hover #custom-cursor-ring {
            transform: translate(-50%, -50%) scale(1.5);
            background-color: rgba(168, 85, 247, 0.1);
            border-color: rgba(168, 85, 247, 0.8);
          }
        `;
        document.head.appendChild(style);

        window.addEventListener(
          'mousemove',
          function (e) {
            mx = e.clientX;
            my = e.clientY;
            
            // Spotlight glow effect for cards globally
            document.querySelectorAll('.card-glow').forEach(function(card) {
              var rect = card.getBoundingClientRect();
              var x = e.clientX - rect.left;
              var y = e.clientY - rect.top;
              (card as HTMLElement).style.setProperty('--mouse-x', x + 'px');
              (card as HTMLElement).style.setProperty('--mouse-y', y + 'px');
            });

            if (d && r) {
              d.style.transform = 'translate(' + mx + 'px,' + my + 'px)';
              if (!v) {
                v = true;
                d.style.opacity = '1';
                r.style.opacity = '1';
              }
            }
          },
          { passive: true },
        );

        // Hover effect for interactive elements
        var interactiveSelectors = 'a, button, .hover-scale, .card-glow, input, select, textarea, [tabindex="0"]';
        function setupCursorHovers() {
          document.querySelectorAll(interactiveSelectors).forEach(function(el) {
            el.addEventListener('mouseenter', function() { document.body.classList.add('cursor-hover'); });
            el.addEventListener('mouseleave', function() { document.body.classList.remove('cursor-hover'); });
          });
        }
        setupCursorHovers();
        document.addEventListener('astro:page-load', setupCursorHovers);

        if (d && r) {
          !(function t() {
            rx += (mx - rx) * 0.12;
            ry += (my - ry) * 0.12;
            r.style.left = rx + 'px';
            r.style.top = ry + 'px';
            requestAnimationFrame(t);
          })();
        }
      })();

      if ('serviceWorker' in navigator)
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });

      // 3. Lazy loading and Scroll Reveal Observer
      (function () {
        if ('IntersectionObserver' in window) {
          document.querySelectorAll('[data-lazy]').forEach(function (el) {
            new IntersectionObserver(
              function (entries, observer) {
                entries.forEach(function (e) {
                  if (e.isIntersecting) {
                    (el as HTMLImageElement).src = (el as HTMLImageElement).dataset.src || '';
                    el.removeAttribute('data-lazy');
                    observer.disconnect();
                  }
                });
              },
              { rootMargin: '200px' },
            ).observe(el);
          });

          // Scroll Reveal Animations
          var revealObserver = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
              }
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

          function setupReveals() {
            document.querySelectorAll('.reveal').forEach(function(el) {
              revealObserver.observe(el);
            });
          }
          setupReveals();
          document.addEventListener('astro:page-load', setupReveals);
        }
      })();
    </script>
  </body>
</html>
