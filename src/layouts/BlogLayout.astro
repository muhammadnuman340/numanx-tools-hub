---
import MainLayout from './MainLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import PopularPosts from '../components/PopularPosts.astro';
import AdUnit from '../components/AdUnit.astro';
import MonetizationSlot from '../components/MonetizationSlot.astro';
import { getToolBySlug } from '../data/tools';
import { usableOgImage } from '../lib/ogImage';
import fs from 'node:fs';
import path from 'node:path';

const { frontmatter } = Astro.props;
const { title, description, date, updated, author, category, tags, readingTime, slug, image } = frontmatter;

// Section from the URL, so guides and comparisons don't say "Blog".
const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const sectionKey = pathParts[0] || 'blog';
const section =
  sectionKey === 'guides'
    ? { name: 'Guides', url: '/guides/', back: 'All guides' }
    : sectionKey === 'comparisons'
      ? { name: 'Comparisons', url: '/comparisons/', back: 'All comparisons' }
      : { name: 'Blog', url: '/blog/', back: 'All articles' };
const pageSlug = pathParts[pathParts.length - 1] || slug || '';

// PNG share card made by scripts/make-og-images.mjs, then the post's own image (if not SVG),
// then the site default (in SEO.astro).
const ogCardFile = path.resolve(process.cwd(), 'public', 'images', 'og', `${pageSlug}.png`);
const hasOgCard = fs.existsSync(ogCardFile);
if (!hasOgCard) console.warn(`[BlogLayout] No share card for "${pageSlug}". Run: node scripts/make-og-images.mjs`);
const ogImage = usableOgImage(hasOgCard ? `/images/og/${pageSlug}.png` : undefined, image);

const authorName = author || 'Muhammad Numan Usmani';
const authorIsPerson = /numan usmani/i.test(authorName);
const modified = updated || date;
const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const articleSchema = {
  '@type': 'Article',
  headline: title,
  description: description,
  author: authorIsPerson
    ? { '@type': 'Person', name: authorName, url: 'https://toolshub.numanxstudio.com/about/' }
    : { '@type': 'Organization', name: authorName, url: 'https://toolshub.numanxstudio.com/' },
  datePublished: date,
  dateModified: modified,
  ...(ogImage ? { image: ogImage } : {}),
  publisher: { '@type': 'Organization', name: 'NumanX Tools' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
  keywords: (tags || []).join(', '),
};

// Pick the tool that best fits the post; names and descriptions come from the registry.
// Whole words only, checked in order: URL slug, tags, title, description.
const TOOL_MATCHES: Array<{ words: string[]; slug: string }> = [
  { words: ['cricket', 'run rate'], slug: 'run-rate-calculator' },
  { words: ['youtube'], slug: 'youtube-title-generator' },
  { words: ['hashtag', 'instagram', 'tiktok', 'viral'], slug: 'hashtag-generator' },
  { words: ['password', 'passphrase', 'cybersecurity', '2fa'], slug: 'password-generator' },
  { words: ['qr', 'qr code', 'rmqr', 'barcode'], slug: 'qr-generator' },
  { words: ['resize', 'resizing', 'resizer', 'image size', 'dimension', 'crop', 'aspect ratio'], slug: 'image-resizer' },
  { words: ['compress', 'compression', 'compressor', 'optimize', 'optimise', 'optimization', 'file size'], slug: 'image-compressor' },
  { words: ['webp'], slug: 'png-to-webp' },
  { words: ['png', 'jpg', 'jpeg', 'image format'], slug: 'jpg-to-png' },
  { words: ['age calculator', 'birthday', 'zodiac'], slug: 'age-calculator' },
  { words: ['writing', 'copywriting', 'grammar'], slug: 'ai-grammar-checker' },
  { words: ['word count', 'readability'], slug: 'word-counter' },
  { words: ['markdown', 'readme'], slug: 'markdown-editor' },
  { words: ['ai', 'students'], slug: 'ai-text-summarizer' },
];
const wordsRe = (words: string[]) =>
  new RegExp(`\\b(?:${words.map((w) => w.replace(/ /g, '[\\s-]')).join('|')})s?\\b`, 'i');
const toolRules = TOOL_MATCHES.map((t) => ({ re: wordsRe(t.words), slug: t.slug }));
const matchFields = [pageSlug, (tags || []).join(', '), title || '', description || ''];
let matchedSlug = 'image-compressor';
for (const field of matchFields) {
  const hit = toolRules.find((r) => r.re.test(field));
  if (hit) {
    matchedSlug = hit.slug;
    break;
  }
}
const registryTool = getToolBySlug(matchedSlug);
const matchedTool = {
  slug: matchedSlug,
  name: registryTool?.name || 'Image Compressor',
  desc: registryTool?.description || 'Make image files smaller in your browser.',
};
---

<MainLayout
  title={`${title} | NumanX`}
  description={description}
  keywords={(tags || []).join(', ')}
  canonical={Astro.url.href}
  image={ogImage}
  type="article"
  articleSchema={articleSchema}
  publishedTime={date}
  modifiedTime={modified}
  tags={tags || []}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: section.name, url: section.url },
    { name: title, url: Astro.url.pathname },
  ]}
>
  <!-- Reading progress indicator -->
  <div class="sticky top-[56px] left-0 w-full h-[2px] bg-white/[0.05] z-40">
    <div id="progress-bar" class="h-full w-0 transition-all duration-75 bg-amber-500">
    </div>
  </div>
  <main class="min-h-screen pt-8 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-6xl mx-auto">
      <div class="flex gap-8">
        <article class="flex-1 min-w-0 max-w-3xl">
          <!-- Proper Breadcrumb Navigation -->
          <nav aria-label="Breadcrumb" class="mb-6 space-y-2">
            <ol class="flex items-center gap-1.5 text-xs sm:text-sm text-zinc-400">
              <li>
                <a href="/" class="inline-flex min-h-6 items-center hover:text-white transition-colors">Home</a>
              </li>
              <li class="text-zinc-600 select-none" aria-hidden="true">&gt;</li>
              <li>
                <a href={section.url} class="inline-flex min-h-6 items-center hover:text-white transition-colors">{section.name}</a>
              </li>
              <li class="text-zinc-600 select-none" aria-hidden="true">&gt;</li>
              <li class="text-zinc-200 font-semibold truncate max-w-[200px] sm:max-w-xs" aria-current="page">
                {title}
              </li>
            </ol>
            <div class="flex items-center gap-3">
              <a
                href={section.url}
                class="inline-flex items-center gap-1.5 min-h-6 text-xs sm:text-sm font-medium text-zinc-300 hover:text-white transition-colors"
              >
                <span aria-hidden="true">&larr;</span>
                <span>{section.back}</span>
              </a>
              {
                category && (
                  <>
                    <span class="text-zinc-600" aria-hidden="true">·</span>
                    {sectionKey === 'blog' ? (
                      <a
                        href={`/blog/?category=${encodeURIComponent(category)}`}
                        class="inline-flex min-h-6 items-center text-xs font-mono uppercase tracking-wider text-zinc-400 hover:text-amber-300 transition-colors"
                      >
                        {category}
                      </a>
                    ) : (
                      <span class="text-xs font-mono uppercase tracking-wider text-zinc-400">{category}</span>
                    )}
                  </>
                )
              }
            </div>
          </nav>

          <h1 class="text-[length:var(--step-3)] font-bold tracking-[-0.02em] leading-tight text-primary mb-4 max-w-[30ch]">
            {title}
          </h1>

          <p class="text-lg text-secondary max-w-[68ch] leading-relaxed mb-6">
            {description}
          </p>

          <div class="flex items-center gap-3 pb-6 border-b border-surface mb-8">
            {
              authorIsPerson ? (
                <img
                  src="/images/author-numan.webp"
                  alt=""
                  width="40"
                  height="40"
                  class="w-10 h-10 rounded-full object-cover shrink-0 bg-surface-2"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span
                  class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-accent-fg shrink-0 bg-amber-500"
                  aria-hidden="true"
                >
                  N
                </span>
              )
            }
            <div>
              <p class="text-sm font-medium text-primary">
                By {authorIsPerson ? <a href="/about/" class="hover:text-amber-300 underline-offset-2 hover:underline">{authorName}</a> : authorName}
              </p>
              <p class="text-xs text-zinc-400">
                <time datetime={date}>{formatDate(date)}</time>
                {
                  updated && updated !== date && (
                    <>
                      <span class="mx-1.5" aria-hidden="true">·</span>Updated <time datetime={updated}>{formatDate(updated)}</time>
                    </>
                  )
                }
                <span class="mx-1.5" aria-hidden="true">·</span>
                {readingTime || '5 min read'}
              </p>
            </div>
          </div>

          <div
            class="prose prose-invert prose-lg max-w-[68ch]
            prose-headings:text-white prose-headings:font-bold prose-headings:tracking-tight
            prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-5 prose-h2:scroll-mt-24
            prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3 prose-h3:scroll-mt-24
            prose-p:text-secondary prose-p:leading-relaxed prose-p:mb-5
            prose-a:text-amber-400 prose-a:no-underline hover:prose-a:text-amber-300 prose-a:transition-colors
            prose-strong:text-primary prose-strong:font-semibold
            prose-ul:text-secondary prose-ul:leading-relaxed prose-ul:space-y-2 prose-ul:list-disc prose-ul:pl-6
            prose-ol:text-secondary prose-ol:leading-relaxed prose-ol:space-y-2 prose-ol:list-decimal prose-ol:pl-6
            prose-li:my-1 prose-li:text-slate-300
            prose-li::marker:text-amber-500
            prose-blockquote:border-l-4 prose-blockquote:border-amber-500 prose-blockquote:bg-amber-600/10 prose-blockquote:py-3 prose-blockquote:px-6 prose-blockquote:rounded-r-xl prose-blockquote:text-secondary prose-blockquote:not-italic
            prose-code:text-amber-300 prose-code:bg-surface-2 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-sm
            prose-pre:bg-surface-1 prose-pre:border prose-pre:border-surface prose-pre:rounded-xl prose-pre:shadow-xl
            prose-img:rounded-xl prose-img:border prose-img:border-surface
            prose-hr:border-surface prose-hr:my-12
            prose-table:w-full prose-table:border-collapse prose-table:my-8 prose-table:text-sm
            prose-th:text-white prose-th:bg-white/[0.03] prose-th:font-semibold prose-th:text-left prose-th:px-4 prose-th:py-3 prose-th:border-b-2 prose-th:border-white/10
            prose-td:px-4 prose-td:py-3 prose-td:text-slate-400 prose-td:border-b prose-td:border-white/5
            hover:prose-tr:td:text-white hover:prose-tr:bg-white/[0.01]"
          >
            <slot />
          </div>

          <aside class="my-10 max-w-[68ch] p-6 rounded-xl border border-amber-500/30 bg-surface-1" aria-label="Related tool">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5">
              <div class="space-y-1.5">
                <p class="text-xs font-mono uppercase tracking-wider text-amber-300">Try it</p>
                <h2 class="text-lg font-bold text-white tracking-tight">{matchedTool.name}</h2>
                <p class="text-sm text-zinc-300 leading-relaxed">
                  {matchedTool.desc} Free, and it runs in your browser.
                </p>
              </div>
              <a
                href={`/tools/${matchedTool.slug}/`}
                class="shrink-0 inline-flex items-center justify-center gap-2 min-h-11 px-5 rounded-lg text-accent-fg font-semibold text-sm bg-amber-500 hover:bg-amber-400 transition-colors"
              >
                Open {matchedTool.name}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </aside>

          {
            (tags || []).length > 0 && (
              <div class="mt-12 pt-8 border-t border-surface">
                <p class="sr-only">Tags</p>
                <ul class="flex flex-wrap gap-2">
                  {(tags || []).map((tag: string) => (
                    <li class="px-3 py-1.5 rounded-lg bg-surface-2 border border-surface-2 text-xs text-secondary font-medium">{tag}</li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="mt-10 flex items-center justify-between p-5 rounded-xl border border-surface bg-surface-1">
            <div class="flex items-center gap-3">
              {
                authorIsPerson ? (
                  <img
                    src="/images/author-numan.webp"
                    alt=""
                    width="40"
                    height="40"
                    class="w-10 h-10 rounded-full object-cover shrink-0 bg-surface-2"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span
                    class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-accent-fg shrink-0 bg-amber-500"
                    aria-hidden="true"
                  >
                    N
                  </span>
                )
              }
              <div>
                <p class="text-sm font-medium text-primary">{authorName}</p>
                <p class="text-xs text-zinc-400">Share this {sectionKey === 'guides' ? 'guide' : 'article'}</p>
              </div>
            </div>
            <div class="flex gap-2">
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2.5 rounded-lg bg-surface-2 border border-surface-2 text-tertiary hover:text-white hover:bg-surface-3 transition-all duration-200"
                title="Share on Twitter"
                aria-label="Share on Twitter"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                  ><path
                    d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"
                  ></path></svg
                >
              </a>
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2.5 rounded-lg bg-surface-2 border border-surface-2 text-tertiary hover:text-white hover:bg-surface-3 transition-all duration-200"
                title="Share on LinkedIn"
                aria-label="Share on LinkedIn"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                  ><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect
                    x="2"
                    y="9"
                    width="4"
                    height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg
                >
              </a>
              <button
                type="button"
                id="copy-link-btn"
                class="p-2.5 rounded-lg bg-surface-2 border border-surface-2 text-tertiary hover:text-white hover:bg-surface-3 transition-all duration-200"
                title="Copy link"
                aria-label="Copy link to clipboard"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                  ><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path
                    d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg
                >
              </button>
            </div>
          </div>

          <!-- Post-Article Contextual Partner Offer & Support Bar -->
          <div class="my-8 space-y-4">
            <MonetizationSlot
              slotType="post-tool-affiliate"
              category={category ? (category.toLowerCase().includes('cricket') ? 'cricket' : category.toLowerCase().includes('image') ? 'image' : category.toLowerCase().includes('creator') ? 'creator' : category.toLowerCase().includes('dev') ? 'developer' : category.toLowerCase().includes('ai') ? 'ai' : 'utility') : 'utility'}
            />
            <MonetizationSlot slotType="pakistan-support-bar" />
          </div>

          <RelatedPosts currentSlug={slug || ''} category={category} tags={tags} />

          <div class="mt-10 text-center">
            <a
              href={section.url}
              class="inline-flex items-center gap-2 min-h-6 text-sm text-zinc-400 hover:text-amber-300 transition-colors font-medium"
            >
              <span aria-hidden="true">&larr;</span>
              {section.back}
            </a>
          </div>
        </article>

        <aside class="hidden lg:block w-56 shrink-0">
          <div class="mb-6 p-4 rounded-xl border border-surface bg-surface-1">
            <p class="text-xs font-mono uppercase tracking-wider text-amber-300 mb-2">Try it</p>
            <p class="text-sm font-bold text-white mb-1 leading-snug">{matchedTool.name}</p>
            <p class="text-xs text-zinc-400 mb-3 leading-relaxed">{matchedTool.desc}</p>
            <a
              href={`/tools/${matchedTool.slug}/`}
              class="flex items-center justify-center w-full min-h-9 px-3 text-xs font-semibold rounded-lg bg-amber-500 hover:bg-amber-400 text-accent-fg transition-colors"
            >
              Open tool <span aria-hidden="true" class="ml-1">→</span>
            </a>
          </div>

          <TableOfContents />
          <PopularPosts />
          <div class="mt-6 sticky top-24">
            <AdUnit format="vertical" />
          </div>
        </aside>
      </div>
    </div>
  </main>
</MainLayout>

<script>
  // Reading progress and copy link. Bound per page because the site uses ClientRouter.
  const COPY_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`;
  const DONE_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;

  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();
    const bar = document.getElementById('progress-bar');
    const btn = document.getElementById('copy-link-btn');
    if (!bar && !btn) return;

    const onScroll = () => {
      const el = document.documentElement;
      const height = el.scrollHeight - el.clientHeight;
      if (bar) bar.style.width = (height > 0 ? (el.scrollTop / height) * 100 : 0) + '%';
    };
    const onCopy = async () => {
      if (!btn) return;
      try {
        await navigator.clipboard.writeText(window.location.href);
        btn.innerHTML = DONE_ICON;
        btn.setAttribute('aria-label', 'Link copied');
        btn.classList.add('text-emerald-400');
        setTimeout(() => {
          btn.innerHTML = COPY_ICON;
          btn.setAttribute('aria-label', 'Copy link to clipboard');
          btn.classList.remove('text-emerald-400');
        }, 2000);
      } catch {}
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    btn?.addEventListener('click', onCopy);
    onScroll();
    cleanup = () => {
      window.removeEventListener('scroll', onScroll);
      btn?.removeEventListener('click', onCopy);
      cleanup = null;
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>
