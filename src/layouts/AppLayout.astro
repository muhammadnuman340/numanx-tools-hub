---
import '../styles/global.css';
import GodTierDock from '../components/GodTierDock.astro';
import Footer from '../components/Footer.astro';
import AppSEO from '../components/AppSEO.astro';
import { getAppBySlug } from '../data/appsData';

interface Props {
  appSlug: string;
}

const { appSlug } = Astro.props;
const appData = getAppBySlug(appSlug);

if (!appData) {
  throw new Error(`[AppLayout] Critical Error: Metadata not found for slug "${appSlug}"`);
}
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <AppSEO metadata={appData} />
  </head>
  <body class="bg-[#050505] text-white antialiased min-h-screen flex flex-col selection:bg-purple-500/30">
    
    <!-- Sticky Navigation Header (Mocked or existing GodTierDock) -->
    <header class="sticky top-0 z-[100] w-full border-b border-white/5 bg-[#050505]/80 backdrop-blur-xl">
      <GodTierDock />
    </header>

    <!-- Main Content Viewport -->
    <main class="flex-grow flex flex-col items-center justify-start w-full relative pt-12 pb-24 px-4 sm:px-6 lg:px-8">
      
      <!-- Hero Section from Metadata -->
      <section class="text-center w-full max-w-4xl mx-auto mb-12">
        <h1 class="text-4xl md:text-6xl font-black tracking-tight bg-gradient-to-br from-white to-zinc-500 bg-clip-text text-transparent mb-4">
          {appData.h1}
        </h1>
        <p class="text-lg text-zinc-400 max-w-2xl mx-auto">
          {appData.tagline}
        </p>
      </section>

      <!-- Dynamic App Mount Point (Slot) -->
      <div class="w-full max-w-6xl mx-auto">
        <slot />
      </div>

      <!-- Conditional FAQ Section -->
      {appData.faqs && appData.faqs.length > 0 && (
        <section class="w-full max-w-4xl mx-auto mt-24">
          <div class="mb-10 text-center">
            <h2 class="text-3xl font-bold text-white mb-3">Frequently Asked Questions</h2>
            <div class="w-16 h-1 bg-purple-500 rounded-full mx-auto"></div>
          </div>
          
          <div class="space-y-4">
            {appData.faqs.map((faq, index) => (
              <details class="group rounded-2xl border border-white/5 bg-white/[0.02] overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white transition-colors hover:bg-white/[0.02]">
                  {faq.question}
                  <span class="transition duration-300 group-open:-rotate-180">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-purple-400">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </span>
                </summary>
                <div class="p-6 pt-0 text-zinc-400 leading-relaxed border-t border-white/5 bg-white/[0.01]">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

    </main>

    <!-- Global Footer -->
    <Footer />
  </body>
</html>
