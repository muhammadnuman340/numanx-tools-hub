---
// Footer.astro
---

<footer id="god-tier-footer" class="relative z-10 w-full overflow-hidden pb-24 sm:pb-32 mt-32 group">
  <!-- Mouse Tracking Spotlight -->
  <div
    class="pointer-events-none absolute inset-0 z-0 transition duration-300 opacity-0 group-hover:opacity-100"
    style="background: radial-gradient(600px circle at var(--mouse-x) var(--mouse-y), rgba(168, 85, 247, 0.15), transparent 40%);"
  >
  </div>

  <!-- Massive Background Glow for Footer -->
  <div class="absolute inset-0 pointer-events-none z-0" aria-hidden="true">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[1px] bg-gradient-to-r from-transparent via-purple-500/30 to-transparent"
    >
    </div>
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[60%] h-[500px] bg-purple-900/10 blur-[120px] rounded-full mix-blend-screen"
    >
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-16 pb-8 relative z-10">
    <!-- Animated Glowing Border Wrapper -->
    <div class="relative rounded-3xl p-[1px] overflow-hidden">
      <!-- Rotating Gradient Border -->
      <div
        class="absolute inset-0 bg-[linear-gradient(45deg,transparent_25%,rgba(168,85,247,0.3)_50%,transparent_75%,transparent_100%)] bg-[length:250%_250%,100%_100%] animate-[bg-spin_3s_linear_infinite] opacity-50 z-0"
      >
      </div>

      <!-- Inner Glassmorphic Container -->
      <div class="relative bg-black/60 backdrop-blur-3xl rounded-3xl p-8 sm:p-12 border border-white/5 z-10">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 sm:gap-16 border-b border-white/5 pb-16">
          <!-- Brand Column -->
          <div class="col-span-2 md:col-span-1">
            <a href="/" class="group/brand relative inline-block" aria-label="NumanX Tools Homepage">
              <span
                class="text-2xl font-black tracking-tighter bg-gradient-to-r from-white via-purple-200 to-white bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(255,255,255,0.3)]"
                >NumanX Tools</span
              >
              <div
                class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gradient-to-r from-purple-400 to-amber-400 group-hover/brand:w-full transition-all duration-300"
              >
              </div>
            </a>
            <p class="mt-3 text-xs text-zinc-400 font-semibold tracking-wide">
              Powered by <span class="text-purple-400">NumanX Studio</span>
            </p>
            <p class="mt-4 text-sm text-zinc-400 leading-relaxed max-w-xs font-medium">
              Free online tools for creators, students, and developers. Privacy-first, serverless, and always free.
            </p>

            <!-- Social Icons -->
            <div class="flex items-center gap-3 mt-8">
              <a
                href="https://github.com/muhammadnuman340/numanx-tools-hub"
                target="_blank"
                rel="noopener noreferrer"
                class="group/social flex items-center justify-center w-10 h-10 rounded-xl bg-white/5 border border-white/10 text-zinc-400 hover:text-white hover:bg-white/10 hover:border-white/20 hover:shadow-[0_0_20px_rgba(168,85,247,0.3)] transition-all duration-300"
                aria-label="GitHub Repository"
              >
                <span class="sr-only">GitHub</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="group-hover/social:-translate-y-1 transition-transform duration-300"
                  ><path
                    d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                  ></path></svg
                >
              </a>
              <a
                href="https://x.com/numanxstudio"
                target="_blank"
                rel="noopener noreferrer"
                class="group/social flex items-center justify-center w-10 h-10 rounded-xl bg-white/5 border border-white/10 text-zinc-400 hover:text-white hover:bg-white/10 hover:border-white/20 hover:shadow-[0_0_20px_rgba(168,85,247,0.3)] transition-all duration-300"
                aria-label="X (formerly Twitter)"
              >
                <span class="sr-only">X (formerly Twitter)</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="group-hover/social:-translate-y-1 transition-transform duration-300"
                  ><path
                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                  ></path></svg
                >
              </a>
              <a
                href="https://instagram.com/numanxstudio"
                target="_blank"
                rel="noopener noreferrer"
                class="group/social flex items-center justify-center w-10 h-10 rounded-xl bg-white/5 border border-white/10 text-zinc-400 hover:text-white hover:bg-white/10 hover:border-white/20 hover:shadow-[0_0_20px_rgba(168,85,247,0.3)] transition-all duration-300"
                aria-label="Instagram"
              >
                <span class="sr-only">Instagram</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="group-hover/social:-translate-y-1 transition-transform duration-300"
                  ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path
                    d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line
                    x1="17.5"
                    y1="6.5"
                    x2="17.51"
                    y2="6.5"></line></svg
                >
              </a>
              <a
                href="https://youtube.com/@numanxstudio"
                target="_blank"
                rel="noopener noreferrer"
                class="group/social flex items-center justify-center w-10 h-10 rounded-xl bg-white/5 border border-white/10 text-zinc-400 hover:text-white hover:bg-white/10 hover:border-white/20 hover:shadow-[0_0_20px_rgba(255,0,0,0.3)] transition-all duration-300"
                aria-label="YouTube"
              >
                <span class="sr-only">YouTube</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="group-hover/social:-translate-y-1 transition-transform duration-300"
                  ><path
                    d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                  ></path></svg
                >
              </a>
              <a
                href="https://tiktok.com/@numanxstudio"
                target="_blank"
                rel="noopener noreferrer"
                class="group/social flex items-center justify-center w-10 h-10 rounded-xl bg-white/5 border border-white/10 text-zinc-400 hover:text-white hover:bg-white/10 hover:border-white/20 hover:shadow-[0_0_20px_rgba(255,0,80,0.3)] transition-all duration-300"
                aria-label="TikTok"
              >
                <span class="sr-only">TikTok</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="group-hover/social:-translate-y-1 transition-transform duration-300"
                  ><path
                    d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"
                  ></path></svg
                >
              </a>
              <a
                href="https://facebook.com/numanxstudio"
                target="_blank"
                rel="noopener noreferrer"
                class="group/social flex items-center justify-center w-10 h-10 rounded-xl bg-white/5 border border-white/10 text-zinc-400 hover:text-white hover:bg-white/10 hover:border-white/20 hover:shadow-[0_0_20px_rgba(24,119,242,0.3)] transition-all duration-300"
                aria-label="Facebook"
              >
                <span class="sr-only">Facebook</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="group-hover/social:-translate-y-1 transition-transform duration-300"
                  ><path
                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                  ></path></svg
                >
              </a>
            </div>
          </div>

          <!-- Tools Navigation -->
          <nav aria-label="Tools">
            <h2 class="text-xs font-bold text-white uppercase tracking-[0.15em] mb-6">Tools</h2>
            <ul class="space-y-3.5 relative z-20">
              <li>
                <a
                  href="/tools/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">All Tools</a
                >
              </li>
              <li>
                <a
                  href="/category/image-tools/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">Image Tools</a
                >
              </li>
              <li>
                <a
                  href="/category/creator-tools/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">Creator Tools</a
                >
              </li>
              <li>
                <a
                  href="/category/utility-tools/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">Utility Tools</a
                >
              </li>
              <li>
                <a
                  href="/category/cricket-tools/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">Cricket Tools</a
                >
              </li>
              <li>
                <a
                  href="/category/ai-tools/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">AI Tools</a
                >
              </li>
              <li>
                <a
                  href="/category/developer-tools/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">Developer Tools</a
                >
              </li>
            </ul>
          </nav>

          <!-- Resources -->
          <nav aria-label="Resources">
            <h2 class="text-xs font-bold text-white uppercase tracking-[0.15em] mb-6">Resources</h2>
            <ul class="space-y-3.5 relative z-20">
              <li>
                <a
                  href="/blog/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">Blog</a
                >
              </li>
              <li>
                <a
                  href="/dashboard/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">Dashboard</a
                >
              </li>
              <li>
                <a
                  href="/search/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">Search</a
                >
              </li>
              <li>
                <a
                  href="/favorites/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">Favorites</a
                >
              </li>
            </ul>
          </nav>

          <!-- Company -->
          <nav aria-label="Company">
            <h2 class="text-xs font-bold text-white uppercase tracking-[0.15em] mb-6">Company</h2>
            <ul class="space-y-3.5 relative z-20">
              <li>
                <a
                  href="/about/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">About</a
                >
              </li>
              <li>
                <a
                  href="/contact/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">Contact</a
                >
              </li>
              <li>
                <a
                  href="/privacy-policy/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">Privacy Policy</a
                >
              </li>
              <li>
                <a
                  href="/terms-of-service/"
                  data-astro-prefetch
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors">Terms of Service</a
                >
              </li>
              <li>
                <button
                  type="button"
                  id="open-cookie-settings"
                  class="inline-flex items-center min-h-6 text-sm font-medium text-zinc-400 hover:text-purple-300 transition-colors cursor-pointer text-left focus:outline-none focus:text-purple-300"
                  aria-label="Open cookie preferences and consent settings"
                >
                  Cookie Settings
                </button>
              </li>
            </ul>
          </nav>
        </div>

        <!-- Sub-footer -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-zinc-400 font-medium tracking-wide">
            &copy; {new Date().getFullYear()}
            <span class="text-white font-semibold">NumanX Studio</span>. All rights reserved.
          </p>
          <div class="flex items-center gap-6 text-xs font-medium text-zinc-400 tracking-wider">
            <span>BUILD.</span>
            <span>CREATE.</span>
            <span class="text-purple-400">ANALYZE.</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- The Massive "NUMANX" Typography at the bottom with breathing animation -->
  <div class="w-full flex items-center justify-center mt-12 px-4 overflow-hidden select-none pointer-events-none">
    <div
      aria-hidden="true"
      role="presentation"
      class="text-[18vw] leading-none font-black tracking-tighter bg-gradient-to-b from-white/10 via-purple-500/10 to-transparent bg-clip-text text-transparent transform translate-y-12 animate-[pulse_4s_ease-in-out_infinite] blur-[1px]"
    >
      NUMANX
    </div>
  </div>
</footer>

<style>
  @keyframes bg-spin {
    to {
      background-position: 200% center;
    }
  }
</style>

<script is:inline>
  // Mouse tracking spotlight effect and Cookie Settings handler
  document.addEventListener('astro:page-load', () => {
    const footer = document.getElementById('god-tier-footer');
    if (footer) {
      footer.addEventListener('mousemove', (e) => {
        const rect = footer.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        footer.style.setProperty('--mouse-x', `${x}px`);
        footer.style.setProperty('--mouse-y', `${y}px`);
      });
    }

    const cookieSettingsBtn = document.getElementById('open-cookie-settings');
    if (cookieSettingsBtn) {
      cookieSettingsBtn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('numanx:open-cookie-settings'));
      });
    }
  });
</script>
