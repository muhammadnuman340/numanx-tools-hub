---
export type BadgeVariant = "default" | "new" | "popular" | "pro" | "success" | "warning" | "info";

interface Props {
  variant?: BadgeVariant;
  size?: "sm" | "md";
  class?: string;
}

const { variant = "default", size = "sm", class: className } = Astro.props;

const variantClasses: Record<BadgeVariant, string> = {
  default: "bg-surface-2 text-tertiary border-surface-2",
  new: "bg-emerald-500/15 text-emerald-400 border-emerald-500/30",
  popular: "bg-purple-500/15 text-purple-400 border-purple-500/30",
  pro: "bg-amber-500/15 text-amber-400 border-amber-500/30",
  success: "bg-emerald-500/15 text-emerald-400 border-emerald-500/30",
  warning: "bg-amber-500/15 text-amber-400 border-amber-500/30",
  info: "bg-blue-500/15 text-blue-400 border-blue-500/30",
};

const sizeClasses: Record<string, string> = {
  sm: "text-[10px] px-2 py-0.5",
  md: "text-xs px-2.5 py-1",
};
---

<span class={`inline-flex items-center gap-1 font-semibold rounded-full border ${variantClasses[variant]} ${sizeClasses[size]} ${className || ""}`}>
  <slot />
</span>

