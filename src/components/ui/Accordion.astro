---
interface Item {
  title: string;
  content: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class={`space-y-2 ${className || ''}`}>
  {
    items.map((item, i) => (
      <div class="accordion-item rounded-xl border border-surface bg-surface-1 overflow-hidden transition-all duration-300">
        <button
          class="accordion-trigger w-full flex items-center justify-between gap-3 px-5 py-4 text-left text-sm font-semibold text-primary hover:text-purple-400 transition-colors duration-200 cursor-pointer"
          aria-expanded="false"
          aria-controls={`accordion-panel-${i}`}
          id={`accordion-header-${i}`}
        >
          {item.title}
          <svg
            class="accordion-icon w-4 h-4 text-muted transition-transform duration-300 ease-out"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>
        <div
          class="accordion-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out opacity-0"
          role="region"
          aria-labelledby={`accordion-header-${i}`}
          id={`accordion-panel-${i}`}
        >
          <div class="overflow-hidden">
            <div class="px-5 pb-4 text-xs text-tertiary leading-relaxed">{item.content}</div>
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  const setupAccordion = () => {
    document.querySelectorAll('.accordion-item').forEach((item) => {
      const trigger = item.querySelector('.accordion-trigger');
      const content = item.querySelector('.accordion-content');
      const icon = item.querySelector('.accordion-icon');

      trigger?.addEventListener('click', () => {
        const isOpen = content?.classList.contains('grid-rows-[1fr]');

        document.querySelectorAll('.accordion-content').forEach((el) => {
          el.classList.remove('grid-rows-[1fr]', 'opacity-100');
          el.classList.add('grid-rows-[0fr]', 'opacity-0');
        });
        document.querySelectorAll('.accordion-trigger').forEach((el) => el.setAttribute('aria-expanded', 'false'));
        document.querySelectorAll('.accordion-icon').forEach((el) => el.classList.remove('rotate-180'));

        if (!isOpen && content) {
          content.classList.remove('grid-rows-[0fr]', 'opacity-0');
          content.classList.add('grid-rows-[1fr]', 'opacity-100');
          trigger?.setAttribute('aria-expanded', 'true');
          icon?.classList.add('rotate-180');
        }
      });
    });
  };

  setupAccordion();
  document.addEventListener('astro:after-swap', setupAccordion);
</script>
