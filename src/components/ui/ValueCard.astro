---
interface Props {
  title: string;
  description: string;
  delay?: number;
}

const { title, description, delay = 0 } = Astro.props;
---

<div
  class="group relative overflow-hidden rounded-2xl border border-surface bg-surface-1 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-amber-500/30 hover:shadow-lg hover:shadow-amber-900/10"
  style={delay ? `animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) ${delay}s both` : ''}
>
  <div
    class="absolute -right-10 -top-10 h-32 w-32 rounded-full blur-2xl transition-all duration-500 group-hover:scale-150 bg-amber-600/10"
  >
  </div>

  <div
    class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-surface-2 border border-surface text-tertiary group-hover:text-amber-400 group-hover:border-amber-500/20 transition-colors duration-300"
  >
    <slot name="icon" />
  </div>

  <h3 class="text-lg font-semibold text-primary transition-colors duration-200 group-hover:text-white flex flex-col">
    {title}
    <span
      class="mt-1.5 h-[1px] w-4 rounded bg-amber-500/40 transition-all duration-300 group-hover:w-12 group-hover:bg-amber-400"
    ></span>
  </h3>

  <p class="mt-3 text-sm leading-relaxed text-muted transition-colors duration-200 group-hover:text-secondary">
    {description}
  </p>

  <div
    class="absolute bottom-0 left-0 right-0 h-px scale-x-0 group-hover:scale-x-100 transition-transform duration-500 bg-amber-500/20"
  >
  </div>
</div>
