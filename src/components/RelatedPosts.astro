---
import PostCard from './ui/PostCard.astro';
interface Props {
  currentSlug?: string;
  category?: string;
  tags?: string[];
  limit?: number;
}

const postModules = import.meta.glob('../pages/blog/*.md', { eager: true });
const allPosts = Object.entries(postModules)
  .map(([path, mod]) => ({
    slug: path.replace('../pages/blog/', '').replace('.md', ''),
    ...mod,
  }))
  .sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));

const { currentSlug, category, tags, limit = 3 } = Astro.props;

const related = allPosts
  .filter((p) => p.slug !== currentSlug)
  .filter((p) => {
    if (category && p.frontmatter.category === category) return true;
    if (tags && tags.length > 0 && p.frontmatter.tags) {
      return p.frontmatter.tags.some((t) => tags.includes(t));
    }
    return !category && !tags;
  })
  .slice(0, limit);
---

{
  related.length > 0 && (
    <div class="mt-12 pt-8 border-t border-surface">
      <h3 class="text-lg font-bold text-white mb-5">Related Articles</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {related.map((post) => (
          <PostCard
            url={`/blog/${post.slug}/`}
            title={post.frontmatter.title}
            desc={post.frontmatter.description}
            tag={post.frontmatter.category || 'Blog'}
            meta={post.frontmatter.readingTime || ''}
            headingLevel="h4"
          />
        ))}
      </div>
    </div>
  )
}
