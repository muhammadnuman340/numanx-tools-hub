<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;
    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          btn.classList.toggle('opacity-0', window.scrollY < 400);
          btn.classList.toggle('pointer-events-none', window.scrollY < 400);
          btn.classList.toggle('translate-y-4', window.scrollY < 400);
          ticking = false;
        });
        ticking = true;
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  });
</script>

<button
  id="back-to-top"
  aria-label="Scroll to top"
  class="fixed bottom-6 right-6 z-[90] w-11 h-11 rounded-full border border-white/[0.08] bg-[#0a0a0b]/70 backdrop-blur-xl flex items-center justify-center text-zinc-400 hover:text-white hover:border-purple-500/40 hover:shadow-lg hover:shadow-purple-900/20 transition-all duration-300 opacity-0 pointer-events-none translate-y-4"
>
  <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
</button>
