---
// FILE: src/components/ToolsDirectoryGrid.astro
import { tools, categories as categoryInfos, type Tool } from '../data/tools';
import ToolIcon from './icons/ToolIcon.astro';
import MonetizationSlot from './MonetizationSlot.astro';

interface Props {
  initialCategory?: string;
  showMonetization?: boolean;
}

const { initialCategory = 'All', showMonetization = true } = Astro.props;

const categoryMap: Record<string, string> = {
  'image-tools': 'Image Tools',
  'creator-tools': 'Creator Tools',
  'utility-tools': 'Utility Tools',
  'cricket-tools': 'Cricket Tools',
  'ai-tools': 'AI Tools',
  'developer-tools': 'Developer Tools',
};

const filterTabs = [
  { id: 'All', title: 'All Tools', count: tools.length },
  ...categoryInfos.map((c) => ({
    id: c.id,
    title: categoryMap[c.id] || c.title,
    count: tools.filter((t) => t.category === c.id).length,
  })),
];
---

<section class="w-full max-w-7xl mx-auto px-4 sm:px-6 relative z-10" id="tools-directory">
  <!-- Search and Filter Controls -->
  <div class="mb-10 max-w-3xl mx-auto space-y-5">
    <!-- Search Bar -->
    <div class="relative">
      <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-zinc-500">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </span>
      <input
        id="directory-search-input"
        type="search"
        placeholder="Filter all 51+ tools by keyword, task, or name (e.g. 'compress', 'qr', 'nrr', 'uuid')..."
        class="w-full bg-[#0a0a0c]/90 text-white placeholder-zinc-500 pl-12 pr-12 py-4 rounded-2xl border border-white/10 focus:outline-none focus:border-amber-500/50 focus:ring-1 focus:ring-amber-500/30 transition-all text-sm shadow-inner backdrop-blur-xl"
        autocomplete="off"
      />
      <button
        id="directory-clear-btn"
        class="absolute inset-y-0 right-0 pr-4 flex items-center text-zinc-500 hover:text-white hidden"
        title="Clear search"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex flex-wrap gap-2 justify-center" id="directory-category-filters">
      {
        filterTabs.map((cat) => (
          <button
            type="button"
            class={`category-tab-btn px-4 py-2 text-xs font-bold rounded-xl border transition-all duration-200 cursor-pointer flex items-center gap-1.5 ${
              cat.id === 'All'
                ? 'bg-amber-500/10 text-amber-400 border-amber-500/30 shadow-[0_0_15px_rgba(251,191,36,0.15)]'
                : 'bg-[#0a0a0c]/60 text-zinc-400 border-white/5 hover:border-white/15 hover:text-white'
            }`}
            data-category={cat.id}
          >
            <span>{cat.title}</span>
            <span class="text-[10px] font-mono opacity-70 bg-white/5 px-1.5 py-0.5 rounded-full">
              {cat.count}
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Live Results Counter -->
  <div class="mb-6 flex items-center justify-between text-xs font-mono text-zinc-500 px-2">
    <span>Showing <strong id="visible-count" class="text-amber-400">{tools.length}</strong> of {tools.length} tools</span>
    <span id="active-category-indicator" class="uppercase font-bold tracking-wider text-zinc-400">All Tools</span>
  </div>

  <!-- Static 51-Tool Grid -->
  <div
    id="directory-cards-grid"
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5"
  >
    {
      tools.map((tool: Tool, index: number) => {
        return (
          <>
            <a
              href={tool.url}
              class="tool-card group relative flex flex-col justify-between rounded-2xl bg-[#0a0a0c]/80 backdrop-blur-xl border border-white/5 p-6 transition-all duration-300 hover:border-white/20 hover:-translate-y-1 hover:shadow-[0_10px_30px_rgba(0,0,0,0.5)]"
              data-category={tool.category}
              data-name={tool.name.toLowerCase()}
              data-keywords={tool.keywords ? tool.keywords.join(' ').toLowerCase() : ''}
              data-desc={tool.description.toLowerCase()}
            >
              <!-- Card Content -->
              <div>
                <div class="flex items-start justify-between mb-4">
                  <div class="w-11 h-11 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 group-hover:scale-110 group-hover:bg-amber-500/10 group-hover:border-amber-500/30 transition-all duration-300 shadow-sm">
                    <ToolIcon name={tool.icon} class="w-5 h-5" />
                  </div>
                  {tool.isNew && (
                    <span class="text-[9px] font-black uppercase tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-full">
                      New
                    </span>
                  )}
                  {tool.isPopular && (
                    <span class="text-[9px] font-black uppercase tracking-wider text-amber-400 bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 rounded-full">
                      Popular
                    </span>
                  )}
                  {tool.isFeatured && !tool.isNew && !tool.isPopular && (
                    <span class="text-[9px] font-black uppercase tracking-wider text-purple-400 bg-purple-500/10 border border-purple-500/20 px-2 py-0.5 rounded-full">
                      Featured
                    </span>
                  )}
                </div>

                <h3 class="text-base font-bold text-white group-hover:text-amber-400 transition-colors tracking-tight line-clamp-1">
                  {tool.name}
                </h3>
                <p class="text-xs text-zinc-400 mt-2 font-medium line-clamp-2 leading-relaxed">
                  {tool.description}
                </p>
              </div>

              <!-- Card Footer -->
              <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-[11px] font-medium text-zinc-500">
                <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-400">
                  {categoryMap[tool.category] || tool.category}
                </span>
                <span class="inline-flex items-center gap-1 text-amber-400 group-hover:translate-x-1 transition-transform font-bold">
                  Open Tool &rarr;
                </span>
              </div>
            </a>

            {/* In-feed monetization slot every 12 cards */}
            {showMonetization && (index === 7 || index === 23 || index === 39) && (
              <div class="col-span-full my-3">
                <MonetizationSlot format="in-feed" variant="auto" />
              </div>
            )}
          </>
        );
      })
    }
  </div>

  <!-- Empty Search Results State -->
  <div
    id="directory-empty-state"
    class="hidden text-center py-20 px-4 rounded-3xl bg-[#0a0a0c]/50 border border-white/5 mt-6"
  >
    <div class="w-16 h-16 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center mx-auto mb-4 text-zinc-400">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </div>
    <h3 class="text-lg font-bold text-white">No matching tools found</h3>
    <p class="text-xs text-zinc-400 mt-1 max-w-sm mx-auto">
      Try adjusting your search terms or switch to another category filter.
    </p>
    <button
      id="directory-reset-btn"
      class="mt-5 px-5 py-2.5 rounded-xl bg-amber-400 text-black text-xs font-bold hover:bg-amber-300 transition-colors cursor-pointer"
    >
      Reset Filters
    </button>
  </div>
</section>

<script is:inline>
  (function () {
    function initDirectoryFilter() {
      const searchInput = document.getElementById('directory-search-input');
      const clearBtn = document.getElementById('directory-clear-btn');
      const categoryBtns = document.querySelectorAll('.category-tab-btn');
      const cards = document.querySelectorAll('.tool-card');
      const visibleCountEl = document.getElementById('visible-count');
      const emptyState = document.getElementById('directory-empty-state');
      const resetBtn = document.getElementById('directory-reset-btn');
      const activeCatIndicator = document.getElementById('active-category-indicator');

      if (!searchInput || !cards.length) return;

      let currentCategory = 'All';
      let currentQuery = '';

      function filterTools() {
        let count = 0;
        const q = currentQuery.toLowerCase().trim();

        cards.forEach((card) => {
          const category = card.dataset.category || '';
          const name = card.dataset.name || '';
          const keywords = card.dataset.keywords || '';
          const desc = card.dataset.desc || '';

          const matchesCategory = currentCategory === 'All' || category === currentCategory;
          const matchesQuery = !q || name.includes(q) || keywords.includes(q) || desc.includes(q);

          if (matchesCategory && matchesQuery) {
            card.style.display = 'flex';
            count++;
          } else {
            card.style.display = 'none';
          }
        });

        if (visibleCountEl) visibleCountEl.textContent = count;

        if (emptyState) {
          if (count === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      }

      // Search event
      searchInput.addEventListener('input', (e) => {
        currentQuery = e.target.value;
        if (clearBtn) {
          if (currentQuery) {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
        }
        filterTools();
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          currentQuery = '';
          clearBtn.classList.add('hidden');
          filterTools();
          searchInput.focus();
        });
      }

      // Category filter buttons
      categoryBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.dataset.category || 'All';
          currentCategory = cat;

          categoryBtns.forEach((b) => {
            if (b.dataset.category === cat) {
              b.classList.add('bg-amber-500/10', 'text-amber-400', 'border-amber-500/30', 'shadow-[0_0_15px_rgba(251,191,36,0.15)]');
              b.classList.remove('bg-[#0a0a0c]/60', 'text-zinc-400', 'border-white/5');
            } else {
              b.classList.remove('bg-amber-500/10', 'text-amber-400', 'border-amber-500/30', 'shadow-[0_0_15px_rgba(251,191,36,0.15)]');
              b.classList.add('bg-[#0a0a0c]/60', 'text-zinc-400', 'border-white/5');
            }
          });

          if (activeCatIndicator) {
            activeCatIndicator.textContent = btn.querySelector('span')?.textContent || 'All Tools';
          }

          filterTools();
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          searchInput.value = '';
          currentQuery = '';
          if (clearBtn) clearBtn.classList.add('hidden');
          const allBtn = document.querySelector('.category-tab-btn[data-category="All"]');
          if (allBtn) allBtn.click();
        });
      }
    }

    initDirectoryFilter();
    document.addEventListener('astro:page-load', initDirectoryFilter);
  })();
</script>
