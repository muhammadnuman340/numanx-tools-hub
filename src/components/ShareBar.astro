---
/**
 * Share + copy-link buttons. Compact by default (sits in the tool header row).
 * Clicks are handled by one delegated listener that reads the current URL at click time,
 * so the buttons keep working after client-side navigation.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const btn =
  'inline-flex items-center gap-1.5 min-h-9 px-3 rounded-lg border border-line text-soft hover:text-fg hover:border-line-strong text-xs font-medium transition-colors cursor-pointer';
---

<div class:list={['flex items-center gap-2', className]}>
  <button type="button" data-share-tool class={btn} aria-label="Share this tool">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"
      ></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"
      ></line></svg
    >
    <span data-share-label>Share</span>
  </button>
  <button type="button" data-copy-link class={btn} aria-label="Copy link to this tool">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path
        d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg
    >
    <span data-copy-label>Copy link</span>
  </button>
</div>

<script>
  const flash = (label: Element | null, text: string, back: string) => {
    if (!label) return;
    label.textContent = text;
    setTimeout(() => (label.textContent = back), 2000);
  };

  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  };

  document.addEventListener('click', async (e) => {
    const target = e.target as Element | null;
    const share = target?.closest?.('[data-share-tool]');
    const copyBtn = target?.closest?.('[data-copy-link]');
    if (!share && !copyBtn) return;
    const url = window.location.href;

    if (share) {
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, url });
        } catch {}
        return;
      }
      if (await copy(url)) flash(share.querySelector('[data-share-label]'), 'Link copied', 'Share');
      return;
    }

    if (copyBtn && (await copy(url))) flash(copyBtn.querySelector('[data-copy-label]'), 'Copied', 'Copy link');
  });
</script>
