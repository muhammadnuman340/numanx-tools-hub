---
// FILE: src/components/MonetizationSlot.astro
// Complete AdSense Replacement: Contextual Affiliates + EthicalAds/A-Ads + NayaPay/Easypaisa/JazzCash Direct Support
import { PAYMENT_METHODS } from '../data/monetizationConfig';

export interface Props {
  slotType?: 'post-tool-affiliate' | 'in-content-banner' | 'pakistan-support-bar' | string;
  category?: 'creator' | 'utility' | 'image' | 'cricket' | 'ai' | 'developer' | string;
  slotId?: string;
  format?: 'horizontal' | 'vertical' | 'rectangle' | 'in-feed' | 'leaderboard';
  variant?: 'auto' | 'adsense' | 'sponsor' | 'affiliate';
  class?: string;
}

const {
  slotType = 'post-tool-affiliate',
  category = 'utility',
  format = 'horizontal',
  variant = 'auto',
  class: className = '',
} = Astro.props;

const PARTNER_OFFERS: Record<string, { badge: string; title: string; desc: string; cta: string; href: string; accent: string }> = {
  creator: {
    badge: 'Partner link',
    title: 'Research YouTube keywords with vidIQ',
    desc: 'vidIQ suggests video ideas and keywords and shows the tags other channels use. It has a free plan.',
    cta: 'Visit vidIQ',
    href: 'https://vidiq.com/?utm_source=numanx_tools',
    accent: 'border-surface bg-surface-1'
  },
  utility: {
    badge: 'Partner link',
    title: 'Keep your passwords in a password manager',
    desc: 'A manager such as NordPass or 1Password stores strong passwords on all your devices, so you only remember one.',
    cta: 'Visit NordPass',
    href: 'https://nordpass.com/?utm_source=numanx_tools',
    accent: 'border-surface bg-surface-1'
  },
  image: {
    badge: 'Partner link',
    title: 'Design thumbnails and social posts in Canva',
    desc: 'Canva has templates for thumbnails and posts. Export there, then compress or convert the file here.',
    cta: 'Visit Canva',
    href: 'https://www.canva.com/?utm_source=numanx_tools',
    accent: 'border-surface bg-surface-1'
  },
  cricket: {
    badge: 'Sponsorship',
    title: 'Sponsor the cricket calculators',
    desc: 'Run a league, club or cricket brand? These tools are used by players and organisers. Email us about a sponsorship slot.',
    cta: 'Email us',
    href: 'mailto:contact@numanxstudio.com?subject=Cricket%20Tool%20Sponsorship',
    accent: 'border-surface bg-surface-1'
  },
  ai: {
    badge: 'Partnership',
    title: 'Build writing or research tools?',
    desc: 'If your product helps students or writers, email us about featuring it next to the text tools.',
    cta: 'Email us',
    href: 'mailto:contact@numanxstudio.com?subject=AI%20Tool%20Partnership',
    accent: 'border-surface bg-surface-1'
  },
  developer: {
    badge: 'Partner link',
    title: 'Host your web app or API on Hostinger',
    desc: 'Shared hosting, cloud and VPS plans with Git deployment, for when your project needs a server.',
    cta: 'Visit Hostinger',
    href: 'https://www.hostinger.com/?utm_source=numanx_tools',
    accent: 'border-surface bg-surface-1'
  }
};

const offer = PARTNER_OFFERS[category] || PARTNER_OFFERS.utility;

// Standardized CLS-safe dimensions for grid/in-feed placements
const formatStyles: Record<string, string> = {
  horizontal: 'w-full min-h-[100px] md:min-h-[120px] max-w-4xl mx-auto',
  leaderboard: 'w-full min-h-[90px] md:min-h-[100px] max-w-5xl mx-auto',
  rectangle: 'w-full min-h-[280px] max-w-[340px] mx-auto',
  vertical: 'w-full min-h-[600px] max-w-[300px] mx-auto',
  'in-feed': 'w-full min-h-[120px] col-span-full',
};
const dimensionClass = formatStyles[format] || formatStyles.horizontal;
---

{slotType === 'post-tool-affiliate' && (
  <aside aria-label={`${offer.badge}: ${offer.title}`} class={`my-7 p-4 sm:p-5 rounded-xl border ${offer.accent} flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 ${className}`}>
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono uppercase tracking-wider text-zinc-400">{offer.badge}</span>
      </div>
      <h2 class="text-sm sm:text-base font-bold text-white m-0">{offer.title}</h2>
      <p class="text-xs text-zinc-300 m-0 max-w-xl">{offer.desc}</p>
    </div>
    <a
      href={offer.href}
      target="_blank"
      rel="sponsored noopener noreferrer"
      class="shrink-0 inline-flex items-center min-h-10 px-4 rounded-lg border border-surface-2 bg-surface-2 hover:border-amber-500/40 hover:text-white text-secondary text-xs font-semibold transition-colors no-underline"
    >
      {offer.cta} <span aria-hidden="true" class="ml-1">↗</span>
    </a>
  </aside>
)}

{slotType === 'in-content-banner' && (
  <div class={`my-8 min-h-[110px] rounded-xl bg-slate-900/70 border border-slate-800 p-4 flex flex-col sm:flex-row items-center justify-between gap-4 ${dimensionClass} ${className}`}>
    <!-- Plug-and-Play EthicalAds / A-Ads Crypto Unit or Direct Sponsor Fallback -->
    <div data-ea-publisher="numanx-tools" data-ea-type="text" class="text-xs text-zinc-300">
      <span class="text-xs text-emerald-400 font-semibold block mb-1">Sponsor NumanX Tools Hub</span>
      <strong>Reach 10,000+ Developers, Creators & Students:</strong> Place your brand or SaaS directly on this tool page.
      Instant setup via USDT, Payoneer, NayaPay, Easypaisa, or JazzCash.
    </div>
    <a
      href="mailto:contact@numanxstudio.com?subject=Sponsor%20NumanX%20Tools%20Hub"
      class="shrink-0 px-3.5 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 text-xs font-semibold no-underline transition"
    >
      Book Sponsor Slot →
    </a>
  </div>
)}

{slotType === 'pakistan-support-bar' && (
  <div class={`my-6 p-4 rounded-xl bg-panel border border-line flex flex-col sm:flex-row items-center justify-between gap-3 text-xs ${className}`}>
    <div class="flex items-center gap-2.5 text-slate-300">
      <span class="flex h-2 w-2 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span><strong>Support NumanX Open-Source Utilities:</strong> Free tools that run in your browser. Instant local support via <strong>NayaPay / JazzCash / Easypaisa / Payoneer</strong> or Crypto USDT.</span>
    </div>
    <button
      type="button"
      class="open-tip-modal-btn shrink-0 px-3.5 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-600 text-white font-semibold transition shadow-sm flex items-center gap-1.5 cursor-pointer active:scale-95"
    >
      <span>Direct Support / Tip</span>
      <span>⚡</span>
    </button>
  </div>

  <!-- ─── Pakistan & Global Direct Tip / Sponsor Modal ─── -->
  <dialog id="numanx-tip-modal" class="fixed inset-0 m-auto p-0 bg-transparent backdrop:bg-slate-950/80 z-50 max-w-lg w-[calc(100%-2rem)] rounded-2xl border border-slate-700 shadow-2xl overflow-hidden text-slate-200">
    <div class="bg-slate-900 p-6 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <h2 class="text-base font-bold text-white m-0">Support NumanX Tools Hub</h2>
        </div>
        <button type="button" id="close-tip-modal-btn" class="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer" aria-label="Close modal">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <p class="text-xs text-slate-400 m-0 leading-relaxed">
        NumanX Tools Hub tools run in your browser, and your files are not uploaded. Support open-source development directly via local Pakistani mobile accounts or global crypto:
      </p>

      <!-- Tab navigation -->
      <div class="flex flex-wrap gap-1 p-1 rounded-xl bg-slate-950 border border-slate-800" id="tip-modal-tabs">
        {PAYMENT_METHODS.map((pm, idx) => (
          <button
            type="button"
            data-target={pm.id}
            class={`tip-tab-btn flex-1 min-w-[70px] py-1.5 px-2 rounded-lg text-xs font-semibold transition text-center cursor-pointer ${idx === 0 ? 'bg-amber-600 text-white shadow' : 'text-slate-400 hover:text-white'}`}
          >
            <span class="mr-1">{pm.icon}</span>{pm.label}
          </button>
        ))}
      </div>

      <!-- Tab panels -->
      <div id="tip-modal-panels" class="space-y-3">
        {PAYMENT_METHODS.map((pm, idx) => (
          <div id={`panel-${pm.id}`} class={`tip-tab-panel space-y-3 p-4 rounded-xl bg-slate-950/80 border border-slate-800 ${idx === 0 ? 'block' : 'hidden'}`}>
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">{pm.badge}</span>
              {pm.network && <span class="text-[10px] text-slate-500 font-mono">{pm.network}</span>}
            </div>

            <div>
              <span class="text-[10px] text-slate-400 uppercase font-bold block mb-1">Account Title:</span>
              <div class="text-sm font-semibold text-white">{pm.accountTitle}</div>
            </div>

            <div>
              <span class="text-[10px] text-slate-400 uppercase font-bold block mb-1">Account Number / ID / Address:</span>
              <div class="flex items-center gap-2">
                <input
                  type="text"
                  readonly
                  value={pm.accountIdentifier}
                  aria-label={`${pm.name} account identifier`}
                  class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs font-mono text-emerald-300 select-all focus:outline-none"
                />
                <button
                  type="button"
                  aria-label={`Copy ${pm.name} account details`}
                  class="copy-payment-btn shrink-0 px-3.5 py-2 rounded-lg bg-amber-600 hover:bg-amber-500 text-accent-fg text-xs font-bold transition flex items-center gap-1 cursor-pointer active:scale-95"
                  data-copy={pm.accountIdentifier}
                >
                  Copy
                </button>
              </div>
            </div>

            <p class="text-[11px] text-slate-400 m-0 leading-relaxed italic">
              💡 {pm.note}
            </p>
          </div>
        ))}
      </div>

      <div class="pt-2 text-center text-[11px] text-slate-500">
        Brand sponsorships & custom tool requests: <a href="mailto:contact@numanxstudio.com" class="text-amber-400 hover:text-amber-300 underline">contact@numanxstudio.com</a>
      </div>
    </div>
  </dialog>
)}

<script>
  // Tip dialog. A bundled script runs once per page (an inline one inside the {slotType && …}
  // block broke the ESLint parser); it does nothing on pages without the support bar.
  function initTipModal(): void {
    const modal = document.getElementById('numanx-tip-modal') as HTMLDialogElement | null;
    if (!modal || modal.dataset.ready === 'true') return;
    modal.dataset.ready = 'true';

    document.querySelectorAll<HTMLElement>('.open-tip-modal-btn').forEach((btn) => {
      btn.addEventListener('click', () => modal.showModal());
    });

    document.getElementById('close-tip-modal-btn')?.addEventListener('click', () => modal.close());

    modal.addEventListener('click', (e: MouseEvent) => {
      const rect = modal.getBoundingClientRect();
      const inDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width;
      if (!inDialog) modal.close();
    });

    const tabBtns = document.querySelectorAll<HTMLElement>('.tip-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.tip-tab-panel');
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');
        tabBtns.forEach((b) => {
          b.classList.remove('bg-amber-600', 'text-accent-fg', 'shadow');
          b.classList.add('text-slate-400');
        });
        btn.classList.add('bg-amber-600', 'text-accent-fg', 'shadow');
        btn.classList.remove('text-slate-400');
        panels.forEach((p) => p.classList.toggle('hidden', p.id !== 'panel-' + target));
      });
    });

    document.querySelectorAll<HTMLElement>('.copy-payment-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-copy');
        if (!text) return;
        void navigator.clipboard.writeText(text);
        const orig = btn.innerText;
        btn.innerText = 'Copied! ✓';
        btn.classList.add('bg-emerald-600');
        setTimeout(() => {
          btn.innerText = orig;
          btn.classList.remove('bg-emerald-600');
        }, 1500);
      });
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initTipModal);
  else initTipModal();
</script>
