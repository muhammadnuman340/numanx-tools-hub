---
// FILE: src/components/MonetizationSlot.astro
interface Props {
  slotId?: string;
  format?: 'horizontal' | 'vertical' | 'rectangle' | 'in-feed' | 'leaderboard';
  variant?: 'auto' | 'adsense' | 'sponsor' | 'affiliate';
  sponsorName?: string;
  sponsorTagline?: string;
  sponsorUrl?: string;
  sponsorCta?: string;
  class?: string;
}

const {
  slotId = '',
  format = 'horizontal',
  variant = 'auto',
  sponsorName = 'Hostinger Cloud',
  sponsorTagline = 'High-Speed Web Hosting with 99.9% Uptime & Free SSL',
  sponsorUrl = 'https://www.hostinger.com',
  sponsorCta = 'Get 75% Off',
  class: className = '',
} = Astro.props;

const ADSENSE_ID = import.meta.env.PUBLIC_ADSENSE_ID || '';
const hasAdSense = Boolean(ADSENSE_ID && ADSENSE_ID !== 'ca-pub-XXXXXXXXXXXXXXXX');

// Standardized CLS-safe dimensions (prevents Cumulative Layout Shift)
const formatStyles: Record<string, string> = {
  horizontal: 'w-full min-h-[100px] md:min-h-[120px] max-w-4xl mx-auto',
  leaderboard: 'w-full min-h-[90px] md:min-h-[100px] max-w-5xl mx-auto',
  rectangle: 'w-full min-h-[280px] max-w-[340px] mx-auto',
  vertical: 'w-full min-h-[600px] max-w-[300px] mx-auto',
  'in-feed': 'w-full min-h-[140px] md:min-h-[160px] col-span-full',
};

const dimensionClass = formatStyles[format] || formatStyles.horizontal;
---

<aside
  aria-label="Sponsored content and advertisement"
  class={`relative overflow-hidden rounded-2xl border border-white/5 bg-[#0a0a0c]/80 backdrop-blur-xl transition-all duration-300 hover:border-white/10 ${dimensionClass} ${className}`}
>
  <!-- Micro Badge -->
  <span
    class="absolute top-2 right-3 text-[9px] font-mono font-bold tracking-widest uppercase text-zinc-500 z-20 pointer-events-none select-none bg-black/40 px-2 py-0.5 rounded-full border border-white/5"
  >
    {hasAdSense && (variant === 'adsense' || variant === 'auto') ? 'Ad' : 'Sponsored'}
  </span>

  {hasAdSense && (variant === 'adsense' || variant === 'auto') ? (
    <!-- AdSense Safe Delivery Box -->
    <div class="relative w-full h-full flex items-center justify-center p-2 z-10">
      <ins
        class="adsbygoogle block w-full"
        style="display:block"
        data-ad-client={ADSENSE_ID}
        data-ad-slot={slotId || null}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
      <script is:inline>
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {}
      </script>
    </div>
  ) : (
    <!-- Native Glassmorphism Sponsor / High-Yield Affiliate Fallback -->
    <div class="relative z-10 w-full h-full flex flex-col sm:flex-row items-center justify-between p-6 sm:p-8 gap-4 text-left">
      <!-- Glow Accent -->
      <div class="absolute -top-12 -left-12 w-48 h-48 bg-purple-500/10 blur-3xl rounded-full pointer-events-none"></div>
      <div class="absolute -bottom-12 -right-12 w-48 h-48 bg-amber-500/10 blur-3xl rounded-full pointer-events-none"></div>

      <div class="flex items-center gap-4 relative z-10">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-purple-600 via-indigo-600 to-amber-500 flex items-center justify-center shrink-0 shadow-lg shadow-purple-900/30">
          <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h4 class="text-sm font-black text-white tracking-tight">{sponsorName}</h4>
            <span class="text-[10px] font-bold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">Verified Partner</span>
          </div>
          <p class="text-xs text-zinc-400 mt-1 max-w-xl font-medium leading-relaxed">{sponsorTagline}</p>
        </div>
      </div>

      <a
        href={sponsorUrl}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold border border-white/10 hover:border-purple-500/30 transition-all duration-200 shrink-0 hover:scale-[1.02] active:scale-[0.98] shadow-md group relative z-10"
      >
        <span>{sponsorCta}</span>
        <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  )}
</aside>
