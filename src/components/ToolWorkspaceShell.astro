---
// FILE: src/components/ToolWorkspaceShell.astro
import MonetizationSlot from './MonetizationSlot.astro';

export interface Props {
  title: string;
  subtitle: string;
  categoryName: string;
  categorySlug: string;
  badgeText?: string;
}

const {
  title,
  subtitle,
  categoryName,
  categorySlug,
  badgeText = '✦ Pro Client-Side Engine'
} = Astro.props;

const cleanCategory = categorySlug.replace('-tools', '').replace('tools', '').trim() || 'utility';
---

<section class="max-w-4xl mx-auto px-4 pt-5 pb-8">
  <!-- Compact Breadcrumb + Privacy Telemetry Row -->
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3 text-xs text-slate-400">
    <nav aria-label="Breadcrumb" class="flex items-center gap-1.5">
      <a href="/" class="hover:text-indigo-400 transition no-underline text-slate-400">Home</a>
      <span>/</span>
      <a href={`/category/${categorySlug}/`} class="hover:text-indigo-400 transition no-underline text-slate-400">{categoryName}</a>
      <span>/</span>
      <span class="text-slate-200 font-medium">{title}</span>
    </nav>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-950/70 border border-emerald-500/30 text-emerald-300 text-[11px] font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        100% Local Browser Sandbox · 0 Uploads
      </span>
      <span class="px-2.5 py-0.5 rounded-full bg-indigo-950/80 border border-indigo-500/30 text-indigo-300 text-[11px] font-semibold">
        {badgeText}
      </span>
    </div>
  </div>

  <!-- Compact High-Contrast Header -->
  <header class="mb-5">
    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-1.5">
      {title}
    </h1>
    <p class="text-xs sm:text-sm text-slate-400 max-w-2xl m-0">
      {subtitle}
    </p>
  </header>

  <!-- Main Interactive Tool Workspace (Zero CLS, High Contrast Border) -->
  <div class="rounded-2xl bg-slate-900/90 backdrop-blur-md border border-slate-800/90 shadow-2xl p-5 sm:p-6">
    <slot />
  </div>

  <!-- Contextual Monetization Slot Below Interactive Tool Workspace -->
  <MonetizationSlot slotType="post-tool-affiliate" category={cleanCategory} />
</section>
