---
// FILE: src/components/AmbientBackground.astro
// Dual-Mode Visual Engine: GPU CSS Aurora Grid (Mobile) + Interactive Neural Constellation Particles (Desktop)
interface Props {
  mode?: 'dual' | 'particles' | 'aurora';
  accentColor?: string;
}

const { mode = 'dual', accentColor = '0xffaa55' } = Astro.props;
---

<div class="fixed inset-0 -z-10 pointer-events-none overflow-hidden bg-slate-950" aria-hidden="true" data-mode={mode}>
  <!-- Layer 1: Hardware-Accelerated GPU Aurora Mesh Orbs (Active on All Devices, 0 JS Overhead) -->
  <div class="absolute -top-40 -left-40 w-96 h-96 rounded-full bg-indigo-600/15 blur-[110px]"></div>
  <div class="absolute top-1/4 -right-32 w-96 h-96 rounded-full bg-sky-500/12 blur-[120px]"></div>
  <div class="absolute -bottom-40 left-1/3 w-96 h-96 rounded-full bg-emerald-500/10 blur-[120px]"></div>

  <!-- Layer 2: Subtle Engineering Dot-Matrix Grid -->
  <div
    class="absolute inset-0 opacity-[0.18]"
    style="background-image: radial-gradient(#6366f1 1px, transparent 1px); background-size: 28px 28px;"
  ></div>

  <!-- Layer 3: Desktop Interactive Neural Constellation Canvas (Auto-disables on Mobile & Hidden Tabs) -->
  <canvas id="numanx-neural-canvas" class="hidden md:block absolute inset-0 w-full h-full opacity-70"></canvas>
</div>

<script>
  function setupNeuralCanvas() {
    const canvas = document.getElementById('numanx-neural-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.matchMedia('(min-width: 768px)').matches;

    if (!isDesktop || prefersReduced) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);
    let animId = 0;
    const mouse = { x: -9999, y: -9999, radius: 130 };
    let voiceReactivity = 0;

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    }, { passive: true });

    window.addEventListener('mouseleave', () => {
      mouse.x = -9999;
      mouse.y = -9999;
    }, { passive: true });

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }, { passive: true });

    window.addEventListener('jarvis-voice', (event: any) => {
      voiceReactivity = typeof event.detail === 'number' ? event.detail : 1;
    });

    const PARTICLE_COUNT = 42;
    const nodes = Array.from({ length: PARTICLE_COUNT }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * 0.45,
      vy: (Math.random() - 0.5) * 0.45,
      r: Math.random() * 1.6 + 1.0
    }));

    function drawFrame() {
      if (!ctx || document.hidden) {
        animId = requestAnimationFrame(drawFrame);
        return;
      }

      ctx.clearRect(0, 0, width, height);

      const currentRadius = voiceReactivity > 0 ? mouse.radius * 1.4 : mouse.radius;

      for (let i = 0; i < PARTICLE_COUNT; i++) {
        const n = nodes[i];
        n.x += n.vx;
        n.y += n.vy;

        if (n.x < 0 || n.x > width) n.vx *= -1;
        if (n.y < 0 || n.y > height) n.vy *= -1;

        // Subtle mouse interaction
        const dxMouse = n.x - mouse.x;
        const dyMouse = n.y - mouse.y;
        const distMouse = Math.hypot(dxMouse, dyMouse);

        if (distMouse < currentRadius) {
          n.x += (dxMouse / distMouse) * 0.8;
          n.y += (dyMouse / distMouse) * 0.8;
        }

        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fillStyle = voiceReactivity > 0 ? 'rgba(239, 68, 68, 0.85)' : 'rgba(129, 140, 248, 0.75)';
        ctx.fill();

        for (let j = i + 1; j < PARTICLE_COUNT; j++) {
          const m = nodes[j];
          const dist = Math.hypot(n.x - m.x, n.y - m.y);

          if (dist < 135) {
            const alpha = (1 - dist / 135) * 0.22;
            ctx.beginPath();
            ctx.moveTo(n.x, n.y);
            ctx.lineTo(m.x, m.y);
            ctx.strokeStyle = `rgba(99, 102, 241, ${alpha.toFixed(3)})`;
            ctx.lineWidth = 0.8;
            ctx.stroke();
          }
        }
      }

      if (voiceReactivity > 0) {
        voiceReactivity *= 0.95;
      }

      animId = requestAnimationFrame(drawFrame);
    }

    drawFrame();
  }

  setupNeuralCanvas();
  document.addEventListener('astro:page-load', setupNeuralCanvas);
</script>
