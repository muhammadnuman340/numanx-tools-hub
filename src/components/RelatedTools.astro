---
import { getRelatedTools } from '../data/tools';
import ToolIcon from './icons/ToolIcon.astro';
import MonetizationSlot from './MonetizationSlot.astro';

interface Props {
  current: string;
}

const { current } = Astro.props;
const relatedTools = getRelatedTools(current);
---

{
  relatedTools.length > 0 && (
    <section class="mt-12">
      <div class="border-t border-surface pt-10">
        <h2 class="text-xl md:text-2xl font-black tracking-tight text-white mb-6">
          Related
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Tools</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedTools.map((tool) => (
            <a
              href={tool.url}
              class="group rounded-xl border border-surface bg-surface-1 p-4 hover:border-purple-500/40 hover:bg-surface-2 transition-all duration-300"
            >
              <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-lg bg-purple-600/10 flex items-center justify-center text-purple-400 shrink-0 group-hover:scale-110 transition-transform duration-200">
                  <ToolIcon name={tool.icon} />
                </span>
                <div class="min-w-0">
                  <h3 class="text-sm font-semibold text-primary group-hover:text-white transition-colors">
                    {tool.name}
                  </h3>
                  <p class="text-xs text-muted mt-0.5">{tool.description}</p>
                </div>
              </div>
            </a>
          ))}
        </div>
        <MonetizationSlot slotType="in-content-banner" class="mt-8" />
      </div>
    </section>
  )
}
