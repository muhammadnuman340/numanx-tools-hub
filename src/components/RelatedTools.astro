---
import { getRelatedTools } from '../data/tools';
import ToolCard from './ui/ToolCard.astro';
import MonetizationSlot from './MonetizationSlot.astro';

interface Props {
  current: string;
}

const { current } = Astro.props;
const relatedTools = getRelatedTools(current);
---

{
  relatedTools.length > 0 && (
    <section class="mt-12" aria-labelledby="related-tools-heading">
      <div class="border-t border-line pt-10">
        <h2 id="related-tools-heading" class="text-xl md:text-2xl font-bold tracking-tight text-fg mb-5">
          Related tools
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedTools.map((tool) => (
            <ToolCard tool={tool} />
          ))}
        </div>
        <MonetizationSlot slotType="in-content-banner" class="mt-8" />
      </div>
    </section>
  )
}
