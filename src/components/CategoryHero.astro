---
import type { CategoryInfo } from '../data/tools';
import ToolIcon from '../components/icons/ToolIcon.astro';

interface Props {
  category: CategoryInfo;
}

const { category } = Astro.props;
---

<div class="mb-10 pt-6">
  <p class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-zinc-400 mb-3">
    <ToolIcon name={category.icon} />
    {category.count} tools
  </p>
  <h1 class="text-[length:var(--step-3)] font-bold tracking-[-0.02em] leading-tight text-primary">
    {category.title}
  </h1>
  <p class="mt-3 text-secondary text-lg max-w-[68ch] leading-relaxed">
    {category.description}
  </p>
</div>
