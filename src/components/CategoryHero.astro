---
import type { CategoryInfo } from '../data/tools';
import ToolIcon from '../components/icons/ToolIcon.astro';

interface Props {
  category: CategoryInfo;
}

const { category } = Astro.props;
---

<div class="text-center mb-12 pt-8">
  <div
    class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-surface bg-surface-1 text-tertiary text-xs font-semibold tracking-wider uppercase mb-6"
  >
    <ToolIcon name={category.icon} />
    {category.count} Tools
  </div>
  <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-none">
    {category.title}
  </h1>
  <p class="mt-4 text-tertiary text-lg max-w-2xl mx-auto leading-relaxed">
    {category.description}
  </p>
</div>
