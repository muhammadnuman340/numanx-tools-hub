---
interface Props {
  serve?: string;
  placement?: string;
  class?: string;
}

const { serve = "CEAICKJM", placement = "numanxtools", class: className } = Astro.props;
---

<aside aria-label="Advertisement" aria-live="polite" class={`relative overflow-hidden rounded-2xl border border-white/[0.06] bg-white/[0.02] p-6 sm:p-8 text-center min-h-[200px] flex items-center justify-center ${className || ""}`}>
  <div id="carbonads" class="w-full">
    <div class="flex flex-col items-center gap-3 py-4">
      <div class="w-8 h-8 rounded-lg bg-white/[0.04] border border-white/[0.06] flex items-center justify-center">
        <svg class="w-4 h-4 text-zinc-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      </div>
      <span class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">Developer Ad</span>
    </div>
  </div>

  <script async type="text/javascript" src={`//cdn.carbonads.com/carbon.js?serve=${serve}&placement=${placement}`} id="_carbonads_js"></script>
</aside>
