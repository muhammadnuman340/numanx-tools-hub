---
const { title, description } = Astro.props;
---

<div
  class="group border border-surface bg-surface-1 rounded-3xl p-6 hover:border-purple-500 transition duration-300 hover:-translate-y-2"
>
  <div class="w-14 h-14 rounded-2xl bg-purple-600/20 flex items-center justify-center text-2xl mb-6">✨</div>

  <h3 class="text-2xl font-bold">
    {title}
  </h3>

  <p class="text-tertiary mt-4 leading-relaxed">
    {description}
  </p>
</div>
