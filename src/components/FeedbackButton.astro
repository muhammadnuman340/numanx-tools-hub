---
const page = Astro.url.pathname;
---

<button
  id="feedback-trigger"
  class="fixed bottom-6 left-6 z-50 w-12 h-12 rounded-full bg-purple-600 hover:bg-purple-700 text-white shadow-xl shadow-purple-900/30 flex items-center justify-center transition-all duration-200 active:scale-90 cursor-pointer"
  aria-label="Send feedback"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
    <line x1="12" y1="8" x2="12" y2="12" />
    <line x1="12" y1="16" x2="12.01" y2="16" />
  </svg>
</button>

<div
  id="feedback-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="feedback-heading"
  aria-describedby="feedback-desc"
>
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm animate-[fadeIn_0.2s_ease-out]" id="feedback-overlay"></div>
  <div class="relative w-full max-w-md rounded-2xl border border-surface bg-surface-1 p-6 shadow-2xl animate-[scaleIn_0.25s_cubic-bezier(0.16,1,0.3,1)]" id="feedback-panel">
    <button
      id="feedback-close"
      class="absolute top-4 right-4 text-tertiary hover:text-white transition-colors cursor-pointer"
      aria-label="Close feedback form"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
    <h3 id="feedback-heading" class="text-lg font-bold text-white mb-1">Send Feedback</h3>
    <p id="feedback-desc" class="text-xs text-tertiary mb-5">Help us improve NumanX Tools. Share your thoughts!</p>
    <form id="feedback-form" class="space-y-4">
      <input type="hidden" id="feedback-page" value={page} />
      <div>
        <label class="block text-xs font-semibold text-tertiary mb-2">Rating</label>
        <div id="feedback-stars" class="flex gap-1.5">
          {[1, 2, 3, 4, 5].map((star) => (
            <button
              type="button"
              data-star={star}
              aria-label={`Rate ${star} star${star > 1 ? 's' : ''}`}
              class="star-btn w-9 h-9 rounded-lg bg-surface-2 border border-surface flex items-center justify-center text-tertiary hover:text-yellow-400 hover:border-yellow-500/30 transition-all cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
            </button>
          ))}
        </div>
      </div>
      <div>
        <label for="feedback-msg" class="block text-xs font-semibold text-tertiary mb-1.5">Your Message</label>
        <textarea
          id="feedback-msg"
          rows="3"
          placeholder="Tell us what you think..."
          required
          aria-required="true"
          class="w-full px-4 py-3 rounded-xl bg-black/40 border border-surface text-white placeholder-zinc-600 text-sm focus:border-purple-500/50 focus:outline-none transition-colors resize-none"
        ></textarea>
      </div>
      <div>
        <label for="feedback-email" class="block text-xs font-semibold text-tertiary mb-1.5">Email (optional)</label>
        <input
          id="feedback-email"
          type="email"
          placeholder="you@example.com"
          class="w-full px-4 py-3 rounded-xl bg-black/40 border border-surface text-white placeholder-zinc-600 text-sm focus:border-purple-500/50 focus:outline-none transition-colors"
        />
      </div>
      <button
        type="submit"
        id="feedback-submit"
        class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold text-sm px-6 py-3 rounded-xl transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span id="fb-submit-text">Submit Feedback</span>
        <span id="fb-submit-spinner" class="hidden inline-flex items-center gap-2">
          <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
          </svg>
          Sending...
        </span>
      </button>
      <p id="feedback-msg-display" class="text-xs text-center hidden"></p>
    </form>
  </div>
</div>

<script>
  const trigger = document.getElementById('feedback-trigger');
  const modal = document.getElementById('feedback-modal');
  const overlay = document.getElementById('feedback-overlay');
  const panel = document.getElementById('feedback-panel');
  const close = document.getElementById('feedback-close');
  const form = document.getElementById('feedback-form');
  const stars = document.querySelectorAll('.star-btn');
  const fbMsg = document.getElementById('feedback-msg-display');
  const submitBtn = document.getElementById('feedback-submit');
  const submitText = document.getElementById('fb-submit-text');
  const submitSpinner = document.getElementById('fb-submit-spinner');
  const feedbackTextarea = document.getElementById('feedback-msg');

  let selectedRating = 0;
  let previousFocus = null;

  function focusTrap(e) {
    if (!modal || modal.classList.contains('hidden')) return;
    const focusable = modal.querySelectorAll('button, input, textarea, select, [tabindex]:not([tabindex="-1"])');
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      (last as HTMLElement).focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      (first as HTMLElement).focus();
    }
  }

  function openModal() {
    previousFocus = document.activeElement;
    modal.classList.remove('hidden');
    panel.style.animation = 'scaleIn 0.25s cubic-bezier(0.16,1,0.3,1) forwards';
    overlay.style.animation = 'fadeIn 0.2s ease-out forwards';
    document.addEventListener('keydown', focusTrap);
    setTimeout(() => feedbackTextarea?.focus(), 100);
  }

  function closeModal() {
    panel.style.animation = 'scaleOut 0.2s ease-out forwards';
    overlay.style.animation = 'fadeOut 0.15s ease-out forwards';
    document.removeEventListener('keydown', focusTrap);
    setTimeout(() => {
      modal.classList.add('hidden');
      if (previousFocus) (previousFocus as HTMLElement)?.focus();
    }, 200);
  }

  if (trigger && modal) {
    trigger.addEventListener('click', openModal);
    if (overlay) overlay.addEventListener('click', closeModal);
    if (close) close.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
  }

  function setStars(count) {
    stars.forEach((s, i) => {
      const svg = s.querySelector('svg');
      const active = i < count;
      s.classList.toggle('text-yellow-400', active);
      s.classList.toggle('border-yellow-500/30', active);
      s.classList.toggle('text-tertiary', !active);
      if (svg) {
        if (active) svg.setAttribute('fill', 'currentColor');
        else svg.removeAttribute('fill');
      }
      s.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  }

  stars.forEach((btn) => {
    btn.addEventListener('mouseenter', () => {
      const count = parseInt(btn.dataset.star, 10);
      setStars(count);
    });
    btn.addEventListener('mouseleave', () => {
      setStars(selectedRating);
    });
    btn.addEventListener('click', () => {
      selectedRating = parseInt(btn.dataset.star, 10);
      setStars(selectedRating);
    });
  });

  if (form && fbMsg && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const message = feedbackTextarea.value.trim();
      const email = document.getElementById('feedback-email').value.trim();
      const page = document.getElementById('feedback-page').value;

      if (!selectedRating || !message) {
        fbMsg.className = 'text-xs text-red-400 text-center';
        fbMsg.textContent = 'Please select a rating and enter a message.';
        fbMsg.setAttribute('role', 'alert');
        return;
      }

      fbMsg.className = 'text-xs text-center hidden';
      fbMsg.removeAttribute('role');
      submitBtn.disabled = true;
      submitText.classList.add('hidden');
      submitSpinner.classList.remove('hidden');

      try {
        const resp = await fetch('/api/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rating: selectedRating, message, email, page }),
        });
        const data = await resp.json();
        if (resp.ok && data.success) {
          fbMsg.className = 'text-xs text-emerald-400 text-center';
          fbMsg.textContent = data.message || 'Thank you for your feedback!';
          fbMsg.setAttribute('role', 'status');
          form.reset();
          selectedRating = 0;
          setStars(0);
          setTimeout(closeModal, 1200);
        } else {
          fbMsg.className = 'text-xs text-red-400 text-center';
          fbMsg.textContent = data.error || 'Something went wrong.';
          fbMsg.setAttribute('role', 'alert');
        }
      } catch {
        fbMsg.className = 'text-xs text-red-400 text-center';
        fbMsg.textContent = 'Network error. Please try again.';
        fbMsg.setAttribute('role', 'alert');
      }

      submitBtn.disabled = false;
      submitText.classList.remove('hidden');
      submitSpinner.classList.add('hidden');
    });
  }
</script>
