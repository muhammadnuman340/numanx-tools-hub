---
interface Props {
  class?: string;
  slotId?: string;
  format?: 'horizontal' | 'vertical' | 'rectangle';
  showAdSense?: boolean;
}

const { 
  class: className, 
  slotId = "", 
  format = 'horizontal',
  showAdSense = true // Made active by default as requested
} = Astro.props;

// Reserve space perfectly so Core Web Vitals (CLS) don't get destroyed
const formatClasses = {
  horizontal: 'w-full min-h-[90px] md:min-h-[120px]',
  vertical: 'w-full min-h-[600px] max-w-[300px]',
  rectangle: 'w-full min-h-[250px] max-w-[300px]',
};
---

{showAdSense ? (
  <!-- Production AdSense Block (Active by Default) -->
  <aside
    aria-label="Advertisement"
    class={`relative overflow-hidden flex items-center justify-center bg-surface-1 border border-surface rounded-2xl ${formatClasses[format]} ${className || ''}`}
  >
    <span class="absolute text-[10px] text-tertiary tracking-widest uppercase z-0">
      Advertisement
    </span>

    <ins class="adsbygoogle"
         style="display:block; z-index: 10; position: relative;"
         data-ad-client="ca-pub-XXXXXXXXXXXXXXXX" 
         data-ad-slot={slotId}
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>
    <script is:inline>
         (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </aside>
) : (
  <!-- Fallback Sponsorship Block -->
  <aside
    aria-label="Sponsorship"
    class={`relative group overflow-hidden rounded-2xl border border-dashed border-surface bg-surface-1 p-6 sm:p-8 text-center transition-all duration-300 hover:border-purple-500/40 hover:bg-surface-2 ${formatClasses[format]} ${className || ''}`}
  >
    <div
      class="absolute inset-0 bg-gradient-to-r from-purple-500/0 via-purple-500/[0.04] to-blue-500/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 flex flex-col items-center justify-center h-full">
      <span
        class="text-[10px] font-bold tracking-widest text-purple-400 uppercase bg-purple-500/10 px-3 py-1 rounded-full mb-4"
      >
        Sponsorship Slot Available
      </span>

      <h3 class="text-base sm:text-lg font-semibold text-secondary group-hover:text-white transition-colors duration-200">
        Reach Creators & Builders Daily
      </h3>

      <p
        class="mt-2 max-w-xs text-xs text-tertiary leading-relaxed group-hover:text-secondary transition-colors duration-200"
      >
        Position your brand, SaaS tool, or newsletter in front of thousands of digital creators.
      </p>

      <a
        href="/contact"
        class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-purple-400 hover:text-purple-300 transition-colors duration-200 group/link"
      >
        Advertise Here
        <span class="transform group-hover/link:translate-x-0.5 transition-transform duration-200">→</span>
      </a>
    </div>
  </aside>
)}
