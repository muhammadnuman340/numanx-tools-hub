---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`relative group overflow-hidden rounded-2xl border border-dashed border-white/[0.06] bg-white/[0.02] p-6 sm:p-8 text-center transition-all duration-300 hover:border-purple-500/40 hover:bg-white/[0.04] ${className || ""}`}>

  <div class="absolute inset-0 bg-gradient-to-r from-purple-500/0 via-purple-500/[0.04] to-blue-500/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" />

  <div class="relative z-10 flex flex-col items-center justify-center min-h-[160px]">
    <span class="text-[10px] font-bold tracking-widest text-purple-400 uppercase bg-purple-500/10 px-3 py-1 rounded-full mb-4">
      Sponsorship Slot Available
    </span>

    <h3 class="text-base sm:text-lg font-semibold text-zinc-300 group-hover:text-white transition-colors duration-200">
      Reach Creators & Builders Daily
    </h3>

    <p class="mt-2 max-w-xs text-xs text-zinc-500 leading-relaxed group-hover:text-zinc-400 transition-colors duration-200">
      Position your brand, SaaS tool, or newsletter in front of thousands of digital creators.
    </p>

    <a href="/contact" class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-purple-400 hover:text-purple-300 transition-colors duration-200 group/link">
      Advertise Here
      <span class="transform group-hover/link:translate-x-0.5 transition-transform duration-200">→</span>
    </a>
  </div>
</div>
