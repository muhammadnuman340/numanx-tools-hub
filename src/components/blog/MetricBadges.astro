---
interface Badge {
  label: string;
  value: string;
  description: string;
  variant?: 'emerald' | 'blue' | 'purple';
}

interface Props {
  badges: Badge[];
}

const variantStyles: Record<string, { container: string; label: string }> = {
  emerald: { container: 'bg-emerald-950/10 border-emerald-500/10', label: 'text-emerald-400' },
  blue: { container: 'bg-blue-950/10 border-blue-500/10', label: 'text-blue-400' },
  purple: { container: 'bg-purple-950/10 border-purple-500/10', label: 'text-purple-400' },
};

const { badges } = Astro.props;
---

<div class="my-8 grid grid-cols-2 gap-4">
  {
    badges.map((badge) => {
      const vs = variantStyles[badge.variant || 'emerald'];
      return (
        <div class="p-4 rounded-xl {vs.container} border flex flex-col justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider {vs.label}">{badge.label}</span>
          <span class="text-2xl font-black text-white mt-2 {badge.value.length > 8 ? '' : 'font-mono'}">
            {badge.value}
          </span>
          <span class="text-xs text-slate-400 mt-1">{badge.description}</span>
        </div>
      );
    })
  }
</div>
