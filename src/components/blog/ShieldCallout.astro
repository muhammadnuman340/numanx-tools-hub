---
interface Props {
  title: string;
  variant?: 'emerald' | 'purple' | 'amber';
}

const variantStyles: Record<string, { container: string; icon: string; header: string; svg: string }> = {
  emerald: {
    container: 'bg-emerald-500/[0.02] border-emerald-500/20',
    icon: 'bg-emerald-500/10 text-emerald-400',
    header: 'text-emerald-400',
    svg: 'text-emerald-500/5',
  },
  purple: {
    container: 'bg-purple-500/[0.02] border-purple-500/20',
    icon: 'bg-purple-500/10 text-purple-400',
    header: 'text-purple-400',
    svg: 'text-purple-500/5',
  },
  amber: {
    container: 'bg-amber-500/[0.02] border-amber-500/20',
    icon: 'bg-amber-500/10 text-amber-400',
    header: 'text-amber-400',
    svg: 'text-amber-500/5',
  },
};

const { title, variant = 'emerald' } = Astro.props;
const vs = variantStyles[variant];
---

<div class="my-8 p-5 rounded-xl {vs.container} border backdrop-blur-sm flex gap-4 items-start relative overflow-hidden">
  <div class="absolute -right-6 -bottom-6 {vs.svg} pointer-events-none">
    <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 20 20">
      <path
        fill-rule="evenodd"
        d="M2.166 4.999A11.954 11.954 0 0010 1.944a11.954 11.954 0 007.834 3.056 11.99 11.99 0 01-1.12 7.323l-5.918 3.738a1 1 0 01-1.092 0l-5.917-3.738a11.99 11.99 0 01-1.12-7.323zM7 9a1 1 0 000 2h6a1 1 0 100-2H7z"
        clip-rule="evenodd"></path>
    </svg>
  </div>

  <div class="p-2 rounded-lg {vs.icon} shrink-0">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
      ></path>
    </svg>
  </div>

  <div>
    <h4 class="text-sm font-bold {vs.header} uppercase tracking-wide">{title}</h4>
    <div class="text-sm text-slate-300 mt-1 leading-relaxed">
      <slot />
    </div>
  </div>
</div>
