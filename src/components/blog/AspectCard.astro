---
interface Props {
  ratio: string;
  label: string;
  dimensions: string;
  cardClass?: string;
}

const { ratio, label, dimensions, cardClass = '' } = Astro.props;
---

<div
  class="p-3 bg-white/[0.02] border border-white/5 rounded-xl text-center hover:bg-white/[0.04] transition-colors {cardClass}"
>
  <div
    class="w-8 h-8 mx-auto mb-2 border border-dashed border-slate-600 rounded flex items-center justify-center text-[10px] text-slate-500 font-mono"
  >
    {ratio}
  </div>
  <p class="text-xs font-semibold text-slate-200 truncate">{label}</p>
  <p class="text-[10px] font-mono text-slate-400 mt-0.5">{dimensions}</p>
</div>
