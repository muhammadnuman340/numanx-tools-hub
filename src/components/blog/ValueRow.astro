---
interface Props {
  icon: 'alpha' | 'lossless' | 'speed' | 'security';
  title: string;
  description: string;
  variant?: 'indigo' | 'default';
}

const icons = {
  alpha: {
    path: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6z',
  },
  lossless: {
    path: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  speed: {
    path: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  security: {
    path: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
};

const { icon, title, description, variant = 'default' } = Astro.props;

const isIndigo = variant === 'indigo';
const containerClass = isIndigo
  ? 'bg-indigo-950/10 border-indigo-500/10 hover:border-indigo-500/20'
  : 'bg-white/[0.01] border-white/5 hover:border-white/10';
const iconContainerClass = isIndigo
  ? 'bg-indigo-500/10 text-indigo-400'
  : 'bg-white/[0.04] text-slate-400 group-hover:text-slate-200';
---

<div class="group flex items-center justify-between p-4 rounded-xl {containerClass} transition-colors">
  <div class="flex items-center gap-3.5">
    <div class="p-2 rounded-lg {iconContainerClass}">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d={icons[icon].path}></path>
      </svg>
    </div>
    <div>
      <h5 class="text-sm font-semibold text-slate-200">{title}</h5>
      <p class="text-xs text-slate-400 mt-0.5">{description}</p>
    </div>
  </div>
</div>
