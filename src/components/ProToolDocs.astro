---
// FILE: src/components/ProToolDocs.astro
import { getProToolDoc } from '../data/proToolContent';

interface Props {
  slug: string;
  toolName: string;
  category?: string;
}

const { slug, toolName, category = 'Utilities' } = Astro.props;
const doc = getProToolDoc(slug, toolName, category);
---

<section class="mt-16 pt-12 border-t border-surface/80" id="technical-docs">
  <div class="max-w-4xl mx-auto space-y-8">
    <!-- Header -->
    <div class="space-y-2 text-center md:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/30 text-purple-300 text-xs font-semibold">
        <span>📐</span>
        <span>Technical Documentation &amp; Verification</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white m-0">
        {doc.title}
      </h2>
      <p class="text-sm text-zinc-400 m-0">
        {doc.subtitle}
      </p>
    </div>

    <!-- Standards & Architecture Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {doc.standards && (
        <div class="p-4 rounded-xl bg-surface-1 border border-surface space-y-1">
          <span class="text-[10px] uppercase font-bold text-muted tracking-wider">Governing Standard</span>
          <p class="text-xs font-semibold text-purple-300 m-0">{doc.standards}</p>
        </div>
      )}
      <div class="p-4 rounded-xl bg-surface-1 border border-surface space-y-1">
        <span class="text-[10px] uppercase font-bold text-muted tracking-wider">Execution Model</span>
        <p class="text-xs font-semibold text-emerald-400 m-0">100% Client-Side In-Browser Runtime</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-1 border border-surface space-y-1">
        <span class="text-[10px] uppercase font-bold text-muted tracking-wider">Privacy &amp; Security</span>
        <p class="text-xs font-semibold text-blue-300 m-0">Zero Cloud Uploads · Zero Logging</p>
      </div>
    </div>

    {doc.formula && (
      <!-- Mathematical Formulation -->
      <div class="rounded-2xl bg-zinc-950 border border-purple-500/30 p-6 space-y-3 shadow-xl">
        <div class="flex items-center justify-between">
          <h3 class="text-xs uppercase font-bold text-purple-300 tracking-wider m-0 flex items-center gap-2">
            <span>∑</span> Mathematical &amp; Algorithmic Formulation
          </h3>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-surface-2 text-zinc-400 border border-surface">
            Deterministic Precision
          </span>
        </div>
        <div class="py-3 px-4 rounded-xl bg-surface-1/80 border border-surface font-mono text-center text-sm md:text-base text-purple-200 overflow-x-auto">
          <code>{doc.formula.latex}</code>
        </div>
        <p class="text-xs text-zinc-400 m-0 leading-relaxed">
          {doc.formula.description}
        </p>
      </div>
    )}

    <!-- Direct Answer Lead Section (AEO / GEO 45-Word Rule) -->
    <div class="p-6 rounded-2xl bg-indigo-950/20 border border-indigo-500/30 space-y-3">
      <h3 class="text-base font-bold text-white m-0 flex items-center gap-2">
        <span>💡</span> What is {toolName}?
      </h3>
      <p class="text-sm text-zinc-300 leading-relaxed m-0">
        {doc.technicalOverview}
      </p>
    </div>

    <!-- Worked Example -->
    <div class="rounded-2xl bg-surface-1 border border-surface p-6 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-bold text-white m-0 flex items-center gap-2">
          <span>🧪</span> Verifiable Worked Example
        </h3>
        <span class="text-[10px] font-semibold text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/30">
          Peer-Verifiable
        </span>
      </div>

      <div class="space-y-3 text-xs font-mono">
        <div class="p-3 rounded-xl bg-zinc-950 border border-surface">
          <span class="text-[10px] uppercase font-bold text-muted block mb-1">Scenario Input:</span>
          <span class="text-zinc-200">{doc.workedExample.input}</span>
        </div>

        <div class="p-3 rounded-xl bg-zinc-950 border border-surface">
          <span class="text-[10px] uppercase font-bold text-muted block mb-1">Calculation Steps:</span>
          <span class="text-zinc-300 leading-relaxed whitespace-pre-line">{doc.workedExample.stepByStepCalculation}</span>
        </div>

        <div class="p-3 rounded-xl bg-emerald-950/20 border border-emerald-500/30">
          <span class="text-[10px] uppercase font-bold text-emerald-400 block mb-1">Expected Output:</span>
          <span class="text-emerald-300 font-bold">{doc.workedExample.expectedOutput}</span>
        </div>
      </div>
    </div>

    <!-- Methodology Notes -->
    {doc.methodologyNotes && doc.methodologyNotes.length > 0 && (
      <div class="p-6 rounded-2xl bg-surface-1 border border-surface space-y-3">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider m-0">
          Rules &amp; Implementation Nuances
        </h3>
        <ul class="space-y-2 text-xs text-zinc-400 list-disc list-inside m-0">
          {doc.methodologyNotes.map((note) => (
            <li class="leading-relaxed">{note}</li>
          ))}
        </ul>
      </div>
    )}

    <!-- Benchmarks if available -->
    {doc.benchmarks && doc.benchmarks.length > 0 && (
      <div class="p-6 rounded-2xl bg-surface-1 border border-surface space-y-3">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider m-0">
          Performance &amp; Scale Benchmarks
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          {doc.benchmarks.map((b) => (
            <div class="p-3 rounded-xl bg-zinc-950 border border-surface flex items-center justify-between">
              <span class="font-semibold text-purple-300">{b.label}</span>
              <span class="text-zinc-400 font-mono">{b.value}</span>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
