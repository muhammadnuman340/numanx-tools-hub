---
// FILE: src/components/ProToolDocs.astro — 600w Verifiable Editorial & Technical Documentation Component
import { getProToolDoc, PRO_TOOL_CONTENT } from '../data/proToolContent';

export interface Props {
  toolName?: string;
  slug?: string;
  category?: string;
  formulaTitle?: string;
  formulaExplanation?: string;
  formulaCode?: string;
  steps?: { title: string; detail: string }[];
  useCases?: { role: string; scenario: string }[];
  faqs?: { question: string; answer: string }[];
}

const {
  slug = '',
  toolName: propToolName,
  category = 'Utilities',
  formulaTitle: propFormulaTitle,
  formulaExplanation: propFormulaExplanation,
  formulaCode: propFormulaCode,
  steps: propSteps,
  useCases: propUseCases,
  faqs: propFaqs,
} = Astro.props;

const regEntry = PRO_TOOL_CONTENT[slug] || {};
const doc = getProToolDoc(slug, propToolName || regEntry.toolName || 'Tool Pro', category);

const toolName = propToolName || regEntry.toolName || doc.title || 'Tool Pro';
const formulaTitle = propFormulaTitle || regEntry.formulaTitle || doc.subtitle || 'Algorithmic Specification & Math';
const formulaExplanation = propFormulaExplanation || regEntry.formulaExplanation || doc.technicalOverview;
const formulaCode = propFormulaCode || regEntry.formulaCode || (doc.formula ? doc.formula.latex : undefined);

const defaultSteps = [
  { title: 'Input Ingestion', detail: 'Data or files are loaded strictly into browser volatile memory via local Web APIs with zero cloud uploads.' },
  { title: 'Local Validation & Lexing', detail: 'The local engine executes structural lexing, format validation, and arithmetic verification based on governing technical standards.' },
  { title: 'Hardware-Accelerated Execution', detail: 'Operations process using browser Web Workers, OffscreenCanvas, or Web Crypto primitives to prevent main-thread UI jank.' },
  { title: 'Zero-Latency Output', detail: 'The verified result is delivered in real-time, ready for immediate 1-click clipboard copy or high-DPI file export.' }
];

const defaultUseCases = [
  { role: 'Software Developers & DevOps', scenario: 'Validate cryptographic tokens, format JSON configurations, or generate high-entropy keys within secure air-gapped workflows.' },
  { role: 'Digital Creators & Video Editors', scenario: 'Accelerate content publishing with optimized viral tags, custom QR packaging strips, and 1080×1920 social cards.' },
  { role: 'Students & Academic Researchers', scenario: 'Verify mathematical calculations, statistical ratios, and temporal durations with peer-verifiable precision.' },
  { role: 'Privacy-Conscious Professionals', scenario: 'Process sensitive customer data and documents locally without risk of corporate data leaks or cloud retention.' }
];

const defaultFaqs = [
  { question: `Does ${toolName} upload my files or data to any external server?`, answer: 'No. Every calculation and conversion executes entirely inside your client-side browser runtime sandbox. Your data never touches a remote server.' },
  { question: `What mathematical or technical standards govern ${toolName}?`, answer: `This utility strictly adheres to ${formulaTitle}, ensuring deterministic accuracy and zero floating-point rounding distortion.` },
  { question: `Can I use ${toolName} without an active internet connection?`, answer: 'Yes. Thanks to our offline-first PWA service worker (numanx-v2026-10-ultra), core tools and precached bundles load and execute completely offline.' },
  { question: `Are there any hidden subscriptions, paywalls, or daily usage caps?`, answer: 'No. NumanX Tools Hub is completely free for individual, commercial, and educational use without watermarks or arbitrary limits.' }
];

const steps = propSteps && propSteps.length > 0 ? propSteps : defaultSteps;
const useCases = propUseCases && propUseCases.length > 0 ? propUseCases : defaultUseCases;
const faqs = propFaqs && propFaqs.length > 0 ? propFaqs : defaultFaqs;
---

<section class="max-w-4xl mx-auto mt-10 space-y-8 border-t border-slate-800 pt-8 text-slate-200">
  <!-- How it works (Formula Title & Code) -->
  <div class="rounded-2xl border border-slate-800 bg-slate-900/90 p-6">
    <h2 class="text-lg sm:text-xl font-bold text-white m-0">How the {toolName} Works ({formulaTitle})</h2>
    <p class="mt-2 text-xs sm:text-sm text-slate-300 leading-relaxed">{formulaExplanation}</p>
    {formulaCode && (
      <pre class="mt-4 rounded-xl bg-slate-950 border border-slate-800 p-4 text-xs text-indigo-300 overflow-x-auto font-mono"><code>{formulaCode}</code></pre>
    )}
  </div>

  <!-- Worked Example (if available in doc) -->
  {doc && doc.workedExample && (
    <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white m-0 flex items-center gap-2">
          <span>🧪</span> Verifiable Worked Example
        </h3>
        <span class="text-[10px] font-semibold text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/30">
          Deterministic
        </span>
      </div>
      <div class="space-y-2 text-xs font-mono">
        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
          <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Scenario Input:</span>
          <span class="text-slate-200">{doc.workedExample.input}</span>
        </div>
        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
          <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Calculation Steps:</span>
          <span class="text-slate-300 whitespace-pre-line leading-relaxed">{doc.workedExample.stepByStepCalculation}</span>
        </div>
        <div class="p-3 rounded-xl bg-emerald-950/20 border border-emerald-500/30">
          <span class="text-[10px] uppercase font-bold text-emerald-400 block mb-1">Expected Output:</span>
          <span class="text-emerald-300 font-bold">{doc.workedExample.expectedOutput}</span>
        </div>
      </div>
    </div>
  )}

  <!-- Steps & Use Cases Grid -->
  <div class="grid gap-6 md:grid-cols-2">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
      <h2 class="text-base font-bold text-white m-0">Step-by-Step Workflow</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-5 text-xs sm:text-sm text-slate-300">
        {steps.map((s) => (
          <li><strong class="text-white">{s.title}:</strong> {s.detail}</li>
        ))}
      </ol>
    </div>
    <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
      <h2 class="text-base font-bold text-white m-0">Industry & Academic Use Cases</h2>
      <ul class="mt-3 space-y-2 text-xs sm:text-sm text-slate-300">
        {useCases.map((u) => (
          <li><strong class="text-indigo-300">{u.role}:</strong> {u.scenario}</li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Benchmarks if available in doc -->
  {doc && doc.benchmarks && doc.benchmarks.length > 0 && (
    <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 space-y-3">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider m-0">
        Performance & Scale Benchmarks
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
        {doc.benchmarks.map((b) => (
          <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between">
            <span class="font-semibold text-purple-300">{b.label}</span>
            <span class="text-slate-400 font-mono">{b.value}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Frequently Asked Questions -->
  <div>
    <h2 class="text-lg sm:text-xl font-bold text-white mb-4">Frequently Asked Questions — {toolName}</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {faqs.map((f) => (
        <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-4">
          <h3 class="text-sm font-bold text-white m-0">{f.question}</h3>
          <p class="mt-1.5 text-xs text-slate-400 m-0 leading-relaxed">{f.answer}</p>
        </div>
      ))}
    </div>
  </div>
</section>
