---
import { categories } from "../data/tools";
import ToolIcon from "./icons/ToolIcon.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<aside id="app-sidebar" class="fixed top-0 left-0 z-[150] h-full flex flex-col border-r border-surface bg-surface-nav backdrop-blur-2xl transition-all duration-300 sidebar-collapsed:w-[62px] sidebar-expanded:w-[240px] w-[240px] -translate-x-full lg:translate-x-0" aria-label="Sidebar navigation">
  
  <!-- Sidebar Header: Logo + Toggle (behind navbar on desktop) -->
  <div class="flex items-center justify-between h-14 sm:h-16 px-3 shrink-0 border-b border-surface">
    <a href="/" class="sidebar-expanded-only flex items-center gap-2 group overflow-hidden">
      <span class="text-lg font-black tracking-tight bg-gradient-to-r from-purple-300 via-purple-200 to-white bg-clip-text text-transparent whitespace-nowrap">NumanX</span>
    </a>
    <a href="/" class="sidebar-collapsed-only flex items-center justify-center w-8 h-8 rounded-lg hover:bg-surface-3 transition-all" data-tooltip="Home">
      <span class="text-sm font-black bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text text-transparent">N</span>
    </a>
    <button id="sidebar-toggle" class="w-7 h-7 rounded-lg flex items-center justify-center text-tertiary hover:text-white hover:bg-surface-3 transition-all cursor-pointer sidebar-collapsed-only" data-tooltip="Expand sidebar" aria-label="Toggle sidebar">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <button id="sidebar-collapse-btn" class="w-7 h-7 rounded-lg flex items-center justify-center text-tertiary hover:text-white hover:bg-surface-3 transition-all cursor-pointer sidebar-expanded-only" data-tooltip="Collapse sidebar" aria-label="Collapse sidebar">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><polyline points="15 18 9 12 15 6"/></svg>
    </button>
  </div>

  <!-- Main Navigation -->
  <nav class="flex-1 overflow-y-auto scrollbar-hide py-3 px-2 space-y-0.5">
    <p class="sidebar-expanded-only text-[10px] font-semibold text-muted uppercase tracking-widest px-3 pb-1.5">Navigation</p>
    
    <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-tertiary hover:text-white hover:bg-surface-3 transition-all group">
      <svg class="w-[18px] h-[18px] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span class="sidebar-expanded-only truncate">Home</span>
    </a>

    <a href="/tools/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-tertiary hover:text-white hover:bg-surface-3 transition-all group">
      <svg class="w-[18px] h-[18px] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      <span class="sidebar-expanded-only truncate">All Tools</span>
    </a>

    <a href="/dashboard/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-tertiary hover:text-white hover:bg-surface-3 transition-all group">
      <svg class="w-[18px] h-[18px] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      <span class="sidebar-expanded-only truncate">Dashboard</span>
    </a>

    <a href="/blog/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-tertiary hover:text-white hover:bg-surface-3 transition-all group">
      <svg class="w-[18px] h-[18px] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="8" y2="18"/><line x1="16" y1="13" x2="8" y2="13"/></svg>
      <span class="sidebar-expanded-only truncate">Blog</span>
    </a>

    <a href="/favorites/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-tertiary hover:text-white hover:bg-surface-3 transition-all group">
      <svg class="w-[18px] h-[18px] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      <span class="sidebar-expanded-only truncate">Favorites</span>
    </a>

    <a href="/recommended/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-tertiary hover:text-white hover:bg-surface-3 transition-all group">
      <svg class="w-[18px] h-[18px] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
      <span class="sidebar-expanded-only truncate">Recommended</span>
    </a>

    <a href="/about/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-tertiary hover:text-white hover:bg-surface-3 transition-all group">
      <svg class="w-[18px] h-[18px] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      <span class="sidebar-expanded-only truncate">About</span>
    </a>

    <!-- Categories Section -->
    <div class="pt-4 mt-2 border-t border-surface">
      <p class="sidebar-expanded-only text-[10px] font-semibold text-muted uppercase tracking-widest px-3 pb-1.5">Categories</p>
      
      {categories.map((cat) => (
        <a href={`/category/${cat.id}/`} class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm text-tertiary hover:text-white hover:bg-surface-3 transition-all group" data-tooltip={cat.title}>
          <ToolIcon name={cat.icon} class="w-[18px] h-[18px] shrink-0" />
          <span class="sidebar-expanded-only flex-1 truncate">{cat.title}</span>
          <span class="sidebar-expanded-only text-[10px] font-mono text-muted bg-surface-2 px-1.5 py-0.5 rounded-md">{cat.count}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- Sidebar Footer: Theme Toggle -->
  <div class="shrink-0 px-3 py-3 border-t border-surface flex items-center justify-between">
    <div class="sidebar-expanded-only flex items-center gap-2">
      <ThemeToggle />
      <span class="text-xs text-tertiary sidebar-expanded-only">Theme</span>
    </div>
    <div class="sidebar-collapsed-only">
      <ThemeToggle />
    </div>
  </div>

</aside>

<!-- Mobile Overlay -->
<div id="sidebar-overlay" class="fixed inset-0 z-[140] bg-black/50 backdrop-blur-sm hidden lg:hidden" aria-hidden="true"></div>

<style>
  /* Collapsed state via class on html/body */
  .sidebar-collapsed .sidebar-expanded-only { display: none; }
  .sidebar-collapsed .sidebar-collapsed-only { display: flex; }
  :not(.sidebar-collapsed) .sidebar-expanded-only { display: flex; }
  :not(.sidebar-collapsed) .sidebar-collapsed-only { display: none; }

  .sidebar-collapsed #app-sidebar { width: 62px; }
  :not(.sidebar-collapsed) #app-sidebar { width: 240px; }

  /* On mobile, sidebar is hidden by default and slides in */
  @media (max-width: 1023px) {
    #app-sidebar { transform: translateX(-100%); }
    #app-sidebar.sidebar-mobile-open { transform: translateX(0); }
    #sidebar-overlay.sidebar-mobile-open { display: block; }
  }

  /* On desktop, sidebar is always visible */
  @media (min-width: 1024px) {
    #app-sidebar { transform: translateX(0); }
  }
</style>

<script>
  const sidebar = document.getElementById("app-sidebar");
  const overlay = document.getElementById("sidebar-overlay");
  const toggleBtn = document.getElementById("sidebar-toggle");
  const collapseBtn = document.getElementById("sidebar-collapse-btn");
  const html = document.documentElement;

  // Restore sidebar state from localStorage
  const saved = localStorage.getItem("sidebar_collapsed");
  if (saved === "true" && window.innerWidth >= 1024) {
    html.classList.add("sidebar-collapsed");
  }

  // Toggle sidebar on desktop
  toggleBtn?.addEventListener("click", () => {
    html.classList.remove("sidebar-collapsed");
    localStorage.setItem("sidebar_collapsed", "false");
  });
  collapseBtn?.addEventListener("click", () => {
    html.classList.add("sidebar-collapsed");
    localStorage.setItem("sidebar_collapsed", "true");
  });

  // Mobile sidebar toggle (triggered from navbar hamburger)
  function toggleMobileSidebar() {
    sidebar.classList.toggle("sidebar-mobile-open");
    overlay.classList.toggle("sidebar-mobile-open");
    document.body.classList.toggle("overflow-hidden");
  }

  overlay?.addEventListener("click", toggleMobileSidebar);

  // Expose for navbar hamburger to call
  window.__toggleSidebar = toggleMobileSidebar;

  // Close sidebar on escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      if (sidebar.classList.contains("sidebar-mobile-open")) {
        toggleMobileSidebar();
      }
    }
  });

  // Close sidebar on route change (view transitions)
  document.addEventListener("astro:before-preparation", () => {
    if (sidebar.classList.contains("sidebar-mobile-open")) {
      sidebar.classList.remove("sidebar-mobile-open");
      overlay.classList.remove("sidebar-mobile-open");
      document.body.classList.remove("overflow-hidden");
    }
  });
</script>
