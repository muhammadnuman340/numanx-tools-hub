---
import HowToUse from './HowToUse.astro';
import RelatedPosts from './RelatedPosts.astro';
import MonetizationSlot from './MonetizationSlot.astro';
import ProToolDocs from './ProToolDocs.astro';
import AuthorCard from './AuthorCard.astro';
import { getRelatedTools } from '../data/tools';

const guideModules = import.meta.glob('../pages/guides/*.md', { eager: true });
const comparisonModules = import.meta.glob('../pages/comparisons/*.md', { eager: true });

const allGuides = Object.entries(guideModules).map(([path, mod]: any) => ({
  slug: path.replace('../pages/guides/', '').replace('.md', ''),
  frontmatter: mod?.frontmatter || {},
}));

const allComparisons = Object.entries(comparisonModules).map(([path, mod]: any) => ({
  slug: path.replace('../pages/comparisons/', '').replace('.md', ''),
  frontmatter: mod?.frontmatter || {},
}));

interface BenefitItem {
  icon: string;
  title: string;
  desc: string;
}

interface HowToStep {
  num: string;
  title: string;
  desc: string;
}

interface UseCase {
  icon: string;
  title: string;
  desc: string;
}

interface Props {
  toolSlug: string;
  toolName: string;
  category: string;
  benefits?: BenefitItem[];
  howToSteps?: HowToStep[];
  useCases?: UseCase[];
  faq?: Array<{ question: string; answer: string }>;
}

const { toolSlug = '', toolName = '', category = '', benefits, howToSteps, useCases, faq } = Astro.props;

const matchesTool = (fm: any) =>
  fm && Array.isArray(fm.tags) && fm.tags.some((t: string) => toolSlug.includes(t) || toolSlug === t);
const relatedGuides = allGuides.filter((g) => matchesTool(g.frontmatter)).slice(0, 2);
const relatedComparisons = allComparisons.filter((c) => matchesTool(c.frontmatter)).slice(0, 2);

// One related-tools block per page (UI plan Phase 3): shown here as the 'Next step' row
const nextTools = getRelatedTools(toolSlug, 3);
---

<!-- ─── Next step: related tools + feedback (replaces the separate Related Tools block) ─── -->
{
  nextTools.length > 0 && (
    <section class="mt-10 max-w-5xl mx-auto" aria-labelledby="next-step-heading">
      <div class="rounded-2xl border border-line bg-panel px-4 py-4 sm:px-5 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 min-w-0">
          <h2 id="next-step-heading" class="font-mono text-[11px] uppercase tracking-wider text-faint">Next step</h2>
          {nextTools.map((t) => (
            <a href={t.url} class="inline-flex items-center gap-1 min-h-9 text-sm font-medium text-accent hover:text-fg transition-colors">
              {t.name} <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
        <button
          type="button"
          data-open-feedback
          class="self-start lg:self-auto inline-flex items-center min-h-9 px-3 rounded-lg border border-line text-soft hover:text-fg hover:border-line-strong text-xs font-medium transition-colors cursor-pointer"
        >
          Was this useful? Send feedback
        </button>
      </div>
    </section>
  )
}


<!-- ─── Benefits Section ─── -->{
  benefits && benefits.length > 0 && (
    <section class="mt-16">
      <div class="text-center mb-10">
        <span class="text-xs font-semibold text-amber-400">Why Use This Tool</span>
        <h2 class="text-2xl md:text-3xl font-black tracking-tight mt-1">
          Benefits of Using
          <span class="text-amber-400"> {toolName}</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto">
        {benefits.map((b) => (
          <div class="rounded-xl border border-surface bg-surface-1 p-5 hover:border-surface-3 transition-all duration-300">
            <div class="flex items-start gap-3">
              <span class="text-xl mt-0.5 shrink-0">{b.icon}</span>
              <div>
                <h3 class="text-sm font-semibold text-primary mb-1">{b.title}</h3>
                <p class="text-xs text-muted leading-relaxed">{b.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}

<!-- ─── How To Use Section ─── -->
{howToSteps && howToSteps.length > 0 && <HowToUse steps={howToSteps} />}

<!-- ─── Use Cases Section ─── -->
{
  useCases && useCases.length > 0 && (
    <section class="mt-16">
      <div class="text-center mb-10">
        <span class="text-xs font-semibold text-amber-400">Applications</span>
        <h2 class="text-2xl md:text-3xl font-black tracking-tight mt-1">
          Common
          <span class="text-amber-400"> Use Cases</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-4xl mx-auto">
        {useCases.map((uc) => (
          <div class="rounded-xl border border-surface bg-surface-1 p-5 hover:border-surface-3 transition-all duration-300">
            <div class="flex items-start gap-3">
              <span class="text-lg mt-0.5 shrink-0">{uc.icon}</span>
              <div>
                <h3 class="text-sm font-semibold text-primary mb-1">{uc.title}</h3>
                <p class="text-xs text-muted leading-relaxed">{uc.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}

<!-- ─── Verifiable Technical Documentation & Mathematical Architecture (AEO / GEO) ─── -->
<ProToolDocs slug={toolSlug} toolName={toolName} category={category} faqs={faq} />

<!-- ─── Contextual Monetization & Support ─── -->
<section class="mt-12">
  <div class="max-w-4xl mx-auto space-y-4">
    <MonetizationSlot
      slotType="post-tool-affiliate"
      category={category.toLowerCase().includes('cricket') ? 'cricket' : category.toLowerCase().includes('image') ? 'image' : category.toLowerCase().includes('creator') ? 'creator' : category.toLowerCase().includes('dev') ? 'developer' : category.toLowerCase().includes('ai') ? 'ai' : 'utility'}
    />
    <MonetizationSlot slotType="pakistan-support-bar" />
  </div>
</section>

<!-- ─── Related Guides ─── -->
{
  relatedGuides.length > 0 && (
    <section class="mt-10">
      <div class="max-w-4xl mx-auto">
        <h3 class="text-sm font-semibold text-zinc-300 mb-4">Related Guides</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {relatedGuides
            .map((guide) => (
              <a
                href={`/guides/${guide.slug}/`}
                class="group rounded-xl border border-surface bg-surface-1 p-4 hover:border-amber-500/40 transition-all duration-300"
              >
                <p class="text-xs font-medium text-amber-400">{guide.frontmatter.category}</p>
                <h4 class="text-sm font-semibold text-primary group-hover:text-white mt-1 transition-colors">
                  {guide.frontmatter.title}
                </h4>
                <p class="text-xs text-muted mt-1 line-clamp-2">{guide.frontmatter.description}</p>
              </a>
            ))}
        </div>
      </div>
    </section>
  )
}

<!-- ─── Related Comparisons ─── -->
{
  relatedComparisons.length > 0 && (
    <section class="mt-6">
      <div class="max-w-4xl mx-auto">
        <h3 class="text-sm font-semibold text-zinc-300 mb-4">Comparisons</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {relatedComparisons
            .map((comp) => (
              <a
                href={`/comparisons/${comp.slug}/`}
                class="group rounded-xl border border-surface bg-surface-1 p-4 hover:border-amber-500/40 transition-all duration-300"
              >
                <span class="text-xs text-amber-400 font-medium">VS</span>
                <h4 class="text-sm font-semibold text-primary group-hover:text-white mt-1 transition-colors">
                  {comp.frontmatter.title}
                </h4>
                <p class="text-xs text-muted mt-1 line-clamp-2">{comp.frontmatter.description}</p>
              </a>
            ))}
        </div>
      </div>
    </section>
  )
}

<!-- ─── E-E-A-T Author Card ─── -->
<section class="mt-12">
  <div class="max-w-4xl mx-auto">
    <AuthorCard />
  </div>
</section>

<!-- ─── Related Articles ─── -->
<RelatedPosts currentSlug={toolSlug} category={category} />

