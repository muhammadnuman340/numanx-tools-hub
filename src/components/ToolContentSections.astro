---
import HowToUse from "./HowToUse.astro";
import RelatedPosts from "./RelatedPosts.astro";
import AdUnit from "./AdUnit.astro";
import AuthorCard from "./AuthorCard.astro";
import PopularTools from "./PopularTools.astro";
import RecentlyUsed from "./RecentlyUsed.astro";
import ExploreMore from "./ExploreMore.astro";

const guideModules = import.meta.glob("../pages/guides/*.md", { eager: true });
const comparisonModules = import.meta.glob("../pages/comparisons/*.md", { eager: true });

const allGuides = Object.entries(guideModules).map(([path, mod]: any) => ({
  slug: path.replace("../pages/guides/", "").replace(".md", ""),
  frontmatter: mod?.frontmatter || {},
}));

const allComparisons = Object.entries(comparisonModules).map(([path, mod]: any) => ({
  slug: path.replace("../pages/comparisons/", "").replace(".md", ""),
  frontmatter: mod?.frontmatter || {},
}));

interface BenefitItem {
  icon: string;
  title: string;
  desc: string;
}

interface HowToStep {
  num: string;
  title: string;
  desc: string;
}

interface UseCase {
  icon: string;
  title: string;
  desc: string;
}

interface Props {
  toolSlug: string;
  toolName: string;
  category: string;
  benefits?: BenefitItem[];
  howToSteps?: HowToStep[];
  useCases?: UseCase[];
  faq?: Array<{ question: string; answer: string }>;
}

const { toolSlug, toolName, category, benefits, howToSteps, useCases } = Astro.props;
---

<!-- ─── Benefits Section ─── -->
{benefits && benefits.length > 0 && (
  <section class="mt-16">
    <div class="text-center mb-10">
      <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Why Use This Tool</span>
      <h2 class="text-2xl md:text-3xl font-black tracking-tight mt-1">
        Benefits of Using
        <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent"> {toolName}</span>
      </h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto">
      {benefits.map((b) => (
        <div class="rounded-xl border border-surface bg-surface-1 p-5 hover:border-surface-3 transition-all duration-300">
          <div class="flex items-start gap-3">
            <span class="text-xl mt-0.5 shrink-0">{b.icon}</span>
            <div>
              <h3 class="text-sm font-semibold text-primary mb-1">{b.title}</h3>
              <p class="text-xs text-muted leading-relaxed">{b.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<!-- ─── How To Use Section ─── -->
{howToSteps && howToSteps.length > 0 && (
  <HowToUse steps={howToSteps} />
)}

<!-- ─── Use Cases Section ─── -->
{useCases && useCases.length > 0 && (
  <section class="mt-16">
    <div class="text-center mb-10">
      <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Applications</span>
      <h2 class="text-2xl md:text-3xl font-black tracking-tight mt-1">
        Common
        <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent"> Use Cases</span>
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-4xl mx-auto">
      {useCases.map((uc) => (
        <div class="rounded-xl border border-surface bg-surface-1 p-5 hover:border-surface-3 transition-all duration-300">
          <div class="flex items-start gap-3">
            <span class="text-lg mt-0.5 shrink-0">{uc.icon}</span>
            <div>
              <h3 class="text-sm font-semibold text-primary mb-1">{uc.title}</h3>
              <p class="text-xs text-muted leading-relaxed">{uc.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<!-- ─── Info Section ─── -->
<section class="mt-12">
  <div class="max-w-4xl mx-auto">
    <AdUnit format="horizontal" />
  </div>
</section>

<!-- ─── Related Guides ─── -->
{allGuides.length > 0 && (
  <section class="mt-10">
    <div class="max-w-4xl mx-auto">
      <h3 class="text-sm font-semibold text-muted uppercase tracking-wider mb-4">Related Guides</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {allGuides.filter(g => g.frontmatter && g.frontmatter.tags && g.frontmatter.tags.some(t => toolSlug.includes(t) || toolSlug === t)).slice(0, 2).map(guide => (
          <a href={`/guides/${guide.slug}/`} class="group rounded-xl border border-surface bg-surface-1 p-4 hover:border-purple-500/40 transition-all duration-300">
            <p class="text-xs font-medium text-purple-400">{guide.frontmatter.category}</p>
            <h4 class="text-sm font-semibold text-primary group-hover:text-white mt-1 transition-colors">{guide.frontmatter.title}</h4>
            <p class="text-xs text-muted mt-1 line-clamp-2">{guide.frontmatter.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- ─── Related Comparisons ─── -->
{allComparisons.length > 0 && (
  <section class="mt-6">
    <div class="max-w-4xl mx-auto">
      <h3 class="text-sm font-semibold text-muted uppercase tracking-wider mb-4">Comparisons</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {allComparisons.filter(c => c.frontmatter && c.frontmatter.tags && c.frontmatter.tags.some(t => toolSlug.includes(t) || toolSlug === t)).slice(0, 2).map(comp => (
          <a href={`/comparisons/${comp.slug}/`} class="group rounded-xl border border-surface bg-surface-1 p-4 hover:border-purple-500/40 transition-all duration-300">
            <span class="text-[10px] text-purple-400 font-medium">VS</span>
            <h4 class="text-sm font-semibold text-primary group-hover:text-white mt-1 transition-colors">{comp.frontmatter.title}</h4>
            <p class="text-xs text-muted mt-1 line-clamp-2">{comp.frontmatter.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- ─── E-E-A-T Author Card ─── -->
<section class="mt-12">
  <div class="max-w-4xl mx-auto">
    <AuthorCard />
  </div>
</section>

<!-- ─── Related Articles ─── -->
<RelatedPosts currentSlug={toolSlug} category={category} />

<!-- ─── Conversion Widgets Grid ─── -->
<section class="mt-12">
  <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-4">
    <PopularTools limit={4} />
    <RecentlyUsed limit={4} />
    <ExploreMore currentCategory={category} />
  </div>
</section>
