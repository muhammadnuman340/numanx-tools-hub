---
// CookieConsent.astro
---

<div
  id="cookie-consent-banner"
  class="fixed bottom-0 left-0 w-full z-[99999] transform translate-y-full transition-transform duration-500 ease-in-out"
>
  <div class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8">
    <div
      class="bg-[#0a0a0c]/95 backdrop-blur-xl border border-white/10 p-6 sm:p-8 rounded-3xl shadow-2xl flex flex-col lg:flex-row items-center gap-6 justify-between"
    >
      <div class="flex-1">
        <div class="flex items-center gap-3 mb-3">
          <div class="p-2 bg-purple-500/20 rounded-lg">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#a855f7"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"
              ></path>
              <path d="M8.5 8.5v.01"></path>
              <path d="M16 12.5v.01"></path>
              <path d="M12 16v.01"></path>
              <path d="M11 12.5v.01"></path>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-white tracking-tight">Your Privacy Matters</h2>
        </div>
        <p class="text-sm text-zinc-400 leading-relaxed max-w-3xl">
          We use cookies and similar technologies to personalize content and ads, provide social media features, and
          analyze our traffic. We also share information about your use of our site with our social media, advertising
          and analytics partners. By clicking "Accept All", you agree to the storing of cookies on your device.
          <a href="/privacy-policy/" class="text-purple-400 hover:text-purple-300 underline underline-offset-4 ml-1">
            Read Privacy Policy
          </a>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto shrink-0">
        <button
          id="btn-decline-cookies"
          class="px-6 py-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white font-semibold text-sm transition-all whitespace-nowrap"
        >
          Essential Only
        </button>
        <button
          id="btn-accept-cookies"
          class="px-6 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm transition-all shadow-lg shadow-purple-900/30 whitespace-nowrap"
        >
          Accept All
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const banner = document.getElementById('cookie-consent-banner');
    const btnAccept = document.getElementById('btn-accept-cookies');
    const btnDecline = document.getElementById('btn-decline-cookies');

    if (!banner || !btnAccept || !btnDecline) return;

    const consentStatus = localStorage.getItem('nx_cookie_consent');

    if (!consentStatus) {
      // Small delay for entrance animation
      setTimeout(() => {
        banner.classList.remove('translate-y-full');
      }, 500);
    }

    const closeBanner = () => {
      banner.classList.add('translate-y-full');
      setTimeout(() => {
        banner.style.display = 'none';
      }, 500);
    };

    btnAccept.addEventListener('click', () => {
      localStorage.setItem('nx_cookie_consent', 'accepted');
      closeBanner();
    });

    btnDecline.addEventListener('click', () => {
      localStorage.setItem('nx_cookie_consent', 'declined');
      closeBanner();
    });
  });
</script>
