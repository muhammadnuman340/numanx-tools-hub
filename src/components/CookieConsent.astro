---
// CookieConsent.astro — Centralized Consent UI (Phase 5C.2B)
---

<!--
  Compact consent bar (UI plan Phase 1): one line on desktop, fully inside the screen on phones.
  Ids, aria labels and the consent script below are unchanged.
-->
<div
  id="cookie-consent-banner"
  role="region"
  aria-label="Cookie and Privacy Consent"
  class="fixed bottom-0 left-0 w-full z-[99999] transform translate-y-full transition-transform duration-500 ease-in-out hidden"
  style="display: none;"
>
  <div class="mx-auto max-w-5xl px-3 sm:px-4 pt-2" style="padding-bottom: max(12px, env(safe-area-inset-bottom, 0px));">
    <div
      class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-5 bg-[#0a0a0c] border border-white/10 rounded-2xl px-4 py-3 shadow-2xl"
    >
      <p class="flex-1 min-w-0 text-[13px] leading-snug text-zinc-300">
        We use essential cookies to run the site. Choose "Accept all" to also allow optional analytics and
        advertising cookies.
        <a href="/privacy-policy/" class="text-purple-300 hover:text-white underline underline-offset-4">Privacy policy</a>
      </p>
      <div class="grid grid-cols-2 gap-2 sm:flex sm:shrink-0">
        <button
          type="button"
          id="btn-decline-cookies"
          class="min-h-11 px-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/15 text-white font-semibold text-sm transition-colors whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0a0c] cursor-pointer"
          aria-label="Allow essential cookies only and deny optional tracking"
        >
          Essential only
        </button>
        <button
          type="button"
          id="btn-accept-cookies"
          class="min-h-11 px-4 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm transition-colors whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0a0c] cursor-pointer"
          aria-label="Accept all cookies and optional tracking"
        >
          Accept all
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { setConsent, hasConsentDecision, OPEN_SETTINGS_EVENT } from '../lib/consent';

  function openBannerElement(banner: HTMLElement, focusTarget?: HTMLElement | null) {
    banner.style.display = 'block';
    banner.classList.remove('hidden');
    // Ensure styles are applied before animating entrance
    requestAnimationFrame(() => {
      banner.classList.remove('translate-y-full');
      focusTarget?.focus();
    });
  }

  function closeBannerElement(banner: HTMLElement) {
    banner.classList.add('translate-y-full');
    setTimeout(() => {
      banner.style.display = 'none';
      banner.classList.add('hidden');
    }, 500);
  }

  function initCookieConsent() {
    const banner = document.getElementById('cookie-consent-banner') as HTMLElement | null;
    const btnAccept = document.getElementById('btn-accept-cookies') as HTMLButtonElement | null;
    const btnDecline = document.getElementById('btn-decline-cookies') as HTMLButtonElement | null;

    if (!banner || !btnAccept || !btnDecline) return;

    if (!hasConsentDecision()) {
      setTimeout(() => {
        openBannerElement(banner, btnDecline);
      }, 500);
    } else {
      banner.style.display = 'none';
      banner.classList.add('hidden');
      banner.classList.add('translate-y-full');
    }

    btnAccept.onclick = () => {
      setConsent('accepted');
      closeBannerElement(banner);
    };

    btnDecline.onclick = () => {
      setConsent('essential');
      closeBannerElement(banner);
    };
  }

  // Global handler for reopening cookie settings across page navigation
  if (typeof window !== 'undefined' && !(window as any).__nx_consent_init) {
    (window as any).__nx_consent_init = true;
    window.addEventListener(OPEN_SETTINGS_EVENT, () => {
      const banner = document.getElementById('cookie-consent-banner') as HTMLElement | null;
      const btnDecline = document.getElementById('btn-decline-cookies') as HTMLButtonElement | null;
      if (banner) {
        openBannerElement(banner, btnDecline);
      }
    });
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCookieConsent);
    } else {
      initCookieConsent();
    }
    document.addEventListener('astro:page-load', initCookieConsent);
  }
</script>
