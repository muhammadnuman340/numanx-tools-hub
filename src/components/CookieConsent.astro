---
// CookieConsent.astro — Centralized Consent UI (Phase 5C.2B)
---

<div
  id="cookie-consent-banner"
  role="region"
  aria-label="Cookie and Privacy Consent"
  class="fixed bottom-0 left-0 w-full z-[99999] transform translate-y-full transition-transform duration-500 ease-in-out hidden"
  style="display: none;"
>
  <div class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8">
    <div
      class="bg-[#0a0a0c]/95 backdrop-blur-xl border border-white/10 p-6 sm:p-8 rounded-3xl shadow-2xl flex flex-col lg:flex-row items-center gap-6 justify-between"
    >
      <div class="flex-1">
        <div class="flex items-center gap-3 mb-3">
          <div class="p-2 bg-purple-500/20 rounded-lg" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#a855f7"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"
              ></path>
              <path d="M8.5 8.5v.01"></path>
              <path d="M16 12.5v.01"></path>
              <path d="M12 16v.01"></path>
              <path d="M11 12.5v.01"></path>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-white tracking-tight">Your Privacy Matters</h2>
        </div>
        <p class="text-sm text-zinc-400 leading-relaxed max-w-3xl">
          We use cookies and similar technologies to support essential functionality, personalize content, and
          analyze our traffic. Choose "Accept All" to enable optional analytics and advertising, or "Essential Only"
          to continue with strictly necessary functions.
          <a href="/privacy-policy/" class="text-purple-400 hover:text-purple-300 underline underline-offset-4 ml-1">
            Read Privacy Policy
          </a>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto shrink-0">
        <button
          type="button"
          id="btn-decline-cookies"
          class="px-6 py-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white font-semibold text-sm transition-all whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-purple-400 focus:ring-offset-2 focus:ring-offset-[#0a0a0c] cursor-pointer"
          aria-label="Allow essential cookies only and deny optional tracking"
        >
          Essential Only
        </button>
        <button
          type="button"
          id="btn-accept-cookies"
          class="px-6 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm transition-all shadow-lg shadow-purple-900/30 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-purple-400 focus:ring-offset-2 focus:ring-offset-[#0a0a0c] cursor-pointer"
          aria-label="Accept all cookies and optional tracking"
        >
          Accept All
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { setConsent, hasConsentDecision, OPEN_SETTINGS_EVENT } from '../lib/consent';

  function openBannerElement(banner: HTMLElement, focusTarget?: HTMLElement | null) {
    banner.style.display = 'block';
    banner.classList.remove('hidden');
    // Ensure styles are applied before animating entrance
    requestAnimationFrame(() => {
      banner.classList.remove('translate-y-full');
      focusTarget?.focus();
    });
  }

  function closeBannerElement(banner: HTMLElement) {
    banner.classList.add('translate-y-full');
    setTimeout(() => {
      banner.style.display = 'none';
      banner.classList.add('hidden');
    }, 500);
  }

  function initCookieConsent() {
    const banner = document.getElementById('cookie-consent-banner') as HTMLElement | null;
    const btnAccept = document.getElementById('btn-accept-cookies') as HTMLButtonElement | null;
    const btnDecline = document.getElementById('btn-decline-cookies') as HTMLButtonElement | null;

    if (!banner || !btnAccept || !btnDecline) return;

    if (!hasConsentDecision()) {
      setTimeout(() => {
        openBannerElement(banner, btnDecline);
      }, 500);
    } else {
      banner.style.display = 'none';
      banner.classList.add('hidden');
      banner.classList.add('translate-y-full');
    }

    btnAccept.onclick = () => {
      setConsent('accepted');
      closeBannerElement(banner);
    };

    btnDecline.onclick = () => {
      setConsent('essential');
      closeBannerElement(banner);
    };
  }

  // Global handler for reopening cookie settings across page navigation
  if (typeof window !== 'undefined' && !(window as any).__nx_consent_init) {
    (window as any).__nx_consent_init = true;
    window.addEventListener(OPEN_SETTINGS_EVENT, () => {
      const banner = document.getElementById('cookie-consent-banner') as HTMLElement | null;
      const btnDecline = document.getElementById('btn-decline-cookies') as HTMLButtonElement | null;
      if (banner) {
        openBannerElement(banner, btnDecline);
      }
    });
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCookieConsent);
    } else {
      initCookieConsent();
    }
    document.addEventListener('astro:page-load', initCookieConsent);
  }
</script>
