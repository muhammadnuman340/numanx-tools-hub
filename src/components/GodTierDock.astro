---
// GodTierDock.astro — fixed bottom navigation dock
interface Props {
  noBorder?: boolean;
}

const { noBorder } = Astro.props;
---

<nav
  class="fixed bottom-0 left-0 right-0 z-[200] bg-[#050505]/80 backdrop-blur-xl border-t border-white/5"
  aria-label="Main navigation"
>
  <div class="max-w-5xl mx-auto flex items-center justify-center gap-1 sm:gap-2 px-3 py-2 sm:py-3">
    <a
      href="/"
      class="flex flex-col items-center gap-0.5 px-3 sm:px-5 py-2 rounded-xl text-zinc-500 hover:text-white hover:bg-white/5 transition-all text-[10px] font-semibold tracking-wider"
      aria-label="Home"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span>Home</span>
    </a>
    <a
      href="/tools/"
      class="flex flex-col items-center gap-0.5 px-3 sm:px-5 py-2 rounded-xl text-zinc-500 hover:text-white hover:bg-white/5 transition-all text-[10px] font-semibold tracking-wider"
      aria-label="Tools"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      <span>Tools</span>
    </a>
    <button
      onclick="window.openGlobalSearch && window.openGlobalSearch()"
      class="flex flex-col items-center gap-0.5 px-3 sm:px-5 py-2 rounded-xl text-zinc-500 hover:text-amber-400 hover:bg-amber-500/5 transition-all text-[10px] font-semibold tracking-wider"
      aria-label="Search"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <span>Search</span>
    </button>
    <button
      onclick="window.startJarvisVoice && window.startJarvisVoice()"
      class="flex flex-col items-center gap-0.5 px-3 sm:px-5 py-2 rounded-xl text-zinc-500 hover:text-amber-400 hover:bg-amber-500/5 transition-all text-[10px] font-semibold tracking-wider"
      aria-label="Voice"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
      <span>Voice</span>
    </button>
    <a
      href="/favorites/"
      class="flex flex-col items-center gap-0.5 px-3 sm:px-5 py-2 rounded-xl text-zinc-500 hover:text-white hover:bg-white/5 transition-all text-[10px] font-semibold tracking-wider"
      aria-label="Favorites"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      <span>Favorites</span>
    </a>
  </div>
</nav>
