---
interface Props {
  slot?: string;
  format?: string;
  class?: string;
  style?: string;
}

const ADSENSE_ID = import.meta.env.PUBLIC_ADSENSE_ID || '';
const { slot = '', format = 'auto', class: className, style } = Astro.props;
---

{
  ADSENSE_ID && slot && (
    <aside aria-label="Advertisement" class={`relative overflow-hidden rounded-2xl border border-white/[0.06] bg-white/[0.02] min-h-[100px] flex items-center justify-center ${className || ''}`}>
      <ins class="adsbygoogle"
        style={`display:block;${style || ''}`}
        data-ad-client={ADSENSE_ID}
        data-ad-slot={slot}
        data-ad-format={format}
        data-full-width-responsive="true"
      />
      <script>{(adsbygoogle = window.adsbygoogle || []).push({})}</script>
    </aside>
  )
}
