---
// FILE: src/components/AdUnit.astro
// Clean Monetization Fallback Engine — Phase 5C.2D (AdSense Fully Deactivated)
import MonetizationSlot from './MonetizationSlot.astro';

interface Props {
  slot?: string;
  format?: 'auto' | 'horizontal' | 'vertical' | 'rectangle' | 'leaderboard' | 'in-feed';
  class?: string;
  style?: string;
  category?: string;
}

const { format = 'horizontal', class: className = '', category = 'utility' } = Astro.props;
const resolvedFormat: 'horizontal' | 'vertical' | 'rectangle' | 'leaderboard' | 'in-feed' =
  format === 'auto' ? 'horizontal' : format;
---

<MonetizationSlot slotType="in-content-banner" format={resolvedFormat} category={category} class={className} />
