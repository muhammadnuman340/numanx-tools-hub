---
import ToolIcon from './icons/ToolIcon.astro';
import { tools } from '../data/tools';
import type { Tool } from '../data/tools';

interface Props {
  limit?: number;
  title?: string;
}

const { limit = 4, title = 'Recently Used Tools' } = Astro.props;

let recentlyUsed: Tool[] = [];
try {
  const stored = typeof localStorage !== 'undefined' ? localStorage.getItem('nt_tool_usage') : null;
  if (stored) {
    const usage = JSON.parse(stored);
    const sorted = Object.entries(usage)
      .sort(([, a]: any, [, b]: any) => b - a)
      .slice(0, limit);
    recentlyUsed = sorted.map(([id]) => tools.find((t) => t.id === id)).filter(Boolean) as Tool[];
  }
} catch {}

const fallbackTools = tools.filter((t) => t.isPopular).slice(0, limit);
const displayTools = recentlyUsed.length > 0 ? recentlyUsed : fallbackTools;
---

<div class="rounded-xl border border-surface bg-surface-1 p-5">
  <div class="flex items-center gap-2 mb-4">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-purple-400"
      ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg
    >
    <h3 class="text-xs font-semibold text-zinc-300">{title}</h3>
  </div>
  <div class="space-y-1">
    {
      displayTools.map((tool) => (
        <a
          href={tool.url}
          class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-surface-2 transition-all duration-200 group"
        >
          <span class="w-7 h-7 rounded-lg bg-purple-600/10 flex items-center justify-center text-purple-400 shrink-0">
            <ToolIcon name={tool.icon} />
          </span>
          <div class="min-w-0">
            <p class="text-xs font-medium text-zinc-200 group-hover:text-white transition-colors truncate">
              {tool.name}
            </p>
            <p class="text-xs text-zinc-400 truncate">{tool.description}</p>
          </div>
        </a>
      ))
    }
  </div>
</div>
