---
interface Props {
  steps: Array<{ num: string; title: string; desc: string }>;
}
const { steps } = Astro.props;
---

<section class="mt-16">
  <div class="text-center mb-10">
    <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Quick Start</span>
    <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">
      How to
      <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Use This Tool</span>
    </h2>
  </div>
  <div
    class="grid grid-cols-1 md:grid-cols-{Math.min(steps.length, 4)} gap-6 max-w-4xl mx-auto"
    style={`grid-template-columns: repeat(${Math.min(steps.length, 4)}, minmax(0, 1fr));`}
  >
    {
      steps.map((step) => (
        <div class="text-center p-6 rounded-xl border border-surface bg-surface-1 hover:border-surface-2 transition-all duration-300">
          <div class="w-10 h-10 rounded-full bg-purple-600/20 flex items-center justify-center text-purple-400 text-sm font-bold mx-auto mb-4">
            {step.num}
          </div>
          <h3 class="text-sm font-semibold text-primary">{step.title}</h3>
          <p class="text-xs text-muted mt-2 leading-relaxed">{step.desc}</p>
        </div>
      ))
    }
  </div>
</section>
