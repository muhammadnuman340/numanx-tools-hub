---
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className } = Astro.props;
---

<button
  type="button"
  class:list={[
    'favorite-btn inline-flex items-center gap-1.5 min-h-9 px-3 rounded-lg border border-line text-soft text-xs font-medium transition-colors hover:text-fg hover:border-line-strong cursor-pointer',
    className,
  ]}
  data-slug={slug}
  aria-pressed="false"
  aria-label="Save this tool to favorites"
>
  <svg
    class="favorite-icon w-4 h-4"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
    ></polygon>
  </svg>
  <span class="favorite-text">Save</span>
</button>

<script>
  import { migrateStoredSlugs } from '../lib/retiredSlugs';
  migrateStoredSlugs();

  // Buttons are replaced on every client-side navigation, so bind on astro:page-load
  // (fires on first load too) and mark each button once.
  const KEY = 'nt_favorites';

  const read = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(KEY) || '[]');
    } catch {
      return [];
    }
  };

  function setState(btn: HTMLElement, isFav: boolean) {
    btn.setAttribute('aria-pressed', String(isFav));
    btn.querySelector('.favorite-icon')?.setAttribute('fill', isFav ? 'currentColor' : 'none');
    btn.classList.toggle('text-accent', isFav);
    btn.classList.toggle('border-accent', isFav);
    btn.classList.toggle('text-soft', !isFav);
    const text = btn.querySelector('.favorite-text');
    if (text) text.textContent = isFav ? 'Saved' : 'Save';
  }

  function initFavorites() {
    document.querySelectorAll<HTMLElement>('.favorite-btn').forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      const slug = btn.dataset.slug || '';
      setState(btn, read().includes(slug));
      btn.addEventListener('click', () => {
        const favorites = read();
        const idx = favorites.indexOf(slug);
        if (idx >= 0) favorites.splice(idx, 1);
        else favorites.push(slug);
        try {
          localStorage.setItem(KEY, JSON.stringify(favorites));
        } catch {}
        setState(btn, idx < 0);
      });
    });
  }

  document.addEventListener('astro:page-load', initFavorites);
</script>
