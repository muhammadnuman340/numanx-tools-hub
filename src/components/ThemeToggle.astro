<button id="theme-toggle" class="relative w-8 h-8 rounded-xl bg-surface-2 border border-surface-3 hover:bg-zinc-700 flex items-center justify-center transition-all" aria-label="Toggle theme">
  <svg id="sun-icon" class="w-4 h-4 text-tertiary hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
  <svg id="moon-icon" class="w-4 h-4 text-tertiary hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
</button>

<script>
  const btn = document.getElementById("theme-toggle");
  const html = document.documentElement;
  const sun = document.getElementById("sun-icon");
  const moon = document.getElementById("moon-icon");
  const mq = window.matchMedia("(prefers-color-scheme: light)");

  function getSystemTheme() {
    return mq.matches ? "light" : "dark";
  }

  function resolveTheme() {
    return localStorage.getItem("theme") || getSystemTheme();
  }

  function setTheme(theme) {
    html.setAttribute("data-theme", theme);
    sun.classList.toggle("hidden", theme !== "light");
    moon.classList.toggle("hidden", theme !== "dark");
  }

  btn.addEventListener("click", () => {
    const next = html.getAttribute("data-theme") === "dark" ? "light" : "dark";
    localStorage.setItem("theme", next);
    setTheme(next);
  });

  setTheme(resolveTheme());

  mq.addEventListener("change", () => {
    if (!localStorage.getItem("theme")) setTheme(getSystemTheme());
  });
</script>
