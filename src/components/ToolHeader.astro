---
/**
 * Compact tool header (DESIGN.md §4.1, UI plan Phase 2):
 * breadcrumb → left-aligned H1 with Save/Share on the same row → one short intro line.
 * Keeps the tool workspace within the first ~300px of the page.
 *
 * `title` + `gradient` are kept as props for compatibility; they now render as one plain name.
 * `badge` is shown only when it carries a fact (e.g. an ICC rule), not generic labels.
 */
import FavoriteButton from './FavoriteButton.astro';
import ShareBar from './ShareBar.astro';

interface Props {
  title: string;
  gradient?: string;
  desc: string;
  badge?: string;
  slug?: string;
}
const { title, gradient = '', desc, badge = '', slug } = Astro.props;
const toolDisplayName = `${title} ${gradient}`.replace(/\s+/g, ' ').trim();
const fact = badge.replace(/^[\s✦•·]+/, '').trim();
const showFact = fact.length > 0 && !/^(client[- ]side|free online tool|100% client[- ]side)$/i.test(fact);
---

<header class="tool-header mb-6 sm:mb-8">
  <nav aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm text-soft">
      <li><a href="/" class="hover:text-fg transition-colors">Home</a></li>
      <li class="text-faint select-none" aria-hidden="true">/</li>
      <li><a href="/tools/" class="hover:text-fg transition-colors">Tools</a></li>
      <li class="text-faint select-none" aria-hidden="true">/</li>
      <li class="text-fg font-medium truncate max-w-[60vw]" aria-current="page">{toolDisplayName}</li>
    </ol>
  </nav>

  <div class="mt-3 flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
    <h1 class="min-w-0 text-fg font-extrabold tracking-tight leading-tight text-balance" style="font-size: var(--step-3);">
      {toolDisplayName}
    </h1>
    <div class="flex items-center gap-2 shrink-0 pt-1">
      {slug && <FavoriteButton slug={slug} />}
      <ShareBar />
    </div>
  </div>

  <p class="mt-2 max-w-3xl text-soft text-sm sm:text-base leading-relaxed">{desc}</p>

  {showFact && <p class="mt-2 font-mono text-[11px] uppercase tracking-wider text-faint">{fact}</p>}

  <!-- Live status for screen readers and browser agents; tools update it via src/lib/toolStatus.ts -->
  <div id="tool-status" role="status" aria-live="polite" data-agent-status="ready" class="sr-only"></div>
</header>

<script define:vars={{ slug }}>
  if (slug) {
    try {
      var usage = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
      usage[slug] = (usage[slug] || 0) + 1;
      localStorage.setItem('nt_tool_usage', JSON.stringify(usage));
      var recent = JSON.parse(localStorage.getItem('nt_recently_used') || '[]');
      recent = recent.filter(function (id) {
        return id !== slug;
      });
      recent.unshift(slug);
      if (recent.length > 20) recent = recent.slice(0, 20);
      localStorage.setItem('nt_recently_used', JSON.stringify(recent));
    } catch (e) {}
  }
</script>
