---
interface Hint {
  keys: string;
  label: string;
}
interface Props {
  hints?: Hint[];
}

const { hints = [] } = Astro.props;
---

<div
  class="flex flex-wrap items-center gap-3 px-1 text-xs text-zinc-400 mt-4"
  role="note"
  aria-label="Keyboard shortcuts"
>
  {
    (hints || []).map((h) => (
      <span class="inline-flex items-center gap-1.5">
        <kbd class="key-hint">{h.keys}</kbd>
        <span>{h.label}</span>
      </span>
    ))
  }
</div>
