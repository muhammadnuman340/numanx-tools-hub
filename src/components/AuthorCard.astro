---
interface Props {
  name?: string;
  title?: string;
  avatar?: string;
  url?: string;
}

const {
  name = "Muhammad Numan Usmani",
  title = "Founder & Developer at NumanX Studio",
  avatar,
  url = "/about/",
} = Astro.props;
---

<div class="rounded-xl border border-surface bg-surface-1 p-5">
  <div class="flex items-center gap-4">
    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-600 to-blue-600 flex items-center justify-center text-lg font-bold text-white shrink-0">
      {avatar ? <img src={avatar} alt={name} class="w-full h-full rounded-full object-cover" /> : name.charAt(0)}
    </div>
    <div class="min-w-0">
      <p class="text-sm font-semibold text-primary">{name}</p>
      <p class="text-xs text-muted">{title}</p>
      <div class="flex items-center gap-3 mt-1.5">
        <a href={url} class="text-[11px] text-purple-400 hover:text-purple-300 transition-colors font-medium">About</a>
        <a href="https://github.com/numanxstudio" target="_blank" class="text-[11px] text-purple-400 hover:text-purple-300 transition-colors font-medium">GitHub</a>
        <a href="https://x.com/numanxstudio" target="_blank" class="text-[11px] text-purple-400 hover:text-purple-300 transition-colors font-medium">X</a>
      </div>
    </div>
  </div>
</div>
