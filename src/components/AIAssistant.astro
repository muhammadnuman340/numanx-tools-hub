  }

  // -- Percentage Calculator --
  function pctOf(a, b) {
    return (a / 100) * b;
  }
  function pctIs(a, b) {
    return b !== 0 ? (a / b) * 100 : 0;
  }
  function pctChange(a, b) {
    return a !== 0 ? ((b - a) / Math.abs(a)) * 100 : 0;
  }
  function pctDiff(a, b) {
    const avg = (a + b) / 2;
    return avg !== 0 ? (Math.abs(b - a) / Math.abs(avg)) * 100 : 0;
  }
  function percentageHandler(a, b, mode) {
    let result, label;
    switch (mode) {
      case 'of':
        result = pctOf(a, b);
        label = `${a}% of ${b} = ${result.toFixed(2)}`;
        break;
      case 'is':
        result = pctIs(a, b);
        label = `${a} is ${result.toFixed(2)}% of ${b}`;
        break;
      case 'change':
        result = pctChange(a, b);
        const s = result >= 0 ? '+' : '';
        label = `${s}${result.toFixed(2)}% change (${a} → ${b})`;
        break;
      case 'diff':
        result = pctDiff(a, b);
