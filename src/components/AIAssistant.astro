  function checkGrammar(text) {
    const errors = [];
    const words = text.split(/\s+/);
    // Spelling
    const wordArr = text.split(/(\s+|[.!?,;:])/);
    let offset = 0;
    for (const w of wordArr) {
      const clean = w.replace(/[^a-zA-Z]/g, '').toLowerCase();
      if (clean.length > 1 && misspellings[clean])
        errors.push({ word: w, suggestion: misspellings[clean], type: 'Spelling' });
      offset += w.length;
    }
    // Repeated words
    for (let i = 0; i < words.length - 1; i++) {
      const w1 = words[i].toLowerCase().replace(/[^a-z]/g, '');
      const w2 = words[i + 1].toLowerCase().replace(/[^a-z]/g, '');
      if (w1 === w2 && w1.length > 1)
        errors.push({ word: `${words[i]} ${words[i + 1]}`, suggestion: words[i], type: 'Repeated' });
    }
    // Capitalization
    const sentences = text.match(/[^.!?\n]+[.!?]*/g) || [text];
    for (const s of sentences) {
      const t = s.trim();
      if (t.length > 1 && t[0] === t[0].toLowerCase() && t[0].match(/[a-z]/))
        errors.push({
          word: t.slice(0, 15) + '...',
          suggestion: t[0].toUpperCase() + t.slice(1),
          type: 'Capitalization',
        });
    }
    if (errors.length === 0)
      return '<span class="text-emerald-400 font-semibold">✓ No issues found! Great writing!</span>';
    return `<div class="text-[11px] space-y-1.5">
      <span class="text-amber-400 font-semibold">Found ${errors.length} issue${errors.length > 1 ? 's' : ''}:</span>
