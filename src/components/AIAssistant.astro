  function analyzeSentiment(text) {
    const tokens = text
      .toLowerCase()
      .replace(/[^a-z\s']/g, '')
      .split(/\s+/)
      .filter((w) => w);
    let posScore = 0,
      negScore = 0,
      neutScore = 0;
    let posWords = [],
      negWords = [];
    for (let i = 0; i < tokens.length; i++) {
      const token = tokens[i].replace(/'s$/, '');
      let mult = 1;
      for (let j = Math.max(0, i - 2); j < i; j++) {
        if (negators.has(tokens[j])) {
          mult = -1;
          break;
        }
      }
      for (let j = Math.max(0, i - 2); j < i; j++) {
        if (intensifiers.has(tokens[j])) {
          mult *= 1.5;
          break;
        }
      }
      if (positiveLex[token] !== undefined) {
        const s = positiveLex[token] * mult;
        if (s > 0) {
          posScore += s;
          posWords.push(token);
        } else {
          negScore += Math.abs(s);
          negWords.push(token);
        }
      } else if (negativeLex[token] !== undefined) {
        const s = negativeLex[token] * mult;
        if (s > 0) {
          negScore += s;
          negWords.push(token);
        } else {
          posScore += Math.abs(s);
          posWords.push(token);
        }
      } else {
        neutScore += 0.1;
      }
    }
    const total = posScore + negScore + neutScore;
    const posPct = total > 0 ? Math.round((posScore / total) * 100) : 33;
    const negPct = total > 0 ? Math.round((negScore / total) * 100) : 33;
    const neutPct = Math.max(0, 100 - posPct - negPct);
    let label, color;
    if (posScore > negScore * 1.2) {
      label = 'Positive';
      color = 'text-emerald-400';
    } else if (negScore > posScore * 1.2) {
      label = 'Negative';
      color = 'text-rose-400';
