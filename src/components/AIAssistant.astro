        <span class="px-1.5 py-0.5 rounded text-[9px] font-mono ${e.type === 'Spelling' ? 'bg-red-500/10 text-red-400' : e.type === 'Repeated' ? 'bg-amber-500/10 text-amber-400' : 'bg-blue-500/10 text-blue-400'}">${e.type}</span>
        <div class="flex-1 min-w-0"><span class="text-red-300 line-through">${escapeHtml(e.word)}</span> → <span class="text-emerald-300">${escapeHtml(e.suggestion)}</span></div>
      </div>`,
