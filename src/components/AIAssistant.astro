---
import { tools, categories } from '../data/tools';

const toolData = tools.map((t) => ({
  name: t.name,
  id: t.id,
  description: t.description,
  category: categories.find((c) => c.id === t.category)?.title || t.category,
  url: t.url,
  keywords: t.keywords,
  isNew: t.isNew,
  isPopular: t.isPopular,
}));
const toolJson = JSON.stringify(toolData);
const catJson = JSON.stringify(categories.map((c) => ({ title: c.title, count: c.count, id: c.id })));
---

<div id="ai-assistant" class="fixed bottom-6 right-6 z-[200] flex flex-col items-end">
  <!-- Chat Panel -->
  <div
    id="ai-chat-panel"
    class="hidden mb-3 w-[360px] max-w-[calc(100vw-2rem)] rounded-2xl border border-surface bg-surface-nav backdrop-blur-2xl shadow-2xl overflow-hidden transition-all duration-300 origin-bottom-right animate-[scaleIn_0.2s_ease-out]"
  >
    <!-- Chat Header -->
    <div
      class="flex items-center justify-between px-4 py-3 border-b border-surface bg-gradient-to-r from-purple-600/10 to-blue-600/5"
    >
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500 to-blue-600 flex items-center justify-center">
          <svg
            class="w-4 h-4 text-white"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path><line
              x1="12"
              y1="8"
              x2="12"
              y2="14"></line><line x1="9" y1="11" x2="15" y2="11"></line></svg
          >
        </div>
        <div>
          <p class="text-sm font-bold text-primary">NumanX Quick Command & Tool Router</p>
          <p class="text-[10px] text-muted">12 instant client-side tools & quick navigation</p>
        </div>
      </div>
      <button
        id="ai-close-btn"
        class="w-7 h-7 rounded-lg flex items-center justify-center text-tertiary hover:text-white hover:bg-surface-3 transition-all cursor-pointer"
        aria-label="Close Quick Command Router"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg
        >
      </button>
    </div>

    <!-- Chat Messages -->
    <div id="ai-messages" class="h-[380px] overflow-y-auto p-4 space-y-3 scrollbar-hide">
      <div class="flex items-start gap-2.5">
        <div
          class="w-6 h-6 rounded-lg bg-gradient-to-br from-purple-500 to-blue-600 flex items-center justify-center shrink-0 mt-0.5"
        >
          <svg
            class="w-3 h-3 text-white"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg
          >
        </div>
        <div class="flex-1 bg-surface-2 rounded-xl rounded-tl-none px-3.5 py-2.5">
          <p class="text-xs text-secondary leading-relaxed">
            Hi! I'm your NumanX Quick Command & Tool Router. Run 12 instant client-side tools or deep-link right here:
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <button
              class="ai-suggestion text-[10px] px-2 py-1 rounded-lg bg-surface-3 hover:bg-purple-500/20 text-tertiary hover:text-purple-300 border border-surface-2 transition-all cursor-pointer"
              >generate password 16</button
            >
            <button
              class="ai-suggestion text-[10px] px-2 py-1 rounded-lg bg-surface-3 hover:bg-purple-500/20 text-tertiary hover:text-purple-300 border border-surface-2 transition-all cursor-pointer"
              >calculate 160/20</button
            >
            <button
              class="ai-suggestion text-[10px] px-2 py-1 rounded-lg bg-surface-3 hover:bg-purple-500/20 text-tertiary hover:text-purple-300 border border-surface-2 transition-all cursor-pointer"
              >crr 145 in 16.2</button
