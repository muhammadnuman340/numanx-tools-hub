  function summarize(text, ratio) {
    const sentences = text.match(/[^.!?\n]+[.!?]*/g) || text.split(/\n+/).filter((s) => s.trim());
    if (!sentences.length) return 'No sentences found.';
    const words = text
      .toLowerCase()
      .replace(/[^a-z\s]/g, '')
      .split(/\s+/)
      .filter((w) => w && !stopWords.has(w));
    const freq = {};
    words.forEach((w) => {
      freq[w] = (freq[w] || 0) + 1;
    });
    const maxFreq = Math.max(...Object.values(freq), 1);
    const scored = sentences.map((s) => {
      const sWords = s
        .toLowerCase()
        .replace(/[^a-z\s]/g, '')
        .split(/\s+/)
        .filter((w) => w && !stopWords.has(w));
      const score = sWords.reduce((sum, w) => sum + (freq[w] || 0) / maxFreq, 0) / Math.max(sWords.length, 1);
      return { sentence: s.trim(), score, length: sWords.length };
    });
    const totalWords = sentences.reduce(
      (sum, s) =>
        sum +
        s
          .toLowerCase()
          .replace(/[^a-z\s]/g, '')
          .split(/\s+/)
          .filter((w) => w).length,
      0,
    );
    const targetWords = Math.max(1, Math.round((totalWords * (ratio || 30)) / 100));
    scored.sort((a, b) => b.score - a.score);
    let selected = [],
      wordCount = 0;
    for (const s of scored) {
      if (wordCount >= targetWords) break;
      selected.push(s);
      wordCount += s.length;
    }
    selected.sort((a, b) => sentences.indexOf(a.sentence) - sentences.indexOf(b.sentence));
    const summary = selected.map((s) => s.sentence).join(' ');
    const sw = summary.split(/\s+/).filter((w) => w).length;
    const comp = totalWords > 0 ? Math.round((1 - sw / totalWords) * 100) : 0;
    return `<div class="text-[11px] space-y-1.5">
      <p class="text-secondary leading-relaxed">${escapeHtml(summary)}</p>
      <div class="grid grid-cols-3 gap-1 text-[10px] pt-1 border-t border-surface">
        <span class="text-muted">Original:</span><span class="text-purple-300">${totalWords} words</span>
        <span class="text-muted">Summary:</span><span class="text-purple-300">${sw} words</span>
        <span class="text-muted">Compressed:</span><span class="text-purple-300">${comp}%</span>
