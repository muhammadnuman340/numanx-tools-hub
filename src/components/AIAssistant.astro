  // -- Spell Number --
  function execSpellNumber(num) {
    const n = parseFloat(num);
    if (isNaN(n) || n < 0 || n > 999999999999 || !Number.isInteger(n)) return null;
    const ones = [
      '',
      'one',
      'two',
      'three',
      'four',
      'five',
      'six',
      'seven',
      'eight',
      'nine',
      'ten',
      'eleven',
      'twelve',
      'thirteen',
      'fourteen',
      'fifteen',
      'sixteen',
      'seventeen',
      'eighteen',
      'nineteen',
    ];
    const tens = ['', '', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
    function spellH(x) {
      if (x === 0) return '';
      let s = '';
      if (x >= 100) {
        s += ones[Math.floor(x / 100)] + ' hundred ';
        x %= 100;
      }
      if (x >= 20) {
        s += tens[Math.floor(x / 10)] + (x % 10 ? '-' + ones[x % 10] : '');
      } else if (x > 0) s += ones[x];
      return s.trim();
    }
    const b = Math.floor(n / 1e9),
      m = Math.floor((n % 1e9) / 1e6),
      th = Math.floor((n % 1e6) / 1e3),
      r = n % 1e3;
    let result = '';
    if (b) result += spellH(b) + ' billion ';
    if (m) result += spellH(m) + ' million ';
    if (th) result += spellH(th) + ' thousand ';
    if (r || !result) result += spellH(r);
    return '<span class="text-purple-300">' + num + ' = </span><i>' + result.trim() + '</i>';
  }

  // -- Number Commas --
  function execCommas(num) {
    const parts = String(num).split('.');
    parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return '<span class="text-purple-300 font-semibold">' + parts.join('.') + '</span>';
  }

  // -- Roman Numerals --
  function execRoman(num) {
    const n = parseInt(num);
    if (isNaN(n) || n < 1 || n > 3999) return null;
    const vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1];
    const syms = ['M', 'CM', 'D', 'CD', 'C', 'XC', 'L', 'XL', 'X', 'IX', 'V', 'IV', 'I'];
    let result = '',
      rem = n;
    for (let i = 0; i < vals.length; i++) {
      while (rem >= vals[i]) {
        result += syms[i];
        rem -= vals[i];
      }
    }
    return '<span class="text-purple-300">' + num + ' = ' + result + '</span>';
  }

  // -- Timestamp Converter --
  function execTimestamp(ts) {
    const n = parseInt(ts);
    if (isNaN(n)) return null;
    const d = new Date(n * 1000);
    if (isNaN(d)) return null;
    return (
      '<span class="text-purple-300">' +
      ts +
      '</span> = <span class="text-purple-300">' +
      d.toUTCString() +
      '</span> (' +
      d.toLocaleString() +
      ')'
    );
  }

  // -- Time 12h to 24h --
  function execTime12to24(time) {
    const m = time.match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);
    if (!m) return null;
    let h = parseInt(m[1]),
      min = parseInt(m[2]);
    if (m[3].toUpperCase() === 'PM' && h !== 12) h += 12;
    if (m[3].toUpperCase() === 'AM' && h === 12) h = 0;
    return (
      '<span class="text-purple-300">' +
      time +
      ' = ' +
      String(h).padStart(2, '0') +
      ':' +
      String(min).padStart(2, '0') +
      ' (24h)</span>'
    );
  }

  // -- Time 24h to 12h --
  function execTime24to12(time) {
    const m = time.match(/^(\d{1,2}):(\d{2})$/);
    if (!m) return null;
    let h = parseInt(m[1]),
      min = parseInt(m[2]);
    if (h < 0 || h > 23) return null;
    const ampm = h >= 12 ? 'PM' : 'AM';
    if (h === 0) h = 12;
    else if (h > 12) h -= 12;
    return (
      '<span class="text-purple-300">' +
      time +
      ' = ' +
      h +
      ':' +
      String(min).padStart(2, '0') +
      ' ' +
      ampm +
      ' (12h)</span>'
    );
  }

  // -- Timer --
  function execTimer(duration, unit) {
    if (timerId) {
      clearTimeout(timerId);
      timerId = null;
    }
    const units = {
      seconds: 1,
      second: 1,
      sec: 1,
      s: 1,
      minutes: 60,
      minute: 60,
      min: 60,
      m: 60,
      hours: 3600,
      hour: 3600,
      hr: 3600,
      h: 3600,
    };
    const mult = units[unit.toLowerCase()] || 60;
    const totalMs = duration * mult * 1000;
    if (totalMs < 1000 || totalMs > 86400000) return 'Timer range: 1 second to 24 hours.';
    timerId = setTimeout(() => {
      timerId = null;
      playPing();
      if (window.__showToast)
        window.__showToast({
          message: '\u23F0 Timer done! ' + duration + ' ' + unit + ' elapsed.',
          variant: 'success',
        });
    }, totalMs);
    return (
      '\u23F1 <span class="text-purple-300">Timer set for ' +
      duration +
      ' ' +
      unit +
      ".</span> I'll ping you when it's done!"
    );
  }
  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }

  // -- SHA-256 Hash --
  async function execHash(text) {
    try {
      const enc = new TextEncoder().encode(text);
      const hash = await crypto.subtle.digest('SHA-256', enc);
      const hex = Array.from(new Uint8Array(hash))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
      return '<span class="text-purple-300 font-semibold">SHA-256:</span> <code class="text-[10px]">' + hex + '</code>';
    } catch (e) {
      return null;
    }
  }

  // -- BMI Calculator --
  function execBmi(weight, wUnit, height, hUnit) {
    let kg = weight,
      cm = height;
    if (wUnit.startsWith('lb')) kg = weight * 0.453592;
    if (hUnit.includes('ft') || hUnit.includes('in')) {
      const hm = height.match(/(\d+)ft\s*(\d+)?/i);
      if (hm) cm = parseInt(hm[1]) * 30.48 + parseInt(hm[2] || 0) * 2.54;
      else cm = height * 30.48;
    }
    cm = cm || height;
    const m = cm / 100;
    const bmi = kg / (m * m);
    if (!isFinite(bmi)) return null;
    let cat;
    if (bmi < 18.5) cat = 'Underweight';
    else if (bmi < 25) cat = 'Normal weight';
    else if (bmi < 30) cat = 'Overweight';
    else if (bmi < 35) cat = 'Obese Class I';
    else if (bmi < 40) cat = 'Obese Class II';
    else cat = 'Obese Class III';
    return (
      '<span class="text-purple-300">BMI: ' +
      bmi.toFixed(1) +
      '</span> \u2014 <i>' +
      cat +
      '</i><br>Weight: ' +
      kg.toFixed(1) +
      ' kg | Height: ' +
      cm.toFixed(1) +
      ' cm'
    );
  }

  // -- Slug Generator --
  function execSlug(text) {
    return text
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, '')
      .replace(/[\s_]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  // -- Text to Binary --
  function execTextToBinary(text) {
    return text
      .split('')
      .map((c) => c.charCodeAt(0).toString(2).padStart(8, '0'))
      .join(' ');
  }

  // -- Binary to Text --
  function execBinaryToText(bin) {
    return bin
      .trim()
      .split(/\s+/)
      .map((b) => String.fromCharCode(parseInt(b, 2)))
      .join('');
  }

  // -- ASCII Lookup --
  function execAscii(ch) {
    if (ch.length === 1)
      return (
        'Character: <code>' +
        ch +
        '</code> | Decimal: <span class="text-purple-300">' +
        ch.charCodeAt(0) +
        '</span> | Hex: <span class="text-purple-300">' +
        ch.charCodeAt(0).toString(16).toUpperCase() +
        '</span> | Binary: <span class="text-purple-300">' +
        ch.charCodeAt(0).toString(2) +
        '</span>'
      );
    return null;
  }

  // -- Character Code to Character --
  function execCharCode(code) {
    const n = parseInt(code);
    if (isNaN(n) || n < 0 || n > 0x10ffff) return null;
    return (
      'Code: <span class="text-purple-300">' +
      n +
      '</span> | Character: <code>' +
      String.fromCodePoint(n) +
      '</code>' +
      (n < 17 ? ' | Hex: ' + n.toString(16).toUpperCase() : '')
    );
  }

  // -- Dice Roller --
  function execDice(roll) {
    const m = roll.match(/^(\d+)?d(\d+)(?:\s*([+-])\s*(\d+))?$/i);
    if (!m) return null;
    const count = parseInt(m[1] || 1);
    const sides = parseInt(m[2]);
    const modSign = m[3];
    const modVal = parseInt(m[4] || 0);
    if (count < 1 || count > 100 || sides < 2 || sides > 1000) return null;
    const rolls = [];
    let total = 0;
    for (let i = 0; i < count; i++) {
      const r = Math.floor(Math.random() * sides) + 1;
      rolls.push(r);
      total += r;
    }
    const modTotal = modSign === '+' ? total + modVal : modSign === '-' ? total - modVal : total;
    let result = '\u{1F3B2} <span class="text-purple-300">Rolling ' + roll + ':</span> ' + rolls.join(', ');
    if (count > 1) result += ' = ' + total;
    if (modSign)
      result += ' ' + modSign + ' ' + modVal + ' = <span class="text-purple-300 font-semibold">' + modTotal + '</span>';
    else
      result =
        '\u{1F3B2} <span class="text-purple-300 font-semibold">Result: ' + total + '</span> (' + rolls.join(', ') + ')';
    return result;
  }

  // -- Password Strength --
  function execPasswordStrength(pwd) {
    if (!pwd) return null;
    let score = 0;
    const len = pwd.length;
    if (len >= 8) score += 1;
    if (len >= 12) score += 1;
    if (len >= 16) score += 1;
    if (/[a-z]/.test(pwd)) score += 1;
    if (/[A-Z]/.test(pwd)) score += 1;
    if (/[0-9]/.test(pwd)) score += 1;
    if (/[^a-zA-Z0-9]/.test(pwd)) score += 1;
    const entropy = len > 0 ? Math.round(len * Math.log2(94)) : 0;
    const strength = score <= 2 ? 'Weak' : score <= 4 ? 'Fair' : score <= 6 ? 'Strong' : 'Very Strong';
    const color =
      score <= 2 ? 'text-red-400' : score <= 4 ? 'text-amber-400' : score <= 6 ? 'text-lime-400' : 'text-emerald-400';
    return (
      '<span class="font-semibold ' +
      color +
      '">' +
      strength +
      '</span> (' +
      score +
      '/7) | Entropy: ~' +
      entropy +
      ' bits | Length: ' +
      len +
      ' chars'
    );
  }

  // -- Fibonacci --
  function execFibonacci(n) {
    const count = parseInt(n);
    if (isNaN(count) || count < 1 || count > 100) return null;
    const seq = [0, 1];
    for (let i = 2; i < count; i++) seq.push(seq[i - 1] + seq[i - 2]);
    return '<span class="text-purple-300">Fibonacci (' + count + '):</span> ' + seq.slice(0, count).join(', ');
  }

  // -- Prime Checker --
  function execPrimeCheck(n) {
    const num = parseInt(n);
    if (isNaN(num) || num < 1) return null;
    if (num <= 3) return '<span class="text-purple-300">' + num + ' is prime</span>';
    if (num % 2 === 0 || num % 3 === 0) {
      const factors = [];
      let rem = num;
      for (let i = 2; i * i <= rem; i++) {
        while (rem % i === 0) {
          factors.push(i);
          rem /= i;
        }
      }
      if (rem > 1) factors.push(rem);
      return '<span class="text-purple-300">' + num + ' is not prime</span><br>Factors: ' + factors.join(' \u00D7 ');
    }
    for (let i = 5; i * i <= num; i += 6) {
      if (num % i === 0 || num % (i + 2) === 0) return '<span class="text-purple-300">' + num + ' is not prime</span>';
    }
    return '<span class="text-purple-300">' + num + ' is prime</span>';
  }

  // -- Day of Week --
  function execDayOfWeek(dateStr) {
    const d = new Date(dateStr);
    if (isNaN(d)) return null;
    const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    return '<span class="text-purple-300">' + dateStr + ' is a ' + days[d.getDay()] + '</span>';
  }

  // -- Leap Year --
  function execLeapYear(year) {
    const y = parseInt(year);
    if (isNaN(y)) return null;
    const leap = (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
    return (
      '<span class="text-purple-300">' +
      y +
      '</span> is ' +
      (leap ? '' : 'not ') +
      'a leap year (' +
      (leap ? '366' : '365') +
      ' days)'
    );
  }

  // -- Random Quote --
  function execQuote() {
    return '\u{1F4AC} <i>' + quotes[Math.floor(Math.random() * quotes.length)] + '</i>';
  }

  // -- Lottery Numbers --
  function execLottery(count, max) {
    const c = count || 6,
      m = max || 49;
    const nums = new Set();
    while (nums.size < Math.min(c, m)) nums.add(Math.floor(Math.random() * m) + 1);
    return (
      '\u{1F3B1} <span class="text-purple-300">Lottery numbers (' +
      c +
      '/' +
      m +
      '):</span> ' +
      [...nums].sort((a, b) => a - b).join('  ')
    );
  }

  // ──────────────────────────────────────────────
  // INTENT PARSER & DISPATCHER
  // ──────────────────────────────────────────────

  function parseAndExec(query) {
    const q = query.trim();
    const lq = q.toLowerCase();

    // 0a) Cricket CRR: "crr 145 in 16.2" or "crr 145/16.2" or "cricket crr 145 16.2"
    let mCrr = q.match(/^(?:cricket\s+)?crr(?:\s*:|\s+)(\d+(?:\.\d+)?)\s*(?:runs)?\s*(?:in|\/|\s)\s*(\d+(?:\.\d+)?)\s*(?:overs?)?/i);
    if (mCrr) {
      const runs = parseFloat(mCrr[1]) || 0;
      const oversParts = String(mCrr[2]).split('.');
      const compOvers = parseInt(oversParts[0], 10) || 0;
      const balls = Math.min(parseInt(oversParts[1] || '0', 10), 5);
      const decOvers = compOvers + balls / 6;
      const crr = decOvers > 0 ? (runs / decOvers).toFixed(2) : '0.00';
      return `<div class="text-[11px] space-y-1">
        <div class="font-bold text-emerald-400">🏏 Cricket Current Run Rate (CRR): ${crr} RPO</div>
        <div class="text-muted text-[10px]">${runs} runs in ${compOvers}.${balls} overs (${decOvers.toFixed(2)} decimal overs).</div>
        <div class="pt-1"><a href="/tools/net-run-rate-calculator/" class="text-purple-400 hover:underline">Open NRR Calculator &rarr;</a></div>
      </div>`;
    }

    // 0b) Deep Link Quick Navigation: "open <tool>", "goto <tool>", "launch <tool>"
    let mOpen = q.match(/^(?:open|goto|go\s+to|launch|visit)\s+(.+)/i);
    if (mOpen) {
      const targetQuery = mOpen[1].toLowerCase().trim();
      const matched = quickTools.find((t) => t.name.toLowerCase().includes(targetQuery) || t.url.includes(targetQuery));
      if (matched) {
        return `<div class="text-[11px] space-y-1.5">
          <div class="text-muted">Direct tool link found:</div>
          <a href="${matched.url}" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs transition-all">
            <span>🚀 Open ${matched.name}</span>
          </a>
        </div>`;
      }
    }

    // 1) Summarize: "summarize: <text>" or "summarize <text>"
    let m = q.match(/^(?:summarize|summary)(?:\s*(?::|of)\s*|\s+)(.+)/is);
    if (m) return summarize(m[1], 30);

    // 2) Grammar: "check grammar: <text>" or "grammar: <text>"
    m = q.match(/^(?:check\s+grammar|grammar)(?:\s*(?::|on|for)\s*|\s+)(.+)/is);
    if (m) return checkGrammar(m[1]);

    // 3) Sentiment: "analyze sentiment: <text>" or "sentiment: <text>"
    m = q.match(/^(?:analyze\s+sentiment|sentiment)(?:\s*(?::|of|on)\s*|\s+)(.+)/is);
    if (m) return analyzeSentiment(m[1]);

    // 4) Word count: "count words: <text>" or "word count: <text>"
    m = q.match(/^(?:count\s+words|word\s+count|analyze\s+text)(?:\s*(?::|of)\s*|\s+)(.+)/is);
    if (m) return wordCount(m[1]);

    // 5) Case convert: "upper: <text>", "lower: <text>", "title: <text>", etc
    const caseModes = {
      upper: 'upper',
      lower: 'lower',
      'title case': 'title',
      title: 'title',
      'sentence case': 'sentence',
      sentence: 'sentence',
      alternating: 'alternating',
      inverse: 'inverse',
      'camel case': 'camel',
      camel: 'camel',
    };
    for (const [key, mode] of Object.entries(caseModes)) {
      m = q.match(new RegExp(`^${key}(?:\\s*(?::|to)\\s*|\\s+)(.+)`, 'is'));
      if (m)
        return `<pre class="text-[11px] text-purple-300 font-mono bg-surface-1 p-2 rounded-lg whitespace-pre-wrap">${escapeHtml(caseConvert(m[1], mode))}</pre>`;
    }

    // 6) Base64: "encode base64: <text>" / "decode base64: <text>" / "base64 encode <text>" / "base64 decode <text>"
    m = q.match(/^(?:encode\s+base64|base64\s+encode)(?:\s*(?::)\s*|\s+)(.+)/is);
    if (m)
      return `<pre class="text-[11px] text-purple-300 font-mono bg-surface-1 p-2 rounded-lg break-all">${escapeHtml(base64Encode(m[1]))}</pre>`;
    m = q.match(/^(?:decode\s+base64|base64\s+decode)(?:\s*(?::)\s*|\s+)(.+)/is);
    if (m)
      return `<pre class="text-[11px] text-purple-300 font-mono bg-surface-1 p-2 rounded-lg">${escapeHtml(base64Decode(m[1]))}</pre>`;

    // 7) URL: "encode url: <text>" / "decode url: <text>" / "url encode <text>" / "url decode <text>"
    m = q.match(/^(?:encode\s+url|url\s+encode)(?:\s*(?::)\s*|\s+)(.+)/is);
    if (m)
      return `<pre class="text-[11px] text-purple-300 font-mono bg-surface-1 p-2 rounded-lg break-all">${escapeHtml(urlEncode(m[1]))}</pre>`;
    m = q.match(/^(?:decode\s+url|url\s+decode)(?:\s*(?::)\s*|\s+)(.+)/is);
    if (m)
      return `<pre class="text-[11px] text-purple-300 font-mono bg-surface-1 p-2 rounded-lg">${escapeHtml(urlDecode(m[1]))}</pre>`;

    // 8) JSON: "format json: <json>" / "minify json: <json>" / "validate json: <json>"
    m = q.match(/^(?:format|beautify)\s+json(?:\s*(?::)\s*|\s+)(.+)/is);
    if (m) return jsonFormat(m[1]);
    m = q.match(/^(?:minify|compress)\s+json(?:\s*(?::)\s*|\s+)(.+)/is);
    if (m) return jsonMinify(m[1]);
    m = q.match(/^(?:validate|check)\s+json(?:\s*(?::)\s*|\s+)(.+)/is);
    if (m) {
      try {
        JSON.parse(m[1]);
        return '<span class="text-emerald-400 font-semibold">✓ Valid JSON</span>';
      } catch (e) {
        return `<span class="text-red-400">✗ ${escapeHtml(e.message)}</span>`;
      }
    }

    // 9) Color: "convert color: #hex" / "color #hex" or various color ops
    m = q.match(/^color(?:\s*(?::|convert)\s*|\s+)(.+)/is);
    if (m) {
      const r = colorConvert(m[1]);
      if (r) return r;
    }

    // 10) Password: "generate password [length] [type]" / "password [length]" / "pin [length]"
    m = q.match(/^(?:generate\s+)?password(?:\s*(?::)\s*|\s+)?(\d+)?(?:\s+(random|pronounceable|passphrase|pin))?/is);
    if (m) return genPassword(+(m[1] || 16), m[2] || 'random');
    m = q.match(/^pin(?:\s*(?::)\s*|\s+)?(\d+)?/is);
    if (m) return genPassword(+(m[1] || 6), 'pin');
    m = q.match(/^passphrase(?:\s*(?::)\s*|\s+)?(\d+)?/is);
    if (m) return genPassword(+(m[1] || 20), 'passphrase');

    // 11) UUID: "uuid" / "generate uuid" / "gen uuid"
    if (/^uuid|^generate\s+uuid|^gen\s+uuid/.test(lq)) return genUUID();

    // 12) Random: "random [count] [min-max]" / "random number [min] [max]" / "roll dice"
    m = q.match(
      /^(?:random|roll|dice)(?:\s+number[s]?)?(?:\s*(?::)\s*|\s+)?(\d+)?(?:\s+(\d+)(?:\s*[-–to]+\s*(\d+))?)?/is,
    );
    if (m) {
      if (m[2] && m[3]) return genRandom(+m[2], +m[3], +(m[1] || 1));
      if (m[2]) return genRandom(0, +m[2], +(m[1] || 1));
      if (m[1]) return genRandom(1, 100, +m[1]);
      return genRandom(1, 100, 1);
    }
    if (/^roll dice|^dice\b/.test(lq)) return genRandom(1, 6, 1);

    // 13) Percentage: "X% of Y" / "X is what % of Y" / "percentage change X to Y"
    m = q.match(/^(\d+\.?\d*)\s*%\s*of\s*(\d+\.?\d*)/i);
    if (m) return percentageHandler(+m[1], +m[2], 'of');
    m = q.match(/^(\d+\.?\d*)\s+is\s+what\s+%\s+of\s+(\d+\.?\d*)/i);
    if (m) return percentageHandler(+m[1], +m[2], 'is');
    m = q.match(/^(?:percentage|pct)\s+change\s+(\d+\.?\d*)\s+to\s+(\d+\.?\d*)/i);
    if (m) return percentageHandler(+m[1], +m[2], 'change');
    m = q.match(/^(?:percentage|pct)\s+difference\s+(\d+\.?\d*)\s+and\s+(\d+\.?\d*)/i);
    if (m) return percentageHandler(+m[1], +m[2], 'diff');

    // 14) Unit conversion: "convert X [from] to [to]" / "X [from] in [to]"
    m = q.match(/^(?:convert\s+)?(\d+\.?\d*)\s*(.+?)\s+(?:to|in)\s+(.+)/is);
    if (m) {
      const r = execConvert(+m[1], m[2].trim(), m[3].trim());
      if (r) return r;
    }

    // --- NEW INTENT PATTERNS ---

    // Math: "calculate 2+3*4" / "calc 5*10" / "what is 2+2"
    let m2 = q.match(/^(?:calculate|calc|eval|math|what is|what's)\s+(.+)/is);
    if (m2) {
      const r = execMath(m2[1]);
      if (r) return r;
    }

    // Number base: "convert 255 to binary" / "FF in decimal"
    m2 = q.match(/(?:convert\s+)?([0-9a-fA-F]+)\s+(?:to|in)\s+(binary|decimal|hex(?:adecimal)?|octal|base[\s-]?\d+)/i);
    if (m2 && (lq.includes('binary') || lq.includes('decimal') || lq.includes('hex') || lq.includes('octal'))) {
      const fb = /[a-fA-F]/.test(m2[1]) ? 'hex' : 'decimal';
      const r = execBaseConvert(m2[1], fb, m2[2]);
      if (r) return r;
    }
    m2 = q.match(/^(\d+)\s+(?:in|to)\s+(binary|decimal|hex(?:adecimal)?|octal|base[\s-]?\d+)/i);
    if (m2) {
      const r = execBaseConvert(m2[1], 'decimal', m2[2]);
      if (r) return r;
    }
    m2 = q.match(/^([0-9a-fA-F]+)\s+(?:in|to)\s+(decimal|binary|octal)/i);
    if (m2) {
      const r = execBaseConvert(m2[1], 'hex', m2[2]);
      if (r) return r;
    }

    // Date diff: "days between 2024-01-01 and 2024-12-31"
    m2 = q.match(
      /^(?:days?|weeks?)\s+between\s+(\d{4}[-/]\d{1,2}[-/]\d{1,2})\s+(?:and|to)\s+(\d{4}[-/]\d{1,2}[-/]\d{1,2})/i,
    );
    if (m2) {
      const r = execDateDiff(m2[1], m2[2]);
      if (r) return r;
    }

    // Days until: "days until 2026-12-25"
    m2 = q.match(/^(?:days?|weeks?)\s+until\s+(\d{4}[-/]\d{1,2}[-/]\d{1,2})/i);
    if (m2) {
      const r = execDaysUntil(m2[1]);
      if (r) return r;
    }

    // Add days: "add 30 days to 2024-01-01"
    m2 = q.match(/^(?:add|plus)\s+(\d+)\s+(days?|weeks?)\s+(?:to|until|from)\s+(\d{4}[-/]\d{1,2}[-/]\d{1,2})/i);
    if (m2) {
      const mult = m2[2].startsWith('week') ? 7 : 1;
      const r = execAddDays(m2[3], +m2[1] * mult);
      if (r) return r;
    }

    // ROT13: "rot13: hello"
    m2 = q.match(/^rot[\s-]?13(?:\s*:|\s+)(.+)/i);
    if (m2) return '<span class="text-purple-300">ROT13:</span> <code>' + execRot13(m2[1]) + '</code>';

    // Reverse text: "reverse: hello"
    m2 = q.match(/^(?:reverse|rev)(?:\s*:|\s+)(.+)/i);
    if (m2) return '<span class="text-purple-300">Reversed:</span> <code>' + execReverse(m2[1]) + '</code>';

    // Palindrome: "palindrome: racecar"
    if (/^(?:is\s+)?palindrome|palindrome check/i.test(lq)) {
      m2 = q.match(/palindrome(?:\s*:|\s+)?(.+)/i) || q.match(/(?:is\s+)?(.+?)\s+a palindrome/i);
      if (m2) return execPalindrome(m2[1]);
    }

    // Morse: "morse encode: hello" / "morse decode: ...."
    m2 = q.match(/^morse\s+(?:encode|enc)(?:\s*:|\s+)(.+)/i);
    if (m2) return '<span class="text-purple-300">Morse:</span> <code>' + execMorseEncode(m2[1]) + '</code>';
    m2 = q.match(/^morse\s+(?:decode|dec)(?:\s*:|\s+)(.+)/i);
    if (m2) return '<span class="text-purple-300">Decoded:</span> <code>' + execMorseDecode(m2[1]) + '</code>';
    if (/^morse\b/.test(lq)) {
      m2 = q.match(/^morse(?:\s*:|\s+)(.+)/i);
      if (m2) return '<span class="text-purple-300">Morse:</span> <code>' + execMorseEncode(m2[1]) + '</code>';
    }

    // List ops: "sort: a, b, c" / "shuffle: a, b, c"
    m2 = q.match(/^(?:sort|order)(?:\s*:|\s+)(.+)/i);
    if (m2) {
      const r = execListSort(m2[1]);
      if (r) return r;
    }
    m2 = q.match(/^reverse(?:\s*:|\s+)(.+)/i);
    if (m2 && m2[1].includes(',')) {
      const r = execListReverse(m2[1]);
      if (r) return r;
    }
    m2 = q.match(/^(?:shuffle|randomize)(?:\s*:|\s+)(.+)/i);
    if (m2) {
      const r = execListShuffle(m2[1]);
      if (r) return r;
    }
    m2 = q.match(/^(?:dedupe|unique|deduplicate)(?:\s*:|\s+)(.+)/i);
    if (m2) {
      const r = execListDedupe(m2[1]);
      if (r) return r;
    }

    // Frequency: "frequency: hello" / "word frequency: hello"
    m2 = q.match(/^(?:char(?:acter)?\s+)?freq(?:uency)?(?:\s*:|\s+)(.+)/i);
    if (m2) {
      const r = execCharFreq(m2[1]);
      if (r) return r;
    }
    m2 = q.match(/^word\s+freq(?:uency)?(?:\s*:|\s+)(.+)/i);
    if (m2) {
      const r = execWordFreq(m2[1]);
      if (r) return r;
    }

    // Number formatting: "spell 1234" / "commas 1234567" / "roman 42"
    m2 = q.match(/^(?:spell|number\s+in\s+words|words?)\s+(\d{1,12})/i);
    if (m2) {
      const r = execSpellNumber(m2[1]);
      if (r) return r;
    }
    m2 = q.match(/^(?:commas|format\s+number)\s+(\d+\.?\d*)/i);
    if (m2) {
      const r = execCommas(m2[1]);
      if (r) return r;
    }
    m2 = q.match(/^(?:roman|to roman)\s+(\d{1,4})/i);
    if (m2) {
      const r = execRoman(m2[1]);
      if (r) return r;
    }
    m2 = q.match(/^(\d{1,12})\s+in\s+(words?|roman)/i);
    if (m2) {
      if (m2[2].startsWith('word')) {
        const r = execSpellNumber(m2[1]);
        if (r) return r;
      }
      if (m2[2].startsWith('roman')) {
        const r = execRoman(m2[1]);
        if (r) return r;
      }
    }

    // Time: "timestamp 1717488000" / "convert 2:30 PM to 24h"
    m2 = q.match(/^(?:timestamp|ts|unix)\s+(\d{8,10})/i);
    if (m2) {
      const r = execTimestamp(m2[1]);
      if (r) return r;
    }
    m2 = q.match(/(\d{1,2}:\d{2}\s*(?:AM|PM))/i);
    if (m2 && (lq.includes('24h') || lq.includes('military'))) {
      const r = execTime12to24(m2[1]);
      if (r) return r;
    }
    m2 = q.match(/(\d{1,2}:\d{2})(?!\s*(?:AM|PM))/i);
    if (m2 && (lq.includes('12h') || lq.includes('standard'))) {
      const r = execTime24to12(m2[1]);
      if (r) return r;
    }

    // Timer: "timer 5 minutes" / "set timer 30 seconds"
    m2 = q.match(/^(?:set\s+)?timer(?:\s+for)?\s+(\d+)\s+(seconds?|secs?|s|minutes?|mins?|m|hours?|hrs?|h)\b/i);
    if (m2) return execTimer(+m2[1], m2[2]);

    // SHA-256: "hash: hello"
    m2 = q.match(/^hash(?:\s+sha[\s-]?256)?(?:\s*:|\s+)(.+)/i);
    if (m2) return execHash(m2[1]);

    // BMI: "bmi 70 kg 175 cm" / "bmi 154 lb 5ft9"
    m2 = q.match(
      /^bmi\s+(\d+\.?\d*)\s*(kg|kilo|lb|pounds?)?(?:.*?)(\d+\.?\d*)\s*(cm|m|meters?|ft|feet|foot|in|inches?|'|")?/i,
    );
    if (m2) {
      const r = execBmi(+m2[1], m2[2] || 'kg', +m2[3], m2[4] || 'cm');
      if (r) return r;
    }

    // Slug: "slug: Hello World"
    m2 = q.match(/^(?:slug|slugify)(?:\s*:|\s+)(.+)/i);
    if (m2) return '<span class="text-purple-300">Slug:</span> <code>' + execSlug(m2[1]) + '</code>';

    // Binary: "text to binary: hello" / "binary to text: 01101000"
    m2 = q.match(/^(?:text|string)\s+(?:to|2|->)\s+binary(?:\s*:|\s+)(.+)/i);
    if (m2) return '<span class="text-purple-300">Binary:</span> <code>' + execTextToBinary(m2[1]) + '</code>';
    m2 = q.match(/^(?:binary|bin)\s+(?:to|2|->)\s+(?:text|string)(?:\s*:|\s+)(.+)/i);
    if (m2) {
      const r = execBinaryToText(m2[1]);
      if (r) return '<span class="text-purple-300">Decoded:</span> <code>' + r + '</code>';
    }

    // ASCII: "ascii A" / "char 65"
    m2 = q.match(/^ascii\s+(.)/i);
    if (m2) {
      const r = execAscii(m2[1]);
      if (r) return r;
    }
    m2 = q.match(/^(?:char|chr|code|character)\s+(\d+)/i);
    if (m2) {
      const r = execCharCode(m2[1]);
      if (r) return r;
    }

    // Dice: "roll d20" / "3d6+2"
    m2 = q.match(/^(?:roll|dice|d)\s+(\d*d\d+(?:\s*[+-]\s*\d+)?)/i);
    if (m2) {
      const r = execDice(m2[1].replace(/\s/g, ''));
      if (r) return r;
    }
    m2 = q.match(/^(\d*d\d+(?:\s*[+-]\s*\d+)?)$/i);
    if (m2) {
      const r = execDice(m2[1].replace(/\s/g, ''));
      if (r) return r;
    }

    // Password strength: "strength: MyP@ss"
    m2 = q.match(/^(?:strength|check\s+password|pwd\s+strength)(?:\s*:|\s+)(.+)/i);
    if (m2) return execPasswordStrength(m2[1]);

    // Fibonacci: "fibonacci 10" / "fib 10"
    m2 = q.match(/^(?:fibonacci|fib)\s+(\d{1,3})/i);
    if (m2) {
      const r = execFibonacci(m2[1]);
      if (r) return r;
    }

    // Prime: "prime 17" / "factors 12" / "is 17 prime"
    m2 = q.match(/^(?:prime|factors?)\s+(\d+)/i);
    if (m2) {
      const r = execPrimeCheck(m2[1]);
      if (r) return r;
    }
    m2 = q.match(/^is\s+(\d+)\s+prime/i);
    if (m2) {
      const r = execPrimeCheck(m2[1]);
      if (r) return r;
    }

    // Day of week: "day 2026-06-04"
    m2 = q.match(/^(?:day|weekday|what\s+day)\s+(\d{4}[-/]\d{1,2}[-/]\d{1,2})/i);
    if (m2) {
      const r = execDayOfWeek(m2[1]);
      if (r) return r;
    }

    // Leap year: "leap 2024" / "is 2024 a leap year"
    m2 = q.match(/^(?:is\s+)?(\d{4})\s+a\s+leap\s+year/i);
    if (m2) {
      const r = execLeapYear(m2[1]);
      if (r) return r;
    }
    m2 = q.match(/^(?:leap|leap\s+year)\s+(\d{4})/i);
    if (m2) {
      const r = execLeapYear(m2[1]);
      if (r) return r;
    }

    // Quote: "quote" / "inspire me"
    if (/^(?:quote|inspire|inspire me|random quote|motivate|motivate me|wisdom)$/i.test(lq)) return execQuote();

    // Lottery: "lottery" / "lotto 6/49"
    m2 = q.match(/^(?:lottery|lotto)\s*(?:\s+(\d+)(?:\s*\/\s*(\d+))?)?/i);
    if (m2) return execLottery(m2[1] ? +m2[1] : 6, m2[2] ? +m2[2] : 49);

    // 15) Find tools by category
    const catPatterns = {
      image: 'Image',
      creator: 'Creator',
      utility: 'Utility',
      cricket: 'Cricket',
      ai: 'AI',
      developer: 'Developer',
    };
    for (const [key, val] of Object.entries(catPatterns)) {
      if (
        lq.includes(`find ${key}`) ||
        lq.includes(`show ${key}`) ||
        lq === key ||
        lq === `${key} tools` ||
        lq.includes(`list ${key}`)
      ) {
        const tools = quickTools.filter((t) => normalize(t.cat) === normalize(val));
        return `<div class="text-[11px] space-y-1"><span class="font-semibold text-purple-300">${val} Tools (${tools.length}):</span>
          ${tools.map((t) => `<div class="text-[10px] flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-purple-500 shrink-0"></span><a href="${t.url}" class="text-purple-400 hover:underline">${t.name}</a>: ${t.desc}</div>`).join('')}</div>`;
      }
    }

    // 16) Q&A about tools
    if (/how many tools/.test(lq)) return `We have <b>${quickTools.length} tools</b> across 6 categories.`;
    if (/how many categories/.test(lq)) return `There are <b>6 categories</b> with ${quickTools.length} total tools.`;
    if (/what'?s new|latest|recent/.test(lq))
      return `<a href="/tools/" class="text-purple-400 hover:underline">Check the latest tools</a> — we recently added AI tools, developer formatters, and more!`;
    if (/popular|best|top|trending/.test(lq))
      return `Popular tools: <a href="/tools/" class="text-purple-400 hover:underline">QR Generator</a>, Word Counter, Password Generator, AI Grammar Checker, and Base64 Tool.`;

    // 17) Tool search (fuzzy)
    const found = quickTools
      .filter((t) => {
        const n = normalize(t.name + ' ' + t.desc + ' ' + t.cat);
        const words = lq.split(/\s+/).filter(Boolean);
        return words.some((w) => n.includes(w) && w.length > 1);
      })
      .slice(0, 5);
    if (found.length > 0) {
      return `<div class="text-[11px] space-y-1"><span class="font-semibold text-purple-300">Matching tools:</span>
        ${found.map((t) => `<div class="text-[10px]"><a href="${t.url}" class="text-purple-400 hover:underline">${t.name}</a>: ${t.desc}</div>`).join('')}</div>`;
    }

    return null; // not matched
  }

  // ──────────────────────────────────────────────
  // UI LOGIC
  // ──────────────────────────────────────────────

  const quickTools = [
    { name: 'QR Generator', cat: 'Creator', desc: 'Generate QR codes from URLs and text', url: '/tools/qr-generator/' },
    { name: 'Word Counter', cat: 'Utility', desc: 'Count words, characters, sentences', url: '/tools/word-counter/' },
    {
      name: 'Password Generator',
      cat: 'Utility',
      desc: 'Generate secure passwords',
      url: '/tools/password-generator/',
    },
    { name: 'JSON Formatter', cat: 'Developer', desc: 'Format and validate JSON', url: '/tools/json-formatter/' },
    { name: 'Base64 Tool', cat: 'Developer', desc: 'Encode/decode Base64', url: '/tools/base64-tool/' },
    { name: 'UUID Generator', cat: 'Developer', desc: 'Generate UUIDs', url: '/tools/uuid-generator/' },
    { name: 'Unit Converter', cat: 'Utility', desc: 'Convert between units', url: '/tools/unit-converter/' },
    { name: 'AI Text Summarizer', cat: 'AI', desc: 'Summarize text with AI', url: '/tools/ai-text-summarizer/' },
    { name: 'AI Grammar Checker', cat: 'AI', desc: 'Check grammar with AI', url: '/tools/ai-grammar-checker/' },
    { name: 'AI Sentiment Analyzer', cat: 'AI', desc: 'Analyze text sentiment', url: '/tools/ai-sentiment-analyzer/' },
    {
      name: 'Color Converter',
      cat: 'Developer',
      desc: 'Convert between color formats',
      url: '/tools/color-converter/',
    },
    {
      name: 'Percentage Calculator',
      cat: 'Utility',
      desc: 'Calculate percentages',
      url: '/tools/percentage-calculator/',
    },
    {
      name: 'Random Number Gen',
      cat: 'Utility',
      desc: 'Generate random numbers',
      url: '/tools/random-number-generator/',
    },
    { name: 'URL Encoder', cat: 'Developer', desc: 'Encode/decode URLs', url: '/tools/url-encoder/' },
    { name: 'Case Converter', cat: 'Creator', desc: 'Convert text case', url: '/tools/case-converter/' },
    { name: 'AI Chat Assistant', cat: 'AI', desc: 'Chat about tools and tasks', url: '/tools/ai-chat/' },
  ];

  function normalize(str) {
    return str
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9\s]/g, '');
  }

  const panel = document.getElementById('ai-chat-panel');
  const fab = document.getElementById('ai-fab');
  const fabIcon = document.getElementById('ai-fab-icon');
  const closeIcon = document.getElementById('ai-close-icon');
  const closeBtn = document.getElementById('ai-close-btn');
  const messages = document.getElementById('ai-messages');
  const form = document.getElementById('ai-chat-form');
  const input = document.getElementById('ai-chat-input');
  const sendBtn = document.getElementById('ai-send-btn');

  let isOpen = false;

  function togglePanel() {
    isOpen = !isOpen;
    panel.classList.toggle('hidden', !isOpen);
    fabIcon.classList.toggle('hidden', isOpen);
    closeIcon.classList.toggle('hidden', !isOpen);
    if (isOpen) setTimeout(() => input?.focus(), 100);
  }

  fab?.addEventListener('click', togglePanel);
  closeBtn?.addEventListener('click', togglePanel);

  function escapeHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function addMessage(html, isUser, isResult) {
    const div = document.createElement('div');
    div.className = `flex items-start gap-2.5 ${isUser ? 'flex-row-reverse' : ''}`;
    const bubbleClass = isUser
      ? 'bg-purple-500/10 border border-purple-500/20 rounded-xl rounded-tr-none'
      : isResult
        ? 'bg-surface-2 rounded-xl rounded-tl-none'
        : 'bg-surface-2 rounded-xl rounded-tl-none';
    div.innerHTML = isUser
      ? `
      <div class="w-6 h-6 rounded-lg bg-purple-500/20 flex items-center justify-center shrink-0 mt-0.5">
        <svg class="w-3 h-3 text-purple-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div class="${bubbleClass} px-3.5 py-2.5 max-w-[85%]">
        <p class="text-xs text-primary leading-relaxed">${escapeHtml(html)}</p>
      </div>
    `
      : `
      <div class="w-6 h-6 rounded-lg bg-gradient-to-br from-purple-500 to-blue-600 flex items-center justify-center shrink-0 mt-0.5">
        <svg class="w-3 h-3 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <div class="${bubbleClass} px-3.5 py-2.5 max-w-[90%] ${isResult ? 'w-full' : ''}">
        <div class="text-xs text-secondary leading-relaxed">${isResult ? html : escapeHtml(html)}</div>
      </div>
    `;
    messages?.appendChild(div);
    messages?.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
  }

  function handleSend(e) {
    e?.preventDefault();
    const text = input?.value.trim();
    if (!text) return;

    addMessage(text, true, false);
    input.value = '';
    sendBtn.disabled = true;

    setTimeout(
      () => {
        const result = parseAndExec(text);
        if (result && typeof result.then === 'function') {
          result.then((r) => {
            if (r) {
              addMessage(r, false, true);
            } else {
              addMessage(
                "I didn't understand that. Try something like:\n\u2022 <code>summarize: your text</code>\n\u2022 <code>generate password 20</code>\n\u2022 <code>encode base64: hello</code>\n\u2022 <code>calculate 5*10+3</code>\n\u2022 <code>hash: hello world</code>\n\u2022 <code>roll d20</code>\n\u2022 <code>bmi 70 kg 175 cm</code>\n\u2022 <code>lottery 6/49</code>",
                false,
                false,
              );
            }
            sendBtn.disabled = false;
            input.focus();
          });
          return;
        }
        if (result) {
          addMessage(result, false, true);
        } else if (/^(hi|hello|hey|howdy|sup|yo)\b/i.test(text)) {
          addMessage(
            'Hey there! I can run any tool right here. Try: summarize, grammar, sentiment, password, uuid, json format, encode base64, convert, random, calculate, timer, hash, bmi, dice, lottery, quote, or ask about tools.',
            false,
            false,
          );
        } else if (/^(thanks|thank you|thx|ty)\b/i.test(text)) {
          addMessage("You're welcome! Let me know what else you need.", false, false);
        } else {
          addMessage(
            "I didn't understand that. Try something like:\n\u2022 <code>summarize: your text</code>\n\u2022 <code>generate password 20</code>\n\u2022 <code>calculate 5*10+3</code>\n\u2022 <code>hash: hello world</code>\n\u2022 <code>timer 5 minutes</code>\n\u2022 <code>roll d20</code>\n\u2022 <code>bmi 70 kg 175 cm</code>\n\u2022 <code>lottery 6/49</code>\n\u2022 <code>convert 5 feet to meters</code>\n\u2022 <code>quote</code>",
            false,
            false,
          );
        }
        sendBtn.disabled = false;
        input.focus();
      },
      300 + Math.random() * 300,
    );
  }

  form?.addEventListener('submit', handleSend);
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) handleSend();
  });
  input?.addEventListener('input', () => {
    sendBtn.disabled = !input.value.trim();
  });

  document.querySelectorAll('.ai-suggestion').forEach((el) => {
    el.addEventListener('click', () => {
      input.value = el.textContent || '';
      if (!panel?.classList.contains('hidden')) handleSend();
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) togglePanel();
  });
</script>
