  // -- Random Numbers --
  function genRandom(min, max, count) {
    const mn = Math.min(min, max),
      mx = Math.max(min, max);
    const c = Math.max(1, Math.min(100, count || 1));
    const nums = [];
    const used = new Set();
    for (let i = 0; i < c; i++) {
      let num,
        att = 0;
      do {
        num = Math.floor(Math.random() * (mx - mn + 1)) + mn;
        att++;
      } while (used.has(num) && att < 1000);
      used.add(num);
      nums.push(num);
    }
    return `<div class="text-[11px] space-y-1">
      <span class="text-muted">Range:</span> ${mn} – ${mx} &nbsp;|&nbsp; <span class="text-muted">Count:</span> ${nums.length}
