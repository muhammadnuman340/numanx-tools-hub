  function findUnit(str) {
    const s = str.toLowerCase().replace(/s$/, '');
    for (const [cat, data] of Object.entries(unitData)) {
      for (const u of data.units) {
        if (
          u.label.toLowerCase().replace(/s$/, '') === s ||
          u.label.toLowerCase().startsWith(s) ||
          s.startsWith(u.label.toLowerCase().replace(/s$/, ''))
        )
          return { cat, unit: u };
      }
    }
    // Abbreviations
    const abbr = {
      km: ['length', 'Kilometers'],
      m: ['length', 'Meters'],
      cm: ['length', 'Centimeters'],
      mm: ['length', 'Millimeters'],
      mi: ['length', 'Miles'],
      ft: ['length', 'Feet'],
      in: ['length', 'Inches'],
      yd: ['length', 'Yards'],
      kg: ['mass', 'Kilograms'],
      g: ['mass', 'Grams'],
      lb: ['mass', 'Pounds'],
      oz: ['mass', 'Ounces'],
      c: ['temp', 'Celsius'],
      f: ['temp', 'Fahrenheit'],
      k: ['temp', 'Kelvin'],
      mb: ['data', 'MB'],
      gb: ['data', 'GB'],
      tb: ['data', 'TB'],
      l: ['volume', 'Liters'],
      ml: ['volume', 'Milliliters'],
      gal: ['volume', 'Gallons'],
    };
    if (abbr[s]) {
      const [cat2, label2] = abbr[s];
      const u2 = unitData[cat2].units.find((u) => u.label === label2);
      return u2 ? { cat: cat2, unit: u2 } : null;
    }
    return null;
  }
  function convertUnit(value, fromUnit, toUnit) {
    if (fromUnit.cat !== toUnit.cat) return null;
    if (fromUnit.cat === 'temp') {
      let celsius;
      if (fromUnit.unit.label === 'Celsius') celsius = value;
      else if (fromUnit.unit.label === 'Fahrenheit') celsius = ((value - 32) * 5) / 9;
      else celsius = value - 273.15;
      if (toUnit.unit.label === 'Celsius') return celsius;
      if (toUnit.unit.label === 'Fahrenheit') return (celsius * 9) / 5 + 32;
      return celsius + 273.15;
    }
    return (value * fromUnit.unit.f) / toUnit.unit.f;
  }
  function execConvert(value, fromStr, toStr) {
    const f = findUnit(fromStr),
      t = findUnit(toStr);
    if (!f || !t) return null;
    if (f.cat !== t.cat)
      return `<span class="text-amber-400">Cannot convert ${fromStr} (${f.cat}) to ${toStr} (${t.cat})</span>`;
    const result = convertUnit(value, f, t);
    return `<span class="text-purple-300 font-semibold">${value} ${f.unit.label} = ${result < 0.001 || result > 1e9 ? result.toExponential(4) : result.toFixed(4)} ${t.unit.label}</span>`;
  }

  // -- Math Evaluator --
  function execMath(expr) {
    const s = expr.replace(/[^0-9+\-*/.()%^ ]/g, '').replace(/\^/g, '**');
    if (!s || s.length > 200) return null;
    try {
      const r = Function('use strict; return (' + s + ')')();
      if (typeof r !== 'number' || !isFinite(r)) return null;
      return (
        '<span class="text-purple-300 font-semibold">Result: ' + (Number.isInteger(r) ? r : r.toFixed(6)) + '</span>'
      );
    } catch (e) {
      return null;
    }
  }

  // -- Number Base Converter --
  function execBaseConvert(value, fromBase, toBase) {
    const bases = { decimal: 10, hex: 16, hexadecimal: 16, binary: 2, bin: 2, octal: 8, oct: 8 };
    const fb = bases[fromBase.toLowerCase()] || parseInt(fromBase) || 10;
    const tb = bases[toBase.toLowerCase()] || parseInt(toBase) || 10;
    if (fb < 2 || fb > 36 || tb < 2 || tb > 36) return null;
    try {
      const dec = parseInt(String(value).replace(/^0x/i, ''), fb);
      if (isNaN(dec)) return null;
      const result = dec.toString(tb).toUpperCase();
      const labels = { 2: 'Binary', 8: 'Octal', 10: 'Decimal', 16: 'Hexadecimal' };
      return (
        '<span class="text-purple-300 font-semibold">' +
        value +
        ' (' +
        (labels[fb] || 'Base-' + fb) +
        ') = ' +
        result +
        ' (' +
        (labels[tb] || 'Base-' + tb) +
        ')</span>'
      );
    } catch (e) {
      return null;
    }
  }

  // -- Date Difference --
  function execDateDiff(d1, d2) {
    const a = new Date(d1),
      b = new Date(d2);
    if (isNaN(a) || isNaN(b)) return null;
    const days = Math.floor(Math.abs(b - a) / 86400000);
    const weeks = Math.floor(days / 7);
    const months = Math.floor(days / 30.44);
    const years = Math.floor(days / 365.25);
    return (
      '<span class="text-purple-300 font-semibold">' +
      days +
      ' days</span> (' +
      weeks +
      ' weeks, ' +
      months +
      ' months, ~' +
      years +
      ' years) between ' +
      d1 +
      ' and ' +
      d2
    );
  }

  // -- Days Until --
  function execDaysUntil(dateStr) {
    const target = new Date(dateStr);
    if (isNaN(target)) return null;
    const ms = target - new Date();
    const days = Math.ceil(ms / 86400000);
    if (days < 0)
      return '<span class="text-zinc-400">' + Math.abs(days) + ' days ago (' + dateStr + ' was in the past)</span>';
    if (days === 0) return '<span class="text-emerald-400 font-semibold">Today! ' + dateStr + ' is today!</span>';
    return (
      '<span class="text-purple-300 font-semibold">' +
      days +
      ' days</span> until ' +
      dateStr +
      ' (~' +
      Math.floor(days / 7) +
      ' weeks)'
    );
  }

  // -- Add Days to Date --
  function execAddDays(dateStr, days) {
    const d = new Date(dateStr);
    if (isNaN(d)) return null;
    d.setDate(d.getDate() + days);
    return (
      '' +
      dateStr +
      ' + ' +
      days +
      ' days = <span class="text-purple-300">' +
      d.toISOString().split('T')[0] +
      '</span> (' +
      d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) +
      ')'
    );
  }

  // -- ROT13 --
  function execRot13(text) {
    return text.replace(/[a-zA-Z]/g, (c) => {
      const code = c.charCodeAt(0);
      if (code >= 65 && code <= 90) return String.fromCharCode(((code - 65 + 13) % 26) + 65);
      return String.fromCharCode(((code - 97 + 13) % 26) + 97);
    });
  }

  // -- Reverse Text --
  function execReverse(text) {
    return text.split('').reverse().join('');
  }

  // -- Palindrome Check --
  function execPalindrome(text) {
    const clean = text.toLowerCase().replace(/[^a-z0-9]/g, '');
    const isPal = clean === clean.split('').reverse().join('');
    return (
      (isPal ? '<span class="text-emerald-400">\u2713 Yes!</span>' : '<span class="text-red-400">\u2717 No.</span>') +
      ' "' +
      text +
      '" is ' +
      (isPal ? '' : 'not ') +
      'a palindrome.'
    );
  }

  // -- Morse Encode --
  function execMorseEncode(text) {
    return text
      .toUpperCase()
      .split('')
      .map((c) => morseMap[c] || '')
      .filter(Boolean)
      .join(' ');
  }

  // -- Morse Decode --
  function execMorseDecode(code) {
    return code
      .trim()
      .split(/\s+/)
      .map((s) => revMorse[s] || '')
      .join('');
  }

  // -- List Sort --
  function execListSort(text) {
    const items = text
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);
    if (items.length < 2) return null;
    return '<span class="text-purple-300">Sorted:</span> ' + items.sort((a, b) => a.localeCompare(b)).join(', ');
  }

  // -- List Reverse --
  function execListReverse(text) {
    const items = text
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);
    if (items.length < 2) return null;
    return '<span class="text-purple-300">Reversed:</span> ' + items.reverse().join(', ');
  }

  // -- List Shuffle --
  function execListShuffle(text) {
    const items = text
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);
    if (items.length < 2) return null;
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }
    return '<span class="text-purple-300">Shuffled:</span> ' + items.join(', ');
  }

  // -- List Dedupe --
  function execListDedupe(text) {
    const items = text
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);
    if (items.length < 2) return null;
    return '<span class="text-purple-300">Unique:</span> ' + [...new Set(items)].join(', ');
  }

  // -- Character Frequency --
  function execCharFreq(text) {
    const clean = text.toLowerCase().replace(/[^a-z0-9]/g, '');
    if (!clean) return null;
    const freq = {};
    for (const c of clean) freq[c] = (freq[c] || 0) + 1;
    const sorted = Object.entries(freq)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 10);
    return (
      '<span class="text-purple-300">Character frequency (top 10):</span><br>' +
      sorted.map(([c, n]) => '<code>' + c + '</code>: ' + n + '').join('  ')
    );
  }

