---
import MainLayout from "../layouts/MainLayout.astro";
import { getFeaturedTools, getPopularTools, categories as catInfos } from "../data/tools";
import AdSlot from "../components/AdSlot.astro";
import CarbonAd from "../components/CarbonAd.astro";
import ValueCard from "../components/ui/ValueCard.astro";
import ToolIcon from "../components/icons/ToolIcon.astro";
import AdUnit from "../components/AdUnit.astro";

const featuredTools = getFeaturedTools(6).map((t) => ({
  name: t.name, desc: t.longDescription, url: t.url, icon: t.icon,
  cat: catInfos.find((c) => c.id === t.category)?.title || t.category,
}));

const categories = catInfos.map((c) => ({
  title: c.title, desc: c.description, count: `${c.count} Tools`, icon: c.icon, gradient: c.gradient,
}));

const whyNumanX = [
  { title: "Fast Browser Processing", desc: "No backends or queues. All file conversions and generation happen instantly in your browser via Web APIs.", icon: "bolt" },
  { title: "Privacy Friendly", desc: "Your data never leaves your computer. Files are processed entirely client-side, making it 100% secure.", icon: "lock" },
  { title: "Free Forever", desc: "No subscriptions, hidden costs, watermarks, or limitations. Enjoy enterprise-grade utilities completely free.", icon: "target" },
  { title: "Mobile Friendly", desc: "Fully adaptive responsive viewport adjustments optimized for smartphones, tablets, and desktop displays.", icon: "mobile" },
  { title: "SEO Optimized", desc: "Blazing fast load speeds, proper metadata nesting, structural schema markup, and crawlable URL paths.", icon: "rocket" },
  { title: "Accessible Anywhere", desc: "Serverless delivery ensures 100% uptime, accessible around the globe with near-zero latency.", icon: "globe" },
];

const popularTools = getPopularTools(4).map((t) => ({
  name: t.name, url: t.url, icon: t.icon, badge: t.isNew ? "New" : t.isPopular ? "Popular" : "Trending",
}));

const blogPosts = [
  { title: "Best Free Image Tools 2026", desc: "The best free image editing and conversion tools available online in 2026.", url: "/blog/best-free-image-tools-2026/", time: "5 min read", imgText: "Image Tools" },
  { title: "Best AI Tools for Students", desc: "Top AI tools every student should use in 2026 for studying, writing, and research.", url: "/blog/best-ai-tools-for-students/", time: "7 min read", imgText: "AI Tools" },
  { title: "Best YouTube Tools for Creators", desc: "Essential tools for YouTube creators to grow channels and edit videos.", url: "/blog/best-youtube-tools-for-creators/", time: "6 min read", imgText: "Creator Tools" },
  { title: "How to Compress Images", desc: "Learn how to compress images without losing quality using free online tools.", url: "/blog/how-to-compress-images/", time: "5 min read", imgText: "Image Tips" },
];

const roadmap = [
  { phase: "Phase 1", title: "NumanX Tools", desc: "Premium online tools for image optimization, text analysis, QR assets, and sports utilities. Fully active and operational.", status: "Completed" },
  { phase: "Phase 2", title: "Creator Hub", desc: "A resource ecosystem for templates, overlay packs, assets, and curated guides.", status: "Upcoming" },
  { phase: "Phase 3", title: "Cricket Analytics", desc: "Advanced database structures tracking player performance metrics, match models, and form analysis.", status: "In Planning" },
  { phase: "Phase 4", title: "AI Platform", desc: "Client-side machine learning templates for visual and textual generation.", status: "Future" },
  { phase: "Phase 5", title: "Operating Brain", desc: "Seamless orchestration layer connecting individual tools into a synchronized personal workspace.", status: "Long-term" },
];
---

<MainLayout title="NumanX Tools — Free Online Tools for Creators, Students &amp; Professionals" description="Free online tools including image converters, QR generators, word counters, creator tools, cricket calculators, and productivity utilities. Fast, private, and browser-based." keywords="free online tools, image compressor, image converter, qr code generator, word counter, cricket calculator, password generator, creator tools, productivity tools, browser based tools, free online tools for students, best free online tools">
  
  <!-- Glow Overlays -->
  <div class="absolute top-[10%] left-[5%] w-[400px] h-[400px] rounded-full bg-purple-600/10 blur-[100px] pointer-events-none -z-10"></div>
  <div class="absolute top-[40%] right-[5%] w-[500px] h-[500px] rounded-full bg-blue-600/10 blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-[15%] left-[10%] w-[350px] h-[350px] rounded-full bg-purple-500/10 blur-[90px] pointer-events-none -z-10"></div>

  <main class="min-h-screen pt-12 pb-24 px-4 sm:px-6 relative overflow-hidden">
    <div class="max-w-7xl mx-auto">

      <!-- ================= HERO SECTION ================= -->
      <section class="relative pt-12 md:pt-20 pb-20 md:pb-28">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-7 text-left animate-[fadeInUp_0.6s_ease-out]">
            <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-surface bg-surface-1 text-tertiary text-xs font-semibold tracking-wider uppercase mb-8">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
              </span>
              Platform v3.0
            </div>
            
            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[1.05] text-white text-balance">
              Free Online Tools for
              <span class="block mt-3 bg-gradient-to-r from-purple-300 via-purple-400 to-blue-400 bg-clip-text text-transparent drop-shadow-[0_2px_12px_rgba(168,85,247,0.15)]">
                Creators, Students & Builders
              </span>
            </h1>
            
            <p class="mt-6 text-tertiary text-lg sm:text-xl max-w-2xl leading-[1.75]">
              <span class="text-purple-400 font-semibold">Build. Create. Analyze.</span> Powerful image tools, creator utilities, calculators, and cricket analytics — all free, client-side, and privacy-friendly.
            </p>
            
            <div class="mt-10 flex flex-wrap items-center gap-4">
              <a href="/tools/" class="group inline-flex items-center gap-2 bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm px-6 py-3.5 rounded-xl transition-all duration-200 hover:scale-[1.03] active:scale-[0.97] hover:-translate-y-0.5 shadow-lg shadow-purple-900/40 hover:shadow-purple-500/40">
                Explore Tools
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <a href="/blog/" class="group inline-flex items-center gap-2 border border-surface-3 hover:border-purple-500/40 text-secondary hover:text-white font-semibold text-sm px-6 py-3.5 rounded-xl bg-surface-1 backdrop-blur-sm transition-all duration-200 hover:scale-[1.03] active:scale-[0.97] hover:-translate-y-0.5 hover:shadow-lg hover:shadow-purple-900/10">
                View Blog
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>
          </div>

          <!-- Hero Illustration / Floating UI Cards -->
          <div class="lg:col-span-5 relative hidden lg:block animate-[fadeInUp_0.6s_ease-out_0.15s_both]">
            <div class="relative w-full h-[440px] flex items-center justify-center">
              
              <!-- Core Graphic Orb -->
              <div class="absolute w-80 h-80 rounded-full bg-gradient-to-br from-purple-500/20 to-blue-500/15 blur-[80px] animate-[breathe_4s_ease-in-out_infinite]" />
              <div class="absolute w-48 h-48 rounded-full bg-purple-500/10 blur-[60px] animate-[breathe_6s_ease-in-out_2s_infinite]" />
              
              <!-- Center Command Palette Mockup -->
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-56 rounded-xl border border-surface-2 var(--surface-nav) p-3 backdrop-blur-xl shadow-2xl shadow-purple-900/20 animate-[fadeInUp_0.6s_ease-out_0.3s_both] hover:border-purple-500/30 transition-all duration-300">
                <div class="flex items-center gap-2 px-2 py-1.5 rounded-lg bg-surface-2 border border-surface">
                  <svg class="w-3.5 h-3.5 text-tertiary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                  <span class="text-[11px] text-tertiary">Search tools...</span>
                  <kbd class="ml-auto flex items-center gap-0.5 px-1 py-0.5 rounded bg-surface-2 text-muted text-[8px] font-mono border border-surface">
                    <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3"/></svg>
                    K
                  </kbd>
                </div>
                <div class="mt-2 space-y-1">
                  <div class="flex items-center gap-2 px-2 py-1 rounded-md hover:bg-surface-1 transition-colors">
                    <span class="w-4 h-4 rounded bg-purple-500/10 flex items-center justify-center text-[8px] text-purple-400 font-bold">W</span>
                    <span class="text-[10px] text-tertiary">Word Counter</span>
                    <span class="ml-auto text-[8px] text-muted">Ctrl+1</span>
                  </div>
                  <div class="flex items-center gap-2 px-2 py-1 rounded-md hover:bg-surface-1 transition-colors">
                    <span class="w-4 h-4 rounded bg-emerald-500/10 flex items-center justify-center text-[8px] text-emerald-400 font-bold">#</span>
                    <span class="text-[10px] text-tertiary">Hashtag Generator</span>
                    <span class="ml-auto text-[8px] text-muted">Ctrl+2</span>
                  </div>
                  <div class="flex items-center gap-2 px-2 py-1 rounded-md bg-purple-500/5 border border-purple-500/10">
                    <span class="w-4 h-4 rounded bg-blue-500/10 flex items-center justify-center text-[8px] text-blue-400 font-bold">QR</span>
                    <span class="text-[10px] text-purple-400 font-medium">QR Generator</span>
                    <span class="ml-auto text-[8px] text-purple-400">Active</span>
                  </div>
                </div>
              </div>
              
              <!-- Card 1: PNG to WebP -->
              <div class="absolute top-[8%] left-[8%] w-60 rounded-2xl border border-surface-2 bg-surface-nav p-4 shadow-2xl backdrop-blur-xl animate-[float_6s_ease-in-out_infinite] hover:border-purple-500/30 hover:shadow-purple-900/20 transition-all duration-300">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-purple-500/20 to-purple-600/10 flex items-center justify-center text-purple-400"><ToolIcon name="jpg2png" /></div>
                  <div>
                    <h4 class="text-xs font-semibold text-primary">PNG to WebP</h4>
                    <p class="text-[10px] text-tertiary">Fast client-side convert</p>
                  </div>
                </div>
                <div class="mt-3 h-1.5 w-full bg-surface-2 rounded-full overflow-hidden">
                  <div class="h-full bg-gradient-to-r from-purple-500 to-purple-400 w-[85%] rounded-full"></div>
                </div>
                <div class="mt-2 flex justify-between text-[9px] text-tertiary">
                  <span>85% smaller</span>
                  <span>2.4MB → 360KB</span>
                </div>
              </div>

              <!-- Card 2: QR Generator -->
              <div class="absolute bottom-[12%] right-[6%] w-56 rounded-2xl border border-surface-2 bg-surface-nav p-4 shadow-2xl backdrop-blur-xl animate-[float_8s_ease-in-out_2s_infinite] hover:border-purple-500/30 hover:shadow-purple-900/20 transition-all duration-300">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-500/20 to-blue-600/10 flex items-center justify-center text-blue-400"><ToolIcon name="qr" /></div>
                  <div>
                    <h4 class="text-xs font-semibold text-primary">QR Generator</h4>
                    <p class="text-[10px] text-tertiary">Generate instantly</p>
                  </div>
                </div>
                <div class="mt-3 space-y-1.5">
                  <div class="flex justify-between text-[10px]">
                    <span class="text-tertiary">Type:</span>
                    <span class="text-secondary">WiFi Network</span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span class="relative flex h-1.5 w-1.5">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
                    </span>
                    <span class="text-[10px] text-emerald-400 font-medium">Ready to scan</span>
                  </div>
                </div>
              </div>

              <!-- Card 3: Performance Stats -->
              <div class="absolute top-[40%] right-[12%] w-52 rounded-2xl border border-surface-2 bg-surface-nav p-4 shadow-2xl backdrop-blur-xl animate-[float_7s_ease-in-out_1s_infinite] hover:border-purple-500/30 hover:shadow-purple-900/20 transition-all duration-300">
                <div class="flex items-center gap-2 mb-3">
                  <div class="w-2 h-2 rounded-full bg-emerald-500 shadow-lg shadow-emerald-500/30"></div>
                  <span class="text-[10px] text-emerald-400 font-semibold">100% Uptime</span>
                </div>
                <div class="space-y-2">
                  <div class="flex items-center justify-between text-[11px]">
                    <span class="text-tertiary">Speed</span>
                    <span class="text-purple-400 font-bold">98/100</span>
                  </div>
                  <div class="w-full h-1.5 bg-surface-2 rounded-full overflow-hidden">
                    <div class="h-full bg-gradient-to-r from-purple-500 to-blue-500 w-[98%] rounded-full"></div>
                  </div>
                  <div class="flex items-center justify-between text-[11px]">
                    <span class="text-tertiary">Privacy</span>
                    <span class="text-emerald-400 font-bold">100%</span>
                  </div>
                  <div class="w-full h-1.5 bg-surface-2 rounded-full overflow-hidden">
                    <div class="h-full bg-gradient-to-r from-emerald-500 to-emerald-400 w-full rounded-full"></div>
                  </div>
                </div>
              </div>
              
            </div>
          </div>

        </div>
      </section>

      <AdUnit format="horizontal" class="mb-16" />

      <!-- ================= STATS SECTION ================= -->
      <section class="mb-24 relative animate-[fadeInUp_0.6s_ease-out_0.3s_both]">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          <div class="relative rounded-2xl border border-surface bg-surface-1 backdrop-blur-xl p-6 hover:border-purple-500/30 hover:bg-surface-2 hover:-translate-y-0.5 transition-all duration-300 group overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 bg-purple-500/5 rounded-full blur-2xl group-hover:bg-purple-500/10 transition-colors"></div>
            <div class="text-4xl md:text-5xl font-black bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">
              <span class="stat-counter" data-target="16">16</span>+
            </div>
            <p class="text-sm font-semibold text-secondary mt-2">Tools Available</p>
            <p class="text-xs text-tertiary mt-1">Free tools ready for production</p>
          </div>
          <div class="relative rounded-2xl border border-surface bg-surface-1 backdrop-blur-xl p-6 hover:border-purple-500/30 hover:bg-surface-2 hover:-translate-y-0.5 transition-all duration-300 group overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 bg-blue-500/5 rounded-full blur-2xl group-hover:bg-blue-500/10 transition-colors"></div>
            <div class="text-4xl md:text-5xl font-black bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">
              <span class="stat-counter" data-target="4">4</span>
            </div>
            <p class="text-sm font-semibold text-secondary mt-2">Core Categories</p>
            <p class="text-xs text-tertiary mt-1">Image, Creator, Utility, Cricket</p>
          </div>
          <div class="relative rounded-2xl border border-surface bg-surface-1 backdrop-blur-xl p-6 hover:border-purple-500/30 hover:bg-surface-2 hover:-translate-y-0.5 transition-all duration-300 group overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 bg-purple-500/5 rounded-full blur-2xl group-hover:bg-purple-500/10 transition-colors"></div>
            <div class="text-4xl md:text-5xl font-black bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">
              <span class="stat-counter" data-target="100">100</span>%
            </div>
            <p class="text-sm font-semibold text-secondary mt-2">Free & Open</p>
            <p class="text-xs text-tertiary mt-1">No limits, no subscriptions</p>
          </div>
          <div class="relative rounded-2xl border border-surface bg-surface-1 backdrop-blur-xl p-6 hover:border-purple-500/30 hover:bg-surface-2 hover:-translate-y-0.5 transition-all duration-300 group overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 bg-blue-500/5 rounded-full blur-2xl group-hover:bg-blue-500/10 transition-colors"></div>
            <div class="text-4xl md:text-5xl font-black bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">
              100%
            </div>
            <p class="text-sm font-semibold text-secondary mt-2">Privacy Secured</p>
            <p class="text-xs text-tertiary mt-1">No database or cookies required</p>
          </div>
        </div>
      </section>

      <!-- ================= FEATURED TOOLS ================= -->
      <section class="mb-24 animate-[fadeInUp_0.6s_ease-out_0.45s_both]">
        <div class="flex items-end justify-between mb-10">
          <div>
            <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Top Selections</span>
            <h2 class="text-3xl md:text-4xl font-black tracking-tight text-white mt-1">
              Featured
              <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Utilities</span>
            </h2>
          </div>
          <a href="/tools/" class="group text-sm font-semibold text-tertiary hover:text-white flex items-center gap-1.5 transition-colors">
            Explore All Tools
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform group-hover:translate-x-0.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredTools.map((tool, idx) => (
            <article class="group relative rounded-2xl border border-surface bg-[#111113]/30 card-glow p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-purple-500/30 hover:shadow-xl hover:shadow-purple-900/10 cursor-pointer" style={`animation: fadeInUp 0.5s ease-out ${0.6 + idx * 0.1}s both`} onclick={`window.location='${tool.url}'`} onkeydown={`if(event.key==='Enter')window.location='${tool.url}'`} tabindex="0" role="link" aria-label={`Open ${tool.name}`}>
              <div>
                <div class="flex items-center justify-between">
                  <span class="w-10 h-10 rounded-xl bg-purple-600/10 flex items-center justify-center text-purple-400 shrink-0 group-hover:scale-110 group-hover:bg-purple-600/20 transition-all duration-200"><ToolIcon name={tool.icon} /></span>
                  <span class="text-[10px] text-tertiary font-medium px-2 py-0.5 rounded-md bg-surface-2">{tool.cat}</span>
                </div>
                <h3 class="text-base font-bold text-primary group-hover:text-white mt-4 transition-colors">{tool.name}</h3>
                <p class="text-xs text-muted mt-2 leading-relaxed">{tool.desc}</p>
              </div>
              <div class="mt-6 flex items-center gap-2 text-xs font-semibold text-purple-400 group-hover:text-purple-300">
                Open Tool
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform group-hover:translate-x-0.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Monetization Row -->
      <div class="mb-24 grid grid-cols-1 lg:grid-cols-2 gap-6">
        <AdSlot />
        <CarbonAd />
      </div>

      <!-- ================= TOOL CATEGORIES ================= -->
      <section class="mb-24 animate-[fadeInUp_0.6s_ease-out_0.7s_both]">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Diverse Ecosystem</span>
          <h2 class="text-3xl md:text-4xl font-black tracking-tight text-white mt-1">
            Browse Tools By
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Category</span>
          </h2>
          <p class="text-sm text-tertiary mt-3 max-w-lg mx-auto">
            Our platform features diverse divisions designed for lightning-fast delivery in image compression, cricket scoring, and utility tools.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {categories.map((cat) => (
            <div class="group rounded-2xl border border-surface bg-[#111113]/30 card-glow p-6 flex flex-col justify-between hover:border-purple-500/20 transition-all duration-300 hover:-translate-y-1">
              <div>
                <div class="flex items-center justify-between">
                  <ToolIcon name={cat.icon} class="text-2xl" />
                  <span class="text-[11px] font-bold text-tertiary px-2 py-0.5 rounded-full bg-zinc-800/80">{cat.count}</span>
                </div>
                <h3 class="text-lg font-bold text-primary mt-4 group-hover:text-white transition-colors">{cat.title}</h3>
                <p class="text-xs text-muted mt-2 leading-relaxed">{cat.desc}</p>
              </div>
              <div class="mt-6 border-t border-zinc-800/60 pt-4 flex justify-between items-center text-xs">
                <span class="text-tertiary">Instant Access</span>
                <a href="/tools/" class="text-purple-400 hover:text-purple-300 font-semibold flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                  Browse &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ================= WHY NUMANX TOOLS ================= -->
      <section class="mb-24 animate-[fadeInUp_0.6s_ease-out_0.85s_both]">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Built Uncompromisingly</span>
          <h2 class="text-3xl md:text-4xl font-black tracking-tight text-white mt-1">
            The Startup Choice for
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Everyday Utilities</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {whyNumanX.map((item, idx) => (
            <ValueCard title={item.title} description={item.desc} delay={0.85 + idx * 0.1}>
              <ToolIcon slot="icon" name={item.icon} />
            </ValueCard>
