---
// Homepage (DESIGN.md §4.2, UI plan Phase 7): search first, categories as ledger rows,
// how it works, latest posts, support bar, early-access form.
import MainLayout from '../layouts/MainLayout.astro';
import MonetizationSlot from '../components/MonetizationSlot.astro';
import { tools, categories, type Tool, type ToolCategory } from '../data/tools';

const toolCount = tools.length;

// Shown under the search box: the tools people come for most
const POPULAR: [id: string, label: string][] = [
  ['image-compressor', 'Image Compressor'],
  ['qr-generator', 'QR Generator'],
  ['word-counter', 'Word Counter'],
  ['net-run-rate-calculator', 'Net Run Rate'],
  ['json-formatter', 'JSON Formatter'],
  ['pdf-merger', 'PDF Merger'],
];
const popular = POPULAR.map(([id, label]) => ({ label, url: tools.find((t) => t.id === id)?.url })).filter(
  (p) => p.url,
);

// Category rows: image and cricket first (most searched), then the rest
const CATEGORY_ORDER: ToolCategory[] = [
  'image-tools',
  'developer-tools',
  'cricket-tools',
  'utility-tools',
  'creator-tools',
  'ai-tools',
];
const SHORT_NAME: Record<ToolCategory, string> = {
  'image-tools': 'image',
  'developer-tools': 'developer',
  'cricket-tools': 'cricket',
  'utility-tools': 'utility',
  'creator-tools': 'creator',
  'ai-tools': 'AI',
};
// The four tools each row leads with (most-used first)
const TOP: Record<ToolCategory, string[]> = {
  'image-tools': ['image-compressor', 'image-resizer', 'jpg-to-png', 'ai-background-remover'],
  'developer-tools': ['json-formatter', 'uuid-generator', 'base64-tool', 'regex-tester'],
  'cricket-tools': ['net-run-rate-calculator', 'run-rate-calculator', 'cricket-dls-calculator', 'cricket-target-calculator'],
  'utility-tools': ['word-counter', 'password-generator', 'pdf-merger', 'age-calculator'],
  'creator-tools': ['qr-generator', 'hashtag-generator', 'youtube-title-generator', 'markdown-editor'],
  'ai-tools': ['ai-chat', 'ai-text-summarizer', 'ai-grammar-checker', 'prompt-generator'],
};
const categoryRows = CATEGORY_ORDER.map((id) => {
  const info = categories.find((c) => c.id === id)!;
  const list = tools.filter((t) => t.category === id);
  const top = TOP[id].map((tid) => list.find((t) => t.id === tid)).filter(Boolean) as Tool[];
  return { id, title: info.title, count: list.length, top, short: SHORT_NAME[id] };
});

// Search index for the hero box (all tools, small fields only)
const searchIndex = tools.map((t) => ({
  n: t.name,
  d: t.description,
  u: t.url,
  c: categories.find((c) => c.id === t.category)?.title || '',
  k: t.keywords.join(' '),
}));

const blogPostModules = import.meta.glob('./blog/*.md', { eager: true });
const blogPosts = Object.entries(blogPostModules)
  .map(([path, mod]) => {
    const fm = (mod as any).frontmatter || {};
    const slug = path.replace('./blog/', '').replace('.md', '');
    return {
      title: fm.title || slug,
      desc: fm.description || '',
      url: `/blog/${slug}/`,
      time: fm.readingTime || '',
      date: String(fm.date || ''),
    };
  })
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

const steps = [
  {
    title: 'Open a tool',
    desc: 'No account, no install. Every tool works on a phone or a laptop.',
  },
  {
    title: 'Your files stay on your device',
    desc: 'Images, PDFs and text are processed by your browser. Nothing is uploaded to a server.',
  },
  {
    title: 'Download or copy the result',
    desc: 'No watermark and no sign-up wall. Close the tab and nothing is kept.',
  },
];

const title = `${toolCount} Free Online Tools — Images, QR, PDF & Text | NumanX`;
const description =
  'Free online tools that run in your browser: compress and convert images, make QR codes, merge PDFs, count words, format JSON and work out cricket run rates.';
---

<MainLayout
  {title}
  {description}
  keywords="free online tools, image compressor, image converter, qr code generator, pdf merger, word counter, json formatter, cricket run rate calculator, browser based tools"
>
  <main id="main-content" class="home relative">
    <!-- ── Hero: search is the main action ── -->
    <section class="home-wrap pt-10 sm:pt-16 pb-10 sm:pb-14" aria-labelledby="home-title">
      <p class="home-label">Free · No sign-up · Runs in your browser</p>
      <h1 id="home-title" class="home-h1">
        <span class="num">{toolCount}</span> free tools that run in your browser
      </h1>
      <p class="mt-4 max-w-[62ch] text-soft text-base sm:text-lg leading-relaxed">
        Compress images, make QR codes, merge PDFs, format JSON or work out a cricket run rate. Nothing is uploaded
        and there's nothing to install.
      </p>

      <form id="home-search-form" class="home-search mt-8" role="search" action="/search/" method="get">
        <label for="home-search" class="sr-only">Search {toolCount} tools</label>
        <svg
          class="home-search-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg
        >
        <input
          id="home-search"
          name="q"
          type="search"
          role="combobox"
          aria-expanded="false"
          aria-controls="home-search-results"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
          placeholder='Try "compress", "NRR" or "json"'
        />
        <kbd class="home-search-kbd" aria-hidden="true">/</kbd>
        <ul id="home-search-results" class="home-results hidden" role="listbox" aria-label="Matching tools"></ul>
      </form>
      <p id="home-search-status" class="sr-only" role="status" aria-live="polite"></p>

      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span class="home-label !mb-0 mr-1">Popular</span>
        {
          popular.map((t) => (
            <a href={t.url} class="home-pill">
              {t.label}
            </a>
          ))
        }
      </div>
    </section>

    <!-- ── Categories as ledger rows ── -->
    <section class="home-wrap pb-14" aria-labelledby="home-cats">
      <div class="flex items-end justify-between gap-4 mb-4">
        <h2 id="home-cats" class="home-h2">Tools by category</h2>
        <a href="/tools/" class="home-more">All {toolCount} tools →</a>
      </div>
      <div class="home-ledger grid sm:grid-cols-2 lg:grid-cols-3">
        {
          categoryRows.map((cat) => (
            <section class="home-cat" aria-labelledby={`cat-${cat.id}`}>
              <h3 id={`cat-${cat.id}`} class="home-cat-head">
                <a href={`/category/${cat.id}/`}>{cat.title}</a>
                <span class="num text-faint">{cat.count}</span>
              </h3>
              <ul class="home-cat-list">
                {cat.top.map((t) => (
                  <li>
                    <a href={t.url} class="home-tool">
                      <span class="home-tool-name">{t.name}</span>
                      <span class="home-tool-desc">{t.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <a href={`/category/${cat.id}/`} class="home-more mt-auto">
                All {cat.count} {cat.short} tools →
              </a>
            </section>
          ))
        }
      </div>
    </section>

    <!-- ── Recently used (only when this browser has used tools) ── -->
    <section id="recently-used-section" class="home-wrap pb-14 hidden" aria-labelledby="home-recent">
      <h2 id="home-recent" class="home-h2 mb-4">Used recently on this device</h2>
      <ul id="recently-used-grid" class="flex flex-wrap gap-2"></ul>
    </section>

    <!-- ── How it works ── -->
    <section class="home-wrap pb-14" aria-labelledby="home-how">
      <h2 id="home-how" class="home-h2 mb-4">How it works</h2>
      <ol class="home-steps grid md:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="home-step">
              <span class="num home-step-no">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="text-base font-semibold text-fg mt-2">{s.title}</h3>
              <p class="text-sm text-soft mt-1.5 leading-relaxed">{s.desc}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ── Latest posts ── -->
    {
      blogPosts.length > 0 && (
        <section class="home-wrap pb-10" aria-labelledby="home-blog">
          <div class="flex items-end justify-between gap-4 mb-4">
            <h2 id="home-blog" class="home-h2">From the blog</h2>
            <a href="/blog/" class="home-more">
              All posts →
            </a>
          </div>
          <ul class="home-posts">
            {blogPosts.map((p) => (
              <li>
                <a href={p.url} class="home-post">
                  <span class="home-post-title">{p.title}</span>
                  <span class="home-post-desc">{p.desc}</span>
                  {p.time && <span class="num home-post-time">{p.time}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- ── Support bar (below the categories, DESIGN.md §4.2) ── -->
    <div class="home-wrap">
      <MonetizationSlot slotType="pakistan-support-bar" />
    </div>

    <!-- ── Early access (ids and /api/subscribe call unchanged) ── -->
    <section class="home-wrap pt-4 pb-24" aria-labelledby="home-news">
      <div class="home-news">
        <div>
          <h2 id="home-news" class="home-h2">Get new tools by email</h2>
          <p class="text-sm text-soft mt-1.5 max-w-[52ch]">
            A short email when new tools or guides go live, at most a couple a month. You confirm by email first and
            can unsubscribe from any message.
          </p>
        </div>
        <form id="newsletter-form" class="flex flex-col sm:flex-row gap-2 w-full md:max-w-md">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input
            id="newsletter-email"
            type="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
            class="w-full sm:flex-1 min-w-0 h-11 px-4 rounded-lg bg-well border border-line-strong text-fg placeholder:text-faint focus:outline-none focus:border-amber-500/60"
          />
          <button
            type="submit"
            class="h-11 px-5 rounded-lg bg-accent text-accent-fg font-semibold hover:bg-amber-400 active:scale-[0.98] transition shrink-0"
            >Subscribe</button
          >
        </form>
        <p id="newsletter-msg" class="text-sm hidden md:col-span-2" role="status"></p>
      </div>
    </section>
  </main>
</MainLayout>

<script is:inline type="application/json" id="home-search-data" set:html={JSON.stringify(searchIndex).replace(/</g, String.raw`\u003c`)} />

<style is:global>
  .home-wrap {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 16px;
  }
  @media (min-width: 768px) {
    .home-wrap {
      padding-inline: 32px;
    }
  }
  .home-label {
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .home-h1 {
    max-width: 18ch;
    font-size: var(--step-4);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: balance;
  }
  .home-h2 {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  /* Search box */
  .home-search {
    position: relative;
    max-width: 720px;
  }
  .home-search input {
    width: 100%;
    height: 56px;
    padding: 0 52px 0 50px;
    border-radius: 14px;
    background: var(--well);
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-size: 1.0625rem;
    transition: border-color 150ms;
  }
  @media (max-width: 767px) {
    .home-search input {
      padding-right: 16px;
    }
  }
  .home-search input::placeholder {
    color: var(--text-faint);
  }
  .home-search input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .home-search input::-webkit-search-cancel-button {
    display: none;
  }
  .home-search-icon {
    position: absolute;
    left: 18px;
    top: 28px;
    width: 20px;
    height: 20px;
    transform: translateY(-50%);
    color: var(--text-faint);
    pointer-events: none;
  }
  .home-search-kbd {
    position: absolute;
    right: 16px;
    top: 28px;
    transform: translateY(-50%);
    min-width: 24px;
    height: 24px;
    display: none;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
    pointer-events: none;
  }
  @media (hover: hover) and (min-width: 768px) {
    .home-search-kbd {
      display: inline-flex;
    }
  }
  .home-results {
    position: absolute;
    z-index: 30;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    max-height: min(60vh, 420px);
    overflow-y: auto;
    padding: 6px;
    border-radius: 14px;
    background: var(--panel-2);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-lg);
  }
  .home-results a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 12px;
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--text);
  }
  .home-results [aria-selected='true'] a,
  .home-results a:hover {
    background: oklch(0.8 0.15 75 / 0.12);
  }
  .home-results .r-name {
    font-weight: 600;
  }
  .home-results .r-cat {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-faint);
    align-self: center;
  }
  .home-results .r-desc {
    grid-column: 1 / -1;
    font-size: 0.8125rem;
    color: var(--text-soft);
  }
  .home-results .r-empty {
    padding: 12px;
    font-size: 0.875rem;
    color: var(--text-soft);
  }
  .home-results mark {
    background: none;
    color: var(--accent);
  }

  .home-pill {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.875rem;
    color: var(--text-soft);
    transition:
      color 150ms,
      border-color 150ms;
  }
  .home-pill:hover {
    color: var(--text);
    border-color: oklch(0.8 0.15 75 / 0.5);
  }
  .home-more {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  .home-more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Category ledger: hairline grid, no floating cards */
  .home-ledger {
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .home-cat {
    display: flex;
    flex-direction: column;
    padding: 18px 20px 14px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .home-cat-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .home-cat-head a {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    color: var(--text);
  }
  .home-cat-head a:hover {
    color: var(--accent);
  }
  .home-cat-list {
    margin: 10px 0 8px;
  }
  .home-tool {
    display: block;
    padding: 8px 0;
    border-top: 1px solid var(--line);
  }
  .home-cat-list li:first-child .home-tool {
    border-top: 0;
  }
  .home-tool-name {
    display: block;
    font-weight: 600;
    color: var(--text);
  }
  .home-tool-desc {
    display: block;
    margin-top: 2px;
    font-size: 0.8125rem;
    color: var(--text-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .home-tool:hover .home-tool-name {
    color: var(--accent);
  }

  .home-steps {
    border-top: 1px solid var(--line);
  }
  .home-step {
    padding: 18px 20px 18px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 768px) {
    .home-step {
      border-bottom: 0;
      padding-right: 32px;
    }
  }
  .home-step-no {
    font-size: 13px;
    color: var(--accent);
  }

  .home-posts {
    border-top: 1px solid var(--line);
  }
  .home-post {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .home-post-title {
    font-weight: 600;
    color: var(--text);
  }
  .home-post:hover .home-post-title {
    color: var(--accent);
  }
  .home-post-desc {
    grid-column: 1;
    font-size: 0.875rem;
    color: var(--text-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .home-post-time {
    grid-column: 2;
    grid-row: 1;
    font-size: 12px;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .home-news {
    display: grid;
    gap: 16px;
    align-items: center;
    padding: 20px;
    border-radius: var(--radius-outer);
    background: var(--panel);
    border: 1px solid var(--line);
  }
  @media (min-width: 768px) {
    .home-news {
      grid-template-columns: 1fr auto;
      padding: 24px 28px;
    }
  }
</style>

<script>
  type Item = { n: string; d: string; u: string; c: string; k: string };
  const data: Item[] = JSON.parse(document.getElementById('home-search-data')?.textContent || '[]');

  // ── Hero search: all tools, ranked by where the words match ──
  const form = document.getElementById('home-search-form') as HTMLFormElement | null;
  const input = document.getElementById('home-search') as HTMLInputElement | null;
  const list = document.getElementById('home-search-results') as HTMLUListElement | null;
  const status = document.getElementById('home-search-status');
  let active = -1;
  let shown: Item[] = [];

  // Short forms people type
  const ALIASES: Record<string, string> = {
    nrr: 'net run rate',
    dls: 'duckworth lewis',
    img: 'image',
    pic: 'image',
    photo: 'image',
    pw: 'password',
    b64: 'base64',
  };

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const mark = (text: string, words: string[]) => {
    let out = esc(text);
    for (const w of words) {
      if (w.length < 2) continue;
      const re = new RegExp('(' + w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
      out = out.replace(re, '<mark>$1</mark>');
    }
    return out;
  };

  function score(item: Item, words: string[]): number {
    const name = item.n.toLowerCase();
    const rest = (item.d + ' ' + item.k + ' ' + item.c).toLowerCase();
    let total = 0;
    for (const w of words) {
      if (name.startsWith(w)) total += 30;
      else if (new RegExp('\\b' + w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).test(name)) total += 20;
      else if (name.includes(w)) total += 12;
      else if (rest.includes(w)) total += 5;
      else return 0; // every word must match somewhere
    }
    return total;
  }

  function search(q: string): Item[] {
    const raw = q.toLowerCase().trim();
    if (!raw) return [];
    const expanded = ALIASES[raw] || raw;
    const words = expanded.split(/\s+/).filter(Boolean);
    return data
      .map((item) => ({ item, s: score(item, words) }))
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s || a.item.n.localeCompare(b.item.n))
      .slice(0, 8)
      .map((x) => x.item);
  }

  function setActive(i: number) {
    if (!list || !input) return;
    const opts = list.querySelectorAll('[role="option"]');
    active = opts.length ? (i + opts.length) % opts.length : -1;
    opts.forEach((o, j) => o.setAttribute('aria-selected', String(j === active)));
    if (active >= 0) {
      input.setAttribute('aria-activedescendant', opts[active].id);
      opts[active].scrollIntoView({ block: 'nearest' });
    } else input.removeAttribute('aria-activedescendant');
  }

  function close() {
    list?.classList.add('hidden');
    input?.setAttribute('aria-expanded', 'false');
    input?.removeAttribute('aria-activedescendant');
    active = -1;
  }

  function render() {
    if (!list || !input) return;
    const q = input.value;
    shown = search(q);
    if (!q.trim()) {
      close();
      if (status) status.textContent = '';
      return;
    }
    const words = (ALIASES[q.toLowerCase().trim()] || q.toLowerCase()).split(/\s+/);
    list.innerHTML = shown.length
      ? shown
          .map(
            (it, i) =>
              `<li role="option" id="hs-opt-${i}" aria-selected="false"><a href="${it.u}" tabindex="-1"><span class="r-name">${mark(it.n, words)}</span><span class="r-cat">${esc(it.c.replace(' Tools', ''))}</span><span class="r-desc">${esc(it.d)}</span></a></li>`,
          )
          .join('')
      : `<li class="r-empty">No tool matches “${esc(q.trim())}”. Press Enter to search the blog and guides too.</li>`;
    list.classList.remove('hidden');
    input.setAttribute('aria-expanded', 'true');
    if (status)
      status.textContent = shown.length
        ? `${shown.length} tool${shown.length === 1 ? '' : 's'} found. Use the arrow keys to choose.`
        : 'No tools found.';
    setActive(shown.length ? 0 : -1);
  }

  input?.addEventListener('input', render);
  input?.addEventListener('focus', () => input.value.trim() && render());
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (list?.classList.contains('hidden')) render();
      else setActive(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(active - 1);
    } else if (e.key === 'Escape') {
      if (list && !list.classList.contains('hidden')) {
        e.preventDefault();
        close();
      } else input.value = '';
    }
  });
  // Enter opens the highlighted tool; with no match the form goes to /search/?q=…
  form?.addEventListener('submit', (e) => {
    const pick = active >= 0 ? shown[active] : null;
    if (pick) {
      e.preventDefault();
      location.href = pick.u;
    } else if (!input?.value.trim()) e.preventDefault();
  });
  document.addEventListener('click', (e) => {
    if (form && !form.contains(e.target as Node)) close();
  });
  // "/" jumps to the search box (unless you're typing somewhere)
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
    const t = e.target as HTMLElement;
    if (t.closest('input, textarea, select, [contenteditable="true"]')) return;
    e.preventDefault();
    input?.focus();
  });

  // ── Early access form (same /api/subscribe call as before) ──
  document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('newsletter-email') as HTMLInputElement).value;
    const msgEl = document.getElementById('newsletter-msg');
    if (!msgEl) return;
    const show = (text: string, ok: boolean) => {
      msgEl.textContent = text;
      msgEl.classList.remove('hidden', ok ? 'text-danger' : 'text-success');
      msgEl.classList.add(ok ? 'text-success' : 'text-danger');
    };
    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      if (res.ok && data.success) {
        show(data.message || 'Thanks! Check your inbox to confirm.', true);
        (document.getElementById('newsletter-form') as HTMLFormElement).reset();
      } else {
        show(data.error || 'Something went wrong. Please try again.', false);
      }
    } catch {
      show('Network error. Check your connection and try again.', false);
    }
  });

  // ── Recently used on this device (from the tools' own usage counter) ──
  try {
    const usage = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}') as Record<string, number>;
    const byUrl = new Map(data.map((d) => [d.u.replace(/^\/tools\/|\/$/g, ''), d]));
    const recent = Object.entries(usage)
      .sort((a, b) => b[1] - a[1])
      .map(([id]) => byUrl.get(id))
      .filter(Boolean)
      .slice(0, 8) as Item[];
    const sect = document.getElementById('recently-used-section');
    const grid = document.getElementById('recently-used-grid');
    if (recent.length && sect && grid) {
      grid.innerHTML = recent
        .map((t) => `<li><a href="${t.u}" class="home-pill">${esc(t.n)}</a></li>`)
        .join('');
      sect.classList.remove('hidden');
    }
  } catch {
    /* storage blocked: the section stays hidden */
  }

</script>
