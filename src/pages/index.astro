</style>

<script>
  type Item = { n: string; d: string; u: string; c: string; k: string };
  const data: Item[] = JSON.parse(document.getElementById('home-search-data')?.textContent || '[]');

  // ── Hero search: all tools, ranked by where the words match ──
  const form = document.getElementById('home-search-form') as HTMLFormElement | null;
  const input = document.getElementById('home-search') as HTMLInputElement | null;
  const list = document.getElementById('home-search-results') as HTMLUListElement | null;
  const status = document.getElementById('home-search-status');
  let active = -1;
  let shown: Item[] = [];

  // Short forms people type
  const ALIASES: Record<string, string> = {
    nrr: 'net run rate',
    dls: 'duckworth lewis',
    img: 'image',
    pic: 'image',
    photo: 'image',
    pw: 'password',
    b64: 'base64',
  };

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const mark = (text: string, words: string[]) => {
    let out = esc(text);
    for (const w of words) {
      if (w.length < 2) continue;
      const re = new RegExp('(' + w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
      out = out.replace(re, '<mark>$1</mark>');
    }
    return out;
  };

  function score(item: Item, words: string[]): number {
    const name = item.n.toLowerCase();
    const rest = (item.d + ' ' + item.k + ' ' + item.c).toLowerCase();
    let total = 0;
    for (const w of words) {
      if (name.startsWith(w)) total += 30;
      else if (new RegExp('\\b' + w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).test(name)) total += 20;
      else if (name.includes(w)) total += 12;
      else if (rest.includes(w)) total += 5;
      else return 0; // every word must match somewhere
    }
    return total;
  }

  function search(q: string): Item[] {
    const raw = q.toLowerCase().trim();
    if (!raw) return [];
    const expanded = ALIASES[raw] || raw;
    const words = expanded.split(/\s+/).filter(Boolean);
    return data
      .map((item) => ({ item, s: score(item, words) }))
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s || a.item.n.localeCompare(b.item.n))
      .slice(0, 8)
      .map((x) => x.item);
  }

  function setActive(i: number) {
    if (!list || !input) return;
    const opts = list.querySelectorAll('[role="option"]');
    active = opts.length ? (i + opts.length) % opts.length : -1;
    opts.forEach((o, j) => o.setAttribute('aria-selected', String(j === active)));
    if (active >= 0) {
      input.setAttribute('aria-activedescendant', opts[active].id);
      opts[active].scrollIntoView({ block: 'nearest' });
    } else input.removeAttribute('aria-activedescendant');
  }

  function close() {
    list?.classList.add('hidden');
    input?.setAttribute('aria-expanded', 'false');
    input?.removeAttribute('aria-activedescendant');
    active = -1;
  }

  function render() {
    if (!list || !input) return;
    const q = input.value;
    shown = search(q);
    if (!q.trim()) {
      close();
      if (status) status.textContent = '';
      return;
    }
    const words = (ALIASES[q.toLowerCase().trim()] || q.toLowerCase()).split(/\s+/);
    list.innerHTML = shown.length
      ? shown
          .map(
            (it, i) =>
              `<li role="option" id="hs-opt-${i}" aria-selected="false"><a href="${it.u}" tabindex="-1"><span class="r-name">${mark(it.n, words)}</span><span class="r-cat">${esc(it.c.replace(' Tools', ''))}</span><span class="r-desc">${esc(it.d)}</span></a></li>`,
          )
          .join('')
      : `<li class="r-empty">No tool matches “${esc(q.trim())}”. Press Enter to search the blog and guides too.</li>`;
    list.classList.remove('hidden');
    input.setAttribute('aria-expanded', 'true');
    if (status)
      status.textContent = shown.length
        ? `${shown.length} tool${shown.length === 1 ? '' : 's'} found. Use the arrow keys to choose.`
        : 'No tools found.';
    setActive(shown.length ? 0 : -1);
  }

  input?.addEventListener('input', render);
  input?.addEventListener('focus', () => input.value.trim() && render());
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (list?.classList.contains('hidden')) render();
      else setActive(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(active - 1);
    } else if (e.key === 'Escape') {
      if (list && !list.classList.contains('hidden')) {
        e.preventDefault();
        close();
      } else input.value = '';
    }
  });
  // Enter opens the highlighted tool; with no match the form goes to /search/?q=…
  form?.addEventListener('submit', (e) => {
    const pick = active >= 0 ? shown[active] : null;
    if (pick) {
      e.preventDefault();
      location.href = pick.u;
    } else if (!input?.value.trim()) e.preventDefault();
  });
  document.addEventListener('click', (e) => {
    if (form && !form.contains(e.target as Node)) close();
  });
  // "/" jumps to the search box (unless you're typing somewhere)
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
    const t = e.target as HTMLElement;
    if (t.closest('input, textarea, select, [contenteditable="true"]')) return;
    e.preventDefault();
    input?.focus();
  });

  // ── Early access form (same /api/subscribe call as before) ──
  document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('newsletter-email') as HTMLInputElement).value;
    const msgEl = document.getElementById('newsletter-msg');
    if (!msgEl) return;
    const show = (text: string, ok: boolean) => {
      msgEl.textContent = text;
      msgEl.classList.remove('hidden', ok ? 'text-danger' : 'text-success');
      msgEl.classList.add(ok ? 'text-success' : 'text-danger');
    };
    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      if (res.ok && data.success) {
        show(data.message || 'Thanks! Check your inbox to confirm.', true);
        (document.getElementById('newsletter-form') as HTMLFormElement).reset();
      } else {
        show(data.error || 'Something went wrong. Please try again.', false);
      }
    } catch {
      show('Network error. Check your connection and try again.', false);
    }
  });

  // ── Recently used on this device (from the tools' own usage counter) ──
  try {
    const usage = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}') as Record<string, number>;
    const byUrl = new Map(data.map((d) => [d.u.replace(/^\/tools\/|\/$/g, ''), d]));
    const recent = Object.entries(usage)
      .sort((a, b) => b[1] - a[1])
      .map(([id]) => byUrl.get(id))
      .filter(Boolean)
      .slice(0, 8) as Item[];
    const sect = document.getElementById('recently-used-section');
    const grid = document.getElementById('recently-used-grid');
    if (recent.length && sect && grid) {
      grid.innerHTML = recent
        .map((t) => `<li><a href="${t.u}" class="home-pill">${esc(t.n)}</a></li>`)
        .join('');
      sect.classList.remove('hidden');
    }
  } catch {
    /* storage blocked: the section stays hidden */
  }

</script>
