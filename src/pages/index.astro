---
// Homepage (DESIGN.md §4.2, UI plan Phase 7): search first, categories, how it works,
// latest posts, support bar, early-access form.
import MainLayout from '../layouts/MainLayout.astro';
import MonetizationSlot from '../components/MonetizationSlot.astro';
import ToolIcon from '../components/icons/ToolIcon.astro';
import { highlight } from '../lib/codeHighlight';
import { tools, categories, type Tool, type ToolCategory } from '../data/tools';

const toolCount = tools.length;
const categoryCount = categories.filter((c) => c.count > 0).length;

// Shown under the search box: the tools people come for most
const POPULAR: [id: string, label: string][] = [
  ['image-compressor', 'Image Compressor'],
  ['qr-generator', 'QR Generator'],
  ['word-counter', 'Word Counter'],
  ['net-run-rate-calculator', 'Net Run Rate'],
  ['json-formatter', 'JSON Formatter'],
  ['pdf-merger', 'PDF Merger'],
];
const popular = POPULAR.map(([id, label]) => ({ label, url: tools.find((t) => t.id === id)?.url })).filter(
  (p) => p.url,
);

// Category cards: image and developer first (most searched), then the rest
const CATEGORY_ORDER: ToolCategory[] = [
  'image-tools',
  'developer-tools',
  'cricket-tools',
  'utility-tools',
  'creator-tools',
  'ai-tools',
];
// Each category has its own hue (icon tile and top edge only; text stays neutral)
const STYLE: Record<ToolCategory, { short: string; icon: string; hue: number }> = {
  'image-tools': { short: 'image', icon: 'image', hue: 200 },
  'developer-tools': { short: 'developer', icon: 'json', hue: 255 },
  'cricket-tools': { short: 'cricket', icon: 'cricket', hue: 145 },
  'utility-tools': { short: 'utility', icon: 'utility', hue: 75 },
  'creator-tools': { short: 'creator', icon: 'creator', hue: 25 },
  'ai-tools': { short: 'text & AI', icon: 'bolt', hue: 305 },
};
// The four tools each card leads with (most-used first)
const TOP: Record<ToolCategory, string[]> = {
  'image-tools': ['image-compressor', 'image-resizer', 'jpg-to-png', 'ai-background-remover'],
  'developer-tools': ['json-formatter', 'uuid-generator', 'base64-tool', 'regex-tester'],
  'cricket-tools': ['net-run-rate-calculator', 'run-rate-calculator', 'cricket-dls-calculator', 'cricket-target-calculator'],
  'utility-tools': ['word-counter', 'password-generator', 'pdf-merger', 'age-calculator'],
  'creator-tools': ['qr-generator', 'hashtag-generator', 'youtube-title-generator', 'markdown-editor'],
  'ai-tools': ['ai-chat', 'ai-text-summarizer', 'ai-grammar-checker', 'prompt-generator'],
};
const categoryCards = CATEGORY_ORDER.map((id) => {
  const info = categories.find((c) => c.id === id)!;
  const list = tools.filter((t) => t.category === id);
  const top = TOP[id].map((tid) => list.find((t) => t.id === tid)).filter(Boolean) as Tool[];
  return { id, title: info.title, count: list.length, top, ...STYLE[id] };
});

// Search index for the hero box (all tools, small fields only)
const searchIndex = tools.map((t) => ({
  n: t.name,
  d: t.description,
  u: t.url,
  c: categories.find((c) => c.id === t.category)?.title || '',
  k: t.keywords.join(' '),
}));

// Sample results beside the hero (what three tools give you)
const sampleJson = highlight('{\n  "tool": "JSON Formatter",\n  "valid": true,\n  "keys": 3\n}', 'json');
const urlOf = (id: string) => tools.find((t) => t.id === id)?.url || '/tools/';

const blogPostModules = import.meta.glob('./blog/*.md', { eager: true });
const blogPosts = Object.entries(blogPostModules)
  .map(([path, mod]) => {
    const fm = (mod as any).frontmatter || {};
    const slug = path.replace('./blog/', '').replace('.md', '');
    return {
      title: fm.title || slug,
      desc: fm.description || '',
      url: `/blog/${slug}/`,
      time: fm.readingTime || '',
      date: String(fm.date || ''),
      cat: String(fm.category || 'Guide').replace(/ Tools$/, ''),
    };
  })
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

const steps = [
  {
    icon: 'globe',
    title: 'Open a tool',
    desc: 'No account, no install. Every tool works on a phone or a laptop.',
  },
  {
    icon: 'lock',
    title: 'Your files stay on your device',
    desc: 'Images, PDFs and text are processed by your browser. Nothing is uploaded to a server.',
  },
  {
    icon: 'bolt',
    title: 'Download or copy the result',
    desc: 'No watermark and no sign-up wall. Close the tab and nothing is kept.',
  },
];

const title = `${toolCount} Free Online Tools — Images, QR, PDF & Text | NumanX`;
const description =
  'Free online tools that run in your browser: compress and convert images, make QR codes, merge PDFs, count words, format JSON and work out cricket run rates.';
---

<MainLayout
  {title}
  {description}
  keywords="free online tools, image compressor, image converter, qr code generator, pdf merger, word counter, json formatter, cricket run rate calculator, browser based tools"
>
  <main id="main-content" class="home relative">
    <!-- ── Hero: search is the main action ── -->
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-wrap home-hero-grid">
        <div class="min-w-0">
          <p class="home-label home-label-accent">
            <span class="home-dot" aria-hidden="true"></span>Free · No sign-up · Runs in your browser
          </p>
          <h1 id="home-title" class="home-h1">
            <span class="num home-h1-num">{toolCount}</span> free tools that run in your browser
          </h1>
          <p class="mt-4 max-w-[58ch] text-soft text-base sm:text-lg leading-relaxed">
            Compress images, make QR codes, merge PDFs, format JSON or work out a cricket run rate. Nothing is uploaded
            and there's nothing to install.
          </p>

          <form id="home-search-form" class="home-search mt-8" role="search" action="/search/" method="get">
            <label for="home-search" class="sr-only">Search {toolCount} tools</label>
            <svg
              class="home-search-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
              ><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg
            >
            <input
              id="home-search"
              name="q"
              type="search"
              role="combobox"
              aria-expanded="false"
              aria-controls="home-search-results"
              aria-autocomplete="list"
              autocomplete="off"
              spellcheck="false"
              enterkeyhint="search"
              placeholder='Try "compress", "NRR" or "json"'
            />
            <kbd class="home-search-kbd" aria-hidden="true">/</kbd>
            <ul id="home-search-results" class="home-results hidden" role="listbox" aria-label="Matching tools"></ul>
          </form>
          <p id="home-search-status" class="sr-only" role="status" aria-live="polite"></p>

          <div class="mt-5 flex flex-wrap items-center gap-2">
            <span class="home-label !mb-0 mr-1">Popular</span>
            {
              popular.map((t) => (
                <a href={t.url} class="home-pill">
                  {t.label}
                </a>
              ))
            }
          </div>
        </div>

        <!-- Sample results: what three of the tools give you -->
        <div class="home-samples" aria-label="Example results">
          <a href={urlOf('image-compressor')} class="home-sample" style="--cat: 200">
            <span class="home-sample-head"><span>Image Compressor</span><span class="num">example</span></span>
            <span class="home-sample-file num">holiday-photo.jpg</span>
            <span class="home-sample-sizes num">4.8 MB <span class="text-faint">→</span> <strong>1.1 MB</strong></span>
            <span class="home-bar" aria-hidden="true"><span style="width: 23%"></span></span>
          </a>
          <a href={urlOf('json-formatter')} class="home-sample" style="--cat: 255">
            <span class="home-sample-head"><span>JSON Formatter</span><span class="num">valid</span></span>
            <pre class="home-sample-code"><code set:html={sampleJson} /></pre>
          </a>
          <a href={urlOf('cricket-target-calculator')} class="home-sample" style="--cat: 145">
            <span class="home-sample-head"><span>Cricket Target</span><span class="num">T20</span></span>
            <span class="home-sample-row num"><span>Need</span><strong>181 off 120</strong></span>
            <span class="home-sample-row num"><span>Required rate</span><strong class="home-sample-big">9.05</strong></span>
          </a>
        </div>
      </div>

      <!-- Facts strip (counts come from the tool registry) -->
      <div class="home-wrap">
        <dl class="home-facts">
          <div><dt>Tools</dt><dd class="num">{toolCount}</dd></div>
          <div><dt>Categories</dt><dd class="num">{categoryCount}</dd></div>
          <div><dt>Files uploaded</dt><dd class="num">0</dd></div>
          <div><dt>Sign-up</dt><dd>None</dd></div>
        </dl>
      </div>
    </section>

    <!-- ── Categories ── -->
    <section class="home-wrap pt-14 pb-14" aria-labelledby="home-cats">
      <div class="flex items-end justify-between gap-4 mb-5">
        <div>
          <p class="home-label">Browse</p>
          <h2 id="home-cats" class="home-h2">Tools by category</h2>
        </div>
        <a href="/tools/" class="home-more">All {toolCount} tools →</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          categoryCards.map((cat) => (
            <section class="home-cat" style={`--cat: ${cat.hue}`} aria-labelledby={`cat-${cat.id}`}>
              <div class="home-cat-top">
                <span class="home-cat-icon" aria-hidden="true">
                  <ToolIcon name={cat.icon} class="w-5 h-5" />
                </span>
                <h3 id={`cat-${cat.id}`} class="home-cat-title">
                  <a href={`/category/${cat.id}/`}>{cat.title}</a>
                </h3>
                <span class="home-cat-count num">{cat.count}</span>
              </div>
              <ul class="home-cat-list">
                {cat.top.map((t) => (
                  <li>
                    <a href={t.url} class="home-tool">
                      <span class="min-w-0">
                        <span class="home-tool-name">{t.name}</span>
                        <span class="home-tool-desc">{t.description}</span>
                      </span>
                      <span class="home-tool-arrow" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <a href={`/category/${cat.id}/`} class="home-cat-all">
                All {cat.count} {cat.short} tools →
              </a>
            </section>
          ))
        }
      </div>
    </section>

    <!-- ── Recently used (only when this browser has used tools) ── -->
    <section id="recently-used-section" class="home-wrap pb-14 hidden" aria-labelledby="home-recent">
      <h2 id="home-recent" class="home-h2 mb-4">Used recently on this device</h2>
      <ul id="recently-used-grid" class="flex flex-wrap gap-2"></ul>
    </section>

    <!-- ── How it works ── -->
    <section class="home-band" aria-labelledby="home-how">
      <div class="home-wrap py-14">
        <p class="home-label">Private by design</p>
        <h2 id="home-how" class="home-h2 mb-6">How it works</h2>
        <ol class="grid gap-4 md:grid-cols-3">
          {
            steps.map((s, i) => (
              <li class="home-step">
                <span class="home-step-no num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="home-step-icon" aria-hidden="true">
                  <ToolIcon name={s.icon} class="w-5 h-5" />
                </span>
                <h3 class="text-base font-semibold text-fg mt-4">{s.title}</h3>
                <p class="text-sm text-soft mt-1.5 leading-relaxed">{s.desc}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ── Latest posts ── -->
    {
      blogPosts.length > 0 && (
        <section class="home-wrap pt-14 pb-10" aria-labelledby="home-blog">
          <div class="flex items-end justify-between gap-4 mb-5">
            <div>
              <p class="home-label">Guides</p>
              <h2 id="home-blog" class="home-h2">From the blog</h2>
            </div>
            <a href="/blog/" class="home-more">
              All posts →
            </a>
          </div>
          <ul class="grid gap-4 md:grid-cols-3">
            {blogPosts.map((p) => (
              <li>
                <a href={p.url} class="home-post">
                  <span class="home-post-meta num">
                    <span class="home-post-cat">{p.cat}</span>
                    {p.time && <span>{p.time}</span>}
                  </span>
                  <span class="home-post-title">{p.title}</span>
                  <span class="home-post-desc">{p.desc}</span>
                  <span class="home-post-read">Read →</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- ── Support bar (below the categories, DESIGN.md §4.2) ── -->
    <div class="home-wrap">
      <MonetizationSlot slotType="pakistan-support-bar" />
    </div>

    <!-- ── Early access (ids and /api/subscribe call unchanged) ── -->
    <section class="home-wrap pt-4 pb-24" aria-labelledby="home-news">
      <div class="home-news">
        <div>
          <p class="home-label home-label-accent">Newsletter</p>
          <h2 id="home-news" class="home-h2">Get new tools by email</h2>
          <p class="text-sm text-soft mt-1.5 max-w-[52ch]">
            A short email when new tools or guides go live, at most a couple a month. You confirm by email first and
            can unsubscribe from any message.
          </p>
        </div>
        <form id="newsletter-form" class="flex flex-col sm:flex-row gap-2 w-full md:max-w-md">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input
            id="newsletter-email"
            type="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
            class="w-full sm:flex-1 min-w-0 h-11 px-4 rounded-lg bg-well border border-line-strong text-fg placeholder:text-faint focus:outline-none focus:border-amber-500/60"
          />
          <button
            type="submit"
            class="h-11 px-5 rounded-lg bg-accent text-accent-fg font-semibold hover:bg-amber-400 active:scale-[0.98] transition shrink-0"
            >Subscribe</button
          >
        </form>
        <p id="newsletter-msg" class="text-sm hidden md:col-span-2" role="status"></p>
      </div>
    </section>
  </main>
</MainLayout>

<script is:inline type="application/json" id="home-search-data" set:html={JSON.stringify(searchIndex).replace(/</g, String.raw`\u003c`)} />

<style is:global>
  .home-wrap {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 16px;
  }
  @media (min-width: 768px) {
    .home-wrap {
      padding-inline: 32px;
    }
  }
  .home-label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .home-label-accent {
    color: var(--accent);
  }
  .home-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px oklch(0.74 0.15 150 / 0.2);
  }
  .home-h1 {
    max-width: 16ch;
    font-size: var(--step-4);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--text);
    text-wrap: balance;
  }
  .home-h1-num {
    color: var(--accent);
  }
  .home-h2 {
    font-size: var(--step-2);
    font-weight: 750;
    letter-spacing: -0.015em;
    color: var(--text);
  }
  .num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  /* ── Hero band: warm surface, technical dot grid fading out, soft amber light at the top ── */
  .home-hero {
    position: relative;
    isolation: isolate;
    padding-top: 40px;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(70% 60% at 15% 0%, oklch(0.8 0.15 75 / 0.13), transparent 70%),
      linear-gradient(to bottom, oklch(0.19 0.016 75), var(--bg));
  }
  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(oklch(0.95 0.02 75 / 0.13) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(90% 80% at 30% 20%, #000 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(90% 80% at 30% 20%, #000 30%, transparent 85%);
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .home-hero {
      padding-top: 64px;
    }
  }
  .home-hero-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .home-hero-grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: 56px;
    }
  }

  /* Search box */
  .home-search {
    position: relative;
    max-width: 640px;
  }
  .home-search input {
    width: 100%;
    height: 58px;
    padding: 0 52px 0 50px;
    border-radius: 14px;
    background: var(--well);
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-size: 1.0625rem;
    box-shadow:
      0 0 0 4px oklch(0.8 0.15 75 / 0.06),
      0 12px 32px -12px rgb(0 0 0 / 0.6);
    transition:
      border-color 150ms,
      box-shadow 150ms;
  }
  @media (max-width: 767px) {
    .home-search input {
      padding-right: 16px;
    }
  }
  .home-search input::placeholder {
    color: var(--text-faint);
  }
  .home-search input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow:
      0 0 0 4px oklch(0.8 0.15 75 / 0.18),
      0 12px 32px -12px rgb(0 0 0 / 0.6);
  }
  .home-search input::-webkit-search-cancel-button {
    display: none;
  }
  .home-search-icon {
    position: absolute;
    left: 18px;
    top: 29px;
    width: 20px;
    height: 20px;
    transform: translateY(-50%);
    color: var(--accent);
    pointer-events: none;
  }
  .home-search-kbd {
    position: absolute;
    right: 16px;
    top: 29px;
    transform: translateY(-50%);
    min-width: 24px;
    height: 24px;
    display: none;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
    pointer-events: none;
  }
  @media (hover: hover) and (min-width: 768px) {
    .home-search-kbd {
      display: inline-flex;
    }
  }
  .home-results {
    position: absolute;
    z-index: 30;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    max-height: min(60vh, 420px);
    overflow-y: auto;
    padding: 6px;
    border-radius: 14px;
    background: var(--panel-2);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-lg);
  }
  .home-results a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 12px;
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--text);
  }
  .home-results [aria-selected='true'] a,
  .home-results a:hover {
    background: oklch(0.8 0.15 75 / 0.12);
  }
  .home-results .r-name {
    font-weight: 600;
  }
  .home-results .r-cat {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-faint);
    align-self: center;
  }
  .home-results .r-desc {
    grid-column: 1 / -1;
    font-size: 0.8125rem;
    color: var(--text-soft);
  }
  .home-results .r-empty {
    padding: 12px;
    font-size: 0.875rem;
    color: var(--text-soft);
  }
  .home-results mark {
    background: none;
    color: var(--accent);
  }

  .home-pill {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: oklch(0.98 0.01 75 / 0.03);
    font-size: 0.875rem;
    color: var(--text-soft);
    transition:
      color 150ms,
      border-color 150ms,
      background-color 150ms;
  }
  .home-pill:hover {
    color: var(--text);
    border-color: oklch(0.8 0.15 75 / 0.5);
    background: oklch(0.8 0.15 75 / 0.1);
  }
  .home-more {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  .home-more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Sample result cards beside the hero */
  .home-samples {
    display: grid;
    gap: 12px;
  }
  @media (max-width: 1023px) {
    .home-samples {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }
  /* Phones: one sample is enough, so the categories come sooner */
  @media (max-width: 639px) {
    .home-sample:nth-child(n + 2) {
      display: none;
    }
  }
  .home-sample {
    --cat: 75;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 16px;
    border-radius: 14px;
    background: oklch(0.21 0.015 75 / 0.92);
    border: 1px solid var(--line);
    border-left: 3px solid oklch(0.75 0.12 var(--cat));
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.8);
    transition:
      border-color 150ms,
      transform 150ms;
  }
  @media (min-width: 1024px) {
    .home-sample:nth-child(2) {
      margin-left: 28px;
    }
  }
  .home-sample:hover {
    border-color: oklch(0.75 0.12 var(--cat) / 0.6);
    border-left-color: oklch(0.75 0.12 var(--cat));
  }
  @media (prefers-reduced-motion: no-preference) {
    .home-sample:hover {
      transform: translateY(-2px);
    }
  }
  .home-sample-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
  }
