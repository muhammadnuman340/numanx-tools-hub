---
import MainLayout from '../layouts/MainLayout.astro';
import Accordion from '../components/ui/Accordion.astro';

const faqItems = [
  {
    title: 'What is NumanX Studio?',
    content:
      'NumanX Studio is a digital innovation company founded by Muhammad Numan Usmani. We build NumanX Tools (free online utilities), NumanX Creator Hub (community platform), MatchPulse Cricket Analytics, Cricket Glory Game Universe, NumanX AI Platform, and the Future Operating Brain System.',
  },
  {
    title: 'What is the NumanX tagline?',
    content:
      'Our official tagline is "Build. Create. Analyze." — reflecting our mission to provide tools for creators, students, and businesses to build projects, create content, and analyze data.',
  },
  {
    title: 'Is NumanX really free?',
    content:
      'Yes, completely free. No watermarks, no file limits, no daily caps, and no sign-up required. All tools run entirely in your browser — nothing is uploaded to any server.',
  },
  {
    title: 'What tools are coming next?',
    content:
      'The roadmap includes NumanX Creator Hub (Phase 2), MatchPulse Cricket Analytics (Phase 3), NumanX AI Platform (Phase 4), and the NumanX Operating Brain (Phase 5).',
  },
];
---

<MainLayout
  title="About NumanX Studio | Building Tools, AI & Cricket Analytics"
  description="Learn about NumanX Studio, founded by Muhammad Numan Usmani, building creator tools, AI platforms, cricket analytics systems, and digital products."
  keywords="numanx studio, numanx tools, muhammad numan usmani, free online tools, creator tools, cricket analytics, pakistan tech startup, made in pakistan software"
  canonical="https://toolshub.numanxstudio.com/about/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about/' },
  ]}
  faq={faqItems}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-5xl mx-auto">
      <!-- Hero -->
      <section class="text-center mb-16 pt-8 animate-[fadeInUp_0.6s_ease-out] group-section">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-surface bg-surface-1 backdrop-blur-sm text-tertiary text-xs font-semibold tracking-wider uppercase mb-8 audio-trigger"
        >
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
          </span>
          NumanX Studio
        </div>
        <h1 class="text-6xl sm:text-8xl font-black tracking-tighter leading-none reveal-text">
          Build. Create.
          <span
            class="block mt-2 bg-gradient-to-r from-purple-300 via-purple-400 to-blue-400 bg-clip-text text-transparent drop-shadow-[0_2px_12px_rgba(168,85,247,0.15)]"
          >
            Analyze.
          </span>
        </h1>
        <p class="mt-6 text-tertiary text-lg md:text-xl max-w-3xl mx-auto leading-[1.75] reveal-text">
          NumanX Studio is a digital innovation company building powerful tools, AI platforms, cricket analytics, and
          creator ecosystems for the next generation.
        </p>
        <div class="mt-8 flex items-center justify-center gap-4 reveal">
          <a
            href="/tools/"
            class="group inline-flex items-center gap-2 bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm px-6 py-3 rounded-xl transition-all duration-200 hover:-translate-y-0.5 hover:scale-[1.02] active:scale-[0.97] shadow-lg shadow-purple-900/30 audio-trigger"
          >
            Explore Tools
            <svg
              class="w-4 h-4 transition-transform group-hover:translate-x-0.5"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              ><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg
            >
          </a>
          <a
            href="/blog/"
            class="group inline-flex items-center gap-2 border border-surface-2 hover:border-purple-500/40 text-secondary hover:text-white font-semibold text-sm px-6 py-3 rounded-xl bg-surface-1 backdrop-blur-sm transition-all duration-200 hover:-translate-y-0.5 hover:scale-[1.02] active:scale-[0.97] audio-trigger"
          >
            Read Blog
            <svg
              class="w-4 h-4 transition-transform group-hover:translate-x-0.5"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline
                points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg
            >
          </a>
        </div>
      </section>

      <!-- Bento Layout Container -->
      <div id="cards-container-about" class="grid grid-cols-1 md:grid-cols-6 gap-6 group-section mb-24">
        <!-- Founder Profile Card (col-span-4, row-span-2) -->
        <div
          class="col-span-1 md:col-span-4 md:row-span-2 card-spotlight bg-surface-1/80 border border-surface rounded-3xl p-6 md:p-10 shadow-2xl relative overflow-hidden flex flex-col justify-between group audio-trigger hover:bg-amber-500/5 transition-all"
        >
          <div
            class="absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-purple-500/50 to-transparent"
          >
          </div>
          <div class="relative flex flex-col md:flex-row items-center gap-8">
            <div
              class="w-32 h-32 md:w-44 md:h-44 rounded-2xl bg-gradient-to-br from-purple-600/20 to-blue-600/20 flex items-center justify-center shrink-0 border border-surface group-hover:scale-105 transition-all duration-300"
            >
              <span class="text-5xl md:text-7xl font-black text-purple-400">NU</span>
            </div>
            <div class="text-center md:text-left">
              <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider font-mono"
                >Founder &amp; Creator</span
              >
              <h2 class="text-3xl md:text-4xl font-black text-white mt-2">Muhammad Numan Usmani</h2>
              <p class="text-tertiary mt-2 max-w-xl leading-relaxed text-sm">
                IT Student, Creator, and System Architect building the NumanX ecosystem — a unified platform of tools,
                analytics, AI, and operating intelligence for creators and businesses worldwide.
              </p>
              <p class="text-muted text-xs mt-3 leading-relaxed">
                <span class="text-purple-400 font-semibold">NumanX Studio</span> is the parent organization behind NumanX
                Tools, NumanX Creator Hub, MatchPulse Cricket Analytics, Cricket Glory Game Universe, NumanX AI Platform,
                and the Future Operating Brain System.
              </p>
              <div class="flex flex-wrap justify-center md:justify-start gap-2.5 mt-5">
                <span class="px-3 py-1.5 rounded-lg bg-surface-2 border border-surface text-xs font-mono text-secondary"
                  >IT Student</span
                >
                <span class="px-3 py-1.5 rounded-lg bg-surface-2 border border-surface text-xs font-mono text-secondary"
                  >Creator</span
                >
                <span class="px-3 py-1.5 rounded-lg bg-surface-2 border border-surface text-xs font-mono text-secondary"
                  >System Architect</span
                >
                <span class="px-3 py-1.5 rounded-lg bg-emerald-950/60 border border-emerald-500/30 text-xs font-mono text-emerald-400 font-medium"
                  >Client-Side Architecture</span
                >
              </div>
              <div class="mt-4 flex items-center justify-center md:justify-start gap-3">
                <a
                  href="https://github.com/muhammadnuman340/numanx-tools-hub"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-zinc-800/80 hover:bg-zinc-700/80 border border-zinc-700/60 text-xs font-medium text-white transition-colors"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                  <span>github.com/muhammadnuman340/numanx-tools-hub</span>
                </a>
              </div>
            </div>
          </div>
          <div class="relative mt-8 pt-6 border-t border-surface">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div class="text-center">
                <div class="text-xl font-black text-purple-400">2024</div>
                <div class="text-[10px] text-muted mt-1 uppercase font-mono">Studio Founded</div>
              </div>
              <div class="text-center">
                <div class="text-xl font-black text-purple-400">2025</div>
                <div class="text-[10px] text-muted mt-1 uppercase font-mono">Tools Launched</div>
              </div>
              <div class="text-center">
                <div class="text-xl font-black text-purple-400">2026</div>
                <div class="text-[10px] text-muted mt-1 uppercase font-mono">Creator Hub</div>
              </div>
              <div class="text-center">
                <div class="text-xl font-black text-purple-400">2027+</div>
                <div class="text-[10px] text-muted mt-1 uppercase font-mono">AI Ecosystem</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Ecosystem Product Roadmap Timeline (col-span-2, row-span-2) -->
        <div
          class="col-span-1 md:col-span-2 md:row-span-2 card-spotlight bg-surface-1/80 border border-surface rounded-3xl p-6 md:p-8 shadow-2xl relative overflow-hidden flex flex-col audio-trigger transition-all"
        >
          <div
            class="absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-purple-500/50 to-transparent"
          >
          </div>
          <div class="mb-6">
            <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider font-mono"
              >NumanX Ecosystem</span
            >
            <h2 class="text-xl font-black text-white mt-1">Ecosystem Roadmap</h2>
          </div>

          <!-- Vertical Glowing Pulse Timeline -->
          <div class="space-y-6 relative border-l border-white/10 ml-3 pl-5 py-2">
            <div class="flex items-start gap-4 relative">
              <div class="absolute -left-[27px] top-1">
                <div
                  class="w-3.5 h-3.5 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.8)] animate-pulse flex items-center justify-center"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                </div>
              </div>
              <div>
                <h3 class="text-[10px] font-semibold text-emerald-400 font-mono uppercase">Phase 1 — Live</h3>
                <h4 class="text-sm font-semibold text-white">NumanX Tools</h4>
                <p class="text-[11px] text-tertiary mt-0.5 leading-relaxed">
                  Free online utilities for image, text, cricket calculations.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-4 relative">
              <div class="absolute -left-[27px] top-1">
                <div
                  class="w-3.5 h-3.5 rounded-full bg-purple-500 shadow-[0_0_10px_rgba(168,85,247,0.8)] animate-pulse flex items-center justify-center"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                </div>
              </div>
              <div>
                <h3 class="text-[10px] font-semibold text-purple-400 font-mono uppercase">Phase 2 — Next</h3>
                <h4 class="text-sm font-semibold text-white">Creator Hub</h4>
                <p class="text-[11px] text-tertiary mt-0.5 leading-relaxed">
                  Community templates & tools repository platform.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-4 relative">
              <div class="absolute -left-[27px] top-1">
                <div
                  class="w-3.5 h-3.5 rounded-full bg-zinc-800 flex items-center justify-center border border-zinc-700"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-zinc-600"></span>
                </div>
              </div>
              <div>
                <h3 class="text-[10px] font-semibold text-zinc-500 font-mono uppercase">Phase 3</h3>
                <h4 class="text-sm font-semibold text-primary">Cricket Analytics</h4>
                <p class="text-[11px] text-muted mt-0.5 leading-relaxed">MatchPulse performances & trends tracker.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 relative">
              <div class="absolute -left-[27px] top-1">
                <div
                  class="w-3.5 h-3.5 rounded-full bg-zinc-800 flex items-center justify-center border border-zinc-700"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-zinc-600"></span>
                </div>
              </div>
              <div>
                <h3 class="text-[10px] font-semibold text-zinc-500 font-mono uppercase">Phase 4</h3>
                <h4 class="text-sm font-semibold text-primary">AI Platform</h4>
                <p class="text-[11px] text-muted mt-0.5 leading-relaxed">
                  Direct content & graphics smart generation tools.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Vision Cards (3 separate columns spanning 2 width units each) -->
        <div
          class="col-span-1 md:col-span-2 card-spotlight bg-surface-1/80 border border-surface rounded-2xl p-6 flex flex-col justify-between group audio-trigger hover:bg-purple-500/5 transition-all"
        >
          <div
            class="w-10 h-10 rounded-xl bg-purple-600/10 flex items-center justify-center text-purple-400 mb-4 group-hover:scale-110 transition-transform"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg
            >
          </div>
          <div>
            <h3 class="text-base font-semibold text-primary group-hover:text-white transition-colors">
              Free Tools for All
            </h3>
            <p class="text-xs text-muted mt-2 leading-relaxed group-hover:text-secondary transition-colors">
              Useful browser-based tools that anyone can use without cost, accounts, or data leaving their device.
            </p>
          </div>
        </div>

        <div
          class="col-span-1 md:col-span-2 card-spotlight bg-surface-1/80 border border-surface rounded-2xl p-6 flex flex-col justify-between group audio-trigger hover:bg-purple-500/5 transition-all"
        >
          <div
            class="w-10 h-10 rounded-xl bg-purple-600/10 flex items-center justify-center text-purple-400 mb-4 group-hover:scale-110 transition-transform"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path
                d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
            >
          </div>
          <div>
            <h3 class="text-base font-semibold text-primary group-hover:text-white transition-colors">
              Empowering Creators
            </h3>
            <p class="text-xs text-muted mt-2 leading-relaxed group-hover:text-secondary transition-colors">
              Giving content creators, students, and developers the tools they need to work faster without
              subscriptions.
            </p>
          </div>
        </div>

        <div
          class="col-span-1 md:col-span-2 card-spotlight bg-surface-1/80 border border-surface rounded-2xl p-6 flex flex-col justify-between group audio-trigger hover:bg-purple-500/5 transition-all"
        >
          <div
            class="w-10 h-10 rounded-xl bg-purple-600/10 flex items-center justify-center text-purple-400 mb-4 group-hover:scale-110 transition-transform"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg
            >
          </div>
          <div>
            <h3 class="text-base font-semibold text-primary group-hover:text-white transition-colors">
              Cricket Analytics
            </h3>
            <p class="text-xs text-muted mt-2 leading-relaxed group-hover:text-secondary transition-colors">
              Specialised cricket analytics tools for fans, players, and analysts to measure performance like a pro.
            </p>
          </div>
        </div>
      </div>

      <!-- Stats / Growth Metrics -->
      <section class="mb-24 animate-[fadeInUp_0.6s_ease-out_0.45s_both]">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div
            class="rounded-xl border border-surface bg-surface-1 p-6 text-center hover:border-purple-500/30 hover:-translate-y-0.5 transition-all duration-300 audio-trigger"
          >
            <div
              class="text-3xl md:text-4xl font-black bg-gradient-to-r from-purple-300 to-blue-400 bg-clip-text text-transparent"
            >
              <span class="stat-counter" data-target="70">0</span>
            </div>
            <p class="text-sm text-tertiary mt-1">Tools Built</p>
          </div>
          <div
            class="rounded-xl border border-surface bg-surface-1 p-6 text-center hover:border-purple-500/30 hover:-translate-y-0.5 transition-all duration-300 audio-trigger"
          >
            <div
              class="text-3xl md:text-4xl font-black bg-gradient-to-r from-purple-300 to-blue-400 bg-clip-text text-transparent"
            >
              <span class="stat-counter" data-target="6">0</span>
            </div>
            <p class="text-sm text-tertiary mt-1">Core Categories</p>
          </div>
          <div
            class="rounded-xl border border-surface bg-surface-1 p-6 text-center hover:border-purple-500/30 hover:-translate-y-0.5 transition-all duration-300 audio-trigger"
          >
            <div
              class="text-3xl md:text-4xl font-black bg-gradient-to-r from-purple-300 to-blue-400 bg-clip-text text-transparent"
            >
              <span class="stat-counter" data-target="6">0</span>
            </div>
            <p class="text-sm text-tertiary mt-1">Ecosystem Products</p>
          </div>
          <div
            class="rounded-xl border border-surface bg-surface-1 p-6 text-center hover:border-purple-500/30 hover:-translate-y-0.5 transition-all duration-300 audio-trigger"
          >
            <div
              class="text-3xl md:text-4xl font-black bg-gradient-to-r from-purple-300 to-blue-400 bg-clip-text text-transparent"
            >
              <span class="stat-counter" data-target="100">0</span><span
                class="bg-gradient-to-r from-purple-300 to-blue-400 bg-clip-text text-transparent">K+</span
              >
            </div>
            <p class="text-sm text-tertiary mt-1">Growth Goal</p>
          </div>
        </div>
      </section>

      <!-- Values Grid -->
      <section class="mb-24 text-center animate-[fadeInUp_0.6s_ease-out_0.75s_both]">
        <div class="text-center max-w-3xl mx-auto mb-10">
          <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">What We Stand For</span>
          <h2 class="text-3xl md:text-4xl font-black tracking-tight text-white mt-1">
            Built by
            <span class="bg-gradient-to-r from-purple-300 to-blue-400 bg-clip-text text-transparent">NumanX Studio</span
            >
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
          <div
            class="rounded-xl border border-surface bg-surface-1 p-5 hover:border-purple-500/30 hover:bg-surface-2 transition-all duration-300 group audio-trigger"
          >
            <div
              class="w-10 h-10 rounded-xl bg-purple-600/10 flex items-center justify-center text-purple-400 mx-auto mb-3 group-hover:scale-110 transition-transform duration-200"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line
                  x1="12"
                  y1="8"
                  x2="12.01"
                  y2="8"></line></svg
              >
            </div>
            <h3 class="text-sm font-semibold text-primary group-hover:text-white transition-colors">Simplicity</h3>
            <p class="text-xs text-muted mt-1 leading-relaxed">Clean, intuitive tools that just work.</p>
          </div>
          <div
            class="rounded-xl border border-surface bg-surface-1 p-5 hover:border-purple-500/30 hover:bg-surface-2 transition-all duration-300 group audio-trigger"
          >
            <div
              class="w-10 h-10 rounded-xl bg-purple-600/10 flex items-center justify-center text-purple-400 mx-auto mb-3 group-hover:scale-110 transition-transform duration-200"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg
              >
            </div>
            <h3 class="text-sm font-semibold text-primary group-hover:text-white transition-colors">Innovation</h3>
            <p class="text-xs text-muted mt-1 leading-relaxed">Modern solutions for modern problems.</p>
          </div>
          <div
            class="rounded-xl border border-surface bg-surface-1 p-5 hover:border-purple-500/30 hover:bg-surface-2 transition-all duration-300 group audio-trigger"
          >
            <div
              class="w-10 h-10 rounded-xl bg-purple-600/10 flex items-center justify-center text-purple-400 mx-auto mb-3 group-hover:scale-110 transition-transform duration-200"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"
                ></path></svg
              >
