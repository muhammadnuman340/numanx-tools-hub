---
import MainLayout from '../../layouts/MainLayout.astro';
import PostCard from '../../components/ui/PostCard.astro';
import AdUnit from '../../components/AdUnit.astro';

const guideModules = import.meta.glob('./*.md', { eager: true });
const guides = Object.entries(guideModules)
  .map(([path, mod]) => ({
    ...mod,
    slug: path.replace('./', '').replace('.md', ''),
  }))
  .sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));
---

<MainLayout
  title="Guides - NumanX Tools | Step-by-Step Tutorials"
  description="Step-by-step guides from NumanX Tools: optimise images for the web, keep your passwords and accounts safe, and install the tools as an app that works offline."
  keywords="guides, tutorials, how-to, image optimization, password security, cricket guides, seo guides, web performance"
  canonical="https://toolshub.numanxstudio.com/guides/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Guides', url: '/guides/' },
  ]}
>
  <main class="min-h-screen pt-8 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-6xl mx-auto">
      <div class="mb-10 pt-6">
        <p class="text-xs font-mono uppercase tracking-wider text-zinc-400 mb-3">{guides.length} guides</p>
        <h1 class="text-[length:var(--step-3)] font-bold tracking-[-0.02em] leading-tight text-primary">Guides</h1>
        <p class="mt-3 text-secondary text-lg max-w-[68ch] leading-relaxed">
          Longer, step-by-step walkthroughs. Each one explains a topic from the start and points to the free tool
          that does the job, such as the image compressor or password generator. For shorter tips and news, see the
          <a href="/blog/" class="text-amber-400 hover:text-amber-300 underline underline-offset-2">blog</a>.
        </p>
      </div>

      <div class="max-w-4xl mx-auto px-4 mb-8">
        <AdUnit format="horizontal" />
      </div>

      <div id="guides-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          guides.map((guide) => (
            <PostCard
              url={'/guides/' + guide.slug + '/'}
              title={guide.frontmatter.title}
              desc={guide.frontmatter.summary || guide.frontmatter.description}
              tag={guide.frontmatter.category || 'Guide'}
              meta={guide.frontmatter.readingTime || '5 min read'}
              headingLevel="h2"
            />
          ))
        }
      </div>

      <div class="max-w-4xl mx-auto my-8">
        <AdUnit format="horizontal" />
      </div>

      <div class="mt-16 bg-surface-1 border border-surface p-8 md:p-10 rounded-xl">
        <h2 class="text-2xl font-bold tracking-tight text-white">Need help with a specific tool?</h2>
        <p class="text-secondary mt-3 max-w-[60ch] text-sm">
          Every tool page has its own how-to and FAQ. You can also <a href="/contact/" class="text-amber-400 hover:text-amber-300 underline underline-offset-2">send a question</a>.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/tools/"
            class="px-6 py-3 rounded-xl bg-amber-600 hover:bg-amber-700 text-accent-fg font-semibold text-sm active:scale-[0.97] transition-all duration-200"
          >
            Browse Tools
          </a>
          <a
            href="/blog/"
            class="px-6 py-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-semibold text-sm active:scale-[0.97] transition-all duration-200 border border-zinc-700"
          >
            Read Blog
          </a>
          <a
            href="/comparisons/"
            class="px-6 py-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-semibold text-sm active:scale-[0.97] transition-all duration-200 border border-zinc-700"
          >
            Format Comparisons
          </a>
        </div>
      </div>
    </div>
  </main>
</MainLayout>
