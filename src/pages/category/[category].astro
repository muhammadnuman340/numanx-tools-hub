---
// FILE: src/pages/category/[category].astro
import MainLayout from '../../layouts/MainLayout.astro';
import ToolCard from '../../components/ui/ToolCard.astro';
import { categories, getToolsByCategory } from '../../data/tools';
import type { ToolCategory } from '../../data/tools';
import CategoryHero from '../../components/CategoryHero.astro';
import ToolIcon from '../../components/icons/ToolIcon.astro';
import MonetizationSlot from '../../components/MonetizationSlot.astro';

export async function getStaticPaths() {
  return categories.map((cat) => ({
    params: { category: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const categoryTools = getToolsByCategory(category.id as ToolCategory);

const categoryGuides: Record<string, { title: string; paragraphs: string[]; highlights: string[] }> = {
  'image-tools': {
    title: 'Client-Side Canvas & WebAssembly Image Processing Guide',
    paragraphs: [
      'Image optimization on NumanX Tools operates exclusively within your local browser sandbox via HTML5 Canvas, OffscreenCanvas Web Workers, and WebAssembly decoders. Unlike legacy cloud image processors that upload your private photos, creative assets, and client documents to remote cloud storage, our tools perform pixel transformations, bilinear resampling, and quantization directly on your device GPU and CPU threads.',
      'Formats such as WebP, adjustable JPEG quality and PNG metadata stripping cut file size while keeping images sharp; each tool shows the before and after size so you can judge the result. Because files stay in the browser as local blobs, there is no upload step to wait for.'
    ],
    highlights: ['100% Client-Side Privacy (0 Server Uploads)', 'Hardware-Accelerated OffscreenCanvas Workers', 'High-DPI 4K Resizing & WebP Conversion', 'Batch Compression of up to 20 Images']
  },
  'creator-tools': {
    title: 'High-Velocity Creator Workflows & Barcode Architecture',
    paragraphs: [
      'Content creators, digital publishers, and packaging engineers require ultra-fast, high-precision tools that seamlessly integrate with modern media workflows. Our creator suite combines barcode generation, including industrial ISO/IEC 23941 Rectangular Micro QR (rMQR) strips designed for narrow physical surfaces, with real-time markdown documentation compilers and viral hashtag metadata analyzers.',
      'Whether you are building YouTube Shorts and TikTok discovery tags, encoding compact product labels, or authoring technical guides with KaTeX equations and Mermaid diagrams, every tool has keyboard shortcuts, clipboard integration, and zero subscription barriers.'
    ],
    highlights: ['ISO/IEC 23941 rMQR Slender Barcode Engine', 'TikTok FYP & YouTube Shorts Tag Extractors', 'Client-Side Markdown to Vector PDF', 'Live Interactive Canvas Previews']
  },
  'utility-tools': {
    title: 'SI Measurement Standards & Cryptographic Entropy Guide',
    paragraphs: [
      'Precision utilities require rigorous adherence to international standards and robust mathematical algorithms. Our utility suite features high-precision unit conversions mapped directly against Bureau International des Poids et Mesures (BIPM) SI base factors, accurate age and date intervals accounting for leap centuries, and percentage increase/decrease financial calculators.',
      'For security utilities, our password and passphrase engines employ the Web Cryptography API (crypto.getRandomValues) and the Electronic Frontier Foundation (EFF) 7,776-word Diceware lexicon to generate mathematically unpredictable passwords with over 64 bits of true entropy, guaranteeing resilience against offline dictionary and rainbow table attacks.'
    ],
    highlights: ['BIPM Standard SI Conversion Factors', 'EFF 7,776-Word Diceware CSPRNG Passphrases', 'Calendar-Accurate Leap Year & Birthday Math', 'Zero-Tracking Local Storage Persistence']
  },
  'cricket-tools': {
    title: 'ICC Net Run Rate (Clause 16.10.2) & DLS Analytics Guide',
    paragraphs: [
      'Cricket tournament analytics demand mathematical accuracy that standard sports apps frequently omit. Our cricket suite is built in accordance with standard International Cricket Council (ICC) tournament conditions, specifically following ICC Clause 16.10.2: if a batting team is dismissed all out before completing their allotted overs, their run rate is calculated based on the maximum quota of overs (e.g., 20.0 or 50.0) rather than the fraction overs when the final wicket fell.',
      'Featuring real-time Playoff Chase Solvers (determining the exact overs threshold or run margin required to leapfrog a tournament rival on Net Run Rate) and Duckworth-Lewis-Stern (DLS) Standard Edition rain par score estimates, this suite powers fans, analysts, and viral shorts creators with standard cricket statistical precision.'
    ],
    highlights: ['ICC Clause 16.10.2 All-Out Quota Enforcement', 'Live Playoff Qualification Scenario Solvers', 'Duckworth-Lewis-Stern (DLS) Par Curves', '1080×1920 Mobile Shorts Stat Card Exporters']
  },
  'ai-tools': {
    title: 'Rule-Based Text Analysis, Readability & Prompt Tools',
    paragraphs: [
      'Modern text and content analysis should be fast, accurate, and completely private. These tools use deterministic, rule-based algorithms (n-gram keyword extraction, Flesch-Kincaid Grade Level, Gunning Fog index, and SMOG readability scoring) instead of an AI model, so the same text always gives the same result.',
      'By executing entirely client-side inside your browser sandbox, every summary, keyword extraction and sentiment check runs without server dependencies or cloud data transmission.'
    ],
    highlights: ['Flesch-Kincaid, Gunning Fog & Readability Metrics', 'Client-Side In-Browser Execution', 'N-Gram & Frequency Extraction Algorithms', 'Zero Telemetry & 100% Confidential Copy']
  },
  'developer-tools': {
    title: 'Zero-Upload Security Architecture for Developers',
    paragraphs: [
      'Pasting production JSON payloads, database connection strings, JWT authorization tokens, or proprietary SQL queries into public cloud utilities represents a critical security and compliance hazard. NumanX Developer Tools eliminates this risk entirely through a zero-upload client-side architecture.',
      'All formatting, AST parsing, regex evaluation, Base64 encoding/decoding, and cryptographic hashing (SHA-256, SHA-512, HMAC) execute inside an isolated browser sandbox. Your authentication keys, customer records and schemas never leave your machine, so no third party receives them.'
    ],
    highlights: ['100% Offline Zero-Upload JWT Debugger', 'Web Crypto API (SHA-256, SHA-512, HMAC)', 'AST-Based JSON, SQL & Code Formatters', 'RFC 3986 URI & UTF-8 Safe Binary Inspection']
  }
};

const guide = categoryGuides[category.id];
const heroCategory = category.id === 'ai-tools' 
  ? { ...category, title: 'Text & AI Tools' }
  : category;
---

<MainLayout
  title={
    category.id === 'ai-tools'
      ? 'Free Text Tools — Summarizer, Grammar & Readability | NumanX'
      : `Free ${heroCategory.title} & Online Utilities | NumanX Tools`
  }
  description={heroCategory.description}
  keywords={`${heroCategory.title.toLowerCase()}, online tools, free ${heroCategory.title.toLowerCase()} tools, numanx tools`}
  noindex={categoryTools.length === 0}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: heroCategory.title, url: `/category/${category.id}/` },
  ]}
>
  <main class="min-h-screen pt-8 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <CategoryHero category={heroCategory} />

      {
        categoryTools.length > 0 ? (
          <>
          <h2 class="sr-only">All {category.title} tools</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
            {categoryTools.map((tool) => (
              <ToolCard tool={tool} badge />
            ))}
          </div>
          </>
        ) : (
          <div class="text-center py-20 bg-zinc-900/30 border border-zinc-800 p-8 rounded-2xl max-w-2xl mx-auto mb-16">
            <h2 class="text-2xl font-bold text-white">This category is launching soon</h2>
            <p class="text-sm text-tertiary mt-3 mb-8">
              We are actively building these tools. Drop your email to get early access and be notified the moment they launch.
            </p>
            <form class="flex max-w-md mx-auto gap-3">
              <input
                type="email"
                aria-label="Email address for launch updates"
                placeholder="your@email.com"
                class="flex-1 bg-surface py-3 px-4 rounded-xl border border-surface-2 focus:border-amber-500 outline-none text-white text-sm"
                required
              />
              <button
                type="submit"
                class="bg-amber-600 hover:bg-amber-500 text-accent-fg px-6 py-3 rounded-xl font-medium text-sm transition-colors"
              >
                Notify Me
              </button>
            </form>
          </div>
        )
      }

      {/* Authoritative Category Guide & E-E-A-T Architecture Panel */}
      {guide && (
        <section class="max-w-4xl mx-auto mb-16 rounded-2xl bg-slate-900/60 border border-slate-800/80 p-6 sm:p-8">
          <div class="flex items-center gap-2 mb-4 text-xs font-mono text-amber-400 font-bold uppercase tracking-wider">
            <span>Engineering Architecture &amp; Methodology</span>
          </div>
          <h2 class="text-2xl font-bold text-white mb-4">{guide.title}</h2>
          <div class="space-y-4 text-sm text-slate-300 leading-relaxed">
            {guide.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-slate-800/80 grid grid-cols-1 sm:grid-cols-2 gap-3">
            {guide.highlights.map((h) => (
              <div class="flex items-center gap-2 text-xs font-medium text-emerald-400">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>{h}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* Contextual Zero-CLS Monetization Slot Below Content */}
      <div class="max-w-4xl mx-auto mb-12 space-y-4">
        <MonetizationSlot
          slotType="post-tool-affiliate"
          category={category.id.replace('-tools', '')}
        />
        <MonetizationSlot slotType="pakistan-support-bar" />
      </div>

      <div class="mt-8 text-center">
        <a
          href="/tools/"
          class="inline-flex items-center min-h-6 gap-2 text-sm text-muted hover:text-amber-400 transition-colors font-medium"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          ><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Browse All Tools
        </a>
      </div>
    </div>
  </main>
</MainLayout>
