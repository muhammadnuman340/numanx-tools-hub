---
import MainLayout from '../../layouts/MainLayout.astro';
import { categories, getToolsByCategory, getCategoryInfo } from '../../data/tools';
import type { ToolCategory } from '../../data/tools';
import CategoryHero from '../../components/CategoryHero.astro';
import ToolIcon from '../../components/icons/ToolIcon.astro';
import AdUnit from '../../components/AdUnit.astro';

export async function getStaticPaths() {
  return categories.map((cat) => ({
    params: { category: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const categoryTools = getToolsByCategory(category.id as ToolCategory);
---

<MainLayout
  title={`${category.title} - NumanX Tools`}
  description={category.description}
  keywords={`${category.title.toLowerCase()}, online tools, free ${category.title.toLowerCase()} tools, numanx tools`}
  noindex={categoryTools.length === 0}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: category.title, url: `/category/${category.id}/` },
  ]}
>
  <main class="min-h-screen pt-8 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <CategoryHero category={category} />

      {
        categoryTools.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {categoryTools.map((tool) => {
              const initials = tool.name
                .split(' ')
                .map((w) => w[0])
                .join('')
                .slice(0, 2);
              return (
                <div class="bg-zinc-900/30 border border-zinc-800/80 p-5 rounded-2xl flex flex-col justify-between hover:border-purple-500/40 hover:bg-zinc-900/50 transition-all group">
                  <div>
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-10 h-10 rounded-xl bg-purple-600/10 flex items-center justify-center text-purple-400 group-hover:scale-105 transition-transform">
                        <ToolIcon name={tool.icon} />
                      </div>
                      <h3 class="text-base font-semibold text-primary group-hover:text-purple-300 transition-colors">
                        {tool.name}
                      </h3>
                    </div>
                    <p class="text-xs text-tertiary leading-relaxed">{tool.description}</p>
                  </div>
                  <a
                    href={tool.url}
                    class="mt-5 w-full bg-surface-2 hover:bg-purple-600 text-secondary hover:text-white text-xs font-medium py-2.5 rounded-xl border border-surface hover:border-purple-500 text-center transition-all"
                  >
                    Open Tool
                  </a>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="text-center py-20 bg-zinc-900/30 border border-zinc-800 p-8 rounded-2xl max-w-2xl mx-auto">
            <h2 class="text-2xl font-bold text-white">This category is launching soon</h2>
            <p class="text-sm text-tertiary mt-3 mb-8">
              We are actively building these tools. Drop your email to get early access and be notified the moment they
              launch.
            </p>
            <form class="flex max-w-md mx-auto gap-3">
              <input
                type="email"
                placeholder="your@email.com"
                class="flex-1 bg-surface py-3 px-4 rounded-xl border border-surface-2 focus:border-purple-500 outline-none text-white text-sm"
                required
              />
              <button
                type="submit"
                class="bg-purple-600 hover:bg-purple-500 text-white px-6 py-3 rounded-xl font-medium text-sm transition-colors"
              >
                Notify Me
              </button>
            </form>
          </div>
        )
      }

      {categoryTools.length > 0 && <AdUnit format="horizontal" class="mt-8" />}

      <div class="mt-12 text-center">
        <a
          href="/tools/"
          class="inline-flex items-center gap-2 text-sm text-muted hover:text-purple-400 transition-colors font-medium"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            ><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg
          >
          Browse All Tools
        </a>
      </div>
    </div>
  </main>
</MainLayout>
