---
// FILE: src/pages/category/[category].astro
import MainLayout from '../../layouts/MainLayout.astro';
import ToolCard from '../../components/ui/ToolCard.astro';
import { categories, getToolsByCategory } from '../../data/tools';
import type { ToolCategory } from '../../data/tools';
import CategoryHero from '../../components/CategoryHero.astro';
import ToolIcon from '../../components/icons/ToolIcon.astro';
import MonetizationSlot from '../../components/MonetizationSlot.astro';

export async function getStaticPaths() {
  return categories.map((cat) => ({
    params: { category: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const categoryTools = getToolsByCategory(category.id as ToolCategory);

// `meta` is the search snippet (140–160 characters). The short registry description stays for cards.
const categoryGuides: Record<string, { meta: string; title: string; paragraphs: string[]; highlights: string[] }> = {
  'image-tools': {
    meta: 'Free image tools that run in your browser: compress, resize, crop and convert JPG, PNG, WebP and SVG, remove backgrounds or upscale. No uploads, no sign-up.',
    title: 'How the image tools work',
    paragraphs: [
      'Every image tool works on your device. The browser decodes the file, changes it with the Canvas API (and Web Workers where it helps) and gives you a new file to download. Nothing is uploaded.',
      'The compressor and converters show the size before and after, so you can judge the result yourself. The first time you use them, the background remover downloads an AI model of about 5–15 MB and the upscaler one of about 900 KB; after that, they also run on your device.'
    ],
    highlights: ['Files stay on your device', 'Before and after file sizes', 'Compress up to 20 images at once', 'Background remover and upscaler use real AI models']
  },
  'creator-tools': {
    meta: 'Free creator tools: QR and rMQR codes, hashtags, YouTube titles, Instagram line breaks, UTM links, Markdown to PDF and countdowns. Runs in your browser.',
    title: 'What the creator tools are for',
    paragraphs: [
      'These tools cover the small jobs around a post or video: a QR code for a poster, hashtags and a title for a Short, clean line breaks for an Instagram caption, or a tracked UTM link for a campaign.',
      'The QR tool also makes rectangular micro QR (rMQR, ISO/IEC 23941) codes for narrow labels, with SVG export. The Markdown editor and Markdown to PDF converter run in the browser, so drafts stay on your device.'
    ],
    highlights: ['Square QR and rMQR codes with SVG export', 'Hashtag and YouTube title ideas', 'Markdown editor and Markdown to PDF', 'No account or subscription']
  },
  'utility-tools': {
    meta: 'Free everyday tools: word and character counter, age, BMI and percentage calculators, unit converter, password generator, and PDF merge, split and convert.',
    title: 'What the utility tools cover',
    paragraphs: [
      'Counters, calculators and converters for everyday tasks: word and character counts, age and working days, percentages, BMI and unit conversions. The PDF merger, splitter and PDF to image converter work on the file in your browser.',
      'The password generator uses the browser\'s cryptographic random number generator (crypto.getRandomValues), so passwords are not predictable and are never sent anywhere.'
    ],
    highlights: ['Cryptographic random passwords', 'PDF merge, split and convert in the browser', 'Leap years handled in date maths', 'Nothing to install']
  },
  'cricket-tools': {
    meta: 'Free cricket calculators: run rate, net run rate (NRR), DLS target, strike rate, economy, overs and batting average. NRR follows the ICC all-out rule.',
    title: 'How the cricket calculators count',
    paragraphs: [
      'The net run rate calculator follows ICC playing condition 16.10.2: if a team is bowled out before its overs are used up, its run rate is worked out over the full quota (for example 20 or 50 overs), not the overs it actually faced.',
      'The NRR calculator also works out how fast a team must chase, or by how much it must win, to pass a rival on net run rate. The DLS calculator uses the public Standard Edition model, not the official ICC software, so treat its targets as estimates.'
    ],
    highlights: ['ICC 16.10.2 all-out rule in NRR', 'Chase target to pass a rival on NRR', 'DLS estimates (Standard Edition)', 'Strike rate, economy and averages']
  },
  'ai-tools': {
    meta: 'Free text tools: summarize, check grammar and readability, find keywords, detect language and analyse sentiment. Rule-based, private, and run in your browser.',
    title: 'How the text tools work',
    paragraphs: [
      'These tools use fixed rules, not an AI model: word-frequency scoring for summaries and keywords, word lists for sentiment, and standard formulas such as Flesch-Kincaid and Gunning Fog for readability. The same text always gives the same result.',
      'Your text is processed in the browser and is not sent to a server.'
    ],
    highlights: ['Rule-based, same result every time', 'Flesch-Kincaid and Gunning Fog scores', 'Keyword and frequency extraction', 'Text stays in your browser']
  },
  'developer-tools': {
    meta: 'Free developer tools: JSON, SQL, HTML and CSS formatters, JWT and Base64 decoders, regex tester, diff checker, hashes, cron and epoch converters. No uploads.',
    title: 'Why the developer tools run locally',
    paragraphs: [
      'Pasting a production JSON payload, a JWT or a SQL query into an online tool can leak it. These tools format, decode, test and hash in your browser, so the data is not sent to a server.',
      'Hashes use the browser\'s Web Crypto API. The JWT decoder only reads the token; it does not verify signatures against your keys.'
    ],
    highlights: ['Data stays in your browser', 'SHA-256 and other hashes via Web Crypto', 'JSON, SQL, HTML and CSS formatters', 'Regex tester and diff checker']
  }
};

const guide = categoryGuides[category.id];
const heroCategory = category.id === 'ai-tools' 
  ? { ...category, title: 'Text & AI Tools' }
  : category;
---

<MainLayout
  title={
    category.id === 'ai-tools'
      ? 'Free Text Tools — Summarizer, Grammar & Readability | NumanX'
      : `Free ${heroCategory.title} & Online Utilities | NumanX Tools`
  }
  description={guide?.meta || heroCategory.description}
  keywords={`${heroCategory.title.toLowerCase()}, online tools, free ${heroCategory.title.toLowerCase()} tools, numanx tools`}
  noindex={categoryTools.length === 0}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: heroCategory.title, url: `/category/${category.id}/` },
  ]}
>
  <main class="min-h-screen pt-8 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <CategoryHero category={heroCategory} />

      {
        categoryTools.length > 0 ? (
          <>
          <h2 class="sr-only">All {category.title} tools</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
            {categoryTools.map((tool) => (
              <ToolCard tool={tool} badge />
            ))}
          </div>
          </>
        ) : (
          <div class="text-center py-20 bg-zinc-900/30 border border-zinc-800 p-8 rounded-2xl max-w-2xl mx-auto mb-16">
            <h2 class="text-2xl font-bold text-white">This category is launching soon</h2>
            <p class="text-sm text-tertiary mt-3 mb-8">
              We are actively building these tools. Drop your email to get early access and be notified the moment they launch.
            </p>
            <form class="flex max-w-md mx-auto gap-3">
              <input
                type="email"
                aria-label="Email address for launch updates"
                placeholder="your@email.com"
                class="flex-1 bg-surface py-3 px-4 rounded-xl border border-surface-2 focus:border-amber-500 outline-none text-white text-sm"
                required
              />
              <button
                type="submit"
                class="bg-amber-600 hover:bg-amber-500 text-accent-fg px-6 py-3 rounded-xl font-medium text-sm transition-colors"
              >
                Notify Me
              </button>
            </form>
          </div>
        )
      }

      {guide && (
        <section class="max-w-[68ch] mb-16 border-t border-surface pt-8">
          <h2 class="text-xl font-bold text-white mb-4">{guide.title}</h2>
          <div class="space-y-4 text-base text-secondary leading-relaxed">
            {guide.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2">
            {guide.highlights.map((h) => (
              <li class="flex items-start gap-2 text-sm text-secondary">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0" aria-hidden="true"></span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="max-w-4xl mb-12 space-y-4">
        <MonetizationSlot
          slotType="post-tool-affiliate"
          category={category.id.replace('-tools', '')}
        />
        <MonetizationSlot slotType="pakistan-support-bar" />
      </div>

      <div class="mt-8 text-center">
        <a
          href="/tools/"
          class="inline-flex items-center min-h-6 gap-2 text-sm text-muted hover:text-amber-400 transition-colors font-medium"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          ><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Browse All Tools
        </a>
      </div>
    </div>
  </main>
</MainLayout>
