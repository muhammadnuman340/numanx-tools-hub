---
import MainLayout from '../layouts/MainLayout.astro';
import { tools } from '../data/tools';
---

<MainLayout
  title="Your Saved Favorite Utilities & Tools | NumanX Tools"
  description="Quickly access your saved and bookmarked tools with local storage privacy on NumanX Tools."
  keywords="favorites, saved tools, numanx tools"
  noindex={true}
>
  <main class="min-h-screen pt-8 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12 pt-8">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-zinc-700/50 bg-zinc-900/80 text-tertiary text-xs font-semibold tracking-wider uppercase mb-6"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-amber-400"
            ><polygon
              points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
            ></polygon></svg
          >
          Your Collection
        </div>
        <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-none">
          Favorite
          <span class="block mt-2 text-amber-400">
            Tools
          </span>
        </h1>
        <p class="mt-4 text-tertiary text-lg max-w-xl mx-auto leading-relaxed">
          Your saved tools for quick access. Star any tool to add it here.
        </p>
      </div>

      <div id="favorites-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
        {/* Rendered by JS */}
      </div>

      <div id="empty-favorites" class="hidden text-center py-20">
        <div class="w-16 h-16 rounded-2xl bg-zinc-800/60 flex items-center justify-center mx-auto mb-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-dim"
            ><polygon
              points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
            ></polygon></svg
          >
        </div>
        <h2 class="text-xl font-bold text-secondary">No favorites yet</h2>
        <p class="text-sm text-muted mt-2">Click the star icon on any tool to save it here.</p>
        <a
          href="/tools/"
          class="inline-flex items-center gap-2 mt-6 px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-accent-fg text-sm font-semibold transition-all duration-200"
        >
          Browse Tools
        </a>
      </div>
    </div>
  </main>
</MainLayout>

<script>
  import { getIconSvg } from '../lib/iconSvgs';
  import { toolCardHtml } from '../lib/cardHtml';
  const allTools = [
    {
      id: 'qr-generator',
      name: 'QR Generator',
      desc: 'Generate QR codes from URLs, text, and messages instantly.',
      icon: 'qr',
      url: '/tools/qr-generator/',
      cat: 'Creator Tools',
    },
    {
      id: 'word-counter',
      name: 'Word Counter',
      desc: 'Count words, characters, sentences, and paragraphs in your text.',
      icon: 'word',
      url: '/tools/word-counter/',
      cat: 'Utility Tools',
    },
    {
      id: 'age-calculator',
      name: 'Age Calculator',
      desc: 'Calculate exact age in years, months, days, hours, and minutes.',
      icon: 'age',
      url: '/tools/age-calculator/',
      cat: 'Utility Tools',
    },
    {
      id: 'password-generator',
      name: 'Password Generator',
      desc: 'Generate strong, secure passwords with custom length and options.',
      icon: 'password',
      url: '/tools/password-generator/',
      cat: 'Utility Tools',
    },
    {
      id: 'hashtag-generator',
      name: 'Hashtag Generator',
      desc: 'Generate trending hashtags for social media posts.',
      icon: 'hashtag',
      url: '/tools/hashtag-generator/',
      cat: 'Creator Tools',
    },
    {
      id: 'run-rate-calculator',
      name: 'Run Rate Calculator',
      desc: 'Calculate cricket run rates and required run rates for matches.',
      icon: 'runrate',
      url: '/tools/run-rate-calculator/',
      cat: 'Cricket Tools',
    },
    {
      id: 'strike-rate-calculator',
      name: 'Strike Rate Calculator',
      desc: 'Calculate batting and bowling strike rates in cricket.',
      icon: 'strikerate',
      url: '/tools/strike-rate-calculator/',
      cat: 'Cricket Tools',
    },
    {
      id: 'jpg-to-png',
      name: 'JPG to PNG',
      desc: 'Convert JPG images to PNG format with high quality preservation.',
      icon: 'jpg2png',
      url: '/tools/jpg-to-png/',
      cat: 'Image Tools',
    },
    {
      id: 'image-compressor',
      name: 'Image Compressor',
      desc: 'Compress images with visual quality presets and batch processing.',
      icon: 'compress',
      url: '/tools/image-compressor/',
      cat: 'Image Tools',
    },
    {
      id: 'png-to-webp',
      name: 'PNG to WebP',
      desc: 'Convert PNG images to WebP format for smaller file sizes.',
      icon: 'webp',
      url: '/tools/png-to-webp/',
      cat: 'Image Tools',
    },
    {
      id: 'image-resizer',
      name: 'Image Resizer',
      desc: 'Resize images to any dimension with aspect ratio lock and presets.',
      icon: 'resize',
      url: '/tools/image-resizer/',
      cat: 'Image Tools',
    },
    {
      id: 'unit-converter',
      name: 'Unit Converter',
      desc: 'Convert length, mass, volume, temperature, area, speed, time, and data units.',
      icon: 'unit',
      url: '/tools/unit-converter/',
      cat: 'Utility Tools',
    },
    {
      id: 'markdown-editor',
      name: 'Markdown Editor',
      desc: 'Write and preview markdown in real-time with toolbar and HTML export.',
      icon: 'markdown',
      url: '/tools/markdown-editor/',
      cat: 'Creator Tools',
    },
    {
      id: 'json-formatter',
      name: 'JSON Formatter',
      desc: 'Format, validate, and minify JSON data with syntax highlighting.',
      icon: 'json',
      url: '/tools/json-formatter/',
      cat: 'Utility Tools',
    },
  ];

  const grid = document.getElementById('favorites-grid');
  const empty = document.getElementById('empty-favorites');

  function renderFavorites() {
    if (!grid || !empty) return;
    try {
      const favSlugs: string[] = JSON.parse(localStorage.getItem('nt_favorites') || '[]');
      const favTools = allTools.filter((t) => favSlugs.includes(t.id));

      if (favTools.length === 0) {
        grid.innerHTML = '';
        empty.classList.remove('hidden');
        return;
      }

      empty.classList.add('hidden');
      grid.innerHTML = favTools
        .map(
          (tool) =>
            toolCardHtml({ url: tool.url, name: tool.name, desc: tool.desc, cat: tool.cat, iconSvg: getIconSvg(tool.icon) }),
        )
        .join('');
    } catch {
      empty.classList.remove('hidden');
    }
  }

  renderFavorites();

  window.addEventListener('storage', (e) => {
    if (e.key === 'nt_favorites') renderFavorites();
  });
</script>
