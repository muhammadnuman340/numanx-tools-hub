---
import MainLayout from '../layouts/MainLayout.astro';
import Accordion from '../components/ui/Accordion.astro';

const faqItems = [
  {
    title: 'How quickly do you respond to inquiries?',
    content:
      'We typically respond within 24 hours during business days. For urgent matters, please include "URGENT" in your subject line.',
  },
  {
    title: 'Can I suggest a new tool idea?',
    content:
      'Absolutely! We love hearing new ideas. Use the contact form with subject "Tool Suggestion" and describe your idea in detail. If selected, we\'ll give you credit on the tool page.',
  },
  {
    title: 'Do you accept guest posts or partnerships?',
    content:
      "Yes! We're open to guest contributions and partnership opportunities. Reach out via our contact form with relevant details and we'll review your proposal.",
  },
];
---

<MainLayout
  title="Contact NumanX Studio — Get in Touch"
  description="Have questions, suggestions, or feedback? Reach out to NumanX Studio. We respond within 24 hours."
  keywords="contact numanx studio, numanx support, feedback, report issue, tool suggestion, numanxstudio@gmail.com"
  canonical="https://numanx-tools.pages.dev/contact/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div
      class="absolute top-[15%] left-[10%] w-[300px] h-[300px] rounded-full bg-purple-600/10 blur-[100px] pointer-events-none -z-10"
    >
    </div>
    <div
      class="absolute bottom-[20%] right-[10%] w-[350px] h-[350px] rounded-full bg-blue-600/10 blur-[100px] pointer-events-none -z-10"
    >
    </div>
    <div class="max-w-5xl mx-auto">
      <!-- Hero -->
      <section class="text-center mb-16 pt-8">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-surface bg-surface-1 backdrop-blur-sm text-tertiary text-xs font-semibold tracking-wider uppercase mb-8"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-purple-400"
            ><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline
              points="22,6 12,13 2,6"></polyline></svg
          >
          Get in Touch
        </div>
        <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-none">
          We&rsquo;d Love to Hear
          <span
            class="block mt-2 bg-gradient-to-r from-purple-400 via-purple-500 to-blue-500 bg-clip-text text-transparent"
            >From You</span
          >
        </h1>
        <p class="mt-6 text-tertiary text-lg max-w-2xl mx-auto leading-relaxed">
          Have a question, suggestion, or want to report an issue? Send us a message and we&rsquo;ll get back to you
          within 24 hours.
        </p>
      </section>

      <!-- Contact Grid (Bento Layout) -->
      <div id="cards-container-contact" class="grid grid-cols-1 lg:grid-cols-5 gap-8 mb-16 group-section">
        <!-- Contact Form (col-span-3) -->
        <div
          class="lg:col-span-3 card-spotlight bg-surface-1/80 border border-surface p-6 md:p-8 rounded-3xl shadow-xl relative overflow-hidden flex flex-col justify-between hover:bg-amber-500/5 transition-all audio-trigger"
        >
          <div
            class="absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-purple-500/50 to-transparent"
          >
          </div>
          <div>
            <h2 class="text-xl font-bold text-white mb-6 font-mono tracking-tight flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-purple-500 animate-pulse"></span>
              Neural Interface Form
            </h2>
            <form id="contact-form" class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="name" class="block text-xs font-semibold text-tertiary mb-1.5 font-mono">Full Name</label>
                  <input
                    id="name"
                    type="text"
                    placeholder="John Doe"
                    required
                    class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/10 hover:border-amber-500/30 focus:border-amber-500/50 focus:outline-none transition-all text-white placeholder-zinc-500 text-sm shadow-inner audio-trigger"
                  />
                </div>
                <div>
                  <label for="email" class="block text-xs font-semibold text-tertiary mb-1.5 font-mono"
                    >Email Address</label
                  >
                  <input
                    id="email"
                    type="email"
                    placeholder="john@example.com"
                    required
                    class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/10 hover:border-amber-500/30 focus:border-amber-500/50 focus:outline-none transition-all text-white placeholder-zinc-500 text-sm shadow-inner audio-trigger"
                  />
                </div>
              </div>
              <div>
                <label for="subject" class="block text-xs font-semibold text-tertiary mb-1.5 font-mono">Subject</label>
                <select
                  id="subject"
                  class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/10 hover:border-amber-500/30 focus:border-amber-500/50 focus:outline-none transition-all text-secondary text-sm shadow-inner audio-trigger"
                >
                  <option value="" class="bg-[#0a0a0b] text-white">Select a topic</option>
                  <option value="feedback" class="bg-[#0a0a0b] text-white">Feedback</option>
                  <option value="bug" class="bg-[#0a0a0b] text-white">Bug Report</option>
                  <option value="suggestion" class="bg-[#0a0a0b] text-white">Tool Suggestion</option>
                  <option value="partnership" class="bg-[#0a0a0b] text-white">Partnership</option>
                  <option value="other" class="bg-[#0a0a0b] text-white">Other</option>
                </select>
              </div>
              <div>
                <label for="message" class="block text-xs font-semibold text-tertiary mb-1.5 font-mono">Message</label>
                <textarea
                  id="message"
                  rows="5"
                  placeholder="Write your message here..."
                  required
                  class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/10 hover:border-amber-500/30 focus:border-amber-500/50 focus:outline-none transition-all text-white placeholder-zinc-500 text-sm shadow-inner resize-none audio-trigger"
                ></textarea>
              </div>
              <button
                type="submit"
                id="contact-submit"
                class="w-full bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm px-6 py-3.5 rounded-xl transition-all duration-200 shadow-lg shadow-purple-900/30 hover:shadow-purple-500/20 hover:scale-[1.01] active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed audio-trigger flex items-center justify-center gap-2 relative overflow-hidden"
              >
                <span id="submit-text" class="flex items-center gap-2">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="group-hover:translate-x-0.5 transition-transform"
