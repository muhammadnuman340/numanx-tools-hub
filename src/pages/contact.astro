---
import MainLayout from "../layouts/MainLayout.astro";
import Accordion from "../components/ui/Accordion.astro";
import AdUnit from "../components/AdUnit.astro";

const faqItems = [
  { title: "How quickly do you respond to inquiries?", content: "We typically respond within 24 hours during business days. For urgent matters, please include \"URGENT\" in your subject line." },
  { title: "Can I suggest a new tool idea?", content: "Absolutely! We love hearing new ideas. Use the contact form with subject \"Tool Suggestion\" and describe your idea in detail. If selected, we'll give you credit on the tool page." },
  { title: "Do you accept guest posts or partnerships?", content: "Yes! We're open to guest contributions and partnership opportunities. Reach out via our contact form with relevant details and we'll review your proposal." },
];
---

<MainLayout
  title="Contact NumanX Studio — Get in Touch"
  description="Have questions, suggestions, or feedback? Reach out to NumanX Studio. We respond within 24 hours."
  keywords="contact numanx studio, numanx support, feedback, report issue, tool suggestion, contact@numanxstudio.com"
  canonical="https://numanx-tools.pages.dev/contact/"
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Contact", url: "/contact/" },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="absolute top-[15%] left-[10%] w-[300px] h-[300px] rounded-full bg-purple-600/10 blur-[100px] pointer-events-none -z-10" />
    <div class="absolute bottom-[20%] right-[10%] w-[350px] h-[350px] rounded-full bg-blue-600/10 blur-[100px] pointer-events-none -z-10" />
    <div class="max-w-5xl mx-auto">

      <!-- Hero -->
      <section class="text-center mb-16 pt-8">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-surface bg-surface-1 backdrop-blur-sm text-tertiary text-xs font-semibold tracking-wider uppercase mb-8">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-400"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          Get in Touch
        </div>
        <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-none">
          We&rsquo;d Love to Hear
          <span class="block mt-2 bg-gradient-to-r from-purple-400 via-purple-500 to-blue-500 bg-clip-text text-transparent">From You</span>
        </h1>
        <p class="mt-6 text-tertiary text-lg max-w-2xl mx-auto leading-relaxed">
          Have a question, suggestion, or want to report an issue? Send us a message and we&rsquo;ll get back to you within 24 hours.
        </p>
      </section>

      <div class="max-w-4xl mx-auto mb-8">
        <AdUnit format="horizontal" />
      </div>

      <!-- Contact Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 mb-16">
        <!-- Contact Form -->
        <div class="lg:col-span-3">
          <div class="rounded-2xl border border-surface bg-surface-1 p-6 md:p-8 shadow-xl">
            <h2 class="text-xl font-bold text-white mb-6">Send a Message</h2>
            <form id="contact-form" class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="name" class="block text-xs font-semibold text-tertiary mb-1.5">Full Name</label>
                  <input id="name" type="text" placeholder="John Doe" required class="w-full px-4 py-3 rounded-xl bg-black/40 border border-surface text-white placeholder-zinc-600 text-sm focus:border-purple-500/50 focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="email" class="block text-xs font-semibold text-tertiary mb-1.5">Email Address</label>
                  <input id="email" type="email" placeholder="john@example.com" required class="w-full px-4 py-3 rounded-xl bg-black/40 border border-surface text-white placeholder-zinc-600 text-sm focus:border-purple-500/50 focus:outline-none transition-colors" />
                </div>
              </div>
              <div>
                <label for="subject" class="block text-xs font-semibold text-tertiary mb-1.5">Subject</label>
                <select id="subject" class="w-full px-4 py-3 rounded-xl bg-black/40 border border-surface text-secondary text-sm focus:border-purple-500/50 focus:outline-none transition-colors">
                  <option value="">Select a topic</option>
                  <option value="feedback">Feedback</option>
                  <option value="bug">Bug Report</option>
                  <option value="suggestion">Tool Suggestion</option>
                  <option value="partnership">Partnership</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div>
                <label for="message" class="block text-xs font-semibold text-tertiary mb-1.5">Message</label>
                <textarea id="message" rows="5" placeholder="Write your message here..." required class="w-full px-4 py-3 rounded-xl bg-black/40 border border-surface text-white placeholder-zinc-600 text-sm focus:border-purple-500/50 focus:outline-none transition-colors resize-none"></textarea>
              </div>
              <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold text-sm px-6 py-3.5 rounded-xl transition-all duration-200 shadow-lg shadow-purple-900/30">
                Send Message
              </button>
              <p id="contact-success" class="text-xs text-emerald-400 text-center hidden">Message sent successfully! We&rsquo;ll get back to you soon.</p>
            </form>
          </div>
        </div>

        <!-- Contact Info Sidebar -->
        <div class="lg:col-span-2 space-y-5">
          <div class="rounded-2xl border border-surface bg-surface-1 p-6 shadow-xl">
            <h3 class="text-sm font-bold text-white mb-4">Contact Information</h3>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-400 mt-0.5 shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <div>
                  <p class="text-xs font-semibold text-secondary">General Inquiries</p>
                  <a href="mailto:contact@numanxstudio.com" class="text-xs text-muted hover:text-purple-400 transition-colors">contact@numanxstudio.com</a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-400 mt-0.5 shrink-0"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/></svg>
                <div>
                  <p class="text-xs font-semibold text-secondary">Support</p>
                  <a href="mailto:support@numanxstudio.com" class="text-xs text-muted hover:text-purple-400 transition-colors">support@numanxstudio.com</a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-400 mt-0.5 shrink-0"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                <div>
                  <p class="text-xs font-semibold text-secondary">Business / Partnerships</p>
                  <a href="mailto:business@numanxstudio.com" class="text-xs text-muted hover:text-purple-400 transition-colors">business@numanxstudio.com</a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-400 mt-0.5 shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <div>
                  <p class="text-xs font-semibold text-secondary">Location</p>
                  <p class="text-xs text-muted">Karachi, Pakistan</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-400 mt-0.5 shrink-0"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                <div>
                  <p class="text-xs font-semibold text-secondary">Response Time</p>
                  <p class="text-xs text-muted">Typically within 24 hours</p>
                </div>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-surface bg-surface-1 p-6 shadow-xl">
            <h3 class="text-sm font-bold text-white mb-4">Quick Links</h3>
            <div class="space-y-2">
              <a href="/about/" class="block text-xs text-tertiary hover:text-purple-400 transition-colors">About NumanX Studio</a>
              <a href="/privacy-policy/" class="block text-xs text-tertiary hover:text-purple-400 transition-colors">Privacy Policy</a>
              <a href="/terms-of-service/" class="block text-xs text-tertiary hover:text-purple-400 transition-colors">Terms of Service</a>
              <a href="/tools/" class="block text-xs text-tertiary hover:text-purple-400 transition-colors">Browse Tools</a>
            </div>
          </div>

          <div class="rounded-2xl border border-surface bg-surface-1 p-6 shadow-xl">
            <h3 class="text-sm font-bold text-white mb-4">Follow Us</h3>
            <div class="flex flex-wrap gap-3">
              <a href="https://github.com/numanxstudio" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-xl bg-surface-2 border border-surface flex items-center justify-center text-tertiary hover:text-white hover:bg-surface-3 hover:border-purple-500/30 transition-all" aria-label="GitHub">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              </a>
              <a href="https://x.com/numanxstudio" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-xl bg-surface-2 border border-surface flex items-center justify-center text-tertiary hover:text-white hover:bg-surface-3 hover:border-purple-500/30 transition-all" aria-label="Twitter / X">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href="https://instagram.com/numanxstudio" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-xl bg-surface-2 border border-surface flex items-center justify-center text-tertiary hover:text-white hover:bg-surface-3 hover:border-purple-500/30 transition-all" aria-label="Instagram">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
              <a href="https://facebook.com/numanxstudio" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-xl bg-surface-2 border border-surface flex items-center justify-center text-tertiary hover:text-white hover:bg-surface-3 hover:border-purple-500/30 transition-all" aria-label="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="https://tiktok.com/@numanxstudio" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-xl bg-surface-2 border border-surface flex items-center justify-center text-tertiary hover:text-white hover:bg-surface-3 hover:border-purple-500/30 transition-all" aria-label="TikTok">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
              </a>
              <a href="https://youtube.com/@numanxstudio" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-xl bg-surface-2 border border-surface flex items-center justify-center text-tertiary hover:text-white hover:bg-surface-3 hover:border-purple-500/30 transition-all" aria-label="YouTube">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ -->
      <section>
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <div class="max-w-3xl mx-auto">
          <Accordion items={faqItems} />
        </div>
      </section>

    </div>
  </main>
</MainLayout>

<script>
  const form = document.getElementById("contact-form");
  const successMsg = document.getElementById("contact-success");
  if (form && successMsg) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      successMsg.classList.remove("hidden");
      form.reset();
      setTimeout(() => successMsg.classList.add("hidden"), 5000);
    });
  }
</script>


