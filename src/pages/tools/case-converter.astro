---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'What case types are supported?',
    answer:
      'Uppercase (ALL CAPS), lowercase (no caps), title case (Each Word Capitalized), sentence case (First word capitalized), alternating case (aLtErNaTiNg), inverse case (OPPOSITE CASE), and camelCase (camelCaseFormatting).',
  },
  {
    question: 'Is my text stored or uploaded?',
    answer: 'No. All text processing happens entirely in your browser. Your text never leaves your device.',
  },
  {
    question: 'Does this work with non-English text?',
    answer: 'Yes, it works with any Unicode text including accented characters, Cyrillic, Arabic, Chinese, and more.',
  },
];
const ccSchema = {
  name: 'Case Converter',
  applicationCategory: 'Utilities',
  description: 'Convert text between uppercase, lowercase, title case, sentence case, and more instantly.',
  featureList: ['7 case conversion modes', 'Instant real-time results', 'Copy to clipboard', '100% client-side'],
};

const benefits = [
  {
    icon: '⚡',
    title: 'Instant Conversion',
    desc: 'Switch between 7 different case types instantly as you type or paste your text.',
  },
  {
    icon: '📊',
    title: 'Format Variety',
    desc: 'Supports everything from standard UPPERCASE and lowercase to camelCase and aLtErNaTiNg case.',
  },
  {
    icon: '🔒',
    title: '100% Secure',
    desc: 'Your text is processed entirely in your browser. No data is ever sent to our servers.',
  },
  {
    icon: '📋',
    title: 'Quick Copy',
    desc: 'Easily copy the formatted result back to your clipboard with a single click.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Enter Text',
    desc: 'Type or paste the text you want to convert into the input area.',
  },
  {
    num: '2',
    title: 'Select Case',
    desc: 'Click on one of the case formatting buttons (e.g., Title Case, camelCase) to apply it.',
  },
  {
    num: '3',
    title: 'Review Result',
    desc: 'The converted text will instantly appear in the result box below.',
  },
  {
    num: '4',
    title: 'Copy or Download',
    desc: 'Click Copy Result to save it to your clipboard, or Download to save as a text file.',
  },
];

const useCases = [
  {
    icon: '✍️',
    title: 'Content Editing',
    desc: 'Quickly fix caps lock mistakes or format blog post headlines into proper Title Case.',
  },
  {
    icon: '👨‍💻',
    title: 'Programming',
    desc: 'Convert variable names between camelCase, snake_case, PascalCase, and kebab-case instantly.',
  },
  {
    icon: '📱',
    title: 'Social Media',
    desc: 'Create eye-catching alternating case (sPoNgEbOb case) for memes and social media posts.',
  },
];
---

<MainLayout
  title="Case Converter Online — UPPERCASE, lowercase, Title Case & camelCase Tool | NumanX Tools"
  description="Convert text between uppercase, lowercase, title case, sentence case, alternating case, and camelCase. Free online case converter."
  keywords="case converter online, case converter, uppercase, lowercase, title case, camelcase, text converter"
  toolSchema={ccSchema}
  faq={faqItems}
  howto={{
    name: 'How to Use Case Converter',
    description: 'Step-by-step guide for using Case Converter.',
    steps: [],
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Case Converter', url: '/tools/case-converter/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="Case"
        gradient="Converter Pro"
        desc="Convert text between uppercase, lowercase, title case, sentence case, alternating case, and more."
        badge="✦ New Tool"
        slug="case-converter"
      />
      <ShareBar />
      <div class="max-w-xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6 relative">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
              <span id="usage-badge" class="text-xs text-muted"></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex gap-1">
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="purple"
                  style="background:#a855f7"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="blue"
                  style="background:#3b82f6"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="green"
                  style="background:#22c55e"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="pink"
                  style="background:#ec4899"></button>
              </div>
              <button
                id="fullscreen-btn"
                class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs"
                title="Fullscreen">⛶</button
              >
            </div>
          </div>
          <div class="flex items-center gap-1.5 mb-2">
            <button
              class="font-dec p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all"
              >A−</button
            >
            <button
              class="font-inc p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all"
              >A+</button
            >
            <span class="text-xs text-muted ml-auto">Ctrl+Enter to process</span>
          </div>
          <div class="flex">
            <div
              id="line-nums"
              class="text-xs text-muted text-right pr-2 select-none overflow-hidden font-mono leading-relaxed pt-3 whitespace-pre shrink-0"
              style="min-width:2.5em; max-width:3.5em;"
            >
              1
            </div>
            <textarea
              id="input-text"
              class="flex-1 h-32 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-green-500/50 focus:outline-none transition-all resize-none font-mono"
              placeholder="Type or paste your text here..."></textarea>
          </div>
          <div id="reading-time" class="text-xs text-muted mt-1"></div>
          <div id="letter-freq" class="mt-2 space-y-0.5 max-h-24 overflow-y-auto hidden"></div>
          <div class="flex flex-wrap gap-2 mt-4">
            <button
              class="case-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-green-600 text-white"
              data-mode="upper">UPPERCASE</button
            >
            <button
              class="case-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary"
              data-mode="lower">lowercase</button
            >
            <button
              class="case-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary"
              data-mode="title">Title Case</button
            >
            <button
              class="case-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary"
              data-mode="sentence">Sentence case</button
            >
            <button
              class="case-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary"
              data-mode="alternating">aLtErNaTiNg</button
            >
            <button
              class="case-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary"
              data-mode="inverse">INVERSE</button
            >
            <button
              class="case-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary"
              data-mode="camel">camelCase</button
            >
            <button
              class="case-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary"
              data-mode="pascal">PascalCase</button
            >
            <button
              class="case-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary"
              data-mode="snake">snake_case</button
            >
            <button
              class="case-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary"
              data-mode="kebab">kebab-case</button
            >
          </div>
          <div class="mt-6 pt-6 border-t border-surface">
            <label class="block text-xs font-medium text-tertiary mb-1.5">Result</label>
            <textarea
              id="output-text"
              class="w-full h-24 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:outline-none resize-none font-mono"
              readonly
              placeholder="Result will appear here..."></textarea>
            <div class="flex gap-2 mt-2">
              <select
                id="export-format"
                class="bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5"
              >
                <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option
                ><option value="html">HTML</option>
              </select>
              <button
                id="download-btn"
                class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
                >Download</button
              >
              <button
                id="share-btn"
                class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-2.5 py-1.5 rounded-lg border border-surface-3 transition-all"
                title="Copy share link">🔗</button
              >
              <button
                id="copy-btn"
                class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
                >Copy Result</button
              >
            </div>
          </div>
        </div>
      </div>
      <ToolContentSections
        toolSlug="case-converter"
        toolName="Case Converter"
        category="Utility Tools"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />
      <RelatedTools current="case-converter" />
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span class="bg-gradient-to-r from-green-400 to-emerald-500 bg-clip-text text-transparent"
            >Questions</span
          >
        </h2><Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>
<script>
  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }
  const input = document.getElementById('input-text');
  const output = document.getElementById('output-text');
  const copyBtn = document.getElementById('copy-btn');
  document.querySelectorAll('.case-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.case-btn').forEach((b) => {
        b.classList.remove('bg-green-600', 'text-white');
        b.classList.add('bg-surface-2', 'text-tertiary', 'hover:text-primary');
      });
      btn.classList.remove('bg-surface-2', 'text-tertiary', 'hover:text-primary');
      btn.classList.add('bg-green-600', 'text-white');
      convert(btn.dataset.mode);
    });
  });
  input.addEventListener('input', () => {
    const active = document.querySelector('.case-btn.bg-green-600');
    if (active) convert(active.dataset.mode);
  });
  function convert(mode) {
    const t = input.value;
    if (!t) {
      output.value = '';
      return;
    }
    let r;
    switch (mode) {
      case 'upper':
        r = t.toUpperCase();
        break;
      case 'lower':
        r = t.toLowerCase();
        break;
      case 'title':
        r = t.replace(/\w\S*/g, (w) => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase());
        break;
      case 'sentence':
        r = t.charAt(0).toUpperCase() + t.slice(1).toLowerCase();
        break;
      case 'alternating':
        r = t
          .split('')
          .map((c, i) => (i % 2 === 0 ? c.toLowerCase() : c.toUpperCase()))
          .join('');
        break;
      case 'inverse':
        r = t
          .split('')
          .map((c) => (c === c.toUpperCase() ? c.toLowerCase() : c.toUpperCase()))
          .join('');
        break;
      case 'camel':
        r = t
          .toLowerCase()
          .replace(/[^a-zA-Z0-9]+(.)/g, (_, c) => c.toUpperCase())
          .replace(/\s+/g, '');
        break;
      case 'pascal':
        r = t
          .toLowerCase()
          .replace(/[^a-zA-Z0-9]+(.)/g, (_, c) => c.toUpperCase())
          .replace(/^(.)/, (c) => c.toUpperCase())
          .replace(/\s+/g, '');
        break;
      case 'snake':
        r = t
          .toLowerCase()
          .trim()
          .replace(/[\s\W]+/g, '_');
        break;
      case 'kebab':
        r = t
          .toLowerCase()
          .trim()
          .replace(/[\s\W]+/g, '-');
        break;
    }
    output.value = r;
  }
  copyBtn.addEventListener('click', async () => {
    if (!output.value) return;
    await navigator.clipboard.writeText(output.value);
    playPing();
    if ((window as any).__showToast) (window as any).__showToast({ message: 'Copied!', variant: 'success' });
  });

  document.getElementById('download-btn')?.addEventListener('click', () => {
    const outputText = output.value;
    if (!outputText) {
      if ((window as any).__showToast)
        (window as any).__showToast({ message: 'Nothing to download!', variant: 'warning' });
      return;
    }
    const fmt = (document.getElementById('export-format') as HTMLSelectElement)?.value || 'txt';
    let content = outputText;
    let mime = 'text/plain';
    let ext = 'txt';
    if (fmt === 'json') {
      content = JSON.stringify({ result: outputText, tool: 'case-converter', timestamp: new Date().toISOString() });
      mime = 'application/json';
      ext = 'json';
    }
    if (fmt === 'csv') {
      content = 'Result\n"' + outputText.replace(/"/g, '""') + '"';
      mime = 'text/csv';
      ext = 'csv';
    }
    if (fmt === 'html') {
      content = '<!DOCTYPE html><html><body><pre>' + outputText.replace(/</g, '&lt;') + '</pre></body></html>';
      mime = 'text/html';
      ext = 'html';
    }
    const blob = new Blob([content], { type: mime });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'case-converter-output.' + ext;
    a.click();
    URL.revokeObjectURL(a.href);
    playPing();
    if ((window as any).__showToast) (window as any).__showToast({ message: 'Downloaded!', variant: 'success' });
  });

  document.getElementById('fullscreen-btn')?.addEventListener('click', () => {
    const card =
      document.getElementById('fullscreen-btn').closest('.bg-surface-1.border.border-surface.rounded-2xl') ||
      document.getElementById('fullscreen-btn').closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
      document.getElementById('fullscreen-btn').textContent = '⛶';
    } else {
      card.requestFullscreen?.() || card.webkitRequestFullscreen?.();
      document.getElementById('fullscreen-btn').textContent = '✕';
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const btn = document.getElementById('fullscreen-btn');
    if (btn) btn.textContent = document.fullscreenElement ? '✕' : '⛶';
  });

  const DRAFT_KEY = 'nt_draft_case-converter';
  (function () {
    const input = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
    if (!input) return;
    try {
      const saved = localStorage.getItem(DRAFT_KEY);
      if (saved && !input.value) {
        input.value = saved;
        input.dispatchEvent(new Event('input'));
      }
    } catch (e) {}
    let saveTimer;
    input.addEventListener('input', () => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        try {
          localStorage.setItem(DRAFT_KEY, input.value);
        } catch (e) {}
      }, 500);
    });
  })();

  document.querySelector('.font-inc')?.addEventListener('click', () => {
    document.querySelectorAll('textarea').forEach((t) => {
      let s = parseInt(getComputedStyle(t).fontSize);
      t.style.fontSize = Math.min(24, s + 2) + 'px';
    });
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    document.querySelectorAll('textarea').forEach((t) => {
      let s = parseInt(getComputedStyle(t).fontSize);
      t.style.fontSize = Math.max(10, s - 2) + 'px';
    });
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) document.querySelectorAll('textarea').forEach((t) => (t.style.fontSize = s + 'px'));
  } catch (e) {}

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b =
        document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])") ||
        document.querySelector("button[class*='bg-']:not([id*='full']):not([id*='paste'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      const clearBtn = document.getElementById('clear-btn') || document.querySelector("button[id*='clear']") || document.querySelector("button[id*='reset']");
      if (clearBtn) clearBtn.click();
      else {
        const inputs = document.querySelectorAll('textarea, input:not([type="radio"]):not([type="checkbox"])');
        inputs.forEach(i => i.value = '');
        const evt = new Event('input', { bubbles: true });
        inputs.forEach(i => i.dispatchEvent(evt));
      }
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });

  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['case-converter']) b.textContent = 'Used ' + u['case-converter'] + '×';
  } catch (e) {}

  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('output-text') || document.querySelector("[id$='result']");
    const t = o?.value || o?.textContent || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof (window as any).__showToast === 'function') (window as any).__showToast({ message: 'Link copied!' });
  });

  const rtInput = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
  if (rtInput) {
    rtInput.addEventListener('input', () => {
      const w = rtInput.value ? rtInput.value.trim().split(/\s+/).length : 0;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent =
          Math.max(1, Math.round(w / 200)) + ' min read · ' + Math.max(1, Math.round(w / 150)) + ' min speak';
    });
    rtInput.dispatchEvent(new Event('input'));
  }

  const lnInput = document.getElementById('input-text');
  if (lnInput) {
    const updateLN = () => {
      const n = document.getElementById('line-nums');
      if (n) n.textContent = Array.from({ length: lnInput.value.split('\n').length }, (_, i) => i + 1).join('\n');
    };
    lnInput.addEventListener('input', updateLN);
    lnInput.addEventListener('scroll', () => {
      const n = document.getElementById('line-nums');
      if (n) n.scrollTop = lnInput.scrollTop;
    });
    updateLN();
  }

  const lfInput = document.getElementById('input-text');
  if (lfInput) {
    lfInput.addEventListener('input', () => {
      const t = lfInput.value.toLowerCase().replace(/[^a-z]/g, '');
      if (!t) {
        document.getElementById('letter-freq').classList.add('hidden');
        return;
      }
      const f = {};
      for (const c of t) f[c] = (f[c] || 0) + 1;
      const s = Object.entries(f)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8);
      const m = s[0] ? s[0][1] : 1;
      const el = document.getElementById('letter-freq');
      el.classList.remove('hidden');
      el.innerHTML = s
        .map(
          ([c, n]) =>
            `<div class="flex items-center gap-1.5 text-xs"><span class="w-3 text-center font-mono text-white">${c}</span><div class="h-2 rounded-full bg-purple-500/50" style="width:${(n / m) * 80 + 10}%"></div><span class="text-muted">${n}</span></div>`,
        )
        .join('');
    });
  }

  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      const map = { purple: '#a855f7', blue: '#3b82f6', green: '#22c55e', pink: '#ec4899', orange: '#f97316' };
      document.querySelectorAll("button[class*='bg-purple'], button[class*='bg-violet']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(purple|violet)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(purple|violet)-\d+/g, 'hover:bg-' + c + '-500')
          .replace(/from-(purple|violet)-\d+/g, 'from-' + c + '-500')
          .replace(/to-purple-\d+/g, 'to-' + c + '-600');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}
</script>
