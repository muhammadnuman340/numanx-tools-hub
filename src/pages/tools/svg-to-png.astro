---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'Is the SVG to PNG conversion done server-side?',
    answer:
      'No, all conversion happens entirely in your browser. The SVG is rendered onto an HTML5 Canvas element using a Blob URL, then exported as a PNG image. Your SVG code never leaves your device.',
  },
  {
    question: 'What SVG features are supported?',
    answer:
      "Most standard SVG elements and styling are supported since the conversion uses the browser's native SVG rendering engine through Canvas. However, advanced features like external fonts, external images, or complex filters may not render correctly.",
  },
  {
    question: 'What dimensions should I use for the PNG?',
    answer:
      'The width and height you specify determine the output PNG dimensions in pixels. For best results, ensure your SVG uses relative or consistent coordinates. Higher dimensions produce larger, sharper images but also increase the file size.',
  },
  {
    question: 'Can I convert SVG with external images or fonts?',
    answer:
      'External resources like images, fonts, or CSS files referenced in your SVG may not render correctly because the browser sandboxes SVG rendering on Canvas. For best results, embed all assets directly in the SVG markup.',
  },
  {
    question: 'What is the advantage of SVG over PNG?',
    answer:
      "SVG is a vector format that scales infinitely without losing quality, making it ideal for logos and icons. PNG is a raster format needed for platforms that don't support SVG, like most image editors and social media.",
  },
  {
    question: 'Is the SVG code stored or logged?',
    answer:
      'No. All processing happens client-side in your browser. Your SVG code is not sent to any server, stored in any database, or logged in any way. Complete privacy is guaranteed.',
  },
  {
    question: 'What file formats can I export to?',
    answer:
      'PNG is the primary export format with customizable dimensions. You can also copy the result as raw text, JSON, CSV, or HTML using the export format dropdown in the preview section.',
  },
];
const schema = {
  name: 'SVG to PNG Converter',
  applicationCategory: 'Image',
  description:
    'Convert SVG code to PNG images instantly in your browser. Custom dimensions, live preview, and one-click download.',
  featureList: ['Client-side conversion', 'Custom dimensions', 'Live preview', 'One-click download'],
};

const benefits = [
  {
    icon: '🔄',
    title: 'Vector to Raster',
    desc: 'Convert scalable SVG vectors to PNG raster images compatible with all platforms, editors, and social media.',
  },
  {
    icon: '📐',
    title: 'Custom Dimensions',
    desc: 'Set exact width and height in pixels. Generate PNG at any size from your SVG code.',
  },
  {
    icon: '👁️',
    title: 'Live Preview',
    desc: 'See the converted PNG instantly before downloading. Make sure every detail renders correctly.',
  },
  {
    icon: '🔒',
    title: '100% Private',
    desc: 'SVG rendering and PNG conversion happen entirely in your browser. Your code never leaves your device.',
  },
  {
    icon: '⚡',
    title: 'Instant Processing',
    desc: 'No server round-trips. Your SVG is rendered locally via Canvas API and exported as PNG in milliseconds.',
  },
  {
    icon: '🆓',
    title: 'Free Forever',
    desc: 'No sign-ups, no limits, no hidden charges. Unlimited SVG to PNG conversions for everyone.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Paste SVG Code',
    desc: 'Copy and paste your SVG markup into the code editor. Supports any standard SVG with inline styling.',
  },
  {
    num: '2',
    title: 'Set Dimensions',
    desc: 'Enter the desired width and height in pixels. These determine the output PNG resolution.',
  },
  {
    num: '3',
    title: 'Convert to PNG',
    desc: 'Click convert to render your SVG onto a Canvas element and export as a PNG image.',
  },
  {
    num: '4',
    title: 'Download',
    desc: 'Preview the result and download your PNG image. The file is ready for immediate use.',
  },
];

const useCases = [
  {
    icon: '🎨',
    title: 'Design Assets',
    desc: 'Convert SVG icons and illustrations to PNG for use in design tools, presentations, and documents.',
  },
  {
    icon: '🌐',
    title: 'Website Assets',
    desc: 'Generate PNG fallbacks for SVG images on websites that need browser compatibility across all platforms.',
  },
  {
    icon: '📱',
    title: 'App Development',
    desc: 'Convert SVG vectors to PNG assets at exact resolutions for mobile and desktop app interfaces.',
  },
  {
    icon: '🖨️',
    title: 'Print Design',
    desc: 'Convert SVG logos and graphics to high-resolution PNG for print materials and branding assets.',
  },
];
---

<MainLayout
  title="SVG to PNG Converter - Convert SVG to PNG Online Free"
  description="Convert SVG code to PNG images instantly in your browser. Custom dimensions, live preview, and one-click download."
  keywords="svg to png, convert svg, svg converter, png converter, svg to image"
  toolSchema={schema}
  faq={faqItems}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'SVG to PNG Converter', url: '/tools/svg-to-png/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="SVG →"
        gradient="PNG Pro"
        desc="Convert SVG code to PNG images instantly in your browser. Custom dimensions, live preview, and one-click download."
        badge="✦ New Tool"
        slug="svg-to-png"
      />
      <ShareBar />
      <div class="max-w-xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
            <div class="flex items-center gap-2">
              <div class="flex gap-1" role="group" aria-label="Theme color swatches">
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="purple"
                  aria-label="Set purple theme"
                  style="background:#a855f7"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="blue"
                  aria-label="Set blue theme"
                  style="background:#3b82f6"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="green"
                  aria-label="Set green theme"
                  style="background:#22c55e"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="pink"
                  aria-label="Set pink theme"
                  style="background:#ec4899"></button>
              </div>
              <button
                id="fullscreen-btn"
                aria-label="Toggle fullscreen"
                class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs"
                title="Fullscreen">⛶</button
              >
            </div>
          </div>
          <div class="flex items-center justify-between min-h-[32px] mb-2">
            <label for="svg-input" class="text-xs font-semibold text-zinc-300">SVG Code</label>
            <div class="flex items-center gap-1.5">
              <div class="flex items-center gap-0.5 bg-surface-2 p-0.5 rounded-lg border border-surface">
                <button
                  type="button"
                  aria-label="Decrease font size"
                  class="font-dec px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                  >A−</button
                >
                <button
                  type="button"
                  aria-label="Increase font size"
                  class="font-inc px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                  >A+</button
                >
              </div>
              <span class="text-xs text-muted ml-2">Ctrl+Enter to process</span>
            </div>
          </div>
          <div class="flex h-[240px] rounded-xl bg-black/40 border border-surface focus-within:border-green-400 focus-within:ring-1 focus-within:ring-green-400 transition-all overflow-hidden relative">
            <div
              id="line-nums"
              class="w-12 shrink-0 h-full select-none overflow-hidden font-mono text-sm leading-6 text-right pr-3.5 py-3 text-zinc-500/80 bg-zinc-950/60 border-r border-white/5 whitespace-pre pointer-events-none tabular-nums"
              style="line-height: 24px; font-size: 14px;"
            >
              1
            </div>
            <textarea
              id="svg-input"
              aria-label="SVG markup input"
              class="flex-1 min-w-0 h-full bg-transparent text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 px-4 py-3 focus:outline-none font-mono resize-none border-0 overflow-y-auto"
              style="line-height: 24px; font-size: 14px;"
              placeholder='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="green" /></svg>'
            ></textarea>
          </div>
          <div class="flex justify-between text-xs text-muted mt-2 px-1">
            <span><span id="char-count">0</span> chars</span>
            <span><span id="word-count">0</span> words</span>
            <span><span id="line-count">0</span> lines</span>
          </div>
          <div id="reading-time" class="text-xs text-muted mt-2"></div>
          <div id="letter-freq" tabindex="0" role="region" aria-label="Character frequency breakdown" class="mt-2 flex flex-wrap gap-1.5 hidden"></div>
          <div class="grid grid-cols-2 gap-3 mt-4 mb-4">
            <div>
              <label for="width-input" class="block text-xs font-semibold text-zinc-300 mb-1.5">Width (px)</label><input
                id="width-input"
                type="number"
                min="1"
                value="500"
                class="w-full px-3 py-3 rounded-xl border border-surface bg-surface-1 text-white text-sm focus:border-green-400/50 focus:outline-none transition-all"
              />
            </div>
            <div>
              <label for="height-input" class="block text-xs font-semibold text-zinc-300 mb-1.5">Height (px)</label><input
                id="height-input"
                type="number"
                min="1"
                value="500"
                class="w-full px-3 py-3 rounded-xl border border-surface bg-surface-1 text-white text-sm focus:border-green-400/50 focus:outline-none transition-all"
              />
            </div>
          </div>
          <button
            id="convert-btn"
            class="w-full bg-gradient-to-r from-green-400 to-emerald-500 text-white font-bold text-sm px-6 py-3 rounded-xl hover:opacity-90 transition-all"
            >Convert to PNG</button
          >
          <div id="preview-area" class="mt-6 pt-6 border-t border-surface hidden">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-medium text-tertiary">Preview</span><div class="flex items-center gap-2">
                <span id="usage-badge" class="text-xs text-muted"></span><button
                  id="share-btn"
                  class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all cursor-pointer"
                  title="Share">🔗</button
                ><select
                  id="export-format"
                  class="bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5"
                  ><option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option
                  ><option value="html">HTML</option></select
                ><button
                  id="copy-btn"
                  class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all cursor-pointer"
                  ><span>Copy</span></button
                ><a
                  id="download-link"
                  download="converted.png"
                  class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all cursor-pointer"
                  >Download PNG</a
                >
              </div>
            </div>
            <div
              class="bg-surface-2 rounded-xl p-4 flex items-center justify-center border border-surface-3 min-h-[200px]"
            >
              <img id="preview-img" class="max-w-full h-auto" alt="PNG preview" />
            </div>
            <div class="flex justify-end mt-3">
              <div class="flex gap-1">
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="purple"
                  style="background:#a855f7"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="blue"
                  style="background:#3b82f6"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="green"
                  style="background:#22c55e"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="pink"
                  style="background:#ec4899"></button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <section class="mt-20 max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-green-400 uppercase tracking-wider">Learn</span><h2
            class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1"
          >
            SVG to <span class="bg-gradient-to-r from-green-400 to-emerald-500 bg-clip-text text-transparent"
              >PNG Conversion</span
            >
          </h2>
        </div><div class="space-y-4 text-sm text-tertiary leading-relaxed">
          <p>
            SVG (Scalable Vector Graphics) is ideal for logos, icons, and illustrations because it scales infinitely
            without losing quality. However, many platforms require raster PNG images. This converter renders your SVG
            code onto a canvas element and exports it as a PNG, giving you full control over the output dimensions while
            keeping the entire process client-side for privacy and speed.
          </p>
        </div>
      </section>
      <RelatedTools current="svg-to-png" />
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span class="bg-gradient-to-r from-green-400 to-emerald-500 bg-clip-text text-transparent"
            >Questions</span
          >
        </h2><Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>
<script>
  const svgInput = document.getElementById('svg-input');
  const widthInput = document.getElementById('width-input');
  const heightInput = document.getElementById('height-input');
  const convertBtn = document.getElementById('convert-btn');
  const previewArea = document.getElementById('preview-area');
  const previewImg = document.getElementById('preview-img');
  const downloadLink = document.getElementById('download-link');

  convertBtn.addEventListener('click', async () => {
    const svgCode = svgInput.value.trim();
    if (!svgCode) return;

    const width = parseInt(widthInput.value) || 500;
    const height = parseInt(heightInput.value) || 500;

    try {
      const blob = new Blob([svgCode], { type: 'image/svg+xml;charset=utf-8' });
      const url = URL.createObjectURL(blob);

      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, width, height);
        ctx.drawImage(img, 0, 0, width, height);

        const dataUrl = canvas.toDataURL('image/png');
        previewImg.src = dataUrl;
        downloadLink.href = dataUrl;
        previewArea.classList.remove('hidden');

        URL.revokeObjectURL(url);
      };
      img.onerror = () => {
        if ((window as any).__showToast) (window as any).__showToast({ message: 'Invalid SVG code', variant: 'error' });
        URL.revokeObjectURL(url);
      };
      img.src = url;
    } catch (e) {
      if ((window as any).__showToast) (window as any).__showToast({ message: 'Conversion failed', variant: 'error' });
    }
  });

  document.getElementById('copy-btn')?.addEventListener('click', () => {
    const text =
      document.getElementById('output-text')?.value || document.querySelector("[id$='result']")?.textContent || '';
    if (!text) return;
    navigator.clipboard.writeText(text).catch(() => {});
    const btn = document.getElementById('copy-btn');
    const span = btn.querySelector('span');
    span.textContent = 'Copied!';
    setTimeout(() => {
      span.textContent = 'Copy';
    }, 2000);
  });

  function updateSVGStats() {
    const val = svgInput.value;
    document.getElementById('char-count').textContent = val.length;
    document.getElementById('word-count').textContent = val.trim() ? val.trim().split(/\s+/).length : 0;
    document.getElementById('line-count').textContent = val ? val.split('\n').length : 0;
  }
  svgInput.addEventListener('input', updateSVGStats);
  updateSVGStats();

  // Fullscreen toggle
  document.getElementById('fullscreen-btn')?.addEventListener('click', () => {
    const card = document.getElementById('fullscreen-btn').closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
      document.getElementById('fullscreen-btn').textContent = '⛶';
    } else {
      card.requestFullscreen?.() || card.webkitRequestFullscreen?.();
      document.getElementById('fullscreen-btn').textContent = '✕';
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const btn = document.getElementById('fullscreen-btn');
    if (btn) btn.textContent = document.fullscreenElement ? '✕' : '⛶';
  });

  // Auto-save draft
  const DRAFT_KEY = 'nt_draft_svg-to-png';
  (function () {
    const input = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
    if (!input) return;
    try {
      const saved = localStorage.getItem(DRAFT_KEY);
      if (saved && !input.value) {
        input.value = saved;
        input.dispatchEvent(new Event('input'));
      }
    } catch (e) {}
    let saveTimer;
    input.addEventListener('input', () => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        try {
          localStorage.setItem(DRAFT_KEY, input.value);
        } catch (e) {}
      }, 500);
    });
  })();

  // Feature 1: Font size
  const updateEditorFontSize = (newSize: number) => {
    const clamped = Math.max(10, Math.min(24, newSize));
    const lineHeight = Math.round(clamped * 1.7);
    document.querySelectorAll('textarea').forEach((t) => {
      t.style.fontSize = clamped + 'px';
      t.style.lineHeight = lineHeight + 'px';
    });
    const lineNums = document.getElementById('line-nums');
    if (lineNums) {
      lineNums.style.fontSize = clamped + 'px';
      lineNums.style.lineHeight = lineHeight + 'px';
    }
    try {
      localStorage.setItem('nt_fs', String(clamped));
    } catch (e) {}
  };

  document.querySelector('.font-inc')?.addEventListener('click', () => {
    const ta = document.getElementById('svg-input');
    const s = parseInt(getComputedStyle(ta as HTMLElement).fontSize) || 14;
    updateEditorFontSize(s + 2);
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    const ta = document.getElementById('svg-input');
    const s = parseInt(getComputedStyle(ta as HTMLElement).fontSize) || 14;
    updateEditorFontSize(s - 2);
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) updateEditorFontSize(parseInt(s));
  } catch (e) {}

  // Feature 2: Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b = document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      const clearBtn = document.getElementById('clear-btn') || document.querySelector("button[id*='clear']") || document.querySelector("button[id*='reset']");
      if (clearBtn) clearBtn.click();
      else {
        const inputs = document.querySelectorAll('textarea, input:not([type="radio"]):not([type="checkbox"])');
        inputs.forEach(i => i.value = '');
        const evt = new Event('input', { bubbles: true });
        inputs.forEach(i => i.dispatchEvent(evt));
      }
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });

  // Feature 3: Usage badge
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['svg-to-png']) b.textContent = 'Used ' + u['svg-to-png'] + '×';
  } catch (e) {}

  // Feature 4: Share button
  document.getElementById('share-btn')?.addEventListener('click', () => {
    const u = window.location.origin + window.location.pathname;
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof showToast === 'function') {
      if (typeof playPing === 'function') playPing();
      showToast('Link copied!');
    }
  });

  // Feature 5: Reading time
  const rt = document.getElementById('svg-input');
  if (rt) {
    rt.addEventListener('input', () => {
      const w = rt.value ? rt.value.trim().split(/\s+/).length : 0;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent = Math.max(1, Math.round(w / 200)) + 'm read · ' + Math.max(1, Math.round(w / 150)) + 'm speak';
    });
    rt.dispatchEvent(new Event('input'));
  }

  // Feature 6: Line numbers
  (function () {
    const li = document.getElementById('svg-input');
    if (li) {
      const ul = () => {
        const n = document.getElementById('line-nums');
        if (n) n.textContent = Array.from({ length: li.value.split('\n').length }, (_, i) => i + 1).join('\n');
      };
      li.addEventListener('input', ul);
      li.addEventListener('scroll', () => {
        const n = document.getElementById('line-nums');
        if (n) n.scrollTop = li.scrollTop;
      });
      ul();
    }
  })();

  // Feature 7: Sound effects
  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }

  // Feature 8: Export format - update download link
  document.getElementById('export-format')?.addEventListener('change', function () {
    const f = this.value;
    const dl = document.getElementById('download-link');
    if (f === 'txt') {
      dl.download = 'converted.txt';
      dl.textContent = 'Download TXT';
    } else if (f === 'json') {
      dl.download = 'converted.json';
      dl.textContent = 'Download JSON';
    } else if (f === 'csv') {
      dl.download = 'converted.csv';
      dl.textContent = 'Download CSV';
    } else if (f === 'html') {
      dl.download = 'converted.html';
      dl.textContent = 'Download HTML';
    } else {
      dl.download = 'converted.png';
      dl.textContent = 'Download PNG';
    }
  });

  // Feature 9: Letter frequency
  (function () {
    const lf = document.getElementById('svg-input');
    if (lf) {
      lf.addEventListener('input', () => {
        const t = lf.value.toLowerCase().replace(/[^a-z]/g, '');
        if (!t) {
          document.getElementById('letter-freq')?.classList.add('hidden');
          return;
        }
        const f = {};
        for (const c of t) f[c] = (f[c] || 0) + 1;
        const s = Object.entries(f)
          .sort((a, b) => b[1] - a[1])
          .slice(0, 8);
        const m = s[0] ? s[0][1] : 1;
        const el = document.getElementById('letter-freq');
        el.classList.remove('hidden');
        el.innerHTML = s
          .map(
            ([c, n]) =>
              `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-xs font-mono"><strong class="text-green-400 uppercase">${c}</strong><span class="text-zinc-400">${n}</span></span>`,
          )
          .join('');
      });
    }
  })();

  // Feature 10: Theme picker
  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      document.querySelectorAll("button[class*='bg-purple'],button[class*='bg-violet']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(purple|violet)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(purple|violet)-\d+/g, 'hover:bg-' + c + '-500');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}
</script>
