---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";

const faqItems = [
  { question: "What does the CSS formatter do?", answer: "It takes minified or messy CSS and beautifies it with proper indentation, line breaks, and consistent spacing for maximum readability." },
  { question: "Is my CSS code stored or uploaded?", answer: "No. All processing happens entirely in your browser. Your CSS never leaves your device." },
  { question: "Can I minify CSS for production use?", answer: "Yes. The Minify button strips unnecessary whitespace, comments, and newlines to create a production-ready compact CSS output." },
];
const cssSchema = { name: "CSS Formatter", applicationCategory: "Developer Tools", description: "Format and beautify CSS code with proper indentation. Minify CSS for production use.", featureList: ["Format CSS with proper indentation", "Minify for production", "Copy to clipboard", "100% client-side"] };
---
<MainLayout title="CSS Formatter - Format & Beautify CSS Online Free" description="Format and beautify your CSS code with proper indentation. Minify CSS for production. Free online CSS formatter." keywords="css formatter, css beautifier, css minifier, format css, css indentation" toolSchema={cssSchema} faq={faqItems} breadcrumbs={[{name:"Home",url:"/"},{name:"Tools",url:"/tools/"},{name:"CSS Formatter",url:"/tools/css-formatter/"}]}>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden"><div class="max-w-4xl mx-auto">
    <ToolHeader title="CSS" gradient="Formatter Pro" desc="Format and beautify your CSS code with proper indentation. Minify CSS for production use." badge="✦ New Tool" slug="css-formatter" />
    <ShareBar />
    <div class="max-w-xl mx-auto mt-10">
      <div class="bg-surface-1 border border-surface rounded-2xl p-6">
        <textarea id="input-text" class="w-full h-32 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-blue-500/50 focus:outline-none transition-all resize-none font-mono" placeholder="Paste your CSS code here..."></textarea>
        <div class="flex flex-wrap gap-2 mt-4">
          <button id="format-btn" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-blue-600 text-white">Format</button>
          <button id="minify-btn" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary">Minify</button>
        </div>
        <div class="mt-6 pt-6 border-t border-surface">
          <label class="block text-xs font-medium text-tertiary mb-1.5">Result</label>
          <textarea id="output-text" class="w-full h-32 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:outline-none resize-none font-mono" readonly placeholder="Formatted CSS will appear here..."></textarea>
          <button id="copy-btn" class="mt-2 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all">Copy Result</button>
        </div>
      </div>
    </div>
    <section class="mt-20 max-w-3xl mx-auto"><div class="text-center mb-8"><span class="text-xs font-semibold text-blue-400 uppercase tracking-wider">Learn</span><h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">Why Use a <span class="bg-gradient-to-r from-blue-400 to-cyan-500 bg-clip-text text-transparent">CSS Formatter?</span></h2></div><div class="space-y-4 text-sm text-tertiary leading-relaxed"><p>Well-formatted CSS is critical for maintaining large stylesheets. A CSS formatter instantly transforms compressed or messy styles into readable, indented code — making it easier to debug, review, and collaborate on your stylesheets.</p></div></section>
    <RelatedTools current="css-formatter" />
    <div class="mt-20 max-w-3xl mx-auto"><h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">Frequently Asked <span class="bg-gradient-to-r from-blue-400 to-cyan-500 bg-clip-text text-transparent">Questions</span></h2><Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} /></div>
  </div></main>
</MainLayout>
<script>
  const input = document.getElementById("input-text");
  const output = document.getElementById("output-text");
  const copyBtn = document.getElementById("copy-btn");
  const formatBtn = document.getElementById("format-btn");
  const minifyBtn = document.getElementById("minify-btn");

  formatBtn.addEventListener("click", () => {
    const css = input.value;
    if (!css) { output.value = ""; return; }
    output.value = formatCSS(css);
  });

  minifyBtn.addEventListener("click", () => {
    const css = input.value;
    if (!css) { output.value = ""; return; }
    output.value = css
      .replace(/\/\*[\s\S]*?\*\//g, "")
      .replace(/\s*([{}:;,])\s*/g, "$1")
      .replace(/\s+/g, " ")
      .replace(/;\s*}/g, "}")
      .trim();
  });

  function formatCSS(css) {
    css = css.replace(/\/\*[\s\S]*?\*\//g, m => m.replace(/\n/g, "\n  "));
    css = css.replace(/\s*([{};])\s*/g, "$1").replace(/\s+/g, " ");
    let indent = 0;
    const lines = [];
    for (const char of css) {
      if (char === "{") {
        lines.push(char);
        indent++;
        lines.push("\n" + "  ".repeat(indent));
      } else if (char === "}") {
        indent--;
        lines.push("\n" + "  ".repeat(indent) + char);
      } else if (char === ";") {
        lines.push(char + "\n" + "  ".repeat(indent));
      } else {
        lines.push(char);
      }
    }
    return lines.join("").replace(/\n\s*\n/g, "\n").trim();
  }

  copyBtn.addEventListener("click", async () => {
    if (!output.value) return;
    await navigator.clipboard.writeText(output.value);
    if (window.__showToast) window.__showToast({ message: "Copied!", variant: "success" });
  });
</script>
