---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'What does the CSS formatter do?',
    answer:
      'It takes minified or messy CSS and beautifies it with proper indentation, line breaks, and consistent spacing for maximum readability.',
  },
  {
    question: 'Is my CSS code stored or uploaded?',
    answer: 'No. All processing happens entirely in your browser. Your CSS never leaves your device.',
  },
  {
    question: 'Can I minify CSS for production use?',
    answer:
      'Yes. The Minify button strips unnecessary whitespace, comments, and newlines to create a production-ready compact CSS output.',
  },
];
const cssSchema = {
  name: 'CSS Formatter',
  applicationCategory: 'Developer Tools',
  description: 'Format and beautify CSS code with proper indentation. Minify CSS for production use.',
  featureList: ['Format CSS with proper indentation', 'Minify for production', 'Copy to clipboard', '100% client-side'],
};

const benefits = [
  {
    icon: '✨',
    title: 'Instant Beautification',
    desc: 'Transform messy or minified CSS into clean, readable code with proper indentation.',
  },
  {
    icon: '🗜️',
    title: 'CSS Minification',
    desc: 'Compress your CSS to remove whitespace and comments, creating smaller files for production.',
  },
  {
    icon: '⚙️',
    title: 'Custom Indentation',
    desc: "Choose between 2 spaces, 4 spaces, or Tabs to match your project's exact coding style.",
  },
  {
    icon: '🔒',
    title: 'Secure & Local',
    desc: 'Your code is never uploaded. All formatting happens entirely in your browser.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Input CSS',
    desc: 'Paste your unformatted, messy, or minified CSS code into the input area.',
  },
  {
    num: '2',
    title: 'Select Preferences',
    desc: 'Choose your preferred indentation style (2 spaces, 4 spaces, or tabs) from the dropdown.',
  },
  {
    num: '3',
    title: 'Format or Minify',
    desc: 'Click Format to beautify the code, or Minify to compress it for production use.',
  },
  {
    num: '4',
    title: 'Copy Result',
    desc: 'Review the formatted CSS in the result box and click Copy Result to use it in your project.',
  },
];

const useCases = [
  {
    icon: '🐛',
    title: 'Debugging',
    desc: 'Un-minify third-party or compiled CSS files to read and debug the styles effectively.',
  },
  {
    icon: '🚀',
    title: 'Production Build',
    desc: 'Quickly minify your development CSS to reduce file size and improve website loading speed.',
  },
  {
    icon: '🧹',
    title: 'Code Cleanup',
    desc: 'Standardize the formatting of legacy CSS files before committing them to your repository.',
  },
];
---

<MainLayout
  title="CSS Formatter & Beautifier — Free Online | NumanX"
  description="Format and beautify your CSS code with proper indentation. Minify CSS for production. Free online CSS formatter."
  keywords="css formatter, css beautifier, css minifier, format css, css indentation"
  toolSchema={cssSchema}
  faq={faqItems}
  howto={{
    name: 'How to Use CSS Formatter',
    description: 'Step-by-step guide for using CSS Formatter.',
    steps: [],
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'CSS Formatter', url: '/tools/css-formatter/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="CSS"
        gradient="Formatter Pro"
        desc="Format and beautify your CSS code with proper indentation. Minify CSS for production use."
        badge="✦ New Tool"
        slug="css-formatter"
      />
      <ShareBar />
      <div class="max-w-xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6 relative">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
              <span id="usage-badge" class="text-xs text-muted"></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex gap-1">
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="purple"
                  style="background:#a855f7"
                  aria-label="Purple theme accent"
                  title="Purple theme accent"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="blue"
                  style="background:#3b82f6"
                  aria-label="Blue theme accent"
                  title="Blue theme accent"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="green"
                  style="background:#22c55e"
                  aria-label="Green theme accent"
                  title="Green theme accent"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="pink"
                  style="background:#ec4899"
                  aria-label="Pink theme accent"
                  title="Pink theme accent"></button>
              </div>
              <button
                id="fullscreen-btn"
                class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs"
                title="Fullscreen"
                aria-label="Fullscreen">⛶</button
              >
            </div>
          </div>
          <div class="flex items-center justify-between min-h-[32px] mb-2">
            <label for="input-text" class="text-xs font-semibold text-zinc-300">Input CSS</label>
            <div class="flex items-center gap-1.5">
              <div class="flex items-center gap-0.5 bg-surface-2 p-0.5 rounded-lg border border-surface">
                <button
                  type="button"
                  aria-label="Decrease font size"
                  class="font-dec px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                  >A−</button
                >
                <button
                  type="button"
                  aria-label="Increase font size"
                  class="font-inc px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                  >A+</button
                >
              </div>
              <span class="text-xs text-muted ml-2">Ctrl+Enter to process</span>
            </div>
          </div>
          <div class="flex h-[240px] rounded-xl bg-black/40 border border-surface focus-within:border-blue-500 focus-within:ring-1 focus-within:ring-blue-500 transition-all overflow-hidden relative">
            <div
              id="line-nums"
              class="w-12 shrink-0 h-full select-none overflow-hidden font-mono text-sm leading-6 text-right pr-3.5 py-3 text-zinc-500/80 bg-zinc-950/60 border-r border-white/5 whitespace-pre pointer-events-none tabular-nums"
              style="line-height: 24px; font-size: 14px;"
            >
              1
            </div>
            <textarea
              id="input-text"
              aria-label="CSS code input"
              class="flex-1 min-w-0 h-full bg-transparent text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 px-4 py-3 focus:outline-none font-mono resize-none border-0 overflow-y-auto"
              style="line-height: 24px; font-size: 14px;"
              placeholder="Paste your CSS code here..."></textarea>
          </div>
          <div id="reading-time" class="text-xs text-muted mt-2"></div>
          <div id="letter-freq" tabindex="0" role="region" aria-label="Character frequency breakdown" class="mt-2 flex flex-wrap gap-1.5 hidden"></div>
          <div class="flex flex-wrap gap-2 mt-4">
            <button
              id="format-btn"
              class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-blue-600 text-white">Format</button
            >
            <button
              id="minify-btn"
              class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary"
              >Minify</button
            >
            <select
              id="indent-size"
              aria-label="Indentation size"
              title="Indentation size"
              class="ml-auto bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5"
            >
              <option value="2">2 spaces</option>
              <option value="4">4 spaces</option>
              <option value="tab">Tabs</option>
            </select>
          </div>
          <div class="mt-6 pt-6 border-t border-surface">
            <label for="output-text" class="block text-xs font-semibold text-zinc-300 mb-2">Result</label>
            <textarea
              id="output-text"
              aria-label="Formatted CSS output"
              class="w-full h-[240px] px-4 py-3 rounded-xl border border-surface bg-black/40 text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 focus:outline-none resize-none font-mono overflow-y-auto"
              style="line-height: 24px; font-size: 14px;"
              readonly
              placeholder="Formatted CSS will appear here..."></textarea>
            <button
              id="copy-btn"
              class="mt-2 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              >Copy Result</button
            >
            <button
              id="share-btn"
              class="mt-2 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              title="Copy share link">🔗</button
            >
            <button
              id="download-btn"
              class="mt-2 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              >Download</button
            >
            <select
              id="export-format" aria-label="Export file format"
              class="mt-2 bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5"
            >
              <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option><option
                value="html">HTML</option
              >
            </select>
            <button
              id="clear-btn"
              class="mt-2 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              >Clear</button
            >
          </div>
        </div>
      </div>
      <ToolContentSections
        toolSlug="css-formatter"
        toolName="CSS Formatter"
        category="Developer Tools"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />
      <RelatedTools current="css-formatter" />
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span class="bg-gradient-to-r from-blue-400 to-cyan-500 bg-clip-text text-transparent"
            >Questions</span
          >
        </h2><Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>
<script>
  const input = document.getElementById('input-text');
  const output = document.getElementById('output-text');
  const copyBtn = document.getElementById('copy-btn');
  const formatBtn = document.getElementById('format-btn');
  const minifyBtn = document.getElementById('minify-btn');

  formatBtn.addEventListener('click', () => {
    const css = input.value;
    if (!css) {
      output.value = '';
      return;
    }
    output.value = formatCSS(css);
  });

  minifyBtn.addEventListener('click', () => {
    const css = input.value;
    if (!css) {
      output.value = '';
      return;
    }
    output.value = css
      .replace(/\/\*[\s\S]*?\*\//g, '')
      .replace(/\s*([{}:;,])\s*/g, '$1')
      .replace(/\s+/g, ' ')
      .replace(/;\s*}/g, '}')
      .trim();
  });

  function formatCSS(css) {
    const iVal = (document.getElementById('indent-size') as HTMLSelectElement)?.value || '2';
    const indentStr = iVal === 'tab' ? '\t' : ' '.repeat(parseInt(iVal));

    css = css.replace(/\/\*[\s\S]*?\*\//g, (m) => m.replace(/\n/g, '\n' + indentStr));
    css = css.replace(/\s*([{};])\s*/g, '$1').replace(/\s+/g, ' ');
    let indent = 0;
    const lines = [];
    for (const char of css) {
      if (char === '{') {
        lines.push(char);
        indent++;
        lines.push('\n' + indentStr.repeat(indent));
      } else if (char === '}') {
        indent--;
        lines.push('\n' + indentStr.repeat(indent) + char);
      } else if (char === ';') {
        lines.push(char + '\n' + indentStr.repeat(indent));
      } else {
        lines.push(char);
      }
    }
    return lines
      .join('')
      .replace(/\n\s*\n/g, '\n')
      .trim();
  }

  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }
  document.getElementById('download-btn')?.addEventListener('click', () => {
    if (!output.value) return;
    const fmt = (document.getElementById('export-format') as HTMLSelectElement)?.value || 'txt';
    const mimes = { txt: 'text/plain', json: 'application/json', csv: 'text/csv', html: 'text/html' };
    const content = fmt === 'json' ? JSON.stringify(output.value) : output.value;
    const blob = new Blob([content], { type: mimes[fmt] || 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'formatted.' + fmt;
    a.click();
    playPing();
    URL.revokeObjectURL(a.href);
  });
  document.getElementById('clear-btn')?.addEventListener('click', () => {
    input.value = '';
    output.value = '';
    playPing();
  });
  copyBtn.addEventListener('click', async () => {
    if (!output.value) return;
    await navigator.clipboard.writeText(output.value);
    playPing();
    if (window.__showToast) window.__showToast({ message: 'Copied!', variant: 'success' });
  });
  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('output-text');
    const t = o?.value || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof (window as any).__showToast === 'function')
      (window as any).__showToast({ message: 'Link copied!', variant: 'success' });
  });
  const updateEditorFontSize = (newSize: number) => {
    const clamped = Math.max(10, Math.min(24, newSize));
    const lineHeight = Math.round(clamped * 1.7);
    document.querySelectorAll('textarea').forEach((t) => {
      t.style.fontSize = clamped + 'px';
      t.style.lineHeight = lineHeight + 'px';
    });
    const lineNums = document.getElementById('line-nums');
    if (lineNums) {
      lineNums.style.fontSize = clamped + 'px';
      lineNums.style.lineHeight = lineHeight + 'px';
    }
    try {
      localStorage.setItem('nt_fs', String(clamped));
    } catch (e) {}
  };

  document.querySelector('.font-inc')?.addEventListener('click', () => {
    const ta = document.getElementById('input-text');
    const s = parseInt(getComputedStyle(ta as HTMLElement).fontSize) || 14;
    updateEditorFontSize(s + 2);
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    const ta = document.getElementById('input-text');
    const s = parseInt(getComputedStyle(ta as HTMLElement).fontSize) || 14;
    updateEditorFontSize(s - 2);
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) updateEditorFontSize(parseInt(s));
  } catch (e) {}
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b = document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      document.getElementById('clear-btn')?.click();
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['css']) b.textContent = 'Used ' + u['css'] + '×';
  } catch (e) {}
  const rt = document.getElementById('input-text');
  if (rt) {
    rt.addEventListener('input', () => {
      const w = rt.value ? rt.value.trim().split(/\s+/).length : 0;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent =
          Math.max(1, Math.round(w / 200)) + ' min read · ' + Math.max(1, Math.round(w / 150)) + ' min speak';
    });
    rt.dispatchEvent(new Event('input'));
  }
  const li = document.getElementById('input-text');
  if (li) {
    const ul = () => {
      const n = document.getElementById('line-nums');
      if (n) n.textContent = Array.from({ length: li.value.split('\n').length }, (_, i) => i + 1).join('\n');
    };
    li.addEventListener('input', ul);
    li.addEventListener('scroll', () => {
      const n = document.getElementById('line-nums');
      if (n) n.scrollTop = li.scrollTop;
    });
    ul();
  }
  const lf = document.getElementById('input-text');
  if (lf) {
    lf.addEventListener('input', () => {
      const t = lf.value.toLowerCase().replace(/[^a-z]/g, '');
      if (!t) {
        document.getElementById('letter-freq')?.classList.add('hidden');
        return;
      }
      const f = {};
      for (const c of t) f[c] = (f[c] || 0) + 1;
      const s = Object.entries(f)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8);
      const m = s[0] ? s[0][1] : 1;
      const el = document.getElementById('letter-freq');
      el.classList.remove('hidden');
      el.innerHTML = s
        .map(
          ([c, n]) =>
            `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-xs font-mono"><strong class="text-purple-400 uppercase">${c}</strong><span class="text-zinc-400">${n}</span></span>`,
        )
        .join('');
    });
  }
  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      document.querySelectorAll("button[class*='bg-blue'],button[class*='bg-cyan']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(blue|cyan)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(blue|cyan)-\d+/g, 'hover:bg-' + c + '-500');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}
</script>
