// FEATURE 3: COPY MESSAGE
// 
function handleCopy(e) {
  const btn = e.target.closest(".msg-copy-btn");
  if (!btn) return;
  const text = btn.getAttribute("data-msg-text");
  if (!text) return;
  navigator.clipboard.writeText(text).then(function() {
    const orig = btn.innerHTML;
    btn.innerHTML = "Copied!";
    btn.style.fontSize = "8px";
    btn.style.padding = "1px 3px";
    setTimeout(function() { btn.innerHTML = orig; btn.style.fontSize = ""; btn.style.padding = ""; }, 1500);
  }).catch(function() {});
}

// 
// FEATURE 4: EXPORT CONVERSATION
// 
function exportConversation(format) {
  const items = containers.messages.querySelectorAll(".flex.items-start.gap-2\\.5");
  const msgs = [];
  items.forEach(function(el) {
    const isUser = el.classList.contains("flex-row-reverse");
    const bubble = el.querySelector("[data-msg-index]");
    const tsEl = bubble?.querySelector(".block.text-\\[9px\\]");
    const contentEl = el.querySelector(".msg-content, .text-xs");
    const raw = contentEl?.textContent || "";
    const ts = tsEl?.textContent || "";
    msgs.push({ role: isUser ? "user" : "bot", text: raw.replace(/\s+/g, " ").trim(), ts: ts });
  });
  let output = "", filename = "", mime = "";
  if (format === "json") {
    output = JSON.stringify(msgs, null, 2);
    filename = "chat-export.json";
    mime = "application/json";
  } else if (format === "txt") {
    output = msgs.map(function(m) { return "[" + m.ts + "] " + m.role.toUpperCase() + ": " + m.text; }).join("\n\n");
    filename = "chat-export.txt";
    mime = "text/plain";
  } else if (format === "md") {
    output = "# Chat Export\n\n" + msgs.map(function(m) {
      return "### " + (m.role === "user" ? "You" : "NumanX AI") + " (" + m.ts + ")\n\n" + m.text;
    }).join("\n\n---\n\n");
    filename = "chat-export.md";
    mime = "text/markdown";
  }
  const blob = new Blob([output], { type: mime });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = filename; a.click();
  URL.revokeObjectURL(url);
}

// 
// FEATURE 7: CHAT STATISTICS
// 
function execStats() {
  const items = containers.messages.querySelectorAll(".flex.items-start.gap-2\\.5");
  let userCount = 0, botCount = 0;
  items.forEach(function(el) {
    if (el.classList.contains("flex-row-reverse")) userCount++;
    else botCount++;
  });
  const now = new Date();
  const timeStr = now.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
  const commands = new Set();
  items.forEach(function(el) {
    const text = el.textContent?.toLowerCase().trim() || "";
    if (text.startsWith("calc") || text.startsWith("hash") || text.startsWith("color") || text.startsWith("bmi") || text.startsWith("roll") || text.startsWith("random") || text.startsWith("convert") || text.startsWith("encode") || text.startsWith("decode") || text.startsWith("rot13") || text.startsWith("reverse") || text.startsWith("sort") || text.startsWith("shuffle") || text.startsWith("dedupe") || text.startsWith("freq") || text.startsWith("spell") || text.startsWith("roman") || text.startsWith("timestamp") || text.startsWith("timer") || text.startsWith("password") || text.startsWith("pin") || text.startsWith("uuid") || text.startsWith("slug") || text.startsWith("ascii") || text.startsWith("char") || text.startsWith("prime") || text.startsWith("fib") || text.startsWith("day") || text.startsWith("leap") || text.startsWith("quote") || text.startsWith("lottery") || text.startsWith("morse") || text.startsWith("text to binary") || text.startsWith("binary to") || text.startsWith("count words") || text.startsWith("summarize") || text.startsWith("grammar") || text.startsWith("strength") || text.startsWith("check password") || text.startsWith("morse")) {
      commands.add(text.split(/\s/)[0]);
    }
  });
  return "**Chat Statistics:**\n- **Total messages:** " + (userCount + botCount) + "\n- **Your messages:** " + userCount + "\n- **Bot responses:** " + botCount + "\n- **Last activity:** " + timeStr + "\n- **Different commands used:** ~" + commands.size;
}

// 
// FEATURE 8: USER NAME MEMORY
// 
function askNameIfNeeded() {
  try {
    if (localStorage.getItem("nt_user_name")) return;
    const asked = parseInt(localStorage.getItem("nt_name_asked") || "0");
    if (asked >= 1) return;
    const items = containers.messages.querySelectorAll(".flex.items-start.gap-2\\.5");
    if (items.length >= 4) {
      localStorage.setItem("nt_name_asked", "1");
      setTimeout(function() { addMessage("By the way, what's your name? I'd love to personalize our chat!", false); }, 600);
    }
  } catch(e) {}
}

function getUserName() {
  try { return localStorage.getItem("nt_user_name") || null; } catch(e) { return null; }
}

// 
// FEATURE 9: CONVERSATION SEARCH
// 
let searchOpen = false;
let searchMatchIndex = -1;
let searchMatches = [];
function toggleSearch() {
  searchOpen = !searchOpen;
  const bar = document.getElementById("search-bar");
  const input = document.getElementById("chat-search");
  if (searchOpen) {
    bar?.classList.remove("hidden");
    setTimeout(function() { input?.focus(); }, 100);
  } else {
    bar?.classList.add("hidden");
    clearSearch();
  }
}
function clearSearch() {
  searchMatches = [];
  searchMatchIndex = -1;
  const countEl = document.getElementById("search-count");
  if (countEl) countEl.textContent = "";
  document.querySelectorAll(".search-highlight").forEach(function(el) {
    el.classList.remove("search-highlight", "search-active");
  });
}
function doSearch(query) {
  clearSearch();
  if (!query.trim()) return;
  const bubbles = containers.messages.querySelectorAll("[data-msg-index] .msg-content");
  const lq = query.toLowerCase();
  bubbles.forEach(function(el) {
    const text = el.textContent?.toLowerCase() || "";
    if (text.includes(lq)) {
      el.classList.add("search-highlight");
      searchMatches.push(el);
    }
  });
  const countEl = document.getElementById("search-count");
  if (searchMatches.length > 0) {
    countEl.textContent = "Found " + searchMatches.length + " result" + (searchMatches.length > 1 ? "s" : "");
    searchMatchIndex = 0;
    highlightMatch(0);
  } else {
    countEl.textContent = "No matches";
  }
}
function highlightMatch(dir) {
  searchMatches.forEach(function(el) { el.classList.remove("search-active"); });
  if (searchMatches.length === 0) return;
  searchMatchIndex = (searchMatchIndex + dir + searchMatches.length) % searchMatches.length;
  const el = searchMatches[searchMatchIndex];
  el.classList.add("search-active");
  el.scrollIntoView({ behavior: "smooth", block: "center" });
}

// 
// FEATURE 10: EDIT & RESEND
// 
function handleMessageClick(e) {
  const bubble = e.target.closest("[data-msg-index]");
  if (!bubble) return;
  const parent = bubble.parentElement;
  if (!parent?.classList.contains("flex-row-reverse")) return;
  const contentEl = bubble.querySelector(".msg-content, .text-xs");
  const text = contentEl?.textContent?.replace(/\s*\(edited\)\s*$/, "").trim();
  if (!text) return;
  containers.input.value = text;
  containers.input.focus();
  if (!bubble.querySelector(".edited-indicator")) {
    const indicator = document.createElement("span");
    indicator.className = "edited-indicator text-[8px] text-muted ml-1";
    indicator.textContent = "(edited)";
    contentEl?.appendChild(indicator);
  }
}

