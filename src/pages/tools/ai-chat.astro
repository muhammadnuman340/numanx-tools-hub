  for (const w of wordArr) {
    const clean = w.replace(/[^a-zA-Z]/g, "").toLowerCase();
    if (clean.length > 1 && misspellings[clean]) errors.push({ word: w, suggestion: misspellings[clean], type: "Spelling" });
