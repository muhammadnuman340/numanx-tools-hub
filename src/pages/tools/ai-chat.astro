function formatTimestamp() {
  const d = new Date();
  let h = d.getHours(), m = d.getMinutes();
  const ampm = h >= 12 ? "PM" : "AM";
  if (h === 0) h = 12;
  else if (h > 12) h -= 12;
  return String(h).padStart(2, "0") + ":" + String(m).padStart(2, "0") + " " + ampm;
}

function markdownToHtml(text) {
  let content = text;
  // Fenced code blocks (must be first)
  content = content.replace(/```(\w*)\n?([\s\S]*?)```/g, function(m, lang, code) {
    var cls = "text-[10px] leading-relaxed text-purple-300";
    if (lang) cls += " language-" + lang;
    return "<pre class=\"bg-surface-1 rounded-lg p-2.5 my-1.5 overflow-x-auto\"><code class=\"" + cls + "\">" + code + "</code></pre>";
  });
  content = content.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-violet-400 hover:underline">$1</a>');
  content = content.replace(/\*\*([^*]+)\*\*/g, '<strong class="text-primary">$1</strong>');
  content = content.replace(/`([^`]+)`/g, '<code class="text-purple-300 bg-surface-1 px-1 py-0.5 rounded text-[10px]">$1</code>');
  // Horizontal rules
  content = content.replace(/^---$/gm, '<hr class="border-surface my-2">');
  // Blockquotes (already entity-encoded &gt; from escapeHtml)
  content = content.replace(/^&gt;\s+(.+)$/gm, '<blockquote class="border-l-2 border-violet-500/40 pl-2.5 italic text-muted my-1">$1</blockquote>');
  // Unordered lists
  content = content.replace(/^[\s]*[-*]\s+(.+)$/gm, '<li class="list-disc ml-4">$1</li>');
  content = content.replace(/(<li.*<\/li>\n?)+/g, '<ul class="my-1">$&</ul>');
  // Ordered lists
  content = content.replace(/^[\s]*\d+\.\s+(.+)$/gm, '<li class="list-decimal ml-4">$1</li>');
  content = content.replace(/(<li.*<\/li>\n?)+/g, function(m) {
    if (m.indexOf("list-disc") === -1) return '<ol class="my-1">' + m + '</ol>';
    return m;
  });
  // Headings
  content = content.replace(/^###\s+(.+)$/gm, '<h3 class="text-sm font-bold text-primary mt-2 mb-1">$1</h3>');
  content = content.replace(/^##\s+(.+)$/gm, '<h2 class="text-base font-bold text-primary mt-2 mb-1">$1</h2>');
  // Newlines
  content = content.replace(/\n/g, "<br>");
  return content;
}

function addMessage(html, isUser, savedTs) {
  const idx = msgIndex++;
  const now = savedTs || formatTimestamp();
  const div = document.createElement("div");
  div.className = "flex items-start gap-2.5 " + (isUser ? "flex-row-reverse" : "");

  const avatar = isUser
    ? `<div class="w-7 h-7 rounded-lg bg-violet-500/20 flex items-center justify-center shrink-0 mt-0.5"><svg class="w-3.5 h-3.5 text-violet-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>`
    : `<div class="w-7 h-7 rounded-lg bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center shrink-0 mt-0.5"><svg class="w-3.5 h-3.5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>`;

  const bubbleClass = isUser
    ? "bg-violet-500/10 border border-violet-500/20 rounded-xl rounded-tr-none"
    : "bg-surface-2 rounded-xl rounded-tl-none";

  let content = markdownToHtml(html);

  const copyBtn = `<button class="msg-copy-btn absolute top-1 right-1 opacity-0 group-hover:opacity-100 transition-opacity p-0.5 rounded hover:bg-surface-1 text-muted hover:text-white" data-msg-text="${escapeAttr(html)}" title="Copy message"><svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button>`;

  const ttsBtn = !isUser ? `<button class="msg-tts-btn absolute top-1 right-9 opacity-0 group-hover:opacity-100 transition-opacity p-0.5 rounded hover:bg-surface-1 text-muted hover:text-white" data-tts="${escapeAttr(html)}" title="Read aloud"><svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg></button>` : "";

  div.innerHTML = avatar + `<div class="${bubbleClass} px-3 py-2 max-w-[85%] ${isUser ? "" : "w-full"} relative group" data-msg-index="${idx}">
    <span class="block text-[9px] text-muted/50 text-right mb-0.5">${now}</span>
    <div class="text-xs text-secondary leading-relaxed ${isUser ? "text-primary" : ""} msg-content">${content}</div>
    ${copyBtn}${ttsBtn}
  </div>`;

  containers.messages.appendChild(div);
  containers.messages.scrollTo({ top: containers.messages.scrollHeight, behavior: "smooth" });
  return idx;
}

function showTyping(show) {
  containers.typing.classList.toggle("hidden", !show);
  if (show) containers.messages.scrollTo({ top: containers.messages.scrollHeight, behavior: "smooth" });
}

function fallbackSearch(text) {
  const lq = text.toLowerCase();
  const words = lq.split(/\s+/).filter(w => w.length > 2);
  const found = allTools.filter(t => {
    const n = (t.name + " " + t.desc + " " + t.cat + " " + t.keywords.join(" ")).toLowerCase();
    return words.some(w => n.includes(w));
  }).slice(0, 3);
  if (found.length > 0) {
    addMessage("I found some related tools:\n" + found.map(t => "- **[" + t.name + "](" + t.url + ")** (" + t.cat + "): " + t.desc).join("\n"), false);
  } else {
    addMessage("I didn't understand that. Try one of these:\n `calculate 2+3*4`\n `hash: hello`\n `color #ff8800`\n `bmi 70 kg 175 cm`\n `slug: Hello World`\n `text to binary: hello`\n `ascii A`\n `roll d20`\n `strength: MyP@ss`\n `fibonacci 10`\n `prime 17`\n `day 2026-06-04`\n `leap 2024`\n `quote`\n `lottery`\n `convert 255 to binary`\n `rot13: hello`\n `sort: banana, apple, cherry`\n `frequency: hello world`\n `spell 1234`\n `days until 2026-12-31`\n `timer 5 seconds`\n `palindrome: racecar`\n `count words in ...`\n `format json: ...`\n `encode base64: hello`\n `generate password 16`\n `what tools do you have?`", false);
  }
}

function handleSend(e) {
  e?.preventDefault();
  const text = containers.input.value.trim();
  if (!text) return;

  addMessage(escapeHtml(text), true);
  containers.input.value = "";
  containers.sendBtn.disabled = true;
  showTyping(true);

  setTimeout(() => {
    const result = processCommand(text);
    showTyping(false);
    if (result && typeof result.then === "function") {
      result.then(r => { showTyping(false); if (r) addMessage(r, false); else fallbackSearch(text); containers.sendBtn.disabled = false; containers.input.focus(); saveHistory(); });
      return;
    }
    if (result) {
      addMessage(result, false);
    } else {
      fallbackSearch(text);
    }
    containers.sendBtn.disabled = false;
    containers.input.focus();
    saveHistory();
    askNameIfNeeded();
  }, 400 + Math.random() * 400);
}

function saveHistory() {
  try {
    const items = containers.messages.querySelectorAll(".flex.items-start.gap-2\\.5");
    const history = [];
    items.forEach(el => {
      const isUser = el.classList.contains("flex-row-reverse");
      const bubble = el.querySelector("[data-msg-index]");
      const contentEl = el.querySelector(".msg-content, .text-xs");
      const content = contentEl?.innerHTML || "";
      const ts = bubble?.querySelector(".block.text-\\[9px\\]")?.textContent || formatTimestamp();
      history.push({ role: isUser ? "user" : "bot", content, ts });
    });
    localStorage.setItem(H_KEY, JSON.stringify(history.slice(-MAX_HISTORY)));
  } catch (e) {}
}

function loadHistory() {
  try {
    const saved = localStorage.getItem(H_KEY);
    if (!saved) return;
    const history = JSON.parse(saved);
    if (!Array.isArray(history) || history.length === 0) return;
    // Clear welcome message
    containers.messages.innerHTML = "";
    for (const msg of history) {
      addMessage(msg.content, msg.role === "user", msg.ts || "");
    }
  } catch (e) {}
}

function clearChat() {
  if (!confirm("Clear the entire conversation?")) return;
  containers.messages.innerHTML = "";
  msgIndex = 0;
  var userName = getUserName();
  var welcomeText = userName ? "Hey " + userName + "! I'm your NumanX AI assistant. I can answer questions about tools, help with text tasks, and guide you. Try some examples below!" : "Hi! I'm your NumanX AI assistant. I can answer questions about tools, help with text tasks, and guide you. Try some examples below!";
  addMessage(welcomeText, false);
  try { localStorage.removeItem(H_KEY); } catch (e) {}
  playPing();
  if (window.__showToast) window.__showToast({ message: "Conversation cleared", variant: "info" });
}

// 
// FEATURE 1: VOICE INPUT
// 
let isListening = false;
let recognition = null;
function initSpeechRecognition() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) return;
  recognition = new SR();
  recognition.continuous = false;
  recognition.interimResults = false;
  recognition.lang = "en-US";
  recognition.onresult = function(e) {
    const transcript = e.results[0][0].transcript;
    containers.input.value = transcript;
    stopListening();
    handleSend();
  };
  recognition.onerror = function() { stopListening(); };
  recognition.onend = function() { stopListening(); };
}
function toggleListening() {
  if (!recognition) return;
  if (isListening) { stopListening(); return; }
  try { recognition.start(); isListening = true; updateVoiceBtn(); } catch(e) { stopListening(); }
}
function stopListening() {
  isListening = false;
  updateVoiceBtn();
  try { if (recognition) recognition.stop(); } catch(e) {}
}
function updateVoiceBtn() {
  const btn = document.getElementById("voice-btn");
  if (!btn) return;
  btn.classList.toggle("listening", isListening);
  btn.innerHTML = isListening
    ? '<span class="voice-dot"></span>'
    : '<svg class="voice-icon w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/></svg>';
}
initSpeechRecognition();

// 
// FEATURE 2: TEXT-TO-SPEECH
// 
function handleTts(e) {
  const btn = e.target.closest(".msg-tts-btn");
  if (!btn) return;
  const text = btn.getAttribute("data-tts");
  if (!text) return;
  window.speechSynthesis.cancel();
  const utter = new SpeechSynthesisUtterance(text.replace(/<[^>]*>/g, ""));
  utter.rate = 0.9;
  window.speechSynthesis.speak(utter);
}

