    if (mx === r2) h = ((g2-b2)/d + (g2 < b2 ? 6 : 0)) / 6;
    else if (mx === g2) h = ((b2-r2)/d + 2) / 6;
    else h = ((r2-g2)/d + 4) / 6;
  }
  return "**Color:** `#" + hex.toUpperCase() + "`\n**RGB:** rgb(" + r + "," + g + "," + b + ")\n**HSL:** hsl(" + Math.round(h*360) + ", " + Math.round(s*100) + "%, " + Math.round(l*100) + "%)";
}

// -- BMI Calculator --
function execBmi(weight, wUnit, height, hUnit) {
  let kg = weight, cm = height;
  if (wUnit.startsWith("lb")) kg = weight * 0.453592;
  if (hUnit.includes("ft") || hUnit.includes("in")) {
    const hm = height.match(/(\d+)ft\s*(\d+)?/i);
    if (hm) cm = (parseInt(hm[1]) * 30.48 + (parseInt(hm[2]||0) * 2.54));
    else cm = height * 30.48;
  }
  cm = cm || height;
  const m = cm / 100;
  const bmi = kg / (m * m);
  if (!isFinite(bmi)) return null;
  let cat;
  if (bmi < 18.5) cat = "Underweight";
  else if (bmi < 25) cat = "Normal weight";
  else if (bmi < 30) cat = "Overweight";
  else if (bmi < 35) cat = "Obese Class I";
  else if (bmi < 40) cat = "Obese Class II";
  else cat = "Obese Class III";
  return "**BMI:** " + bmi.toFixed(1) + " \u2014 *" + cat + "*\n**Weight:** " + kg.toFixed(1) + " kg | **Height:** " + cm.toFixed(1) + " cm";
}

// -- Slug Generator --
function execSlug(text) {
  return text.toLowerCase().trim().replace(/[^\w\s-]/g, "").replace(/[\s_]+/g, "-").replace(/^-+|-+$/g, "");
}

// -- Binary/Text Conversion --
function execTextToBinary(text) {
  return text.split("").map(c => c.charCodeAt(0).toString(2).padStart(8,"0")).join(" ");
}
function execBinaryToText(bin) {
  return bin.trim().split(/\s+/).map(b => String.fromCharCode(parseInt(b, 2))).join("");
}

// -- ASCII Lookup --
function execAscii(ch) {
  if (ch.length === 1) return "**`" + ch + "`**  Decimal: **" + ch.charCodeAt(0) + "** | Hex: **" + ch.charCodeAt(0).toString(16).toUpperCase() + "** | Binary: **" + ch.charCodeAt(0).toString(2) + "**";
  return null;
}
function execCharCode(code) {
  const n = parseInt(code);
  if (isNaN(n) || n < 0 || n > 0x10FFFF) return null;
  return "**" + n + "**  Character: **`" + String.fromCodePoint(n) + "`**" + (n < 17 ? " | Hex: **" + n.toString(16).toUpperCase() + "**" : "");
}

// -- Dice Roller --
function execDice(roll) {
  const m = roll.match(/^(\d+)?d(\d+)(?:\s*([+-])\s*(\d+))?$/i);
  if (!m) return null;
  const count = parseInt(m[1] || 1);
  const sides = parseInt(m[2]);
  const modSign = m[3];
  const modVal = parseInt(m[4] || 0);
  if (count < 1 || count > 100 || sides < 2 || sides > 1000) return null;
  const rolls = [];
  let total = 0;
  for (let i = 0; i < count; i++) {
    const r = Math.floor(Math.random() * sides) + 1;
    rolls.push(r); total += r;
  }
  const modTotal = modSign === "+" ? total + modVal : modSign === "-" ? total - modVal : total;
  let result = "\u{1F3B2} **Rolling " + roll + ":** " + rolls.join(", ");
  if (count > 1) result += " = " + total;
  if (modSign) result += " " + modSign + " " + modVal + " = **" + modTotal + "**";
  else result = "\u{1F3B2} **Result:** **" + total + "** (" + rolls.join(", ") + ")";
  return result;
}

// -- Password Strength Analyzer --
function execPasswordStrength(pwd) {
  if (!pwd) return null;
  let score = 0;
  const len = pwd.length;
  if (len >= 8) score += 1;
  if (len >= 12) score += 1;
  if (len >= 16) score += 1;
  if (/[a-z]/.test(pwd)) score += 1;
  if (/[A-Z]/.test(pwd)) score += 1;
  if (/[0-9]/.test(pwd)) score += 1;
  if (/[^a-zA-Z0-9]/.test(pwd)) score += 1;
  const entropy = len > 0 ? Math.round(len * Math.log2(94)) : 0;
  const strength = score <= 2 ? "Weak" : score <= 4 ? "Fair" : score <= 6 ? "Strong" : "Very Strong";
  const color = score <= 2 ? "red" : score <= 4 ? "amber" : score <= 6 ? "lime" : "emerald";
  return "**Strength:** *" + strength + "* (" + score + "/7) | **Entropy:** ~" + entropy + " bits | **Length:** " + len + " chars" + (entropy >= 60 ? " \u2705" : entropy >= 40 ? " \u26A0\uFE0F" : " \u274C");
}

// -- Fibonacci --
function execFibonacci(n) {
  const count = parseInt(n);
  if (isNaN(count) || count < 1 || count > 100) return null;
  const seq = [0, 1];
  for (let i = 2; i < count; i++) seq.push(seq[i-1] + seq[i-2]);
  return "**Fibonacci (" + count + "):** " + seq.slice(0, count).join(", ");
}

// -- Prime Checker --
function execPrimeCheck(n) {
  const num = parseInt(n);
  if (isNaN(num) || num < 1) return null;
  if (num <= 3) return "**" + num + "** is **prime** ";
  if (num % 2 === 0 || num % 3 === 0) {
    const factors = [];
    let rem = num;
    for (let i = 2; i * i <= rem; i++) { while (rem % i === 0) { factors.push(i); rem /= i; } }
    if (rem > 1) factors.push(rem);
    return "**" + num + "** is **not prime** \n**Factors:** " + factors.join("  ");
  }
  for (let i = 5; i * i <= num; i += 6) { if (num % i === 0 || num % (i+2) === 0) return "**" + num + "** is **not prime** "; }
  return "**" + num + "** is **prime** ";
}

// -- Date Info --
function execDayOfWeek(dateStr) {
  const d = new Date(dateStr);
  if (isNaN(d)) return null;
  const days = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
  return "**" + dateStr + "** is a **" + days[d.getDay()] + "**";
}
function execLeapYear(year) {
  const y = parseInt(year);
  if (isNaN(y)) return null;
  const leap = (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
  return "**" + y + "** is " + (leap ? "" : "**not** ") + "a leap year " + (leap ? " (366 days)" : " (365 days)");
}

