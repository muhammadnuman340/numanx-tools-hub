// -- Lottery Numbers --
function execLottery(count, max) {
  const c = count || 6, m = max || 49;
  const nums = new Set();
  while (nums.size < Math.min(c, m)) nums.add(Math.floor(Math.random() * m) + 1);
  return "\u{1F3B1} **Lottery numbers (" + c + "/" + m + "):** " + [...nums].sort((a,b) => a-b).join("  ");
}

// 
// COMMAND PARSER
// 

function processCommand(text) {
  const q = text.trim();
  const lq = q.toLowerCase();

  // Greetings
  if (/^(hi|hello|hey|howdy|sup|yo|good morning|good evening|good afternoon)[.!]*$/i.test(lq)) {
    const userName = getUserName();
    const greetings = [
      userName ? "Hey " + userName + "! How can I help you today?" : "Hello! How can I help you today? Try asking about tools or giving me a command!",
      userName ? "Hi " + userName + "! I'm your NumanX AI assistant. What can I do for you?" : "Hi there! I'm your NumanX AI assistant. What can I do for you?",
      userName ? "Welcome back, " + userName + "! Ready to help. Try a command like `count words in ...` or ask about a tool." : "Hey! Ready to help. Try a command like `count words in ...` or ask about a tool.",
    ];
    return greetings[Math.floor(Math.random() * greetings.length)];
  }

  if (/^(thanks|thank you|thx|ty)[.!]*$/i.test(lq)) {
    return "You're welcome! Let me know what else you need.";
  }

  if (/^(bye|goodbye|see you|cya)[.!]*$/i.test(lq)) {
    return "Goodbye! Feel free to come back anytime you need help.";
  }

  // Tool counts
  if (/how many tools/.test(lq)) {
    catCounts(allTools);
    return "We have **" + allTools.length + " tools** across 6 categories. Try asking about a specific category!";
  }
  if (/how many categories/.test(lq)) {
    const cats = [...new Set(allTools.map(t => t.cat))];
    return "There are **" + cats.length + " categories** with " + allTools.length + " total tools.";
  }

  // What tools / list tools
  if (/what tools|list tools|show tools|all tools|what can you do/i.test(lq) && !/category|ai|image|utility|developer|creator|cricket/i.test(lq)) {
    const cats = [...new Set(allTools.map(t => t.cat))];
    let response = "Here are all **" + allTools.length + " tools** across " + cats.length + " categories:\n";
    for (const cat of cats) {
      const tools = allTools.filter(t => t.cat === cat);
      response += "\n**" + cat + "** (" + tools.length + "): " + tools.map(t => "[" + t.name + "](" + t.url + ")").join(", ");
    }
    return response;
  }

  // By category
  const catMatch = lq.match(/(?:find|show|list|what)\s+(ai|image|utility|developer|creator|cricket)\s*(?:tools)?/);
  if (catMatch) {
    const catMap = { "ai": "AI Tools", "image": "Image Tools", "utility": "Utility Tools", "developer": "Developer Tools", "creator": "Creator Tools", "cricket": "Cricket Tools" };
    const cat = catMap[catMatch[1]];
    if (cat) {
      const tools = allTools.filter(t => t.cat === cat);
      return "**" + cat + "** (" + tools.length + " tools):\n" + tools.map(t => "- [" + t.name + "](" + t.url + "): " + t.desc).join("\n");
    }
  }

  // Tool info
  const toolInfo = lq.match(/^(?:what is|tell me about|info|about)\s+(.+)/i);
  if (toolInfo) {
    const query = toolInfo[1].toLowerCase();
    const found = allTools.filter(t => t.name.toLowerCase().includes(query) || t.keywords.some(k => query.includes(k))).slice(0, 3);
    if (found.length > 0) {
      return "Here's what I found:\n" + found.map(t => "- **[" + t.name + "](" + t.url + ")** (" + t.cat + "): " + t.desc).join("\n");
    }
  }

  // What's new
  if (/what'?s new|latest|recent/.test(lq)) {
    return "We recently added many new tools! Check out **AI Chat Assistant**, **Character Counter**, **BMI Calculator**, **SQL Formatter**, **JWT Decoder**, and more. Visit the [All Tools](/tools/) page to see everything.";
  }

  // Popular / best
  if (/popular|best|top|trending/.test(lq)) {
    return "Popular tools: **QR Generator**, **Image Compressor**, **Password Generator**, **AI Grammar Checker**, and **JSON Formatter**. Check them out!";
  }

  //  Commands with arguments 

  // Word count: "count words in <text>" or "word count <text>"
  let m = lq.match(/^(?:count\s+words|word\s+count)(?:\s+in|\s*:|\s+)(.+)/);
  if (m) return execWordCount(m[1]);

  // Summarize: "summarize: <text>" or "summarize <text>"
  m = lq.match(/^(?:summarize|summary)(?:\s*:|\s+)(.+)/);
  if (m) {
    const result = summarize(m[1], 30);
    return "**Summary:** " + result;
  }

  // Grammar: "check grammar: <text>" or "grammar: <text>"
  m = lq.match(/^(?:check\s+grammar|grammar)(?:\s*:|\s+)(.+)/);
  if (m) return checkGrammar(m[1]);

  // Case convert: "upper: <text>", "lower: <text>", etc
  const caseModes = { upper:"upper", lowercase:"lower", "lower case":"lower", lower:"lower", "title case":"title", title:"title", "sentence case":"sentence", sentence:"sentence" };
  for (const [key, mode] of Object.entries(caseModes)) {
    m = lq.match(new RegExp("^" + key.replace(/ /g, "\\s") + "(?:\\s*:|\\s+)(.+)"));
    if (m) return "**Result:** `" + execCaseConvert(m[1], mode) + "`";
  }

  // Base64 encode/decode
  m = lq.match(/^(?:encode\s+base64|base64\s+encode)(?:\s*:|\s+)(.+)/);
  if (m) return "**Base64 encoded:** `" + execBase64Encode(m[1]) + "`";
  m = lq.match(/^(?:decode\s+base64|base64\s+decode)(?:\s*:|\s+)(.+)/);
  if (m) {
    const result = execBase64Decode(m[1]);
    if (result.startsWith("Error")) return result;
    return "**Base64 decoded:** `" + result + "`";
  }

  // URL encode/decode
  m = lq.match(/^(?:encode\s+url|url\s+encode)(?:\s*:|\s+)(.+)/);
  if (m) return "**URL encoded:** `" + execUrlEncode(m[1]) + "`";
  m = lq.match(/^(?:decode\s+url|url\s+decode)(?:\s*:|\s+)(.+)/);
  if (m) {
    const result = execUrlDecode(m[1]);
    if (result.startsWith("Error")) return result;
    return "**URL decoded:** `" + result + "`";
  }

  // JSON format: "format json: <json>" or "json: <json>"
  m = lq.match(/^(?:format|beautify)\s+json(?:\s*:|\s+)(.+)/);
  if (m) return execJsonFormat(m[1]);
  m = lq.match(/^(?:validate|check)\s+json(?:\s*:|\s+)(.+)/);
  if (m) { try { JSON.parse(m[1]); return "\u2713 **Valid JSON**"; } catch (e) { return "\u2717 **Invalid JSON:** " + e.message; } }

  // Password: "generate password [length]" / "password [length]" / "pin [length]"
  m = lq.match(/^(?:generate\s+)?password(?:\s*:|\s+)?(\d+)?(?:\s+(random|pronounceable|passphrase|pin))?/);
  if (m) return "**Generated password:** `" + execPassword(+(m[1] || 16), m[2] || "random") + "`";
  m = lq.match(/^pin(?:\s*:|\s+)?(\d+)?/);
  if (m) return "**Generated PIN:** `" + execPassword(+(m[1] || 6), "pin") + "`";

  // UUID
  if (/^(?:generate\s+)?uuid/.test(lq)) return execUUID();

  // Random: "random [count]" / "random [min] [max]" / "roll dice"
  m = lq.match(/^random(?:\s+(\d+))?(?:\s+(\d+)(?:\s*[-to]+\s*(\d+))?)?/);
  if (m) {
    if (m[2] && m[3]) return execRandom(+m[2], +m[3], +(m[1] || 1));
    if (m[2]) return execRandom(0, +m[2], +(m[1] || 1));
    if (m[1]) return execRandom(1, 100, +m[1]);
    return execRandom(1, 100, 1);
  }
  if (/^roll dice|^dice\b/.test(lq)) return execRandom(1, 6, 1);

  // Percentage: "X% of Y" / "X is what % of Y" / "percentage change X to Y"
  m = q.match(/^(\d+\.?\d*)\s*%\s*of\s*(\d+\.?\d*)/);
  if (m) return "**" + m[1] + "% of " + m[2] + "** = **" + execPctOf(+m[1], +m[2]).toFixed(2) + "**";
  m = q.match(/^(\d+\.?\d*)\s+is\s+what\s+%\s+of\s+(\d+\.?\d*)/);
  if (m) return "**" + m[1] + " is " + execPctIs(+m[1], +m[2]).toFixed(2) + "% of " + m[2] + "**";
  m = q.match(/^(?:percentage|pct)\s+change\s+(\d+\.?\d*)\s+to\s+(\d+\.?\d*)/);
  if (m) { const r = execPctChange(+m[1], +m[2]); return "**" + m[1] + "  " + m[2] + ":** " + (r >= 0 ? "+" : "") + r.toFixed(2) + "% change"; }

  // Unit conversion: "convert X [from] to [to]" / "X [from] in [to]"
  m = q.match(/^(?:convert\s+)?(\d+\.?\d*)\s+(.+?)\s+(?:to|in)\s+(.+)/);
  if (m) {
    const result = execConvert(+m[1], m[2].trim(), m[3].trim());
    if (result) return result;
  }

  //  Math: "calculate 2+3*4" or "calc 2+3*4" or "eval 2+3*4"
  m = lq.match(/^(?:calculate|calc|eval|math|what is|what's)\s+(.+)/);
  if (m) { const r = execMath(m[1]); if (r) return r; }

  //  Number base: "convert 255 to binary" / "255 in binary" / "FF in decimal"
  m = lq.match(/(?:convert\s+)?([0-9a-fA-F]+)\s+(?:to|in)\s+(binary|decimal|hex(?:adecimal)?|octal|base[\s-]?\d+)/);
  if (m) {
    for (const base of ["binary","decimal","hex","hexadecimal","octal"]) {
      if (lq.includes(base)) {
        const from = /^[0-9a-fA-F]+$/.test(m[1]) && /[a-fA-F]/.test(m[1]) ? "hex" : "decimal";
        const r = execBaseConvert(m[1], from, base);
        if (r) return r;
      }
    }
  }
  m = lq.match(/^(\d+)\s+(?:in|to)\s+(binary|decimal|hex(?:adecimal)?|octal|base[\s-]?\d+)/);
  if (m) { const r = execBaseConvert(m[1], "decimal", m[2]); if (r) return r; }
  m = lq.match(/^([0-9a-fA-F]+)\s+(?:in|to)\s+(decimal|binary|octal)/);
  if (m) { const r = execBaseConvert(m[1], "hex", m[2]); if (r) return r; }

  //  Date: "days between 2026-01-01 and 2026-06-04" / "days until 2026-12-31" / "add 30 days to 2026-06-04"
  m = lq.match(/^(?:days?|weeks?)\s+between\s+(\d{4}[-/]\d{1,2}[-/]\d{1,2})\s+(?:and|to)\s+(\d{4}[-/]\d{1,2}[-/]\d{1,2})/);
  if (m) { const r = execDateDiff(m[1], m[2]); if (r) return r; }
  m = lq.match(/^(?:days?|weeks?)\s+until\s+(\d{4}[-/]\d{1,2}[-/]\d{1,2})/);
  if (m) { const r = execDaysUntil(m[1]); if (r) return r; }
  m = lq.match(/^(?:add|plus)\s+(\d+)\s+(days?|weeks?)\s+(?:to|until|from)\s+(\d{4}[-/]\d{1,2}[-/]\d{1,2})/);
  if (m) { const mult = m[2].startsWith("week") ? 7 : 1; const r = execAddDays(m[3], +m[1] * mult); if (r) return r; }

  //  Text transformations: "rot13: hello" / "reverse: hello" / "palindrome: racecar"
  m = lq.match(/^rot[\s-]?13(?:\s*:|\s+)(.+)/);
  if (m) return "**ROT13:** `" + execRot13(m[1]) + "`";
  m = lq.match(/^(?:reverse|rev)(?:\s*:|\s+)(.+)/);
  if (m) return "**Reversed:** `" + execReverse(m[1]) + "`";
  if (/^(?:is\s+)?palindrome|palindrome check/i.test(lq)) {
    m = lq.match(/palindrome(?:\s*:|\s+)?(.+)/) || lq.match(/(?:is\s+)?(.+?)\s+a palindrome/);
    if (m) return execPalindrome(m[1]);
  }

  //  Morse: "morse encode: hello" / "morse decode: .... . .-.. .-.. ---"
  m = lq.match(/^morse\s+(?:encode|enc)(?:\s*:|\s+)(.+)/);
  if (m) { const r = execMorseEncode(m[1]); if (r) return "**Morse:** `" + r + "`"; }
  m = lq.match(/^morse\s+(?:decode|dec)(?:\s*:|\s+)(.+)/);
  if (m) { const r = execMorseDecode(m[1]); if (r) return "**Decoded:** `" + r + "`"; }
  if (/^morse\b/.test(lq) || /encode to morse/.test(lq)) {
    m = lq.match(/^morse(?:\s*:|\s+)(.+)/);
    if (m) { const r = execMorseEncode(m[1]); if (r) return "**Morse:** `" + r + "`"; }
  }

  //  List ops: "sort: a, b, c" / "reverse: a, b, c" / "shuffle: a, b, c" / "dedupe: a, b, a"
  m = lq.match(/^(?:sort|order)(?:\s*:|\s+)(.+)/);
  if (m) { const r = execListSort(m[1]); if (r) return r; }
  m = lq.match(/^reverse(?:\s*:|\s+)(.+)/);
  if (m) { if (m[1].includes(",")) { const r = execListReverse(m[1]); if (r) return r; } }
  m = lq.match(/^(?:shuffle|randomize)(?:\s*:|\s+)(.+)/);
  if (m) { const r = execListShuffle(m[1]); if (r) return r; }
  m = lq.match(/^(?:dedupe|unique|deduplicate)(?:\s*:|\s+)(.+)/);
  if (m) { const r = execListDedupe(m[1]); if (r) return r; }

  //  Frequency: "frequency: hello world" / "char frequency: hello" / "word frequency: the cat"
  m = lq.match(/^(?:char(?:acter)?\s+)?freq(?:uency)?(?:\s*:|\s+)(.+)/);
  if (m) { const r = execCharFreq(m[1]); if (r) return r; }
  m = lq.match(/^word\s+freq(?:uency)?(?:\s*:|\s+)(.+)/);
  if (m) { const r = execWordFreq(m[1]); if (r) return r; }

  //  Number formatting: "spell 1234" / "commas 1234567" / "roman 42" / "1234 in words"
  m = lq.match(/^(?:spell|number\s+in\s+words|words?)\s+(\d{1,12})/);
  if (m) { const r = execSpellNumber(m[1]); if (r) return r; }
  m = lq.match(/^(?:commas|format\s+number)\s+(\d+\.?\d*)/);
  if (m) { const r = execCommas(m[1]); if (r) return r; }
  m = lq.match(/^(?:roman|to roman)\s+(\d{1,4})/);
  if (m) { const r = execRoman(m[1]); if (r) return r; }
  m = lq.match(/^(\d{1,12})\s+in\s+(words?|roman)/);
  if (m) {
    if (m[2].startsWith("word")) { const r = execSpellNumber(m[1]); if (r) return r; }
    if (m[2].startsWith("roman")) { const r = execRoman(m[1]); if (r) return r; }
  }

  //  Time conversion: "timestamp 1717488000" / "convert 2:30 PM to 24h" / "convert 14:30 to 12h"
  m = lq.match(/^(?:timestamp|ts|unix)\s+(\d{8,10})/);
  if (m) { const r = execTimestamp(m[1]); if (r) return r; }
  m = q.match(/(\d{1,2}:\d{2}\s*(?:AM|PM))/i);
  if (m && (lq.includes("24h") || lq.includes("convert") || lq.includes("military"))) { const r = execTime12to24(m[1]); if (r) return r; }
  m = q.match(/(\d{1,2}:\d{2})(?!\s*(?:AM|PM))/i);
  if (m && (lq.includes("12h") || lq.includes("convert") || lq.includes("standard"))) { const r = execTime24to12(m[1]); if (r) return r; }

  //  Timer: "set timer 5 minutes" / "timer 30 seconds" / "timer 2 hours"
  m = lq.match(/^(?:set\s+)?timer(?:\s+for)?\s+(\d+)\s+(seconds?|secs?|s|minutes?|mins?|m|hours?|hrs?|h)\b/i);
  if (m) return execTimer(+m[1], m[2]);

  //  SHA-256 Hash: "hash: hello" / "hash sha256: hello"
  m = lq.match(/^hash(?:\s+sha[\s-]?256)?(?:\s*:|\s+)(.+)/);
  if (m) return execHash(m[1]); // async  handled specially below

  //  Color: "color #ff8800" / "color red to hsl" / "convert #ff0 to rgb"
  m = lq.match(/^color\s+(.+?)(?:\s+(?:to|in)\s+(rgb|hsl|hex))?$/i);
  if (m) { const r = execColorConv(m[1].trim()); if (r) return r; }
  m = lq.match(/^convert\s+(#[0-9a-f]{3,6}|[a-z]+)\s+(?:to|in)\s+(rgb|hsl|hex)/i);
  if (m) { const r = execColorConv(m[1].replace("#","")); if (r) return r; }

  //  BMI: "bmi 70 kg 175 cm" / "bmi 154 lb 5ft9"
  m = lq.match(/^bmi\s+(\d+\.?\d*)\s*(kg|kilo|lb|pounds?)?(?:.*?)(\d+\.?\d*)\s*(cm|m|meters?|ft|feet|foot|in|inches?|'|")?/i);
  if (m) { const r = execBmi(+m[1], m[2]||"kg", +m[3], m[4]||"cm"); if (r) return r; }

  //  Slug: "slug: Hello World!" / "slugify: Hello"
  m = lq.match(/^(?:slug|slugify)(?:\s*:|\s+)(.+)/);
  if (m) return "**Slug:** `" + execSlug(m[1]) + "`";

  //  Binary/Text: "text to binary: hello" / "binary to text: 01101000..."
  m = lq.match(/^(?:text|string)\s+(?:to|2|->)\s+binary(?:\s*:|\s+)(.+)/);
  if (m) return "**Binary:** `" + execTextToBinary(m[1]) + "`";
  m = lq.match(/^(?:binary|bin)\s+(?:to|2|->)\s+(?:text|string)(?:\s*:|\s+)(.+)/);
  if (m) { const r = execBinaryToText(m[1]); if (r) return "**Decoded:** `" + r + "`"; }

  //  ASCII: "ascii A" / "char 65" / "code 65"
  m = lq.match(/^ascii\s+(.)/);
  if (m) { const r = execAscii(m[1]); if (r) return r; }
  m = lq.match(/^(?:char|chr|code|character)\s+(\d+)/);
  if (m) { const r = execCharCode(m[1]); if (r) return r; }

  //  Dice: "roll d20" / "roll 3d6+2" / "dice 2d8"
  m = lq.match(/^(?:roll|dice|d)\s+(\d*d\d+(?:\s*[+-]\s*\d+)?)/i);
  if (m) { const r = execDice(m[1].replace(/\s/g, "")); if (r) return r; }
  m = lq.match(/^(\d*d\d+(?:\s*[+-]\s*\d+)?)$/i);
  if (m) { const r = execDice(m[1].replace(/\s/g, "")); if (r) return r; }

  //  Password strength: "strength: MyP@ss" / "check password: MyP@ss"
  m = lq.match(/^(?:strength|check\s+password|pwd\s+strength)(?:\s*:|\s+)(.+)/);
  if (m) return execPasswordStrength(m[1]);

  //  Fibonacci: "fibonacci 10" / "fib 10"
  m = lq.match(/^(?:fibonacci|fib)\s+(\d{1,3})/i);
  if (m) { const r = execFibonacci(m[1]); if (r) return r; }

  //  Prime: "prime 17" / "factors 12" / "is 17 prime"
  m = lq.match(/^(?:prime|is\s+prime|factors?)\s+(\d+)/i);
  if (m) { const r = execPrimeCheck(m[1]); if (r) return r; }
  if (/^is\s+\d+\s+prime/.test(lq)) {
    m = lq.match(/^is\s+(\d+)\s+prime/);
    if (m) { const r = execPrimeCheck(m[1]); if (r) return r; }
  }

  //  Date info: "day 2026-06-04" / "leap 2024" / "what day is 2026-06-04"
  m = lq.match(/^(?:day|weekday|what\s+day)\s+(\d{4}[-/]\d{1,2}[-/]\d{1,2})/i);
  if (m) { const r = execDayOfWeek(m[1]); if (r) return r; }
  m = lq.match(/^(?:is\s+)?(\d{4})\s+a\s+leap\s+year/);
  if (m) { const r = execLeapYear(m[1]); if (r) return r; }
  m = lq.match(/^(?:leap|leap\s+year)\s+(\d{4})/i);
  if (m) { const r = execLeapYear(m[1]); if (r) return r; }

  //  Quote: "quote" / "inspire me" / "random quote"
  if (/^(?:quote|inspire|inspire me|random quote|motivate|motivate me|wisdom)$/i.test(lq)) return execQuote();

  //  Lottery: "lottery" / "lotto 6/49" / "lotto numbers"
  m = lq.match(/^(?:lottery|lotto)\s*(?:\s+(\d+)(?:\s*\/\s*(\d+))?)?/i);
  if (m) return execLottery(m[1] ? +m[1] : 6, m[2] ? +m[2] : 49);

  // Name capture: "my name is X" / "i'm X" / "call me X"
  m = lq.match(/^(?:my name is|i am|i'm|call me)\s+(.+)/i);
  if (m) {
    const name = m[1].replace(/[.!]+$/, "").trim();
    if (name.length > 1 && name.length < 30) {
      try { localStorage.setItem("nt_user_name", name); } catch(e) {}
      context.userName = name;
      return "Nice to meet you, **" + escapeHtml(name) + "**! I'll remember your name for our chat.";
    }
  }

  // Stats command
  if (/^(?:stats?|statistics|chat stats?|conversation stats)/i.test(lq)) {
    return execStats();
  }

  // Tool search (fuzzy) — with inline execution when possible
  const searchTerms = lq.split(/\s+/).filter(w => w.length > 2 && !["the","what","how","can","you","tell","about","show","find","list","for","are","there","with","some","does","this","that","and","please","help"].includes(w));
  if (searchTerms.length > 0) {
    const found = allTools.filter(t => {
      const n = (t.name + " " + t.desc + " " + t.cat + " " + t.keywords.join(" ")).toLowerCase();
      return searchTerms.some(w => n.includes(w));
    }).slice(0, 5);
    if (found.length > 0) {
      // Try to execute the tool inline if we have a command mapping
      const bestTool = found[0];
      const cmd = toolCommands[bestTool.name.toLowerCase()];
      if (cmd !== undefined) {
        // Extract text after the tool mention
        const toolNames = [bestTool.name.toLowerCase()];
        const parts = lq.split(new RegExp("(" + toolNames.map(n => n.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|") + ")", "i"));
        const afterText = parts.length > 2 ? parts.slice(2).join("").trim() : "";
        // Also try extracting after "use", "run", "for"
        const extraText = afterText || lq.replace(/^(?:use|run|try|open|launch|start)\s+(?:the\s+)?/, "").replace(new RegExp("^" + bestTool.name.toLowerCase().replace(/[.*+?^${}()|[\]\\]/g, "\\$&")), "").replace(/^(?:\s*(?:for|on|with|to|about|using)\s*:?\s*)/, "").trim();
        if (extraText && extraText.length > 0 && extraText !== bestTool.name.toLowerCase()) {
          const fullCmd = cmd + extraText;
          const subResult = processCommand(fullCmd);
          if (subResult) return subResult;
        }
        // No text provided — prompt for input
        if (cmd === null) {
          // Complex tool — just link
          return "Here's the **[" + bestTool.name + "](" + bestTool.url + ")** tool.\n" + bestTool.desc + "\n\nVisit it to use the full interface.";
        }
        return "I can help with **" + bestTool.name + "**! " + toolCommands.prompt.replace("TOOL", bestTool.name.toLowerCase());
      }
      return "Here are matching tools:\n" + found.map(t => "- **[" + t.name + "](" + t.url + ")** (" + t.cat + "): " + t.desc).join("\n");
    }
  }

  return null; // not matched
}

function catCounts(tools) {
  const counts = {};
  for (const t of tools) counts[t.cat] = (counts[t.cat] || 0) + 1;
  return counts;
}

