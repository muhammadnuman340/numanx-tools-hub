---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";

const faqItems = [
  { question: "What can the AI Chat Assistant do?", answer: "It can answer questions about tools, SHA-256 hashing, color conversion (hex/rgb/hsl), BMI calculation, slug generation, binary/text conversion, ASCII lookup, dice rolling (d4d100), password strength analysis, Fibonacci sequences, prime checking with factorization, date info (day of week, leap year), random inspirational quotes, lottery number generation, text transformations (word count, JSON format, base64, case convert, URL encode/decode, ROT13, reverse text, Morse code, palindrome check), math calculations, number base conversions, date arithmetic, list operations, frequency analysis, number formatting, time conversion, timers, password/UUID generation, and more." },
  { question: "Does the AI use an external API?", answer: "No. All responses are generated locally in your browser using built-in logic. No data is ever sent to any server, ensuring complete privacy." },
  { question: "Can I have a conversation history?", answer: "Yes. Your conversation is automatically saved in your browser's local storage. You can clear the conversation at any time using the Clear button above the chat." },
  { question: "What kind of commands does the AI understand?", answer: "Try: 'calculate 2+3*4', 'rot13: hello', 'sort: banana, apple, cherry', 'frequency: hello world', 'spell 1234', 'roman 42', 'days until 2026-12-31', 'timer 5 minutes', 'morse encode: hello', 'convert 255 to binary', 'palindrome: racecar', 'count words in hello world', 'format json: {\"a\":1}', 'encode base64: hello', 'generate password 16', 'what tools do you have?', 'show ai tools', or just say hello!" },
];

const schema = {
  name: "AI Chat Assistant",
  applicationCategory: "AI Tools",
  description: "A full-page conversational AI assistant that helps with tools, transformations, and platform navigation  all running locally.",
};
---
<MainLayout title="AI Chat Assistant - Free AI Chatbot for Tools & Tasks" description="Chat with a local AI assistant about NumanX tools, execute text transformations, generate passwords, format JSON, and more  all in your browser." keywords="ai chat, chatbot, ai assistant, conversation, help, ai helper, virtual assistant, local ai" toolSchema={schema} faq={faqItems} breadcrumbs={[{name:"Home",url:"/"},{name:"Tools",url:"/tools/"},{name:"AI Chat Assistant",url:"/tools/ai-chat/"}]}>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden"><div class="max-w-4xl mx-auto">
    <ToolHeader title="AI Chat" gradient="Assistant" desc="Chat with a local AI assistant about tools, features, and tasks. All processing is private and runs entirely in your browser." badge=" New" slug="ai-chat" />
    <ShareBar />
    <div class="max-w-2xl mx-auto mt-10">
      <div class="bg-surface-1 border border-surface rounded-2xl overflow-hidden">
        <!-- Header -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-surface">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center">
              <svg class="w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><line x1="12" y1="8" x2="12" y2="14"/><line x1="9" y1="11" x2="15" y2="11"/></svg>
            </div>
            <div>
              <p class="text-sm font-bold text-primary">NumanX AI</p>
              <p class="text-[10px] text-muted">Conversational assistant</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex gap-1">
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="purple" style="background:#a855f7"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="blue" style="background:#3b82f6"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="green" style="background:#22c55e"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="pink" style="background:#ec4899"></button>
            </div>
            <div class="relative">
              <button id="search-toggle-btn" class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-violet-500/40 transition-all text-xs" title="Search conversation">
                <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </button>
            </div>
            <div class="relative" id="export-container">
              <button id="export-btn" class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-violet-500/40 transition-all text-xs" title="Export conversation">
                <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              </button>
              <div id="export-dropdown" class="hidden absolute right-0 mt-1 w-44 bg-surface-2 border border-surface rounded-lg shadow-xl z-10 py-1">
                <button data-export="json" class="block w-full text-left px-3 py-1.5 text-xs text-secondary hover:bg-surface-3 hover:text-white transition-colors">Export as JSON</button>
                <button data-export="txt" class="block w-full text-left px-3 py-1.5 text-xs text-secondary hover:bg-surface-3 hover:text-white transition-colors">Export as TXT</button>
                <button data-export="md" class="block w-full text-left px-3 py-1.5 text-xs text-secondary hover:bg-surface-3 hover:text-white transition-colors">Export as Markdown</button>
              </div>
            </div>
            <button id="clear-chat-btn" class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-violet-500/40 transition-all text-xs" title="Clear conversation">
              <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </div>
        </div>

        <!-- Search bar -->
        <div id="search-bar" class="hidden px-4 py-2 border-b border-surface">
          <div class="relative">
            <input id="chat-search" type="text" class="w-full bg-surface-2 border border-surface-2 rounded-lg px-3 py-1.5 text-xs text-primary placeholder:text-muted focus:outline-none focus:border-violet-500/50 transition-all" placeholder="Search messages..." autocomplete="off" />
            <span id="search-count" class="absolute right-2 top-1/2 -translate-y-1/2 text-[9px] text-muted"></span>
          </div>
        </div>

        <!-- Messages -->
        <div id="chat-messages" class="h-[420px] overflow-y-auto p-4 space-y-3 scrollbar-hide">
          <div class="flex items-start gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div class="flex-1 bg-surface-2 rounded-xl rounded-tl-none px-3.5 py-2.5">
              <p class="text-xs text-secondary leading-relaxed">
                Hi! I'm your NumanX AI assistant. I can answer questions about tools, help with text tasks, and guide you. Try some examples below!
              </p>
            </div>
          </div>
        </div>

        <!-- Typing indicator -->
        <div id="typing-indicator" class="hidden px-4 py-2">
          <div class="flex items-start gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div class="flex-1 bg-surface-2 rounded-xl rounded-tl-none px-3.5 py-3">
              <span class="typing-dot inline-block w-1.5 h-1.5 rounded-full bg-purple-400 mx-0.5"></span>
              <span class="typing-dot inline-block w-1.5 h-1.5 rounded-full bg-purple-400 mx-0.5"></span>
              <span class="typing-dot inline-block w-1.5 h-1.5 rounded-full bg-purple-400 mx-0.5"></span>
            </div>
          </div>
        </div>

        <!-- Quick suggestions -->
        <div id="suggestions" class="flex flex-wrap gap-1.5 px-4 pb-2 pt-0">
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">What tools do you have?</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">hash: hello</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">color #ff8800</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">calculate 2+3*4</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">bmi 70 kg 175 cm</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">roll d20</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">strength: MyP@ss</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">quote</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">convert 255 to binary</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">rot13: hello world</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">sort: banana, apple, cherry</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">frequency: hello world</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">ascii A</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">day 2026-06-04</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">leap 2024</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">prime 17</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">palindrome: racecar</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">fibonacci 10</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">lottery</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">slug: Hello World</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">text to binary: hello</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">timer 5 seconds</button>
          <button class="suggestion-chip text-[10px] px-2.5 py-1 rounded-lg bg-surface-3 hover:bg-violet-500/20 text-tertiary hover:text-violet-300 border border-surface-2 transition-all cursor-pointer">morse encode: hello</button>
        </div>

        <!-- Input -->
        <div class="px-4 py-3 border-t border-surface">
          <form id="chat-form" class="flex items-center gap-2">
            <input id="chat-input" type="text" class="flex-1 bg-surface-2 border border-surface-2 rounded-xl px-3.5 py-2.5 text-sm text-primary placeholder:text-muted focus:outline-none focus:border-violet-500/50 focus:ring-1 focus:ring-violet-500/20 transition-all" placeholder="Ask about tools or try a command..." autocomplete="off" />
            <button type="submit" id="send-btn" class="w-9 h-9 rounded-xl bg-violet-600 hover:bg-violet-500 flex items-center justify-center text-white transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed shrink-0" aria-label="Send message">
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
            <button type="button" id="voice-btn" class="voice-btn w-9 h-9 rounded-xl bg-surface-2 border border-surface-2 hover:border-violet-500/40 flex items-center justify-center text-tertiary hover:text-white transition-all cursor-pointer shrink-0" aria-label="Voice input">
              <svg class="voice-icon w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/></svg>
            </button>
          </form>
          <p class="text-[9px] text-dim mt-1.5 text-center">All responses are generated locally  No data sent to servers</p>
        </div>
      </div>
    </div>

    <!-- How It Works -->
    <section class="mt-20 max-w-3xl mx-auto"><div class="text-center mb-8"><span class="text-xs font-semibold text-violet-400 uppercase tracking-wider">AI Technology</span><h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">How It <span class="bg-gradient-to-r from-violet-400 to-purple-500 bg-clip-text text-transparent">Works</span></h2></div><div class="space-y-4 text-sm text-tertiary leading-relaxed"><p>The AI Chat Assistant uses intelligent pattern matching to understand your requests. It can recognize greetings, tool-related questions, and specific commands like <strong class="text-primary">calculate</strong>, <strong class="text-primary">convert 255 to binary</strong>, <strong class="text-primary">rot13</strong>, <strong class="text-primary">sort</strong>, <strong class="text-primary">frequency</strong>, <strong class="text-primary">palindrome</strong>, <strong class="text-primary">timer</strong>, <strong class="text-primary">days until</strong>, <strong class="text-primary">spell 1234</strong>, <strong class="text-primary">roman</strong>, <strong class="text-primary">morse encode</strong>, <strong class="text-primary">count words</strong>, <strong class="text-primary">format json</strong>, and more.</p><p>Each command is executed locally using built-in JavaScript  no API calls, no server requests. Your text stays private. The assistant also saves your conversation history in your browser for continuity.</p></div></section>

    <RelatedTools current="ai-chat" />
    <div class="mt-20 max-w-3xl mx-auto"><h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">Frequently Asked <span class="bg-gradient-to-r from-violet-400 to-purple-500 bg-clip-text text-transparent">Questions</span></h2><Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} /></div>
  </div></main>
</MainLayout>
<script>
function playPing(){ try{const a=new(window.AudioContext||window.webkitAudioContext)();const o=a.createOscillator();const g=a.createGain();o.connect(g);g.connect(a.destination);o.frequency.value=800;g.gain.setValueAtTime(0.08,a.currentTime);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+0.12);o.start();o.stop(a.currentTime+0.12);}catch(e){} }

const H_KEY = "nt_chat_history";
const MAX_HISTORY = 50;

const containers = {
  messages: document.getElementById("chat-messages"),
  typing: document.getElementById("typing-indicator"),
  input: document.getElementById("chat-input"),
  form: document.getElementById("chat-form"),
  sendBtn: document.getElementById("send-btn"),
};

let msgIndex = 0;
let context = { lastTopic: null, toolCount: null };

function escapeHtml(str) {
  return str.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

function escapeAttr(str) {
  return str.replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}

// Tool data
const allTools = [
  { name:"QR Generator", cat:"Creator Tools", desc:"Generate QR codes from URLs and text", url:"/tools/qr-generator/", keywords:["qr","barcode","scan"] },
  { name:"Word Counter", cat:"Utility Tools", desc:"Count words, characters, sentences", url:"/tools/word-counter/", keywords:["word","count","character","text"] },
  { name:"Password Generator", cat:"Utility Tools", desc:"Generate secure passwords", url:"/tools/password-generator/", keywords:["password","secure","random"] },
  { name:"JSON Formatter", cat:"Developer Tools", desc:"Format and validate JSON", url:"/tools/json-formatter/", keywords:["json","format","validate"] },
  { name:"Base64 Tool", cat:"Developer Tools", desc:"Encode/decode Base64", url:"/tools/base64-tool/", keywords:["base64","encode","decode"] },
  { name:"UUID Generator", cat:"Developer Tools", desc:"Generate UUIDs v4 and v7", url:"/tools/uuid-generator/", keywords:["uuid","guid","id"] },
  { name:"Unit Converter", cat:"Utility Tools", desc:"Convert length, mass, temp, speed, data, volume", url:"/tools/unit-converter/", keywords:["convert","unit","length","mass","temp"] },
  { name:"AI Text Summarizer", cat:"AI Tools", desc:"Summarize long text into concise summaries", url:"/tools/ai-text-summarizer/", keywords:["summarize","summary","text","article"] },
  { name:"AI Grammar Checker", cat:"AI Tools", desc:"Check grammar, spelling, punctuation", url:"/tools/ai-grammar-checker/", keywords:["grammar","spelling","check","writing"] },
  { name:"AI Sentiment Analyzer", cat:"AI Tools", desc:"Analyze text sentiment", url:"/tools/ai-sentiment-analyzer/", keywords:["sentiment","emotion","tone","positive","negative"] },
  { name:"Color Converter", cat:"Developer Tools", desc:"Convert between HEX, RGB, HSL", url:"/tools/color-converter/", keywords:["color","hex","rgb","hsl"] },
  { name:"Percentage Calculator", cat:"Utility Tools", desc:"Calculate percentages", url:"/tools/percentage-calculator/", keywords:["percent","percentage","of"] },
  { name:"Random Number Gen", cat:"Utility Tools", desc:"Generate random numbers", url:"/tools/random-number-generator/", keywords:["random","number","dice"] },
  { name:"URL Encoder", cat:"Developer Tools", desc:"Encode/decode URLs", url:"/tools/url-encoder/", keywords:["url","encode","decode"] },
  { name:"Case Converter", cat:"Creator Tools", desc:"Convert text case", url:"/tools/case-converter/", keywords:["case","upper","lower","title"] },
  { name:"Image Compressor", cat:"Image Tools", desc:"Compress images without quality loss", url:"/tools/image-compressor/", keywords:["image","compress","optimize","size"] },
  { name:"AI Language Detector", cat:"AI Tools", desc:"Detect language of any text", url:"/tools/ai-language-detector/", keywords:["language","detect","identify"] },
  { name:"AI Readability Analyzer", cat:"AI Tools", desc:"Analyze text readability scores", url:"/tools/ai-readability-analyzer/", keywords:["readability","flesch","score"] },
  { name:"AI Paraphraser", cat:"AI Tools", desc:"Rewrite text with different phrasing", url:"/tools/ai-paraphraser/", keywords:["paraphrase","rewrite","rephrase"] },
  { name:"AI Tag Generator", cat:"AI Tools", desc:"Generate tags and hashtags from content", url:"/tools/ai-tag-generator/", keywords:["tag","hashtag","keyword","seo"] },
  { name:"Markdown Editor", cat:"Creator Tools", desc:"Write and preview markdown in real-time", url:"/tools/markdown-editor/", keywords:["markdown","md","preview","editor"] },
  { name:"Image Resizer", cat:"Image Tools", desc:"Resize images to any dimension", url:"/tools/image-resizer/", keywords:["resize","image","dimension"] },
  { name:"HTML Formatter", cat:"Developer Tools", desc:"Format, minify, validate HTML", url:"/tools/html-formatter/", keywords:["html","format","beautify","minify"] },
  { name:"CSS Formatter", cat:"Developer Tools", desc:"Format, minify, validate CSS", url:"/tools/css-formatter/", keywords:["css","format","beautify"] },
  { name:"Regex Tester", cat:"Developer Tools", desc:"Test and debug regular expressions", url:"/tools/regex-tester/", keywords:["regex","regular expression","pattern"] },
  { name:"Diff Checker", cat:"Developer Tools", desc:"Compare two texts side by side", url:"/tools/diff-checker/", keywords:["diff","compare","difference"] },
  { name:"BMI Calculator", cat:"Utility Tools", desc:"Calculate your Body Mass Index", url:"/tools/bmi-calculator/", keywords:["bmi","body mass","weight","health"] },
  { name:"SQL Formatter", cat:"Developer Tools", desc:"Format and beautify SQL queries", url:"/tools/sql-formatter/", keywords:["sql","format","query","database"] },
  { name:"Character Counter", cat:"Utility Tools", desc:"Count characters, words, sentences", url:"/tools/character-counter/", keywords:["character","count","letter"] },
  { name:"JWT Decoder", cat:"Developer Tools", desc:"Decode and inspect JWT tokens", url:"/tools/jwt-decoder/", keywords:["jwt","token","decode","auth"] },
