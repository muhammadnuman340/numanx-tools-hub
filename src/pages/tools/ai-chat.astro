  return "Found " + errors.length + " issue" + (errors.length > 1 ? "s" : "") + ":\n" + errors.slice(0, 5).map(e => "- **" + e.word + "** \u2192 " + e.suggestion).join("\n") + (errors.length > 5 ? "\n...and " + (errors.length - 5) + " more" : "");
}

