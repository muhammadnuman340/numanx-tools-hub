});

const DRAFT_KEY = "nt_draft_ai-language-detector";
(function() {
  const input = document.getElementById("input-text") || document.querySelector("textarea:not([readonly])");
  if (!input) return;
  try {
    const saved = localStorage.getItem(DRAFT_KEY);
    if (saved && !input.value) { input.value = saved; input.dispatchEvent(new Event("input")); }
  } catch(e) {}
  let saveTimer;
  input.addEventListener("input", () => {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(() => {
      try { localStorage.setItem(DRAFT_KEY, input.value); } catch(e) {}
    }, 500);
  });
})();

