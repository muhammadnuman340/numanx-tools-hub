function getNgrams(text, n) {
  const cleaned = text.toLowerCase().replace(/[^a-z\u00C0-\u024F\u0400-\u04FF\u4E00-\u9FFF\u3040-\u309F\u30A0-\u30FF\u0600-\u06FF\u0900-\u097F\u0E00-\u0E7F\uAC00-\uD7AF\u0590-\u05FF\u1F00-\u1FFF]/g, " ");
  const ngrams = {};
  for (let i = 0; i <= cleaned.length - n; i++) {
    const gram = cleaned.substring(i, i + n);
    if (gram.includes(" ")) continue;
    ngrams[gram] = (ngrams[gram] || 0) + 1;
  }
  return ngrams;
}

function cosineSimilarity(a, b) {
  let dot = 0, normA = 0, normB = 0;
  for (const key in a) {
    const va = a[key], vb = b[key] || 0;
    dot += va * vb;
    normA += va * va;
  }
  for (const key in b) normB += b[key] * b[key];
  if (normA === 0 || normB === 0) return 0;
  return dot / (Math.sqrt(normA) * Math.sqrt(normB));
}

function detectLanguage(text) {
  if (!text.trim()) return null;
  const triGrams = getNgrams(text, 3);
  const biGrams = getNgrams(text, 2);
  const combined = {};
  for (const k in triGrams) combined[k] = triGrams[k];
  for (const k in biGrams) combined[k] = (combined[k] || 0) + biGrams[k] * 0.5;

  let best = null, bestScore = -1, secondScore = -1;
  for (const code in langProfiles) {
    const profile = langProfiles[code].freq;
    const score = cosineSimilarity(combined, profile);
    if (score > bestScore) {
      secondScore = bestScore;
      bestScore = score;
      best = code;
    } else if (score > secondScore) {
      secondScore = score;
    }
  }

  const confidence = bestScore > 0 ? Math.min(100, Math.round((1 - secondScore / (bestScore || 1)) * 100)) : 0;
  return { ...langProfiles[best], code: best, confidence };
}

document.getElementById("detect-btn").addEventListener("click", () => {
  const text = document.getElementById("input-text").value;
  const result = detectLanguage(text);
  const resultDiv = document.getElementById("result");
  if (!result) {
    resultDiv.classList.add("hidden");
    if (window.__showToast) window.__showToast({ message: "Please enter some text to analyze", variant: "warning" });
    return;
  }
  resultDiv.classList.remove("hidden");
  document.getElementById("detected-lang").textContent = result.name;
  document.getElementById("confidence-score").textContent = result.confidence + "%";
  document.getElementById("confidence-fill").style.width = result.confidence + "%";
  document.getElementById("detected-script").textContent = result.script;

  if (result.confidence < 50) {
    document.getElementById("confidence-fill").className = "block h-full rounded-full bg-gradient-to-r from-yellow-500 to-orange-500 transition-all duration-500";
  } else if (result.confidence < 80) {
    document.getElementById("confidence-fill").className = "block h-full rounded-full bg-gradient-to-r from-violet-500 to-purple-500 transition-all duration-500";
  } else {
    document.getElementById("confidence-fill").className = "block h-full rounded-full bg-gradient-to-r from-emerald-500 to-green-500 transition-all duration-500";
  }
});
</script>
