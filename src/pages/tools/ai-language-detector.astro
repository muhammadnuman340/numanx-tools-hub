const lfInput=document.getElementById("input-text");
if(lfInput){
  lfInput.addEventListener("input", ()=>{
    const t=lfInput.value.toLowerCase().replace(/[^a-z]/g,""); if(!t){ document.getElementById("letter-freq").classList.add("hidden"); return; }
    const f={}; for(const c of t) f[c]=(f[c]||0)+1;
    const s=Object.entries(f).sort((a,b)=>b[1]-a[1]).slice(0,8); const m=s[0]?s[0][1]:1;
    const el=document.getElementById("letter-freq"); el.classList.remove("hidden");
    el.innerHTML=s.map(([c,n])=>`<div class="flex items-center gap-1.5 text-xs"><span class="w-3 text-center font-mono text-white">${c}</span><div class="h-2 rounded-full bg-purple-500/50" style="width:${(n/m)*80+10}%"></div><span class="text-muted">${n}</span></div>`).join("");
  });
}

