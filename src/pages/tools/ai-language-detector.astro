---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";

const faqItems = [
  { question: "How does AI language detection work?", answer: "Language detection uses character n-gram frequency analysis. Every language has unique patterns of letter combinations (n-grams). By comparing the n-gram profile of your input text against pre-computed profiles for 28 languages, the tool identifies the closest match and provides a confidence score." },
  { question: "How accurate is the language detector?", answer: "Accuracy depends on text length and quality. For text longer than 50 characters, accuracy is very high. Very short texts (under 20 characters) or texts with mixed languages may produce less reliable results. The confidence score helps you gauge reliability." },
  { question: "Can it detect multiple languages in one text?", answer: "Currently, the detector identifies the primary language of the entire text. For multilingual content, the dominant language (the one with the most matching n-gram patterns) is reported. We recommend testing each language segment separately for best results." },
];

const schema = {
  name: "AI Language Detector Pro",
  applicationCategory: "AI Tools",
  description: "Detect the language of any text using AI-powered n-gram frequency analysis. Supports 28 languages including English, Spanish, French, German, Chinese, Arabic, and more.",
};
---
<MainLayout title="AI Language Detector - Free Online Language Identifier" description="Detect the language of any text instantly using AI-powered analysis. Supports 28 languages with confidence scoring." keywords="language detector, language identifier, text language detection, what language is this, language recognition, AI language detector" toolSchema={schema} faq={faqItems} breadcrumbs={[{name:"Home",url:"/"},{name:"Tools",url:"/tools/"},{name:"AI Language Detector",url:"/tools/ai-language-detector/"}]}>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden"><div class="max-w-4xl mx-auto">
    <ToolHeader title="AI Language" gradient="Detector Pro" desc="Identify the language of any text instantly with AI-powered n-gram frequency analysis across 28 languages." badge="✦ AI Powered" slug="ai-language-detector" />
    <ShareBar />
    <div class="max-w-xl mx-auto mt-10"><div class="bg-surface-1 border border-surface rounded-2xl p-6">
      <textarea id="input-text" rows="6" placeholder="Type text in any language..." class="w-full bg-transparent text-white placeholder-zinc-600 p-4 resize-none focus:outline-none text-sm leading-relaxed border border-surface-2 rounded-xl mb-4"></textarea>
      <button id="detect-btn" class="w-full py-3 rounded-xl font-bold text-sm bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-500 hover:to-purple-500 text-white transition-all duration-200 shadow-lg shadow-violet-600/20">Detect Language</button>
      <div id="result" class="hidden mt-6 space-y-3">
        <div class="bg-surface-1 border border-surface rounded-xl p-4 flex items-center justify-between"><span class="text-sm text-tertiary">Language</span><span id="detected-lang" class="text-lg font-bold text-white"></span></div>
        <div class="bg-surface-1 border border-surface rounded-xl p-4 flex items-center justify-between"><span class="text-sm text-tertiary">Confidence</span><div class="flex items-center gap-2"><span id="confidence-score" class="text-lg font-bold text-white"></span><span id="confidence-bar" class="block w-20 h-2 rounded-full bg-surface-2 overflow-hidden"><span id="confidence-fill" class="block h-full rounded-full bg-gradient-to-r from-violet-500 to-purple-500 transition-all duration-500" style="width:0%"></span></span></div></div>
        <div class="bg-surface-1 border border-surface rounded-xl p-4 flex items-center justify-between"><span class="text-sm text-tertiary">Script</span><span id="detected-script" class="text-lg font-bold text-white"></span></div>
      </div>
    </div></div>
    <section class="mt-20 max-w-3xl mx-auto"><div class="text-center mb-8"><span class="text-xs font-semibold text-violet-400 uppercase tracking-wider">AI Technology</span><h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">How It <span class="bg-gradient-to-r from-violet-400 to-purple-500 bg-clip-text text-transparent">Works</span></h2></div><div class="space-y-4 text-sm text-tertiary leading-relaxed"><p>The AI Language Detector uses <strong class="text-primary">character n-gram frequency analysis</strong> to identify languages. Every language has a unique fingerprint of common letter pairs and triples. By extracting n-grams from your input and comparing them against pre-computed frequency profiles for 28 languages, the tool finds the closest statistical match.</p><p>The confidence score reflects how strongly the input matches the top language versus the runner-up. Longer texts produce more reliable results as more n-gram data is available for comparison.</p></div></section>
    <RelatedTools current="ai-language-detector" />
    <div class="mt-20 max-w-3xl mx-auto"><h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">Frequently Asked <span class="bg-gradient-to-r from-violet-400 to-purple-500 bg-clip-text text-transparent">Questions</span></h2><Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} /></div>
  </div></main>
</MainLayout>
