---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";

const faqItems = [
  { question: "What is a UUID?", answer: "A UUID (Universally Unique Identifier) is a 128-bit identifier standardized by RFC 4122. It's used to uniquely identify information in computer systems. The probability of duplication is extremely low." },
  { question: "What is the difference between UUID v4 and v7?", answer: "UUID v4 is randomly generated. UUID v7 includes a Unix timestamp prefix, making them time-ordered and more efficient for database indexing." },
  { question: "Are these truly random?", answer: "UUID v4 uses crypto.getRandomValues() for cryptographically strong random values. UUID v7 embeds the current timestamp with random entropy." },
];
const uvSchema = { name: "UUID Generator", applicationCategory: "Utilities", description: "Generate UUID v4 and v7 identifiers instantly with bulk generation and copy/download.", featureList: ["UUID v4 and v7 support", "Bulk generation (1-100)", "Copy single UUID", "Download all as .txt"] };
---
<MainLayout title="UUID Generator - Generate UUIDs Online Free" description="Generate UUID v4 and v7 identifiers instantly. Bulk generate UUIDs with copy and download support." keywords="uuid generator, uuid, guid, unique id, developer tools" toolSchema={uvSchema} faq={faqItems} breadcrumbs={[{name:"Home",url:"/"},{name:"Tools",url:"/tools/"},{name:"UUID Generator",url:"/tools/uuid-generator/"}]}>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden"><div class="max-w-4xl mx-auto">
    <ToolHeader title="UUID" gradient="Generator Pro" desc="Generate UUID v4 and v7 identifiers instantly. Bulk generate, copy, and download." badge="✦ New Tool" slug="uuid-generator" />
    <ShareBar />
    <div class="max-w-xl mx-auto mt-10">
      <div class="bg-surface-1 border border-surface rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="flex gap-2">
            <button id="v4-btn" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-purple-600 text-white">UUID v4</button>
            <button id="v7-btn" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary">UUID v7 (Timestamp)</button>
          </div>
          <div class="flex items-center gap-2">
            <label class="text-xs text-tertiary">Count:</label>
            <input id="count-input" type="number" value="1" min="1" max="100" class="w-16 px-2 py-1.5 rounded-lg border border-surface-2 bg-surface-1 text-white text-xs text-center focus:border-purple-500/50 focus:outline-none" />
          </div>
        </div>
        <button id="generate-btn" class="w-full bg-purple-600 hover:bg-purple-500 text-white text-sm font-semibold py-2.5 rounded-xl transition-all mb-4">Generate</button>
        <div id="uuid-list" class="space-y-1.5 max-h-64 overflow-y-auto">
          <div class="text-center text-muted text-xs py-8">Click Generate to create UUIDs</div>
        </div>
        <div class="flex gap-2 mt-4 pt-4 border-t border-surface">
          <button id="copy-all-btn" class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all">Copy All</button>
          <button id="download-btn" class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all">Download .txt</button>
        </div>
      </div>
    </div>
    <section class="mt-20 max-w-3xl mx-auto"><div class="text-center mb-8"><span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Learn</span><h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">Why Use a <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">UUID Generator?</span></h2></div><div class="space-y-4 text-sm text-tertiary leading-relaxed"><p>UUIDs are essential for database primary keys, API resource identifiers, session tokens, and distributed systems where unique identifiers must be generated without coordination. UUID v7 with timestamp ordering is increasingly preferred for modern database systems.</p></div></section>
    <RelatedTools current="uuid-generator" />
    <div class="mt-20 max-w-3xl mx-auto"><h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">Frequently Asked <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span></h2><Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} /></div>
  </div></main>
</MainLayout>
<script>
  let useV7 = false;
  let uuids = [];
  document.getElementById("v4-btn").addEventListener("click", () => { useV7 = false; document.getElementById("v4-btn").classList.add("bg-purple-600","text-white"); document.getElementById("v4-btn").classList.remove("bg-surface-2","text-tertiary","hover:text-primary"); document.getElementById("v7-btn").classList.remove("bg-purple-600","text-white"); document.getElementById("v7-btn").classList.add("bg-surface-2","text-tertiary","hover:text-primary"); });
  document.getElementById("v7-btn").addEventListener("click", () => { useV7 = true; document.getElementById("v7-btn").classList.add("bg-purple-600","text-white"); document.getElementById("v7-btn").classList.remove("bg-surface-2","text-tertiary","hover:text-primary"); document.getElementById("v4-btn").classList.remove("bg-purple-600","text-white"); document.getElementById("v4-btn").classList.add("bg-surface-2","text-tertiary","hover:text-primary"); });
  function generateUUIDv4() { return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = crypto.getRandomValues(new Uint8Array(1))[0] / 256 | 0; return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16); }); }
  function generateUUIDv7() { const t = Date.now(); const r = crypto.getRandomValues(new Uint8Array(10)); return `${t.toString(16).padStart(12,'0')}-${Array.from(r).map((b,i) => { if (i===0) return (b & 0x0f | 0x70).toString(16); if (i===1) return (b & 0x3f | 0x80).toString(16); return b.toString(16).padStart(2,'0'); }).join('').replace(/^(.{4})(.{4})(.{8})(.{4})$/,'$1-$2-$3-$4')}`; }
  function render() { const el = document.getElementById("uuid-list"); if (uuids.length === 0) { el.innerHTML = '<div class="text-center text-muted text-xs py-8">Click Generate to create UUIDs</div>'; return; } el.innerHTML = uuids.map((u, i) => `<div class="flex items-center gap-2 bg-surface-1 rounded-lg px-3 py-1.5"><span class="text-xs text-muted w-5">${i+1}.</span><code class="flex-1 text-xs text-primary font-mono truncate">${u}</code><button class="copy-uuid text-[10px] text-purple-400 hover:text-purple-300 font-medium shrink-0" data-uuid="${u}">Copy</button></div>`).join(''); el.querySelectorAll(".copy-uuid").forEach(btn => btn.addEventListener("click", async () => { await navigator.clipboard.writeText(btn.dataset.uuid); if ((window as any).__showToast) (window as any).__showToast({message:"Copied!",variant:"success"}); })); }
  document.getElementById("generate-btn").addEventListener("click", () => { const n = Math.min(Math.max(parseInt((document.getElementById("count-input") as HTMLInputElement).value) || 1, 1), 100); uuids = Array.from({length: n}, () => useV7 ? generateUUIDv7() : generateUUIDv4()); render(); });
  document.getElementById("copy-all-btn").addEventListener("click", async () => { if (!uuids.length) return; await navigator.clipboard.writeText(uuids.join('\n')); if ((window as any).__showToast) (window as any).__showToast({message:"All copied!",variant:"success"}); });
  document.getElementById("download-btn").addEventListener("click", () => { if (!uuids.length) return; const a = document.createElement("a"); a.href = URL.createObjectURL(new Blob([uuids.join('\n')], {type:'text/plain'})); a.download = `uuids-${Date.now()}.txt`; a.click(); URL.revokeObjectURL(a.href); });
</script>
