---
import MainLayout from '../../layouts/MainLayout.astro';
import { tools, categories as categoryInfos } from '../../data/tools';
import MonetizationSlot from '../../components/MonetizationSlot.astro';

const categoryMap: Record<string, string> = {
  'image-tools': 'Image Tools',
  'creator-tools': 'Creator Tools',
  'utility-tools': 'Utility Tools',
  'cricket-tools': 'Cricket Tools',
  'ai-tools': 'AI Tools',
  'developer-tools': 'Developer Tools',
};

const categories = ['All', ...categoryInfos.map((c) => categoryMap[c.id] || c.title)];
---

<MainLayout
  title="Free Online Tools - NumanX Tools"
  description="Free browser-based tools for image conversion, text analysis, QR codes, cricket and productivity. No sign-up needed."
  keywords="free online tools, image compressor, qr code generator, word counter, cricket calculator, password generator, hashtag generator, age calculator, png to webp, jpg to png, image resizer, online utilities free, browser tools no signup, productivity tools, best free online tools"
  canonical="https://toolshub.numanxstudio.com/tools/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
  ]}
>
  <main class="min-h-screen pt-8 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-1.5 text-xs sm:text-sm text-zinc-400">
          <li>
            <a href="/" class="hover:text-white transition-colors">Home</a>
          </li>
          <li class="text-zinc-600 select-none" aria-hidden="true">&gt;</li>
          <li class="text-zinc-200 font-semibold" aria-current="page">
            Tools
          </li>
        </ol>
      </nav>

      <div class="text-center mb-12">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-surface bg-surface-1 text-tertiary text-xs font-semibold tracking-wider uppercase mb-6"
        >
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
          </span>
          {tools.length} Free Tools
        </div>
        <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-none">
          Free Online
          <span class="bg-gradient-to-r from-purple-400 via-pink-400 to-amber-400 bg-clip-text text-transparent">
            Tools
          </span>
        </h1>
        <p class="text-muted mt-4 max-w-xl mx-auto text-base">
          A collection of free, fast, browser-based tools with zero data collection. Everything runs locally on your
          device.
        </p>
      </div>

      <!-- Top Leaderboard Monetization Slot -->
      <div class="mb-10 max-w-4xl mx-auto">
        <MonetizationSlot format="leaderboard" variant="auto" />
      </div>

      <div class="max-w-xl mx-auto mb-10 space-y-4">
        <div class="relative flex items-center">
          <input
            id="search-input"
            type="search"
            placeholder="Search tools..."
            class="w-full bg-[#0a0a0c]/80 text-white placeholder-zinc-500 pl-11 pr-24 py-3.5 rounded-2xl border border-white/5 focus:outline-none focus:border-purple-500/50 focus:ring-1 focus:ring-purple-500/20 transition-all text-sm shadow-inner"
            autocomplete="off" aria-label="Search tools"
          />
          <div class="absolute right-3 flex items-center gap-1.5 pointer-events-none">
            <kbd
              class="hidden sm:inline-flex items-center gap-0.5 px-2 py-0.5 rounded border border-white/10 bg-white/5 text-[10px] font-medium font-mono text-zinc-550"
            >
              CMD+K
            </kbd>
          </div>
        </div>

        <div id="category-filters" class="flex flex-wrap gap-2 justify-center">
          {
            categories.map((cat) => (
              <button
                class={`category-btn relative px-4 py-2 text-xs font-bold rounded-xl transition-all audio-trigger ${
                  cat === 'All'
                    ? 'bg-purple-600/10 border border-purple-500/30 text-purple-400'
                    : 'bg-[#0a0a0c]/80 text-zinc-400 border border-white/5 hover:border-white/10 hover:text-white'
                }`}
                data-active={cat === 'All' ? 'true' : 'false'}
                data-category={cat}
              >
                {cat}
              </button>
            ))
          }
        </div>
      </div>

      <div
        id="cards-container-tools"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 px-4 py-8 max-w-7xl mx-auto group-section preserve-3d"
      >
        {
          tools.map((tool) => {
            const initials = tool.name
              .split(' ')
              .map((w) => w[0])
              .join('')
              .slice(0, 2);
            const displayCat = categoryMap[tool.category] || tool.category;
            return (
              <div
                class="tool-card group card-spotlight bg-surface-1/80 border border-surface p-5 rounded-3xl flex flex-col justify-between hover:bg-amber-500/5 transition-all audio-trigger"
                data-name={tool.name}
                data-category={displayCat}
              >
                <div>
                  <div class="flex items-center gap-3 mb-3">
                    <div class="w-12 h-12 rounded-2xl bg-zinc-950 border border-white/5 flex items-center justify-center text-zinc-400 group-hover:scale-110 group-hover:bg-amber-500/10 group-hover:border-amber-500/20 group-hover:text-amber-400 transition-all relative overflow-hidden shadow-inner shrink-0">
                      <span class="font-bold text-sm relative z-10 font-mono tracking-wider">{initials}</span>
                      <span class="absolute inset-0 bg-radial-gradient from-amber-500/25 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
                    </div>
                    <h3 class="text-base font-semibold text-primary group-hover:text-purple-300 transition-colors">
                      {tool.name}
                    </h3>
                  </div>
                  <p class="text-xs text-tertiary leading-relaxed">{tool.description}</p>
                </div>
                <a
                  href={tool.url}
                  class="mt-5 w-full bg-surface-2 hover:bg-purple-650 text-secondary hover:text-white text-xs font-semibold py-3 rounded-xl border border-surface-2 hover:border-purple-500/50 text-center transition-all group-hover:scale-[1.02] shadow-inner audio-trigger"
                >
                  Open Tool
                </a>
              </div>
            );
          })
        }

        <div id="empty-state" class="hidden col-span-full text-center py-20">
          <div class="w-16 h-16 rounded-2xl bg-zinc-800 flex items-center justify-center mx-auto mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#a855f7"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-secondary">No tools found</h3>
          <p class="text-sm text-muted mt-1">Try adjusting your search or filter.</p>
        </div>
      </div>

      <div class="max-w-4xl mx-auto px-4 mt-8">
        <MonetizationSlot format="horizontal" variant="auto" />
      </div>
    </div>
  </main>
</MainLayout>

<script>
  const handleOnMouseMove = (e: MouseEvent, containerId: string) => {
    const container = document.getElementById(containerId);
    if (!container) return;
    const cards = container.getElementsByClassName('card-spotlight');
    for (const card of cards as any) {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
      if (x > 0 && x < rect.width && y > 0 && y < rect.height) {
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -4;
        const rotateY = ((x - centerX) / centerX) * 4;
        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(10px) scale(1.02)`;
        card.style.zIndex = '50';
      } else {
        card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(0px) scale(1)`;
        card.style.zIndex = '1';
      }
    }
  };

  const initToolsPage = () => {
    // 3D Tilt initialization
    const container = document.getElementById('cards-container-tools');
    if (container) {
      container.addEventListener('mousemove', (e) => handleOnMouseMove(e, 'cards-container-tools'));
      container.addEventListener('mouseleave', () => {
        const cards = container.getElementsByClassName('card-spotlight');
        for (const card of cards as any) {
          card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(0px) scale(1)`;
          card.style.zIndex = '1';
        }
      });
    }

    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const categoryBtns = document.querySelectorAll('.category-btn');
    const toolCards = document.querySelectorAll('.tool-card');
    const emptyState = document.getElementById('empty-state');

    let activeCategory = 'All';

    const updateBtnStyles = () => {
      categoryBtns.forEach((b: any) => {
        const active = b.dataset.active === 'true';
        if (active) {
          b.className =
            'category-btn relative px-4 py-2 text-xs font-bold rounded-xl transition-all bg-purple-600/10 border border-purple-500/30 text-purple-400 audio-trigger';
        } else {
          b.className =
            'category-btn relative px-4 py-2 text-xs font-bold rounded-xl transition-all bg-[#0a0a0c]/80 text-zinc-400 border border-white/5 hover:border-white/10 hover:text-white audio-trigger';
        }
      });
    };

    function filterTools() {
      if (!searchInput || !emptyState) return;
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      toolCards.forEach((card: any) => {
        const name = card.dataset.name.toLowerCase();
        const category = card.dataset.category;
        const desc = card.querySelector('p').textContent.toLowerCase();

        const matchesSearch = !query || name.includes(query) || desc.includes(query);
        const matchesCategory = activeCategory === 'All' || category === activeCategory;
        const visible = matchesSearch && matchesCategory;

        card.classList.toggle('hidden', !visible);
        if (visible) visibleCount++;
      });

      emptyState.classList.toggle('hidden', visibleCount > 0);
    }

    if (searchInput) {
      searchInput.addEventListener('input', filterTools);
    }

    categoryBtns.forEach((btn: any) => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach((b: any) => (b.dataset.active = 'false'));
        btn.dataset.active = 'true';
        activeCategory = btn.dataset.category || 'All';
        updateBtnStyles();
        filterTools();
      });
    });
  };
  document.addEventListener('astro:page-load', initToolsPage);
</script>
