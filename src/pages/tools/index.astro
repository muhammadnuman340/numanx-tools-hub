---
import MainLayout from "../../layouts/MainLayout.astro";
import { tools, categories as categoryInfos } from "../../data/tools";
import AdUnit from "../../components/AdUnit.astro";

const categoryMap: Record<string, string> = {
  "image-tools": "Image Tools",
  "creator-tools": "Creator Tools",
  "utility-tools": "Utility Tools",
  "cricket-tools": "Cricket Tools",
  "ai-tools": "AI Tools",
  "developer-tools": "Developer Tools",
};

const categories = ["All", ...categoryInfos.map((c) => categoryMap[c.id] || c.title)];
---

<MainLayout
  title="Free Online Tools - NumanX Tools"
  description="Free online tools for image conversion, text analysis, QR codes, cricket calculators, creator utilities, and productivity. Fast, private, browser-based. No sign-up required."
  keywords="free online tools, image compressor, qr code generator, word counter, cricket calculator, password generator, hashtag generator, age calculator, png to webp, jpg to png, image resizer, online utilities free, browser tools no signup, productivity tools, best free online tools"
  canonical="https://numanx-tools.pages.dev/tools/"
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Tools", url: "/tools/" },
  ]}
>
  <main class="min-h-screen pt-8 pb-20 px-6 relative overflow-hidden">

    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-surface bg-surface-1 text-tertiary text-xs font-semibold tracking-wider uppercase mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75" />
            <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500" />
          </span>
          {tools.length} Free Tools
        </div>
        <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-none">
          Free Online
          <span class="block mt-2 bg-gradient-to-r from-purple-400 via-purple-500 to-blue-500 bg-clip-text text-transparent">
            Tools
          </span>
        </h1>
        <p class="mt-6 text-tertiary text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
          Every tool you need, all in one place.
          <span class="text-secondary"> Free, fast, and private.</span>
        </p>
      </div>

      <div class="max-w-4xl mx-auto px-4 mb-8">
        <AdUnit format="horizontal" class="mb-0" />
      </div>

      <div class="w-full max-w-xl mx-auto px-4 mt-8 space-y-4">
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-muted">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </span>
          <input
            id="search-input"
            type="text"
            placeholder="Search tools..."
            class="w-full bg-surface-1 text-white placeholder-zinc-500 pl-10 pr-4 py-3 rounded-xl border border-surface-2 focus:outline-none focus:border-purple-500/50 focus:ring-1 focus:ring-purple-500/30 transition-all text-sm"
          />
        </div>

        <div id="category-filters" class="flex flex-wrap gap-2 justify-center">
          {categories.map((cat, index) => (
            <button
              class="category-btn text-xs px-3 py-1.5 rounded-lg border transition-all"
              data-active={cat === "All"}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <div id="tools-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 px-4 py-8 max-w-7xl mx-auto">
        {tools.map((tool) => {
          const initials = tool.name.split(" ").map(w => w[0]).join("").slice(0, 2);
          const displayCat = categoryMap[tool.category] || tool.category;
          return (
          <div
            class="tool-card bg-surface-1 border border-surface p-5 rounded-2xl flex flex-col justify-between hover:border-purple-500/30 hover:bg-surface-2 transition-all group"
            data-name={tool.name}
            data-category={displayCat}
          >
            <div>
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-xl bg-purple-600/10 flex items-center justify-center text-purple-400 group-hover:scale-110 group-hover:bg-purple-600/20 transition-all">
                  <span class="font-bold text-sm">{initials}</span>
                </div>
                <h3 class="text-base font-semibold text-primary group-hover:text-purple-300 transition-colors">
                  {tool.name}
                </h3>
              </div>
              <p class="text-xs text-tertiary leading-relaxed">
                {tool.description}
              </p>
            </div>
            <a
              href={tool.url}
              class="mt-5 w-full bg-surface-2 hover:bg-purple-600 text-secondary hover:text-white text-xs font-medium py-2.5 rounded-xl border border-surface-2 hover:border-purple-500/50 text-center transition-all group-hover:scale-[1.02]"
            >
              Open Tool
            </a>
          </div>
          );
        })}

        <div id="empty-state" class="hidden col-span-full text-center py-20">
          <div class="w-16 h-16 rounded-2xl bg-zinc-800 flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-secondary">No tools found</h3>
          <p class="text-sm text-muted mt-1">Try adjusting your search or filter.</p>
        </div>
      </div>

      <div class="max-w-4xl mx-auto px-4 mt-8">
        <AdUnit format="horizontal" />
      </div>
    </div>
  </main>

</MainLayout>

<style>
  .category-btn[data-active="true"] {
    background: #7c3aed;
    border-color: #a855f7;
    color: white;
  }
  .category-btn[data-active="false"] {
    background: rgba(24, 24, 27, 0.4);
    border-color: #27272a;
    color: #a1a1aa;
  }
  .category-btn[data-active="false"]:hover {
    color: white;
    border-color: #3f3f46;
  }
</style>

<script>
  const searchInput = document.getElementById("search-input");
  const categoryBtns = document.querySelectorAll(".category-btn");
  const toolCards = document.querySelectorAll(".tool-card");
  const emptyState = document.getElementById("empty-state");

  let activeCategory = "All";

  function filterTools() {
    const query = searchInput.value.toLowerCase().trim();
    let visibleCount = 0;

    toolCards.forEach((card) => {
      const name = card.dataset.name.toLowerCase();
      const category = card.dataset.category;
      const desc = card.querySelector("p").textContent.toLowerCase();

      const matchesSearch = !query || name.includes(query) || desc.includes(query);
      const matchesCategory = activeCategory === "All" || category === activeCategory;
      const visible = matchesSearch && matchesCategory;

      card.classList.toggle("hidden", !visible);
      if (visible) visibleCount++;
    });

    emptyState.classList.toggle("hidden", visibleCount > 0);
  }

  searchInput.addEventListener("input", filterTools);

  categoryBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      categoryBtns.forEach((b) => b.dataset.active = "false");
      btn.dataset.active = "true";
      activeCategory = btn.dataset.category;
      filterTools();
    });
  });
</script>
