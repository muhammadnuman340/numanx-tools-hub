---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolsDirectoryGrid from '../../components/ToolsDirectoryGrid.astro';
import MonetizationSlot from '../../components/MonetizationSlot.astro';
import { tools } from '../../data/tools';
---

<MainLayout
  title="Free Online Tools Directory — All 51+ Utilities | NumanX Tools"
  description="Explore all 51+ free online tools for image optimization, text analysis, QR code generation, cricket analytics, creator utilities, and developer productivity. 100% private, client-side, and free."
  keywords="free online tools, image compressor, qr code generator, word counter, cricket calculator, password generator, hashtag generator, age calculator, png to webp, jpg to png, image resizer, online utilities free, browser tools no signup, productivity tools, best free online tools"
  canonical="https://numanx-tools.pages.dev/tools/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
  ]}
>
  <main class="min-h-screen pt-8 pb-24 px-4 sm:px-6 relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <!-- Header Banner -->
      <div class="text-center mb-10 pt-4">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-amber-500/20 bg-amber-500/10 text-amber-400 text-xs font-bold tracking-wider uppercase mb-6 shadow-[0_0_15px_rgba(251,191,36,0.1)]"
        >
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
          </span>
          {tools.length} Free Production Tools
        </div>
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight leading-none text-white">
          Free Online
          <span
            class="block mt-2 bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500 bg-clip-text text-transparent"
          >
            Tools Directory
          </span>
        </h1>
        <p class="mt-5 text-zinc-400 text-base md:text-lg max-w-2xl mx-auto leading-relaxed font-medium">
          Every utility runs 100% locally in your browser.
          <span class="text-white font-semibold"> Zero server uploads, instant execution, completely free.</span>
        </p>
      </div>

      <!-- Top Leaderboard Monetization Slot -->
      <div class="mb-10">
        <MonetizationSlot format="leaderboard" variant="auto" />
      </div>

      <!-- Static 51-Tool Directory Grid with Live Instant Filter -->
      <ToolsDirectoryGrid initialCategory="All" showMonetization={true} />

      <!-- Bottom Monetization Slot -->
      <div class="mt-14">
        <MonetizationSlot format="horizontal" variant="auto" />
      </div>
    </div>
  </main>
</MainLayout>
