---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";

const faqItems = [
  { question: "What does the HTML formatter do?", answer: "It takes messy or minified HTML and beautifies it with proper indentation and line breaks, making it readable and well-structured." },
  { question: "Is my HTML code stored or uploaded?", answer: "No. All processing happens entirely in your browser. Your HTML never leaves your device." },
  { question: "Does this work with malformed HTML?", answer: "It attempts to format any HTML-like content. For best results, use well-formed HTML. The formatter handles most common tag structures." },
];
const htmlSchema = { name: "HTML Formatter", applicationCategory: "Developer Tools", description: "Format and beautify HTML code with proper indentation. Minify HTML for production use.", featureList: ["Format HTML with proper indentation", "Minify for production", "Copy to clipboard", "100% client-side"] };
---
<MainLayout title="HTML Formatter - Format & Beautify HTML Online Free" description="Format and beautify your HTML code with proper indentation. Minify HTML for production. Free online HTML formatter." keywords="html formatter, html beautifier, html minifier, format html, html indentation" toolSchema={htmlSchema} faq={faqItems} breadcrumbs={[{name:"Home",url:"/"},{name:"Tools",url:"/tools/"},{name:"HTML Formatter",url:"/tools/html-formatter/"}]}>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden"><div class="max-w-4xl mx-auto">
    <ToolHeader title="HTML" gradient="Formatter Pro" desc="Format and beautify your HTML code with proper indentation. Minify HTML for production use." badge="✦ New Tool" slug="html-formatter" />
    <ShareBar />
    <div class="max-w-xl mx-auto mt-10">
      <div class="bg-surface-1 border border-surface rounded-2xl p-6 relative">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
            <span id="usage-badge" class="text-xs text-muted"></span>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex gap-1">
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="purple" style="background:#a855f7"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="blue" style="background:#3b82f6"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="green" style="background:#22c55e"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="pink" style="background:#ec4899"></button>
            </div>
            <button id="fullscreen-btn" class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs" title="Fullscreen">⛶</button>
          </div>
        </div>
        <label class="block text-xs font-medium text-tertiary mb-1.5">Input</label>
        <div class="flex items-center gap-1.5 mb-2">
          <button class="font-dec p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all">A−</button>
          <button class="font-inc p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all">A+</button>
          <span class="text-xs text-muted ml-auto">Ctrl+Enter to process</span>
        </div>
        <div class="flex">
          <div id="line-nums" class="text-xs text-muted text-right pr-2 select-none overflow-hidden font-mono leading-relaxed pt-3" style="min-width:2.5em">1</div>
          <textarea id="input-text" class="flex-1 h-32 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-green-500/50 focus:outline-none transition-all resize-none font-mono" placeholder="Paste your HTML code here..."></textarea>
        </div>
        <div id="reading-time" class="text-xs text-muted mt-1"></div>
        <div id="letter-freq" class="mt-2 space-y-0.5 max-h-24 overflow-y-auto hidden"></div>
        <div class="flex flex-wrap gap-2 mt-4">
          <button id="format-btn" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-green-600 text-white">Format</button>
          <button id="minify-btn" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary">Minify</button>
        </div>
        <div class="mt-6 pt-6 border-t border-surface">
          <label class="block text-xs font-medium text-tertiary mb-1.5">Result</label>
          <textarea id="output-text" class="w-full h-32 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:outline-none resize-none font-mono" readonly placeholder="Formatted HTML will appear here..."></textarea>
          <button id="copy-btn" class="mt-2 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all">Copy Result</button>
          <button id="share-btn" class="mt-2 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all" title="Copy share link">🔗</button>
          <button id="download-btn" class="mt-2 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all">Download</button>
          <select id="export-format" class="mt-2 bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5">
            <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option><option value="html">HTML</option>
          </select>
          <button id="clear-btn" class="mt-2 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all">Clear</button>
        </div>
      </div>
    </div>
    <section class="mt-20 max-w-3xl mx-auto"><div class="text-center mb-8"><span class="text-xs font-semibold text-green-400 uppercase tracking-wider">Learn</span><h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">Why Use an <span class="bg-gradient-to-r from-green-400 to-emerald-500 bg-clip-text text-transparent">HTML Formatter?</span></h2></div><div class="space-y-4 text-sm text-tertiary leading-relaxed"><p>Clean, properly indented HTML is essential for maintainability and debugging. Whether you're working with minified production code, legacy templates, or generated markup, an HTML formatter restores readability instantly — saving hours of manual cleanup.</p></div></section>
    <RelatedTools current="html-formatter" />
    <div class="mt-20 max-w-3xl mx-auto"><h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">Frequently Asked <span class="bg-gradient-to-r from-green-400 to-emerald-500 bg-clip-text text-transparent">Questions</span></h2><Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} /></div>
  </div></main>
</MainLayout>
<script>
  const input = document.getElementById("input-text");
  const output = document.getElementById("output-text");
  const copyBtn = document.getElementById("copy-btn");
  const formatBtn = document.getElementById("format-btn");
  const minifyBtn = document.getElementById("minify-btn");

  formatBtn.addEventListener("click", () => {
    const html = input.value;
    if (!html) { output.value = ""; return; }
    output.value = formatHTML(html);
  });

  minifyBtn.addEventListener("click", () => {
    const html = input.value;
    if (!html) { output.value = ""; return; }
    output.value = html
      .replace(/>\s+</g, "><")
      .replace(/\s{2,}/g, " ")
      .replace(/\s*\n\s*/g, "")
      .trim();
  });

  function formatHTML(html) {
    let indent = 0;
    const lines = [];
    const tokens = html.replace(/>\s*</g, ">\n<").split("\n");
    const selfClosing = /^(area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)$/i;
    for (const line of tokens) {
      const trimmed = line.trim();
      if (!trimmed) continue;
      const closes = trimmed.startsWith("</");
      const isSelfClosing = selfClosing.test(trimmed.replace(/<(\w+).*/,"$1"));
      if (closes) indent--;
      lines.push("  ".repeat(Math.max(0, indent)) + trimmed);
      if (!closes && !isSelfClosing && trimmed.endsWith(">") && !trimmed.endsWith("/>")) indent++;
    }
    return lines.join("\n");
  }

  function playPing(){try{const a=new(window.AudioContext||window.webkitAudioContext)();const o=a.createOscillator();const g=a.createGain();o.connect(g);g.connect(a.destination);o.frequency.value=800;g.gain.setValueAtTime(0.08,a.currentTime);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+0.12);o.start();o.stop(a.currentTime+0.12);}catch(e){}}
  document.getElementById("download-btn")?.addEventListener("click", () => {
    if (!output.value) return;
    const fmt = (document.getElementById("export-format") as HTMLSelectElement)?.value || "txt";
    const mimes = {txt:"text/plain",json:"application/json",csv:"text/csv",html:"text/html"};
    const content = fmt === "json" ? JSON.stringify(output.value) : output.value;
    const blob = new Blob([content], {type:mimes[fmt]||"text/plain"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "formatted." + fmt;
    a.click();
    playPing();
    URL.revokeObjectURL(a.href);
  });
  document.getElementById("clear-btn")?.addEventListener("click", () => {
    input.value = "";
    output.value = "";
    playPing();
  });
  copyBtn.addEventListener("click", async () => {
    if (!output.value) return;
    await navigator.clipboard.writeText(output.value);
    playPing();
    if (window.__showToast) window.__showToast({ message: "Copied!", variant: "success" });
  });
  document.getElementById("share-btn")?.addEventListener("click",()=>{const o=document.getElementById("output-text");const t=o?.value||"";if(!t)return;const u=window.location.origin+window.location.pathname+"#result="+encodeURIComponent(t.substring(0,200));navigator.clipboard.writeText(u).catch(()=>{});if(typeof (window as any).__showToast==="function")(window as any).__showToast({message:"Link copied!",variant:"success"});});
  document.querySelector(".font-inc")?.addEventListener("click",()=>{document.querySelectorAll("textarea").forEach(t=>{let s=parseInt(getComputedStyle(t).fontSize);t.style.fontSize=Math.min(24,s+2)+"px";})});
  document.querySelector(".font-dec")?.addEventListener("click",()=>{document.querySelectorAll("textarea").forEach(t=>{let s=parseInt(getComputedStyle(t).fontSize);t.style.fontSize=Math.max(10,s-2)+"px";})});
  try{const s=localStorage.getItem("nt_fs");if(s)document.querySelectorAll("textarea").forEach(t=>t.style.fontSize=s+"px")}catch(e){}
  document.addEventListener("keydown",e=>{if(e.ctrlKey&&e.key==="Enter"){e.preventDefault();const b=document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");if(b)b.click();}if(e.ctrlKey&&e.shiftKey&&(e.key==="C"||e.key==="c")){e.preventDefault();document.getElementById("clear-btn")?.click();}if(e.ctrlKey&&(e.key==="D"||e.key==="d")){e.preventDefault();document.getElementById("download-btn")?.click();}});
  try{const u=JSON.parse(localStorage.getItem("nt_tool_usage")||"{}");const b=document.getElementById("usage-badge");if(b&&u["html"])b.textContent="Used "+u["html"]+"×"}catch(e){}
  const rt=document.getElementById("input-text");if(rt){rt.addEventListener("input",()=>{const w=rt.value?rt.value.trim().split(/\s+/).length:0;const e=document.getElementById("reading-time");if(e)e.textContent=Math.max(1,Math.round(w/200))+" min read · "+Math.max(1,Math.round(w/150))+" min speak"});rt.dispatchEvent(new Event("input"));}
  const li=document.getElementById("input-text");if(li){const ul=()=>{const n=document.getElementById("line-nums");if(n)n.textContent=Array.from({length:li.value.split("\n").length},(_,i)=>i+1).join("\n")};li.addEventListener("input",ul);li.addEventListener("scroll",()=>{const n=document.getElementById("line-nums");if(n)n.scrollTop=li.scrollTop});ul();}
  const lf=document.getElementById("input-text");if(lf){lf.addEventListener("input",()=>{const t=lf.value.toLowerCase().replace(/[^a-z]/g,"");if(!t){document.getElementById("letter-freq")?.classList.add("hidden");return;}const f={};for(const c of t)f[c]=(f[c]||0)+1;const s=Object.entries(f).sort((a,b)=>b[1]-a[1]).slice(0,8);const m=s[0]?s[0][1]:1;const el=document.getElementById("letter-freq");el.classList.remove("hidden");el.innerHTML=s.map(([c,n])=>`<div class="flex items-center gap-1.5 text-xs"><span class="w-3 text-center font-mono text-white">${c}</span><div class="h-2 rounded-full bg-purple-500/50" style="width:${(n/m)*80+10}%"></div><span class="text-muted">${n}</span></div>`).join("")})}
  document.querySelectorAll(".theme-swatch").forEach(s=>{s.addEventListener("click",()=>{const c=s.dataset.color;document.querySelectorAll("button[class*='bg-green'],button[class*='bg-emerald']").forEach(b=>{b.className=b.className.replace(/bg-(green|emerald)-\d+/g,"bg-"+c+"-600").replace(/hover:bg-(green|emerald)-\d+/g,"hover:bg-"+c+"-500")});try{localStorage.setItem("nt_theme",c)}catch(e){}})});
  try{const c=localStorage.getItem("nt_theme");if(c)document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click()}catch(e){}
</script>
