---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";
import ToolContentSections from "../../components/ToolContentSections.astro";

const faqItems = [
  { question: "Does this tool use real AI?", answer: "No. All images are generated client-side using deterministic algorithms powered by your prompt text. Pixel Art uses seeded pseudo-random pixel placement, ASCII Art converts text to character-based patterns, Pattern creates geometric designs, and Geometric generates abstract shapes \u2014 all without any API calls or external services." },
  { question: "Can I use these images commercially?", answer: "Yes, all images generated with this tool are created locally in your browser with no external dependencies. You have full ownership and can use them for any purpose, including commercial projects, without attribution." },
  { question: "What image sizes are available?", answer: "You can choose from three sizes: 64\u00D764 (favicon/icon size), 128\u00D7128 (small avatar), and 256\u00D7256 (standard icon). All images are downloaded as transparent-background PNG files." },
  { question: "What is Pixel Art mode?", answer: "Pixel Art mode converts your text prompt into a seeded pseudo-random color map. Each word contributes to the color palette and pixel placement, creating unique retro-style pixel art every time." },
  { question: "How is ASCII Art generated?", answer: "ASCII Art mode maps text characters onto a grid using density patterns. The characters from your prompt are mixed with alphanumeric symbols and placed at random positions with varied gray shades." },
  { question: "Can I use the generated images in my projects?", answer: "Yes, all images are generated locally with no external dependencies. You have full ownership and can use them for any purpose, including commercial projects, without attribution." },
  { question: "What is the difference between Pattern and Geometric modes?", answer: "Pattern mode creates repeating designs like stripes, dots, and sine waves. Geometric mode composes random abstract shapes — circles, rectangles, and triangles — into unique compositions with varied transparency." },
];
const schema = { name: "AI Image Generator", applicationCategory: "Image", description: "Generate pixel art, ASCII art, patterns, and geometric images from text prompts \u2014 entirely in your browser, no AI API required.", featureList: ["Client-side generation", "Pixel Art mode", "ASCII Art mode", "Pattern mode", "Geometric mode", "PNG download"] };
---
<MainLayout title="AI Image Generator - Free Online Image Generator" description="Generate pixel art, ASCII art, patterns, and geometric images from text prompts \u2014 entirely in your browser." keywords="image generator, ai image, pixel art, ascii art, pattern generator, geometric art, online tool" toolSchema={schema} faq={faqItems} breadcrumbs={[{name:"Home",url:"/"},{name:"Tools",url:"/tools/"},{name:"AI Image Generator",url:"/tools/ai-image-generator/"}]}>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden"><div class="max-w-4xl mx-auto">
    <ToolHeader title="AI" gradient="Image Generator" desc="Generate pixel art, ASCII art, patterns, and geometric images from text prompts \u2014 all in your browser. No API calls or external services needed." badge="\u2726 New Tool" slug="ai-image-generator" />
    <ShareBar />
    <div class="max-w-xl mx-auto mt-10"><div class="bg-surface-1 border border-surface rounded-2xl p-6 relative">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
          <span id="usage-badge" class="text-xs text-muted"></span>
        </div>
        <div class="flex items-center gap-2">
          <div class="flex gap-1">
            <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="purple" style="background:#a855f7"></button>
            <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="blue" style="background:#3b82f6"></button>
            <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="green" style="background:#22c55e"></button>
            <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="pink" style="background:#ec4899"></button>
          </div>
          <button id="fullscreen-btn" class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs" title="Fullscreen">&#x26F6;</button>
        </div>
      </div>
      <div class="flex items-center gap-1.5 mb-2">
        <button class="font-dec p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all">A\u2212</button>
        <button class="font-inc p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all">A+</button>
        <span class="text-xs text-muted ml-auto">Ctrl+Enter to generate</span>
      </div>
      <textarea id="prompt-input" rows="3" placeholder="Describe the image you want to generate..." class="w-full bg-transparent text-white placeholder-zinc-600 p-4 resize-none focus:outline-none text-sm leading-relaxed border border-surface-2 rounded-xl mb-4"></textarea>
      <div id="reading-time" class="text-xs text-muted -mt-3 mb-2"></div>
      <div id="letter-freq" class="mt-2 space-y-0.5 max-h-24 overflow-y-auto hidden"></div>
      <div class="flex flex-wrap gap-2 mb-4" id="style-selector">
        <button data-style="pixel" class="style-btn px-4 py-2 rounded-lg text-xs font-semibold border transition-all bg-violet-600 text-white border-violet-500">Pixel Art</button>
        <button data-style="ascii" class="style-btn px-4 py-2 rounded-lg text-xs font-semibold border transition-all bg-surface-2 text-tertiary border-surface-3 hover:text-white">ASCII Art</button>
        <button data-style="pattern" class="style-btn px-4 py-2 rounded-lg text-xs font-semibold border transition-all bg-surface-2 text-tertiary border-surface-3 hover:text-white">Pattern</button>
        <button data-style="geometric" class="style-btn px-4 py-2 rounded-lg text-xs font-semibold border transition-all bg-surface-2 text-tertiary border-surface-3 hover:text-white">Geometric</button>
      </div>
      <div class="flex gap-3 mb-4">
        <select id="size-select" class="flex-1 bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-3 py-2.5">
          <option value="64">64 x 64</option>
          <option value="128" selected>128 x 128</option>
          <option value="256">256 x 256</option>
        </select>
        <button id="generate-btn" class="flex-1 py-3 rounded-xl font-bold text-sm bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-500 hover:to-purple-500 text-white transition-all duration-200 shadow-lg shadow-violet-600/20">Generate</button>
      </div>
      <div id="output-section" class="hidden mt-4">
        <div class="relative rounded-xl border border-surface-2 bg-surface-1 overflow-hidden flex items-center justify-center p-4">
          <canvas id="preview-canvas" class="max-w-full h-auto"></canvas>
        </div>
        <div class="flex items-center justify-between mt-2">
          <div class="flex gap-2">
            <button id="download-btn" class="px-3 py-1.5 bg-surface-2 hover:bg-surface-3 border border-surface-3 rounded-lg text-[10px] text-tertiary hover:text-primary transition-all">Download PNG</button>
            <button id="share-btn" class="px-2.5 py-1.5 bg-surface-2 hover:bg-surface-3 border border-surface-3 rounded-lg text-[10px] text-tertiary hover:text-primary transition-all" title="Copy share link">&#x1F517;</button>
            <button id="clear-btn" class="px-3 py-1.5 bg-surface-2 hover:bg-surface-3 border border-surface-3 rounded-lg text-[10px] text-tertiary hover:text-primary transition-all">Clear</button>
          </div>
          <span id="size-info" class="text-xs text-tertiary"></span>
        </div>
      </div>
    </div></div>
    <section class="mt-20 max-w-3xl mx-auto"><div class="text-center mb-8"><span class="text-xs font-semibold text-violet-400 uppercase tracking-wider">Generation Engine</span><h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">How It <span class="bg-gradient-to-r from-violet-400 to-purple-500 bg-clip-text text-transparent">Works</span></h2></div><div class="space-y-4 text-sm text-tertiary leading-relaxed"><p>The AI Image Generator uses four distinct client-side rendering engines. <strong class="text-primary">Pixel Art</strong> converts your prompt into a seeded pseudo-random color map and draws individual pixels. <strong class="text-primary">ASCII Art</strong> maps text characters onto a grid using density patterns. <strong class="text-primary">Pattern</strong> generates repeating geometric motifs like stripes, dots, and waves. <strong class="text-primary">Geometric</strong> composes random shapes into abstract compositions.</p><p>Everything runs locally in your browser using the HTML5 Canvas API. No images are sent to any server, ensuring complete privacy.</p></div></section>
    <RelatedTools current="ai-image-generator" />
    <div class="mt-20 max-w-3xl mx-auto"><h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">Frequently Asked <span class="bg-gradient-to-r from-violet-400 to-purple-500 bg-clip-text text-transparent">Questions</span></h2><Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} /></div>
  </div></main>
</MainLayout>
<script>
function playPing(){ try{const a=new(window.AudioContext||window.webkitAudioContext)();const o=a.createOscillator();const g=a.createGain();o.connect(g);g.connect(a.destination);o.frequency.value=800;g.gain.setValueAtTime(0.08,a.currentTime);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+0.12);o.start();o.stop(a.currentTime+0.12);}catch(e){} }

function hashSeed(text){let h=0;for(let i=0;i<text.length;i++){h=((h<<5)-h)+text.charCodeAt(i);h|=0;}return Math.abs(h);}

function seededRandom(seed){let s=seed;return function(){s=(s*1103515245+12345)&0x7fffffff;return s/0x7fffffff;};}

function generatePixelArt(prompt,size,canvas){
  const ctx=canvas.getContext("2d");canvas.width=size;canvas.height=size;
  const seed=hashSeed(prompt);const rand=seededRandom(seed);
  const palette=[[255,99,132],[54,162,235],[255,206,86],[75,192,192],[153,102,255],[255,159,64],[46,204,113],[231,76,60],[52,152,219],[155,89,182],[26,188,156],[241,196,15]];
  const ps=Math.max(1,size/16);
  for(let y=0;y<size;y+=ps){for(let x=0;x<size;x+=ps){const ci=Math.floor(rand()*palette.length);const[r,g,b]=palette[ci];ctx.fillStyle=`rgb(${r},${g},${b})`;ctx.fillRect(x,y,ps,ps);}}
  const words=prompt.split(/\s+/).filter(w=>w.length>0);
  for(let i=0;i<words.length*3;i++){const x=Math.floor(rand()*(size/ps))*ps;const y=Math.floor(rand()*(size/ps))*ps;const w=ps*(1+Math.floor(rand()*3));const h=ps*(1+Math.floor(rand()*3));const ci=Math.floor(rand()*palette.length);const[r,g,b]=palette[ci];ctx.fillStyle=`rgb(${r},${g},${b})`;ctx.fillRect(x,y,w,h);}
}

function generateAsciiArt(prompt,size,canvas){
  const ctx=canvas.getContext("2d");canvas.width=size;canvas.height=size;
  const seed=hashSeed(prompt);const rand=seededRandom(seed+42);
  const fs=Math.max(4,size/16);ctx.font=fs+"px monospace";
  ctx.fillStyle="#000";ctx.fillRect(0,0,size,size);
  const cols=Math.floor(size/fs);const rows=Math.floor(size/fs);
  const pool=(prompt||"ascii").split("").concat("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".split(""));
  for(let r=0;r<rows;r++){for(let c=0;c<cols;c++){const idx=Math.floor(rand()*pool.length);const ch=pool[idx];const gray=Math.floor(rand()*200+55);ctx.fillStyle=`rgb(${gray},${gray},${gray})`;ctx.fillText(ch,c*fs,(r+1)*fs-2);}}
}

function generatePattern(prompt,size,canvas){
  const ctx=canvas.getContext("2d");canvas.width=size;canvas.height=size;
  const seed=hashSeed(prompt)||1;const rand=seededRandom(seed+99);
  const colors=["#ff6384","#36a2eb","#ffce56","#4bc0c0","#9966ff","#ff9f40"];
  ctx.fillStyle=colors[Math.floor(rand()*colors.length)];ctx.fillRect(0,0,size,size);
  const pt=Math.floor(rand()*3);const fg=colors[(Math.floor(rand()*colors.length)+1)%colors.length];
  if(pt===0){const sp=Math.max(4,Math.floor(rand()*12)+4);ctx.strokeStyle=fg;ctx.lineWidth=Math.max(1,Math.floor(rand()*4)+1);for(let i=0;i<size;i+=sp){ctx.beginPath();ctx.moveTo(i,0);ctx.lineTo(i,size);ctx.stroke();}}
  else if(pt===1){const sp=Math.max(6,Math.floor(rand()*10)+6);const r=Math.max(1,Math.floor(rand()*4)+1);ctx.fillStyle=fg;for(let y=sp;y<size;y+=sp){for(let x=sp;x<size;x+=sp){ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fill();}}}
  else{ctx.strokeStyle=fg;ctx.lineWidth=2;for(let y=0;y<size;y+=12){ctx.beginPath();for(let x=0;x<=size;x++){const yy=y+Math.sin((x+seed)*0.1)*6;x===0?ctx.moveTo(x,yy):ctx.lineTo(x,yy);}ctx.stroke();}}
}

function generateGeometric(prompt,size,canvas){
  const ctx=canvas.getContext("2d");canvas.width=size;canvas.height=size;
  const seed=hashSeed(prompt)||1;const rand=seededRandom(seed+77);
  const palette=["#ff6384","#36a2eb","#ffce56","#4bc0c0","#9966ff","#ff9f40","#e74c3c","#2ecc71"];
  ctx.fillStyle="#1a1a2e";ctx.fillRect(0,0,size,size);
  const count=Math.floor(rand()*20)+10;
  for(let i=0;i<count;i++){const shape=Math.floor(rand()*3);const x=rand()*size;const y=rand()*size;const w=rand()*(size*0.3)+5;const h=rand()*(size*0.3)+5;const color=palette[Math.floor(rand()*palette.length)];ctx.fillStyle=color;ctx.globalAlpha=rand()*0.6+0.2;if(shape===0){ctx.beginPath();ctx.arc(x,y,w/2,0,Math.PI*2);ctx.fill();}else if(shape===1){ctx.fillRect(x,y,w,h);}else{ctx.beginPath();ctx.moveTo(x,y-h/2);ctx.lineTo(x+w/2,y+h/2);ctx.lineTo(x-w/2,y+h/2);ctx.closePath();ctx.fill();}}
  ctx.globalAlpha=1;
}

function generateImage(prompt,style,size,canvas){
  if(!prompt.trim()){if(window.__showToast)window.__showToast({message:"Please enter a prompt",variant:"warning"});return;}
  if(style==="pixel")generatePixelArt(prompt,size,canvas);else if(style==="ascii")generateAsciiArt(prompt,size,canvas);else if(style==="pattern")generatePattern(prompt,size,canvas);else if(style==="geometric")generateGeometric(prompt,size,canvas);
  document.getElementById("output-section").classList.remove("hidden");
  document.getElementById("size-info").textContent=size+"\u00D7"+size+" px";
}

let currentStyle="pixel";

document.querySelectorAll(".style-btn").forEach(btn=>{
  btn.addEventListener("click",()=>{
    document.querySelectorAll(".style-btn").forEach(b=>{b.className="style-btn px-4 py-2 rounded-lg text-xs font-semibold border transition-all bg-surface-2 text-tertiary border-surface-3 hover:text-white";});
    btn.className="style-btn px-4 py-2 rounded-lg text-xs font-semibold border transition-all bg-violet-600 text-white border-violet-500";
    currentStyle=btn.dataset.style;
  });
});

document.getElementById("generate-btn").addEventListener("click",()=>{
  const prompt=document.getElementById("prompt-input").value;
  const size=parseInt(document.getElementById("size-select").value)||128;
  const canvas=document.getElementById("preview-canvas");
  generateImage(prompt,currentStyle,size,canvas);
  playPing();if(window.__showToast)window.__showToast({message:"Image generated!",variant:"success"});
});

document.getElementById("download-btn").addEventListener("click",()=>{
  const canvas=document.getElementById("preview-canvas");
  if(!canvas.width||!canvas.height){if(window.__showToast)window.__showToast({message:"Nothing to download!",variant:"warning"});return;}
  const link=document.createElement("a");link.download="ai-generated-image.png";link.href=canvas.toDataURL("image/png");link.click();
  playPing();if(window.__showToast)window.__showToast({message:"Downloaded!",variant:"success"});
});

document.getElementById("clear-btn")?.addEventListener("click",()=>{
  document.getElementById("prompt-input").value="";document.getElementById("output-section").classList.add("hidden");
  const canvas=document.getElementById("preview-canvas");canvas.width=0;canvas.height=0;
  document.getElementById("prompt-input").focus();
  playPing();if(window.__showToast)window.__showToast({message:"Cleared!",variant:"info"});
});

document.getElementById("fullscreen-btn")?.addEventListener("click",()=>{
  const card=document.getElementById("fullscreen-btn").closest(".bg-surface-1.border.border-surface.rounded-2xl")||document.getElementById("fullscreen-btn").closest("[class*='bg-surface-1']");
  if(!card)return;
  if(document.fullscreenElement){document.exitFullscreen();document.getElementById("fullscreen-btn").textContent="\u26F6";}
  else{card.requestFullscreen?.()||card.webkitRequestFullscreen?.();document.getElementById("fullscreen-btn").textContent="\u2715";}
});
document.addEventListener("fullscreenchange",()=>{const btn=document.getElementById("fullscreen-btn");if(btn)btn.textContent=document.fullscreenElement?"\u2715":"\u26F6";});

const DRAFT_KEY="nt_draft_ai-image-generator";
(function(){const input=document.getElementById("prompt-input")||document.querySelector("textarea:not([readonly])");if(!input)return;try{const saved=localStorage.getItem(DRAFT_KEY);if(saved&&!input.value){input.value=saved;input.dispatchEvent(new Event("input"));}}catch(e){}let saveTimer;input.addEventListener("input",()=>{clearTimeout(saveTimer);saveTimer=setTimeout(()=>{try{localStorage.setItem(DRAFT_KEY,input.value);}catch(e){}},500);});})();

document.querySelector(".font-inc")?.addEventListener("click",()=>{document.querySelectorAll("textarea").forEach(t=>{let s=parseInt(getComputedStyle(t).fontSize);t.style.fontSize=Math.min(24,s+2)+"px";});});
document.querySelector(".font-dec")?.addEventListener("click",()=>{document.querySelectorAll("textarea").forEach(t=>{let s=parseInt(getComputedStyle(t).fontSize);t.style.fontSize=Math.max(10,s-2)+"px";});});
try{const s=localStorage.getItem("nt_fs");if(s)document.querySelectorAll("textarea").forEach(t=>t.style.fontSize=s+"px");}catch(e){}

document.addEventListener("keydown",e=>{if(e.ctrlKey&&e.key==="Enter"){e.preventDefault();const b=document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])")||document.querySelector("button[class*='bg-']:not([id*='full']):not([id*='paste'])");if(b)b.click();}});

try{const u=JSON.parse(localStorage.getItem("nt_tool_usage")||"{}");const b=document.getElementById("usage-badge");if(b&&u["ai-image-generator"])b.textContent="Used "+u["ai-image-generator"]+"\u00D7";}catch(e){}

document.getElementById("share-btn")?.addEventListener("click",()=>{const c=document.getElementById("preview-canvas");if(!c.width||!c.height)return;const u=window.location.origin+window.location.pathname+"#result="+encodeURIComponent(c.toDataURL("image/png").substring(0,200));navigator.clipboard.writeText(u).catch(()=>{});if(typeof window.__showToast==="function")window.__showToast({message:"Link copied!"});});

const rtInput=document.getElementById("prompt-input")||document.querySelector("textarea:not([readonly])");
if(rtInput){rtInput.addEventListener("input",()=>{const w=rtInput.value?rtInput.value.trim().split(/\s+/).length:0;const e=document.getElementById("reading-time");if(e)e.textContent=Math.max(1,Math.round(w/200))+" min read \u00B7 "+Math.max(1,Math.round(w/150))+" min speak";});rtInput.dispatchEvent(new Event("input"));}

const lfInput=document.getElementById("prompt-input");
if(lfInput){lfInput.addEventListener("input",()=>{const t=lfInput.value.toLowerCase().replace(/[^a-z]/g,"");if(!t){document.getElementById("letter-freq").classList.add("hidden");return;}const f={};for(const c of t)f[c]=(f[c]||0)+1;const s=Object.entries(f).sort((a,b)=>b[1]-a[1]).slice(0,8);const m=s[0]?s[0][1]:1;const el=document.getElementById("letter-freq");el.classList.remove("hidden");el.innerHTML=s.map(([c,n])=>`<div class="flex items-center gap-1.5 text-xs"><span class="w-3 text-center font-mono text-white">${c}</span><div class="h-2 rounded-full bg-purple-500/50" style="width:${(n/m)*80+10}%"></div><span class="text-muted">${n}</span></div>`).join("");});}

document.querySelectorAll(".theme-swatch").forEach(s=>{s.addEventListener("click",()=>{const c=s.dataset.color;document.querySelectorAll("button[class*='bg-purple'],button[class*='bg-violet']").forEach(b=>{b.className=b.className.replace(/bg-(purple|violet)-\d+/g,"bg-"+c+"-600").replace(/hover:bg-(purple|violet)-\d+/g,"hover:bg-"+c+"-500").replace(/from-(purple|violet)-\d+/g,"from-"+c+"-500").replace(/to-purple-\d+/g,"to-"+c+"-600");});try{localStorage.setItem("nt_theme",c);}catch(e){}});});
try{const c=localStorage.getItem("nt_theme");if(c)document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();}catch(e){}
</script>
