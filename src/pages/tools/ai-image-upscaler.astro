---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'How does AI image upscaling work?',
    answer: 'The tool uses a neural network (ESRGAN) to analyze the low-resolution image and "guess" missing details by predicting how the image should look at a higher resolution, rather than just stretching the pixels.',
  },
  {
    question: 'Are my images uploaded to the cloud?',
    answer: 'No! The AI model runs completely on your device using TensorFlow.js. Your images never leave your browser, ensuring total privacy.',
  },
  {
    question: 'Why is it slow or why did my browser crash?',
    answer: 'AI upscaling is extremely computationally heavy. If you try to upscale a very large image, your browser may run out of memory. This tool is best used for small images (under 500x500 pixels).',
  },
  {
    question: 'How much larger will the image get?',
    answer: 'Our default model increases the resolution of your image by 2x in both width and height (4x total pixels).',
  },
];

const schema = {
  name: 'AI Image Upscaler',
  applicationCategory: 'Multimedia',
  description: 'Enhance and upscale images locally in your browser using AI (ESRGAN).',
  featureList: [
    '100% client-side upscaling (no uploads)',
    '2x Super Resolution (ESRGAN)',
    'Privacy-first architecture',
    'TensorFlow.js Edge AI integration',
  ],
};

const benefits = [
  {
    icon: '🔍',
    title: 'Enhance Detail',
    desc: 'Breathe new life into blurry or low-resolution images by using neural networks to intelligently generate missing details.',
  },
  {
    icon: '🔒',
    title: 'Absolute Privacy',
    desc: 'Unlike traditional upscalers that require you to upload your personal photos, our Edge AI runs directly on your device.',
  },
  {
    icon: '⚡',
    title: 'No Hidden Fees',
    desc: 'Because you are providing the computing power, there are no server costs, meaning we can offer this tool completely for free.',
  },
  {
    icon: '🖼️',
    title: 'Clean Results',
    desc: 'Neural upscaling avoids the pixelated or "blocky" artifacts associated with traditional resizing methods.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Upload Image',
    desc: 'Select a small, low-resolution image (we recommend starting with images under 500x500 pixels to prevent browser crashes).',
  },
  {
    num: '2',
    title: 'Initialize Engine',
    desc: 'When you upload an image for the first time, your browser will download the TensorFlow AI model (approx 20MB).',
  },
  {
    num: '3',
    title: 'Wait for Upscaling',
    desc: 'The AI will process your image block by block. This can take several seconds depending on your device\'s GPU.',
  },
  {
    num: '4',
    title: 'Download Result',
    desc: 'Once complete, you can view the before/after comparison and download the 2x enhanced image to your computer.',
  },
];

const useCases = [
  {
    icon: '📱',
    title: 'Social Media',
    desc: 'Upscale old photos or memes that have been compressed too many times, making them crisp for modern displays.',
  },
  {
    icon: '🎨',
    title: 'Digital Art',
    desc: 'Enlarge small AI-generated art or pixel art without losing the core aesthetic or introducing heavy blurring.',
  },
  {
    icon: '💻',
    title: 'Web Assets',
    desc: 'Enhance small icons or legacy graphics for use in modern, high-DPI web designs.',
  },
];
---

<MainLayout
  title="AI Image Upscaler — Enhance Photos Free | NumanX"
  description="Upscale and enhance images directly in your browser using Edge AI. 100% private, no server uploads required."
  keywords="ai image upscaler, free image enhancer, super resolution, tensorflow.js upscaler"
  toolSchema={schema}
  faq={faqItems}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'AI Image Upscaler', url: '/tools/ai-image-upscaler/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-5xl mx-auto">
      <ToolHeader
        title="AI Image"
        gradient="Upscaler"
        desc="Enhance and enlarge low-resolution images directly on your device using neural networks."
        badge="✦ Edge AI"
        slug="ai-image-upscaler"
      />
      <ShareBar />
      
      <div class="w-full max-w-4xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6 relative">
           
           <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl p-4 mb-6 flex gap-3 items-start">
             <span class="text-amber-500 text-xl">⚠️</span>
             <div>
               <h2 class="text-amber-500 font-semibold text-sm">Browser Memory Warning</h2>
               <p class="text-xs text-amber-500/80 mt-1">AI upscaling is extremely intensive. We strongly recommend uploading images <b>smaller than 500x500 pixels</b>. Very large images will cause your browser to crash or freeze.</p>
             </div>
           </div>

           <div id="dropzone" class="relative rounded-2xl border-2 border-dashed border-surface-3 bg-surface-1 p-10 md:p-16 text-center cursor-pointer hover:border-emerald-500/50 hover:bg-surface-2 transition-all duration-300 group">
            <input id="file-input" type="file" accept="image/*" class="hidden" aria-label="Upload image to upscale" />
            <div id="dropzone-content">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-600/20 to-teal-600/20 flex items-center justify-center mx-auto mb-5 group-hover:scale-110 transition-transform duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
              </div>
              <h2 class="text-lg font-semibold text-primary mb-2">Drop a small image here</h2>
              <p class="text-sm text-muted mb-4">
                or <span class="text-emerald-400 underline underline-offset-2 font-medium">browse files</span>
              </p>
              <p class="text-xs text-emerald-500 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full inline-block">2x AI Super Resolution</p>
            </div>
            
            <div id="loading-state" class="hidden flex-col items-center justify-center space-y-4">
               <div class="w-12 h-12 border-4 border-emerald-500/30 border-t-emerald-500 rounded-full animate-spin"></div>
               <p id="loading-text" class="text-sm font-medium text-white">Initializing AI Engine...</p>
               <div class="w-full max-w-xs bg-surface-3 rounded-full h-2 mt-2 hidden" id="progress-bar-container">
                  <div class="bg-emerald-500 h-2 rounded-full" style="width: 0%" id="progress-bar"></div>
               </div>
               <p class="text-xs text-muted text-center max-w-xs">This might take up to a minute depending on your device's GPU.</p>
            </div>
          </div>
          
          <div id="result-section" class="hidden mt-8 space-y-6">
             <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <h3 class="text-sm font-semibold text-tertiary mb-3 text-center">Original <span id="orig-size" class="text-muted font-normal"></span></h3>
                  <div class="rounded-xl overflow-hidden border border-surface-2 bg-black/20 aspect-square flex items-center justify-center p-2 relative">
                     <img id="original-preview" alt="Original uploaded low-resolution image preview" class="max-w-full max-h-full object-contain rounded-lg" style="image-rendering: pixelated;" />
                  </div>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-tertiary mb-3 text-center">2x Upscaled <span id="up-size" class="text-emerald-400 font-normal"></span></h3>
                  <div class="rounded-xl overflow-hidden border border-surface-2 bg-black/20 aspect-square flex items-center justify-center relative p-2">
                     <img id="result-preview" alt="AI upscaled high-resolution image preview" class="max-w-full max-h-full object-contain drop-shadow-2xl rounded-lg" />
                  </div>
                </div>
             </div>
             
             <div class="flex justify-center pt-4 border-t border-surface">
                <button id="download-btn" class="bg-gradient-to-r from-emerald-600 to-teal-600 hover:opacity-90 text-white font-bold px-8 py-3 rounded-xl shadow-lg shadow-emerald-900/30 transition-all active:scale-95 flex items-center gap-2">
                   <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                   Download Enhanced Image
                </button>
             </div>
          </div>
        </div>
      </div>
      
      <ToolContentSections
        toolSlug="ai-image-upscaler"
        toolName="AI Image Upscaler"
        category="Multimedia"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />
      <RelatedTools current="ai-image-upscaler" />
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span class="bg-gradient-to-r from-emerald-400 to-teal-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>

<script>
  let upscalerInstance: any = null;

  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('file-input');
  const dropzoneContent = document.getElementById('dropzone-content');
  const loadingState = document.getElementById('loading-state');
  const loadingText = document.getElementById('loading-text');
  const progressBarContainer = document.getElementById('progress-bar-container');
  const progressBar = document.getElementById('progress-bar');
  const resultSection = document.getElementById('result-section');
  const originalPreview = document.getElementById('original-preview') as HTMLImageElement;
  const resultPreview = document.getElementById('result-preview') as HTMLImageElement;
  const origSize = document.getElementById('orig-size');
  const upSize = document.getElementById('up-size');
  const downloadBtn = document.getElementById('download-btn');
  
  let currentFile: File | null = null;
  let resultBlobURL: string | null = null;

  dropzone?.addEventListener('click', () => {
    if(!loadingState?.classList.contains('hidden')) return;
    fileInput?.click();
  });
  
  fileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) processImage(file);
  });
  
  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    if(!loadingState?.classList.contains('hidden')) return;
    dropzone.classList.add('border-emerald-500', 'bg-surface-2');
  });
  
  dropzone?.addEventListener('dragleave', () => dropzone.classList.remove('border-emerald-500', 'bg-surface-2'));
  
  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-emerald-500', 'bg-surface-2');
    if(!loadingState?.classList.contains('hidden')) return;
    const file = e.dataTransfer?.files?.[0];
    if (file && file.type.startsWith('image/')) processImage(file);
  });

  async function processImage(file: File) {
    currentFile = file;
    dropzoneContent?.classList.add('hidden');
    loadingState?.classList.remove('hidden');
    loadingState?.classList.add('flex');
    resultSection?.classList.add('hidden');
    
    // Check image size before processing to prevent massive crashes
    const bitmap = await createImageBitmap(file);
    if(bitmap.width > 800 || bitmap.height > 800) {
      if ((window as any).__showToast) {
        (window as any).__showToast({ message: 'Image too large. Please use an image smaller than 800x800 for browser-based upscaling.', variant: 'error' });
      } else {
        alert('Image too large. Please use an image smaller than 800x800.');
      }
      resetState();
      return;
    }

    if(origSize) origSize.textContent = `(${bitmap.width}x${bitmap.height})`;
    if(upSize) upSize.textContent = `(${bitmap.width*2}x${bitmap.height*2})`;

    // Set original preview
    const objectURL = URL.createObjectURL(file);
    originalPreview.src = objectURL;
    
    try {
      if(!upscalerInstance) {
        loadingText!.textContent = "Downloading AI Model (approx 20MB)...";
        // Dynamically import Upscaler via unpkg to avoid Astro/Vite static build errors with TFJS
        const Upscaler = (await import('https://unpkg.com/upscaler@1.0.0-beta.18/dist/browser/umd/upscaler.min.js' as any)).default;
        upscalerInstance = new Upscaler();
      }
      
      loadingText!.textContent = "Upscaling Image (this may take a minute)...";
      progressBarContainer?.classList.remove('hidden');
      
      const upscaledImgSrc = await upscalerInstance.upscale(originalPreview, {
        patchSize: 64,
        padding: 2,
        progress: (amount: number) => {
            const percent = Math.round(amount * 100);
            if(progressBar) progressBar.style.width = `${percent}%`;
            loadingText!.textContent = `Upscaling... ${percent}%`;
        }
      });
      
      resultPreview.src = upscaledImgSrc;
      
      // Save for download
      fetch(upscaledImgSrc)
        .then(res => res.blob())
        .then(blob => {
          if(resultBlobURL) URL.revokeObjectURL(resultBlobURL);
          resultBlobURL = URL.createObjectURL(blob);
        });
      
      loadingState?.classList.add('hidden');
      loadingState?.classList.remove('flex');
      resultSection?.classList.remove('hidden');
      dropzoneContent?.classList.remove('hidden');
      progressBarContainer?.classList.add('hidden');
      if(fileInput) (fileInput as HTMLInputElement).value = ''; 
      
    } catch (err) {
      console.error(err);
      resetState();
      if ((window as any).__showToast) {
        (window as any).__showToast({ message: 'Failed to upscale image. Your browser might have run out of memory.', variant: 'error' });
      } else {
        alert('Failed to upscale image.');
      }
    }
  }

  function resetState() {
      loadingState?.classList.add('hidden');
      loadingState?.classList.remove('flex');
      dropzoneContent?.classList.remove('hidden');
      progressBarContainer?.classList.add('hidden');
      if(fileInput) (fileInput as HTMLInputElement).value = '';
  }

  downloadBtn?.addEventListener('click', () => {
    if (!resultBlobURL) return;
    const a = document.createElement('a');
    a.href = resultBlobURL;
    a.download = `upscaled-${Date.now()}.png`;
    a.click();
  });
</script>
