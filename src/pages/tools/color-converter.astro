---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'What color formats are supported?',
    answer: 'HEX (with and without #), RGB (rgb(r,g,b)), HSL (hsl(h,s%,l%)), and HEX with alpha (RGBA equivalent).',
  },
  {
    question: 'Can I pick a color visually?',
    answer:
      'Yes, use the color picker input to select a color visually. The equivalent values in all formats update instantly.',
  },
  {
    question: 'Why do HSL values differ between tools?',
    answer:
      'HSL is a cylindrical representation of RGB. All conversions follow the standard CSS specification for consistency.',
  },
];
const cSchema = {
  name: 'Color Converter',
  applicationCategory: 'Utilities',
  description: 'Convert colors between HEX, RGB, and HSL formats with live preview.',
  featureList: ['HEX, RGB, HSL conversion', 'Live color preview', 'Visual color picker', 'Copy values instantly'],
};

const benefits = [
  {
    icon: '🎨',
    title: 'Multiple Formats',
    desc: 'Seamlessly convert colors between HEX, RGB, HSL, and CMYK formats in real-time.',
  },
  {
    icon: '👁️',
    title: 'Live Preview',
    desc: 'Instantly see the visual representation of your color code as you type or adjust values.',
  },
  {
    icon: '🖱️',
    title: 'Visual Picker',
    desc: 'Use the intuitive color picker to visually select a color and generate its exact codes.',
  },
  {
    icon: '🔒',
    title: '100% Client-Side',
    desc: 'All conversions happen securely in your browser without any server communication.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Input Color',
    desc: 'Type your color into any of the format fields (HEX, RGB, HSL, or CMYK), or use the visual picker.',
  },
  {
    num: '2',
    title: 'View Conversion',
    desc: 'Watch as all other color format fields automatically update instantly.',
  },
  {
    num: '3',
    title: 'Preview',
    desc: 'Check the visual color swatch to ensure the color matches your expectations.',
  },
  {
    num: '4',
    title: 'Copy or Export',
    desc: 'Click Copy HEX to grab the web-ready code, or Download to save all format values.',
  },
];

const useCases = [
  {
    icon: '💻',
    title: 'Web Development',
    desc: 'Convert graphic design files (which often use HEX or CMYK) into CSS-friendly RGB or HSL formats.',
  },
  {
    icon: '📐',
    title: 'Graphic Design',
    desc: 'Translate web colors back to CMYK values for print media and branding guidelines.',
  },
  {
    icon: '🌈',
    title: 'Theme Creation',
    desc: 'Use HSL values to easily generate lighter or darker shades for a cohesive UI theme.',
  },
];
---

<MainLayout
  title="Color Converter - HEX to RGB to HSL Converter Online"
  description="Convert colors between HEX, RGB, and HSL formats with a live color preview. Free online color converter."
  keywords="color converter, hex to rgb, rgb to hex, color picker, hsl"
  toolSchema={cSchema}
  faq={faqItems}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Color Converter', url: '/tools/color-converter/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="Color"
        gradient="Converter Pro"
        desc="Convert colors between HEX, RGB, and HSL formats with a live color preview and visual picker."
        badge="✦ New Tool"
        slug="color-converter"
      />
      <ShareBar />
      <div class="max-w-xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
              <span id="usage-badge" class="text-xs text-muted"></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex gap-1">
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="purple"
                  style="background:#a855f7"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="blue"
                  style="background:#3b82f6"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="green"
                  style="background:#22c55e"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="pink"
                  style="background:#ec4899"></button>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-4 mb-6">
            <input
              id="color-picker"
              type="color"
              value="#7c3aed"
              class="w-16 h-16 rounded-xl border border-surface-2 cursor-pointer bg-transparent"
            />
            <div class="flex-1">
              <label class="block text-xs font-medium text-tertiary mb-1.5">HEX</label>
              <input
                id="hex-input"
                type="text"
                value="#7c3aed"
                class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm font-mono focus:border-purple-500/50 focus:outline-none transition-all"
              />
            </div>
          </div>
          <div class="space-y-4">
            <div>
              <label class="block text-xs font-medium text-tertiary mb-1.5">RGB</label>
              <div class="flex gap-2">
                <input
                  id="r-input"
                  type="number"
                  min="0"
                  max="255"
                  value="124"
                  class="flex-1 px-3 py-2.5 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm text-center focus:border-purple-500/50 focus:outline-none"
                /><span class="text-muted self-center">,</span><input
                  id="g-input"
                  type="number"
                  min="0"
                  max="255"
                  value="58"
                  class="flex-1 px-3 py-2.5 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm text-center focus:border-purple-500/50 focus:outline-none"
                /><span class="text-muted self-center">,</span><input
                  id="b-input"
                  type="number"
                  min="0"
                  max="255"
                  value="237"
                  class="flex-1 px-3 py-2.5 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm text-center focus:border-purple-500/50 focus:outline-none"
                />
              </div>
            </div>
            <div>
              <label class="block text-xs font-medium text-tertiary mb-1.5">HSL</label>
              <div class="flex gap-2">
                <input
                  id="h-input"
                  type="number"
                  min="0"
                  max="360"
                  value="263"
                  class="flex-1 px-3 py-2.5 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm text-center focus:border-purple-500/50 focus:outline-none"
                /><span class="text-muted self-center text-xs">H</span><input
                  id="s-input"
                  type="number"
                  min="0"
                  max="100"
                  value="83"
                  class="flex-1 px-3 py-2.5 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm text-center focus:border-purple-500/50 focus:outline-none"
                /><span class="text-muted self-center text-xs">%</span><input
                  id="l-input"
                  type="number"
                  min="0"
                  max="100"
                  value="58"
                  class="flex-1 px-3 py-2.5 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm text-center focus:border-purple-500/50 focus:outline-none"
                /><span class="text-muted self-center text-xs">%</span>
              </div>
            </div>
            <div>
              <label class="block text-xs font-medium text-tertiary mb-1.5">CMYK</label>
              <div class="flex gap-2">
                <input
                  id="cmyk-c"
                  type="number"
                  min="0"
                  max="100"
                  value="48"
                  class="flex-1 px-3 py-2.5 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm text-center focus:border-purple-500/50 focus:outline-none"
                /><span class="text-muted self-center text-xs">C%</span><input
                  id="cmyk-m"
                  type="number"
                  min="0"
                  max="100"
                  value="76"
                  class="flex-1 px-3 py-2.5 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm text-center focus:border-purple-500/50 focus:outline-none"
                /><span class="text-muted self-center text-xs">M%</span><input
                  id="cmyk-y"
                  type="number"
                  min="0"
                  max="100"
                  value="0"
                  class="flex-1 px-3 py-2.5 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm text-center focus:border-purple-500/50 focus:outline-none"
                /><span class="text-muted self-center text-xs">Y%</span><input
                  id="cmyk-k"
                  type="number"
                  min="0"
                  max="100"
                  value="7"
                  class="flex-1 px-3 py-2.5 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm text-center focus:border-purple-500/50 focus:outline-none"
                /><span class="text-muted self-center text-xs">K%</span>
              </div>
            </div>
          </div>
          <div class="flex gap-2 mt-6 pt-6 border-t border-surface">
            <button
              id="copy-btn"
              class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              >Copy HEX</button
            >
            <button
              id="share-btn"
              class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              title="Copy share link">🔗</button
            >
            <button
              id="download-btn"
              class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              >Download</button
            >
            <button
              id="clear-btn"
              class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              >Clear</button
            >
          </div>
        </div>
      </div>
      <ToolContentSections
        toolSlug="color-converter"
        toolName="Color Converter"
        category="Design Tools"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />
      <RelatedTools current="color-converter" />
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent"
            >Questions</span
          >
        </h2><Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>
<script>
  const picker = document.getElementById('color-picker') as HTMLInputElement;
  const hexInput = document.getElementById('hex-input') as HTMLInputElement;
  const rInput = document.getElementById('r-input') as HTMLInputElement;
  const gInput = document.getElementById('g-input') as HTMLInputElement;
  const bInput = document.getElementById('b-input') as HTMLInputElement;
  const hInput = document.getElementById('h-input') as HTMLInputElement;
  const sInput = document.getElementById('s-input') as HTMLInputElement;
  const lInput = document.getElementById('l-input') as HTMLInputElement;
  const cInput = document.getElementById('cmyk-c') as HTMLInputElement;
  const mInput = document.getElementById('cmyk-m') as HTMLInputElement;
  const yInput = document.getElementById('cmyk-y') as HTMLInputElement;
  const kInput = document.getElementById('cmyk-k') as HTMLInputElement;
  let updating = false;
  function hexToRgb(hex: string) {
    const m = hex.replace('#', '').match(/^([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i);
    return m ? { r: parseInt(m[1], 16), g: parseInt(m[2], 16), b: parseInt(m[3], 16) } : null;
  }
  function rgbToHsl(r: number, g: number, b: number) {
    r /= 255;
    g /= 255;
    b /= 255;
    const mx = Math.max(r, g, b),
      mn = Math.min(r, g, b),
      d = mx - mn;
    let h = 0,
      s = 0,
      l = (mx + mn) / 2;
    if (d) {
      s = l > 0.5 ? d / (2 - mx - mn) : d / (mx + mn);
      switch (mx) {
        case r:
          h = ((g - b) / d + (g < b ? 6 : 0)) / 6;
          break;
        case g:
          h = ((b - r) / d + 2) / 6;
          break;
        case b:
          h = ((r - g) / d + 4) / 6;
          break;
      }
    }
    return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
  }
  function hslToRgb(h: number, s: number, l: number) {
    s /= 100;
    l /= 100;
    const a = s * Math.min(l, 1 - l);
    const f = (n: number) => {
      const k = (n + h / 30) % 12;
      return l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
    };
    return { r: Math.round(f(0) * 255), g: Math.round(f(8) * 255), b: Math.round(f(4) * 255) };
  }
  function rgbToHex(r: number, g: number, b: number) {
    return '#' + [r, g, b].map((x) => x.toString(16).padStart(2, '0')).join('');
  }
  function rgbToCmyk(r: number, g: number, b: number) {
    let c = 1 - r / 255,
      m = 1 - g / 255,
      y = 1 - b / 255,
      k = Math.min(c, Math.min(m, y));
    if (k === 1) return { c: 0, m: 0, y: 0, k: 100 };
    return {
      c: Math.round(((c - k) / (1 - k)) * 100),
      m: Math.round(((m - k) / (1 - k)) * 100),
      y: Math.round(((y - k) / (1 - k)) * 100),
      k: Math.round(k * 100),
    };
  }
  function cmykToRgb(c: number, m: number, y: number, k: number) {
    c /= 100;
    m /= 100;
    y /= 100;
    k /= 100;
    return {
      r: Math.round(255 * (1 - c) * (1 - k)),
      g: Math.round(255 * (1 - m) * (1 - k)),
      b: Math.round(255 * (1 - y) * (1 - k)),
    };
  }
  function updateFromHex() {
    if (updating) return;
    updating = true;
    let hex = hexInput.value.trim();
    if (!hex.startsWith('#')) hex = '#' + hex;
    if (/^#[a-f\d]{6}$/i.test(hex)) {
      const rgb = hexToRgb(hex);
      if (!rgb) return;
      picker.value = hex;
      rInput.value = String(rgb.r);
      gInput.value = String(rgb.g);
      bInput.value = String(rgb.b);
      const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
      hInput.value = String(hsl.h);
      sInput.value = String(hsl.s);
      lInput.value = String(hsl.l);
      const cmyk = rgbToCmyk(rgb.r, rgb.g, rgb.b);
      cInput.value = String(cmyk.c);
      mInput.value = String(cmyk.m);
      yInput.value = String(cmyk.y);
      kInput.value = String(cmyk.k);
    }
    updating = false;
  }
  function updateFromRgb() {
    if (updating) return;
    updating = true;
    const r = parseInt(rInput.value) || 0,
      g = parseInt(gInput.value) || 0,
      b = parseInt(bInput.value) || 0;
    const hex = rgbToHex(Math.min(r, 255), Math.min(g, 255), Math.min(b, 255));
    hexInput.value = hex;
    picker.value = hex;
    const hsl = rgbToHsl(Math.min(r, 255), Math.min(g, 255), Math.min(b, 255));
    hInput.value = String(hsl.h);
    sInput.value = String(hsl.s);
    lInput.value = String(hsl.l);
    const cmyk = rgbToCmyk(Math.min(r, 255), Math.min(g, 255), Math.min(b, 255));
    cInput.value = String(cmyk.c);
    mInput.value = String(cmyk.m);
    yInput.value = String(cmyk.y);
    kInput.value = String(cmyk.k);
    updating = false;
  }
  function updateFromHsl() {
    if (updating) return;
    updating = true;
    const h = parseInt(hInput.value) || 0,
      s = parseInt(sInput.value) || 0,
      l = parseInt(lInput.value) || 0;
    const rgb = hslToRgb(Math.min(h, 360), Math.min(s, 100), Math.min(l, 100));
    rInput.value = String(rgb.r);
    gInput.value = String(rgb.g);
    bInput.value = String(rgb.b);
    const hex = rgbToHex(rgb.r, rgb.g, rgb.b);
    hexInput.value = hex;
    picker.value = hex;
    const cmyk = rgbToCmyk(rgb.r, rgb.g, rgb.b);
    cInput.value = String(cmyk.c);
    mInput.value = String(cmyk.m);
    yInput.value = String(cmyk.y);
    kInput.value = String(cmyk.k);
    updating = false;
  }
  function updateFromCmyk() {
    if (updating) return;
    updating = true;
    const c = parseInt(cInput.value) || 0,
      m = parseInt(mInput.value) || 0,
      y = parseInt(yInput.value) || 0,
      k = parseInt(kInput.value) || 0;
    const rgb = cmykToRgb(Math.min(c, 100), Math.min(m, 100), Math.min(y, 100), Math.min(k, 100));
    rInput.value = String(rgb.r);
    gInput.value = String(rgb.g);
    bInput.value = String(rgb.b);
    const hex = rgbToHex(rgb.r, rgb.g, rgb.b);
    hexInput.value = hex;
    picker.value = hex;
    const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
    hInput.value = String(hsl.h);
    sInput.value = String(hsl.s);
    lInput.value = String(hsl.l);
    updating = false;
  }
  picker.addEventListener('input', () => {
    hexInput.value = picker.value;
    updateFromHex();
  });
  hexInput.addEventListener('input', updateFromHex);
  rInput.addEventListener('input', updateFromRgb);
  gInput.addEventListener('input', updateFromRgb);
  bInput.addEventListener('input', updateFromRgb);
  hInput.addEventListener('input', updateFromHsl);
  sInput.addEventListener('input', updateFromHsl);
  lInput.addEventListener('input', updateFromHsl);
  cInput.addEventListener('input', updateFromCmyk);
  mInput.addEventListener('input', updateFromCmyk);
  yInput.addEventListener('input', updateFromCmyk);
  kInput.addEventListener('input', updateFromCmyk);
  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }
  document.getElementById('copy-btn')?.addEventListener('click', () => {
    const text = hexInput.value;
    if (!text) return;
    navigator.clipboard.writeText(text).catch(() => {});
    playPing();
    const btn = document.getElementById('copy-btn');
    btn.textContent = 'Copied!';
    setTimeout(() => {
      btn.textContent = 'Copy HEX';
    }, 2000);
  });
  document.getElementById('download-btn')?.addEventListener('click', () => {
    const content =
      'HEX: ' +
      hexInput.value +
      '\nRGB: ' +
      rInput.value +
      ', ' +
      gInput.value +
      ', ' +
      bInput.value +
      '\nHSL: ' +
      hInput.value +
      ', ' +
      sInput.value +
      '%, ' +
      lInput.value +
      '%\nCMYK: ' +
      cInput.value +
      '%, ' +
      mInput.value +
      '%, ' +
      yInput.value +
      '%, ' +
      kInput.value +
      '%';
    if (!content.trim()) return;
    const blob = new Blob([content], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'color-values.txt';
    a.click();
    playPing();
    URL.revokeObjectURL(a.href);
  });
  document.getElementById('clear-btn')?.addEventListener('click', () => {
    hexInput.value = '#7c3aed';
    picker.value = '#7c3aed';
    updateFromHex();
    playPing();
  });
  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('hex-input');
    const t = o?.value || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof (window as any).__showToast === 'function')
      (window as any).__showToast({ message: 'Link copied!', variant: 'success' });
  });
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b = document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      document.getElementById('clear-btn')?.click();
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['color']) b.textContent = 'Used ' + u['color'] + '×';
  } catch (e) {}
  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      document.querySelectorAll("button[class*='bg-purple'],button[class*='bg-violet']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(purple|violet)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(purple|violet)-\d+/g, 'hover:bg-' + c + '-500');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}

  // ─── Fullscreen ───
  (function() {
    var fsBtn = document.getElementById('fullscreen-btn');
    if (fsBtn) {
      fsBtn.addEventListener('click', function() {
        var el = document.querySelector('main') || document.documentElement;
        if (!document.fullscreenElement) { el.requestFullscreen && el.requestFullscreen(); }
        else { document.exitFullscreen && document.exitFullscreen(); }
      });
    }
    document.addEventListener('keydown', function(e) {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'f' || e.key === 'F') { if (fsBtn) fsBtn.click(); }
    });
  })();</script>
