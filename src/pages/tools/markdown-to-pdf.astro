---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import KeyboardHints from '../../components/KeyboardHints.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';
import ProToolDocs from '../../components/ProToolDocs.astro';

const faqItems = [
  {
    question: 'How does client-side Markdown to PDF conversion work?',
    answer:
      'The converter executes 100% inside your browser. Your Markdown is parsed into HTML using Marked, sanitized with DOMPurify, enriched with vector SVGs from Mermaid, and rendered with LaTeX equations via KaTeX. When you click Export PDF, the browser’s native print engine compiles an uncompressed vector PDF with selectable text.',
  },
  {
    question: 'Does this tool support LaTeX math formulas and Mermaid diagrams?',
    answer:
      'Yes! Inline math ($E=mc^2$) and display equations ($$\\int_0^\\infty e^{-x^2} dx = \\frac{\\sqrt{\\pi}}{2}$$) are rendered with KaTeX. Code blocks marked with ```mermaid are converted into crisp vector SVG diagrams.',
  },
  {
    question: 'How do I add page breaks to my generated PDF?',
    answer:
      'Click the "Page Break" button in the toolbar, or type `<div class="page-break"></div>` anywhere in your markdown. The print stylesheet automatically splits the document onto a fresh page at that point.',
  },
  {
    question: 'Are my private documents uploaded to any server?',
    answer:
      'Never. NumanX Tools Hub enforces a strict zero-server privacy architecture. Your markdown text, math equations, and generated PDFs exist exclusively in your browser’s volatile memory.',
  },
];

const mdPdfSchema = {
  name: 'Markdown to PDF Converter Pro',
  applicationCategory: 'DeveloperApplication',
  description:
    'Free client-side Markdown to PDF converter with GitHub Flavored Markdown, LaTeX math, Mermaid diagrams, and vector print styling.',
  featureList: [
    'GitHub Flavored Markdown (GFM) parsing with tables and task lists',
    'Full LaTeX math rendering with KaTeX ($inline$ and $$display$$)',
    'Interactive Mermaid diagram synthesis (flowcharts, sequence, class diagrams)',
    'Native vector print output — crisp 300+ DPI selectable text and working links',
    'Page size selection (A4 and US Letter) with customizable margin presets',
    'Multiple document themes: GitHub Light, Academic Serif, and Modern Clean',
    '100% in-browser processing — absolute privacy with zero cloud upload',
  ],
};

const benefits = [
  {
    icon: '📄',
    title: 'Crisp Vector Output',
    desc: 'Unlike canvas rasterizers, browser print compilation preserves ultra-sharp fonts, selectable text, and clickable hyperlinks at 300+ DPI.',
  },
  {
    icon: '📐',
    title: 'LaTeX & Mermaid Built-In',
    desc: 'Effortlessly document engineering architectures and research papers with inline math formulas and interactive SVG flowcharts.',
  },
  {
    icon: '✂️',
    title: 'Dedicated Page Breaks',
    desc: 'Insert precise CSS paged media breaks (<div class="page-break"></div>) to prevent awkward table splits and orphan headings.',
  },
  {
    icon: '🔒',
    title: 'Confidential & Private',
    desc: 'All conversion runs locally via Web APIs. Zero document bytes are transmitted across the internet.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Type or Paste Markdown',
    desc: 'Input your Markdown text in the editor, or choose one of our pre-built technical and academic templates.',
  },
  {
    num: '2',
    title: 'Select Paper Format & Theme',
    desc: 'Choose between A4 or US Letter, customize margin widths, and toggle GitHub Light or Academic Serif styling.',
  },
  {
    num: '3',
    title: 'Add Page Breaks if Needed',
    desc: 'Use the Page Break toolbar button to position content across distinct pages.',
  },
  {
    num: '4',
    title: 'Export Vector PDF',
    desc: 'Click "Print / Save PDF" to invoke your browser’s print dialog and save a clean PDF.',
  },
];
---

<MainLayout
  title="Markdown to PDF — GFM, Math & Mermaid | NumanX"
  description="Convert Markdown to PDF online free. 100% client-side with full support for GitHub Flavored Markdown, LaTeX math equations, Mermaid diagrams, and vector print."
  keywords="markdown to pdf, convert markdown to pdf online, md to pdf, latex markdown to pdf, mermaid to pdf, github markdown pdf exporter, free pdf generator, printable markdown"
  canonical="https://toolshub.numanxstudio.com/tools/markdown-to-pdf/"
  toolSchema={mdPdfSchema}
  faq={faqItems}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Markdown to PDF', url: '/tools/markdown-to-pdf/' },
  ]}
>
  <!-- KaTeX Stylesheet from allowlisted jsdelivr CDN -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
    crossorigin="anonymous"
    media="print"
    onload="this.media='all'"
  />

  <main class="min-h-screen pt-20 pb-24 px-4 sm:px-6 relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <ToolHeader
        title="Markdown to PDF Converter"
        description="Convert Markdown to publication-grade vector PDFs with live GFM preview, LaTeX math formulas, and Mermaid diagrams."
        badge="Vector PDF Engine"
      />

      <!-- Main Toolbar -->
      <div class="bg-surface-1/90 border border-surface rounded-2xl p-4 mb-6 shadow-xl backdrop-blur-md flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-2">
          <!-- Template Selector -->
          <div class="flex items-center gap-1.5">
            <span class="text-xs text-zinc-400 font-mono hidden sm:inline">Template:</span>
            <select
              id="md-template-select"
              class="px-3 py-1.5 rounded-xl bg-surface-2 border border-surface text-xs font-mono text-zinc-200 focus:border-purple-500 focus:outline-none cursor-pointer" aria-label="Document template"
            >
              <option value="tech-report">Architecture & Technical Spec</option>
              <option value="academic">Academic Research Paper</option>
              <option value="readme">Project Documentation & README</option>
              <option value="empty">Blank Document</option>
            </select>
          </div>

          <!-- Page Format -->
          <div class="flex items-center gap-1.5 ml-0 sm:ml-2">
            <span class="text-xs text-zinc-400 font-mono hidden sm:inline">Page:</span>
            <select
              id="md-pagesize-select"
              class="px-3 py-1.5 rounded-xl bg-surface-2 border border-surface text-xs font-mono text-zinc-200 focus:border-purple-500 focus:outline-none cursor-pointer" aria-label="Page size"
            >
              <option value="a4">A4 (210×297mm)</option>
              <option value="letter">US Letter (8.5×11")</option>
            </select>
          </div>

          <!-- Theme -->
          <div class="flex items-center gap-1.5 ml-0 sm:ml-2">
            <span class="text-xs text-zinc-400 font-mono hidden sm:inline">Theme:</span>
            <select
              id="md-theme-select"
              class="px-3 py-1.5 rounded-xl bg-surface-2 border border-surface text-xs font-mono text-zinc-200 focus:border-purple-500 focus:outline-none cursor-pointer" aria-label="PDF theme"
            >
              <option value="theme-github">GitHub Light</option>
              <option value="theme-academic">Academic Serif</option>
              <option value="theme-minimal">Modern Minimal</option>
            </select>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="md-insert-pagebreak"
            class="px-3 py-1.5 rounded-xl bg-surface-2 hover:bg-surface-3 border border-surface text-xs font-mono text-zinc-300 transition-all cursor-pointer flex items-center gap-1.5"
            title="Insert Page Break for PDF"
          >
            <span>✂️</span> Page Break
          </button>
          <button
            type="button"
            id="md-download-btn"
            class="px-3 py-1.5 rounded-xl bg-surface-2 hover:bg-surface-3 border border-surface text-xs font-mono text-zinc-300 transition-all cursor-pointer flex items-center gap-1.5"
          >
            <span>💾</span> .md
          </button>
          <button
            type="button"
            id="md-print-pdf-btn"
            class="px-5 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold text-xs font-mono uppercase tracking-wider shadow-lg shadow-purple-900/40 transition-all duration-200 cursor-pointer flex items-center gap-2"
          >
            <span>🖨️</span> Print / Save PDF
          </button>
        </div>
      </div>

      <!-- Split-Pane Editor & Preview -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        <!-- Editor Column -->
        <div class="bg-surface-1/90 border border-surface rounded-xl p-5 shadow-2xl backdrop-blur-md flex flex-col h-[750px]">
          <div class="flex items-center justify-between pb-3 border-b border-surface mb-3 min-h-[38px]">
            <span class="text-xs font-mono font-semibold text-zinc-400 uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-purple-500"></span>
              Markdown Source
            </span>
            <div class="flex items-center gap-3 text-xs font-mono text-zinc-500">
              <span id="md-char-count">0 chars</span>
              <span>•</span>
              <span id="md-word-count">0 words</span>
            </div>
          </div>

          <div class="flex-1 flex rounded-xl bg-black/40 border border-surface focus-within:border-purple-500 focus-within:ring-1 focus-within:ring-purple-500 transition-all overflow-hidden relative">
            <div
              id="line-nums"
              class="w-12 shrink-0 h-full select-none overflow-hidden font-mono text-sm leading-6 text-right pr-3.5 py-3 text-zinc-500/80 bg-zinc-950/60 border-r border-white/5 whitespace-pre pointer-events-none tabular-nums"
              style="line-height: 24px; font-size: 14px;"
            >1</div>
            <textarea
              id="markdown-input"
              aria-label="Markdown source input"
              class="flex-1 min-w-0 h-full bg-transparent text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 px-4 py-3 focus:outline-none font-mono resize-none border-0 overflow-y-auto"
              style="line-height: 24px; font-size: 14px;"
              placeholder="Type or paste your Markdown here..."
              spellcheck="false"
            ></textarea>
          </div>
        </div>

        <!-- Live Preview Document Column -->
        <div class="bg-surface-1/90 border border-surface rounded-xl p-5 shadow-2xl backdrop-blur-md flex flex-col h-[750px] overflow-hidden">
          <div class="flex items-center justify-between pb-3 border-b border-surface mb-3 min-h-[38px]">
            <span class="text-xs font-mono font-semibold text-zinc-400 uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Live Document Preview
            </span>
            <span class="text-xs font-mono text-zinc-400 px-2 py-0.5 rounded-md bg-surface-2 border border-surface">
              WYSIWYG Print Mirror
            </span>
          </div>

          <!-- Paper Preview Container (Scrollable) -->
          <div
            role="region"
            aria-label="PDF Document Live Preview"
            tabindex="0"
            class="flex-1 overflow-y-auto rounded-xl bg-zinc-950/60 p-4 sm:p-6 border border-surface flex justify-center focus:outline-none focus:ring-1 focus:ring-purple-500">
            <div
              id="pdf-paper-sheet"
              class="theme-github w-full max-w-[680px] bg-white text-zinc-900 p-8 sm:p-12 rounded-lg shadow-2xl min-h-full font-sans transition-all"
            >
              <div id="markdown-rendered-content" class="markdown-body"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Pro Tool Educational Documentation Component -->
      <div class="my-16">
        <ProToolDocs
          slug="markdown-to-pdf"
          toolName="Markdown to PDF Converter"
          category="Developer Tools"
        />
      </div>

      <ShareBar title="Markdown to PDF Converter" />
      <ToolContentSections
        toolSlug="markdown-to-pdf"
        toolName="Markdown to PDF Converter"
        category="Developer Tools"
        benefits={benefits}
        howToSteps={howToSteps}
      />

      <section class="mt-16 mb-8">
        <h2 class="text-2xl font-bold text-white mb-6 text-center">Frequently Asked Questions</h2>
        <div class="max-w-3xl mx-auto">
          <Accordion items={faqItems} />
        </div>
      </section>

      <RelatedTools currentSlug="markdown-to-pdf" />
      <KeyboardHints
        hints={[
          { keys: 'Ctrl + P', label: 'Print / Save Vector PDF' },
          { keys: 'Tab', label: 'Indent in Editor' },
        ]}
      />
    </div>
  </main>
</MainLayout>

<style is:global>
  /* ─── Paged Media & Print Stylesheet ─── */
  @page {
    size: A4;
    margin: 16mm 14mm;
  }

  @media print {
    body * {
      visibility: hidden;
    }
    #pdf-paper-sheet,
    #pdf-paper-sheet * {
      visibility: visible;
    }
    #pdf-paper-sheet {
      position: absolute;
      left: 0;
      top: 0;
      width: 100% !important;
      max-width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
      box-shadow: none !important;
      background: white !important;
      color: black !important;
    }
    .page-break {
      page-break-before: always !important;
      break-before: page !important;
      height: 0 !important;
      margin: 0 !important;
      border: none !important;
    }
    pre,
    blockquote,
    table {
      page-break-inside: avoid !important;
      break-inside: avoid !important;
    }
  }

  /* ─── Document Theme Typography ─── */
  .theme-github {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    color: #1f2328;
    line-height: 1.6;
  }
  .theme-github h1,
  .theme-github h2,
  .theme-github h3 {
    color: #1f2328;
    font-weight: 600;
    border-bottom: 1px solid #d0d7de;
    padding-bottom: 0.3em;
    margin-top: 24px;
    margin-bottom: 16px;
  }
  .theme-github h1 { font-size: 2em; }
  .theme-github h2 { font-size: 1.5em; }
  .theme-github h3 { font-size: 1.25em; }
  .theme-github p { margin-bottom: 16px; }
  .theme-github code {
    background: #f6f8fa;
    padding: 0.2em 0.4em;
    border-radius: 6px;
    font-size: 85%;
    font-family: ui-monospace, SFMono-Regular, monospace;
  }
  .theme-github pre {
    background: #f6f8fa;
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    border: 1px solid #d0d7de;
    margin-bottom: 16px;
  }
  .theme-github table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 16px;
  }
  .theme-github th,
  .theme-github td {
    padding: 8px 14px;
    border: 1px solid #d0d7de;
    text-align: left;
  }
  .theme-github th {
    background: #f6f8fa;
    font-weight: 600;
  }
  .theme-github blockquote {
    padding: 0 1em;
    color: #656d76;
    border-left: 0.25em solid #d0d7de;
    margin: 0 0 16px 0;
  }

  /* Academic Serif Theme */
  .theme-academic {
    font-family: 'Times New Roman', Times, Georgia, serif;
    color: #111111;
    line-height: 1.7;
    font-size: 11pt;
  }
  .theme-academic h1 {
    font-size: 18pt;
    text-align: center;
    margin-bottom: 24px;
  }
  .theme-academic h2 {
    font-size: 14pt;
    margin-top: 20px;
    margin-bottom: 12px;
    border-bottom: 1px solid #333;
  }
  .theme-academic p {
    text-align: justify;
    margin-bottom: 14px;
  }

  /* Page Break Visual Divider in Preview */
  .page-break {
    border-top: 2px dashed #a855f7;
    margin: 32px 0;
    position: relative;
  }
  .page-break::after {
    content: 'PAGE BREAK';
    position: absolute;
    top: -10px;
    right: 16px;
    background: #a855f7;
    color: white;
    font-size: 9px;
    font-family: monospace;
    padding: 2px 6px;
    border-radius: 4px;
  }
</style>

<!-- External Script Libraries for GFM, Math & Diagrams -->
<script is:inline async src="https://cdn.jsdelivr.net/npm/marked@11.1.1/marked.min.js"></script>
<script is:inline async src="https://cdn.jsdelivr.net/npm/dompurify@3.0.8/dist/purify.min.js"></script>
<script is:inline async src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<script is:inline async src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
<script is:inline async src="https://cdn.jsdelivr.net/npm/mermaid@10.8.0/dist/mermaid.min.js"></script>

<script>
  declare const marked: any;
  declare const DOMPurify: any;
  declare const renderMathInElement: any;
  declare const mermaid: any;

  // Mermaid can reject internally while a diagram is still loading from the CDN.
  // Keep that transient failure from surfacing as an uncaught promise error.
  window.addEventListener('unhandledrejection', (event) => {
    const reason = event.reason;
    const message = typeof reason === 'string' ? reason : reason?.message || '';
    if (message.includes("reading 'ParseError'")) {
      event.preventDefault();
      console.warn('Mermaid diagram could not be rendered; continuing with the rest of the preview.');
    }
  });

  const TEMPLATES: Record<string, string> = {
    'tech-report': `## NumanX System Architecture & Technical Report
*Date: October 16, 2026 | Author: System Engineering Team*

---

## 1. System Overview
The **NumanX Tools Hub** operates on a zero-server edge architecture. Calculations, barcode generation, and PDF document synthesis occur client-side without remote cloud latency.

### Core Processing Pipeline
\`\`\`mermaid
flowchart LR
    A["Raw Markdown Input"] --> B["GFM Lexical Parser"]
    B --> C["KaTeX LaTeX Math Engine"]
    B --> D["Mermaid Vector Synthesizer"]
    C --> E["Sanitized DOM"]
    D --> E
    E --> F["Vector Print PDF Stream"]
\`\`\`

---

## 2. Mathematical Formalization
Resource decay in the cricket simulation suite follows the standard exponential distribution:

$$R(u, w) = Z_0(w) \\times \\left(1 - e^{-b(w) \\cdot u}\\right)$$

Where $u$ denotes overs remaining, $w$ is wickets fallen, and $Z_0$ represents the asymptotic resource quota:

$$\\text{Target} = \\left\\lfloor S_1 \\times \\frac{R_2}{R_1} \\right\\rfloor + 1$$

<div class="page-break"></div>

## 3. Engineering Benchmark Results

| Metric Dimension | Target SLA | Observed Performance | Conformance |
| :--- | :--- | :--- | :--- |
| **Parsing Latency** | < 100ms | 38ms (V8 Engine) | **PASSED** |
| **Vector Resolution** | 300 DPI | Lossless Vector SVG | **PASSED** |
| **Privacy Leakage** | 0 bytes | 0 outgoing network calls | **COMPLIANT** |

> **Security Note:** All cryptographic operations utilize \`window.crypto.getRandomValues()\` rather than insecure pseudorandom generators.
`,
    'academic': `# An Empirical Analysis of Client-Side Web Performance
**Muhammad Numan Usmani**  
*Department of Information Technology, NumanX Studio*

---

### Abstract
This paper examines the computational trade-offs of shifting intensive utilities (barcode synthesis, matrix calculations, document generation) from cloud-hosted microservices to client-side Web Workers and Canvas APIs.

### 1. Introduction
Modern browser runtimes afford near-native execution velocities via WebAssembly and modern V8 engines. By eliminating server roundtrips, response latencies fall from hundreds of milliseconds to sub-millisecond execution times.

### 2. Theoretical Methodology
Let $T_{\\text{network}}$ represent server trip latency and $T_{\\text{client}}$ denote execution time in local browser memory. The total time saved $\\Delta T$ is expressed as:

$$\\Delta T = T_{\\text{network}} + T_{\\text{queue}} - T_{\\text{client}}$$

<div class="page-break"></div>

### 3. Conclusion
Client-side processing guarantees zero data leakage, continuous offline availability, and eliminates linear cloud hosting overheads.
`,
    'readme': `# Project Documentation
Welcome to the **NumanX Tools Hub** open-source repository.

## Features
- **Zero Configuration**: Runs instantly in modern web browsers.
- **Privacy Guaranteed**: Data never leaves your machine.
- **100+ Free Tools**: Barcodes, Cricket Analytics, Math, Text, and Media.

## Installation
\`\`\`bash
git clone https://github.com/muhammadnuman340/numanx-tools-hub.git
cd numanx-tools-hub
npm install
npm run dev
\`\`\`
`,
    'empty': '# Untitled Document\n\nStart typing your markdown here...\n'
  };

  let isMermaidInitialized = false;
  let isMarkdownConverterInitialized = false;

  async function renderPreview() {
    const textarea = document.getElementById('markdown-input') as HTMLTextAreaElement;
    const preview = document.getElementById('markdown-rendered-content');
    const charCountEl = document.getElementById('md-char-count');
    const wordCountEl = document.getElementById('md-word-count');

    if (!textarea || !preview) return;

    const rawMarkdown = textarea.value;

    // Update stats
    if (charCountEl) charCountEl.textContent = `${rawMarkdown.length.toLocaleString()} chars`;
    const words = rawMarkdown.trim() ? rawMarkdown.trim().split(/\s+/).length : 0;
    if (wordCountEl) wordCountEl.textContent = `${words.toLocaleString()} words`;

    // 1. Parse GFM Markdown via Marked
    let rawHtml = '';
    if (typeof marked !== 'undefined') {
      rawHtml = marked.parse(rawMarkdown, { gfm: true, breaks: true });
    } else {
      rawHtml = rawMarkdown;
    }

    // 2. Sanitize HTML via DOMPurify
    if (typeof DOMPurify !== 'undefined') {
      preview.innerHTML = DOMPurify.sanitize(rawHtml);
    } else {
      preview.innerHTML = rawHtml;
    }

    // 3. Render Mermaid Diagrams
    const mermaidNodes = preview.querySelectorAll('pre code.language-mermaid');
    if (mermaidNodes.length > 0 && typeof mermaid !== 'undefined' && typeof DOMPurify !== 'undefined') {
      if (!isMermaidInitialized) {
        mermaid.initialize({ startOnLoad: false, theme: 'default', securityLevel: 'loose' });
        isMermaidInitialized = true;
      }

      for (let i = 0; i < mermaidNodes.length; i++) {
        const node = mermaidNodes[i];
        const container = document.createElement('div');
        container.className = 'mermaid my-4 flex justify-center overflow-x-auto';
        container.id = `mermaid-node-${i}-${Date.now()}`;
        container.textContent = node.textContent || '';
        node.parentElement?.replaceWith(container);
      }

      try {
        await mermaid.run({ querySelector: '.mermaid' });
      } catch (err) {
        console.warn('Mermaid render issue:', err);
      }
    }

    // 4. Render LaTeX Math via KaTeX Auto-Render
    if (typeof renderMathInElement !== 'undefined') {
      renderMathInElement(preview, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$', right: '$', display: false }
        ],
        throwOnError: false
      });
    }
  }

  function initMarkdownConverter() {
    if (isMarkdownConverterInitialized) return;
    isMarkdownConverterInitialized = true;
    const textarea = document.getElementById('markdown-input') as HTMLTextAreaElement;
    const templateSelect = document.getElementById('md-template-select') as HTMLSelectElement;
    const pageSizeSelect = document.getElementById('md-pagesize-select') as HTMLSelectElement;
    const themeSelect = document.getElementById('md-theme-select') as HTMLSelectElement;
    const pageBreakBtn = document.getElementById('md-insert-pagebreak');
    const downloadBtn = document.getElementById('md-download-btn');
    const printBtn = document.getElementById('md-print-pdf-btn');
    const paperSheet = document.getElementById('pdf-paper-sheet');

    const lineNums = document.getElementById('line-nums');
    const updateLineNums = () => {
      if (lineNums && textarea) {
        const count = (textarea.value || '').split('\n').length;
        lineNums.textContent = Array.from({ length: Math.max(1, count) }, (_, i) => i + 1).join('\n');
      }
    };

    // Load initial default template
    if (textarea && !textarea.value) {
      textarea.value = TEMPLATES['tech-report'];
      renderPreview();
    }
    updateLineNums();

    // Input listener with debounce
    let debounceTimer: any;
    textarea?.addEventListener('input', () => {
      updateLineNums();
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(renderPreview, 120);
    });
    textarea?.addEventListener('scroll', () => {
      if (lineNums) lineNums.scrollTop = textarea.scrollTop;
    });

    // Template change
    templateSelect?.addEventListener('change', () => {
      const selected = templateSelect.value;
      if (TEMPLATES[selected] && textarea) {
        textarea.value = TEMPLATES[selected];
        renderPreview();
        updateLineNums();
      }
    });

    // Page format change
    pageSizeSelect?.addEventListener('change', () => {
      if (paperSheet) {
        if (pageSizeSelect.value === 'letter') {
          paperSheet.style.maxWidth = '640px';
        } else {
          paperSheet.style.maxWidth = '680px';
        }
      }
    });

    // Theme change
    themeSelect?.addEventListener('change', () => {
      if (paperSheet) {
        paperSheet.className = `${themeSelect.value} w-full max-w-[680px] bg-white text-zinc-900 p-8 sm:p-12 rounded-lg shadow-2xl min-h-full transition-all`;
      }
    });

    // Insert Page Break
    pageBreakBtn?.addEventListener('click', () => {
      if (!textarea) return;
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const text = textarea.value;
      const breakTag = '\n\n<div class="page-break"></div>\n\n';
      textarea.value = text.substring(0, start) + breakTag + text.substring(end);
      textarea.focus();
      textarea.selectionStart = textarea.selectionEnd = start + breakTag.length;
      renderPreview();
    });

    // Download Raw Markdown
    downloadBtn?.addEventListener('click', () => {
      if (!textarea) return;
      const blob = new Blob([textarea.value], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'document.md';
      a.click();
      URL.revokeObjectURL(url);
    });

    // Print / Vector PDF
    printBtn?.addEventListener('click', () => {
      window.print();
    });

    // Keyboard shortcut Ctrl+P / Cmd+P intercept for quick print
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
        e.preventDefault();
        window.print();
      }
    });
  }

  document.addEventListener('astro:page-load', initMarkdownConverter);
  if (document.readyState === 'complete') {
    initMarkdownConverter();
  } else {
    window.addEventListener('DOMContentLoaded', initMarkdownConverter);
  }
</script>
