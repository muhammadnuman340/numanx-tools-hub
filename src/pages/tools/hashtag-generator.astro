---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";
import KeyboardHints from "../../components/KeyboardHints.astro";


const faqItems = [
    { question: "How do hashtags improve reach?", answer: "Hashtags help the platform algorithm categorize your content and show it to users interested in those topics. Using the right mix of viral, trending, and niche tags maximizes discoverability." },
    { question: "How many hashtags should I use?", answer: "Instagram supports up to 30 (use 20–28), TikTok performs best with 3–5, YouTube works well with 3–15, Shorts with 10–20, Threads with 5–10." },
    { question: "What's the difference between viral, trending, and niche hashtags?", answer: "Viral tags have massive reach but high competition. Trending tags are currently popular. Niche tags are specific to your topic — lower reach but higher engagement from targeted audiences." },
    { question: "How is the popularity score calculated?", answer: "Popularity scores are based on tag usage frequency, competition level, and current trends. Low = under 10K posts, Medium = 10K–100K, High = 100K–1M, Viral = 1M+." },
    { question: "Can I save my favorite hashtags?", answer: "Yes! Click the star icon on any hashtag to save it to your favorites. Saved tags are stored in your browser and persist across sessions." },
  ];
const htSchema = {
  "name": "Hashtag Generator Pro",
  "applicationCategory": "Multimedia",
  "description": "Generate viral, trending, and niche hashtags for any platform. Popularity scores, reach estimates, and save favorites.",
  "featureList": [
    "Viral, trending, and niche hashtag suggestions",
    "Multi-platform support — Instagram, TikTok, YouTube, Threads",
    "Popularity scores with low, medium, high, and viral tiers",
    "Favorites list saved to browser localStorage",
    "Client-side — no text or data sent to any server"
  ],
}
---

<MainLayout
  title="AI Hashtag Generator - Viral Hashtags for Instagram, TikTok, YouTube & More"
  description="Generate viral, trending, and niche hashtags for Instagram, TikTok, YouTube, Shorts, and Threads. Popularity scores and reach estimates included."
  keywords="hashtag generator, viral hashtags, instagram hashtags, tiktok hashtags, youtube tags, threads hashtags, trending tags"
  toolSchema={htSchema}
  faq={faqItems}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Tools", url: "/tools/" },
    { name: "Hashtag Generator", url: "/tools/hashtag-generator/" },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="Hashtag"
        gradient="Generator Pro"
        desc="Generate viral, trending, and niche hashtags for any platform. Popularity scores, reach estimates, and save favorites — free and unlimited."
        badge="✦ Pro Version"
        slug="hashtag-generator"
      />

      <ShareBar />

      <!-- ─── Tool Interface (Later/Hootsuite style) ─── -->
      <div class="mt-8 space-y-4">

        <!-- Input Card -->
        <div class="bg-surface-1 border border-surface rounded-2xl p-5 md:p-6 space-y-4 max-w-2xl mx-auto">
          <div class="space-y-2">
            <label for="topic-input" class="text-[10px] font-semibold text-muted uppercase tracking-wider">Enter Your Topic</label>
            <input type="text" id="topic-input" placeholder="e.g. tech reviews, fitness tips, travel vlog..."
              class="w-full bg-zinc-950 text-white placeholder-zinc-600 px-4 py-3.5 rounded-xl border border-surface focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all text-sm" />
          </div>

          <div class="space-y-2">
            <span class="text-[10px] font-semibold text-muted uppercase tracking-wider">Platform</span>
            <div id="platform-tabs" class="grid grid-cols-5 gap-1.5">
              {[
                { id: "instagram", label: "Instagram", icon: "📸" },
                { id: "tiktok", label: "TikTok", icon: "🎵" },
                { id: "youtube", label: "YouTube", icon: "📺" },
                { id: "shorts", label: "Shorts", icon: "📱" },
                { id: "threads", label: "Threads", icon: "🧵" },
              ].map((p, idx) => (
                <button class="platform-btn flex flex-col items-center gap-1 rounded-xl py-2.5 px-1 text-[10px] font-medium border transition-all"
                  data-platform={p.id}>
                  <span class="text-base">{p.icon}</span>
                  <span>{p.label}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="flex gap-2 pt-1">
            <button id="generate-btn" class="flex-1 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-semibold py-3 rounded-xl transition-all shadow-lg shadow-purple-900/20 text-sm flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span id="btn-text">Generate</span>
              <svg id="btn-spinner" class="hidden animate-spin shrink-0" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            </button>
            <button id="randomize-btn" title="Randomize & Re-shuffle" class="bg-surface-1 hover:bg-surface-3 border border-surface text-tertiary hover:text-primary px-4 rounded-xl transition-all flex items-center justify-center text-lg">
              🔄
            </button>
          </div>
        </div>

        <!-- Analytics Bar (Hootsuite-style metrics) -->
        <div id="analytics-bar" class="hidden max-w-2xl mx-auto grid grid-cols-2 gap-3">
          <div class="bg-surface-1 border border-surface rounded-xl p-4 flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-purple-600/20 to-blue-600/20 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0">📊</div>
            <div>
              <div class="text-[10px] font-semibold text-muted uppercase tracking-wider">Popularity Score</div>
              <div class="flex items-center gap-2 mt-0.5">
                <span id="popularity-num" class="text-sm font-bold text-primary font-mono">0</span>
                <span id="popularity-label" class="text-[10px] font-semibold px-2 py-0.5 rounded-full border"></span>
              </div>
            </div>
          </div>
          <div class="bg-surface-1 border border-surface rounded-xl p-4 flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-600/20 to-teal-600/20 flex items-center justify-center text-emerald-400 text-sm font-bold shrink-0">📈</div>
            <div>
              <div class="text-[10px] font-semibold text-muted uppercase tracking-wider">Estimated Reach</div>
              <div class="flex items-center gap-2 mt-0.5">
                <span id="reach-num" class="text-sm font-bold text-primary font-mono">0</span>
                <span id="reach-label" class="text-[10px] font-semibold text-muted">impressions</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Output -->
        <div id="output-section" class="hidden max-w-2xl mx-auto">
          <div class="bg-surface-1 border border-surface rounded-2xl p-5 md:p-6">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="text-sm font-semibold text-primary">Generated Hashtags</h3>
                <p id="hashtag-count" class="text-[11px] text-muted mt-0.5"></p>
              </div>
              <button id="copy-all-btn" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-surface-3 bg-surface-1 text-tertiary text-xs font-medium hover:bg-zinc-700 hover:text-primary active:scale-[0.97] transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span id="copy-all-text">Copy All</span>
              </button>
            </div>
            <div id="hashtag-list" class="flex flex-wrap gap-2"></div>
          </div>
        </div>

        <!-- Save Favorites -->
        <div id="favorites-section" class="hidden max-w-2xl mx-auto">
          <div class="bg-surface-1 border border-surface rounded-2xl p-5 md:p-6">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <span class="text-sm leading-none">⭐</span>
                <span class="text-[10px] font-semibold text-muted uppercase tracking-wider">Saved Favorites</span>
              </div>
              <button id="clear-favorites" class="text-[10px] text-dim hover:text-red-400 transition-colors">Clear All</button>
            </div>
            <div id="favorites-list" class="flex flex-wrap gap-2"></div>
          </div>
        </div>
      </div>

      <!-- ─── Trending + Viral + Niche Hashtags by Platform ─── -->
      <section class="mt-16">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Explore</span>
          <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">
            Viral, Trending &amp; Niche
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Hashtags</span>
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="trending-grid">
          {[
            { name: "Instagram Viral", icon: "📸", tags: ["#instagram","#reels","#explorepage","#viral","#trending","#explore","#instagood","#photooftheday","#reelsinstagram","#fyp"] },
            { name: "Instagram Niche", icon: "🎯", tags: ["#igers","#instadaily","#picoftheday","#instalike","#followme","#instamood","#instaphoto","#likeforlike","#followforfollow","#dailyphoto"] },
            { name: "TikTok Viral", icon: "🎵", tags: ["#fyp","#foryou","#foryoupage","#viral","#tiktok","#trending","#xyzbca","#blowthisup","#fypシ","#viraltiktok"] },
            { name: "TikTok Niche", icon: "🔍", tags: ["#tiktokdance","#tiktokchallenge","#greenscreen","#transition","#duet","#stitch","#voiceover","#tiktoktrend","#dancechallenge","#lifetips"] },
            { name: "YouTube Trending", icon: "📺", tags: ["#youtube","#subscribe","#contentcreator","#viral","#trending","#newvideo","#youtuber","#youtubevideos","#sub","#videomaker"] },
            { name: "YouTube Niche", icon: "🎬", tags: ["#tutorial","#howto","#review","#unboxing","#vlog","#dailyvlog","#gaming","#tech","#diy","#cooking"] },
            { name: "Shorts Trending", icon: "📱", tags: ["#shorts","#youtubeshorts","#shortsviral","#shortvideo","#shortsvideo","#viralshorts","#trendingshorts","#shortsfeed","#ytshorts","#shortstrending"] },
            { name: "Shorts Niche", icon: "⚡", tags: ["#gaming","#comedy","#funny","#dance","#music","#fitness","#food","#recipe","#art","#reaction"] },
            { name: "Threads Viral", icon: "🧵", tags: ["#threads","#threadsapp","#threadscommunity","#viral","#trending","#foryou","#explore","#threadsindia","#threadsusa","#contentcreator"] },
          ].map((g) => (
            <div class="trending-group rounded-xl border border-surface bg-surface-1 p-4 hover:border-surface-3 transition-all">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-base">{g.icon}</span>
                <h3 class="text-xs font-semibold text-secondary">{g.name}</h3>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {g.tags.map((t) => (
                  <span class="trending-tag px-2 py-1 rounded-lg bg-surface-1 text-[10px] text-secondary cursor-pointer hover:bg-purple-600/20 hover:text-purple-300 transition-all">{t}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ─── How It Works ─── -->
      <section class="mt-16 max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Quick Start</span>
          <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">
            How to
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Use Hashtag Generator</span>
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
          <div class="text-center p-5 rounded-xl border border-surface bg-surface-1 hover:border-surface-3 transition-all">
            <div class="w-9 h-9 rounded-full bg-purple-600/20 flex items-center justify-center text-purple-400 text-sm font-bold mx-auto mb-3">1</div>
            <h3 class="text-sm font-semibold text-primary">Enter Topic</h3>
            <p class="text-xs text-muted mt-1.5">Type your content topic or niche.</p>
          </div>
          <div class="text-center p-5 rounded-xl border border-surface bg-surface-1 hover:border-surface-3 transition-all">
            <div class="w-9 h-9 rounded-full bg-purple-600/20 flex items-center justify-center text-purple-400 text-sm font-bold mx-auto mb-3">2</div>
            <h3 class="text-sm font-semibold text-primary">Pick Platform</h3>
            <p class="text-xs text-muted mt-1.5">Choose Instagram, TikTok, YouTube, Shorts, or Threads.</p>
          </div>
          <div class="text-center p-5 rounded-xl border border-surface bg-surface-1 hover:border-surface-3 transition-all">
            <div class="w-9 h-9 rounded-full bg-purple-600/20 flex items-center justify-center text-purple-400 text-sm font-bold mx-auto mb-3">3</div>
            <h3 class="text-sm font-semibold text-primary">Generate &amp; Save</h3>
            <p class="text-xs text-muted mt-1.5">Get tags with popularity scores. Star favorites to save them.</p>
          </div>
          <div class="text-center p-5 rounded-xl border border-surface bg-surface-1 hover:border-surface-3 transition-all">
            <div class="w-9 h-9 rounded-full bg-purple-600/20 flex items-center justify-center text-purple-400 text-sm font-bold mx-auto mb-3">4</div>
            <h3 class="text-sm font-semibold text-primary">Copy &amp; Post</h3>
            <p class="text-xs text-muted mt-1.5">Copy all at once or pick individual tags.</p>
          </div>
        </div>
      </section>

      <!-- ─── FAQ ─── -->
      <section class="mt-16">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight         <div class="mt-20 max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
            Frequently Asked
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
          </h2>
          <Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} />
        </div>

      </section>

      <KeyboardHints hints={[
        { keys: "⌘K", label: "Open search" },
        { keys: "Enter", label: "Generate hashtags" },
        { keys: "Click", label: "Copy hashtag" },
      ]} />

      <RelatedTools current="hashtag-generator" />
    </div>
  </main>
</MainLayout>

<script>
  const topicInput = document.getElementById("topic-input");
  const generateBtn = document.getElementById("generate-btn");
  const btnText = document.getElementById("btn-text");
  const btnSpinner = document.getElementById("btn-spinner");
  const randomizeBtn = document.getElementById("randomize-btn");
  const analyticsBar = document.getElementById("analytics-bar");
  const popularityNum = document.getElementById("popularity-num");
  const popularityLabel = document.getElementById("popularity-label");
  const reachNum = document.getElementById("reach-num");
  const outputSection = document.getElementById("output-section");
  const hashtagList = document.getElementById("hashtag-list");
  const hashtagCount = document.getElementById("hashtag-count");
  const copyAllBtn = document.getElementById("copy-all-btn");
  const copyAllText = document.getElementById("copy-all-text");
  const favoritesSection = document.getElementById("favorites-section");
  const favoritesList = document.getElementById("favorites-list");
  const clearFavorites = document.getElementById("clear-favorites");
  const platformBtns = document.querySelectorAll(".platform-btn");

  let currentPlatform = "instagram";
  let currentTags = [];
  let generating = false;

  const favorites = JSON.parse(localStorage.getItem("ht_favorites") || "[]");

  function saveFavorites() {
    localStorage.setItem("ht_favorites", JSON.stringify(favorites));
    renderFavorites();
  }

  function renderFavorites() {
    if (favorites.length === 0) { favoritesSection.classList.add("hidden"); return; }
    favoritesSection.classList.remove("hidden");
    favoritesList.innerHTML = favorites.map((tag) =>
      `<span class="fav-pill inline-flex items-center gap-1 px-3 py-1.5 rounded-xl border border-amber-500/30 bg-amber-500/10 text-xs text-amber-300 font-medium select-none">${tag}<span class="remove-fav cursor-pointer hover:text-red-400 ml-0.5" data-tag="${tag}">✕</span></span>`
    ).join("");

    favoritesList.querySelectorAll(".remove-fav").forEach((el) => {
      el.addEventListener("click", () => {
        const tag = el.dataset.tag;
        const idx = favorites.indexOf(tag);
        if (idx > -1) { favorites.splice(idx, 1); saveFavorites(); }
      });
    });
  }

  clearFavorites.addEventListener("click", () => {
    favorites.length = 0;
    saveFavorites();
  });

  // ─── Tag pools ───
  const TAG_POOLS = {
    instagram: [
      "instagram","instagood","photooftheday","explore","explorepage",
      "reels","reelsinstagram","instareels","trending","viral",
      "fashion","style","beauty","makeup","skincare",
      "fitness","gym","workout","foodie","food","travel",
      "photography","nature","landscape","art",
      "music","dance","comedy","memes","quotes","motivation",
      "lifestyle","aesthetic","summer","love","instadaily",
    ],
    tiktok: [
      "tiktok","fyp","foryou","foryoupage","viral","trending",
      "tiktokviral","tiktokchallenge","tiktokdance",
      "fypシ","xyzbca","blowthisup","viraltiktok",
      "dancechallenge","comedy","funny","memes",
      "transition","greenscreen","duet","stitch","voiceover",
      "tutorial","lifehack","prank","challenge",
      "music","singer","rapper","dancer","creator",
      "fitness","workout","health","food","recipe","travel",
    ],
    youtube: [
      "youtube","youtuber","youtubevideos","subscribe","contentcreator",
      "videomaker","newvideo","videography","creator",
      "growyourchannel","youtubegrowth","youtubecommunity",
      "vlog","vlogger","tutorial","howto","education",
      "entertainment","gaming","tech","review","unboxing","challenge",
      "dailyvlog","lifestyle","fitness","music","comedy",
      "diy","cooking","travel","fashion","photography",
    ],
    shorts: [
      "shorts","youtubeshorts","shortsviral","shortvideo","shortsvideo",
      "shortsfeed","shortscommunity","viralshorts","trendingshorts",
      "shortstrending","shortscreator","shortscontent",
      "shortsdaily","ytshorts","gaming","tech",
      "comedy","funny","memes","dance","music","fitness",
      "workout","food","recipe","cooking","travel","nature",
      "motivation","tips","lifehack","diy",
      "art","reaction","prank","challenge","tutorial",
    ],
    threads: [
      "threads","threadsapp","threadscommunity","threadsindia",
      "threadsusa","threadstrending","threadsviral",
      "viral","trending","foryou","explore",
      "contentcreator","creator","socialmedia",
      "photography","art","music","writing","poetry",
      "tech","startup","business","marketing","design",
      "fashion","style","fitness","travel","food",
      "motivation","quotes","mindset","growth",
    ],
  };

  const POPULARITY_MAP = {
    viral: "Viral", trending: "Viral", fyp: "Viral", explorepage: "Viral",
    instagram: "High", tiktok: "High", youtube: "High", reels: "High",
    subscribe: "High", shorts: "High", threads: "High",
    explore: "High", photooftheday: "High",
    reelsinstagram: "High", fypシ: "High", xyzbca: "High",
    youtubeshorts: "High",
    fashion: "High", beauty: "High", fitness: "High", travel: "High", food: "High",
    music: "High", comedy: "High", dance: "High", art: "High",
    love: "High", style: "High", nature: "High",
    // Medium defaults, Low for very specific
  };

  function getTagPopularity(tag) {
    const clean = tag.replace(/^#/, "").toLowerCase();
    return POPULARITY_MAP[clean] || (clean.length > 12 ? "Low" : "Medium");
  }

  function getTagScore(tag) {
    const p = getTagPopularity(tag);
    return p === "Viral" ? 90 : p === "High" ? 65 : p === "Medium" ? 35 : 15;
  }

  function shuffle(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  const STOP_WORDS = new Set([
    "a","an","the","and","or","but","in","on","at","to","for",
    "of","with","by","from","as","is","was","are","were","be",
    "been","being","have","has","had","do","does","did","will",
    "would","could","should","may","might","shall","can","need",
    "about","into","through","during","before","after","above","below",
    "between","out","off","over","under","again","then","once",
    "here","there","when","where","why","how","all","each","every",
    "both","few","more","most","other","some","such","no","nor","not",
    "only","own","same","so","than","too","very","just","because",
    "this","that","these","those","it","its","my","your","his","her",
    "our","their",
  ]);

  function extractKeywords(text) {
    return text.toLowerCase().replace(/[^a-z0-9\s]/g, "").split(/\s+/)
      .filter((w) => w.length > 1 && !STOP_WORDS.has(w));
  }

  function generateHashtags(topic, platform) {
    const pool = TAG_POOLS[platform] || TAG_POOLS.instagram;
    const keywords = extractKeywords(topic);
    const tags = new Set();

    keywords.forEach((kw) => {
      tags.add(kw);
      if (kw.length > 2) tags.add(kw + "tips");
      if (kw.length > 2) tags.add(kw + "ideas");
      if (kw.length > 2) tags.add("best" + kw);
      if (kw.length > 2) tags.add("top" + kw);
      if (kw.length > 2) tags.add(kw + "life");
      if (kw.length > 3) tags.add("howto" + kw);
      if (kw.length > 3) tags.add("new" + kw);
    });

    const shuffledPool = shuffle(pool);
    const poolCount = keywords.length > 1 ? 12 : 16;
    shuffledPool.slice(0, poolCount).forEach((t) => tags.add(t));

    if (keywords.length === 0) {
      shuffle(pool).slice(0, 6).forEach((t) => tags.add(t));
    }

    const result = shuffle([...tags])
      .map((t) => "#" + t.replace(/[^a-z0-9]/g, "").toLowerCase())
      .filter((t) => t.length > 2 && t.length < 25);

    const targetCount = platform === "instagram" ? 28
      : platform === "tiktok" ? 22
      : platform === "shorts" ? 22
      : platform === "threads" ? 12
      : 24;

    return shuffle(result).slice(0, Math.min(targetCount, result.length));
  }

  function calcAnalytics(tags) {
    if (tags.length === 0) return { avgScore: 0, reach: 0 };
    const scores = tags.map(getTagScore);
    const avgScore = Math.round(scores.reduce((a, b) => a + b, 0) / scores.length);
    // reach = avg score * tag count * some factor
    const base = avgScore * tags.length * 150;
    const reach = base < 1000 ? base : base < 1000000 ? Math.round(base / 1000) + "K" : (base / 1000000).toFixed(1) + "M";
    return { avgScore, reach };
  }

  function renderTags() {
    hashtagList.innerHTML = "";
    currentTags.forEach((tag) => {
      const pop = getTagPopularity(tag);
      const popColors = {
        Low: "border-zinc-700/50 bg-surface-1 text-tertiary",
        Medium: "border-blue-500/30 bg-blue-500/10 text-blue-300",
        High: "border-purple-500/30 bg-purple-500/10 text-purple-300",
        Viral: "border-rose-500/30 bg-rose-500/10 text-rose-300",
      };

      const outer = document.createElement("span");
      outer.className = `hashtag-pill group inline-flex items-center gap-1 px-3 py-1.5 rounded-xl border text-xs font-medium cursor-pointer hover:opacity-80 active:scale-95 transition-all select-none ${popColors[pop] || popColors.Low}`;
      outer.title = `Click to copy · Popularity: ${pop}`;

      // Star for favorites
      const star = document.createElement("span");
      const isFav = favorites.includes(tag);
      star.textContent = isFav ? "⭐" : "☆";
      star.className = "text-[11px] opacity-60 group-hover:opacity-100 transition-opacity shrink-0";
      star.title = isFav ? "Remove from favorites" : "Add to favorites";

      const label = document.createElement("span");
      label.textContent = tag;

      // Popularity badge
      const badge = document.createElement("span");
      badge.className = `text-[8px] font-semibold uppercase px-1.5 py-0.5 rounded ml-0.5 ${
        pop === "Viral" ? "bg-rose-500/20 text-rose-400" :
        pop === "High" ? "bg-purple-500/20 text-purple-400" :
        pop === "Medium" ? "bg-blue-500/20 text-blue-400" :
        "bg-surface-1 text-muted"
      }`;
      badge.textContent = pop === "Viral" ? "🔥" : pop;

      outer.appendChild(star);
      outer.appendChild(label);
      outer.appendChild(badge);

      // Click to copy
      outer.addEventListener("click", (e) => {
        if (e.target === star) return;
        navigator.clipboard.writeText(tag).catch(() => {});
        triggerToast(`Copied #${tag}`, "success");
        const orig = outer.className;
        label.textContent = "Copied!";
        outer.classList.add("ring-1", "ring-emerald-500/50");
        setTimeout(() => { label.textContent = tag; outer.className = orig; }, 800);
      });

      // Star toggle
      star.addEventListener("click", (e) => {
        e.stopPropagation();
        const idx = favorites.indexOf(tag);
        if (idx > -1) { favorites.splice(idx, 1); star.textContent = "☆"; }
        else { favorites.push(tag); star.textContent = "⭐"; }
        saveFavorites();
      });

      hashtagList.appendChild(outer);
    });
    hashtagCount.textContent = `${currentTags.length} hashtags · ${currentPlatform}`;

    // Analytics
    const { avgScore, reach } = calcAnalytics(currentTags);
    analyticsBar.classList.remove("hidden");
    popularityNum.textContent = avgScore;
    const popText = avgScore >= 75 ? "Viral" : avgScore >= 50 ? "High" : avgScore >= 30 ? "Medium" : "Low";
    const popColors = { Viral: "bg-rose-500/20 text-rose-400 border-rose-500/30", High: "bg-purple-500/20 text-purple-400 border-purple-500/30", Medium: "bg-blue-500/20 text-blue-400 border-blue-500/30", Low: "bg-surface-1 text-muted border-zinc-700/30" };
    popularityLabel.textContent = popText;
    popularityLabel.className = `text-[10px] font-semibold px-2 py-0.5 rounded-full border ${popColors[popText]}`;
    reachNum.textContent = reach;
  }

  function doGenerate() {
    if (generating) return;
    const topic = topicInput.value.trim();
    if (!topic) {
      topicInput.focus();
      topicInput.classList.add("ring-2", "ring-red-500/40", "border-red-500/60");
      setTimeout(() => topicInput.classList.remove("ring-2", "ring-red-500/40", "border-red-500/60"), 1500);
      return;
    }

    generating = true;
    btnText.textContent = "Generating...";
    btnSpinner.classList.remove("hidden");

    setTimeout(() => {
      currentTags = generateHashtags(topic, currentPlatform);
      renderTags();
      outputSection.classList.remove("hidden");
      generating = false;
      btnText.textContent = "Generate";
      btnSpinner.classList.add("hidden");
    }, 300);
  }

  generateBtn.addEventListener("click", doGenerate);
  topicInput.addEventListener("keydown", (e) => { if (e.key === "Enter") doGenerate(); });

  function triggerToast(message: string, variant: "success" | "error" | "info" | "warning" = "success") {
    if ((window as any).__showToast) {
      (window as any).__showToast({ message, variant });
    }
  }

  randomizeBtn.addEventListener("click", () => {
    const topics = ["tech reviews","fitness tips","travel vlog","cooking recipes","gaming clips","music covers","dance trends","daily vlog","fashion haul","skincare routine","book reviews","art timelapse","pet videos","study tips","productivity hacks","nature photography","car detailing","home decor","street food","behind the scenes"];
    topicInput.value = topics[Math.floor(Math.random() * topics.length)];
    doGenerate();
  });

  copyAllBtn.addEventListener("click", async () => {
    if (currentTags.length === 0) { triggerToast("No hashtags to copy!", "warning"); return; }
    try {
      await navigator.clipboard.writeText(currentTags.join(" "));
      triggerToast(`${currentTags.length} hashtags copied!`, "success");
      copyAllText.textContent = "Copied!";
      copyAllBtn.classList.add("border-emerald-500/50", "text-emerald-300");
      setTimeout(() => {
        copyAllText.textContent = "Copy All";
        copyAllBtn.classList.remove("border-emerald-500/50", "text-emerald-300");
      }, 2000);
    } catch {}
  });

  platformBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      platformBtns.forEach((b) => {
        b.classList.remove("bg-purple-600/20", "border-purple-500/40", "text-purple-300");
        b.classList.add("bg-surface-1", "border-surface", "text-tertiary");
      });
      btn.classList.remove("bg-surface-1", "border-surface", "text-tertiary");
      btn.classList.add("bg-purple-600/20", "border-purple-500/40", "text-purple-300");
      currentPlatform = btn.dataset.platform;
    });
  });

  // Trending tag click-to-copy
  document.querySelectorAll(".trending-tag").forEach((tag) => {
    tag.addEventListener("click", () => {
      const text = tag.textContent.trim();
      navigator.clipboard.writeText(text).catch(() => {});
      triggerToast(`Copied ${text}`, "success");
      const orig = tag.textContent;
      tag.textContent = "Copied!";
      tag.classList.add("bg-emerald-600/20", "text-emerald-300");
      setTimeout(() => {
        tag.textContent = orig;
        tag.classList.remove("bg-emerald-600/20", "text-emerald-300");
      }, 1000);
    });
  });

  // Init
  document.querySelector('[data-platform="instagram"]').click();
  renderFavorites();
</script>



