---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'What is WCAG contrast ratio?',
    answer:
      'WCAG (Web Content Accessibility Guidelines) defines contrast ratios to ensure text is readable. The ratio is calculated as (L1 + 0.05) / (L2 + 0.05) where L1 is the relative luminance of the lighter color and L2 of the darker color. AA requires 4.5:1 for normal text, AAA requires 7:1.',
  },
  {
    question: 'What is the difference between AA and AAA?',
    answer:
      'AA is the minimum recommended contrast level (4.5:1 for normal text, 3:1 for large text). AAA is an enhanced standard (7:1 for normal text, 4.5:1 for large text). AA is typically required for legal compliance, while AAA is a best-practice target.',
  },
  {
    question: 'How do I fix low contrast issues?',
    answer:
      'To improve contrast, darken the foreground text or lighten the background (or vice versa). Small adjustments to hex values can significantly impact the contrast ratio. Tools like this checker help you verify compliance before deploying your design.',
  },
];
const schema = {
  name: 'Color Contrast Checker',
  applicationCategory: 'Utilities',
  description:
    'Check color contrast ratios for WCAG AA/AAA compliance. Enter foreground and background hex colors to verify accessibility.',
  featureList: ['WCAG AA/AAA checking', 'Normal and large text', 'UI component compliance', 'Visual color preview'],
};

const benefits = [
  {
    icon: '✅',
    title: 'WCAG Compliance',
    desc: 'Instantly check if your colors pass WCAG AA (4.5:1) and AAA (7:1) accessibility standards.',
  },
  {
    icon: '🎨',
    title: 'Live Preview',
    desc: 'See exactly how the foreground text will look against the background color in real-time.',
  },
  {
    icon: '🔍',
    title: 'Detailed Checks',
    desc: 'Get separate compliance results for both normal text and large text (headings).',
  },
  {
    icon: '🔒',
    title: '100% Client-Side',
    desc: 'No server tracking. All contrast calculations run locally in your browser.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Enter Foreground',
    desc: 'Type or paste the hex color code (e.g., #FFFFFF) for your text.',
  },
  {
    num: '2',
    title: 'Enter Background',
    desc: 'Type or paste the hex color code for your background.',
  },
  {
    num: '3',
    title: 'Check Contrast',
    desc: 'Click Check Contrast to instantly calculate the contrast ratio between the two colors.',
  },
  {
    num: '4',
    title: 'Review Results',
    desc: 'Check the breakdown to see if your color pair passes WCAG AA and AAA standards.',
  },
];

const useCases = [
  {
    icon: '🖌️',
    title: 'Web Design',
    desc: 'Ensure your website color palette meets legal accessibility requirements before development begins.',
  },
  {
    icon: '📱',
    title: 'App UI',
    desc: 'Check the contrast of buttons, badges, and alerts to guarantee readability on mobile devices.',
  },
  {
    icon: '📈',
    title: 'Accessibility Audits',
    desc: 'Use the tool during QA testing to quickly verify compliance and identify contrast issues.',
  },
];
---

<MainLayout
  title="WCAG Color Contrast Checker Online — Free AA & AAA Accessibility Tester | NumanX Tools"
  description="Check color contrast ratios for WCAG AA/AAA compliance. Enter foreground and background hex colors to verify accessibility."
  keywords="wcag color contrast checker, color contrast checker, wcag contrast, accessibility tester, aa aaa contrast checker, contrast ratio"
  toolSchema={schema}
  faq={faqItems}
  howto={{
    name: 'How to Use Color Contrast Checker',
    description: 'Step-by-step guide for using Color Contrast Checker.',
    steps: [],
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Color Contrast Checker', url: '/tools/color-contrast-checker/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="Contrast"
        gradient="Checker Pro"
        desc="Check color contrast ratios for WCAG AA/AAA compliance. Enter foreground and background hex colors to verify accessibility."
        badge="✦ New Tool"
        slug="color-contrast-checker"
      />
      <ShareBar />
      <div class="max-w-xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
              <span id="usage-badge" class="text-xs text-muted"></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex gap-1">
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="purple"
                  style="background:#a855f7"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="blue"
                  style="background:#3b82f6"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="green"
                  style="background:#22c55e"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="pink"
                  style="background:#ec4899"></button>
              </div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
              <label class="block text-xs font-medium text-tertiary mb-1.5">Foreground</label><input
                id="fg-input"
                type="text"
                value="#ffffff"
                maxlength="7"
                class="w-full px-3 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm font-mono focus:border-violet-400/50 focus:outline-none transition-all uppercase"
              /><div id="fg-preview" class="mt-2 h-12 rounded-xl border border-surface-3" style="background:#ffffff">
              </div>
            </div>
            <div>
              <label class="block text-xs font-medium text-tertiary mb-1.5">Background</label><input
                id="bg-input"
                type="text"
                value="#000000"
                maxlength="7"
                class="w-full px-3 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm font-mono focus:border-violet-400/50 focus:outline-none transition-all uppercase"
              /><div id="bg-preview" class="mt-2 h-12 rounded-xl border border-surface-3" style="background:#000000">
              </div>
            </div>
          </div>
          <button
            id="check-btn"
            class="w-full bg-gradient-to-r from-violet-400 to-purple-500 text-white font-bold text-sm px-6 py-3 rounded-xl hover:opacity-90 transition-all"
            >Check Contrast</button
          >
          <div class="flex gap-2 mt-4">
            <button
              id="copy-btn"
              class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              >Copy Results</button
            >
            <button
              id="share-btn"
              class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              title="Copy share link">🔗</button
            >
            <button
              id="download-btn"
              class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              >Download</button
            >
            <button
              id="clear-btn"
              class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              >Clear</button
            >
          </div>
          <div id="results" class="mt-6 pt-6 border-t border-surface hidden">
            <div class="text-center mb-4">
              <span class="text-xs text-tertiary">Contrast Ratio</span><div
                class="text-3xl font-black text-white"
                id="ratio-display"
              >
                21:1
              </div>
            </div>
            <div class="space-y-2" id="compliance-list"></div>
          </div>
        </div>
      </div>
      <ToolContentSections
        toolSlug="color-contrast-checker"
        toolName="Color Contrast Checker"
        category="Design Tools"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />
      <RelatedTools current="color-contrast-checker" />
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span class="bg-gradient-to-r from-violet-400 to-purple-500 bg-clip-text text-transparent"
            >Questions</span
          >
        </h2><Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>
<script>
  const fgInput = document.getElementById('fg-input');
  const bgInput = document.getElementById('bg-input');
  const fgPreview = document.getElementById('fg-preview');
  const bgPreview = document.getElementById('bg-preview');
  const checkBtn = document.getElementById('check-btn');
  const results = document.getElementById('results');
  const ratioDisplay = document.getElementById('ratio-display');
  const complianceList = document.getElementById('compliance-list');

  function hexToRgb(hex) {
    const h = hex.replace('#', '');
    return {
      r: parseInt(h.substring(0, 2), 16),
      g: parseInt(h.substring(2, 4), 16),
      b: parseInt(h.substring(4, 6), 16),
    };
  }

  function relativeLuminance(r, g, b) {
    const [rs, gs, bs] = [r, g, b].map((v) => {
      v = v / 255;
      return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
    });
    return 0.2126 * rs + 0.7152 * gs + 0.0722 * bs;
  }

  function contrastRatio(l1, l2) {
    const lighter = Math.max(l1, l2);
    const darker = Math.min(l1, l2);
    return (lighter + 0.05) / (darker + 0.05);
  }

  function updatePreviews() {
    fgPreview.style.background = fgInput.value;
    bgPreview.style.background = bgInput.value;
  }

  fgInput.addEventListener('input', updatePreviews);
  bgInput.addEventListener('input', updatePreviews);

  checkBtn.addEventListener('click', () => {
    const fg = hexToRgb(fgInput.value);
    const bg = hexToRgb(bgInput.value);
    const lFg = relativeLuminance(fg.r, fg.g, fg.b);
    const lBg = relativeLuminance(bg.r, bg.g, bg.b);
    const ratio = contrastRatio(lFg, lBg);

    ratioDisplay.textContent = ratio.toFixed(2) + ':1';
    results.classList.remove('hidden');

    const checks = [
      { label: 'AA Normal Text', pass: ratio >= 4.5, threshold: '4.5:1' },
      { label: 'AA Large Text', pass: ratio >= 3, threshold: '3:1' },
      { label: 'AAA Normal Text', pass: ratio >= 7, threshold: '7:1' },
      { label: 'AAA Large Text', pass: ratio >= 4.5, threshold: '4.5:1' },
    ];

    complianceList.innerHTML = '';
    checks.forEach((c) => {
      const div = document.createElement('div');
      div.className =
        'flex items-center justify-between px-4 py-2 rounded-lg border ' +
        (c.pass ? 'bg-green-900/20 border-green-500/30' : 'bg-red-900/20 border-red-500/30');
      div.innerHTML = `<span class="text-sm ${c.pass ? 'text-green-400' : 'text-red-400'}">${c.label}</span><span class="text-xs font-medium ${c.pass ? 'text-green-400' : 'text-red-400'}">${c.pass ? '✓ Pass' : '✗ Fail'} (min ${c.threshold})</span>`;
      complianceList.appendChild(div);
    });
  });

  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }
  document.getElementById('copy-btn')?.addEventListener('click', () => {
    const text = 'Contrast Ratio: ' + ratioDisplay.textContent + '\n\n' + complianceList.textContent;
    if (!text.trim()) return;
    navigator.clipboard.writeText(text).catch(() => {});
    playPing();
    const btn = document.getElementById('copy-btn');
    btn.textContent = 'Copied!';
    setTimeout(() => {
      btn.textContent = 'Copy Results';
    }, 2000);
  });
  document.getElementById('download-btn')?.addEventListener('click', () => {
    const content = 'Contrast Ratio: ' + ratioDisplay.textContent + '\n\n' + complianceList.textContent;
    if (!content.trim()) return;
    const blob = new Blob([content], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'contrast-results.txt';
    a.click();
    playPing();
    URL.revokeObjectURL(a.href);
  });
  document.getElementById('clear-btn')?.addEventListener('click', () => {
    fgInput.value = '#ffffff';
    bgInput.value = '#000000';
    results.classList.add('hidden');
    updatePreviews();
    playPing();
  });
  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('ratio-display');
    const t = o?.textContent || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof (window as any).__showToast === 'function')
      (window as any).__showToast({ message: 'Link copied!', variant: 'success' });
  });
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b = document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      document.getElementById('clear-btn')?.click();
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['contrast']) b.textContent = 'Used ' + u['contrast'] + '×';
  } catch (e) {}
  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      document.querySelectorAll("button[class*='bg-violet'],button[class*='bg-purple']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(violet|purple)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(violet|purple)-\d+/g, 'hover:bg-' + c + '-500');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}
  updatePreviews();

  // ─── Fullscreen ───
  (function() {
    var fsBtn = document.getElementById('fullscreen-btn');
    if (fsBtn) {
      fsBtn.addEventListener('click', function() {
        var el = document.querySelector('main') || document.documentElement;
        if (!document.fullscreenElement) { el.requestFullscreen && el.requestFullscreen(); }
        else { document.exitFullscreen && document.exitFullscreen(); }
      });
    }
    document.addEventListener('keydown', function(e) {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'f' || e.key === 'F') { if (fsBtn) fsBtn.click(); }
    });
  })();</script>
