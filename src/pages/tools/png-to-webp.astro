        </div>
        <div class="mt-3 h-2 bg-zinc-800 rounded-full overflow-hidden">
          <div
            id="analytics-bar-fill"
            class="h-full rounded-full bg-gradient-to-r from-purple-500 to-emerald-400 transition-all duration-700 ease-out"
            style="width:0%"
          >
          </div>
        </div>
      </div>
    </div>

    <div id="gallery-section" class="hidden mt-8 max-w-5xl mx-auto px-4">
      <h2 class="text-xl font-bold text-white flex items-center gap-2.5 mb-5">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-purple-400"
        >
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        Converted Images
