---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";
import KeyboardHints from "../../components/KeyboardHints.astro";


const faqItems = [
    { question: "How secure is the generated password?", answer: "Passwords use cryptographically random selection. With 16+ characters and all character types enabled, your password would take billions of years to crack with current technology." },
    { question: "What's the difference between password types?", answer: "Random mixes letters, numbers, and symbols. Pronounceable creates readable syllable-based words. Passphrase uses random dictionary words. PIN is numeric-only for quick entry." },
    { question: "Is my password stored anywhere?", answer: "No. Everything runs locally in your browser. Password history is stored in your browser's localStorage and never transmitted anywhere." },
    { question: "What is entropy?", answer: "Entropy measures password strength in bits. Each bit doubles the number of attempts needed to crack it. 80+ bits is considered strong, 128+ is military-grade." },
    { question: "What password length is recommended?", answer: "16+ characters for most accounts, 20+ for critical accounts (email, banking), 8+ digits for PINs, 4-6 words for passphrases." },
  ];
const pwSchema = {
  "name": "Password Generator Pro",
  "applicationCategory": "Security",
  "description": "Generate strong passwords, PINs, and passphrases with real-time strength meter and entropy scoring.",
  "featureList": [
    "Cryptographically random password generation",
    "Real-time strength meter with entropy score",
    "Random, pronounceable, passphrase, and PIN modes",
    "Custom length, symbols, numbers, and uppercase options",
    "Password history stored locally — nothing transmitted"
  ],
}
---

<MainLayout
  title="Password Generator - Strong Password & PIN Generator Online"
  description="Generate strong secure passwords, PINs, passphrases, and pronounceable passwords. Includes strength meter, entropy score, and history."
  keywords="password generator, strong password, pin generator, passphrase generator, secure password, entropy score"
  toolSchema={pwSchema}
  faq={faqItems}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Tools", url: "/tools/" },
    { name: "Password Generator", url: "/tools/password-generator/" },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-5xl mx-auto">
      <ToolHeader
        title="Password"
        gradient="Generator Pro"
        desc="Generate strong passwords, PINs, and passphrases with real-time strength meter and entropy scoring. 1Password + Bitwarden inspired."
        badge="âœ¦ Pro Version"
        slug="password-generator"
      />

      <ShareBar />

      <!-- â”€â”€â”€ Tool Interface â”€â”€â”€ -->
      <div class="max-w-xl mx-auto mt-8 space-y-4">

        <!-- Password Display â€” 1Password-style large card -->
        <div class="relative bg-white/[0.05] border border-white/[0.08] rounded-2xl p-5 flex items-center justify-between group min-h-[72px] focus-within:border-purple-500/40 transition-all">
          <span id="password-display" class="text-base sm:text-lg font-mono text-zinc-500 break-all select-all pr-14 leading-relaxed tracking-wide">Click generate to create a secure password</span>
          <button id="copy-btn" class="absolute right-4 bg-zinc-800 hover:bg-purple-600 border border-white/[0.1] text-zinc-400 hover:text-white p-2.5 rounded-xl transition-all" title="Copy to clipboard">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>

        <!-- Password Options -->
        <div class="space-y-3">
          <div class="flex flex-wrap gap-2" id="type-buttons">
            {["Random","Pronounceable","Passphrase","PIN"].map(t => (
              <button class="type-btn rounded-xl py-2 px-4 text-xs font-medium border transition-all bg-white/[0.05] border-white/[0.06] text-zinc-400 hover:text-white hover:border-white/[0.12] active:scale-95" data-type={t}>{t}</button>
            ))}
          </div>

          <div class="flex items-center justify-between gap-4">
            <div class="flex-1">
              <label class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider flex justify-between mb-2">
                <span>Length</span>
                <span id="length-display" class="text-zinc-300 font-mono">16</span>
              </label>
              <input id="length-slider" type="range" min="4" max="64" value="16" class="w-full h-1.5 bg-zinc-800 rounded-full appearance-none cursor-pointer accent-purple-500 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-purple-500 [&::-webkit-slider-thumb]:shadow-lg [&::-webkit-slider-thumb]:shadow-purple-900/40" />
            </div>
          </div>

          <!-- Options -->
          <div class="flex flex-wrap gap-3 text-xs" id="options">
            {["uppercase","lowercase","numbers","symbols"].map(o => (
              <label class="flex items-center gap-2 cursor-pointer text-zinc-400 hover:text-zinc-300 transition-colors">
                <input type="checkbox" checked class="rounded border-zinc-700 bg-zinc-900 text-purple-500 focus:ring-purple-500/30 focus:ring-offset-0" />
                <span class="capitalize">{o}</span>
              </label>
            ))}
          </div>

          <button id="generate-btn" class="w-full bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-semibold py-3 rounded-xl transition-all shadow-lg shadow-purple-900/20 text-sm active:scale-[0.98]">
            Generate Password
          </button>
        </div>

        <!-- Entropy + Strength -->
        <div class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-4 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider">Strength</span>
            <span id="strength-label" class="text-xs font-bold text-zinc-400">--</span>
          </div>
          <div class="h-1.5 bg-zinc-800 rounded-full overflow-hidden">
            <div id="strength-bar" class="h-full rounded-full transition-all duration-500" style="width:0%"></div>
          </div>
          <div class="flex justify-between text-[10px] text-zinc-600">
            <span>Weak</span>
            <span>Strong</span>
            <span id="entropy-display" class="text-zinc-500 font-mono">0 bits</span>
          </div>
        </div>

        <!-- History -->
        <div id="history-section" class="hidden">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider">Recent Passwords</span>
            <button id="clear-history" class="text-[10px] text-zinc-600 hover:text-zinc-400 transition-colors">Clear</button>
          </div>
          <div id="history-list" class="space-y-1 max-h-32 overflow-y-auto"></div>
        </div>
      </div>

      <!-- ─── FAQ ─── -->
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} />
      </div>

      <KeyboardHints hints={[
        { keys: "⌘C", label: "Copy password" },
        { keys: "⌘K", label: "Open search" },
        { keys: "Space", label: "Generate new" },
      ]} />

      <RelatedTools current="password-generator" />
    </div>
  </main>
</MainLayout>

<script>
  const display = document.getElementById("password-display");
  const generateBtn = document.getElementById("generate-btn");
  const copyBtn = document.getElementById("copy-btn");
  const lengthSlider = document.getElementById("length-slider");
  const lengthDisplay = document.getElementById("length-display");
  const strengthBar = document.getElementById("strength-bar");
  const strengthLabel = document.getElementById("strength-label");
  const entropyDisplay = document.getElementById("entropy-display");
  const historyList = document.getElementById("history-list");
  const historySection = document.getElementById("history-section");
  const clearHistory = document.getElementById("clear-history");
  const typeBtns = document.querySelectorAll(".type-btn");
  const typeOpts = document.querySelectorAll("#options input");

  let currentType = "Random";
  const HISTORY_KEY = "pwd_history";

  typeBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      typeBtns.forEach((b) => {
        b.classList.remove("bg-purple-600/15", "border-purple-500/50", "text-purple-300");
        b.classList.add("bg-white/[0.05]", "border-white/[0.06]", "text-zinc-400");
      });
      btn.classList.remove("bg-white/[0.05]", "border-white/[0.06]", "text-zinc-400");
      btn.classList.add("bg-purple-600/15", "border-purple-500/50", "text-purple-300");
      currentType = btn.dataset.type;
      generate();
    });
  });

  lengthSlider.addEventListener("input", () => {
    lengthDisplay.textContent = lengthSlider.value;
    generate();
  });

  typeOpts.forEach((cb) => cb.addEventListener("change", generate));

  function getCharset() {
    const opts = Array.from(typeOpts).filter((c) => c.checked);
    let set = "";
    if (opts.some((c) => c.value === "uppercase" || c.nextElementSibling.textContent.trim() === "uppercase")) set += "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    if (opts.some((c) => c.value === "lowercase" || c.nextElementSibling.textContent.trim() === "lowercase")) set += "abcdefghijklmnopqrstuvwxyz";
    if (opts.some((c) => c.value === "numbers" || c.nextElementSibling.textContent.trim() === "numbers")) set += "0123456789";
    if (opts.some((c) => c.value === "symbols" || c.nextElementSibling.textContent.trim() === "symbols")) set += "!@#$%^&*()_+-=[]{}|;:,.<>?";
    return set || "abcdefghijklmnopqrstuvwxyz";
  }

  function randomPassword(len) {
    const set = getCharset();
    const arr = new Uint32Array(len);
    crypto.getRandomValues(arr);
    return Array.from(arr, (v) => set[v % set.length]).join("");
  }

  function pronounceablePassword(len) {
    const vowels = "aeiou";
    const consonants = "bcdfghjklmnpqrstvwxyz";
    let pwd = "";
    for (let i = 0; i < len; i++) {
      pwd += (i % 2 === 0 ? consonants : vowels)[Math.floor(Math.random() * (i % 2 === 0 ? consonants.length : vowels.length))];
    }
    return pwd;
  }

  function passphrasePassword() {
    const words = ["sunset","ocean","forest","mountain","river","thunder","crystal","silver","golden","flame","shadow","blaze","storm","frost","ember","cosmic","velvet","drift","fusion","echo","orbit","zenith","aurora","cascade","harbor","lunar","solar","tidal","vortex","wilder"];
    const count = Math.max(3, Math.min(8, Math.floor(parseInt(lengthSlider.value) / 5)));
    const selected = [];
    for (let i = 0; i < count; i++) {
      let w;
      do { w = words[Math.floor(Math.random() * words.length)]; } while (selected.includes(w));
      selected.push(w);
    }
    return selected.map((w, i) => i === 0 ? w.charAt(0).toUpperCase() + w.slice(1) : w).join("-");
  }

  function pinPassword(len) {
    const arr = new Uint32Array(len);
    crypto.getRandomValues(arr);
    return Array.from(arr, (v) => "0123456789"[v % 10]).join("");
  }

  function entropy(len, charsetSize) {
    if (!charsetSize) return 0;
    return Math.round(len * Math.log2(charsetSize));
  }

  function updateStrength(e) {
    const colors = ["bg-red-500","bg-orange-500","bg-amber-500","bg-lime-500","bg-emerald-500"];
    const labels = ["Weak","Fair","Good","Strong","Very Strong"];
    const idx = Math.min(4, Math.floor(e / 20));
    strengthBar.style.width = Math.min(100, e) + "%";
    strengthBar.className = `h-full rounded-full transition-all duration-500 ${colors[idx]}`;
    strengthLabel.textContent = labels[idx];
    strengthLabel.className = `text-xs font-bold ${["text-red-400","text-orange-400","text-amber-400","text-lime-400","text-emerald-400"][idx]}`;
  }

  function generate() {
    const len = parseInt(lengthSlider.value);
    let pwd = "";
    switch (currentType) {
      case "Random": pwd = randomPassword(len); break;
      case "Pronounceable": pwd = pronounceablePassword(len); break;
      case "Passphrase": pwd = passphrasePassword(); break;
      case "PIN": pwd = pinPassword(len); break;
    }
    display.textContent = pwd;
    const cs = getCharset().length;
    const e = entropy(pwd.length, cs || 26);
    entropyDisplay.textContent = e + " bits";
    updateStrength(e);

    // Save to history
    let hist = JSON.parse(localStorage.getItem(HISTORY_KEY) || "[]");
    hist = [pwd, ...hist.filter((h) => h !== pwd)].slice(0, 20);
    localStorage.setItem(HISTORY_KEY, JSON.stringify(hist));
    renderHistory();
  }

  function renderHistory() {
    const hist = JSON.parse(localStorage.getItem(HISTORY_KEY) || "[]");
    if (hist.length === 0) { historySection.classList.add("hidden"); return; }
    historySection.classList.remove("hidden");
    historyList.innerHTML = hist.map((p) => `<div class="flex items-center justify-between py-1.5 px-3 rounded-lg hover:bg-white/[0.03] transition-colors"><code class="text-xs font-mono text-zinc-400">${p}</code><button class="copy-hist text-[10px] text-zinc-600 hover:text-zinc-400" data-pwd="${p}">Copy</button></div>`).join("");
    historyList.querySelectorAll(".copy-hist").forEach((btn) => {
      btn.addEventListener("click", () => {
        navigator.clipboard.writeText(btn.dataset.pwd);
        btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = "Copy"), 1500);
      });
    });
  }

  function triggerToast(message: string, variant: "success" | "error" | "info" | "warning" = "success") {
    if ((window as any).__showToast) {
      (window as any).__showToast({ message, variant });
    }
  }

  copyBtn.addEventListener("click", () => {
    navigator.clipboard.writeText(display.textContent);
    triggerToast("Password copied to clipboard!", "success");
  });

  clearHistory.addEventListener("click", () => {
    localStorage.removeItem(HISTORY_KEY);
    renderHistory();
    triggerToast("Password history cleared", "info");
  });

  // Init
  typeBtns[0]?.classList.add("bg-purple-600/15", "border-purple-500/50", "text-purple-300");
  generate();
  renderHistory();
</script>
