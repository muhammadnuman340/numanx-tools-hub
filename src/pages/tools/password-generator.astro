  function getSecureRandomInt(max: number): number {
    const arr = new Uint32Array(1);
    const limit = 0xffffffff - (0xffffffff % max);
    let val: number;
    do {
      crypto.getRandomValues(arr);
      val = arr[0];
    } while (val >= limit);
    return val % max;
  }

  function generateSecureWordPassphrase(wordCount = 4, separator = '-', transform = 'capitalize', includeNumber = true): string {
    const selected: string[] = [];
    const usedIndices = new Set<number>();

    while (selected.length < wordCount) {
      const idx = getSecureRandomInt(EFF_WORDS.length);
      if (!usedIndices.has(idx)) {
        usedIndices.add(idx);
        let w = EFF_WORDS[idx];
        if (transform === 'capitalize') {
          w = w.charAt(0).toUpperCase() + w.slice(1);
        } else if (transform === 'uppercase') {
          w = w.toUpperCase();
        } else {
          w = w.toLowerCase();
        }
        selected.push(w);
      }
    }

    let result = selected.join(separator);
    if (includeNumber) {
      const symbols = ['#', '!', '$', '%', '&', '@'];
      const sym = symbols[getSecureRandomInt(symbols.length)];
      const num = getSecureRandomInt(90) + 10;
      result += separator ? `${separator}${sym}${num}` : `${sym}${num}`;
    }
    return result;
  }

  function passphrasePassword() {
    const count = Math.max(3, Math.min(8, Math.floor(parseInt(lengthSlider.value) / 5)));
    return generateSecureWordPassphrase(count, '-', 'capitalize', false);
  }

  function pinPassword(len) {
    const arr = new Uint32Array(len);
    crypto.getRandomValues(arr);
    return Array.from(arr, (v) => '0123456789'[v % 10]).join('');
  }

  function entropy(len, charsetSize) {
    if (!charsetSize) return 0;
    return Math.round(len * Math.log2(charsetSize));
  }

  function updateStrength(e) {
    const colors = ['bg-red-500', 'bg-orange-500', 'bg-amber-500', 'bg-lime-500', 'bg-emerald-500'];
    const labels = ['Weak', 'Fair', 'Good', 'Strong', 'Very Strong'];
    const idx = Math.min(4, Math.floor(e / 20));
    strengthBar.style.width = Math.min(100, e) + '%';
    strengthBar.className = `h-full rounded-full transition-all duration-500 ${colors[idx]}`;
    strengthLabel.textContent = labels[idx];
    strengthLabel.className = `text-xs font-bold ${['text-red-400', 'text-orange-400', 'text-amber-400', 'text-lime-400', 'text-emerald-400'][idx]}`;
  }

  function generate() {
    const len = parseInt(lengthSlider.value);
    let pwd = '';
    switch (currentType) {
      case 'Random':
        pwd = randomPassword(len);
        break;
      case 'Pronounceable':
        pwd = pronounceablePassword(len);
        break;
      case 'Passphrase':
        pwd = passphrasePassword();
        break;
      case 'PIN':
        pwd = pinPassword(len);
        break;
    }
    display.textContent = pwd;
    const cs = getCharset().length;
    const e = entropy(pwd.length, cs || 26);
    entropyDisplay.textContent = e + ' bits';
    updateStrength(e);

    // Add to in-memory session history (never persisted)
    sessionHistoryManager.add(pwd);
    renderHistory();
  }

  function renderHistory() {
    if (!historySection || !historyList) return;
    const hist = sessionHistoryManager.getAll();
    if (hist.length === 0) {
      historySection.classList.add('hidden');
      historyList.replaceChildren();
      return;
    }
    historySection.classList.remove('hidden');
    historyList.replaceChildren();

    hist.forEach((p) => {
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between py-1.5 px-3 rounded-lg hover:bg-surface-1 transition-colors';

      const code = document.createElement('code');
      code.className = 'text-xs font-mono text-tertiary';
      code.textContent = p;

      const copyBtn = document.createElement('button');
      copyBtn.className = 'copy-hist text-[10px] text-dim hover:text-tertiary';
      copyBtn.textContent = 'Copy';
      copyBtn.setAttribute('type', 'button');
      copyBtn.setAttribute('aria-label', 'Copy password from session history');
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(p);
        copyBtn.textContent = 'Copied!';
        triggerToast('Password copied to clipboard!', 'success');
        setTimeout(() => {
          copyBtn.textContent = 'Copy';
        }, 1500);
      });

      row.appendChild(code);
      row.appendChild(copyBtn);
      historyList.appendChild(row);
    });
  }

  function triggerToast(message: string, variant: 'success' | 'error' | 'info' | 'warning' = 'success') {
    if ((window as any).__showToast) {
      (window as any).__showToast({ message, variant });
    }
  }

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(display.textContent);
    triggerToast('Password copied to clipboard!', 'success');
  });

  clearHistory.addEventListener('click', () => {
    sessionHistoryManager.clear();
    renderHistory();
    triggerToast('Session history cleared', 'info');
  });

  // ─── Download ───
  document.getElementById('download-btn')?.addEventListener('click', () => {
    const pwd = display.textContent;
    if (!pwd || pwd === 'Click generate to create a secure password') return;
    const text = `Password: ${pwd}\nType: ${currentType}\nLength: ${lengthSlider.value}\nEntropy: ${entropyDisplay.textContent}\nGenerated: ${new Date().toLocaleString()}`;
    const blob = new Blob([text], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'password.txt';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // ─── Word-Based Passphrase Panel Handlers ───
  const wordDisplay = document.getElementById('word-passphrase-display');
  const copyWordBtn = document.getElementById('copy-word-passphrase-btn');
  const copyWordText = document.getElementById('copy-word-passphrase-text');
  const wordCountSlider = document.getElementById('word-count-slider') as HTMLInputElement | null;
  const wordCountNum = document.getElementById('word-count-num');
  const wordSeparatorSelect = document.getElementById('word-separator-select') as HTMLSelectElement | null;
  const wordTransformSelect = document.getElementById('word-transform-select') as HTMLSelectElement | null;
  const wordIncludeNumber = document.getElementById('word-include-number') as HTMLInputElement | null;
  const generateWordBtn = document.getElementById('generate-word-passphrase-btn');

  function updateWordPassphrase() {
    if (!wordDisplay) return;
    const count = wordCountSlider ? parseInt(wordCountSlider.value) : 4;
    if (wordCountNum) wordCountNum.textContent = `${count} words`;
    const sep = wordSeparatorSelect ? wordSeparatorSelect.value : '-';
    const trans = wordTransformSelect ? wordTransformSelect.value : 'capitalize';
    const incNum = wordIncludeNumber ? wordIncludeNumber.checked : true;

    const pwd = generateSecureWordPassphrase(count, sep, trans, incNum);
    wordDisplay.textContent = pwd;
  }

  if (wordCountSlider) wordCountSlider.addEventListener('input', updateWordPassphrase);
  if (wordSeparatorSelect) wordSeparatorSelect.addEventListener('change', updateWordPassphrase);
  if (wordTransformSelect) wordTransformSelect.addEventListener('change', updateWordPassphrase);
  if (wordIncludeNumber) wordIncludeNumber.addEventListener('change', updateWordPassphrase);
  if (generateWordBtn) generateWordBtn.addEventListener('click', updateWordPassphrase);

  if (copyWordBtn && wordDisplay) {
    copyWordBtn.addEventListener('click', async () => {
      const text = wordDisplay.textContent?.trim();
      if (!text || text.startsWith('Generating')) return;
      try {
        await navigator.clipboard.writeText(text);
        triggerToast('Word passphrase copied!', 'success');
        if (copyWordText) copyWordText.textContent = 'Copied!';
        setTimeout(() => {
          if (copyWordText) copyWordText.textContent = 'Copy';
        }, 1500);
      } catch (e) {
        triggerToast('Failed to copy', 'error');
      }
    });
  }

  // Init
  typeBtns[0]?.classList.add('bg-purple-600/15', 'border-purple-500/50', 'text-purple-300');
  generate();
  updateWordPassphrase();
  renderHistory();

  // ─── Fullscreen ───
  document.getElementById('fullscreen-btn')?.addEventListener('click', () => {
    const card = document.getElementById('fullscreen-btn').closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
      document.getElementById('fullscreen-btn').textContent = '⛶';
    } else {
      card.requestFullscreen?.() || card.webkitRequestFullscreen?.();
      document.getElementById('fullscreen-btn').textContent = '✕';
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const btn = document.getElementById('fullscreen-btn');
    if (btn) btn.textContent = document.fullscreenElement ? '✕' : '⛶';
  });

  // ─── Keyboard shortcuts ───
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b = document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      const clearBtn = document.getElementById('clear-btn') || document.querySelector("button[id*='clear']") || document.querySelector("button[id*='reset']");
      if (clearBtn) clearBtn.click();
      else {
        const inputs = document.querySelectorAll('textarea, input:not([type="radio"]):not([type="checkbox"])');
        inputs.forEach(i => i.value = '');
        const evt = new Event('input', { bubbles: true });
        inputs.forEach(i => i.dispatchEvent(evt));
      }
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });

  // ─── Usage badge ───
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['password-generator']) b.textContent = 'Used ' + u['password-generator'] + '×';
  } catch (e) {}


  // ─── Sound effects ───
  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }

  // ─── Color theme picker ───
  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      document.querySelectorAll("button[class*='bg-purple'],button[class*='bg-violet']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(purple|violet)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(purple|violet)-\d+/g, 'hover:bg-' + c + '-500');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}
</script>
