---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import KeyboardHints from '../../components/KeyboardHints.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'How secure is the generated password?',
    answer:
      'Passwords use cryptographically random selection. With 16+ characters and all character types enabled, your password would take billions of years to crack with current technology.',
  },
  {
    question: "What's the difference between password types?",
    answer:
      'Random mixes letters, numbers, and symbols. Pronounceable creates readable syllable-based words. Passphrase uses random dictionary words. PIN is numeric-only for quick entry.',
  },
  {
    question: 'Is my password stored anywhere?',
    answer:
      'No. Everything runs locally in your browser. Password history is kept strictly in volatile memory during your active session and destroyed upon refresh or navigation. Nothing is stored in localStorage or transmitted anywhere.',
  },
  {
    question: 'What is entropy?',
    answer:
      'Entropy measures password strength in bits of randomness based on length and character set: E = L × log2(N). Each additional bit doubles the search space for brute-force attacks. 60+ bits provides moderate resistance, 80+ bits is considered strong for general accounts, and 128+ bits offers exceptional resistance against offline brute-force attacks with modern hardware.',
  },
  {
    question: 'What password length is recommended?',
    answer:
      '16+ characters for most accounts, 20+ for critical accounts (email, banking), 8+ digits for PINs, 4-6 words for passphrases.',
  },
  {
    question: 'What is a passphrase?',
    answer:
      "A passphrase is a sequence of random words (e.g., 'correct-horse-battery-staple'). They are easier to remember, harder to crack, and ideal for master passwords on password managers.",
  },
  {
    question: 'Can I exclude similar characters?',
    answer:
      "Yes. Toggle 'Exclude Similar' to remove characters like 1, l, I, 0, O that are easily confused in fonts. This improves readability without sacrificing much strength.",
  },
  {
    question: 'How often should I change my passwords?',
    answer:
      'Change passwords every 6-12 months, or immediately after a service you use reports a data breach. Use unique passwords for every account — never reuse.',
  },
];
const pwSchema = {
  name: 'Password Generator Pro',
  applicationCategory: 'Security',
  description: 'Generate strong passwords, PINs, and passphrases with real-time strength meter and entropy scoring.',
  featureList: [
    'Cryptographically random password generation',
    'Real-time strength meter with entropy score',
    'Random, pronounceable, passphrase, and PIN modes',
    'Custom length, symbols, numbers, and uppercase options',
    'In-memory session history — zero disk persistence or transmission',
  ],
};

const benefits = [
  {
    icon: '🔐',
    title: 'High-Entropy Security',
    desc: 'Uses cryptographically random selection. 128+ bit entropy passwords would take billions of years to crack with current hardware.',
  },
  {
    icon: '📊',
    title: 'Real-Time Strength Meter',
    desc: 'Visual strength indicator with entropy score. See exactly how secure each password is as you adjust parameters.',
  },
  {
    icon: '🔄',
    title: '4 Generation Modes',
    desc: 'Random, pronounceable, passphrase, and PIN. Each mode is optimized for different use cases and security requirements.',
  },
  {
    icon: '📋',
    title: 'Current Session History',
    desc: 'View recently generated passwords during your active session. History is kept strictly in volatile memory and cleared on page refresh.',
  },
  {
    icon: '⚡',
    title: 'Instant Generation',
    desc: 'Generate a new password with one click, keyboard shortcut, or tap. Instant client-side generation as you adjust settings.',
  },
  {
    icon: '🆓',
    title: 'Free & No Limits',
    desc: 'Generate unlimited passwords. No sign-ups, no premium tiers, no restrictions. All features are completely free.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Choose Mode',
    desc: 'Select Random, Pronounceable, Passphrase, or PIN from the mode tabs. Each mode has optimized defaults for its use case.',
  },
  {
    num: '2',
    title: 'Set Parameters',
    desc: 'Adjust length, toggle character types (uppercase, lowercase, numbers, symbols), and enable exclusions for similar characters.',
  },
  {
    num: '3',
    title: 'Check Strength',
    desc: 'View the real-time strength meter and entropy score. Aim for 80+ bits for strong passwords, 128+ for critical accounts.',
  },
  {
    num: '4',
    title: 'Copy & Use',
    desc: 'Click to copy a password, generate multiple at once, or reference your current session history. Use unique passwords for every account.',
  },
];

const useCases = [
  {
    icon: '📧',
    title: 'Email & Banking',
    desc: 'Generate 20+ character passwords with all character types for your most critical accounts. Enable 2FA for additional security.',
  },
  {
    icon: '🔑',
    title: 'Password Manager Master',
    desc: 'Create a memorable 6-word passphrase as your password manager master key. Long enough to be secure, easy enough to recall.',
  },
  {
    icon: '🏢',
    title: 'Business Accounts',
    desc: 'Generate unique passwords for every work account. Enforce password policy standards — length, complexity, and rotation requirements.',
  },
  {
    icon: '📱',
    title: 'Social Media',
    desc: 'Use unique 16+ character passwords for every social platform. Store in your password manager and enable 2FA everywhere.',
  },
];
---

<MainLayout
  title="Password & Passphrase Generator — Free | NumanX"
  description="Generate strong passwords and passphrases with CSPRNG security, custom rules and live strength feedback. Free and private."
  keywords="generate password with words, password generator with words, passphrase generator, strong password generator, random password generator, diceware passphrase"
  toolSchema={pwSchema}
  faq={faqItems}
  howto={{
    name: 'How to Generate Strong Passwords',
    description: 'Create secure, unique passwords with real-time strength analysis in 4 steps.',
    steps: howToSteps.map((s) => ({ title: s.title, text: s.desc })),
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Password Generator', url: '/tools/password-generator/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-5xl mx-auto">
      <ToolHeader
        title="Password"
        gradient="Generator Pro"
        desc="Generate strong passwords, PINs, and passphrases with real-time strength meter and entropy scoring. 1Password + Bitwarden inspired."
        badge="✦ Client-Side"
        slug="password-generator"
      />

      <ShareBar />

      <!-- ─── Tool Interface ─── -->
      <div class="max-w-xl mx-auto mt-8 space-y-4">
        <!-- Password Display — 1Password-style large card -->
        <div
          class="relative bg-surface-2 border border-surface-2 rounded-2xl p-5 flex items-center justify-between group min-h-[72px] focus-within:border-purple-500/40 transition-all"
        >
          <span
            id="password-display"
            class="text-base sm:text-lg font-mono text-muted break-all select-all pr-14 leading-relaxed tracking-wide"
            >Click generate to create a secure password</span
          >
          <button
            id="copy-btn"
            class="absolute right-4 bg-zinc-800 hover:bg-purple-600 border border-surface-3 text-tertiary hover:text-white p-2.5 rounded-xl transition-all"
            title="Copy to clipboard"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path
                d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg
            >
          </button>
        </div>

        <!-- Password Options -->
        <div class="space-y-3">
          <div class="flex flex-wrap gap-2" id="type-buttons">
            {
              ['Random', 'Pronounceable', 'Passphrase', 'PIN'].map((t) => (
                <button
                  class="type-btn rounded-xl py-2 px-4 text-xs font-medium border transition-all bg-surface-2 border-surface text-tertiary hover:text-white hover:border-surface-3 active:scale-95"
                  data-type={t}
                >
                  {t}
                </button>
              ))
            }
          </div>

          <div class="flex items-center justify-between gap-4">
            <div class="flex-1">
              <label class="text-[10px] font-semibold text-muted uppercase tracking-wider flex justify-between mb-2">
                <span>Length</span>
                <span id="length-display" class="text-secondary font-mono">16</span>
              </label>
              <input
                id="length-slider"
                type="range"
                min="4"
                max="64"
                value="16"
                class="w-full h-1.5 bg-zinc-800 rounded-full appearance-none cursor-pointer accent-purple-500 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-purple-500 [&::-webkit-slider-thumb]:shadow-lg [&::-webkit-slider-thumb]:shadow-purple-900/40" aria-label="Password length"
              />
            </div>
          </div>

          <!-- Options -->
          <div class="flex flex-wrap gap-3 text-xs" id="options">
            {
              ['uppercase', 'lowercase', 'numbers', 'symbols'].map((o) => (
                <label class="flex items-center gap-2 cursor-pointer text-tertiary hover:text-secondary transition-colors">
                  <input
                    type="checkbox"
                    checked
                    class="rounded border-zinc-700 bg-zinc-900 text-purple-500 focus:ring-purple-500/30 focus:ring-offset-0"
                  />
                  <span class="capitalize">{o}</span>
                </label>
              ))
            }
            <label class="flex items-center gap-2 cursor-pointer text-tertiary hover:text-secondary transition-colors">
              <input
                type="checkbox"
                id="exclude-ambiguous"
                class="rounded border-zinc-700 bg-zinc-900 text-purple-500 focus:ring-purple-500/30 focus:ring-offset-0"
              />
              <span>Exclude Similar</span>
            </label>
          </div>

          <button
            id="generate-btn"
            class="w-full bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-semibold py-3 rounded-xl transition-all shadow-lg shadow-purple-900/20 text-sm active:scale-[0.98]"
          >
            Generate Password
          </button>
        </div>

        <!-- Entropy + Strength -->
        <div class="bg-surface-1 border border-surface rounded-xl p-4 space-y-2 relative">
          <button
            id="fullscreen-btn"
            class="absolute top-3 right-3 p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs"
            title="Fullscreen">⛶</button
          >
          <div class="flex items-center gap-2">
            <span id="usage-badge" class="text-xs text-muted"></span>
            <div class="flex gap-1 ml-auto">
              <button
                class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                data-color="purple"
                style="background:#a855f7"></button>
              <button
                class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                data-color="blue"
                style="background:#3b82f6"></button>
              <button
                class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                data-color="green"
                style="background:#22c55e"></button>
              <button
                class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                data-color="pink"
                style="background:#ec4899"></button>
            </div>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-semibold text-muted uppercase tracking-wider">Strength</span>
            <span id="strength-label" class="text-xs font-bold text-tertiary">--</span>
          </div>
          <div class="h-1.5 bg-zinc-800 rounded-full overflow-hidden">
            <div id="strength-bar" class="h-full rounded-full transition-all duration-500" style="width:0%"></div>
          </div>
          <div class="flex justify-between text-[10px] text-dim">
            <span>Weak</span>
            <span>Strong</span>
            <span id="entropy-display" class="text-muted font-mono">0 bits</span>
          </div>
        </div>

        <!-- CSPRNG Word-Based Passphrase Generator Panel (Targets 'generate password with words' ranking query) -->
        <section class="rounded-2xl bg-surface-1 border border-surface p-5 space-y-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="text-xl">📖</span>
              <div>
                <h2 class="text-sm font-bold text-white m-0">Generate Password With Words (CSPRNG Passphrase)</h2>
                <p class="text-[11px] text-muted m-0">Cryptographically secure word-based Diceware passphrase generator</p>
              </div>
            </div>
            <span class="text-[10px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/30">
              CSPRNG Verified
            </span>
          </div>

          <!-- Passphrase Result Display & Copy -->
          <div class="relative bg-zinc-950 border border-surface rounded-xl p-3.5 flex items-center justify-between group min-h-[50px]">
            <span id="word-passphrase-display" class="font-mono text-sm sm:text-base text-purple-300 font-semibold break-all select-all pr-16 leading-relaxed">
              Generating secure passphrase...
            </span>
            <button
              id="copy-word-passphrase-btn"
              class="absolute right-3 px-3 py-1.5 rounded-lg bg-surface-2 hover:bg-purple-600 border border-surface text-tertiary hover:text-white transition-all text-xs font-medium flex items-center gap-1.5 active:scale-95"
              title="Copy Word Passphrase"
            >
              <span>📋</span>
              <span id="copy-word-passphrase-text">Copy</span>
            </button>
          </div>

          <!-- Passphrase Controls -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
            <div>
              <label class="text-[10px] font-semibold text-muted uppercase tracking-wider block mb-1">
                Word Count: <span id="word-count-num" class="text-purple-400 font-bold">4 words</span>
              </label>
              <input
                id="word-count-slider"
                type="range"
                min="3"
                max="8"
                value="4"
                class="w-full h-1.5 bg-zinc-800 rounded-full appearance-none cursor-pointer accent-purple-500" aria-label="Passphrase word count"
              />
            </div>
            <div>
              <label for="word-separator-select" class="text-[10px] font-semibold text-muted uppercase tracking-wider block mb-1">
                Word Separator
              </label>
              <select
                id="word-separator-select"
                class="w-full bg-zinc-950 border border-surface text-xs text-white rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-purple-500 cursor-pointer"
              >
                <option value="-" selected>Hyphen (-)</option>
                <option value=".">Period (.)</option>
                <option value="_">Underscore (_)</option>
                <option value=" ">Space ( )</option>
                <option value="">None (Concatenated)</option>
              </select>
            </div>
            <div>
              <label for="word-transform-select" class="text-[10px] font-semibold text-muted uppercase tracking-wider block mb-1">
                Capitalization
              </label>
              <select
                id="word-transform-select"
                class="w-full bg-zinc-950 border border-surface text-xs text-white rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-purple-500 cursor-pointer"
              >
                <option value="capitalize" selected>Capitalize (TitleCase)</option>
                <option value="lowercase">lowercase</option>
                <option value="uppercase">UPPERCASE</option>
              </select>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
            <label class="flex items-center gap-2 text-xs text-tertiary cursor-pointer hover:text-white select-none">
              <input type="checkbox" id="word-include-number" checked class="rounded border-zinc-700 bg-zinc-900 text-purple-500 focus:ring-purple-500/30" />
              <span>Include random number & symbol (e.g. #7)</span>
            </label>
            <button
              id="generate-word-passphrase-btn"
              class="px-4 py-2 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 text-purple-300 border border-purple-500/30 text-xs font-semibold transition-all active:scale-95 flex items-center justify-center gap-1.5"
            >
              <span>🎲</span>
              <span>Generate New Words</span>
            </button>
          </div>
        </section>

        <!-- History -->
        <div id="history-section" class="hidden">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-semibold text-muted uppercase tracking-wider">Current Session History</span>
            <div class="flex items-center gap-2">
              <button id="download-btn" class="text-[10px] text-dim hover:text-tertiary transition-colors"
                >Download</button
              >
              <button id="clear-history" class="text-[10px] text-dim hover:text-tertiary transition-colors"
                >Clear</button
              >
            </div>
          </div>
          <div id="history-list" class="space-y-1 max-h-32 overflow-y-auto"></div>
        </div>
      </div>

      <!-- --- FAQ --- -->
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>

      <KeyboardHints
        hints={[
          { keys: '⌘C', label: 'Copy password' },
          { keys: '⌘K', label: 'Open search' },
          { keys: 'Space', label: 'Generate new' },
        ]}
      />

      <RelatedTools current="password-generator" />

      <ToolContentSections
        toolSlug="password-generator"
        toolName="Password Generator"
        category="Security"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />

      <section class="mt-16 text-center">
        <div
          class="max-w-2xl mx-auto bg-gradient-to-br from-purple-600/10 to-blue-600/5 border border-purple-500/20 rounded-2xl p-8 md:p-10"
        >
          <h2 class="text-2xl md:text-3xl font-black tracking-tight">
            Generate Strong
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">
              Passwords Free</span
            >
          </h2>
          <p class="text-tertiary mt-3 max-w-lg mx-auto text-sm leading-relaxed">
            Protect your accounts with cryptographically secure passwords. No sign-ups, no limits, no tracking.
          </p>
          <div class="mt-6 flex gap-3 justify-center flex-wrap">
            <button
              onclick="document.querySelector('[data-mode=random]')?.click()"
              class="px-6 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm transition-all active:scale-[0.97] shadow-lg shadow-purple-900/30"
            >
              Generate Now
            </button>
            <a
              href="/tools/qr-generator/"
              class="px-6 py-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-semibold text-sm transition-all border border-zinc-700"
            >
              Create QR Code
            </a>
            <a
              href="/guides/password-security-guide/"
              class="px-6 py-3 rounded-xl bg-purple-600/10 hover:bg-purple-600/20 text-purple-300 font-semibold text-sm transition-all border border-purple-500/30"
            >
              Complete Guide to Password Security
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</MainLayout>

<script>
  import {
    purgeLegacyPasswordHistory,
    createSessionPasswordHistory,
  } from '../../lib/passwordSessionHistory';

  // Purge legacy plaintext password storage from previous versions
  purgeLegacyPasswordHistory();

  const sessionHistoryManager = createSessionPasswordHistory(20);

  const display = document.getElementById('password-display');
  const generateBtn = document.getElementById('generate-btn');
  const copyBtn = document.getElementById('copy-btn');
  const lengthSlider = document.getElementById('length-slider');
  const lengthDisplay = document.getElementById('length-display');
  const strengthBar = document.getElementById('strength-bar');
  const strengthLabel = document.getElementById('strength-label');
  const entropyDisplay = document.getElementById('entropy-display');
  const historyList = document.getElementById('history-list');
  const historySection = document.getElementById('history-section');
  const clearHistory = document.getElementById('clear-history');
  const typeBtns = document.querySelectorAll('.type-btn');
  const typeOpts = document.querySelectorAll('#options input');

  const excludeSimilar = document.getElementById('exclude-ambiguous');

  let currentType = 'Random';

  typeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      typeBtns.forEach((b) => {
        b.classList.remove('bg-purple-600/15', 'border-purple-500/50', 'text-purple-300');
        b.classList.add('bg-surface-2', 'border-surface', 'text-tertiary');
      });
      btn.classList.remove('bg-surface-2', 'border-surface', 'text-tertiary');
      btn.classList.add('bg-purple-600/15', 'border-purple-500/50', 'text-purple-300');
      currentType = btn.dataset.type;
      generate();
    });
  });

  lengthSlider.addEventListener('input', () => {
    lengthDisplay.textContent = lengthSlider.value;
    generate();
  });

  typeOpts.forEach((cb) => cb.addEventListener('change', generate));
  if (excludeSimilar) excludeSimilar.addEventListener('change', generate);

  function getCharset() {
    const opts = Array.from(typeOpts).filter((c) => c.checked);
    let set = '';
    if (
      opts.some((c) => c.value === 'uppercase' || c.nextElementSibling.textContent.trim().toLowerCase() === 'uppercase')
    )
      set += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    if (
      opts.some((c) => c.value === 'lowercase' || c.nextElementSibling.textContent.trim().toLowerCase() === 'lowercase')
    )
      set += 'abcdefghijklmnopqrstuvwxyz';
    if (opts.some((c) => c.value === 'numbers' || c.nextElementSibling.textContent.trim().toLowerCase() === 'numbers'))
      set += '0123456789';
    if (opts.some((c) => c.value === 'symbols' || c.nextElementSibling.textContent.trim().toLowerCase() === 'symbols'))
      set += '!@#$%^&*()_+-=[]{}|;:,.<>?';

    if (excludeSimilar && excludeSimilar.checked) {
      set = set.replace(/[Il1O0]/g, '');
    }

    return set || 'abcdefghijklmnopqrstuvwxyz';
  }

  function randomPassword(len) {
    const set = getCharset();
    const arr = new Uint32Array(len);
    crypto.getRandomValues(arr);
    return Array.from(arr, (v) => set[v % set.length]).join('');
  }

  function pronounceablePassword(len) {
    const vowels = 'aeiou';
    const consonants = 'bcdfghjklmnpqrstvwxyz';
    let pwd = '';
    for (let i = 0; i < len; i++) {
      pwd += (i % 2 === 0 ? consonants : vowels)[
        Math.floor(Math.random() * (i % 2 === 0 ? consonants.length : vowels.length))
      ];
    }
    return pwd;
  }

  // ─── EFF Diceware Wordlist & CSPRNG Passphrase Logic ───
  const EFF_WORDS = [
    'ability', 'absorb', 'abstract', 'academy', 'accent', 'account', 'achieve', 'acoustic', 'acquire', 'action',
    'actress', 'adapter', 'address', 'advance', 'afford', 'airport', 'alarm', 'album', 'alcohol', 'algebra',
    'alpha', 'alpine', 'alter', 'amber', 'amuse', 'anchor', 'ancient', 'angel', 'anthem', 'antique',
    'apron', 'arcade', 'arch', 'arctic', 'arena', 'armor', 'arrow', 'artist', 'aspect', 'asset',
    'atlas', 'atom', 'audio', 'august', 'aurora', 'avatar', 'avenue', 'avocado', 'bacon', 'badge',
    'balance', 'bamboo', 'banana', 'banner', 'baron', 'barrel', 'basket', 'battery', 'beacon', 'breeze',
    'bronze', 'bubble', 'cactus', 'canyon', 'canvas', 'carpet', 'castle', 'cedar', 'celestial', 'channel',
    'chime', 'cider', 'cinema', 'circuit', 'citrus', 'clever', 'cliff', 'clover', 'cobalt', 'comet',
