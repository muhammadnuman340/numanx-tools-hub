---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";
import KeyboardHints from "../../components/KeyboardHints.astro";
import ToolContentSections from "../../components/ToolContentSections.astro";

const faqItems = [
    { question: "How secure is the generated password?", answer: "Passwords use cryptographically random selection. With 16+ characters and all character types enabled, your password would take billions of years to crack with current technology." },
    { question: "What's the difference between password types?", answer: "Random mixes letters, numbers, and symbols. Pronounceable creates readable syllable-based words. Passphrase uses random dictionary words. PIN is numeric-only for quick entry." },
    { question: "Is my password stored anywhere?", answer: "No. Everything runs locally in your browser. Password history is stored in your browser's localStorage and never transmitted anywhere." },
    { question: "What is entropy?", answer: "Entropy measures password strength in bits. Each bit doubles the number of attempts needed to crack it. 80+ bits is considered strong, 128+ is military-grade." },
    { question: "What password length is recommended?", answer: "16+ characters for most accounts, 20+ for critical accounts (email, banking), 8+ digits for PINs, 4-6 words for passphrases." },
    { question: "What is a passphrase?", answer: "A passphrase is a sequence of random words (e.g., 'correct-horse-battery-staple'). They are easier to remember, harder to crack, and ideal for master passwords on password managers." },
    { question: "Can I exclude similar characters?", answer: "Yes. Toggle 'Exclude Similar' to remove characters like 1, l, I, 0, O that are easily confused in fonts. This improves readability without sacrificing much strength." },
    { question: "How often should I change my passwords?", answer: "Change passwords every 6-12 months, or immediately after a service you use reports a data breach. Use unique passwords for every account — never reuse." },
  ];
const pwSchema = {
  "name": "Password Generator Pro",
  "applicationCategory": "Security",
  "description": "Generate strong passwords, PINs, and passphrases with real-time strength meter and entropy scoring.",
  "featureList": [
    "Cryptographically random password generation",
    "Real-time strength meter with entropy score",
    "Random, pronounceable, passphrase, and PIN modes",
    "Custom length, symbols, numbers, and uppercase options",
    "Password history stored locally — nothing transmitted"
  ],
}

const benefits = [
  { icon: "🔐", title: "Military-Grade Security", desc: "Uses cryptographically random selection. 128+ bit entropy passwords would take billions of years to crack with current hardware." },
  { icon: "📊", title: "Real-Time Strength Meter", desc: "Visual strength indicator with entropy score. See exactly how secure each password is as you adjust parameters." },
  { icon: "🔄", title: "4 Generation Modes", desc: "Random, pronounceable, passphrase, and PIN. Each mode is optimized for different use cases and security requirements." },
  { icon: "📋", title: "Password History", desc: "Previously generated passwords are saved locally. No cloud sync, no data transmission — stored only in your browser." },
  { icon: "⚡", title: "Instant Generation", desc: "Generate a new password with one click, keyboard shortcut, or tap. Zero latency — results appear instantly." },
  { icon: "🆓", title: "Free & No Limits", desc: "Generate unlimited passwords. No sign-ups, no premium tiers, no restrictions. All features are completely free." },
];

const howToSteps = [
  { num: "1", title: "Choose Mode", desc: "Select Random, Pronounceable, Passphrase, or PIN from the mode tabs. Each mode has optimized defaults for its use case." },
  { num: "2", title: "Set Parameters", desc: "Adjust length, toggle character types (uppercase, lowercase, numbers, symbols), and enable exclusions for similar characters." },
  { num: "3", title: "Check Strength", desc: "View the real-time strength meter and entropy score. Aim for 80+ bits for strong passwords, 128+ for critical accounts." },
  { num: "4", title: "Copy & Use", desc: "Click to copy a password, generate multiple at once, or save to your local history. Use unique passwords for every account." },
];

const useCases = [
  { icon: "📧", title: "Email & Banking", desc: "Generate 20+ character passwords with all character types for your most critical accounts. Enable 2FA for additional security." },
  { icon: "🔑", title: "Password Manager Master", desc: "Create a memorable 6-word passphrase as your password manager master key. Long enough to be secure, easy enough to recall." },
  { icon: "🏢", title: "Business Accounts", desc: "Generate unique passwords for every work account. Enforce password policy standards — length, complexity, and rotation requirements." },
  { icon: "📱", title: "Social Media", desc: "Use unique 16+ character passwords for every social platform. Store in your password manager and enable 2FA everywhere." },
];
---

<MainLayout
  title="Password Generator - Strong Password & PIN Generator Online"
  description="Generate strong secure passwords, PINs, passphrases, and pronounceable passwords. Includes strength meter, entropy score, and history."
  keywords="password generator, strong password, pin generator, passphrase generator, secure password, entropy score"
  toolSchema={pwSchema}
  faq={faqItems}
  howto={{
    name: "How to Generate Strong Passwords",
    description: "Create secure, unique passwords with real-time strength analysis in 4 steps.",
    steps: howToSteps.map(s => ({ title: s.title, text: s.desc })),
    totalTime: "PT1M",
  }}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Tools", url: "/tools/" },
    { name: "Password Generator", url: "/tools/password-generator/" },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-5xl mx-auto">
      <ToolHeader
        title="Password"
        gradient="Generator Pro"
        desc="Generate strong passwords, PINs, and passphrases with real-time strength meter and entropy scoring. 1Password + Bitwarden inspired."
        badge="✦ Pro Version"
        slug="password-generator"
      />

      <ShareBar />

      <!-- ─── Tool Interface ─── -->
      <div class="max-w-xl mx-auto mt-8 space-y-4">

        <!-- Password Display — 1Password-style large card -->
        <div class="relative bg-surface-2 border border-surface-2 rounded-2xl p-5 flex items-center justify-between group min-h-[72px] focus-within:border-purple-500/40 transition-all">
          <span id="password-display" class="text-base sm:text-lg font-mono text-muted break-all select-all pr-14 leading-relaxed tracking-wide">Click generate to create a secure password</span>
          <button id="copy-btn" class="absolute right-4 bg-zinc-800 hover:bg-purple-600 border border-surface-3 text-tertiary hover:text-white p-2.5 rounded-xl transition-all" title="Copy to clipboard">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>

        <!-- Password Options -->
        <div class="space-y-3">
          <div class="flex flex-wrap gap-2" id="type-buttons">
            {["Random","Pronounceable","Passphrase","PIN"].map(t => (
              <button class="type-btn rounded-xl py-2 px-4 text-xs font-medium border transition-all bg-surface-2 border-surface text-tertiary hover:text-white hover:border-surface-3 active:scale-95" data-type={t}>{t}</button>
            ))}
          </div>

          <div class="flex items-center justify-between gap-4">
            <div class="flex-1">
              <label class="text-[10px] font-semibold text-muted uppercase tracking-wider flex justify-between mb-2">
                <span>Length</span>
                <span id="length-display" class="text-secondary font-mono">16</span>
              </label>
              <input id="length-slider" type="range" min="4" max="64" value="16" class="w-full h-1.5 bg-zinc-800 rounded-full appearance-none cursor-pointer accent-purple-500 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-purple-500 [&::-webkit-slider-thumb]:shadow-lg [&::-webkit-slider-thumb]:shadow-purple-900/40" />
            </div>
          </div>

          <!-- Options -->
          <div class="flex flex-wrap gap-3 text-xs" id="options">
            {["uppercase","lowercase","numbers","symbols"].map(o => (
              <label class="flex items-center gap-2 cursor-pointer text-tertiary hover:text-secondary transition-colors">
                <input type="checkbox" checked class="rounded border-zinc-700 bg-zinc-900 text-purple-500 focus:ring-purple-500/30 focus:ring-offset-0" />
                <span class="capitalize">{o}</span>
              </label>
            ))}
          </div>

          <button id="generate-btn" class="w-full bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-semibold py-3 rounded-xl transition-all shadow-lg shadow-purple-900/20 text-sm active:scale-[0.98]">
            Generate Password
          </button>
        </div>

        <!-- Entropy + Strength -->
        <div class="bg-surface-1 border border-surface rounded-xl p-4 space-y-2 relative">
          <button id="fullscreen-btn" class="absolute top-3 right-3 p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs" title="Fullscreen">⛶</button>
          <div class="flex items-center gap-2">
            <span id="usage-badge" class="text-xs text-muted"></span>
            <div class="flex gap-1 ml-auto">
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="purple" style="background:#a855f7"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="blue" style="background:#3b82f6"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="green" style="background:#22c55e"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="pink" style="background:#ec4899"></button>
            </div>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-semibold text-muted uppercase tracking-wider">Strength</span>
            <span id="strength-label" class="text-xs font-bold text-tertiary">--</span>
          </div>
          <div class="h-1.5 bg-zinc-800 rounded-full overflow-hidden">
            <div id="strength-bar" class="h-full rounded-full transition-all duration-500" style="width:0%"></div>
          </div>
          <div class="flex justify-between text-[10px] text-dim">
            <span>Weak</span>
            <span>Strong</span>
            <span id="entropy-display" class="text-muted font-mono">0 bits</span>
          </div>
        </div>

        <!-- History -->
        <div id="history-section" class="hidden">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-semibold text-muted uppercase tracking-wider">Recent Passwords</span>
            <div class="flex items-center gap-2">
              <button id="share-btn" class="text-[10px] text-dim hover:text-tertiary transition-colors">Share</button>
              <button id="download-btn" class="text-[10px] text-dim hover:text-tertiary transition-colors">Download</button>
              <button id="clear-history" class="text-[10px] text-dim hover:text-tertiary transition-colors">Clear</button>
            </div>
          </div>
          <div id="history-list" class="space-y-1 max-h-32 overflow-y-auto"></div>
        </div>
      </div>

      <!-- --- FAQ --- -->
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} />
      </div>

      <KeyboardHints hints={[
        { keys: "?C", label: "Copy password" },
        { keys: "?K", label: "Open search" },
        { keys: "Space", label: "Generate new" },
      ]} />

      <RelatedTools current="password-generator" />

      <ToolContentSections
        toolSlug="password-generator"
        toolName="Password Generator"
        category="Security"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />

      <section class="mt-16 text-center">
        <div class="max-w-2xl mx-auto bg-gradient-to-br from-purple-600/10 to-blue-600/5 border border-purple-500/20 rounded-2xl p-8 md:p-10">
          <h2 class="text-2xl md:text-3xl font-black tracking-tight">
            Generate Strong
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent"> Passwords Free</span>
          </h2>
          <p class="text-tertiary mt-3 max-w-lg mx-auto text-sm leading-relaxed">
            Protect your accounts with cryptographically secure passwords. No sign-ups, no limits, no tracking.
          </p>
          <div class="mt-6 flex gap-3 justify-center flex-wrap">
            <button onclick="document.querySelector('.mode-btn[data-mode=\"random\"]')?.click()" class="px-6 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm transition-all active:scale-[0.97] shadow-lg shadow-purple-900/30">
              Generate Now
            </button>
            <a href="/tools/qr-generator/" class="px-6 py-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-semibold text-sm transition-all border border-zinc-700">
              Create QR Code
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</MainLayout>

<script>
  const display = document.getElementById("password-display");
  const generateBtn = document.getElementById("generate-btn");
  const copyBtn = document.getElementById("copy-btn");
  const lengthSlider = document.getElementById("length-slider");
  const lengthDisplay = document.getElementById("length-display");
  const strengthBar = document.getElementById("strength-bar");
  const strengthLabel = document.getElementById("strength-label");
  const entropyDisplay = document.getElementById("entropy-display");
  const historyList = document.getElementById("history-list");
  const historySection = document.getElementById("history-section");
  const clearHistory = document.getElementById("clear-history");
  const typeBtns = document.querySelectorAll(".type-btn");
  const typeOpts = document.querySelectorAll("#options input");

  let currentType = "Random";
  const HISTORY_KEY = "pwd_history";

  typeBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      typeBtns.forEach((b) => {
        b.classList.remove("bg-purple-600/15", "border-purple-500/50", "text-purple-300");
        b.classList.add("bg-surface-2", "border-surface", "text-tertiary");
      });
      btn.classList.remove("bg-surface-2", "border-surface", "text-tertiary");
      btn.classList.add("bg-purple-600/15", "border-purple-500/50", "text-purple-300");
      currentType = btn.dataset.type;
      generate();
    });
  });

  lengthSlider.addEventListener("input", () => {
    lengthDisplay.textContent = lengthSlider.value;
    generate();
  });

  typeOpts.forEach((cb) => cb.addEventListener("change", generate));

  function getCharset() {
    const opts = Array.from(typeOpts).filter((c) => c.checked);
    let set = "";
    if (opts.some((c) => c.value === "uppercase" || c.nextElementSibling.textContent.trim() === "uppercase")) set += "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    if (opts.some((c) => c.value === "lowercase" || c.nextElementSibling.textContent.trim() === "lowercase")) set += "abcdefghijklmnopqrstuvwxyz";
    if (opts.some((c) => c.value === "numbers" || c.nextElementSibling.textContent.trim() === "numbers")) set += "0123456789";
    if (opts.some((c) => c.value === "symbols" || c.nextElementSibling.textContent.trim() === "symbols")) set += "!@#$%^&*()_+-=[]{}|;:,.<>?";
    return set || "abcdefghijklmnopqrstuvwxyz";
  }

  function randomPassword(len) {
    const set = getCharset();
    const arr = new Uint32Array(len);
    crypto.getRandomValues(arr);
    return Array.from(arr, (v) => set[v % set.length]).join("");
  }

  function pronounceablePassword(len) {
    const vowels = "aeiou";
    const consonants = "bcdfghjklmnpqrstvwxyz";
    let pwd = "";
    for (let i = 0; i < len; i++) {
      pwd += (i % 2 === 0 ? consonants : vowels)[Math.floor(Math.random() * (i % 2 === 0 ? consonants.length : vowels.length))];
    }
    return pwd;
  }

  function passphrasePassword() {
    const words = ["sunset","ocean","forest","mountain","river","thunder","crystal","silver","golden","flame","shadow","blaze","storm","frost","ember","cosmic","velvet","drift","fusion","echo","orbit","zenith","aurora","cascade","harbor","lunar","solar","tidal","vortex","wilder"];
    const count = Math.max(3, Math.min(8, Math.floor(parseInt(lengthSlider.value) / 5)));
    const selected = [];
    for (let i = 0; i < count; i++) {
      let w;
      do { w = words[Math.floor(Math.random() * words.length)]; } while (selected.includes(w));
      selected.push(w);
    }
    return selected.map((w, i) => i === 0 ? w.charAt(0).toUpperCase() + w.slice(1) : w).join("-");
  }

  function pinPassword(len) {
    const arr = new Uint32Array(len);
    crypto.getRandomValues(arr);
    return Array.from(arr, (v) => "0123456789"[v % 10]).join("");
  }

  function entropy(len, charsetSize) {
    if (!charsetSize) return 0;
    return Math.round(len * Math.log2(charsetSize));
  }

  function updateStrength(e) {
    const colors = ["bg-red-500","bg-orange-500","bg-amber-500","bg-lime-500","bg-emerald-500"];
    const labels = ["Weak","Fair","Good","Strong","Very Strong"];
    const idx = Math.min(4, Math.floor(e / 20));
    strengthBar.style.width = Math.min(100, e) + "%";
    strengthBar.className = `h-full rounded-full transition-all duration-500 ${colors[idx]}`;
    strengthLabel.textContent = labels[idx];
    strengthLabel.className = `text-xs font-bold ${["text-red-400","text-orange-400","text-amber-400","text-lime-400","text-emerald-400"][idx]}`;
  }

  function generate() {
    const len = parseInt(lengthSlider.value);
    let pwd = "";
    switch (currentType) {
      case "Random": pwd = randomPassword(len); break;
      case "Pronounceable": pwd = pronounceablePassword(len); break;
      case "Passphrase": pwd = passphrasePassword(); break;
      case "PIN": pwd = pinPassword(len); break;
    }
    display.textContent = pwd;
    const cs = getCharset().length;
    const e = entropy(pwd.length, cs || 26);
    entropyDisplay.textContent = e + " bits";
    updateStrength(e);

    // Save to history
    let hist = JSON.parse(localStorage.getItem(HISTORY_KEY) || "[]");
    hist = [pwd, ...hist.filter((h) => h !== pwd)].slice(0, 20);
    localStorage.setItem(HISTORY_KEY, JSON.stringify(hist));
    renderHistory();
  }

  function renderHistory() {
    const hist = JSON.parse(localStorage.getItem(HISTORY_KEY) || "[]");
    if (hist.length === 0) { historySection.classList.add("hidden"); return; }
    historySection.classList.remove("hidden");
    historyList.innerHTML = hist.map((p) => `<div class="flex items-center justify-between py-1.5 px-3 rounded-lg hover:bg-surface-1 transition-colors"><code class="text-xs font-mono text-tertiary">${p}</code><button class="copy-hist text-[10px] text-dim hover:text-tertiary" data-pwd="${p}">Copy</button></div>`).join("");
    historyList.querySelectorAll(".copy-hist").forEach((btn) => {
      btn.addEventListener("click", () => {
        navigator.clipboard.writeText(btn.dataset.pwd);
        btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = "Copy"), 1500);
      });
    });
  }

  function triggerToast(message: string, variant: "success" | "error" | "info" | "warning" = "success") {
    if ((window as any).__showToast) {
      (window as any).__showToast({ message, variant });
    }
  }

  copyBtn.addEventListener("click", () => {
    navigator.clipboard.writeText(display.textContent);
    triggerToast("Password copied to clipboard!", "success");
  });

  clearHistory.addEventListener("click", () => {
    localStorage.removeItem(HISTORY_KEY);
    renderHistory();
    triggerToast("Password history cleared", "info");
  });

  // ─── Download ───
  document.getElementById("download-btn")?.addEventListener("click", () => {
    const pwd = display.textContent;
    if (!pwd || pwd === "Click generate to create a secure password") return;
    const text = `Password: ${pwd}\nType: ${currentType}\nLength: ${lengthSlider.value}\nEntropy: ${entropyDisplay.textContent}\nGenerated: ${new Date().toLocaleString()}`;
    const blob = new Blob([text], {type:"text/plain"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "password.txt";
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // Init
  typeBtns[0]?.classList.add("bg-purple-600/15", "border-purple-500/50", "text-purple-300");
  generate();
  renderHistory();

  // ─── Fullscreen ───
  document.getElementById("fullscreen-btn")?.addEventListener("click", () => {
    const card = document.getElementById("fullscreen-btn").closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) { document.exitFullscreen(); document.getElementById("fullscreen-btn").textContent = "⛶"; }
    else { card.requestFullscreen?.() || card.webkitRequestFullscreen?.(); document.getElementById("fullscreen-btn").textContent = "✕"; }
  });
  document.addEventListener("fullscreenchange", () => {
    const btn = document.getElementById("fullscreen-btn");
    if (btn) btn.textContent = document.fullscreenElement ? "✕" : "⛶";
  });

  // ─── Keyboard shortcuts ───
  document.addEventListener("keydown",e=>{if(e.ctrlKey&&e.key==="Enter"){e.preventDefault();const b=document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");if(b)b.click();}if(e.ctrlKey&&e.shiftKey&&(e.key==="C"||e.key==="c")){e.preventDefault();document.getElementById("clear-btn")?.click();}if(e.ctrlKey&&(e.key==="D"||e.key==="d")){e.preventDefault();document.getElementById("download-btn")?.click();}});

  // ─── Usage badge ───
  try{const u=JSON.parse(localStorage.getItem("nt_tool_usage")||"{}");const b=document.getElementById("usage-badge");if(b&&u["password-generator"])b.textContent="Used "+u["password-generator"]+"×";}catch(e){}

  // ─── Share button ───
  document.getElementById("share-btn")?.addEventListener("click",()=>{const o=document.getElementById("output-text")||document.querySelector("[id$='result']");const t=o?.value||o?.textContent||"";if(!t)return;const u=window.location.origin+window.location.pathname+"#result="+encodeURIComponent(t.substring(0,200));navigator.clipboard.writeText(u).catch(()=>{});if(typeof showToast==="function")showToast("Link copied!");});

  // ─── Sound effects ───
  function playPing(){try{const a=new(window.AudioContext||window.webkitAudioContext)();const o=a.createOscillator();const g=a.createGain();o.connect(g);g.connect(a.destination);o.frequency.value=800;g.gain.setValueAtTime(0.08,a.currentTime);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+0.12);o.start();o.stop(a.currentTime+0.12);}catch(e){}}

  // ─── Color theme picker ───
  document.querySelectorAll(".theme-swatch").forEach(s=>{s.addEventListener("click",()=>{const c=s.dataset.color;document.querySelectorAll("button[class*='bg-purple'],button[class*='bg-violet']").forEach(b=>{b.className=b.className.replace(/bg-(purple|violet)-\d+/g,"bg-"+c+"-600").replace(/hover:bg-(purple|violet)-\d+/g,"hover:bg-"+c+"-500");});try{localStorage.setItem("nt_theme",c);}catch(e){}});});
  try{const c=localStorage.getItem("nt_theme");if(c)document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();}catch(e){}
</script>
