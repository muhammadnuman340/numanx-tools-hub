---
import { appsMatrix, type AppMetadata } from '../../data/appsData';
import ProToolDocs from '../../components/ProToolDocs.astro';
import MonetizationSlot from '../../components/MonetizationSlot.astro';

// Generate static paths for all tools in our matrix
export async function getStaticPaths() {
  return appsMatrix.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

interface Props {
  app: AppMetadata;
}

const { app } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{app.metaTitle}</title>
  <meta name="description" content={app.metaDescription} />
  
  <!-- SEO JSON-LD / Schema.org snippet -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": app.applicationCategory,
    "name": app.h1Headline,
    "description": app.metaDescription,
    "applicationCategory": app.applicationCategory,
    "operatingSystem": "All"
  })} />
</head>
<body class="bg-gray-50 text-gray-900 font-sans antialiased">
  
  <!-- Main Application Wrapper -->
  <main class="min-h-screen flex flex-col items-center py-12 px-4 sm:px-6 lg:px-8">
    
    <!-- Header Section -->
    <header class="w-full max-w-4xl text-center mb-12">
      <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
        {app.h1Headline}
      </h1>
      <p class="mt-4 text-xl text-gray-500">
        {app.tagline}
      </p>
    </header>

    <!-- 
      TOOL MOUNTING POINT 
      Explicit container sizing (w-full min-h-[500px]) to reserve space and prevent Layout Shifts (CLS).
      This ensures a perfect Core Web Vitals score while the client-side component hydrates.
    -->
    <section class="w-full max-w-4xl bg-white shadow-xl rounded-2xl overflow-hidden min-h-[500px] border border-gray-100 flex flex-col relative">
      
      <!-- 
        DEVELOPER NOTE:
        This is where the framework-specific tool component (React, Svelte, Vue, Solid) will be mounted.
        Use Astro's hydration directives:
        - Use `client:load` ONLY if immediately visible and interactive immediately on load.
        - Use `client:idle` for medium priority (waits for main thread to be free).
        - Use `client:visible` for components below the fold (hydrates when entering viewport).
        
        Example React Component Mount:
        {app.slug === 'pdf-merger' && <PdfMergerApp client:idle />}
        {app.slug === 'qr-generator' && <QrGeneratorApp client:visible />}
      -->
      
      <!-- Fallback / Loading Skeleton for the reserved space -->
      <div class="absolute inset-0 flex flex-col items-center justify-center text-gray-400 p-8 text-center" aria-hidden="true">
        <svg class="animate-spin h-10 w-10 mb-4 text-indigo-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <p class="font-medium text-lg text-gray-600 mb-2">Loading tool interface...</p>
        <p class="text-sm">Please wait while we initialize the {app.h1Headline} component.</p>
        
        <!-- Feature hints while loading -->
        <div class="mt-8 grid grid-cols-1 gap-2 text-left w-full max-w-sm">
          {app.features.map((feature: string) => (
            <div class="flex items-center space-x-2 text-sm">
              <svg class="h-4 w-4 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>{feature}</span>
            </div>
          ))}
        </div>
      </div>
      
    </section>

    <!-- Contextual Monetization Slot Below Tool Interface -->
    <div class="w-full max-w-4xl my-8 space-y-4">
      <MonetizationSlot
        slotType="post-tool-affiliate"
        category={app.applicationCategory ? (app.applicationCategory.toLowerCase().includes('cricket') ? 'cricket' : app.applicationCategory.toLowerCase().includes('image') ? 'image' : app.applicationCategory.toLowerCase().includes('creator') ? 'creator' : app.applicationCategory.toLowerCase().includes('dev') ? 'developer' : app.applicationCategory.toLowerCase().includes('ai') ? 'ai' : 'utility') : 'utility'}
      />
      <MonetizationSlot slotType="pakistan-support-bar" />
    </div>

    <!-- Verifiable ProToolDocs Below Canvas -->
    <div class="w-full max-w-4xl">
      <ProToolDocs
        slug={app.slug}
        toolName={app.h1Headline || app.metaTitle}
        category={app.applicationCategory || 'Utilities'}
      />
    </div>
  </main>
</body>
</html>
