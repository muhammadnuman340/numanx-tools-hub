---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const benefits = [
  {
    title: 'Four Paraphrasing Modes',
    desc: 'Choose from Standard, Fluent, Formal, and Creative modes — each with unique transformation rules for different needs',
  },
  {
    title: 'Synonym Intelligence',
    desc: 'Built-in dictionary of hundreds of synonyms with context-aware replacement for natural-sounding results',
  },
  {
    title: 'Sentence Restructuring',
    desc: 'Fluent and Creative modes actively restructure sentences for improved flow and originality beyond simple word swaps',
  },
  {
    title: 'Formal Tone Control',
    desc: 'Formal mode expands contractions and elevates vocabulary for professional and academic writing',
  },
  {
    title: 'Instant Results',
    desc: 'See your paraphrased text immediately with zero loading time — no server round-trips required',
  },
  {
    title: 'Completely Private',
    desc: 'All processing happens in your browser. Your text never leaves your device and is never stored',
  },
];

const howToSteps = [
  { title: 'Paste your text', desc: 'Copy and paste the text you want to rewrite into the input box' },
  {
    title: 'Choose paraphrasing mode',
    desc: 'Select Standard, Fluent, Formal, or Creative mode depending on the tone you want to achieve',
  },
  {
    title: 'Click paraphrase',
    desc: 'Hit the Paraphrase button and watch as the AI rewrites your text with intelligent synonym replacement',
  },
  {
    title: 'Review and copy',
    desc: 'Check the output, try different modes for variety, and copy the result to your clipboard',
  },
];

const useCases = [
  {
    title: 'Academic Writing',
    desc: 'Rephrase essays and papers to improve clarity, tone, and avoid unintentional plagiarism',
  },
  {
    title: 'Content Marketing',
    desc: 'Refresh blog posts, social media content, and web copy with fresh phrasing for better engagement',
  },
  {
    title: 'Professional Communication',
    desc: 'Polish emails, reports, and proposals with formal language that conveys authority and professionalism',
  },
  {
    title: 'Creative Writing',
    desc: 'Experiment with different phrasing styles for stories, poems, and creative projects',
  },
];

const faqItems = [
  {
    question: 'How does AI paraphrasing work?',
    answer:
      'The AI Paraphraser uses a built-in synonym dictionary to intelligently replace words with suitable alternatives. Different modes apply different transformation rules — Standard replaces common words, Fluent restructures short phrases, Formal uses elevated vocabulary, and Creative applies more varied replacements for maximum originality.',
  },
  {
    question: 'Which paraphrasing mode should I choose?',
    answer:
      'Standard mode is best for quick rewording while preserving original structure. Fluent mode improves flow and readability. Formal mode elevates tone for professional contexts. Creative mode produces the most varied output, ideal for content refresh and avoiding duplication. Try different modes to find the best result.',
  },
  {
    question: 'Is my text stored or saved?',
    answer:
      'No. All paraphrasing happens entirely in your browser. Your text is never sent to any server. The tool processes everything locally using JavaScript, ensuring your content remains private and secure at all times.',
  },
];

const schema = {
  name: 'AI Paraphraser Pro',
  applicationCategory: 'AI Tools',
  description:
    'Paraphrase any text with four modes: Standard, Fluent, Formal, and Creative. AI-powered synonym replacement for content rewriting.',
};
---

<MainLayout
  title="AI Paraphraser & Sentence Rewriter — Client-Side NLP & WebGPU Offline Mode | NumanX Tools"
  description="Paraphrase text with client-side NLP and local WebGPU neural execution. Choose from Standard, Fluent, Formal, and Creative modes with zero cloud uploads."
  keywords="ai paraphraser, sentence rewriter, client side paraphrasing tool, webgpu paraphraser offline, rewrite text free"
  toolSchema={schema}
  faq={faqItems}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'AI Paraphraser', url: '/tools/ai-paraphraser/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="AI"
        gradient="Paraphraser Pro"
        desc="Paraphrase your text in four different modes — Standard, Fluent, Formal, and Creative — using AI synonym replacement."
        badge="✦ AI Powered"
        slug="ai-paraphraser"
      />
      <ShareBar />
      <div class="max-w-xl mx-auto mt-10">
        <div class="bg-surface-1 border border-surface rounded-2xl p-6 relative">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
              <span id="usage-badge" class="text-xs text-muted"></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex gap-1">
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="purple"
                  style="background:#a855f7"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="blue"
                  style="background:#3b82f6"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="green"
                  style="background:#22c55e"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="pink"
                  style="background:#ec4899"></button>
              </div>
              <button
                id="fullscreen-btn"
                class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs"
                title="Fullscreen">⛶</button
              >
            </div>
          </div>
          <div class="flex items-center gap-1.5 mb-2">
            <button
              class="font-dec p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all"
              >A−</button
            >
            <button
              class="font-inc p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all"
              >A+</button
            >
            <span class="text-xs text-muted ml-auto">Ctrl+Enter to process</span>
          </div>
          <div class="flex">
            <div
              id="line-nums"
              class="text-xs text-muted text-right pr-2 select-none overflow-hidden font-mono leading-relaxed pt-3"
              style="min-width:2.5em"
            >
              1
            </div>
            <textarea
              id="input-text"
              rows="5"
              placeholder="Paste your text here to paraphrase..."
              class="flex-1 bg-transparent text-white placeholder-zinc-600 p-4 resize-none focus:outline-none text-sm leading-relaxed border border-surface-2 rounded-xl mb-4"
            ></textarea>
          </div>
          <div id="reading-time" class="text-xs text-muted -mt-3 mb-2"></div>
          <div id="letter-freq" class="mt-2 space-y-0.5 max-h-24 overflow-y-auto hidden"></div>
          <div class="flex flex-wrap gap-2 mb-4" id="mode-selector">
            <button
              data-mode="standard"
              class="mode-btn px-4 py-2 rounded-lg text-xs font-semibold border transition-all bg-violet-600 text-white border-violet-500"
              >Standard</button
            >
            <button
              data-mode="fluent"
              class="mode-btn px-4 py-2 rounded-lg text-xs font-semibold border transition-all bg-surface-2 text-tertiary border-surface-3 hover:text-white"
              >Fluent</button
            >
            <button
              data-mode="formal"
              class="mode-btn px-4 py-2 rounded-lg text-xs font-semibold border transition-all bg-surface-2 text-tertiary border-surface-3 hover:text-white"
              >Formal</button
            >
            <button
              data-mode="creative"
              class="mode-btn px-4 py-2 rounded-lg text-xs font-semibold border transition-all bg-surface-2 text-tertiary border-surface-3 hover:text-white"
              >Creative</button
            >
          </div>
          <button
            id="paraphrase-btn"
            class="w-full py-3 rounded-xl font-bold text-sm bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-500 hover:to-purple-500 text-white transition-all duration-200 shadow-lg shadow-violet-600/20"
            >Paraphrase</button
          >
          <div id="output-section" class="hidden mt-4">
            <div class="relative rounded-xl border border-surface-2 bg-surface-1 overflow-hidden">
              <textarea
                id="output-text"
                rows="5"
                readonly
                class="w-full bg-transparent text-white p-4 resize-none focus:outline-none text-sm leading-relaxed"
              ></textarea>
              <button
                id="copy-btn"
                class="absolute top-2 right-2 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-[10px] font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
                >Copy</button
              >
            </div>
            <div class="flex items-center justify-between mt-2">
              <div class="flex gap-2">
                <select
                  id="export-format"
                  class="bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5"
                >
                  <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option
                  ><option value="html">HTML</option>
                </select>
                <button
                  id="download-btn"
                  class="px-3 py-1.5 bg-surface-2 hover:bg-surface-3 border border-surface-3 rounded-lg text-[10px] text-tertiary hover:text-primary transition-all"
                  >Download</button
                >
                <button
                  id="share-btn"
                  class="px-2.5 py-1.5 bg-surface-2 hover:bg-surface-3 border border-surface-3 rounded-lg text-[10px] text-tertiary hover:text-primary transition-all"
                  title="Copy share link">🔗</button
                >
                <button
                  id="clear-btn"
                  class="px-3 py-1.5 bg-surface-2 hover:bg-surface-3 border border-surface-3 rounded-lg text-[10px] text-tertiary hover:text-primary transition-all"
                  >Clear</button
                >
              </div>
              <span id="word-count" class="text-xs text-tertiary"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <section class="mt-20 max-w-3xl mx-auto">
      <div class="text-center mb-8">
        <span class="text-xs font-semibold text-violet-400 uppercase tracking-wider">AI Technology</span><h2
          class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1"
        >
          How It <span class="bg-gradient-to-r from-violet-400 to-purple-500 bg-clip-text text-transparent">Works</span>
        </h2>
      </div><div class="space-y-4 text-sm text-tertiary leading-relaxed">
        <p>
          The AI Paraphraser uses a built-in synonym dictionary covering hundreds of common English words. Each mode
          applies different transformation rules: <strong class="text-primary">Standard</strong> replaces common words with
          contextually appropriate synonyms. <strong class="text-primary">Fluent</strong> restructures short phrases and reorders
          clauses. <strong class="text-primary">Formal</strong> elevates vocabulary and removes contractions. <strong
            class="text-primary">Creative</strong
          > applies varied synonym replacement with more aggressive restructuring.
        </p><p>
          All processing happens locally in your browser — no data is ever sent to a server, ensuring complete privacy.
        </p>
      </div>
    </section>
    <RelatedTools current="ai-paraphraser" />
    <div class="mt-20 max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
        Frequently Asked <span class="bg-gradient-to-r from-violet-400 to-purple-500 bg-clip-text text-transparent"
          >Questions</span
        >
      </h2><Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
    </div>
  </main>
</MainLayout>
<script>
  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }
  const synonyms = {
    good: ['excellent', 'superb', 'outstanding', 'fine'],
    bad: ['poor', 'terrible', 'awful', 'subpar'],
    big: ['large', 'huge', 'enormous', 'massive'],
    small: ['tiny', 'little', 'compact', 'minute'],
    fast: ['quick', 'rapid', 'swift', 'speedy'],
    slow: ['gradual', 'leisurely', 'sluggish'],
    happy: ['glad', 'pleased', 'delighted', 'cheerful'],
    sad: ['unhappy', 'sorrowful', 'gloomy', 'melancholy'],
    nice: ['pleasant', 'lovely', 'delightful', 'agreeable'],
    old: ['ancient', 'elderly', 'aged', 'mature'],
    new: ['fresh', 'recent', 'modern', 'current'],
    important: ['significant', 'crucial', 'vital', 'essential'],
    interesting: ['fascinating', 'engaging', 'compelling', 'captivating'],
    beautiful: ['gorgeous', 'stunning', 'lovely', 'exquisite'],
    hard: ['difficult', 'challenging', 'tough', 'demanding'],
    easy: ['simple', 'effortless', 'straightforward'],
    help: ['assist', 'support', 'aid', 'facilitate'],
    use: ['utilize', 'employ', 'leverage', 'apply'],
    make: ['create', 'produce', 'generate', 'craft'],
    get: ['obtain', 'acquire', 'receive', 'secure'],
    show: ['demonstrate', 'display', 'exhibit', 'reveal'],
    think: ['believe', 'consider', 'suppose', 'reckon'],
    need: ['require', 'demand', 'necessitate'],
    provide: ['supply', 'furnish', 'offer', 'deliver'],
  };

  const formalSynonyms = {
    good: ['satisfactory', 'commendable', 'exceptional', 'superior'],
    bad: ['inferior', 'deficient', 'substandard', 'unsatisfactory'],
    big: ['substantial', 'considerable', 'significant', 'extensive'],
    small: ['diminutive', 'modest', 'compact', 'minimal'],
    help: ['facilitate', 'assist', 'provide support'],
    use: ['utilize', 'employ', 'leverage'],
    make: ['produce', 'manufacture', 'fabricate'],
    get: ['obtain', 'acquire', 'procure', 'secure'],
    show: ['demonstrate', 'illustrate', 'exhibit'],
    think: ['opine', 'surmise', 'postulate', 'conceive'],
    need: ['require', 'necessitate', 'be incumbent upon'],
    buy: ['purchase', 'acquire', 'procure'],
    start: ['commence', 'initiate', 'embark upon'],
    end: ['terminate', 'conclude', 'cease'],
  };

  const contractions =
    /\b(can't|don't|won't|isn't|aren't|wasn't|weren't|haven't|hasn't|hadn't|doesn't|didn't|couldn't|wouldn't|shouldn't|mightn't|mustn't|i'm|you're|he's|she's|it's|we're|they're|i've|you've|we've|they've|i'll|you'll|he'll|she'll|we'll|they'll|i'd|you'd|he'd|she'd|we'd|they'd)\b/gi;

  const contractionMap = {
    "can't": 'cannot',
    "don't": 'do not',
    "won't": 'will not',
    "isn't": 'is not',
    "aren't": 'are not',
    "wasn't": 'was not',
    "weren't": 'were not',
    "haven't": 'have not',
    "hasn't": 'has not',
    "hadn't": 'had not',
    "doesn't": 'does not',
    "didn't": 'did not',
    "couldn't": 'could not',
    "wouldn't": 'would not',
    "shouldn't": 'should not',
    "mightn't": 'might not',
    "mustn't": 'must not',
    "i'm": 'I am',
    "you're": 'you are',
    "he's": 'he is',
    "she's": 'she is',
    "it's": 'it is',
    "we're": 'we are',
    "they're": 'they are',
    "i've": 'I have',
    "you've": 'you have',
    "we've": 'we have',
    "they've": 'they have',
    "i'll": 'I will',
    "you'll": 'you will',
    "he'll": 'he will',
    "she'll": 'she will',
    "we'll": 'we will',
    "they'll": 'they will',
    "i'd": 'I would',
    "you'd": 'you would',
    "he'd": 'he would',
    "she'd": 'she would',
    "we'd": 'we would',
    "they'd": 'they would',
  };

  const creativeModifiers = {
    good: ['stellar', 'first-rate', 'top-notch', 'remarkable'],
    bad: ['dreadful', 'atrocious', 'abysmal', 'lamentable'],
    big: ['colossal', 'gigantic', 'immense', 'towering'],
    small: ['petite', 'diminutive', 'wee', 'microscopic'],
    fast: ['brisk', 'hasty', 'expeditious', 'whirlwind'],
    slow: ['unhurried', 'leisurely', 'plodding', 'gradual'],
    happy: ['jubilant', 'ecstatic', 'elated', 'thrilled'],
    sad: ['dismal', 'despondent', 'somber', 'wistful'],
    nice: ['charming', 'enchanting', 'captivating', 'delightful'],
  };

  function getRandomSynonym(word, mode) {
    const lower = word.toLowerCase();
    let dict;
    if (mode === 'formal') dict = formalSynonyms;
    else if (mode === 'creative') dict = { ...synonyms, ...creativeModifiers };
    else dict = synonyms;
    const list = dict[lower];
    if (!list) return null;
    return list[Math.floor(Math.random() * list.length)];
  }

  function replaceInSentence(sentence, mode) {
    const words = sentence.split(/(\s+)/);
    return words
      .map((w) => {
        if (w.trim() === '') return w;
        const isUpper = w[0] === w[0].toUpperCase() && w[0] !== w[0].toLowerCase();
        const clean = w.replace(/[^a-zA-Z'-]/g, '');
        const punct = w.replace(/[a-zA-Z'-]/g, '');
        const syn = getRandomSynonym(clean, mode);
        if (syn) {
          const result = isUpper ? syn[0].toUpperCase() + syn.slice(1) : syn;
          if (mode === 'creative' && Math.random() > 0.3) return result + punct;
          if (mode === 'standard' && Math.random() > 0.35) return result + punct;
          if (mode === 'fluent' && Math.random() > 0.4) return result + punct;
          return w;
        }
        return w;
      })
      .join('');
  }

  function expandContractions(text) {
    return text.replace(contractions, (match) => contractionMap[match.toLowerCase()] || match);
  }

  function fluentRestructure(text) {
    const sentences = text.split(/(?<=[.!?])\s+/).filter((s) => s.trim());
    return sentences
      .map((s) => {
        if (s.split(' ').length > 8 && Math.random() > 0.5) {
          const parts = s.split(/[,;]/);
          if (parts.length > 1 && Math.random() > 0.5) {
            const idx = Math.floor(Math.random() * (parts.length - 1)) + 1;
            parts.splice(idx, 0, parts.shift());
            return parts.join(',').trim();
          }
        }
        return s;
      })
      .join(' ');
  }

  function creativeRestructure(text) {
    const sentences = text.split(/(?<=[.!?])\s+/).filter((s) => s.trim());
    return sentences
      .map((s) => {
        if (Math.random() > 0.6) {
          const words = s.split(/\s+/);
          if (words.length > 5) {
            const idx = Math.floor(Math.random() * (words.length - 2)) + 1;
            const temp = words[idx];
            words[idx] = words[idx + 1];
            words[idx + 1] = temp;
            return words.join(' ');
          }
        }
        return s;
      })
      .join(' ');
  }

  function paraphrase(text, mode) {
    if (!text.trim()) return '';
    let result = text.trim();

    if (mode === 'formal') {
      result = expandContractions(result);
      result = replaceInSentence(result, 'formal');
    } else if (mode === 'fluent') {
      result = replaceInSentence(result, 'fluent');
      result = fluentRestructure(result);
    } else if (mode === 'creative') {
      result = replaceInSentence(result, 'creative');
      result = creativeRestructure(result);
      result = fluentRestructure(result);
    } else {
      result = replaceInSentence(result, 'standard');
    }

    return result;
  }

  let currentMode = 'standard';

  document.querySelectorAll('.mode-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.mode-btn').forEach((b) => {
        b.className =
          'mode-btn px-4 py-2 rounded-lg text-xs font-semibold border transition-all bg-surface-2 text-tertiary border-surface-3 hover:text-white';
      });
      btn.className =
        'mode-btn px-4 py-2 rounded-lg text-xs font-semibold border transition-all bg-violet-600 text-white border-violet-500';
      currentMode = btn.dataset.mode;
    });
  });

  document.getElementById('paraphrase-btn').addEventListener('click', () => {
    const input = document.getElementById('input-text').value;
    if (!input.trim()) {
      if (window.__showToast) window.__showToast({ message: 'Please enter text to paraphrase', variant: 'warning' });
      return;
    }
    const output = paraphrase(input, currentMode);
    document.getElementById('output-section').classList.remove('hidden');
    document.getElementById('output-text').value = output;
    document.getElementById('word-count').textContent = output.split(/\s+/).filter((w) => w).length + ' words';
  });

  document.getElementById('copy-btn').addEventListener('click', async () => {
    const text = document.getElementById('output-text').value;
    if (!text) {
      if (window.__showToast) window.__showToast({ message: 'Nothing to copy!', variant: 'warning' });
      return;
    }
    await navigator.clipboard.writeText(text);
    playPing();
    if (window.__showToast) window.__showToast({ message: 'Paraphrased text copied!', variant: 'success' });
  });

  document.getElementById('download-btn')?.addEventListener('click', () => {
    const outputText = document.getElementById('output-text').value;
    if (!outputText) {
      if (window.__showToast) window.__showToast({ message: 'Nothing to download!', variant: 'warning' });
      return;
    }
    const fmt = document.getElementById('export-format')?.value || 'txt';
    let content = outputText;
    let mime = 'text/plain';
    let ext = 'txt';
    if (fmt === 'json') {
      content = JSON.stringify({ result: outputText, tool: 'ai-paraphraser', timestamp: new Date().toISOString() });
      mime = 'application/json';
      ext = 'json';
    }
    if (fmt === 'csv') {
      content = 'Result\n"' + outputText.replace(/"/g, '""') + '"';
      mime = 'text/csv';
      ext = 'csv';
    }
    if (fmt === 'html') {
      content = '<!DOCTYPE html><html><body><pre>' + outputText.replace(/</g, '&lt;') + '</pre></body></html>';
      mime = 'text/html';
      ext = 'html';
    }
    const blob = new Blob([content], { type: mime });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'paraphrased-output.' + ext;
    a.click();
    URL.revokeObjectURL(a.href);
    playPing();
    if (window.__showToast) window.__showToast({ message: 'Downloaded!', variant: 'success' });
  });

  document.getElementById('clear-btn')?.addEventListener('click', () => {
    document.getElementById('input-text').value = '';
    document.getElementById('output-text').value = '';
    document.getElementById('output-section').classList.add('hidden');
    document.getElementById('input-text').focus();
    playPing();
    if (window.__showToast) window.__showToast({ message: 'Cleared!', variant: 'info' });
  });

  document.getElementById('fullscreen-btn')?.addEventListener('click', () => {
    const card =
      document.getElementById('fullscreen-btn').closest('.bg-surface-1.border.border-surface.rounded-2xl') ||
      document.getElementById('fullscreen-btn').closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
      document.getElementById('fullscreen-btn').textContent = '⛶';
    } else {
      card.requestFullscreen?.() || card.webkitRequestFullscreen?.();
      document.getElementById('fullscreen-btn').textContent = '✕';
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const btn = document.getElementById('fullscreen-btn');
    if (btn) btn.textContent = document.fullscreenElement ? '✕' : '⛶';
  });

  const DRAFT_KEY = 'nt_draft_ai-paraphraser';
  (function () {
    const input = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
    if (!input) return;
    try {
      const saved = localStorage.getItem(DRAFT_KEY);
      if (saved && !input.value) {
        input.value = saved;
        input.dispatchEvent(new Event('input'));
      }
    } catch (e) {}
    let saveTimer;
    input.addEventListener('input', () => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        try {
          localStorage.setItem(DRAFT_KEY, input.value);
        } catch (e) {}
      }, 500);
    });
  })();

  document.querySelector('.font-inc')?.addEventListener('click', () => {
    document.querySelectorAll('textarea').forEach((t) => {
      let s = parseInt(getComputedStyle(t).fontSize);
      t.style.fontSize = Math.min(24, s + 2) + 'px';
    });
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    document.querySelectorAll('textarea').forEach((t) => {
      let s = parseInt(getComputedStyle(t).fontSize);
      t.style.fontSize = Math.max(10, s - 2) + 'px';
    });
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) document.querySelectorAll('textarea').forEach((t) => (t.style.fontSize = s + 'px'));
  } catch (e) {}

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b =
        document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])") ||
        document.querySelector("button[class*='bg-']:not([id*='full']):not([id*='paste'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      document.getElementById('clear-btn')?.click();
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });

  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['ai-paraphraser']) b.textContent = 'Used ' + u['ai-paraphraser'] + '×';
  } catch (e) {}

  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('output-text') || document.querySelector("[id$='result']");
    const t = o?.value || o?.textContent || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof window.__showToast === 'function') window.__showToast({ message: 'Link copied!' });
  });

  const rtInput = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
  if (rtInput) {
    rtInput.addEventListener('input', () => {
      const w = rtInput.value ? rtInput.value.trim().split(/\s+/).length : 0;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent =
          Math.max(1, Math.round(w / 200)) + ' min read · ' + Math.max(1, Math.round(w / 150)) + ' min speak';
    });
    rtInput.dispatchEvent(new Event('input'));
  }

  const lnInput = document.getElementById('input-text');
  if (lnInput) {
    const updateLN = () => {
      const n = document.getElementById('line-nums');
      if (n) n.textContent = Array.from({ length: lnInput.value.split('\n').length }, (_, i) => i + 1).join('\n');
    };
    lnInput.addEventListener('input', updateLN);
    lnInput.addEventListener('scroll', () => {
      const n = document.getElementById('line-nums');
      if (n) n.scrollTop = lnInput.scrollTop;
    });
    updateLN();
  }

  const lfInput = document.getElementById('input-text');
  if (lfInput) {
    lfInput.addEventListener('input', () => {
      const t = lfInput.value.toLowerCase().replace(/[^a-z]/g, '');
      if (!t) {
        document.getElementById('letter-freq').classList.add('hidden');
        return;
      }
      const f = {};
      for (const c of t) f[c] = (f[c] || 0) + 1;
      const s = Object.entries(f)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8);
      const m = s[0] ? s[0][1] : 1;
      const el = document.getElementById('letter-freq');
      el.classList.remove('hidden');
      el.innerHTML = s
        .map(
          ([c, n]) =>
            `<div class="flex items-center gap-1.5 text-xs"><span class="w-3 text-center font-mono text-white">${c}</span><div class="h-2 rounded-full bg-purple-500/50" style="width:${(n / m) * 80 + 10}%"></div><span class="text-muted">${n}</span></div>`,
        )
        .join('');
    });
  }

  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      const map = { purple: '#a855f7', blue: '#3b82f6', green: '#22c55e', pink: '#ec4899', orange: '#f97316' };
      document.querySelectorAll("button[class*='bg-purple'], button[class*='bg-violet']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(purple|violet)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(purple|violet)-\d+/g, 'hover:bg-' + c + '-500')
          .replace(/from-(purple|violet)-\d+/g, 'from-' + c + '-500')
          .replace(/to-purple-\d+/g, 'to-' + c + '-600');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}
</script>
