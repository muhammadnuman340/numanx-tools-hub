---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";

const faqItems = [
  { question: "What is a good Flesch Reading Ease score?", answer: "Scores typically range from 0-100. 60-70 is considered 'plain English' and easily understood by 13-15 year olds. Scores above 80 are very easy to read (conversational), while scores below 30 are very difficult (academic/technical). Most professional content aims for 50-70." },
  { question: "Which readability score should I use?", answer: "It depends on your audience. Flesch Reading Ease is great for general readability. Flesch-Kincaid Grade Level is widely used in education and government. Gunning Fog is excellent for business and journalism. SMOG Index is ideal for healthcare content. Using all four gives you a comprehensive picture." },
  { question: "How can I improve my text's readability?", answer: "Use shorter words and sentences, avoid jargon, break long paragraphs into smaller ones, use bullet points and headings, prefer active voice over passive voice, and keep sentences under 20 words when possible. Aim for your target grade level and adjust based on your audience." },
];

const schema = {
  name: "AI Readability Analyzer Pro",
  applicationCategory: "AI Tools",
  description: "Analyze text readability with Flesch Reading Ease, Flesch-Kincaid, Gunning Fog, and SMOG Index scores. Get detailed stats on word count, sentence length, and syllable count.",
};
---
<MainLayout title="AI Readability Analyzer - Free Text Readability Checker" description="Analyze your text with Flesch Reading Ease, Flesch-Kincaid Grade Level, Gunning Fog Index, and SMOG Index scores." keywords="readability analyzer, flesch reading ease, flesch-kincaid, gunning fog, smog index, text readability checker" toolSchema={schema} faq={faqItems} breadcrumbs={[{name:"Home",url:"/"},{name:"Tools",url:"/tools/"},{name:"AI Readability Analyzer",url:"/tools/ai-readability-analyzer/"}]}>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden"><div class="max-w-4xl mx-auto">
    <ToolHeader title="AI Readability" gradient="Analyzer Pro" desc="Analyze text readability using Flesch Reading Ease, Flesch-Kincaid, Gunning Fog, and SMOG Index with detailed statistics." badge="✦ AI Powered" slug="ai-readability-analyzer" />
    <ShareBar />
    <div class="max-w-xl mx-auto mt-10"><div class="bg-surface-1 border border-surface rounded-2xl p-6">
      <textarea id="input-text" rows="6" placeholder="Paste your text here to analyze readability..." class="w-full bg-transparent text-white placeholder-zinc-600 p-4 resize-none focus:outline-none text-sm leading-relaxed border border-surface-2 rounded-xl mb-4"></textarea>
      <button id="analyze-btn" class="w-full py-3 rounded-xl font-bold text-sm bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-500 hover:to-purple-500 text-white transition-all duration-200 shadow-lg shadow-violet-600/20">Analyze Readability</button>
      <div id="results" class="hidden mt-6 space-y-4">
        <div class="bg-surface-1 border border-surface rounded-xl p-4">
          <div class="flex items-center justify-between mb-1"><span class="text-xs text-tertiary">Flesch Reading Ease</span><span id="flesch-score" class="text-lg font-bold text-white"></span></div>
          <div class="w-full h-2 rounded-full bg-surface-2 overflow-hidden"><div id="flesch-bar" class="h-full rounded-full transition-all duration-500" style="width:0%"></div></div>
          <span id="flesch-label" class="text-[10px] text-tertiary mt-1 block"></span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="bg-surface-1 border border-surface rounded-xl p-4 text-center"><span class="text-xs text-tertiary block mb-1">Flesch-Kincaid</span><span id="fk-grade" class="text-xl font-bold text-white">—</span></div>
          <div class="bg-surface-1 border border-surface rounded-xl p-4 text-center"><span class="text-xs text-tertiary block mb-1">Gunning Fog</span><span id="gunning-score" class="text-xl font-bold text-white">—</span></div>
          <div class="bg-surface-1 border border-surface rounded-xl p-4 text-center"><span class="text-xs text-tertiary block mb-1">SMOG Index</span><span id="smog-score" class="text-xl font-bold text-white">—</span></div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center"><span class="text-[10px] text-tertiary block">Words</span><span id="word-count" class="text-sm font-bold text-white">0</span></div>
          <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center"><span class="text-[10px] text-tertiary block">Sentences</span><span id="sentence-count" class="text-sm font-bold text-white">0</span></div>
          <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center"><span class="text-[10px] text-tertiary block">Syllables</span><span id="syllable-count" class="text-sm font-bold text-white">0</span></div>
          <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center"><span class="text-[10px] text-tertiary block">Complex Words</span><span id="complex-count" class="text-sm font-bold text-white">0</span></div>
          <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center"><span class="text-[10px] text-tertiary block">Avg Words/Sentence</span><span id="avg-wps" class="text-sm font-bold text-white">0</span></div>
          <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center"><span class="text-[10px] text-tertiary block">Avg Syllables/Word</span><span id="avg-spw" class="text-sm font-bold text-white">0</span></div>
          <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center"><span class="text-[10px] text-tertiary block">Characters</span><span id="char-count" class="text-sm font-bold text-white">0</span></div>
          <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center"><span class="text-[10px] text-tertiary block">Paragraphs</span><span id="para-count" class="text-sm font-bold text-white">0</span></div>
        </div>
      </div>
    </div></div>
    <section class="mt-20 max-w-3xl mx-auto"><div class="text-center mb-8"><span class="text-xs font-semibold text-violet-400 uppercase tracking-wider">AI Technology</span><h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">How It <span class="bg-gradient-to-r from-violet-400 to-purple-500 bg-clip-text text-transparent">Works</span></h2></div><div class="space-y-4 text-sm text-tertiary leading-relaxed"><p>The AI Readability Analyzer applies four established readability formulas to your text. <strong class="text-primary">Flesch Reading Ease</strong> (206.835 - 1.015×W/S - 84.6×Syl/W) produces a 0-100 score. <strong class="text-primary">Flesch-Kincaid Grade Level</strong> converts this to a US grade level. <strong class="text-primary">Gunning Fog</strong> estimates years of education needed, and <strong class="text-primary">SMOG Index</strong> evaluates polysyllabic word density.</p><p>A built-in syllable counter uses vowel-grouping rules to accurately count syllables for English text, identifying complex words (3+ syllables) that impact readability scores.</p></div></section>
    <RelatedTools current="ai-readability-analyzer" />
    <div class="mt-20 max-w-3xl mx-auto"><h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">Frequently Asked <span class="bg-gradient-to-r from-violet-400 to-purple-500 bg-clip-text text-transparent">Questions</span></h2><Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} /></div>
  </div></main>
</MainLayout>
<script>
function countSyllables(word) {
  word = word.toLowerCase().replace(/[^a-z]/g, "");
  if (word.length <= 3) return 1;
  word = word.replace(/(?:[^laeiouy]es|ed|[^laeiouy]e)$/, "");
  word = word.replace(/^y/, "");
  const vowels = word.match(/[aeiouy]{1,2}/g);
  return vowels ? vowels.length : 1;
}

function isComplex(word) {
  return countSyllables(word) >= 3;
}

function analyze(text) {
  if (!text.trim()) return null;
  const words = text.trim().split(/\s+/).filter(w => w.length > 0);
  const sentences = text.split(/[.!?]+/).filter(s => s.trim().length > 0);
  const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0);
  const wordCount = words.length;
  const sentenceCount = sentences.length || 1;
  const charCount = text.length;
  let syllableCount = 0, complexCount = 0;
  for (const w of words) {
    const syl = countSyllables(w);
    syllableCount += syl;
    if (syl >= 3) complexCount++;
  }

  const wordsPerSentence = wordCount / sentenceCount;
  const syllablesPerWord = syllableCount / wordCount;

  const flesch = Math.max(0, Math.min(100, 206.835 - 1.015 * wordsPerSentence - 84.6 * syllablesPerWord));
  const fleschKincaid = Math.max(0, 0.39 * wordsPerSentence + 11.8 * syllablesPerWord - 15.59);
  const gunningFog = Math.max(0, 0.4 * (wordsPerSentence + 100 * (complexCount / wordCount)));
  const smog = Math.max(0, 1.0430 * Math.sqrt(complexCount * (30 / sentenceCount)) + 3.1291);

  let fleschLabel;
  if (flesch >= 90) fleschLabel = "Very Easy (5th grade)";
  else if (flesch >= 80) fleschLabel = "Easy (6th grade)";
  else if (flesch >= 70) fleschLabel = "Fairly Easy (7th grade)";
  else if (flesch >= 60) fleschLabel = "Standard (8-9th grade)";
  else if (flesch >= 50) fleschLabel = "Fairly Difficult (10-12th grade)";
  else if (flesch >= 30) fleschLabel = "Difficult (College)";
  else fleschLabel = "Very Difficult (College Graduate)";

  let barColor;
  if (flesch >= 80) barColor = "from-emerald-500 to-green-500";
  else if (flesch >= 60) barColor = "from-green-500 to-yellow-500";
  else if (flesch >= 40) barColor = "from-yellow-500 to-orange-500";
  else barColor = "from-orange-500 to-red-500";

  return { flesch, fleschKincaid, gunningFog, smog, fleschLabel, barColor, wordCount, sentenceCount, syllableCount, complexCount, wordsPerSentence, syllablesPerWord, charCount, paragraphCount: paragraphs.length };
}

document.getElementById("analyze-btn").addEventListener("click", () => {
  const text = document.getElementById("input-text").value;
  const result = analyze(text);
  const resDiv = document.getElementById("results");
  if (!result) {
    resDiv.classList.add("hidden");
    if (window.__showToast) window.__showToast({ message: "Please enter some text to analyze", variant: "warning" });
    return;
  }
  resDiv.classList.remove("hidden");
  document.getElementById("flesch-score").textContent = Math.round(result.flesch);
  document.getElementById("flesch-bar").style.width = result.flesch + "%";
  document.getElementById("flesch-bar").className = "h-full rounded-full bg-gradient-to-r " + result.barColor + " transition-all duration-500";
  document.getElementById("flesch-label").textContent = result.fleschLabel;
  document.getElementById("fk-grade").textContent = result.fleschKincaid.toFixed(1);
  document.getElementById("gunning-score").textContent = result.gunningFog.toFixed(1);
  document.getElementById("smog-score").textContent = result.smog.toFixed(1);
  document.getElementById("word-count").textContent = result.wordCount;
  document.getElementById("sentence-count").textContent = result.sentenceCount;
  document.getElementById("syllable-count").textContent = result.syllableCount;
  document.getElementById("complex-count").textContent = result.complexCount;
  document.getElementById("avg-wps").textContent = result.wordsPerSentence.toFixed(1);
  document.getElementById("avg-spw").textContent = result.syllablesPerWord.toFixed(2);
  document.getElementById("char-count").textContent = result.charCount;
  document.getElementById("para-count").textContent = result.paragraphCount;
});
</script>
