---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";
import ToolContentSections from "../../components/ToolContentSections.astro";

const faqItems = [
  { question: "What is Base64?", answer: "Base64 is a binary-to-text encoding scheme that represents binary data in an ASCII string format. It's commonly used for embedding images in HTML/CSS, transmitting data in APIs, and storing binary data in text-based formats like JSON." },
  { question: "Is my data uploaded to a server?", answer: "No. All encoding and decoding happens entirely in your browser. Your data never leaves your device." },
  { question: "Can I encode files?", answer: "Yes, you can upload a file and the tool will encode its contents to Base64. This is useful for creating data URIs." },
];
const b64Schema = { name: "Base64 Encoder/Decoder", applicationCategory: "Utilities", description: "Encode and decode Base64 strings instantly in your browser.", featureList: ["Encode text to Base64", "Decode Base64 to text", "File upload support", "Copy results instantly"] };
---
<MainLayout title="Base64 Encoder/Decoder - Encode & Decode Base64 Online" description="Encode text or files to Base64 and decode Base64 back to text. Free online Base64 encoder/decoder." keywords="base64 encoder, base64 decoder, base64, encode, decode, developer tools" toolSchema={b64Schema} faq={faqItems} breadcrumbs={[{name:"Home",url:"/"},{name:"Tools",url:"/tools/"},{name:"Base64 Tool",url:"/tools/base64-tool/"}]}>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden"><div class="max-w-4xl mx-auto">
    <ToolHeader title="Base64" gradient="Encoder/Decoder" desc="Encode and decode Base64 strings instantly. Supports text input and file upload." badge="✦ New Tool" slug="base64-tool" />
    <ShareBar />
    <div class="max-w-xl mx-auto mt-10">
      <div class="bg-surface-1 border border-surface rounded-2xl p-6 relative">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
            <span id="usage-badge" class="text-xs text-muted"></span>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex gap-1">
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="purple" style="background:#a855f7"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="blue" style="background:#3b82f6"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="green" style="background:#22c55e"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="pink" style="background:#ec4899"></button>
            </div>
            <button id="fullscreen-btn" class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs" title="Fullscreen">⛶</button>
          </div>
        </div>
        <div class="flex gap-2 mb-4">
          <button id="encode-btn" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-green-600 text-white">Encode</button>
          <button id="decode-btn" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary">Decode</button>
          <button id="clear-btn" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary ml-auto">Clear</button>
        </div>
        <div>
          <label class="block text-xs font-medium text-tertiary mb-1.5">Input</label>
          <div class="flex items-center gap-1.5 mb-2">
            <button class="font-dec p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all">A−</button>
            <button class="font-inc p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all">A+</button>
            <span class="text-xs text-muted ml-auto">Ctrl+Enter to process</span>
          </div>
          <div class="flex">
            <div id="line-nums" class="text-xs text-muted text-right pr-2 select-none overflow-hidden font-mono leading-relaxed pt-3" style="min-width:2.5em">1</div>
            <textarea id="input-area" class="flex-1 h-28 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm font-mono focus:border-green-500/50 focus:outline-none transition-all resize-none" placeholder="Type or paste text here..."></textarea>
          </div>
          <div id="reading-time" class="text-xs text-muted mt-1"></div>
          <div id="letter-freq" class="mt-2 space-y-0.5 max-h-24 overflow-y-auto hidden"></div>
          <div class="mt-2"><input id="file-input" type="file" class="text-xs text-tertiary file:mr-2 file:px-2 file:py-1 file:rounded-lg file:border-0 file:bg-surface-2 file:text-secondary file:text-xs file:cursor-pointer" /></div>
        </div>
        <div class="mt-4">
          <label class="block text-xs font-medium text-tertiary mb-1.5">Result</label>
          <textarea id="output-area" class="w-full h-28 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm font-mono focus:outline-none resize-none" readonly placeholder="Result will appear here..."></textarea>
        </div>
        <button id="b64-copy-btn" class="mt-3 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all">Copy Result</button>
          <button id="share-btn" class="mt-3 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all" title="Copy share link">🔗</button>
          <button id="download-btn" class="mt-3 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all">Download</button>
          <select id="export-format" class="mt-3 bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5">
            <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option><option value="html">HTML</option>
          </select>
      </div>
    </div>
    <section class="mt-20 max-w-3xl mx-auto"><div class="text-center mb-8"><span class="text-xs font-semibold text-green-400 uppercase tracking-wider">Learn</span><h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">Why Use <span class="bg-gradient-to-r from-green-400 to-emerald-500 bg-clip-text text-transparent">Base64 Encoding?</span></h2></div><div class="space-y-4 text-sm text-tertiary leading-relaxed"><p>Base64 encoding is essential for embedding binary data (images, files) in text-based formats like HTML, CSS, and JSON. It's also widely used in email attachments (MIME), data URIs, and API payloads where binary data needs to be transmitted as text.</p></div></section>
    <RelatedTools current="base64-tool" />
    <div class="mt-20 max-w-3xl mx-auto"><h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">Frequently Asked <span class="bg-gradient-to-r from-green-400 to-emerald-500 bg-clip-text text-transparent">Questions</span></h2><Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} /></div>
  </div></main>
</MainLayout>
<script>
  let mode = "encode";
  const inputArea = document.getElementById("input-area") as HTMLTextAreaElement;
  const outputArea = document.getElementById("output-area") as HTMLTextAreaElement;
  const fileInput = document.getElementById("file-input") as HTMLInputElement;
  document.getElementById("encode-btn")!.addEventListener("click", () => { mode="encode"; document.getElementById("encode-btn")!.className="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-green-600 text-white"; document.getElementById("decode-btn")!.className="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary"; process(); });
  document.getElementById("decode-btn")!.addEventListener("click", () => { mode="decode"; document.getElementById("decode-btn")!.className="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-green-600 text-white"; document.getElementById("encode-btn")!.className="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary"; process(); });
  function playPing(){try{const a=new(window.AudioContext||window.webkitAudioContext)();const o=a.createOscillator();const g=a.createGain();o.connect(g);g.connect(a.destination);o.frequency.value=800;g.gain.setValueAtTime(0.08,a.currentTime);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+0.12);o.start();o.stop(a.currentTime+0.12);}catch(e){}}
  document.getElementById("clear-btn")!.addEventListener("click", () => { inputArea.value = ""; outputArea.value = ""; fileInput.value = ""; playPing(); });
  document.getElementById("b64-copy-btn")!.addEventListener("click", async () => { if (!outputArea.value) return; await navigator.clipboard.writeText(outputArea.value); playPing(); if ((window as any).__showToast) (window as any).__showToast({message:"Copied!",variant:"success"}); });
  fileInput.addEventListener("change", () => { const f = fileInput.files?.[0]; if (!f) return; const r = new FileReader(); r.onload = () => { inputArea.value = r.result as string; if (mode==="encode") { outputArea.value = btoa(unescape(encodeURIComponent(inputArea.value))); } }; r.readAsText(f); });
  function process() {
    const text = inputArea.value;
    if (!text) { outputArea.value = ""; return; }
    try {
      if (mode === "encode") { outputArea.value = btoa(unescape(encodeURIComponent(text))); }
      else { outputArea.value = decodeURIComponent(escape(atob(text.replace(/\s/g,'')))); }
    } catch { outputArea.value = "Error: Invalid input for " + (mode==="encode"?"encoding":"decoding"); }
  }
  inputArea.addEventListener("input", process);
  document.getElementById("download-btn")?.addEventListener("click", () => {
    if (!outputArea.value) return;
    const fmt = (document.getElementById("export-format") as HTMLSelectElement)?.value || "txt";
    const mimes = {txt:"text/plain",json:"application/json",csv:"text/csv",html:"text/html"};
    const content = fmt === "json" ? JSON.stringify(outputArea.value) : outputArea.value;
    const blob = new Blob([content], {type:mimes[fmt]||"text/plain"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "base64-output." + fmt;
    a.click();
    playPing();
    URL.revokeObjectURL(a.href);
  });
  document.getElementById("share-btn")?.addEventListener("click",()=>{const o=document.getElementById("output-area");const t=o?.value||"";if(!t)return;const u=window.location.origin+window.location.pathname+"#result="+encodeURIComponent(t.substring(0,200));navigator.clipboard.writeText(u).catch(()=>{});if(typeof (window as any).__showToast==="function")(window as any).__showToast({message:"Link copied!",variant:"success"});});
  document.querySelector(".font-inc")?.addEventListener("click",()=>{document.querySelectorAll("textarea").forEach(t=>{let s=parseInt(getComputedStyle(t).fontSize);t.style.fontSize=Math.min(24,s+2)+"px";})});
  document.querySelector(".font-dec")?.addEventListener("click",()=>{document.querySelectorAll("textarea").forEach(t=>{let s=parseInt(getComputedStyle(t).fontSize);t.style.fontSize=Math.max(10,s-2)+"px";})});
  try{const s=localStorage.getItem("nt_fs");if(s)document.querySelectorAll("textarea").forEach(t=>t.style.fontSize=s+"px")}catch(e){}
  document.addEventListener("keydown",e=>{if(e.ctrlKey&&e.key==="Enter"){e.preventDefault();const b=document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");if(b)b.click();}if(e.ctrlKey&&e.shiftKey&&(e.key==="C"||e.key==="c")){e.preventDefault();document.getElementById("clear-btn")?.click();}if(e.ctrlKey&&(e.key==="D"||e.key==="d")){e.preventDefault();document.getElementById("download-btn")?.click();}});
  try{const u=JSON.parse(localStorage.getItem("nt_tool_usage")||"{}");const b=document.getElementById("usage-badge");if(b&&u["base64"])b.textContent="Used "+u["base64"]+"×"}catch(e){}
  const rt=document.getElementById("input-area");if(rt){rt.addEventListener("input",()=>{const w=rt.value?rt.value.trim().split(/\s+/).length:0;const e=document.getElementById("reading-time");if(e)e.textContent=Math.max(1,Math.round(w/200))+" min read · "+Math.max(1,Math.round(w/150))+" min speak"});rt.dispatchEvent(new Event("input"));}
  const li=document.getElementById("input-area");if(li){const ul=()=>{const n=document.getElementById("line-nums");if(n)n.textContent=Array.from({length:li.value.split("\n").length},(_,i)=>i+1).join("\n")};li.addEventListener("input",ul);li.addEventListener("scroll",()=>{const n=document.getElementById("line-nums");if(n)n.scrollTop=li.scrollTop});ul();}
  const lf=document.getElementById("input-area");if(lf){lf.addEventListener("input",()=>{const t=lf.value.toLowerCase().replace(/[^a-z]/g,"");if(!t){document.getElementById("letter-freq")?.classList.add("hidden");return;}const f={};for(const c of t)f[c]=(f[c]||0)+1;const s=Object.entries(f).sort((a,b)=>b[1]-a[1]).slice(0,8);const m=s[0]?s[0][1]:1;const el=document.getElementById("letter-freq");el.classList.remove("hidden");el.innerHTML=s.map(([c,n])=>`<div class="flex items-center gap-1.5 text-xs"><span class="w-3 text-center font-mono text-white">${c}</span><div class="h-2 rounded-full bg-purple-500/50" style="width:${(n/m)*80+10}%"></div><span class="text-muted">${n}</span></div>`).join("")})}
  document.querySelectorAll(".theme-swatch").forEach(s=>{s.addEventListener("click",()=>{const c=s.dataset.color;document.querySelectorAll("button[class*='bg-green'],button[class*='bg-emerald']").forEach(b=>{b.className=b.className.replace(/bg-(green|emerald)-\d+/g,"bg-"+c+"-600").replace(/hover:bg-(green|emerald)-\d+/g,"hover:bg-"+c+"-500")});try{localStorage.setItem("nt_theme",c)}catch(e){}})});
  try{const c=localStorage.getItem("nt_theme");if(c)document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click()}catch(e){}
</script>
