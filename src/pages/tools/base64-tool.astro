---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'What is Base64?',
    answer:
      "Base64 is a binary-to-text encoding scheme that represents binary data in an ASCII string format. It's commonly used for embedding images in HTML/CSS, transmitting data in APIs, and storing binary data in text-based formats like JSON.",
  },
  {
    question: 'Is my data uploaded to a server?',
    answer: 'No. All encoding and decoding happens entirely in your browser. Your data never leaves your device.',
  },
  {
    question: 'Can I encode files?',
    answer:
      'Yes, you can upload a file and the tool will encode its contents to Base64. This is useful for creating data URIs.',
  },
];
const b64Schema = {
  name: 'Base64 Encoder/Decoder',
  applicationCategory: 'Utilities',
  description: 'Encode and decode Base64 strings instantly in your browser.',
  featureList: ['Encode text to Base64', 'Decode Base64 to text', 'File upload support', 'Copy results instantly'],
};

const benefits = [
  {
    icon: '⚡',
    title: 'Instant Encoding',
    desc: 'Encode text or files into Base64 format instantly without server delays.',
  },
  {
    icon: '🔒',
    title: '100% Private',
    desc: 'All encoding and decoding happens locally in your browser. No data is sent to our servers.',
  },
  {
    icon: '📁',
    title: 'File Support',
    desc: 'Upload files directly to convert them into Base64 data URIs for embedding in HTML or CSS.',
  },
  {
    icon: '🔄',
    title: 'Bidirectional',
    desc: 'Seamlessly switch between encoding text to Base64 and decoding Base64 back to text.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Select Mode',
    desc: 'Choose whether you want to Encode text/files to Base64 or Decode Base64 back to text.',
  },
  {
    num: '2',
    title: 'Input Data',
    desc: 'Type or paste your text into the input area. Alternatively, use the file upload button to encode a file.',
  },
  {
    num: '3',
    title: 'View Result',
    desc: 'The tool will automatically process your input in real-time and display the result.',
  },
  {
    num: '4',
    title: 'Copy or Download',
    desc: 'Click Copy Result to copy to clipboard, or Download to save the output as a file.',
  },
];

const useCases = [
  {
    icon: '🖼️',
    title: 'Image Embedding',
    desc: 'Convert small images into Base64 data URIs to embed directly into HTML or CSS files, reducing HTTP requests.',
  },
  {
    icon: '📡',
    title: 'API Authentication',
    desc: 'Encode API credentials (username:password) for use in Basic Authentication headers.',
  },
  {
    icon: '📝',
    title: 'Data Storage',
    desc: 'Safely store complex binary data or rich text in JSON or XML formats.',
  },
];
---

<MainLayout
  title="Base64 Encoder & Decoder — UTF-8 Safe | NumanX"
  description="Encode text or files to Base64 and decode Base64 back to text with UTF-8 byte safety. Generate inline CSS and HTML Data URI image strings online free."
  keywords="utf8 safe base64, base64 encoder decoder, data uri generator, inline image base64, base64 serializer"
  toolSchema={b64Schema}
  faq={faqItems}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Base64 Tool', url: '/tools/base64-tool/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="Base64"
        gradient="Encoder/Decoder"
        desc="Encode and decode Base64 strings instantly. Supports text input and file upload."
        badge="✦ New Tool"
        slug="base64-tool"
      />
      <ShareBar />
      <div class="max-w-xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6 relative">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
              <span id="usage-badge" class="text-xs text-muted"></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex gap-1" role="group" aria-label="Theme color swatches">
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="purple"
                  aria-label="Set purple theme"
                  style="background:#a855f7"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="blue"
                  aria-label="Set blue theme"
                  style="background:#3b82f6"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="green"
                  aria-label="Set green theme"
                  style="background:#22c55e"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="pink"
                  aria-label="Set pink theme"
                  style="background:#ec4899"></button>
              </div>
              <button
                id="fullscreen-btn"
                aria-label="Toggle fullscreen"
                class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs"
                title="Fullscreen">⛶</button
              >
            </div>
          </div>
          <div class="flex gap-2 mb-4">
            <button
              id="encode-btn"
              class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-green-600 text-white">Encode</button
            >
            <button
              id="decode-btn"
              class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary"
              >Decode</button
            >
            <button
              id="clear-btn"
              class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary ml-auto"
              >Clear</button
            >
          </div>
          <div>
            <div class="flex items-center justify-between min-h-[32px] mb-2">
              <label for="input-area" class="text-xs font-semibold text-zinc-300">Input</label>
              <div class="flex items-center gap-1.5">
                <div class="flex items-center gap-0.5 bg-surface-2 p-0.5 rounded-lg border border-surface">
                  <button
                    type="button"
                    aria-label="Decrease font size"
                    class="font-dec px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                    >A−</button
                  >
                  <button
                    type="button"
                    aria-label="Increase font size"
                    class="font-inc px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                    >A+</button
                  >
                </div>
                <span class="text-xs text-muted ml-2">Ctrl+Enter to process</span>
              </div>
            </div>
            <div class="flex h-[180px] rounded-xl bg-black/40 border border-surface focus-within:border-green-500 focus-within:ring-1 focus-within:ring-green-500 transition-all overflow-hidden relative">
              <div
                id="line-nums"
                class="w-12 shrink-0 h-full select-none overflow-hidden font-mono text-sm leading-6 text-right pr-3.5 py-3 text-zinc-500/80 bg-zinc-950/60 border-r border-white/5 whitespace-pre pointer-events-none tabular-nums"
                style="line-height: 24px; font-size: 14px;"
              >
                1
              </div>
              <textarea
                id="input-area"
                aria-label="Base64 input text"
                class="flex-1 min-w-0 h-full bg-transparent text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 px-4 py-3 focus:outline-none font-mono resize-none border-0 overflow-y-auto"
                style="line-height: 24px; font-size: 14px;"
                placeholder="Type or paste text here..."></textarea>
            </div>
            <div id="reading-time" class="text-xs text-muted mt-2"></div>
            <div id="letter-freq" tabindex="0" role="region" aria-label="Character frequency breakdown" class="mt-2 flex flex-wrap gap-1.5 hidden"></div>
            <div class="mt-2">
              <input
                id="file-input"
                type="file"
                aria-label="Upload file to encode or decode"
                class="text-xs text-tertiary file:mr-2 file:px-2 file:py-1 file:rounded-lg file:border-0 file:bg-surface-2 file:text-secondary file:text-xs file:cursor-pointer"
              />
            </div>
          </div>
          <div class="mt-4">
            <label for="output-area" class="block text-xs font-semibold text-zinc-300 mb-1.5">Result</label>
            <textarea
              id="output-area"
              aria-label="Base64 output result"
              class="w-full h-[180px] px-4 py-3 rounded-xl border border-surface bg-black/40 text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 focus:outline-none resize-none font-mono overflow-y-auto"
              style="line-height: 24px; font-size: 14px;"
              readonly
              placeholder="Result will appear here..."></textarea>
          </div>
          <button
            id="b64-copy-btn"
            class="mt-3 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
            >Copy Result</button
          >
          <button
            id="share-btn"
            class="mt-3 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
            title="Copy share link">🔗</button
          >
          <button
            id="download-btn"
            class="mt-3 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
            >Download</button
          >
          <select
            id="export-format" aria-label="Export file format"
            class="mt-3 bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5"
          >
            <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option><option
              value="html">HTML</option
            >
          </select>
        </div>
      </div>
      <ToolContentSections
        toolSlug="base64-tool"
        toolName="Base64 Encoder/Decoder"
        category="Utility Tools"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />
      <RelatedTools current="base64-tool" />
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span class="bg-gradient-to-r from-green-400 to-emerald-500 bg-clip-text text-transparent"
            >Questions</span
          >
        </h2><Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>
<script>
  let mode = 'encode';
  const inputArea = document.getElementById('input-area') as HTMLTextAreaElement;
  const outputArea = document.getElementById('output-area') as HTMLTextAreaElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  document.getElementById('encode-btn')!.addEventListener('click', () => {
    mode = 'encode';
    document.getElementById('encode-btn')!.className =
      'px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-green-600 text-white';
    document.getElementById('decode-btn')!.className =
      'px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary';
    process();
  });
  document.getElementById('decode-btn')!.addEventListener('click', () => {
    mode = 'decode';
    document.getElementById('decode-btn')!.className =
      'px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-green-600 text-white';
    document.getElementById('encode-btn')!.className =
      'px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary';
    process();
  });
  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }
  document.getElementById('clear-btn')!.addEventListener('click', () => {
    inputArea.value = '';
    outputArea.value = '';
    fileInput.value = '';
    playPing();
  });
  document.getElementById('b64-copy-btn')!.addEventListener('click', async () => {
    if (!outputArea.value) return;
    await navigator.clipboard.writeText(outputArea.value);
    playPing();
    if ((window as any).__showToast) (window as any).__showToast({ message: 'Copied!', variant: 'success' });
  });
  fileInput.addEventListener('change', () => {
    const f = fileInput.files?.[0];
    if (!f) return;
    const r = new FileReader();
    r.onload = () => {
      try {
        inputArea.value = r.result as string;
        if (mode === 'encode') {
          outputArea.value = btoa(unescape(encodeURIComponent(inputArea.value)));
        }
      } catch (err) {
        console.error("Base64 auto-process error:", err);
        if ((window as any).__showToast) {
          (window as any).__showToast({ message: 'Error processing base64 data.', variant: 'error' });
        }
      }
    };
    r.onerror = (err) => {
      console.error("File reading error:", err);
      if ((window as any).__showToast) {
        (window as any).__showToast({ message: 'Failed to read file.', variant: 'error' });
      }
    };
    r.readAsText(f);
  });
  function process() {
    const text = inputArea.value;
    if (!text) {
      outputArea.value = '';
      return;
    }
    try {
      if (mode === 'encode') {
        outputArea.value = btoa(unescape(encodeURIComponent(text)));
      } else {
        outputArea.value = decodeURIComponent(escape(atob(text.replace(/\s/g, ''))));
      }
    } catch {
      outputArea.value = 'Error: Invalid input for ' + (mode === 'encode' ? 'encoding' : 'decoding');
    }
  }
  inputArea.addEventListener('input', process);
  document.getElementById('download-btn')?.addEventListener('click', () => {
    if (!outputArea.value) return;
    const fmt = (document.getElementById('export-format') as HTMLSelectElement)?.value || 'txt';
    const mimes = { txt: 'text/plain', json: 'application/json', csv: 'text/csv', html: 'text/html' };
    const content = fmt === 'json' ? JSON.stringify(outputArea.value) : outputArea.value;
    const blob = new Blob([content], { type: mimes[fmt] || 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'base64-output.' + fmt;
    a.click();
    playPing();
    URL.revokeObjectURL(a.href);
  });
  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('output-area');
    const t = o?.value || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof (window as any).__showToast === 'function')
      (window as any).__showToast({ message: 'Link copied!', variant: 'success' });
  });
  const updateEditorFontSize = (newSize: number) => {
    const clamped = Math.max(10, Math.min(24, newSize));
    const lineHeight = Math.round(clamped * 1.7);
    document.querySelectorAll('textarea').forEach((t) => {
      t.style.fontSize = clamped + 'px';
      t.style.lineHeight = lineHeight + 'px';
    });
    const lineNums = document.getElementById('line-nums');
    if (lineNums) {
      lineNums.style.fontSize = clamped + 'px';
      lineNums.style.lineHeight = lineHeight + 'px';
    }
    try {
      localStorage.setItem('nt_fs', String(clamped));
    } catch (e) {}
  };

  document.querySelector('.font-inc')?.addEventListener('click', () => {
    const ta = document.getElementById('input-area');
    const s = parseInt(getComputedStyle(ta as HTMLElement).fontSize) || 14;
    updateEditorFontSize(s + 2);
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    const ta = document.getElementById('input-area');
    const s = parseInt(getComputedStyle(ta as HTMLElement).fontSize) || 14;
    updateEditorFontSize(s - 2);
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) updateEditorFontSize(parseInt(s));
  } catch (e) {}
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b = document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      document.getElementById('clear-btn')?.click();
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['base64']) b.textContent = 'Used ' + u['base64'] + '×';
  } catch (e) {}
  const rt = document.getElementById('input-area');
  if (rt) {
    rt.addEventListener('input', () => {
      const w = rt.value ? rt.value.trim().split(/\s+/).length : 0;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent =
          Math.max(1, Math.round(w / 200)) + ' min read · ' + Math.max(1, Math.round(w / 150)) + ' min speak';
    });
    rt.dispatchEvent(new Event('input'));
  }
  const li = document.getElementById('input-area');
  if (li) {
    const ul = () => {
      const n = document.getElementById('line-nums');
      if (n) n.textContent = Array.from({ length: li.value.split('\n').length }, (_, i) => i + 1).join('\n');
    };
    li.addEventListener('input', ul);
    li.addEventListener('scroll', () => {
      const n = document.getElementById('line-nums');
      if (n) n.scrollTop = li.scrollTop;
    });
    ul();
  }
  const lf = document.getElementById('input-area');
  if (lf) {
    lf.addEventListener('input', () => {
      const t = lf.value.toLowerCase().replace(/[^a-z]/g, '');
      if (!t) {
        document.getElementById('letter-freq')?.classList.add('hidden');
        return;
      }
      const f = {};
      for (const c of t) f[c] = (f[c] || 0) + 1;
      const s = Object.entries(f)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8);
      const m = s[0] ? s[0][1] : 1;
      const el = document.getElementById('letter-freq');
      el.classList.remove('hidden');
      el.innerHTML = s
        .map(
          ([c, n]) =>
            `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-xs font-mono"><strong class="text-green-400 uppercase">${c}</strong><span class="text-zinc-400">${n}</span></span>`,
        )
        .join('');
    });
  }
  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      document.querySelectorAll("button[class*='bg-green'],button[class*='bg-emerald']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(green|emerald)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(green|emerald)-\d+/g, 'hover:bg-' + c + '-500');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}
</script>
