---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'What is economy rate in cricket?',
    answer:
      'Economy rate is the average number of runs a bowler concedes per over bowled. It is calculated by dividing total runs conceded by total overs bowled.',
  },
  {
    question: 'How do fractional overs work in economy rate calculation?',
    answer:
      'In cricket, an over consists of 6 balls. A fractional over like 7.3 means 7 overs and 3 balls. For calculation, 3 balls is converted to 0.5 of an over (3/6 = 0.5), making it 7.5 overs total.',
  },
  {
    question: 'What is a good economy rate in cricket?',
    answer:
      'A good economy rate varies by format. In T20s, under 7 is excellent. In ODIs, under 5 is strong. In Tests, under 3 is exceptional. Lower economy rates indicate better bowling control.',
  },
];
const schema = {
  name: 'Economy Rate Calculator',
  applicationCategory: 'Sports',
  description:
    'Calculate cricket bowling economy rate instantly. Enter runs conceded and overs bowled to get your economy rate.',
  featureList: ['Cricket economy rate calculation', 'Fractional over support', 'Instant results', 'Free online tool'],
};
---

<MainLayout
  title="Economy Rate Calculator - Cricket Bowling Economy Calculator"
  description="Calculate cricket bowling economy rate instantly. Enter runs conceded and overs bowled to get your economy rate."
  keywords="economy rate calculator, cricket economy rate, bowling economy, cricket calculator"
  toolSchema={schema}
  faq={faqItems}
  howto={{
    name: 'How to Use Economy Rate Calculator',
    description: 'Step-by-step guide for using Economy Rate Calculator.',
    steps: [],
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Economy Rate Calculator', url: '/tools/economy-rate-calculator/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="Economy"
        gradient="Rate Pro"
        desc="Calculate cricket bowling economy rate instantly. Enter runs conceded and overs bowled to get your economy rate."
        badge="✦ New Tool"
        slug="economy-rate-calculator"
      />
      <ShareBar />
      <div class="max-w-xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6 relative">
          <button
            id="fullscreen-btn"
            class="absolute top-3 right-3 p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs"
            title="Fullscreen">⛶</button
          >
          <div class="flex items-center gap-2 mb-3">
            <span id="usage-badge" class="text-xs text-muted"></span>
            <div class="flex gap-1 ml-auto">
              <button
                class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                data-color="purple"
                style="background:#a855f7"></button>
              <button
                class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                data-color="blue"
                style="background:#3b82f6"></button>
              <button
                class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                data-color="green"
                style="background:#22c55e"></button>
              <button
                class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                data-color="pink"
                style="background:#ec4899"></button>
            </div>
          </div>
          <label class="block text-xs font-medium text-tertiary mb-1.5">Runs Conceded</label>
          <input
            id="runs-input"
            type="number"
            min="0"
            step="1"
            value="0"
            class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-amber-400/50 focus:outline-none transition-all mb-4"
            placeholder="e.g. 42"
          />
          <label class="block text-xs font-medium text-tertiary mb-1.5">Overs Bowled (e.g. 7.3)</label>
          <input
            id="overs-input"
            type="number"
            min="0"
            step="0.1"
            value="0"
            class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-amber-400/50 focus:outline-none transition-all mb-4"
            placeholder="e.g. 7.3"
          />
          <button
            id="calculate-btn"
            class="w-full bg-gradient-to-r from-amber-400 to-orange-500 text-black font-bold text-sm px-6 py-3 rounded-xl hover:opacity-90 transition-all"
            >Calculate Economy Rate</button
          >
          <div id="result" class="mt-6 pt-6 border-t border-surface hidden">
            <div class="grid grid-cols-3 gap-4 text-center">
              <div>
                <div class="text-2xl font-black text-amber-400" id="economy-rate">0.00</div><div
                  class="text-xs text-tertiary mt-1"
                >
                  Economy Rate
                </div>
              </div>
              <div>
                <div class="text-2xl font-black text-white" id="total-runs">0</div><div
                  class="text-xs text-tertiary mt-1"
                >
                  Total Runs
                </div>
              </div>
              <div>
                <div class="text-2xl font-black text-white" id="total-overs">0.0</div><div
                  class="text-xs text-tertiary mt-1"
                >
                  Total Overs
                </div>
              </div>
            </div>
            <div class="flex items-center justify-center gap-2 mt-4">
              <button
                id="share-btn"
                class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
                title="Share">🔗</button
              >
              <button
                id="copy-btn"
                class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
                >Copy</button
              >
              <button
                id="download-btn"
                class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
                >Download</button
              >
              <button
                id="clear-btn"
                class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
                >Clear</button
              >
            </div>
          </div>
        </div>
      </div>
      <section class="mt-20 max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider">Learn</span><h2
            class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1"
          >
            Understanding <span class="bg-gradient-to-r from-amber-400 to-orange-500 bg-clip-text text-transparent"
              >Economy Rate</span
            >
          </h2>
        </div><div class="space-y-4 text-sm text-tertiary leading-relaxed">
          <p>
            Economy rate is a key bowling statistic in cricket that measures how many runs a bowler concedes per over.
            It is calculated by dividing total runs conceded by total overs bowled, where fractional overs are converted
            to their decimal equivalent. A lower economy rate indicates better bowling performance and control. This
            metric is especially important in limited-overs formats where run containment is crucial.
          </p>
        </div>
      </section>
      <RelatedTools current="economy-rate-calculator" />
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span class="bg-gradient-to-r from-amber-400 to-orange-500 bg-clip-text text-transparent"
            >Questions</span
          >
        </h2><Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>
<script>
  const runsInput = document.getElementById('runs-input');
  const oversInput = document.getElementById('overs-input');
  const calculateBtn = document.getElementById('calculate-btn');
  const resultDiv = document.getElementById('result');
  const economyRate = document.getElementById('economy-rate');
  const totalRuns = document.getElementById('total-runs');
  const totalOvers = document.getElementById('total-overs');

  function fractionalOversToDecimal(overs) {
    const whole = Math.floor(overs);
    const frac = Math.round((overs - whole) * 10);
    const balls = frac > 6 ? frac - 6 : frac;
    const actualOvers = balls > 6 ? whole + 1 : whole;
    const actualBalls = balls > 6 ? balls - 6 : balls;
    return actualOvers + actualBalls / 6;
  }

  calculateBtn.addEventListener('click', () => {
    const runs = parseFloat(runsInput.value) || 0;
    const oversRaw = parseFloat(oversInput.value) || 0;
    const oversDecimal = fractionalOversToDecimal(oversRaw);
    const rate = oversDecimal > 0 ? runs / oversDecimal : 0;

    const whole = Math.floor(oversRaw);
    const frac = Math.round((oversRaw - whole) * 10);
    const ballsPart = frac > 6 ? frac - 6 : frac;

    economyRate.textContent = rate.toFixed(2);
    totalRuns.textContent = runs;
    totalOvers.textContent = whole + '.' + ballsPart;
    resultDiv.classList.remove('hidden');
  });

  // ─── Copy ───
  document.getElementById('copy-btn')?.addEventListener('click', () => {
    const text = `Economy Rate: ${economyRate.textContent} | Runs: ${totalRuns.textContent} | Overs: ${totalOvers.textContent}`;
    if (!text) return;
    navigator.clipboard.writeText(text).catch(() => {});
    const btn = document.getElementById('copy-btn');
    btn.textContent = 'Copied!';
    setTimeout(() => {
      btn.textContent = 'Copy';
    }, 2000);
  });

  // ─── Download ───
  document.getElementById('download-btn')?.addEventListener('click', () => {
    const content = `Economy Rate: ${economyRate.textContent}\nRuns Conceded: ${totalRuns.textContent}\nOvers Bowled: ${totalOvers.textContent}`;
    if (!content) return;
    const blob = new Blob([content], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'economy-rate-results.txt';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // ─── Clear ───
  document.getElementById('clear-btn')?.addEventListener('click', () => {
    runsInput.value = '0';
    oversInput.value = '0';
    resultDiv.classList.add('hidden');
  });

  // ─── Fullscreen ───
  document.getElementById('fullscreen-btn')?.addEventListener('click', () => {
    const card = document.getElementById('fullscreen-btn').closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
      document.getElementById('fullscreen-btn').textContent = '⛶';
    } else {
      card.requestFullscreen?.() || card.webkitRequestFullscreen?.();
      document.getElementById('fullscreen-btn').textContent = '✕';
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const btn = document.getElementById('fullscreen-btn');
    if (btn) btn.textContent = document.fullscreenElement ? '✕' : '⛶';
  });

  // ─── Keyboard shortcuts ───
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b = document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      document.getElementById('clear-btn')?.click();
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });

  // ─── Usage badge ───
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['economy-rate-calculator']) b.textContent = 'Used ' + u['economy-rate-calculator'] + '×';
  } catch (e) {}

  // ─── Share button ───
  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('output-text') || document.querySelector("[id$='result']");
    const t = o?.value || o?.textContent || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof showToast === 'function') showToast('Link copied!');
  });

  // ─── Sound effects ───
  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }

  // ─── Color theme picker ───
  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      document.querySelectorAll("button[class*='bg-purple'],button[class*='bg-violet']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(purple|violet)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(purple|violet)-\d+/g, 'hover:bg-' + c + '-500');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}
</script>
