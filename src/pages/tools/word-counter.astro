          </div>
          <div class="flex">
            <div id="line-nums" class="text-xs text-muted text-right pr-2 select-none overflow-hidden font-mono leading-relaxed pt-3" style="min-width:2.5em">1</div>
            <textarea id="analyzer-input" rows="10" placeholder="Start typing or paste your text here…" class="flex-1 bg-transparent text-white placeholder-zinc-600 p-5 pb-16 resize-none focus:outline-none text-sm leading-relaxed"></textarea>
          </div>
          <div id="reading-time" class="text-xs text-muted px-5 -mt-2"></div>
          <div id="letter-freq" class="px-5 mt-2 space-y-0.5 max-h-24 overflow-y-auto hidden"></div>
          <div class="absolute bottom-3 right-3 flex items-center gap-2">
            <select id="export-format" class="bg-surface-2 border border-surface text-[10px] text-tertiary rounded-lg px-2 py-1.5">
              <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option><option value="html">HTML</option>
            </select>
            <button id="clear-btn" class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-[10px] font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all">Clear</button>
            <button id="share-btn" class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-[10px] font-medium px-2.5 py-1.5 rounded-lg border border-surface-3 transition-all" title="Copy share link">🔗</button>
            <button id="copy-btn" class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-[10px] font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all">Copy</button>
            <button id="download-txt" class="bg-purple-600/20 hover:bg-purple-600 text-purple-300 hover:text-white text-[10px] font-medium px-3 py-1.5 rounded-lg border border-purple-500/30 transition-all">Download TXT</button>
          </div>
        </div>

        <!-- ─── Readability Meter ─── -->
        <div id="readability-card" class="bg-surface-1 border border-surface rounded-xl p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <span class="text-sm leading-none">🎯</span>
              <span class="text-xs font-semibold text-secondary uppercase tracking-wider">Readability Score</span>
            </div>
            <span id="readability" class="text-xs font-bold text-tertiary">—</span>
          </div>
          <div class="h-1.5 rounded-full bg-zinc-800 overflow-hidden">
            <div id="readability-bar" class="h-full rounded-full transition-all duration-500 ease-out" style="width:0%"></div>
          </div>
          <div class="flex justify-between text-[9px] text-dim mt-1.5">
            <span>Complex</span>
            <span>Fair</span>
            <span>Easy</span>
          </div>
        </div>

        <!-- ─── Analysis Grid ─── -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <!-- Keyword Density Panel -->
          <div id="keyword-panel" class="bg-surface-1 border border-surface rounded-xl p-4 min-h-[140px]">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <span class="text-sm leading-none">📊</span>
                <span class="text-xs font-semibold text-secondary uppercase tracking-wider">Keyword Density</span>
              </div>
              <span class="text-[9px] text-muted">Top 10</span>
            </div>
            <div id="keyword-list" class="flex flex-wrap gap-1.5"></div>
            <p id="keyword-empty" class="text-xs text-dim text-center py-6 hidden">Start typing to see keyword analysis…</p>
          </div>

          <!-- Text Stats Panel -->
          <div class="bg-surface-1 border border-surface rounded-xl p-4">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-sm leading-none">📋</span>
              <span class="text-xs font-semibold text-secondary uppercase tracking-wider">Text Analysis</span>
            </div>
            <div class="grid grid-cols-2 gap-2.5">
              <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center">
                <span id="avg-word-len" class="block text-lg font-bold text-secondary tabular-nums">—</span>
                <span class="text-[9px] text-dim font-medium">Avg Word Len</span>
              </div>
              <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center">
                <span id="longest-word" class="block text-lg font-bold text-secondary truncate">—</span>
                <span class="text-[9px] text-dim font-medium">Longest Word</span>
              </div>
              <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center">
                <span id="unique-words" class="block text-lg font-bold text-secondary tabular-nums">0</span>
                <span class="text-[9px] text-dim font-medium">Unique Words</span>
              </div>
              <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center">
                <span id="speak-time" class="block text-lg font-bold text-secondary tabular-nums">0m</span>
                <span class="text-[9px] text-dim font-medium">Speak Time</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ─── What is a Word Counter? ─── -->
      <section class="mt-20 max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Learn</span>
          <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">
            What is a
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Word Counter?</span>
          </h2>
        </div>
        <div class="space-y-4 text-sm text-tertiary leading-relaxed">
          <p>A <strong class="text-primary">word counter</strong> is a tool that automatically counts the number of words, characters, sentences, and paragraphs in a given text. It provides instant feedback on your writing length and structure, helping you stay within limits for essays, articles, social media posts, or SEO content.</p>
          <p>Modern word counters go beyond simple counts. They analyze <strong class="text-primary">keyword density</strong> to show which words you use most, estimate <strong class="text-primary">reading and speaking times</strong> so you can pace your content, and calculate <strong class="text-primary">readability scores</strong> to determine how easy your text is to understand.</p>
          <p>Writers, students, editors, SEO professionals, and content creators use word counters daily to polish their work and meet platform-specific requirements — from Twitter's 280-character limit to blog posts targeting 1,500+ words.</p>
        </div>
      </section>

      <!-- ─── How to Improve Writing Tips ─── -->
      <section class="mt-20 max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Pro Tips</span>
          <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">
            How to Improve
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Your Writing</span>
          </h2>
        </div>
        <div class="space-y-4">
          <div class="flex gap-4 p-4 rounded-xl border border-surface bg-zinc-900/20">
            <span class="w-8 h-8 rounded-lg bg-purple-600/15 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0">1</span>
            <div>
              <h3 class="text-sm font-semibold text-primary">Vary Your Sentence Length</h3>
              <p class="text-xs text-muted mt-1 leading-relaxed">Mix short, punchy sentences with longer, detailed ones. This creates rhythm and keeps readers engaged. The readability meter helps you spot if your text feels too dense or too choppy.</p>
            </div>
          </div>
          <div class="flex gap-4 p-4 rounded-xl border border-surface bg-zinc-900/20">
            <span class="w-8 h-8 rounded-lg bg-purple-600/15 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0">2</span>
            <div>
              <h3 class="text-sm font-semibold text-primary">Watch Your Keyword Density</h3>
              <p class="text-xs text-muted mt-1 leading-relaxed">Overusing the same word makes writing feel repetitive. Aim for keyword density between 1–3%. Use the density panel to spot overused words and swap in synonyms for a natural flow.</p>
            </div>
          </div>
          <div class="flex gap-4 p-4 rounded-xl border border-surface bg-zinc-900/20">
            <span class="w-8 h-8 rounded-lg bg-purple-600/15 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0">3</span>
            <div>
              <h3 class="text-sm font-semibold text-primary">Shorten Long Sentences</h3>
              <p class="text-xs text-muted mt-1 leading-relaxed">Sentences over 30 words can confuse readers. If your average word length is high or readability is low, break long sentences into shorter, clearer ones. Your average word length should ideally stay under 6 characters.</p>
            </div>
          </div>
          <div class="flex gap-4 p-4 rounded-xl border border-surface bg-zinc-900/20">
            <span class="w-8 h-8 rounded-lg bg-purple-600/15 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0">4</span>
            <div>
              <h3 class="text-sm font-semibold text-primary">Use Active Voice</h3>
              <p class="text-xs text-muted mt-1 leading-relaxed">Active voice makes your writing direct and energetic. Instead of "The ball was hit by him," write "He hit the ball." The word counter helps you track total words as you revise for clarity.</p>
            </div>
          </div>
          <div class="flex gap-4 p-4 rounded-xl border border-surface bg-zinc-900/20">
            <span class="w-8 h-8 rounded-lg bg-purple-600/15 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0">5</span>
            <div>
              <h3 class="text-sm font-semibold text-primary">Edit for Conciseness</h3>
              <p class="text-xs text-muted mt-1 leading-relaxed">Cut unnecessary words like "very," "really," "that," and "just." Every word should earn its place. Use the character count to see how trimming affects your total — shorter is often stronger.</p>
            </div>
          </div>
        </div>
      </section>

      <KeyboardHints hints={[
        { keys: "⌘K", label: "Open search" },
        { keys: "Ctrl+A", label: "Select all" },
        { keys: "Ctrl+Z", label: "Undo" },
      ]} />

      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} />
      </div>

      <ToolContentSections
        toolSlug="word-counter"
        toolName="Word Counter"
        category="Utility Tools"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />

      <!-- ─── CTA Section ─── -->
      <section class="mt-16 text-center">
        <div class="max-w-2xl mx-auto bg-gradient-to-br from-purple-600/10 to-blue-600/5 border border-purple-500/20 rounded-2xl p-8 md:p-10">
          <h2 class="text-2xl md:text-3xl font-black tracking-tight">
            Start Analyzing
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent"> Your Text Free</span>
          </h2>
          <p class="text-tertiary mt-3 max-w-lg mx-auto text-sm leading-relaxed">
            No sign-up required. No limits. Analyze unlimited text with word count, keyword density, and readability scoring completely free.
          </p>
          <div class="mt-6 flex gap-3 justify-center flex-wrap">
            <button onclick="document.querySelector('#analyzer-input')?.focus()" class="px-6 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm transition-all active:scale-[0.97] shadow-lg shadow-purple-900/30">
              Start Analyzing
            </button>
            <a href="/tools/age-calculator/" class="px-6 py-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-semibold text-sm transition-all border border-zinc-700">
              Try Age Calculator
            </a>
          </div>
        </div>
      </section>

      <RelatedTools current="word-counter" />
    </div>
  </main>
</MainLayout>

<script>
  function playPing(){ try{const a=new(window.AudioContext||window.webkitAudioContext)();const o=a.createOscillator();const g=a.createGain();o.connect(g);g.connect(a.destination);o.frequency.value=800;g.gain.setValueAtTime(0.08,a.currentTime);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+0.12);o.start();o.stop(a.currentTime+0.12);}catch(e){} }
  const textarea = document.getElementById("analyzer-input");
  const $ = (id) => document.getElementById(id);
  const wordCount = $("word-count");
  const charCount = $("char-count");
  const charNs = $("char-ns");
  const sentenceCount = $("sentence-count");
  const paragraphCount = $("paragraph-count");
  const readTime = $("read-time");
  const speakTime = $("speak-time");
  const readability = $("readability");
  const readabilityBar = $("readability-bar");
  const avgWordLen = $("avg-word-len");
  const longestWord = $("longest-word");
  const uniqueWords = $("unique-words");
  const keywordPanel = $("keyword-panel");
  const keywordList = $("keyword-list");
  const keywordEmpty = $("keyword-empty");
  const copyBtn = $("copy-btn");
  const clearBtn = $("clear-btn");
  const downloadBtn = $("download-txt");

  function syllableCount(word) {
    word = word.toLowerCase().replace(/[^a-z]/g, "");
    if (!word.length) return 0;
    let count = 0, prevVowel = false;
    const vowels = "aeiouy";
    for (const ch of word) {
      const isVowel = vowels.includes(ch);
      if (isVowel && !prevVowel) count++;
      prevVowel = isVowel;
    }
    return count || 1;
  }

  function updateStats() {
    const text = textarea.value;
    const words = text.trim() ? text.trim().split(/\s+/).filter(w => w.length > 0) : [];
    const wc = words.length;
    const cc = text.length;
    const cns = text.replace(/\s/g, "").length;
    const sc = text.split(/[.!?]+/).filter(s => s.trim().length > 0).length;
    const pc = text.split(/\n+/).filter(p => p.trim().length > 0).length;

    wordCount.textContent = wc;
    charCount.textContent = cc;
    charNs.textContent = cns;
    sentenceCount.textContent = sc;
    paragraphCount.textContent = pc;
    readTime.textContent = wc > 0 ? (Math.ceil(wc / 200) + "m") : "0m";
    speakTime.textContent = wc > 0 ? (Math.ceil(wc / 150) + "m") : "0m";

    // Readability
    if (wc > 0 && sc > 0) {
      const syllables = words.reduce((s, w) => s + syllableCount(w), 0);
      const score = Math.max(0, Math.min(100, Math.round(206.835 - 1.015 * (wc / sc) - 84.6 * (syllables / wc))));
      let label, color, barColor;
      if (score >= 70) { label = "Easy"; color = "text-emerald-400"; barColor = "bg-emerald-500"; }
      else if (score >= 50) { label = "Fair"; color = "text-lime-400"; barColor = "bg-lime-500"; }
      else if (score >= 30) { label = "Hard"; color = "text-yellow-400"; barColor = "bg-yellow-500"; }
      else { label = "Complex"; color = "text-red-400"; barColor = "bg-red-500"; }
      readability.textContent = `${score} — ${label}`;
      readability.className = `text-xs font-bold ${color}`;
      readabilityBar.style.width = score + "%";
      readabilityBar.className = `h-full rounded-full transition-all duration-500 ease-out ${barColor}`;
    } else {
      readability.textContent = "—";
      readability.className = "text-xs font-bold text-tertiary";
      readabilityBar.style.width = "0%";
    }

    // Advanced stats
    if (wc > 0) {
      avgWordLen.textContent = (cns / wc).toFixed(1);
      longestWord.textContent = words.reduce((a, b) => a.length >= b.length ? a : b).substring(0, 18);
      uniqueWords.textContent = new Set(words.map(w => w.toLowerCase())).size;
    } else {
      avgWordLen.textContent = "—";
      longestWord.textContent = "—";
      uniqueWords.textContent = "0";
    }

    // Keyword Density
    if (wc > 0) {
      const freq = {};
      words.forEach(w => { const k = w.toLowerCase().replace(/[^a-z]/g, ""); if (k.length > 2) freq[k] = (freq[k] || 0) + 1; });
      const sorted = Object.entries(freq).sort((a, b) => b[1] - a[1]).slice(0, 10);
      if (sorted.length > 0) {
        keywordEmpty?.classList.add("hidden");
        keywordList.innerHTML = sorted.map(([word, count]) => {
          const pct = ((count / wc) * 100).toFixed(1);
          const barW = Math.min(parseFloat(pct) * 20, 100);
          return `<span class="flex items-center gap-1.5 px-2 py-1 rounded-lg bg-surface-1 border border-zinc-700/50 text-[10px] text-secondary">
            <span class="font-medium">${word}</span>
            <span class="text-purple-400 font-bold">${pct}%</span>
            <span class="w-8 h-1 rounded-full bg-zinc-700 overflow-hidden"><span class="block h-full rounded-full bg-purple-500" style="width:${barW}%"></span></span>
          </span>`;
        }).join("");
      } else {
        keywordEmpty?.classList.remove("hidden");
        keywordList.innerHTML = "";
      }
    } else {
      keywordEmpty?.classList.remove("hidden");
      keywordList.innerHTML = "";
    }
  }

  textarea.addEventListener("input", () => {
    updateStats();
    try { localStorage.setItem("nt_wc_text", textarea.value); } catch {}
  });

  // Restore saved text
  try {
    const saved = localStorage.getItem("nt_wc_text");
    if (saved) { textarea.value = saved; }
  } catch {}
  updateStats();

  clearBtn.addEventListener("click", () => {
    textarea.value = "";
    updateStats();
    textarea.focus();
    try { localStorage.removeItem("nt_wc_text"); } catch {}
    playPing(); triggerToast("Text cleared", "info");
  });

  function triggerToast(message: string, variant: "success" | "error" | "info" | "warning" = "success") {
    if ((window as any).__showToast) {
      (window as any).__showToast({ message, variant });
    }
  }

  copyBtn.addEventListener("click", async () => {
    if (!textarea.value.trim()) { triggerToast("Nothing to copy!", "warning"); return; }
    await navigator.clipboard.writeText(textarea.value);
    playPing(); triggerToast("Text copied to clipboard!", "success");
  });

  downloadBtn.addEventListener("click", () => {
    const outputText = textarea.value;
    const fmt=(document.getElementById("export-format") as HTMLSelectElement)?.value||"txt";
    let content = outputText;
    let mime = "text/plain";
    let ext = "txt";
    if(fmt==="json"){ content=JSON.stringify({result:outputText, tool:"word-counter", timestamp:new Date().toISOString()}); mime="application/json"; ext="json"; }
    if(fmt==="csv"){ content="Result\n\""+outputText.replace(/"/g,'""')+"\""; mime="text/csv"; ext="csv"; }
    if(fmt==="html"){ content="<!DOCTYPE html><html><body><pre>"+outputText.replace(/</g,"&lt;")+"</pre></body></html>"; mime="text/html"; ext="html"; }
    const blob = new Blob([content], { type: mime });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "numanx-word-count."+ext;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    playPing(); triggerToast("Downloaded!", "success");
  });

  document.getElementById("fullscreen-btn")?.addEventListener("click", () => {
    const card = document.getElementById("fullscreen-btn").closest(".bg-surface-1.border.border-surface.rounded-2xl") || document.getElementById("fullscreen-btn").closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
      document.getElementById("fullscreen-btn").textContent = "⛶";
    } else {
      card.requestFullscreen?.() || card.webkitRequestFullscreen?.();
      document.getElementById("fullscreen-btn").textContent = "✕";
    }
  });
  document.addEventListener("fullscreenchange", () => {
    const btn = document.getElementById("fullscreen-btn");
    if (btn) btn.textContent = document.fullscreenElement ? "✕" : "⛶";
  });

  const DRAFT_KEY = "nt_draft_word-counter";
  (function() {
    const input = document.getElementById("input-text") || document.querySelector("textarea:not([readonly])");
    if (!input) return;
    try {
      const saved = localStorage.getItem(DRAFT_KEY);
      if (saved && !input.value) { input.value = saved; input.dispatchEvent(new Event("input")); }
    } catch(e) {}
    let saveTimer;
    input.addEventListener("input", () => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        try { localStorage.setItem(DRAFT_KEY, input.value); } catch(e) {}
      }, 500);
    });
  })();

  document.querySelector(".font-inc")?.addEventListener("click", () => { document.querySelectorAll("textarea").forEach(t => { let s=parseInt(getComputedStyle(t).fontSize); t.style.fontSize=Math.min(24,s+2)+"px"; }); });
  document.querySelector(".font-dec")?.addEventListener("click", () => { document.querySelectorAll("textarea").forEach(t => { let s=parseInt(getComputedStyle(t).fontSize); t.style.fontSize=Math.max(10,s-2)+"px"; }); });
  try { const s=localStorage.getItem("nt_fs"); if(s) document.querySelectorAll("textarea").forEach(t=>t.style.fontSize=s+"px"); } catch(e){}

  document.addEventListener("keydown", e => {
    if(e.ctrlKey&&e.key==="Enter"){ e.preventDefault(); const b=document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])")||document.querySelector("button[class*='bg-']:not([id*='full']):not([id*='paste'])"); if(b) b.click(); }
    if(e.ctrlKey&&e.shiftKey&&(e.key==="C"||e.key==="c")){ e.preventDefault(); document.getElementById("clear-btn")?.click(); }
    if(e.ctrlKey&&(e.key==="D"||e.key==="d")){ e.preventDefault(); document.getElementById("download-txt")?.click(); }
  });

  try { const u=JSON.parse(localStorage.getItem("nt_tool_usage")||"{}"); const b=document.getElementById("usage-badge"); if(b&&u["word-counter"]) b.textContent="Used "+u["word-counter"]+"×"; } catch(e){}

  document.getElementById("share-btn")?.addEventListener("click", () => {
    const o=document.getElementById("analyzer-input")||document.querySelector("[id$='result']");
    const t=o?.value||o?.textContent||"";
    if(!t) return;
    const u=window.location.origin+window.location.pathname+"#result="+encodeURIComponent(t.substring(0,200));
    navigator.clipboard.writeText(u).catch(()=>{});
    if(typeof triggerToast==="function") triggerToast("Link copied!");
  });

  const rtInput=document.getElementById("analyzer-input")||document.querySelector("textarea:not([readonly])");
  if(rtInput){
    rtInput.addEventListener("input", ()=>{
      const w=rtInput.value?rtInput.value.trim().split(/\s+/).length:0;
      const e=document.getElementById("reading-time");
      if(e) e.textContent=Math.max(1,Math.round(w/200))+" min read · "+Math.max(1,Math.round(w/150))+" min speak";
    });
    rtInput.dispatchEvent(new Event("input"));
  }

  const lnInput=document.getElementById("analyzer-input");
  if(lnInput){
    const updateLN=()=>{ const n=document.getElementById("line-nums"); if(n) n.textContent=Array.from({length:lnInput.value.split("\n").length},(_,i)=>i+1).join("\n"); };
    lnInput.addEventListener("input", updateLN);
    lnInput.addEventListener("scroll", ()=>{ const n=document.getElementById("line-nums"); if(n) n.scrollTop=lnInput.scrollTop; });
    updateLN();
  }

  const lfInput=document.getElementById("analyzer-input");
  if(lfInput){
    lfInput.addEventListener("input", ()=>{
      const t=lfInput.value.toLowerCase().replace(/[^a-z]/g,""); if(!t){ document.getElementById("letter-freq").classList.add("hidden"); return; }
      const f={}; for(const c of t) f[c]=(f[c]||0)+1;
      const s=Object.entries(f).sort((a,b)=>b[1]-a[1]).slice(0,8); const m=s[0]?s[0][1]:1;
      const el=document.getElementById("letter-freq"); el.classList.remove("hidden");
      el.innerHTML=s.map(([c,n])=>`<div class="flex items-center gap-1.5 text-xs"><span class="w-3 text-center font-mono text-white">${c}</span><div class="h-2 rounded-full bg-purple-500/50" style="width:${(n/m)*80+10}%"></div><span class="text-muted">${n}</span></div>`).join("");
    });
  }

  document.querySelectorAll(".theme-swatch").forEach(s=>{
    s.addEventListener("click",()=>{
      const c=s.dataset.color; const map={purple:"#a855f7",blue:"#3b82f6",green:"#22c55e",pink:"#ec4899",orange:"#f97316"};
      document.querySelectorAll("button[class*='bg-purple'], button[class*='bg-violet']").forEach(b=>{ b.className=b.className.replace(/bg-(purple|violet)-\d+/g,"bg-"+c+"-600").replace(/hover:bg-(purple|violet)-\d+/g,"hover:bg-"+c+"-500").replace(/from-(purple|violet)-\d+/g,"from-"+c+"-500").replace(/to-purple-\d+/g,"to-"+c+"-600"); });
      try{localStorage.setItem("nt_theme",c);}catch(e){}
    });
  });
  try{const c=localStorage.getItem("nt_theme");if(c)document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();}catch(e){}
</script>

