---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";
import KeyboardHints from "../../components/KeyboardHints.astro";

const faqItems = [
  { question: "How do I count words in a text?", answer: "Simply type or paste your text into the text area above. The word count, character count, and other stats update instantly as you type. No button clicking required." },
  { question: "How is reading time calculated?", answer: "Reading time is estimated using the average reading speed of 200 words per minute. We divide the total word count by 200 and round up. For texts under 200 words, it shows '<1 min'." },
  { question: "What counts as a word?", answer: "A word is any sequence of characters separated by spaces or line breaks. Hyphenated words count as one word. Numbers and symbols are also counted as words when separated by spaces." },
  { question: "Does it count characters with or without spaces?", answer: "We show both! Total characters includes spaces, and characters without spaces excludes them. Many platforms count spaces in their character limits." },
  { question: "What is keyword density?", answer: "Keyword density shows how frequently a word appears in your text as a percentage of total words. It helps with SEO optimization — a healthy density is typically 1-3%." },
];

const wcSchema = {
  "name": "Word Counter Pro",
  "applicationCategory": "Utilities",
  "description": "Count words, characters, sentences, and paragraphs. Analyze keyword density, reading time, and speaking time.",
  "featureList": [
    "Real-time word, character, sentence, and paragraph count",
    "Keyword density analysis for SEO optimization",
    "Reading time and speaking time estimation",
    "Live character count with and without spaces",
    "Privacy-first — all processing stays in your browser"
  ],
}
---

<MainLayout
  title="Word Counter - Free Online Word & Character Counter"
  description="Count words, characters, sentences, paragraphs, reading time, and keyword density. Free online text analyzer with live stats."
  keywords="word counter, character counter, sentence counter, paragraph counter, reading time, keyword density"
  toolSchema={wcSchema}
  faq={faqItems}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Tools", url: "/tools/" },
    { name: "Word Counter", url: "/tools/word-counter/" },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-5xl mx-auto">

      <ToolHeader
        title="Word Counter"
        gradient="Analytics Pro"
        desc="Count words, characters, sentences, and paragraphs. Analyze keyword density, reading time, and speaking time — live as you type."
        badge="🆕 Pro Version"
        slug="word-counter"
      />

      <ShareBar />

      <!-- ─── Dashboard ─── -->
      <div class="max-w-3xl mx-auto mt-10 space-y-5">

        <!-- Stats Bar — Grammarly-style compact row -->
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-2.5" id="stats-bar">
          <div class="stat-card group bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="word-count" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-500">Words</span>
          </div>
          <div class="stat-card group bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="char-count" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-500">Chars</span>
          </div>
          <div class="stat-card group bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="char-ns" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-500">No Spaces</span>
          </div>
          <div class="stat-card group bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="sentence-count" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-500">Sentences</span>
          </div>
          <div class="stat-card group bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="paragraph-count" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-500">Paragraphs</span>
          </div>
          <div class="stat-card group bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="read-time" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0m</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-500">Read Time</span>
          </div>
        </div>

        <!-- Text Area — Notion x ChatGPT style -->
        <div class="relative rounded-2xl border border-white/[0.08] bg-white/[0.02] focus-within:border-purple-500/60 focus-within:shadow-[0_0_20px_-8px_#a855f7] transition-all duration-300 overflow-hidden">
          <textarea id="analyzer-input" rows="10" placeholder="Start typing or paste your text here…" class="w-full bg-transparent text-white placeholder-zinc-600 p-5 pb-16 resize-none focus:outline-none text-sm leading-relaxed"></textarea>
          <div class="absolute bottom-3 right-3 flex items-center gap-2">
            <button id="clear-btn" class="bg-white/[0.04] hover:bg-zinc-700 text-zinc-400 hover:text-zinc-200 text-[10px] font-medium px-3 py-1.5 rounded-lg border border-white/[0.1] transition-all">Clear</button>
            <button id="copy-btn" class="bg-white/[0.04] hover:bg-zinc-700 text-zinc-400 hover:text-zinc-200 text-[10px] font-medium px-3 py-1.5 rounded-lg border border-white/[0.1] transition-all">Copy</button>
            <button id="download-txt" class="bg-purple-600/20 hover:bg-purple-600 text-purple-300 hover:text-white text-[10px] font-medium px-3 py-1.5 rounded-lg border border-purple-500/30 transition-all">Download TXT</button>
          </div>
        </div>

        <!-- ─── Readability Meter ─── -->
        <div id="readability-card" class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <span class="text-sm leading-none">🎯</span>
              <span class="text-xs font-semibold text-zinc-300 uppercase tracking-wider">Readability Score</span>
            </div>
            <span id="readability" class="text-xs font-bold text-zinc-400">—</span>
          </div>
          <div class="h-1.5 rounded-full bg-zinc-800 overflow-hidden">
            <div id="readability-bar" class="h-full rounded-full transition-all duration-500 ease-out" style="width:0%"></div>
          </div>
          <div class="flex justify-between text-[9px] text-zinc-600 mt-1.5">
            <span>Complex</span>
            <span>Fair</span>
            <span>Easy</span>
          </div>
        </div>

        <!-- ─── Analysis Grid ─── -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <!-- Keyword Density Panel -->
          <div id="keyword-panel" class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-4 min-h-[140px]">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <span class="text-sm leading-none">📊</span>
                <span class="text-xs font-semibold text-zinc-300 uppercase tracking-wider">Keyword Density</span>
              </div>
              <span class="text-[9px] text-zinc-500">Top 10</span>
            </div>
            <div id="keyword-list" class="flex flex-wrap gap-1.5"></div>
            <p id="keyword-empty" class="text-xs text-zinc-600 text-center py-6 hidden">Start typing to see keyword analysis…</p>
          </div>

          <!-- Text Stats Panel -->
          <div class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-4">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-sm leading-none">📋</span>
              <span class="text-xs font-semibold text-zinc-300 uppercase tracking-wider">Text Analysis</span>
            </div>
            <div class="grid grid-cols-2 gap-2.5">
              <div class="bg-white/[0.03] border border-white/[0.04] rounded-lg p-3 text-center">
                <span id="avg-word-len" class="block text-lg font-bold text-zinc-300 tabular-nums">—</span>
                <span class="text-[9px] text-zinc-600 font-medium">Avg Word Len</span>
              </div>
              <div class="bg-white/[0.03] border border-white/[0.04] rounded-lg p-3 text-center">
                <span id="longest-word" class="block text-lg font-bold text-zinc-300 truncate">—</span>
                <span class="text-[9px] text-zinc-600 font-medium">Longest Word</span>
              </div>
              <div class="bg-white/[0.03] border border-white/[0.04] rounded-lg p-3 text-center">
                <span id="unique-words" class="block text-lg font-bold text-zinc-300 tabular-nums">0</span>
                <span class="text-[9px] text-zinc-600 font-medium">Unique Words</span>
              </div>
              <div class="bg-white/[0.03] border border-white/[0.04] rounded-lg p-3 text-center">
                <span id="speak-time" class="block text-lg font-bold text-zinc-300 tabular-nums">0m</span>
                <span class="text-[9px] text-zinc-600 font-medium">Speak Time</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ─── What is a Word Counter? ─── -->
      <section class="mt-20 max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Learn</span>
          <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">
            What is a
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Word Counter?</span>
          </h2>
        </div>
        <div class="space-y-4 text-sm text-zinc-400 leading-relaxed">
          <p>A <strong class="text-zinc-200">word counter</strong> is a tool that automatically counts the number of words, characters, sentences, and paragraphs in a given text. It provides instant feedback on your writing length and structure, helping you stay within limits for essays, articles, social media posts, or SEO content.</p>
          <p>Modern word counters go beyond simple counts. They analyze <strong class="text-zinc-200">keyword density</strong> to show which words you use most, estimate <strong class="text-zinc-200">reading and speaking times</strong> so you can pace your content, and calculate <strong class="text-zinc-200">readability scores</strong> to determine how easy your text is to understand.</p>
          <p>Writers, students, editors, SEO professionals, and content creators use word counters daily to polish their work and meet platform-specific requirements — from Twitter's 280-character limit to blog posts targeting 1,500+ words.</p>
        </div>
      </section>

      <!-- ─── How to Improve Writing Tips ─── -->
      <section class="mt-20 max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Pro Tips</span>
          <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">
            How to Improve
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Your Writing</span>
          </h2>
        </div>
        <div class="space-y-4">
          <div class="flex gap-4 p-4 rounded-xl border border-white/[0.06] bg-zinc-900/20">
            <span class="w-8 h-8 rounded-lg bg-purple-600/15 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0">1</span>
            <div>
              <h3 class="text-sm font-semibold text-zinc-200">Vary Your Sentence Length</h3>
              <p class="text-xs text-zinc-500 mt-1 leading-relaxed">Mix short, punchy sentences with longer, detailed ones. This creates rhythm and keeps readers engaged. The readability meter helps you spot if your text feels too dense or too choppy.</p>
            </div>
          </div>
          <div class="flex gap-4 p-4 rounded-xl border border-white/[0.06] bg-zinc-900/20">
            <span class="w-8 h-8 rounded-lg bg-purple-600/15 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0">2</span>
            <div>
              <h3 class="text-sm font-semibold text-zinc-200">Watch Your Keyword Density</h3>
              <p class="text-xs text-zinc-500 mt-1 leading-relaxed">Overusing the same word makes writing feel repetitive. Aim for keyword density between 1–3%. Use the density panel to spot overused words and swap in synonyms for a natural flow.</p>
            </div>
          </div>
          <div class="flex gap-4 p-4 rounded-xl border border-white/[0.06] bg-zinc-900/20">
            <span class="w-8 h-8 rounded-lg bg-purple-600/15 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0">3</span>
            <div>
              <h3 class="text-sm font-semibold text-zinc-200">Shorten Long Sentences</h3>
              <p class="text-xs text-zinc-500 mt-1 leading-relaxed">Sentences over 30 words can confuse readers. If your average word length is high or readability is low, break long sentences into shorter, clearer ones. Your average word length should ideally stay under 6 characters.</p>
            </div>
          </div>
          <div class="flex gap-4 p-4 rounded-xl border border-white/[0.06] bg-zinc-900/20">
            <span class="w-8 h-8 rounded-lg bg-purple-600/15 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0">4</span>
            <div>
              <h3 class="text-sm font-semibold text-zinc-200">Use Active Voice</h3>
              <p class="text-xs text-zinc-500 mt-1 leading-relaxed">Active voice makes your writing direct and energetic. Instead of "The ball was hit by him," write "He hit the ball." The word counter helps you track total words as you revise for clarity.</p>
            </div>
          </div>
          <div class="flex gap-4 p-4 rounded-xl border border-white/[0.06] bg-zinc-900/20">
            <span class="w-8 h-8 rounded-lg bg-purple-600/15 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0">5</span>
            <div>
              <h3 class="text-sm font-semibold text-zinc-200">Edit for Conciseness</h3>
              <p class="text-xs text-zinc-500 mt-1 leading-relaxed">Cut unnecessary words like "very," "really," "that," and "just." Every word should earn its place. Use the character count to see how trimming affects your total — shorter is often stronger.</p>
            </div>
          </div>
        </div>
      </section>

      <KeyboardHints hints={[
        { keys: "⌘K", label: "Open search" },
        { keys: "Ctrl+A", label: "Select all" },
        { keys: "Ctrl+Z", label: "Undo" },
      ]} />

      <RelatedTools current="word-counter" />

      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} />
      </div>
    </div>
  </main>
</MainLayout>

<script>
  const textarea = document.getElementById("analyzer-input");
  const $ = (id) => document.getElementById(id);
  const wordCount = $("word-count");
  const charCount = $("char-count");
  const charNs = $("char-ns");
  const sentenceCount = $("sentence-count");
  const paragraphCount = $("paragraph-count");
  const readTime = $("read-time");
  const speakTime = $("speak-time");
  const readability = $("readability");
  const readabilityBar = $("readability-bar");
  const avgWordLen = $("avg-word-len");
  const longestWord = $("longest-word");
  const uniqueWords = $("unique-words");
  const keywordPanel = $("keyword-panel");
  const keywordList = $("keyword-list");
  const keywordEmpty = $("keyword-empty");
  const copyBtn = $("copy-btn");
  const clearBtn = $("clear-btn");
  const downloadBtn = $("download-txt");

  function syllableCount(word) {
    word = word.toLowerCase().replace(/[^a-z]/g, "");
    if (!word.length) return 0;
    let count = 0, prevVowel = false;
    const vowels = "aeiouy";
    for (const ch of word) {
      const isVowel = vowels.includes(ch);
      if (isVowel && !prevVowel) count++;
      prevVowel = isVowel;
    }
    return count || 1;
  }

  function updateStats() {
    const text = textarea.value;
    const words = text.trim() ? text.trim().split(/\s+/).filter(w => w.length > 0) : [];
    const wc = words.length;
    const cc = text.length;
    const cns = text.replace(/\s/g, "").length;
    const sc = text.split(/[.!?]+/).filter(s => s.trim().length > 0).length;
    const pc = text.split(/\n+/).filter(p => p.trim().length > 0).length;

    wordCount.textContent = wc;
    charCount.textContent = cc;
    charNs.textContent = cns;
    sentenceCount.textContent = sc;
    paragraphCount.textContent = pc;
    readTime.textContent = wc > 0 ? (Math.ceil(wc / 200) + "m") : "0m";
    speakTime.textContent = wc > 0 ? (Math.ceil(wc / 150) + "m") : "0m";

    // Readability
    if (wc > 0 && sc > 0) {
      const syllables = words.reduce((s, w) => s + syllableCount(w), 0);
      const score = Math.max(0, Math.min(100, Math.round(206.835 - 1.015 * (wc / sc) - 84.6 * (syllables / wc))));
      let label, color, barColor;
      if (score >= 70) { label = "Easy"; color = "text-emerald-400"; barColor = "bg-emerald-500"; }
      else if (score >= 50) { label = "Fair"; color = "text-lime-400"; barColor = "bg-lime-500"; }
      else if (score >= 30) { label = "Hard"; color = "text-yellow-400"; barColor = "bg-yellow-500"; }
      else { label = "Complex"; color = "text-red-400"; barColor = "bg-red-500"; }
      readability.textContent = `${score} — ${label}`;
      readability.className = `text-xs font-bold ${color}`;
      readabilityBar.style.width = score + "%";
      readabilityBar.className = `h-full rounded-full transition-all duration-500 ease-out ${barColor}`;
    } else {
      readability.textContent = "—";
      readability.className = "text-xs font-bold text-zinc-400";
      readabilityBar.style.width = "0%";
    }

    // Advanced stats
    if (wc > 0) {
      avgWordLen.textContent = (cns / wc).toFixed(1);
      longestWord.textContent = words.reduce((a, b) => a.length >= b.length ? a : b).substring(0, 18);
      uniqueWords.textContent = new Set(words.map(w => w.toLowerCase())).size;
    } else {
      avgWordLen.textContent = "—";
      longestWord.textContent = "—";
      uniqueWords.textContent = "0";
    }

    // Keyword Density
    if (wc > 0) {
      const freq = {};
      words.forEach(w => { const k = w.toLowerCase().replace(/[^a-z]/g, ""); if (k.length > 2) freq[k] = (freq[k] || 0) + 1; });
      const sorted = Object.entries(freq).sort((a, b) => b[1] - a[1]).slice(0, 10);
      if (sorted.length > 0) {
        keywordEmpty?.classList.add("hidden");
        keywordList.innerHTML = sorted.map(([word, count]) => {
          const pct = ((count / wc) * 100).toFixed(1);
          const barW = Math.min(parseFloat(pct) * 20, 100);
          return `<span class="flex items-center gap-1.5 px-2 py-1 rounded-lg bg-white/[0.03] border border-zinc-700/50 text-[10px] text-zinc-300">
            <span class="font-medium">${word}</span>
            <span class="text-purple-400 font-bold">${pct}%</span>
            <span class="w-8 h-1 rounded-full bg-zinc-700 overflow-hidden"><span class="block h-full rounded-full bg-purple-500" style="width:${barW}%"></span></span>
          </span>`;
        }).join("");
      } else {
        keywordEmpty?.classList.remove("hidden");
        keywordList.innerHTML = "";
      }
    } else {
      keywordEmpty?.classList.remove("hidden");
      keywordList.innerHTML = "";
    }
  }

  textarea.addEventListener("input", () => {
    updateStats();
    try { localStorage.setItem("nt_wc_text", textarea.value); } catch {}
  });

  // Restore saved text
  try {
    const saved = localStorage.getItem("nt_wc_text");
    if (saved) { textarea.value = saved; }
  } catch {}
  updateStats();

  clearBtn.addEventListener("click", () => {
    textarea.value = "";
    updateStats();
    textarea.focus();
    try { localStorage.removeItem("nt_wc_text"); } catch {}
    triggerToast("Text cleared", "info");
  });

  function triggerToast(message: string, variant: "success" | "error" | "info" | "warning" = "success") {
    if ((window as any).__showToast) {
      (window as any).__showToast({ message, variant });
    }
  }

  copyBtn.addEventListener("click", async () => {
    if (!textarea.value.trim()) { triggerToast("Nothing to copy!", "warning"); return; }
    await navigator.clipboard.writeText(textarea.value);
    triggerToast("Text copied to clipboard!", "success");
  });

  downloadBtn.addEventListener("click", () => {
    const blob = new Blob([textarea.value], { type: "text/plain" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "numanx-word-count.txt";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  });

</script>

