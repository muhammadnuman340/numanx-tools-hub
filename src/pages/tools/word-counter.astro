---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";
import KeyboardHints from "../../components/KeyboardHints.astro";
import ToolContentSections from "../../components/ToolContentSections.astro";

const faqItems = [
  { question: "How do I count words in a text?", answer: "Simply type or paste your text into the text area above. The word count, character count, and other stats update instantly as you type. No button clicking required." },
  { question: "How is reading time calculated?", answer: "Reading time is estimated using the average reading speed of 200 words per minute. We divide the total word count by 200 and round up. For texts under 200 words, it shows '<1 min'." },
  { question: "What counts as a word?", answer: "A word is any sequence of characters separated by spaces or line breaks. Hyphenated words count as one word. Numbers and symbols are also counted as words when separated by spaces." },
  { question: "Does it count characters with or without spaces?", answer: "We show both! Total characters includes spaces, and characters without spaces excludes them. Many platforms count spaces in their character limits." },
  { question: "What is keyword density?", answer: "Keyword density shows how frequently a word appears in your text as a percentage of total words. It helps with SEO optimization — a healthy density is typically 1-3%." },
  { question: "How does the readability score work?", answer: "The readability score uses the Flesch-Kincaid formula based on average sentence length and syllables per word. Scores range from 0 (complex) to 100 (easy). Aim for 60+ for broad audiences." },
  { question: "What is the difference between reading time and speaking time?", answer: "Reading time is calculated at 200 words per minute (average silent reading). Speaking time uses 150 words per minute (average conversational pace). Both help you tailor content for your audience." },
  { question: "Does the word counter count numbers and symbols?", answer: "Yes, the counter counts all characters including numbers, symbols, and punctuation. Words are sequences separated by spaces. Hyphenated words like 'well-known' count as a single word." },
];

const wcSchema = {
  "name": "Word Counter Pro",
  "applicationCategory": "Utilities",
  "description": "Count words, characters, sentences, and paragraphs. Analyze keyword density, reading time, and speaking time.",
  "featureList": [
    "Real-time word, character, sentence, and paragraph count",
    "Keyword density analysis for SEO optimization",
    "Reading time and speaking time estimation",
    "Live character count with and without spaces",
    "Privacy-first — all processing stays in your browser"
  ],
}

const benefits = [
  { icon: "⚡", title: "Real-Time Stats", desc: "Words, characters, sentences, and paragraphs update instantly as you type. No buttons to click — just start typing and watch the dashboard come alive." },
  { icon: "📊", title: "Keyword Density", desc: "See which words you use most with frequency percentages. Optimize your content for SEO with ideal keyword density of 1-3%." },
  { icon: "🎯", title: "Readability Score", desc: "Get a Flesch-Kincaid readability score with color-coded feedback. Know instantly if your writing is easy, fair, or complex to read." },
  { icon: "⏱️", title: "Reading & Speaking Time", desc: "Know exactly how long your content takes to read (200 WPM) and speak (150 WPM). Perfect for presentations, scripts, and audio content." },
  { icon: "🔍", title: "Advanced Analysis", desc: "Track average word length, longest word, unique word count, and character counts with and without spaces for detailed text analysis." },
  { icon: "🆓", title: "Completely Free", desc: "No sign-ups, no limits, no hidden charges. Analyze unlimited text with all features including keyword density and readability scoring." },
];

const howToSteps = [
  { num: "1", title: "Type or Paste Text", desc: "Start typing or paste any text into the analysis area. The word counter updates automatically with zero delay." },
  { num: "2", title: "Review the Dashboard", desc: "Watch words, characters, sentences, and paragraphs count in real-time. Each stat updates as you add or remove text." },
  { num: "3", title: "Analyze Keyword Density", desc: "Check the keyword density panel to see which words appear most. Aim for 1-3% density for optimal SEO performance." },
  { num: "4", title: "Check Readability", desc: "Use the readability meter and advanced stats to refine your writing. Adjust sentence length and word choice for better scores." },
];

const useCases = [
  { icon: "✍️", title: "Content Writing", desc: "Track word counts for blog posts, articles, and essays. Ensure your content meets platform requirements and SEO best practices." },
  { icon: "🎓", title: "Academic Writing", desc: "Stay within word limits for assignments, theses, and research papers. Monitor keyword usage and readability for clearer academic prose." },
  { icon: "📱", title: "Social Media", desc: "Craft posts that fit character limits on Twitter, Instagram captions, and LinkedIn updates. Know exact counts before posting." },
  { icon: "📋", title: "Professional Reports", desc: "Write concise business reports and proposals. Track readability to ensure your message is clear to all stakeholders." },
];
---

<MainLayout
  title="Word Counter - Free Online Word & Character Counter"
  description="Count words, characters, sentences, paragraphs, reading time, and keyword density. Free online text analyzer with live stats."
  keywords="word counter, character counter, sentence counter, paragraph counter, reading time, keyword density"
  toolSchema={wcSchema}
  faq={faqItems}
  howto={{
    name: "How to Use Word Counter",
    description: "Count words, characters, sentences, and analyze keyword density and readability in 4 easy steps.",
    steps: howToSteps.map(s => ({ title: s.title, text: s.desc })),
    totalTime: "PT1M",
  }}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Tools", url: "/tools/" },
    { name: "Word Counter", url: "/tools/word-counter/" },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-5xl mx-auto">

      <ToolHeader
        title="Word Counter"
        gradient="Analytics Pro"
        desc="Count words, characters, sentences, and paragraphs. Analyze keyword density, reading time, and speaking time — live as you type."
        badge="🆕 Pro Version"
        slug="word-counter"
      />

      <ShareBar />

      <!-- ─── Dashboard ─── -->
      <div class="max-w-3xl mx-auto mt-10 space-y-5">

        <!-- Stats Bar — Grammarly-style compact row -->
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-2.5" id="stats-bar">
          <div class="stat-card group bg-surface-1 border border-surface rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="word-count" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-muted">Words</span>
          </div>
          <div class="stat-card group bg-surface-1 border border-surface rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="char-count" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-muted">Chars</span>
          </div>
          <div class="stat-card group bg-surface-1 border border-surface rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="char-ns" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-muted">No Spaces</span>
          </div>
          <div class="stat-card group bg-surface-1 border border-surface rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="sentence-count" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-muted">Sentences</span>
          </div>
          <div class="stat-card group bg-surface-1 border border-surface rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="paragraph-count" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-muted">Paragraphs</span>
          </div>
          <div class="stat-card group bg-surface-1 border border-surface rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="read-time" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0m</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-muted">Read Time</span>
          </div>
        </div>

        <!-- Text Area — Notion x ChatGPT style -->
        <div class="relative rounded-2xl border border-surface-2 bg-surface-1 focus-within:border-purple-500/60 focus-within:shadow-[0_0_20px_-8px_#a855f7] transition-all duration-300 overflow-hidden">
          <div class="flex items-center justify-between px-5 pt-3">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
              <span id="usage-badge" class="text-xs text-muted"></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex gap-1">
                <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="purple" style="background:#a855f7"></button>
                <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="blue" style="background:#3b82f6"></button>
                <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="green" style="background:#22c55e"></button>
                <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="pink" style="background:#ec4899"></button>
              </div>
              <button id="fullscreen-btn" class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs" title="Fullscreen">⛶</button>
            </div>
          </div>
          <div class="flex items-center gap-1.5 px-5">
            <button class="font-dec p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all">A−</button>
            <button class="font-inc p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all">A+</button>
