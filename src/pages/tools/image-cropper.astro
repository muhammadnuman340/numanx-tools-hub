---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";

const faqItems = [
  { question: "How does this image cropper work?", answer: "Upload an image, then drag the crop area handles or adjust the width/height values to select your desired region. The preview updates in real-time. Click 'Crop' to generate the final cropped image for download." },
  { question: "What image formats are supported?", answer: "You can upload PNG and JPG images. The cropped result can be downloaded as PNG (with transparent background support) or JPG." },
  { question: "Can I crop to a specific aspect ratio?", answer: "Yes. Choose from presets like 1:1 (square), 4:3, 16:9 (widescreen), or select 'Freeform' to crop to any dimensions." },
  { question: "Is my image uploaded to a server?", answer: "No. All image processing happens entirely in your browser using the Canvas API. Your images never leave your device." },
  { question: "Will cropping reduce image quality?", answer: "Cropping removes pixels — it doesn't recompress or degrade the remaining image. The output quality depends on the export format: PNG is lossless, JPG uses the quality level you select." },
];

const cropperSchema = {
  name: "Image Cropper Pro",
  applicationCategory: "Multimedia",
  description: "Crop images to any dimension with customizable aspect ratios. Drag to adjust the crop area and download the result.",
  featureList: [
    "Drag-based crop area adjustment",
    "Preset aspect ratios: 1:1, 4:3, 16:9, 3:2",
    "Custom dimensions with Freeform mode and aspect ratio lock",
    "Export as PNG or JPG with quality control",
    "100% client-side — no uploads, no servers"
  ],
};
---

<MainLayout
  title="Image Cropper - Crop Images Online Free | NumanX Tools"
  description="Crop images to any dimension with customizable aspect ratios. Drag to adjust crop area, preview in real-time, and download the result. Free online image cropper."
  keywords="image cropper, crop image online, crop photo, aspect ratio, image editor, free image cropper"
  toolSchema={cropperSchema}
  faq={faqItems}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Tools", url: "/tools/" },
    { name: "Image Cropper", url: "/tools/image-cropper/" },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-5xl mx-auto">
      <ToolHeader
        title="Image"
        gradient="Cropper Pro"
        desc="Crop images to any dimension with customizable aspect ratios. Drag to adjust crop area, preview in real-time, and download the result."
        badge="✦ New Tool"
        slug="image-cropper"
      />

      <ShareBar />

      <div class="w-full max-w-2xl mx-auto mt-10">
        <div class="bg-surface-1 border border-surface rounded-2xl p-6">

          <div id="dropzone" class="relative rounded-2xl border-2 border-dashed border-surface-3 bg-surface-1 p-10 md:p-16 text-center cursor-pointer hover:border-purple-500/50 hover:bg-surface-2 transition-all duration-300 group">
            <input id="file-input" type="file" accept="image/png,image/jpeg" class="hidden" />
            <div id="dropzone-content">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-600/20 to-blue-600/20 flex items-center justify-center mx-auto mb-5 group-hover:scale-110 transition-transform duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="17 8 12 3 7 8" />
                  <line x1="12" y1="3" x2="12" y2="15" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-primary mb-2">Drop your image here</h3>
              <p class="text-sm text-muted mb-4">or <span class="text-purple-400 underline underline-offset-2 font-medium">browse files</span></p>
              <p class="text-xs text-dim">Supports PNG and JPG</p>
            </div>
          </div>

          <div id="editor-section" class="hidden mt-6 space-y-5">

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              <button class="ar-btn rounded-xl border px-3 py-2 text-xs font-medium transition-all bg-purple-600 text-white border-purple-500/30" data-ar="free" data-active="true">Freeform</button>
              <button class="ar-btn rounded-xl border px-3 py-2 text-xs font-medium transition-all bg-surface-1 border-surface-3 text-tertiary hover:text-primary" data-ar="1:1" data-active="false">1:1 Square</button>
              <button class="ar-btn rounded-xl border px-3 py-2 text-xs font-medium transition-all bg-surface-1 border-surface-3 text-tertiary hover:text-primary" data-ar="4:3" data-active="false">4:3</button>
              <button class="ar-btn rounded-xl border px-3 py-2 text-xs font-medium transition-all bg-surface-1 border-surface-3 text-tertiary hover:text-primary" data-ar="16:9" data-active="false">16:9</button>
            </div>

            <div class="flex items-center justify-center">
              <div id="canvas-wrapper" class="relative max-w-full overflow-hidden rounded-xl bg-black/20 select-none" style="touch-action: none;">
                <canvas id="source-canvas" class="max-w-full max-h-[60vh]"></canvas>
                <div id="crop-overlay" class="absolute inset-0 pointer-events-none">
                  <div id="crop-box" class="absolute border-2 border-purple-400 cursor-move pointer-events-auto" style="display:none;">
                    <div class="absolute -top-3 -left-3 w-6 h-6 rounded-full bg-purple-600 border-2 border-white cursor-nwse-resize pointer-events-auto" data-handle="nw"></div>
                    <div class="absolute -top-3 -right-3 w-6 h-6 rounded-full bg-purple-600 border-2 border-white cursor-nesw-resize pointer-events-auto" data-handle="ne"></div>
                    <div class="absolute -bottom-3 -left-3 w-6 h-6 rounded-full bg-purple-600 border-2 border-white cursor-nesw-resize pointer-events-auto" data-handle="sw"></div>
                    <div class="absolute -bottom-3 -right-3 w-6 h-6 rounded-full bg-purple-600 border-2 border-white cursor-nwse-resize pointer-events-auto" data-handle="se"></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-medium text-tertiary mb-1.5">Crop Width (px)</label>
                <input id="crop-w" type="number" min="1" class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-purple-500/50 focus:outline-none transition-all" />
              </div>
              <div>
                <label class="block text-xs font-medium text-tertiary mb-1.5">Crop Height (px)</label>
                <input id="crop-h" type="number" min="1" class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-purple-500/50 focus:outline-none transition-all" />
              </div>
            </div>

            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <label class="text-xs font-medium text-tertiary">Format:</label>
                <select id="export-format" class="bg-surface-2 border border-surface-3 text-primary text-xs rounded-lg px-2.5 py-1.5 focus:outline-none">
                  <option value="png">PNG</option>
                  <option value="jpeg">JPG</option>
                </select>
                <div id="quality-wrap">
                  <label class="text-xs font-medium text-tertiary mr-2">Quality:</label>
                  <input id="quality-slider" type="range" min="10" max="100" value="92" class="w-20 align-middle accent-purple-500" />
                  <span id="quality-label" class="text-xs text-tertiary">92%</span>
                </div>
              </div>
              <button id="crop-btn" class="bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold px-5 py-2.5 rounded-xl transition-all">
                Crop & Download
              </button>
            </div>

          </div>
        </div>
      </div>

      <section class="mt-20 max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Learn</span>
          <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">
            Smart Image
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Cropping</span>
          </h2>
        </div>
        <div class="space-y-4 text-sm text-tertiary leading-relaxed">
          <p>Image cropping is essential for removing unwanted areas, focusing on a subject, or fitting specific aspect ratios for social media, websites, and print. Our image cropper gives you precise control with drag handles and preset aspect ratios.</p>
          <p>All processing happens in your browser using the HTML5 Canvas API — your images are never uploaded, ensuring complete privacy and fast results.</p>
        </div>
      </section>

      <RelatedTools current="image-cropper" />

      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} />
      </div>
    </div>
  </main>
</MainLayout>

<script>
  const dropzone = document.getElementById("dropzone");
  const fileInput = document.getElementById("file-input");
  const dropzoneContent = document.getElementById("dropzone-content");
  const editorSection = document.getElementById("editor-section");
  const sourceCanvas = document.getElementById("source-canvas");
  const canvasWrapper = document.getElementById("canvas-wrapper");
  const cropBox = document.getElementById("crop-box");
  const cropOverlay = document.getElementById("crop-overlay");
  const cropW = document.getElementById("crop-w");
  const cropH = document.getElementById("crop-h");
  const cropBtn = document.getElementById("crop-btn");
  const exportFormat = document.getElementById("export-format");
  const qualitySlider = document.getElementById("quality-slider");
  const qualityLabel = document.getElementById("quality-label");
  const qualityWrap = document.getElementById("quality-wrap");
  const arBtns = document.querySelectorAll(".ar-btn");

  const handles = cropBox.querySelectorAll("[data-handle]");
  const ctx = sourceCanvas.getContext("2d");

  let img = null;
  let imgNaturalW = 0, imgNaturalH = 0;
  let displayW = 0, displayH = 0;
  let scaleX = 1, scaleY = 1;

  let crop = { x: 0, y: 0, w: 0, h: 0 };
  let currentAR = "free";
  let dragging = false, resizing = false;
  let dragStartX = 0, dragStartY = 0;
  let resizeHandle = "";
  let resizeStart = { x: 0, y: 0, cx: 0, cy: 0, cw: 0, ch: 0 };

  function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }

  function updateDisplayDimensions() {
    const maxW = canvasWrapper.clientWidth - 4;
    const maxH = Math.min(window.innerHeight * 0.6, 600);
    const aspect = imgNaturalW / imgNaturalH;
    if (maxW / aspect <= maxH) {
      displayW = maxW;
      displayH = maxW / aspect;
    } else {
      displayH = maxH;
      displayW = maxH * aspect;
    }
    scaleX = imgNaturalW / displayW;
    scaleY = imgNaturalH / displayH;
    sourceCanvas.width = displayW;
    sourceCanvas.height = displayH;
    sourceCanvas.style.width = displayW + "px";
    sourceCanvas.style.height = displayH + "px";
  }

  function drawImage() {
    if (!img) return;
    ctx.clearRect(0, 0, displayW, displayH);
    ctx.drawImage(img, 0, 0, displayW, displayH);
  }

  function createCropBoxShadow() {
    cropOverlay.querySelectorAll(".crop-shadow").forEach(el => el.remove());
    const r = cropBox.getBoundingClientRect();
    const wr = cropOverlay.getBoundingClientRect();
    const sides = [
      { t: 0, l: 0, w: wr.width, h: r.top - wr.top },
      { t: r.top - wr.top, l: 0, w: r.left - wr.left, h: r.height },
      { t: r.top - wr.top, l: r.right - wr.left, w: wr.width - (r.right - wr.left), h: r.height },
      { t: r.bottom - wr.top, l: 0, w: wr.width, h: wr.height - (r.bottom - wr.top) },
    ];
    sides.forEach(s => {
      if (s.w <= 0 || s.h <= 0) return;
      const div = document.createElement("div");
      div.className = "crop-shadow absolute bg-black/40 pointer-events-none";
      div.style.cssText = `top:${s.t}px;left:${s.l}px;width:${s.w}px;height:${s.h}px;`;
      cropOverlay.appendChild(div);
    });
  }

  function showCropBox() {
    if (crop.w <= 0 || crop.h <= 0) { cropBox.style.display = "none"; return; }
    cropBox.style.display = "block";
    cropBox.style.left = crop.x + "px";
    cropBox.style.top = crop.y + "px";
    cropBox.style.width = crop.w + "px";
    cropBox.style.height = crop.h + "px";
    cropW.value = Math.round(crop.w * scaleX);
    cropH.value = Math.round(crop.h * scaleY);
    createCropBoxShadow();
  }

  function fitInitialCrop() {
    const margin = 0.1;
    crop.x = displayW * margin;
    crop.y = displayH * margin;
    crop.w = displayW * (1 - 2 * margin);
    crop.h = displayH * (1 - 2 * margin);
    applyARConstraint();
    showCropBox();
  }

  function applyARConstraint() {
    if (currentAR === "free") return;
    const parts = currentAR.split(":");
    const ar = parseFloat(parts[0]) / parseFloat(parts[1]);
    const currentAspect = crop.w / crop.h;
    if (currentAspect > ar) {
      crop.w = crop.h * ar;
    } else {
      crop.h = crop.w / ar;
    }
    crop.x = clamp(crop.x, 0, displayW - crop.w);
    crop.y = clamp(crop.y, 0, displayH - crop.h);
  }

  function loadImage(file) {
    const reader = new FileReader();
    reader.onload = (e) => {
      const image = new Image();
      image.onload = () => {
        img = image;
        imgNaturalW = image.naturalWidth;
        imgNaturalH = image.naturalHeight;
        dropzoneContent.classList.add("hidden");
        editorSection.classList.remove("hidden");
        updateDisplayDimensions();
        drawImage();
        fitInitialCrop();
        document.getElementById("file-input").value = "";
      };
      image.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  dropzone.addEventListener("click", () => fileInput.click());
  fileInput.addEventListener("change", (e) => {
    if (e.target.files[0]) loadImage(e.target.files[0]);
  });
  dropzone.addEventListener("dragover", (e) => { e.preventDefault(); dropzone.classList.add("border-purple-500"); });
  dropzone.addEventListener("dragleave", () => dropzone.classList.remove("border-purple-500"));
  dropzone.addEventListener("drop", (e) => {
    e.preventDefault();
    dropzone.classList.remove("border-purple-500");
    if (e.dataTransfer.files[0]) loadImage(e.dataTransfer.files[0]);
  });

  arBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      arBtns.forEach(b => {
        b.classList.remove("bg-purple-600", "text-white", "border-purple-500/30");
        b.classList.add("bg-surface-1", "border-surface-3", "text-tertiary", "hover:text-primary");
      });
      btn.classList.remove("bg-surface-1", "border-surface-3", "text-tertiary", "hover:text-primary");
      btn.classList.add("bg-purple-600", "text-white", "border-purple-500/30");
      currentAR = btn.dataset.ar;
      if (currentAR !== "free") applyARConstraint();
      showCropBox();
    });
  });

  cropBox.addEventListener("mousedown", (e) => {
    if (e.target.dataset.handle) return;
    dragging = true;
    dragStartX = e.clientX;
    dragStartY = e.clientY;
    resizeStart = { cx: crop.x, cy: crop.y, cw: crop.w, ch: crop.h };
    e.preventDefault();
  });

  handles.forEach(h => {
    h.addEventListener("mousedown", (e) => {
      resizing = true;
      resizeHandle = h.dataset.handle;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      resizeStart = { cx: crop.x, cy: crop.y, cw: crop.w, ch: crop.h };
      e.preventDefault();
      e.stopPropagation();
    });
  });

  document.addEventListener("mousemove", (e) => {
    if (!dragging && !resizing) return;
    const dx = e.clientX - dragStartX;
    const dy = e.clientY - dragStartY;

    if (dragging) {
      crop.x = clamp(resizeStart.cx + dx, 0, displayW - crop.w);
      crop.y = clamp(resizeStart.cy + dy, 0, displayH - crop.h);
      showCropBox();
      return;
    }

    if (resizing) {
      let nx = crop.x, ny = crop.y, nw = crop.w, nh = crop.h;
      const minSize = 20;
      if (resizeHandle.includes("e")) {
        nw = clamp(resizeStart.cw + dx, minSize, displayW - crop.x);
      }
      if (resizeHandle.includes("w")) {
        const maxW = resizeStart.cx + resizeStart.cw;
        let newW = clamp(resizeStart.cw - dx, minSize, maxW);
        nx = maxW - newW;
        nw = newW;
      }
      if (resizeHandle.includes("s")) {
        nh = clamp(resizeStart.ch + dy, minSize, displayH - crop.y);
      }
      if (resizeHandle.includes("n")) {
        const maxH = resizeStart.cy + resizeStart.ch;
        let newH = clamp(resizeStart.ch - dy, minSize, maxH);
        ny = maxH - newH;
        nh = newH;
      }
      crop.x = nx; crop.y = ny; crop.w = nw; crop.h = nh;

      if (currentAR !== "free") {
        const parts = currentAR.split(":");
        const ar = parseFloat(parts[0]) / parseFloat(parts[1]);
        if (resizeHandle.includes("e") || resizeHandle.includes("w")) {
          nh = nw / ar;
          if (resizeHandle.includes("n")) { ny = resizeStart.cy + resizeStart.ch - nh; }
        } else {
          nw = nh * ar;
          if (resizeHandle.includes("w")) { nx = resizeStart.cx + resizeStart.cw - nw; }
        }
        crop.x = clamp(nx, 0, displayW - nw);
        crop.y = clamp(ny, 0, displayH - nh);
        crop.w = clamp(nw, minSize, displayW);
        crop.h = clamp(nh, minSize, displayH);
      }
      showCropBox();
    }
  });

  document.addEventListener("mouseup", () => { dragging = false; resizing = false; });

  cropW.addEventListener("input", () => {
    const w = parseInt(cropW.value) || 1;
    const dw = clamp(w / scaleX, 1, displayW);
    crop.x = clamp(crop.x, 0, displayW - dw);
    crop.w = dw;
    if (currentAR !== "free") {
      const parts = currentAR.split(":");
      const ar = parseFloat(parts[0]) / parseFloat(parts[1]);
      crop.h = crop.w / ar;
      crop.y = clamp(crop.y, 0, displayH - crop.h);
    }
    showCropBox();
  });

  cropH.addEventListener("input", () => {
    const h = parseInt(cropH.value) || 1;
    const dh = clamp(h / scaleY, 1, displayH);
    crop.y = clamp(crop.y, 0, displayH - dh);
    crop.h = dh;
    if (currentAR !== "free") {
      const parts = currentAR.split(":");
      const ar = parseFloat(parts[0]) / parseFloat(parts[1]);
      crop.w = crop.h * ar;
      crop.x = clamp(crop.x, 0, displayW - crop.w);
    }
    showCropBox();
  });

  qualitySlider.addEventListener("input", () => {
    qualityLabel.textContent = qualitySlider.value + "%";
  });

  exportFormat.addEventListener("change", () => {
    qualityWrap.style.display = exportFormat.value === "jpeg" ? "inline-block" : "none";
  });

  cropBtn.addEventListener("click", () => {
    if (!img) return;
    const outW = Math.round(crop.w * scaleX);
    const outH = Math.round(crop.h * scaleY);
    if (outW <= 0 || outH <= 0) return;

    const outCanvas = document.createElement("canvas");
    outCanvas.width = outW;
    outCanvas.height = outH;
    const outCtx = outCanvas.getContext("2d");
    outCtx.drawImage(
      img,
      crop.x * scaleX, crop.y * scaleY, outW, outH,
      0, 0, outW, outH
    );

    const fmt = exportFormat.value;
    const mime = fmt === "jpeg" ? "image/jpeg" : "image/png";
    const quality = parseInt(qualitySlider.value) / 100;
    const dataUrl = outCanvas.toDataURL(mime, quality);

    const a = document.createElement("a");
    a.href = dataUrl;
    const ext = fmt === "jpeg" ? "jpg" : "png";
    a.download = `cropped-${Date.now()}.${ext}`;
    a.click();
  });

  window.addEventListener("resize", () => {
    if (!img) return;
    cx = crop.x; cy = crop.y; cw = crop.w; ch = crop.h;
    updateDisplayDimensions();
    drawImage();
    showCropBox();
  });
</script>
