---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import KeyboardHints from '../../components/KeyboardHints.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'What is a QR code?',
    answer:
      'A QR code (Quick Response code) is a two-dimensional barcode that stores information like URLs, text, or contact details. It can be scanned by smartphones and QR readers for instant access to the encoded data.',
  },
  {
    question: 'Can I customize the QR code colors?',
    answer:
      'Yes, you can change both the foreground and background colors, choose from quick theme presets, and upload a logo to appear in the center of your QR code.',
  },
  {
    question: 'Is my data sent to a server?',
    answer:
      'No. Everything happens in your browser using the qrcode JavaScript library. Your data never leaves your device.',
  },
  {
    question: 'What download formats are available?',
    answer:
      'You can download your QR code as PNG, JPG, or SVG. SVG is ideal for print and scaling to any size without quality loss.',
  },
  {
    question: 'How do error correction levels work?',
    answer:
      'Higher error correction allows the QR to be scanned even if partially damaged. L (7%), M (15%), Q (25%), H (30%). Higher levels can encode less data but are more reliable.',
  },
  {
    question: 'Can I make a WiFi QR code?',
    answer:
      'Yes! Select the WiFi template and enter your network SSID and password. The QR code will let guests connect instantly — no need to share your password verbally.',
  },
  {
    question: 'How do I scan a QR code?',
    answer:
      'Most modern smartphones have built-in QR scanning in the camera app. Open your camera and point it at the QR code — a notification will appear with the encoded content.',
  },
  {
    question: 'What is the difference between static and dynamic QR codes?',
    answer:
      'Static QR codes encode data directly and cannot be changed after creation. Dynamic QR codes redirect through a short URL, allowing you to update the destination without regenerating the code.',
  },
];
const qrSchema = {
  name: 'rMQR & QR Code Generator Pro',
  applicationCategory: 'Multimedia',
  description:
    'Generate ISO/IEC 23941 Rectangular Micro QR (rMQR) strips (R7x43 to R17x139) and custom square QR codes with WiFi, vCard, Logo, PNG, and vector SVG export.',
  featureList: [
    'ISO/IEC 23941 Rectangular Micro QR (rMQR) strips (R7x43 to R17x139)',
    'Auto-Fit smart sizing for compact rectangular barcodes',
    'Custom square QR codes with logo and brand colors',
    'WiFi, Email, Phone, SMS, YouTube, and vCard templates',
    'Vector SVG, PNG, and JPG download formats',
    '4 error correction levels for damaged-code recovery',
    '100% client-side — no server uploads, zero data transfer',
  ],
};

const benefits = [
  {
    icon: '🔒',
    title: '100% Private',
    desc: 'All QR codes are generated locally in your browser. Your data never touches any server — complete privacy guaranteed.',
  },
  {
    icon: '🎨',
    title: 'Fully Customizable',
    desc: 'Change colors, upload logos, pick themes, and choose from 6 templates. Make QR codes that match your brand perfectly.',
  },
  {
    icon: '⬇️',
    title: 'Multiple Export Formats',
    desc: 'Download as PNG, JPG, or SVG. SVG is ideal for print — scales to any size without pixelation or quality loss.',
  },
  {
    icon: '🔧',
    title: 'Smart Templates',
    desc: 'WiFi, Email, Phone, YouTube, and vCard templates pre-configure the encoding so you get the right format every time.',
  },
  {
    icon: '⚡',
    title: 'Lightning Fast',
    desc: 'Instant generation as you type. No page reloads, no API calls, no waiting. Real-time preview updates directly in your browser.',
  },
  {
    icon: '🆓',
    title: 'Completely Free',
    desc: 'No sign-ups, no hidden charges, no usage limits. All features including SVG export and custom logos are completely free.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Choose a Template',
    desc: 'Pick from Website, WiFi, Email, Phone, or YouTube templates. Each template pre-configures the right encoding format for your use case.',
  },
  {
    num: '2',
    title: 'Enter Your Data',
    desc: 'Type or paste your URL, text, WiFi credentials, or contact information into the input fields. Watch the QR code update in real-time.',
  },
  {
    num: '3',
    title: 'Customize Design',
    desc: 'Change foreground and background colors, pick a theme preset, or upload a logo to appear in the center of your QR code.',
  },
  {
    num: '4',
    title: 'Download or Share',
    desc: 'Download your QR code as PNG, JPG, or SVG. Copy to clipboard or share the link directly from the tool.',
  },
];

const useCases = [
  {
    icon: '🏪',
    title: 'Restaurant Menus',
    desc: 'Replace physical menus with QR codes that link to your digital menu. Update items anytime without reprinting.',
  },
  {
    icon: '📱',
    title: 'Social Media Growth',
    desc: 'Add QR codes to business cards, flyers, and posters that link directly to your Instagram, TikTok, or YouTube channel.',
  },
  {
    icon: '🏨',
    title: 'Hotel & Hospitality',
    desc: 'Provide guests with QR codes for WiFi access, room service menus, local attractions, and checkout forms.',
  },
  {
    icon: '🎫',
    title: 'Event Ticketing',
    desc: 'Generate QR codes for event tickets, VIP passes, and registration confirmations. Scan for instant entry verification.',
  },
];
---

<MainLayout
  title="QR & rMQR Code Generator — ISO/IEC 23941 | NumanX"
  description="Generate ISO/IEC 23941 Rectangular Micro QR (rMQR) strips (R7x43 to R17x139) and custom square QR codes with WiFi, vCard, Logo, PNG, and vector SVG export."
  keywords="rmqr generator, rectangular micro qr, qr code generator, custom qr maker, qr with logo, wifi qr code, svg qr code"
  toolSchema={qrSchema}
  faq={faqItems}
  howto={{
    name: 'How to Generate a QR Code or rMQR Strip',
    description: 'Create a custom square QR code or rectangular micro QR strip with logo, colors, and templates in 4 easy steps.',
    steps: howToSteps.map((s) => ({ title: s.title, text: s.desc })),
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'rMQR & QR Generator', url: '/tools/qr-generator/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-5xl mx-auto">
      <ToolHeader
        title="rMQR & QR"
        gradient="Generator Pro"
        desc="Generate ISO/IEC 23941 Rectangular Micro QR strips and custom square QR codes with colors, logos, and vector SVG export. 100% client-side."
        badge="✦ ISO/IEC 23941 rMQR"
        slug="qr-generator"
      />

      <ShareBar />

      <!-- ─── Tool Interface ─── -->
      <div class="mt-8 grid grid-cols-1 lg:grid-cols-5 gap-5">
        <!-- ── Left Panel: Inputs ── -->
        <div class="lg:col-span-3 space-y-4">
          <!-- Format & Standard Selector -->
          <div class="glass-card rounded-2xl p-4">
            <label class="text-xs font-semibold text-muted uppercase tracking-wider mb-2.5 block">Format & Standard</label>
            <div class="grid grid-cols-2 gap-2" id="format-toggle">
              <button
                type="button"
                id="btn-mode-square"
                class="format-mode-btn rounded-xl py-2.5 px-3 text-xs font-semibold border transition-all flex items-center justify-center gap-2 bg-purple-600/20 border-purple-500/50 text-white shadow-sm"
                data-mode="square"
              >
                <span>🔲</span>
                <span>Square QR (Standard)</span>
              </button>
              <button
                type="button"
                id="btn-mode-rmqr"
                class="format-mode-btn rounded-xl py-2.5 px-3 text-xs font-semibold border transition-all flex items-center justify-center gap-2 bg-surface-2 border-surface text-tertiary hover:text-white"
                data-mode="rmqr"
              >
                <span>📏</span>
                <span>rMQR Strip (ISO/IEC 23941)</span>
              </button>
            </div>
          </div>

          <!-- Templates -->
          <div class="glass-card rounded-2xl p-5" id="templates-card">
            <label class="text-xs font-semibold text-muted uppercase tracking-wider mb-3 block">Template</label>
            <div class="grid grid-cols-5 gap-2" id="template-tabs">
              {
                ['Website', 'WiFi', 'Email', 'Phone', 'YouTube'].map((t) => (
                  <button
                    class="template-btn rounded-xl py-2.5 px-2 text-xs font-medium border transition-all flex flex-col items-center gap-1"
                    data-template={t}
                  >
                    <span class="text-base">
                      {t === 'Website'
                        ? '🌐'
                        : t === 'WiFi'
                          ? '📶'
                          : t === 'Email'
                            ? '✉️'
                            : t === 'Phone'
                              ? '📞'
                              : '▶️'}
                    </span>
                    <span>{t}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <!-- Dynamic Input Fields -->
          <div class="glass-card rounded-2xl p-5 space-y-4" id="input-fields">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
              <button
                id="fullscreen-btn"
                class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs"
                title="Fullscreen">⛶</button
              >
            </div>
            <!-- Website (default) -->
            <div id="field-website" class="field-group space-y-2">
              <label class="text-xs font-semibold text-muted uppercase tracking-wider">URL or Text</label>
              <input
                id="qr-text"
                type="text"
                placeholder="https://example.com"
                class="w-full bg-black/40 border border-surface text-primary text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" aria-label="QR code content"
              />
            </div>
            <div id="field-wifi" class="field-group space-y-2 hidden">
              <label class="text-xs font-semibold text-muted uppercase tracking-wider">WiFi Network</label>
              <input
                id="wifi-ssid"
                type="text"
                placeholder="Network name (SSID)"
                class="w-full bg-black/40 border border-surface text-primary text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" aria-label="Wi-Fi network name"
              />
              <input
                id="wifi-pass"
                type="text"
                placeholder="Password"
                class="w-full bg-black/40 border border-surface text-primary text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" aria-label="Wi-Fi password"
              />
            </div>
            <div id="field-email" class="field-group space-y-2 hidden">
              <label class="text-xs font-semibold text-muted uppercase tracking-wider">Email</label>
              <input
                id="email-to"
                type="email"
                placeholder="recipient@example.com"
                class="w-full bg-black/40 border border-surface text-primary text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" aria-label="Recipient email address"
              />
              <input
                id="email-subject"
                type="text"
                placeholder="Subject"
                class="w-full bg-black/40 border border-surface text-primary text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" aria-label="Email subject"
              />
              <div class="flex items-center justify-between min-h-[32px] mb-2">
                <label for="email-body" class="text-xs font-semibold text-zinc-300">Message</label>
                <div class="flex items-center gap-1.5">
                  <div class="flex items-center gap-0.5 bg-surface-2 p-0.5 rounded-lg border border-surface">
                    <button
                      type="button"
                      aria-label="Decrease font size"
                      class="font-dec px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                      >A−</button
                    >
                    <button
                      type="button"
                      aria-label="Increase font size"
                      class="font-inc px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                      >A+</button
                    >
                  </div>
                  <span class="text-xs text-muted ml-2">Ctrl+Enter to process</span>
                </div>
              </div>
              <div class="flex h-[180px] rounded-xl bg-black/40 border border-surface focus-within:border-purple-500 focus-within:ring-1 focus-within:ring-purple-500 transition-all overflow-hidden relative">
                <div
                  id="line-nums"
                  class="w-12 shrink-0 h-full select-none overflow-hidden font-mono text-sm leading-6 text-right pr-3.5 py-3 text-zinc-500/80 bg-zinc-950/60 border-r border-white/5 whitespace-pre pointer-events-none tabular-nums"
                  style="line-height: 24px; font-size: 14px;"
                >
                  1
                </div>
                <textarea
                  id="email-body"
                  placeholder="Message"
                  aria-label="Email message"
                  class="flex-1 min-w-0 h-full bg-transparent text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 px-4 py-3 focus:outline-none font-mono resize-none border-0 overflow-y-auto"
                  style="line-height: 24px; font-size: 14px;"
                ></textarea>
              </div>
              <div class="flex justify-between text-xs text-muted mt-1.5 px-1">
                <span><span id="char-count">0</span> chars</span>
                <span><span id="word-count">0</span> words</span>
                <span><span id="line-count">0</span> lines</span>
              </div>
              <div id="reading-time" class="text-xs text-muted mt-1"></div>
              <div id="letter-freq" class="mt-2 flex flex-wrap gap-1.5 hidden" role="region" aria-label="Character frequency breakdown"></div>
            </div>
            <div id="field-phone" class="field-group space-y-2 hidden">
              <label class="text-xs font-semibold text-muted uppercase tracking-wider">Phone Number</label>
              <input
                id="phone-number"
                type="tel"
                placeholder="+1234567890"
                class="w-full bg-black/40 border border-surface text-primary text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" aria-label="Phone number"
              />
            </div>
            <div id="field-youtube" class="field-group space-y-2 hidden">
              <label class="text-xs font-semibold text-muted uppercase tracking-wider">YouTube Video URL</label>
              <input
                id="youtube-url"
                type="url"
                placeholder="https://youtube.com/watch?v=..."
                class="w-full bg-black/40 border border-surface text-primary text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" aria-label="YouTube video URL"
              />
            </div>
          </div>

          <!-- Colors + Logo -->
          <div class="bg-surface-1 border border-surface rounded-2xl p-5 space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="text-xs font-semibold text-muted uppercase tracking-wider block mb-2"
                  >Foreground</label
                >
                <input
                  id="fg-color"
                  type="color"
                  value="#000000"
                  class="w-full h-10 rounded-xl bg-zinc-900 border border-surface cursor-pointer" aria-label="QR foreground color"
                />
              </div>
              <div>
                <label class="text-xs font-semibold text-muted uppercase tracking-wider block mb-2"
                  >Background</label
                >
                <input
                  id="bg-color"
                  type="color"
                  value="#ffffff"
                  class="w-full h-10 rounded-xl bg-zinc-900 border border-surface cursor-pointer" aria-label="QR background color"
                />
              </div>
            </div>
            <div>
              <label class="text-xs font-semibold text-muted uppercase tracking-wider block mb-2">Size</label>
              <select
                id="qr-size"
                class="w-full bg-black/40 border border-surface text-primary text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" aria-label="QR code size"
              >
                {
                  [100, 150, 200, 250, 300, 400, 500].map((s) => (
                    <option value={s}>
                      {s}×{s}px
                    </option>
                  ))
                }
              </select>
            </div>
            <!-- Square QR Options -->
            <div id="square-qr-options">
              <label class="text-xs font-semibold text-muted uppercase tracking-wider block mb-2"
                >Error Correction</label
              >
              <select
                id="qr-error-level"
                class="w-full bg-black/40 border border-surface text-primary text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" aria-label="Error correction level"
              >
                <option value="L">L (7%)</option>
                <option value="M">M (15%)</option>
                <option value="Q">Q (25%)</option>
                <option value="H" selected>H (30%)</option>
              </select>
            </div>

            <!-- rMQR Options -->
            <div id="rmqr-options" class="hidden space-y-3">
              <div>
                <label class="text-xs font-semibold text-muted uppercase tracking-wider block mb-2"
                  >rMQR Strip Version</label
                >
                <select
                  id="rmqr-version"
                  class="w-full bg-black/40 border border-surface text-primary text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all font-mono text-xs" aria-label="rMQR version"
                >
                  <option value="auto" selected>Auto-Fit (Smart Compact Strip)</option>
                  <option value="R7x43">R7x43 (7 rows × 43 cols - Ultra Slim)</option>
                  <option value="R7x59">R7x59 (7 rows × 59 cols)</option>
                  <option value="R7x77">R7x77 (7 rows × 77 cols)</option>
                  <option value="R7x99">R7x99 (7 rows × 99 cols)</option>
                  <option value="R7x139">R7x139 (7 rows × 139 cols - Long Strip)</option>
                  <option value="R9x43">R9x43 (9 rows × 43 cols)</option>
                  <option value="R9x59">R9x59 (9 rows × 59 cols)</option>
                  <option value="R9x77">R9x77 (9 rows × 77 cols)</option>
                  <option value="R9x99">R9x99 (9 rows × 99 cols)</option>
                  <option value="R9x139">R9x139 (9 rows × 139 cols)</option>
                  <option value="R11x43">R11x43 (11 rows × 43 cols)</option>
                  <option value="R11x77">R11x77 (11 rows × 77 cols)</option>
                  <option value="R11x139">R11x139 (11 rows × 139 cols - High Density)</option>
                  <option value="R13x77">R13x77 (13 rows × 77 cols)</option>
                  <option value="R15x99">R15x99 (15 rows × 99 cols)</option>
                  <option value="R17x139">R17x139 (17 rows × 139 cols - Maximum)</option>
                </select>
              </div>
              <p class="text-xs text-zinc-400 leading-relaxed">
                ISO/IEC 23941 Rectangular Micro QR is optimized for long, narrow spaces like packaging edges, test tubes, and wristbands.
              </p>
            </div>
          </div>
        </div>

        <!-- -- Right Panel: Preview + Download -- -->
        <div class="lg:col-span-2 space-y-4">
          <div class="bg-surface-1 border border-surface rounded-2xl p-5 flex flex-col items-center">
            <div id="qr-canvas-wrapper" class="bg-white rounded-xl p-4 mb-4">
              <canvas id="qr-canvas"></canvas>
            </div>
            <span id="qr-size-badge" class="text-xs text-muted font-mono">--</span>
          </div>
          <div class="grid grid-cols-4 gap-2">
            <button
              id="copy-btn"
              class="bg-surface-2 hover:bg-surface-3 border border-surface text-tertiary hover:text-white text-xs font-medium py-2.5 rounded-xl transition-all active:scale-95"
              ><span>Copy</span></button
            >
            {
              ['PNG', 'JPG', 'SVG'].map((f) => (
                <button
                  class="download-btn bg-surface-2 hover:bg-surface-3 border border-surface text-tertiary hover:text-white text-xs font-medium py-2.5 rounded-xl transition-all active:scale-95"
                  data-format={f}
                >
                  Download {f}
                </button>
              ))
            }
          </div>
          <div class="flex items-center gap-2">
            <span id="usage-badge" class="text-xs text-muted"></span>
            <button
              id="share-btn"
              class="bg-surface-2 hover:bg-surface-3 border border-surface text-tertiary hover:text-white text-xs font-medium px-3 py-1.5 rounded-xl transition-all"
              title="Share">🔗</button
            >
            <select
              id="export-format" aria-label="Export file format"
              class="bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5 ml-auto"
            >
              <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option><option
                value="html">HTML</option
              >
            </select>
            <div class="flex gap-1">
              <button
                class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                data-color="purple"
                aria-label="Set purple theme"
                style="background:#a855f7"></button>
              <button
                class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                data-color="blue"
                aria-label="Set blue theme"
                style="background:#3b82f6"></button>
              <button
                class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                data-color="green"
                aria-label="Set green theme"
                style="background:#22c55e"></button>
              <button
                class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                data-color="pink"
                aria-label="Set pink theme"
                style="background:#ec4899"></button>
            </div>
          </div>
        </div>
      </div>

      <!-- --- FAQ --- -->
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>

      <KeyboardHints
        hints={[
          { keys: '?K', label: 'Open search' },
          { keys: 'Enter', label: 'Generate QR' },
          { keys: 'Esc', label: 'Clear / Reset' },
        ]}
      />

      <ToolContentSections
        toolSlug="qr-generator"
        toolName="QR Generator"
        category="Creator Tools"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />

      <!-- ─── CTA Section ─── -->
      <section class="mt-16 text-center">
        <div
          class="max-w-2xl mx-auto bg-gradient-to-br from-purple-600/10 to-blue-600/5 border border-purple-500/20 rounded-2xl p-8 md:p-10"
        >
          <h2 class="text-2xl md:text-3xl font-black tracking-tight">
            Start Creating
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">
              QR Codes Free</span
            >
          </h2>
          <p class="text-tertiary mt-3 max-w-lg mx-auto text-sm leading-relaxed">
            No sign-up required. No limits. Generate unlimited custom QR codes with logos, colors, and templates
            completely free.
          </p>
          <div class="mt-6 flex gap-3 justify-center flex-wrap">
            <button
              onclick="document.querySelector('#qr-text')?.focus()"
              class="px-6 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm transition-all active:scale-[0.97] shadow-lg shadow-purple-900/30"
            >
              Generate Now
            </button>
            <a
              href="/tools/hashtag-generator/"
              class="px-6 py-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-semibold text-sm transition-all border border-zinc-700"
            >
              Try Hashtag Generator
            </a>
          </div>
        </div>
      </section>

      <RelatedTools current="qr-generator" />
    </div>
  </main>
</MainLayout>

<script>
  import QRCode from 'qrcode';
  import bwipjs from 'bwip-js/browser';

  const canvas = document.getElementById('qr-canvas') as HTMLCanvasElement;
  const qrText = document.getElementById('qr-text') as HTMLInputElement;
  const fgColor = document.getElementById('fg-color') as HTMLInputElement;
  const bgColor = document.getElementById('bg-color') as HTMLInputElement;
  const qrSize = document.getElementById('qr-size') as HTMLSelectElement;
  const qrErrorLevel = document.getElementById('qr-error-level') as HTMLSelectElement;
  const rmqrVersionSelect = document.getElementById('rmqr-version') as HTMLSelectElement;
  const sizeBadge = document.getElementById('qr-size-badge');
  const downloadBtns = document.querySelectorAll('.download-btn');
  const templateBtns = document.querySelectorAll('.template-btn');
  const formatModeBtns = document.querySelectorAll('.format-mode-btn');
  const squareOptions = document.getElementById('square-qr-options');
  const rmqrOptions = document.getElementById('rmqr-options');

  let currentMode: 'square' | 'rmqr' = 'square';
  let currentData = 'https://toolshub.numanxstudio.com';
  let currentTemplate = 'Website';
  let lastValidRMQRVersion = 'R11x139';

  const RMQR_ASCENDING_VERSIONS = [
    'R7x43', 'R7x59', 'R7x77', 'R7x99', 'R7x139',
    'R9x43', 'R9x59', 'R9x77', 'R9x99', 'R9x139',
    'R11x43', 'R11x77', 'R11x139',
    'R13x77', 'R15x99', 'R17x139'
  ];

  function resolveRMQRVersion(data: string, requested: string): string {
    if (requested !== 'auto') return requested;
    for (const v of RMQR_ASCENDING_VERSIONS) {
      try {
        bwipjs.toSVG({
          bcid: 'rectangularmicroqrcode',
          text: data,
          version: v,
        });
        return v;
      } catch (err) {
        // Continue searching larger versions
      }
    }
    return 'R17x139';
  }

  function getQRData() {
    switch (currentTemplate) {
      case 'WiFi': {
        const ssid = (document.getElementById('wifi-ssid') as HTMLInputElement)?.value || 'network';
        const pass = (document.getElementById('wifi-pass') as HTMLInputElement)?.value || '';
        return `WIFI:S:${ssid};T:WPA;P:${pass};;`;
      }
      case 'Email': {
        const to = (document.getElementById('email-to') as HTMLInputElement)?.value || '';
        const sub = (document.getElementById('email-subject') as HTMLInputElement)?.value || '';
        const body = (document.getElementById('email-body') as HTMLTextAreaElement)?.value || '';
        return `mailto:${to}?subject=${encodeURIComponent(sub)}&body=${encodeURIComponent(body)}`;
      }
      case 'Phone':
        return `tel:${(document.getElementById('phone-number') as HTMLInputElement)?.value || '+1234567890'}`;
      case 'YouTube':
        return (document.getElementById('youtube-url') as HTMLInputElement)?.value || 'https://youtube.com';
      default:
        return qrText?.value || 'https://toolshub.numanxstudio.com';
    }
  }

  async function generateBarcode() {
    currentData = getQRData() || 'https://toolshub.numanxstudio.com';
    const fg = fgColor?.value || '#000000';
    const bg = bgColor?.value || '#ffffff';

    if (currentMode === 'square') {
      const size = parseInt(qrSize?.value || '250');
      if (sizeBadge) sizeBadge.textContent = `${size}×${size}px`;
      try {
        await QRCode.toCanvas(canvas, currentData, {
          width: size,
          color: { dark: fg, light: bg },
          errorCorrectionLevel: (qrErrorLevel?.value as any) || 'H',
        });
      } catch (e) {
        console.error('Square QR generation error:', e);
      }
    } else {
      // rMQR Strip mode (ISO/IEC 23941)
      const requestedVersion = rmqrVersionSelect?.value || 'auto';
      const actualVersion = resolveRMQRVersion(currentData, requestedVersion);
      lastValidRMQRVersion = actualVersion;

      try {
        bwipjs.toCanvas(canvas, {
          bcid: 'rectangularmicroqrcode',
          text: currentData,
          version: actualVersion,
          scale: 4,
          barcolor: fg.replace('#', ''),
          backgroundcolor: bg.replace('#', ''),
          padding: 8,
        });
        if (sizeBadge) {
          sizeBadge.textContent = `rMQR ${actualVersion} (${canvas.width}×${canvas.height}px)`;
        }
      } catch (err: any) {
        console.warn('rMQR generation error:', err);
        if (sizeBadge) {
          sizeBadge.textContent = `Capacity exceeded for ${actualVersion}`;
        }
      }
    }
  }

  formatModeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = (btn as HTMLElement).dataset.mode as 'square' | 'rmqr';
      currentMode = mode;

      formatModeBtns.forEach((b) => {
        b.classList.remove('bg-purple-600/20', 'border-purple-500/50', 'text-white', 'shadow-sm');
        b.classList.add('bg-surface-2', 'border-surface', 'text-tertiary');
      });
      btn.classList.remove('bg-surface-2', 'border-surface', 'text-tertiary');
      btn.classList.add('bg-purple-600/20', 'border-purple-500/50', 'text-white', 'shadow-sm');

      if (mode === 'square') {
        squareOptions?.classList.remove('hidden');
        rmqrOptions?.classList.add('hidden');
      } else {
        squareOptions?.classList.add('hidden');
        rmqrOptions?.classList.remove('hidden');
      }
      generateBarcode();
    });
  });

  templateBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      templateBtns.forEach((b) => {
        b.classList.remove('bg-purple-600/15', 'border-purple-500/50', 'text-purple-300');
        b.classList.add('bg-surface-2', 'border-surface', 'text-tertiary');
      });
      btn.classList.remove('bg-surface-2', 'border-surface', 'text-tertiary');
      btn.classList.add('bg-purple-600/15', 'border-purple-500/50', 'text-purple-300');
      currentTemplate = (btn as HTMLElement).dataset.template || 'Website';
      document.querySelectorAll('.field-group').forEach((g) => g.classList.add('hidden'));
      const field = document.getElementById(`field-${currentTemplate.toLowerCase()}`);
      if (field) field.classList.remove('hidden');
      generateBarcode();
    });
  });

  qrText?.addEventListener('input', generateBarcode);
  fgColor?.addEventListener('input', generateBarcode);
  bgColor?.addEventListener('input', generateBarcode);
  qrSize?.addEventListener('change', generateBarcode);
  qrErrorLevel?.addEventListener('change', generateBarcode);
  rmqrVersionSelect?.addEventListener('change', generateBarcode);

  document.querySelectorAll('#input-fields input, #input-fields textarea').forEach((el) => {
    el.addEventListener('input', generateBarcode);
  });

  function triggerToast(message: string, variant: 'success' | 'error' | 'info' | 'warning' = 'success') {
    if ((window as any).__showToast) {
      (window as any).__showToast({ message, variant });
    }
  }

  downloadBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const fmt = (btn as HTMLElement).dataset.format?.toLowerCase() || 'png';
      const link = document.createElement('a');
      const filename = currentMode === 'square' ? `qrcode.${fmt}` : `rmqr-${lastValidRMQRVersion}.${fmt}`;

      if (fmt === 'svg') {
        try {
          let svgStr = '';
          if (currentMode === 'square') {
            svgStr = await QRCode.toString(currentData, {
              type: 'svg',
              color: { dark: fgColor?.value || '#000000', light: bgColor?.value || '#ffffff' },
              errorCorrectionLevel: (qrErrorLevel?.value as any) || 'H',
            });
          } else {
            svgStr = bwipjs.toSVG({
              bcid: 'rectangularmicroqrcode',
              text: currentData,
              version: lastValidRMQRVersion,
              scale: 4,
              barcolor: (fgColor?.value || '#000000').replace('#', ''),
              backgroundcolor: (bgColor?.value || '#ffffff').replace('#', ''),
              padding: 8,
            });
          }
          const blob = new Blob([svgStr], { type: 'image/svg+xml' });
          link.href = URL.createObjectURL(blob);
          link.download = filename;
        } catch (e) {
          console.error(e);
          return;
        }
      } else {
        link.href = canvas.toDataURL(`image/${fmt === 'jpg' ? 'jpeg' : fmt}`);
        link.download = filename;
      }
      link.click();
      triggerToast(`Downloaded as ${fmt.toUpperCase()}`, 'success');
    });
  });

  document.getElementById('copy-btn')?.addEventListener('click', () => {
    const text =
      document.getElementById('output-text')?.value || document.querySelector("[id$='result']")?.textContent || '';
    if (!text) return;
    navigator.clipboard.writeText(text).catch(() => {});
    const btn = document.getElementById('copy-btn');
    const span = btn.querySelector('span');
    span.textContent = 'Copied!';
    setTimeout(() => {
      span.textContent = 'Copy';
    }, 2000);
  });

  const emailBody = document.getElementById('email-body') as HTMLTextAreaElement;
  function updateQRStats() {
    const val = emailBody.value;
    document.getElementById('char-count').textContent = val.length;
    document.getElementById('word-count').textContent = val.trim() ? val.trim().split(/\s+/).length : 0;
    document.getElementById('line-count').textContent = val ? val.split('\n').length : 0;
  }
  emailBody.addEventListener('input', updateQRStats);

  // Init
  templateBtns[0]?.classList.add('bg-purple-600/15', 'border-purple-500/50', 'text-purple-300');
  generateBarcode();

  // Fullscreen toggle
  document.getElementById('fullscreen-btn')?.addEventListener('click', () => {
    const card = document.getElementById('fullscreen-btn').closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
      document.getElementById('fullscreen-btn').textContent = '⛶';
    } else {
      card.requestFullscreen?.() || card.webkitRequestFullscreen?.();
      document.getElementById('fullscreen-btn').textContent = '✕';
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const btn = document.getElementById('fullscreen-btn');
    if (btn) btn.textContent = document.fullscreenElement ? '✕' : '⛶';
  });

  // Auto-save draft
  const DRAFT_KEY = 'nt_draft_qr-generator';
  (function () {
    const input = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
    if (!input) return;
    try {
      const saved = localStorage.getItem(DRAFT_KEY);
      if (saved && !input.value) {
        input.value = saved;
        input.dispatchEvent(new Event('input'));
      }
    } catch (e) {}
    let saveTimer;
    input.addEventListener('input', () => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        try {
          localStorage.setItem(DRAFT_KEY, input.value);
        } catch (e) {}
      }, 500);
    });
  })();

  // Feature 1: Font size
  const updateEditorFontSize = (newSize: number) => {
    const clamped = Math.max(10, Math.min(24, newSize));
    const lineHeight = Math.round(clamped * 1.7);
    document.querySelectorAll('textarea').forEach((t) => {
      t.style.fontSize = clamped + 'px';
      t.style.lineHeight = lineHeight + 'px';
    });
    const lineNums = document.getElementById('line-nums');
    if (lineNums) {
      lineNums.style.fontSize = clamped + 'px';
      lineNums.style.lineHeight = lineHeight + 'px';
    }
    try {
      localStorage.setItem('nt_fs', String(clamped));
    } catch (e) {}
  };

  document.querySelector('.font-inc')?.addEventListener('click', () => {
    const firstArea = document.querySelector('textarea');
    const cur = firstArea ? parseInt(getComputedStyle(firstArea).fontSize) : 14;
    updateEditorFontSize(cur + 2);
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    const firstArea = document.querySelector('textarea');
    const cur = firstArea ? parseInt(getComputedStyle(firstArea).fontSize) : 14;
    updateEditorFontSize(cur - 2);
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) updateEditorFontSize(parseInt(s));
  } catch (e) {}

  // Feature 2: Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b = document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      const clearBtn = document.getElementById('clear-btn') || document.querySelector("button[id*='clear']") || document.querySelector("button[id*='reset']");
      if (clearBtn) clearBtn.click();
      else {
        const inputs = document.querySelectorAll('textarea, input:not([type="radio"]):not([type="checkbox"])');
        inputs.forEach(i => i.value = '');
        const evt = new Event('input', { bubbles: true });
        inputs.forEach(i => i.dispatchEvent(evt));
      }
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });

  // Feature 3: Usage badge
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['qr-generator']) b.textContent = 'Used ' + u['qr-generator'] + '×';
  } catch (e) {}

  // Feature 4: Share button
  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('output-text') || document.querySelector("[id$='result']");
    const t = o?.value || o?.textContent || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof showToast === 'function') {
      playPing();
      showToast('Link copied!');
    }
  });

  // Feature 5: Reading time
  const rt = document.getElementById('email-body');
  if (rt) {
    rt.addEventListener('input', () => {
      const w = rt.value ? rt.value.trim().split(/\s+/).length : 0;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent = Math.max(1, Math.round(w / 200)) + 'm read · ' + Math.max(1, Math.round(w / 150)) + 'm speak';
    });
    rt.dispatchEvent(new Event('input'));
  }

  // Feature 6: Line numbers
  (function () {
    const li = document.getElementById('email-body');
    if (li) {
      const ul = () => {
        const n = document.getElementById('line-nums');
        if (n) n.textContent = Array.from({ length: li.value.split('\n').length }, (_, i) => i + 1).join('\n');
      };
      li.addEventListener('input', ul);
      li.addEventListener('scroll', () => {
        const n = document.getElementById('line-nums');
        if (n) n.scrollTop = li.scrollTop;
      });
      ul();
    }
  })();

  // Feature 7: Sound effects
  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }

  // Feature 8: Export format
  document.getElementById('export-format')?.addEventListener('change', function () {});

  // Feature 9: Letter frequency
  (function () {
    const lf = document.getElementById('email-body');
    if (lf) {
      lf.addEventListener('input', () => {
        const t = lf.value.toLowerCase().replace(/[^a-z]/g, '');
        if (!t) {
          document.getElementById('letter-freq')?.classList.add('hidden');
          return;
        }
        const f = {};
        for (const c of t) f[c] = (f[c] || 0) + 1;
        const s = Object.entries(f)
          .sort((a, b) => b[1] - a[1])
          .slice(0, 8);
        const m = s[0] ? s[0][1] : 1;
        const el = document.getElementById('letter-freq');
        el.classList.remove('hidden');
        el.innerHTML = s
          .map(
            ([c, n]) =>
              `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-xs font-mono"><strong class="text-purple-400 uppercase">${c}</strong><span class="text-zinc-400">${n}</span></span>`,
          )
          .join('');
      });
    }
  })();

  // Feature 10: Theme picker
  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      document.querySelectorAll("button[class*='bg-purple'],button[class*='bg-violet']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(purple|violet)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(purple|violet)-\d+/g, 'hover:bg-' + c + '-500');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}
</script>
