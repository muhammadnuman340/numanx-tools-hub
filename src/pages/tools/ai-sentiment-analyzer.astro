  toolSchema={schema}
  faq={faqItems}
  howto={{
    name: 'How to Analyze Sentiment with AI',
    description: 'Learn how to use our AI sentiment analyzer to detect emotions and opinions in any text',
    steps: howToSteps.map((s) => ({ title: s.title, text: s.desc })),
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'AI Sentiment Analyzer', url: '/tools/ai-sentiment-analyzer/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="AI Sentiment"
        gradient="Analyzer Pro"
        desc="Detect the emotional tone of any text — positive, negative, or neutral. See a detailed breakdown of emotions and key sentiment-driving words."
        badge="✦ AI Powered"
        slug="ai-sentiment-analyzer"
      />
      <ShareBar />
      <div class="max-w-xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6 space-y-4 relative">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
