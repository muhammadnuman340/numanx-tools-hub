        'heartbroken',
        'devastated',
        'disappointed',
        'disappointing',
        'gloomy',
        'melancholy',
        'sorrow',
        'grief',
        'mourn',
        'cry',
        'tears',
        'lonely',
        'hopeless',
        'despair',
        'heartache',
        'mournful',
      ],
      weight: 1,
    },
    fear: {
      words: [
        'afraid',
        'scared',
        'terrified',
        'frightened',
        'anxious',
        'worried',
        'nervous',
        'panicked',
        'horrified',
        'fearful',
        'terrifying',
        'frightening',
        'alarming',
        'dread',
        'dreadful',
        'threatened',
        'uneasy',
        'paranoid',
        'phobia',
        'timid',
      ],
      weight: 1,
    },
    surprise: {
      words: [
        'surprised',
        'amazed',
        'astonished',
        'shocked',
        'stunned',
        'astounded',
        'startled',
        'dumbfounded',
        'flabbergasted',
        'speechless',
        'unexpected',
        'unforeseen',
        'sudden',
        'remarkable',
        'incredible',
        'extraordinary',
        'striking',
        'notable',
        'stunning',
        'breathtaking',
      ],
      weight: 1,
    },
  };

  const intensifiers = [
    'very',
    'extremely',
    'incredibly',
    'really',
    'so',
    'absolutely',
    'completely',
    'totally',
    'utterly',
    'highly',
    'deeply',
    'truly',
  ];
  const diminishers = [
    'slightly',
    'somewhat',
    'barely',
    'hardly',
    'a bit',
    'a little',
    'kinda',
    'kind of',
    'fairly',
    'rather',
  ];
  const negators = [
    'not',
    'no',
    'never',
    'neither',
    'nor',
    'cannot',
    "can't",
    "don't",
    "doesn't",
    "didn't",
    "won't",
    "wouldn't",
    "shouldn't",
    "couldn't",
    "isn't",
    "aren't",
    "wasn't",
    "weren't",
    "haven't",
    "hasn't",
    "hadn't",
  ];

  function analyzeSentiment(text) {
    const tokens = text
      .toLowerCase()
      .replace(/[^a-z\s']/g, '')
      .split(/\s+/)
      .filter((w) => w);
    let posScore = 0,
      negScore = 0,
      neutralScore = 0;
    let posCount = 0,
      negCount = 0;
    let posWordsFound = [],
      negWordsFound = [];
    const emotions = { joy: 0, anger: 0, sadness: 0, fear: 0, surprise: 0 };

    for (let i = 0; i < tokens.length; i++) {
      const token = tokens[i].replace(/'s$/, '');
      let multiplier = 1;

      // Check for negator in previous 1-2 words
      for (let j = Math.max(0, i - 2); j < i; j++) {
        if (negators.includes(tokens[j])) {
          multiplier = -1;
          break;
        }
      }

      // Check for intensifier in previous 1-2 words
      for (let j = Math.max(0, i - 2); j < i; j++) {
        if (intensifiers.includes(tokens[j])) {
          multiplier *= 1.5;
          break;
        }
      }

      // Check for diminisher
      for (let j = Math.max(0, i - 2); j < i; j++) {
        if (diminishers.includes(tokens[j])) {
          multiplier *= 0.5;
          break;
        }
      }

      if (positiveWords[token] !== undefined) {
        const score = positiveWords[token] * multiplier;
        if (score > 0) {
          posScore += score;
          posCount++;
          posWordsFound.push({ word: token, score });
        } else {
          negScore += Math.abs(score);
          negCount++;
          negWordsFound.push({ word: token, score: Math.abs(score) });
        }
      } else if (negativeWords[token] !== undefined) {
        const score = negativeWords[token] * multiplier;
        if (score > 0) {
          negScore += score;
          negCount++;
          negWordsFound.push({ word: token, score });
        } else {
          posScore += Math.abs(score);
          posCount++;
          posWordsFound.push({ word: token, score: Math.abs(score) });
        }
      } else {
        neutralScore += 0.1;
      }

      // Emotion detection
      for (const [emotion, data] of Object.entries(emotionWords)) {
        if (data.words.includes(token)) {
          emotions[emotion] += data.weight * Math.abs(multiplier);
        }
      }
    }

    const total = posScore + negScore + neutralScore;
    const posPct = total > 0 ? Math.round((posScore / total) * 100) : 33;
    const negPct = total > 0 ? Math.round((negScore / total) * 100) : 33;
    const neutPct = Math.max(0, 100 - posPct - negPct);

    let label, labelColor;
    if (posScore > negScore * 1.2) {
      label = 'Positive 😊';
      labelColor = 'text-emerald-400';
    } else if (negScore > posScore * 1.2) {
      label = 'Negative 😟';
      labelColor = 'text-rose-400';
    } else {
      label = 'Neutral 😐';
      labelColor = 'text-zinc-400';
    }

    posWordsFound.sort((a, b) => b.score - a.score);
    negWordsFound.sort((a, b) => b.score - a.score);

    const topPos = posWordsFound.slice(0, 10).filter((w, i, arr) => arr.findIndex((x) => x.word === w.word) === i);
    const topNeg = negWordsFound.slice(0, 10).filter((w, i, arr) => arr.findIndex((x) => x.word === w.word) === i);

    // Normalize emotions
    const maxEmotion = Math.max(...Object.values(emotions), 1);
    for (const key of Object.keys(emotions)) {
      emotions[key] = Math.round((emotions[key] / maxEmotion) * 100);
    }

    return { posPct, negPct, neutPct, label, labelColor, emotions, topPos, topNeg };
  }

  function drawDonutChart(canvasId, posPct, negPct, neutPct) {
    const canvas = document.getElementById(canvasId);
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const cx = 100,
      cy = 100,
      r = 80,
      w = 25;
    ctx.clearRect(0, 0, 200, 200);
    const total = posPct + negPct + neutPct || 100;
    const data = [
      { pct: (posPct / total) * 100, color: '#22c55e' },
      { pct: (negPct / total) * 100, color: '#f43f5e' },
      { pct: (neutPct / total) * 100, color: '#71717a' },
    ];
    let startAngle = -Math.PI / 2;
    data.forEach((d) => {
      const angle = (d.pct / 100) * 2 * Math.PI;
      ctx.beginPath();
      ctx.arc(cx, cy, r, startAngle, startAngle + angle);
      ctx.arc(cx, cy, r - w, startAngle + angle, startAngle, true);
      ctx.closePath();
      ctx.fillStyle = d.color;
      ctx.fill();
      startAngle += angle;
    });
    ctx.fillStyle = '#e4e4e7';
    ctx.font = 'bold 18px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(posPct + '%', cx, cy - 10);
    ctx.fillStyle = '#a1a1aa';
    ctx.font = '11px sans-serif';
    ctx.fillText('Positive', cx, cy + 12);
  }

  function drawEmotionChart(canvasId, emotions) {
    const canvas = document.getElementById(canvasId);
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = 300,
      h = 150;
    ctx.clearRect(0, 0, w, h);
    const labels = Object.keys(emotions);
    const values = Object.values(emotions);
    const max = Math.max(...values, 1);
    const colors = ['#22c55e', '#ef4444', '#3b82f6', '#a855f7', '#f59e0b'];
    const barW = 36;
    const gap = 16;
    const startX = 20;
    ctx.font = '10px sans-serif';
    ctx.textAlign = 'center';
    labels.forEach((label, i) => {
      const x = startX + i * (barW + gap) + barW / 2;
      const barH = (values[i] / max) * 100;
      const y = h - 30 - barH;
      ctx.fillStyle = colors[i % colors.length];
      ctx.beginPath();
      ctx.roundRect(x - barW / 2, y, barW, barH, 3);
      ctx.fill();
      ctx.fillStyle = '#a1a1aa';
      ctx.fillText(label[0].toUpperCase() + label.slice(1, 4), x, h - 12);
      ctx.fillStyle = '#e4e4e7';
      ctx.font = 'bold 10px sans-serif';
      ctx.fillText(values[i] + '%', x, y - 5);
      ctx.font = '10px sans-serif';
    });
  }

  analyzeBtn.addEventListener('click', () => {
    const text = inputEl.value.trim();
    if (!text) {
      triggerToast('Please enter some text to analyze', 'warning');
      return;
    }

    const result = analyzeSentiment(text);
    resultsArea.classList.remove('hidden');

    sentimentLabel.textContent = result.label;
    sentimentLabel.className = `text-sm font-bold ${result.labelColor}`;

    positiveBar.style.width = result.posPct + '%';
    positiveBar.className = 'h-full bg-emerald-500 transition-all duration-700 ease-out';
    negativeBar.style.width = result.negPct + '%';
    negativeBar.className = 'h-full bg-rose-500 transition-all duration-700 ease-out';
    neutralBar.style.width = result.neutPct + '%';
    neutralBar.className = 'h-full bg-zinc-600 transition-all duration-700 ease-out';

    positivePct.textContent = result.posPct;
    negativePct.textContent = result.negPct;
    neutralPct.textContent = result.neutPct;

    const emotionColors = {
      joy: { color: 'bg-emerald-500', text: 'text-emerald-400', icon: '😊' },
      anger: { color: 'bg-red-500', text: 'text-red-400', icon: '😠' },
      sadness: { color: 'bg-blue-500', text: 'text-blue-400', icon: '😢' },
      fear: { color: 'bg-purple-500', text: 'text-purple-400', icon: '😨' },
      surprise: { color: 'bg-amber-500', text: 'text-amber-400', icon: '😲' },
    };

    emotionBreakdown.innerHTML = Object.entries(result.emotions)
      .map(([emotion, pct]) => {
        const ec = emotionColors[emotion];
        return `<div class="flex items-center gap-3">
        <span class="w-6 text-center text-sm">${ec.icon}</span>
        <span class="text-xs capitalize text-secondary w-16">${emotion}</span>
        <div class="flex-1 h-2 rounded-full bg-zinc-800 overflow-hidden">
          <div class="h-full rounded-full ${ec.color} transition-all duration-700" style="width:${pct}%"></div>
        </div>
        <span class="text-xs text-dim w-8 text-right">${pct}%</span>
      </div>`;
      })
      .join('');

    positiveWordsEl.innerHTML =
      result.topPos.length > 0
        ? result.topPos
            .map(
              (w) =>
                `<span class="inline-block px-2 py-0.5 bg-emerald-500/10 border border-emerald-500/30 rounded text-emerald-300 mr-1 mb-1">${w.word}</span>`,
            )
            .join('')
        : '<span class="text-dim">No strong positive words found</span>';

    negativeWordsEl.innerHTML =
      result.topNeg.length > 0
        ? result.topNeg
            .map(
              (w) =>
                `<span class="inline-block px-2 py-0.5 bg-rose-500/10 border border-rose-500/30 rounded text-rose-300 mr-1 mb-1">${w.word}</span>`,
            )
            .join('')
        : '<span class="text-dim">No strong negative words found</span>';

    drawDonutChart('sentiment-donut', result.posPct, result.negPct, result.neutPct);
    drawEmotionChart('emotion-chart', result.emotions);

    document.getElementById('donut-pos-pct').textContent = result.posPct + '%';
    document.getElementById('donut-neg-pct').textContent = result.negPct + '%';
    document.getElementById('donut-neut-pct').textContent = result.neutPct + '%';

    triggerToast('Sentiment analysis complete!', 'success');
  });

  document.getElementById('copy-btn')?.addEventListener('click', () => {
    const label = document.getElementById('sentiment-label')?.textContent || '';
    const pos = document.getElementById('positive-pct')?.textContent || '';
    const neg = document.getElementById('negative-pct')?.textContent || '';
    const neut = document.getElementById('neutral-pct')?.textContent || '';
    if (!label) {
      triggerToast('Nothing to copy!', 'warning');
      return;
    }
    navigator.clipboard.writeText(`Sentiment: ${label}\nPositive: ${pos}% | Neutral: ${neut}% | Negative: ${neg}%`);
    playPing();
    const btn = document.getElementById('copy-btn');
    btn.textContent = 'Copied!';
    setTimeout(() => {
      btn.textContent = 'Copy';
    }, 2000);
  });

  document.getElementById('download-btn')?.addEventListener('click', () => {
    const label = document.getElementById('sentiment-label')?.textContent || '';
    const pos = document.getElementById('positive-pct')?.textContent || '0';
    const neg = document.getElementById('negative-pct')?.textContent || '0';
    const neut = document.getElementById('neutral-pct')?.textContent || '0';
    const text = inputEl.value.trim();
    if (!text) {
      triggerToast('Nothing to download!', 'warning');
      return;
    }
    const outputText = `Input Text:\n${text}\n\nSentiment: ${label}\nPositive: ${pos}% | Neutral: ${neut}% | Negative: ${neg}%`;
    const fmt = document.getElementById('export-format')?.value || 'txt';
    let content = outputText;
    let mime = 'text/plain';
    let ext = 'txt';
    if (fmt === 'json') {
      content = JSON.stringify({
        result: outputText,
        tool: 'ai-sentiment-analyzer',
        timestamp: new Date().toISOString(),
      });
      mime = 'application/json';
      ext = 'json';
    }
    if (fmt === 'csv') {
      content = 'Result\n"' + outputText.replace(/"/g, '""') + '"';
      mime = 'text/csv';
      ext = 'csv';
    }
    if (fmt === 'html') {
      content = '<!DOCTYPE html><html><body><pre>' + outputText.replace(/</g, '&lt;') + '</pre></body></html>';
      mime = 'text/html';
      ext = 'html';
    }
    const blob = new Blob([content], { type: mime });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'sentiment-output.' + ext;
    a.click();
    URL.revokeObjectURL(a.href);
    playPing();
    triggerToast('Downloaded!', 'success');
  });

  inputEl?.addEventListener('input', () => {
    const text = inputEl.value;
    document.getElementById('char-count').textContent = text.length;
    document.getElementById('word-count').textContent = text.trim()
      ? text
          .trim()
          .split(/\s+/)
          .filter((w) => w).length
      : 0;
    document.getElementById('line-count').textContent = text ? text.split('\n').length : 0;
  });

  document.getElementById('fullscreen-btn')?.addEventListener('click', () => {
    const card =
      document.getElementById('fullscreen-btn').closest('.bg-surface-1.border.border-surface.rounded-2xl') ||
      document.getElementById('fullscreen-btn').closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
      document.getElementById('fullscreen-btn').textContent = '⛶';
    } else {
      card.requestFullscreen?.() || card.webkitRequestFullscreen?.();
      document.getElementById('fullscreen-btn').textContent = '✕';
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const btn = document.getElementById('fullscreen-btn');
    if (btn) btn.textContent = document.fullscreenElement ? '✕' : '⛶';
  });

  const DRAFT_KEY = 'nt_draft_ai-sentiment-analyzer';
  (function () {
    const input = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
    if (!input) return;
    try {
      const saved = localStorage.getItem(DRAFT_KEY);
      if (saved && !input.value) {
        input.value = saved;
        input.dispatchEvent(new Event('input'));
      }
    } catch (e) {}
    let saveTimer;
    input.addEventListener('input', () => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        try {
          localStorage.setItem(DRAFT_KEY, input.value);
        } catch (e) {}
      }, 500);
    });
  })();

  document.querySelector('.font-inc')?.addEventListener('click', () => {
    document.querySelectorAll('textarea').forEach((t) => {
      let s = parseInt(getComputedStyle(t).fontSize);
      t.style.fontSize = Math.min(24, s + 2) + 'px';
    });
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    document.querySelectorAll('textarea').forEach((t) => {
      let s = parseInt(getComputedStyle(t).fontSize);
      t.style.fontSize = Math.max(10, s - 2) + 'px';
    });
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) document.querySelectorAll('textarea').forEach((t) => (t.style.fontSize = s + 'px'));
  } catch (e) {}

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b =
        document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])") ||
        document.querySelector("button[class*='bg-']:not([id*='full']):not([id*='paste'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      const clearBtn = document.getElementById('clear-btn') || document.querySelector("button[id*='clear']") || document.querySelector("button[id*='reset']");
      if (clearBtn) clearBtn.click();
      else {
        const inputs = document.querySelectorAll('textarea, input:not([type="radio"]):not([type="checkbox"])');
        inputs.forEach(i => i.value = '');
        const evt = new Event('input', { bubbles: true });
        inputs.forEach(i => i.dispatchEvent(evt));
      }
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });

  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['ai-sentiment-analyzer']) b.textContent = 'Used ' + u['ai-sentiment-analyzer'] + '×';
  } catch (e) {}

  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('sentiment-label') || document.querySelector("[id$='result']");
    const t = o?.value || o?.textContent || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof triggerToast === 'function') triggerToast('Link copied!');
  });

  const rtInput = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
  if (rtInput) {
    rtInput.addEventListener('input', () => {
      const w = rtInput.value ? rtInput.value.trim().split(/\s+/).length : 0;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent =
          Math.max(1, Math.round(w / 200)) + ' min read · ' + Math.max(1, Math.round(w / 150)) + ' min speak';
    });
    rtInput.dispatchEvent(new Event('input'));
  }

  const lnInput = document.getElementById('input-text');
  if (lnInput) {
    const updateLN = () => {
      const n = document.getElementById('line-nums');
      if (n) n.textContent = Array.from({ length: lnInput.value.split('\n').length }, (_, i) => i + 1).join('\n');
    };
    lnInput.addEventListener('input', updateLN);
    lnInput.addEventListener('scroll', () => {
      const n = document.getElementById('line-nums');
      if (n) n.scrollTop = lnInput.scrollTop;
    });
    updateLN();
  }

  const lfInput = document.getElementById('input-text');
  if (lfInput) {
    lfInput.addEventListener('input', () => {
      const t = lfInput.value.toLowerCase().replace(/[^a-z]/g, '');
      if (!t) {
        document.getElementById('letter-freq').classList.add('hidden');
        return;
      }
      const f = {};
      for (const c of t) f[c] = (f[c] || 0) + 1;
      const s = Object.entries(f)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8);
      const m = s[0] ? s[0][1] : 1;
      const el = document.getElementById('letter-freq');
      el.classList.remove('hidden');
      el.innerHTML = s
        .map(
          ([c, n]) =>
            `<div class="flex items-center gap-1.5 text-xs"><span class="w-3 text-center font-mono text-white">${c}</span><div class="h-2 rounded-full bg-purple-500/50" style="width:${(n / m) * 80 + 10}%"></div><span class="text-muted">${n}</span></div>`,
        )
        .join('');
    });
  }

  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      const map = { purple: '#a855f7', blue: '#3b82f6', green: '#22c55e', pink: '#ec4899', orange: '#f97316' };
      document.querySelectorAll("button[class*='bg-purple'], button[class*='bg-violet']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(purple|violet)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(purple|violet)-\d+/g, 'hover:bg-' + c + '-500')
          .replace(/from-(purple|violet)-\d+/g, 'from-' + c + '-500')
          .replace(/to-purple-\d+/g, 'to-' + c + '-600');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}
</script>
