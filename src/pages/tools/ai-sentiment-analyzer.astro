import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const benefits = [
  {
    title: 'Overall Sentiment Score',
    desc: 'Get a clear positive, negative, or neutral classification for any text with percentage breakdowns',
  },
  {
    title: 'Emotion Breakdown',
    desc: 'See detailed analysis of joy, anger, sadness, fear, and surprise levels in your text',
  },
  {
    title: 'Visual Charts',
    desc: 'View donut chart and emotion bar graph for instant visual understanding of sentiment',
