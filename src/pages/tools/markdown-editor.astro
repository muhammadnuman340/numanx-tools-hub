---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";
import KeyboardHints from "../../components/KeyboardHints.astro";

const faqItems = [
  { question: "Is my markdown content saved anywhere?", answer: "Your content is saved to your browser's localStorage so it persists between sessions. Nothing is uploaded to any server." },
  { question: "Can I export my markdown as HTML?", answer: "Yes. Click the 'Export HTML' button to download a complete HTML file with rendered content. You can also copy the markdown source or the rendered HTML." },
  { question: "What markdown features are supported?", answer: "The editor supports headings (H1-H6), bold, italic, strikethrough, links, images, ordered/unordered lists, blockquotes, inline code, code blocks, horizontal rules, and tables." },
  { question: "Does it support dark mode?", answer: "The preview automatically follows the site's dark theme. The rendered output uses the same dark styling for consistency." },
  { question: "Can I use keyboard shortcuts?", answer: "Yes. Use the toolbar buttons or common shortcuts. The editor also supports tab for indentation and auto-closing of markdown syntax." },
];
const schema = {
  name: "Markdown Editor Pro",
  applicationCategory: "Web Application",
  description: "Live markdown editor with split-pane preview, formatting toolbar, syntax highlighting, and one-click HTML export.",
  featureList: [
    "Real-time split-pane markdown preview",
    "Formatting toolbar with common markdown actions",
    "HTML export with styled output",
    "Copy rendered HTML to clipboard",
    "Auto-saves content to localStorage",
    "Full markdown syntax support including tables and code blocks"
  ],
};
---

<MainLayout
  title="Markdown Editor Free Online - Live Preview & HTML Export"
  description="Write and preview markdown in real-time with a split-pane editor, formatting toolbar, syntax highlighting, and one-click HTML export."
  keywords="markdown editor, markdown preview, md editor, online markdown, markdown to html, rich text editor"
  toolSchema={schema}
  faq={faqItems}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Tools", url: "/tools/" },
    { name: "Markdown Editor", url: "/tools/markdown-editor/" },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-6xl mx-auto">
      <ToolHeader
        title="Markdown"
        gradient="Editor Pro"
        desc="Write and preview markdown in real-time with a rich toolbar, syntax highlighting, and HTML export. Perfect for docs, READMEs, and notes."
        badge="★ Upgraded"
        slug="markdown-editor"
      />

      <ShareBar />

      <!-- Tool Interface -->
      <div class="mt-8 space-y-4">

        <!-- Toolbar -->
        <div class="bg-surface-1 border border-surface rounded-2xl p-2 flex flex-wrap gap-1">
          {[
            { cmd: "bold", label: "B", style: "font-bold" },
            { cmd: "italic", label: "I", style: "italic" },
            { cmd: "strike", label: "S", style: "line-through" },
            { cmd: "|" },
            { cmd: "h1", label: "H1" },
            { cmd: "h2", label: "H2" },
            { cmd: "h3", label: "H3" },
            { cmd: "|" },
            { cmd: "link", label: "🔗" },
            { cmd: "img", label: "🖼" },
            { cmd: "|" },
            { cmd: "ul", label: "• List" },
            { cmd: "ol", label: "1. List" },
            { cmd: "quote", label: "❝" },
            { cmd: "code", label: "<>" },
            { cmd: "hr", label: "—" },
            { cmd: "|" },
            { cmd: "table", label: "⊞ Table" },
          ].map((item) =>
            item.cmd === "|"
              ? `<span class="w-px h-6 bg-surface-3 mx-1 self-center"></span>`
              : `<button class="toolbar-btn px-2.5 py-1.5 rounded-lg text-xs font-medium text-tertiary hover:text-white hover:bg-surface-3 transition-all active:scale-95" data-cmd="${item.cmd}">${item.label}</button>`
          ).join("")}
        </div>

        <!-- Editor + Preview -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="text-[10px] font-semibold text-muted uppercase tracking-wider">Markdown</label>
              <span id="md-stats" class="text-[10px] text-dim font-mono">0 words</span>
            </div>
            <textarea id="md-input" class="w-full h-[500px] bg-black/40 border border-surface text-primary text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all font-mono resize-y" placeholder="Type your markdown here..."># Hello World

Start typing **markdown** on the left, see the *rendered* preview on the right.

## Features

- Headings (H1-H6)
- **Bold**, *italic*, ~~strikethrough~~
- [Links](https://example.com)
- Code blocks with `inline code`
- Tables, lists, and more</textarea>
          </div>
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="text-[10px] font-semibold text-muted uppercase tracking-wider">Preview</label>
              <div class="flex gap-2">
                <button id="copy-html-btn" class="text-[10px] font-medium text-muted hover:text-secondary px-2 py-1 rounded-lg border border-surface hover:bg-surface-2 transition-all">Copy HTML</button>
                <button id="export-html-btn" class="text-[10px] font-medium text-muted hover:text-secondary px-2 py-1 rounded-lg border border-surface hover:bg-surface-2 transition-all">Export HTML</button>
              </div>
            </div>
            <div id="md-preview" class="w-full h-[500px] overflow-y-auto bg-black/40 border border-surface rounded-xl px-4 py-3 text-sm text-secondary prose prose-invert max-w-none"></div>
          </div>
        </div>

        <!-- Info -->
        <div class="bg-surface-1 border border-surface rounded-2xl p-4 text-xs text-muted leading-relaxed">
          <strong class="text-tertiary">Supports:</strong> H1-H6, bold, italic, strikethrough, links, images, ordered/unordered lists, blockquotes, inline code, fenced code blocks, horizontal rules, tables, and line breaks. Content auto-saves to your browser.
        </div>

      </div>

      <!-- FAQ -->
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} />
      </div>

      <KeyboardHints hints={[
        { keys: "Ctrl+B", label: "Bold" },
        { keys: "Ctrl+I", label: "Italic" },
        { keys: "⌘K", label: "Open search" },
      ]} />

      <RelatedTools current="markdown-editor" />
    </div>
  </main>
</MainLayout>

<script>
  const input = document.getElementById("md-input") as HTMLTextAreaElement;
  const preview = document.getElementById("md-preview");
  const statsEl = document.getElementById("md-stats");
  const copyHtmlBtn = document.getElementById("copy-html-btn");
  const exportHtmlBtn = document.getElementById("export-html-btn");

  function escapeHtml(text: string): string {
    return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function renderMarkdown(src: string): string {
    let html = "";

    // Split into blocks, preserving order
    const lines = src.split("\n");
    let inCodeBlock = false;
    let inTable = false;
    let tableRows: string[] = [];
    let codeContent: string[] = [];
    let codeLang = "";

    function flushTable() {
      if (tableRows.length > 0) {
        const headerCells = tableRows[0].split("|").filter(Boolean);
        const isHeader = tableRows.length > 1 && tableRows[1].trim().match(/^[\|:\s\-]+$/);
        let start = 0;
        if (isHeader) start = 2;
        html += "<table><thead><tr>";
        headerCells.forEach((c) => { html += `<th>${inlineMd(c.trim())}</th>`; });
        html += "</tr></thead><tbody>";
        for (let i = start; i < tableRows.length; i++) {
          const cells = tableRows[i].split("|").filter(Boolean);
          html += "<tr>" + cells.map((c) => `<td>${inlineMd(c.trim())}</td>`).join("") + "</tr>";
        }
        html += "</tbody></table>\n";
        tableRows = [];
      }
    }

    function inlineMd(text: string): string {
      let s = escapeHtml(text);
      // Images
      s = s.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1" class="max-w-full rounded-lg my-2" />');
      // Links
      s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-purple-400 hover:text-purple-300 underline">$1</a>');
      // Bold+Italic
      s = s.replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>');
      // Bold
      s = s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      s = s.replace(/__(.+?)__/g, '<strong>$1</strong>');
      // Italic
      s = s.replace(/\*(.+?)\*/g, '<em>$1</em>');
      s = s.replace(/_(.+?)_/g, '<em>$1</em>');
      // Strikethrough
      s = s.replace(/~~(.+?)~~/g, '<del>$1</del>');
      // Inline code
      s = s.replace(/`([^`]+)`/g, '<code class="bg-zinc-800 text-orange-300 px-1 rounded text-xs">$1</code>');
      return s;
    }

    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];

      // Code block
      if (line.trim().startsWith("```")) {
        if (!inCodeBlock) {
          flushTable();
          inCodeBlock = true;
          codeLang = line.trim().slice(3).trim();
          codeContent = [];
          continue;
        } else {
          const code = escapeHtml(codeContent.join("\n"));
          html += `<pre class="bg-zinc-900 rounded-xl p-4 my-3 overflow-x-auto"><code class="text-sm text-secondary font-mono">${code}</code></pre>\n`;
          inCodeBlock = false;
          continue;
        }
      }
      if (inCodeBlock) {
        codeContent.push(line);
        continue;
      }

      // Table
      if (line.includes("|") && line.trim().startsWith("|")) {
        inTable = true;
        tableRows.push(line);
        continue;
      } else if (inTable) {
        flushTable();
        inTable = false;
      }

      // Horizontal rule
      if (/^(-{3,}|\*{3,}|_{3,})\s*$/.test(line.trim())) {
        html += '<hr class="border-surface my-4" />\n';
        continue;
      }

      // Headings
      const hMatch = line.match(/^(#{1,6})\s+(.+)$/);
      if (hMatch) {
        const level = hMatch[1].length;
        html += `<h${level} class="font-bold text-primary mt-5 mb-2 ${level <= 2 ? 'text-xl' : level === 3 ? 'text-lg' : 'text-base'}">${inlineMd(hMatch[2])}</h${level}>\n`;
        continue;
      }

      // Blockquote
      if (line.trim().startsWith("> ")) {
        const content = line.trim().slice(2);
        html += `<blockquote class="border-l-2 border-purple-500/50 pl-4 my-2 text-tertiary italic">${inlineMd(content)}</blockquote>\n`;
        continue;
      }

      // Unordered list
      const ulMatch = line.match(/^(\s*)[*\-+]\s+(.+)$/);
      if (ulMatch) {
        html += `<li class="ml-4 list-disc text-secondary">${inlineMd(ulMatch[2])}</li>\n`;
        continue;
      }

      // Ordered list
      const olMatch = line.match(/^(\s*)\d+\.\s+(.+)$/);
      if (olMatch) {
        html += `<li class="ml-4 list-decimal text-secondary">${inlineMd(olMatch[2])}</li>\n`;
        continue;
      }

      // Empty line
      if (line.trim() === "") {
        html += "\n";
        continue;
      }

      // Regular paragraph
      html += `<p class="my-1.5 text-secondary leading-relaxed">${inlineMd(line)}</p>\n`;
    }

    if (inCodeBlock) {
      const code = escapeHtml(codeContent.join("\n"));
      html += `<pre class="bg-zinc-900 rounded-xl p-4 my-3 overflow-x-auto"><code class="text-sm text-secondary font-mono">${code}</code></pre>\n`;
    }
    if (inTable) flushTable();

    return html;
  }

  function triggerToast(message: string, variant: "success" | "error" | "info" | "warning" = "success") {
    if ((window as any).__showToast) {
      (window as any).__showToast({ message, variant });
    }
  }

  function updatePreview() {
    const src = input.value;
    const html = renderMarkdown(src);
    preview.innerHTML = html;
    const words = src.trim() ? src.trim().split(/\s+/).length : 0;
    statsEl.textContent = `${words} words`;
    try { localStorage.setItem("nt_md_content", src); } catch {}
  }

  function getHtmlDocument(): string {
    const content = renderMarkdown(input.value);
    return `<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Markdown Export</title><style>body{max-width:800px;margin:0 auto;padding:2rem;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;line-height:1.6;color:#1a1a2e;background:#fff}h1,h2,h3{color:#111}code{background:#f0f0f0;padding:0.2em 0.4em;border-radius:3px;font-size:0.9em}pre{background:#f5f5f5;padding:1rem;border-radius:8px;overflow-x:auto}pre code{background:none;padding:0}img{max-width:100%;border-radius:8px}blockquote{border-left:3px solid #7c3aed;padding-left:1rem;color:#555;margin:1rem 0}table{border-collapse:collapse;width:100%;margin:1rem 0}th,td{border:1px solid #ddd;padding:0.5rem;text-align:left}th{background:#f5f5f5}</style></head><body>${content}</body></html>`;
  }

  input.addEventListener("input", updatePreview);

  // Toolbar
  document.querySelectorAll(".toolbar-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const cmd = (btn as HTMLElement).dataset.cmd;
      const start = input.selectionStart;
      const end = input.selectionEnd;
      const selected = input.value.substring(start, end);
      const lineStart = input.value.lastIndexOf("\n", start - 1) + 1;
      const lineEnd = input.value.indexOf("\n", end);
      const fullLine = input.value.substring(lineStart, lineEnd === -1 ? input.value.length : lineEnd);

      let replacement = "";
      let cursorOffset = 0;

      switch (cmd) {
        case "bold": replacement = `**${selected || "bold"}**`; cursorOffset = selected ? 0 : 2; break;
        case "italic": replacement = `*${selected || "italic"}*`; cursorOffset = selected ? 0 : 1; break;
        case "strike": replacement = `~~${selected || "strikethrough"}~~`; cursorOffset = selected ? 0 : 2; break;
        case "h1": replacement = `# ${fullLine.trim() || "Heading 1"}`; cursorOffset = 2; break;
        case "h2": replacement = `## ${fullLine.trim() || "Heading 2"}`; cursorOffset = 3; break;
        case "h3": replacement = `### ${fullLine.trim() || "Heading 3"}`; cursorOffset = 4; break;
        case "link": replacement = `[${selected || "link text"}](url)`; cursorOffset = selected ? 0 : -1; break;
        case "img": replacement = `![${selected || "alt text"}](image-url)`; cursorOffset = selected ? 0 : -1; break;
        case "ul": replacement = `- ${selected || "list item"}`; cursorOffset = 2; break;
        case "ol": replacement = `1. ${selected || "list item"}`; cursorOffset = 3; break;
        case "quote": replacement = `> ${selected || "blockquote"}`; cursorOffset = 2; break;
        case "code": replacement = "```\n" + (selected || "code") + "\n```"; cursorOffset = selected ? 0 : 1; break;
        case "hr": replacement = "\n---\n"; cursorOffset = 1; break;
        case "table": replacement = "| Header 1 | Header 2 | Header 3 |\n| --- | --- | --- |\n| Cell 1 | Cell 2 | Cell 3 |"; cursorOffset = 0; break;
      }

      if (cmd === "h1" || cmd === "h2" || cmd === "h3") {
        const before = input.value.substring(0, lineStart);
        const after = input.value.substring(lineEnd === -1 ? input.value.length : lineEnd);
        input.value = before + replacement + after;
        input.selectionStart = input.selectionEnd = lineStart + replacement.length;
      } else {
        const before = input.value.substring(0, start);
        const after = input.value.substring(end);
        input.value = before + replacement + after;
        input.selectionStart = input.selectionEnd = start + replacement.length + (cursorOffset || 0);
      }
      input.focus();
      updatePreview();
      triggerToast(`Applied: ${cmd.toUpperCase()}`, "info");
    });
  });

  copyHtmlBtn.addEventListener("click", () => {
    const html = getHtmlDocument();
    navigator.clipboard.writeText(html).then(() => {
      triggerToast("Rendered HTML copied to clipboard!", "success");
    });
  });

  exportHtmlBtn.addEventListener("click", () => {
    const html = getHtmlDocument();
    const blob = new Blob([html], { type: "text/html" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "markdown-export.html";
    a.click();
    URL.revokeObjectURL(url);
    triggerToast("HTML file exported successfully!", "success");
  });

  // Load saved content
  try {
    const saved = localStorage.getItem("nt_md_content");
    if (saved) input.value = saved;
  } catch {}
  updatePreview();
</script>
