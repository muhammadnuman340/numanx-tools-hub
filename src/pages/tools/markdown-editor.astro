---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import Accordion from '../../components/ui/Accordion.astro';
import KeyboardHints from '../../components/KeyboardHints.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'Is my markdown content saved anywhere?',
    answer:
      "Your content is saved to your browser's localStorage so it persists between sessions. Nothing is uploaded to any server.",
  },
  {
    question: 'Can I export my markdown as HTML?',
    answer:
      "Yes. Click the 'Export HTML' button to download a complete HTML file with rendered content. You can also copy the markdown source or the rendered HTML.",
  },
  {
    question: 'Can I convert markdown to PDF?',
    answer:
      'Yes. Click "Export PDF" (or press Ctrl+P). Your markdown is rendered with Marked (GitHub Flavored Markdown), sanitized with DOMPurify, Mermaid code blocks become diagrams and LaTeX becomes KaTeX math, then your browser’s print dialog saves it as a PDF with selectable text. Pick A4 or US Letter and a GitHub Light, Academic Serif or Modern Minimal theme first.',
  },
  {
    question: 'Does the PDF export support LaTeX math and Mermaid diagrams?',
    answer:
      'Yes. Inline math ($E=mc^2$) and display equations ($$…$$) are rendered with KaTeX, and code blocks marked with ```mermaid become SVG diagrams. Switch the preview to "PDF page" to see them before exporting.',
  },
  {
    question: 'How do I add page breaks to my PDF?',
    answer:
      'Click "Page Break" in the PDF toolbar, or type <div class="page-break"></div> anywhere in your markdown. The PDF starts a new page at that point.',
  },
  {
    question: 'Is my document uploaded when I export a PDF?',
    answer:
      'No. The PDF is made by your own browser. The first time you use PDF export, the open-source Marked, DOMPurify, KaTeX and Mermaid libraries load from the jsDelivr CDN; your document text is never sent anywhere.',
  },
  {
    question: 'What markdown features are supported?',
    answer:
      'The editor supports headings (H1-H6), bold, italic, strikethrough, links, images, ordered/unordered lists, blockquotes, inline code, code blocks, horizontal rules, and tables.',
  },
  {
    question: 'Does it support dark mode?',
    answer:
      "The preview automatically follows the site's dark theme. The rendered output uses the same dark styling for consistency.",
  },
  {
    question: 'Can I use keyboard shortcuts?',
    answer:
      'Yes. Use the toolbar buttons or common shortcuts. The editor also supports tab for indentation and auto-closing of markdown syntax.',
  },
  {
    question: 'Can I use markdown for GitHub README files?',
    answer:
      'Absolutely. This editor uses standard GitHub-flavored markdown syntax. Write your README here, preview it live, and copy the source directly to your repository.',
  },
  {
    question: 'Does the editor support live preview?',
    answer:
      'Yes, the split-pane layout shows your raw markdown on the left and a fully rendered HTML preview on the right. Updates happen in real-time as you type.',
  },
  {
    question: 'What is the difference between markdown and rich text?',
    answer:
      "Markdown uses plain text formatting syntax that is readable as-is, while rich text uses hidden formatting codes. Markdown is preferred for documentation because it's version-control friendly and portable.",
  },
];
const schema = {
  name: 'Markdown Editor & PDF Converter',
  applicationCategory: 'Web Application',
  description:
    'Live markdown editor with split-pane preview, formatting toolbar, syntax highlighting, HTML export and Markdown to PDF export with LaTeX math and Mermaid diagrams.',
  featureList: [
    'Markdown to PDF export through the browser print dialog (A4 or US Letter)',
    'LaTeX math (KaTeX) and Mermaid diagrams in PDF export',
    'PDF themes: GitHub Light, Academic Serif, Modern Minimal; page breaks and document templates',
    'Real-time split-pane markdown preview',
    'Formatting toolbar with common markdown actions',
    'HTML export with styled output',
    'Copy rendered HTML to clipboard',
    'Auto-saves content to localStorage',
    'Full markdown syntax support including tables and code blocks',
  ],
};

const benefits = [
  {
    icon: '⚡',
    title: 'Real-Time Preview',
    desc: 'See your markdown rendered instantly in a split-pane view. Type on the left, see the formatted result on the right with zero delay.',
  },
  {
    icon: '🎨',
    title: 'Rich Formatting Toolbar',
    desc: 'Bold, italic, headings, lists, tables, code blocks, and more — all available with one click from the toolbar. No need to remember syntax.',
  },
  {
    icon: '⬇️',
    title: 'HTML & PDF Export',
    desc: 'Export a standalone HTML file, download the .md source, or save a themed PDF with page breaks, LaTeX math and Mermaid diagrams.',
  },
  {
    icon: '💾',
    title: 'Auto-Save Draft',
    desc: 'Your content is automatically saved to localStorage. Refresh the page or come back later — your work is always there.',
  },
  {
    icon: '🔧',
    title: 'Full Syntax Support',
    desc: 'Support for all GitHub-flavored markdown including tables, fenced code blocks, images, links, strikethrough, and horizontal rules.',
  },
  {
    icon: '🆓',
    title: 'Completely Free',
    desc: 'No sign-ups, no limits. Use the markdown editor as much as you need for docs, READMEs, notes, and more.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Type Markdown',
    desc: 'Start typing markdown in the left panel. Use the toolbar for quick formatting — bold, italic, headings, lists, and more.',
  },
  {
    num: '2',
    title: 'Preview Live',
    desc: 'Watch the right panel update in real-time as you type. The rendered preview shows exactly how your content will look.',
  },
  {
    num: '3',
    title: 'Copy or Export',
    desc: 'Copy the rendered HTML, export an HTML file, download the .md source, or choose a page size and theme and click Export PDF.',
  },
  {
    num: '4',
    title: 'Come Back Anytime',
    desc: 'Your content auto-saves to your browser. Close and return later — your markdown will be right where you left it.',
  },
];

const useCases = [
  {
    icon: '📝',
    title: 'Writing Documentation',
    desc: 'Write project documentation, API guides, and technical docs with proper formatting. Export as HTML for your documentation site.',
  },
  {
    icon: '📖',
    title: 'README Files',
    desc: 'Craft polished README files for your GitHub repositories. Preview headings, code blocks, tables, and badges before committing.',
  },
  {
    icon: '📋',
    title: 'Meeting Notes',
    desc: 'Take structured meeting notes with headings, bullet points, and action items. The auto-save feature ensures you never lose notes.',
  },
  {
    icon: '✍️',
    title: 'Blog Writing',
    desc: 'Write blog posts in markdown format. Preview the rendered output and export HTML for direct publishing to your CMS.',
  },
];
---

<MainLayout
  title="Markdown Editor & Markdown to PDF — Live Preview, HTML & PDF Export | NumanX"
  description="Free online markdown editor with live preview. Write and format markdown, export HTML, or convert markdown to PDF with LaTeX math, Mermaid diagrams, page breaks and print themes."
  keywords="markdown editor, online markdown editor, markdown to pdf, convert markdown to pdf online, md to pdf, markdown creator, markdown file creator, live markdown preview, markdown to html, latex markdown to pdf, mermaid to pdf"
  toolSchema={schema}
  faq={faqItems}
  howto={{
    name: 'How to Write Markdown and Export HTML or PDF',
    description: 'Write and preview markdown in real-time with a rich toolbar, then export HTML or PDF in 4 easy steps.',
    steps: howToSteps.map((s) => ({ title: s.title, text: s.desc })),
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Markdown Editor & PDF', url: '/tools/markdown-editor/' },
  ]}
>
  <main class="min-h-screen pt-6 sm:pt-8 pb-20 px-4 sm:px-6 relative overflow-hidden">
    <div class="max-w-6xl mx-auto">
      <ToolHeader
        title="Markdown Editor"
        gradient="& PDF Converter"
        desc="Markdown Editor shows a live preview beside your text as you write. Use the toolbar for headings, lists, links and code blocks, then copy the result, export it as HTML, or export a PDF with page breaks, LaTeX math and Mermaid diagrams. It suits README files, documentation, reports and notes, and everything you type stays in your browser."
        updated="2026-11-02"
        badge="✦ Client-Side"
        slug="markdown-editor"
      />


      <!-- Tool Interface -->
      <div class="mt-8 space-y-4">
        <!-- Toolbar -->
        <div class="glass-card rounded-xl p-3">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold text-zinc-300">Tool</span>
            <button
              id="fullscreen-btn"
              class="p-1.5 rounded-lg bg-surface-2 border border-surface text-zinc-300 hover:text-white hover:border-amber-500/40 transition-all text-xs"
              title="Fullscreen"
              aria-label="Toggle Fullscreen">⛶</button
            >
          </div>
          <div class="flex flex-wrap items-center gap-1">
            {
              [
                { cmd: 'bold', label: 'B', style: 'font-bold' },
                { cmd: 'italic', label: 'I', style: 'italic font-serif' },
                { cmd: 'strike', label: 'S', style: 'line-through' },
                { cmd: '|' },
                { cmd: 'h1', label: 'H1', style: 'font-bold' },
                { cmd: 'h2', label: 'H2', style: 'font-bold' },
                { cmd: 'h3', label: 'H3', style: 'font-bold' },
                { cmd: '|' },
                { cmd: 'link', label: '🔗' },
                { cmd: 'img', label: '🖼' },
                { cmd: '|' },
                { cmd: 'ul', label: '• List' },
                { cmd: 'ol', label: '1. List' },
                { cmd: 'quote', label: '❝' },
                { cmd: 'code', label: '<>' },
                { cmd: 'hr', label: '—' },
                { cmd: '|' },
                { cmd: 'table', label: '⊞ Table' },
              ].map((item) =>
                item.cmd === '|' ? (
                  <span class="w-px h-5 bg-white/10 mx-1 self-center" />
                ) : (
                  <button
                    type="button"
                    class={`toolbar-btn px-2.5 py-1.5 rounded-lg text-xs font-medium text-zinc-300 hover:text-white hover:bg-surface-3 transition-all active:scale-95 ${item.style || ''}`}
                    data-cmd={item.cmd}
                    title={item.cmd.toUpperCase()}
                    aria-label={`Insert ${item.cmd}`}
                  >
                    {item.label}
                  </button>
                ),
              )
            }
          </div>

          <!-- PDF export -->
          <div id="md-pdf-tools" class="flex flex-wrap items-center gap-2 mt-3 pt-3 border-t border-surface">
            <span class="text-xs font-semibold text-zinc-300 mr-1">PDF</span>
            <select id="md-template-select" aria-label="Insert a document template" class="min-h-[36px] px-3 py-1.5 rounded-xl bg-surface-2 border border-surface text-xs font-mono text-zinc-200 focus:border-amber-500 focus:outline-none cursor-pointer">
              <option value="">Insert template…</option>
              <option value="tech-report">Architecture & Technical Spec</option>
              <option value="academic">Academic Research Paper</option>
              <option value="readme">Project Documentation & README</option>
              <option value="empty">Blank Document</option>
            </select>
            <select id="md-pagesize-select" aria-label="PDF page size" class="min-h-[36px] px-3 py-1.5 rounded-xl bg-surface-2 border border-surface text-xs font-mono text-zinc-200 focus:border-amber-500 focus:outline-none cursor-pointer">
              <option value="a4">A4 (210×297mm)</option>
              <option value="letter">US Letter (8.5×11")</option>
            </select>
            <select id="md-theme-select" aria-label="PDF theme" class="min-h-[36px] px-3 py-1.5 rounded-xl bg-surface-2 border border-surface text-xs font-mono text-zinc-200 focus:border-amber-500 focus:outline-none cursor-pointer">
              <option value="theme-github">GitHub Light</option>
              <option value="theme-academic">Academic Serif</option>
              <option value="theme-minimal">Modern Minimal</option>
            </select>
            <button type="button" id="md-insert-pagebreak" class="min-h-[36px] px-3 py-1.5 rounded-xl bg-surface-2 hover:bg-surface-3 border border-surface text-xs font-mono text-zinc-300 hover:text-white transition-all cursor-pointer flex items-center gap-1.5" title="Insert a page break for the PDF">
              <span aria-hidden="true">✂️</span> Page Break
            </button>
            <button type="button" id="download-btn" class="min-h-[36px] px-3 py-1.5 rounded-xl bg-surface-2 hover:bg-surface-3 border border-surface text-xs font-mono text-zinc-300 hover:text-white transition-all cursor-pointer flex items-center gap-1.5" title="Download the markdown source">
              <span aria-hidden="true">💾</span> .md
            </button>
            <button
              type="button"
              id="md-print-pdf-btn"
              class="min-h-[36px] px-4 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-accent-fg font-semibold text-xs font-mono uppercase tracking-wider transition-all cursor-pointer flex items-center gap-2 active:scale-[0.98] disabled:opacity-55 disabled:cursor-not-allowed"
            >
              <span aria-hidden="true">🖨️</span> <span id="md-print-pdf-label">Export PDF</span>
            </button>
          </div>
        </div>

        <!-- Editor + Preview -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-start">
          <!-- Editor Column -->
          <div class="flex flex-col">
            <div class="flex items-center justify-between min-h-[38px] mb-2">
              <div class="flex items-center gap-2">
                <label for="md-input" class="text-xs font-semibold text-zinc-300">Markdown</label>
                <span id="md-stats" class="text-[11px] text-zinc-400 font-mono bg-white/5 px-2 py-0.5 rounded-md border border-white/5">0 words</span>
              </div>
              <div class="flex items-center gap-1.5">
                <div class="flex items-center gap-0.5 bg-surface-2 p-0.5 rounded-lg border border-surface">
                  <button
                    type="button"
                    aria-label="Decrease editor font size"
                    class="font-dec px-2 py-1 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                    >A−</button
                  >
                  <button
                    type="button"
                    aria-label="Increase editor font size"
                    class="font-inc px-2 py-1 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                    >A+</button
                  >
                </div>
                <button
                  id="toggle-linenums-btn"
                  type="button"
                  class="text-xs font-medium text-zinc-300 hover:text-white px-2.5 py-1.5 rounded-lg border border-surface hover:bg-surface-2 transition-all"
                  title="Toggle Line Numbers"
                  ># Numbers</button
                >
                <button
                  id="clear-btn"
                  type="button"
                  class="text-xs font-medium text-zinc-300 hover:text-white px-2.5 py-1.5 rounded-lg border border-surface hover:bg-surface-2 transition-all"
                  >Clear</button
                >
              </div>
            </div>

            <!-- The Editor Box (h-[520px]) -->
            <div class="flex h-[520px] rounded-xl bg-black/40 border border-surface focus-within:border-amber-500 focus-within:ring-1 focus-within:ring-amber-500 transition-all overflow-hidden relative">
              <div
                id="line-nums"
                class="w-12 shrink-0 h-full select-none overflow-hidden font-mono text-sm leading-6 text-right pr-3.5 py-3 text-zinc-500/80 bg-zinc-950/60 border-r border-white/5 whitespace-pre pointer-events-none tabular-nums"
                style="line-height: 24px; font-size: 14px;"
              >1</div>
              <textarea
                id="md-input"
                data-code-lang="markdown"
                aria-label="Markdown text input"
                class="flex-1 min-w-0 h-full bg-transparent text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 px-4 py-3 focus:outline-none font-mono resize-none border-0 overflow-y-auto"
                style="line-height: 24px; font-size: 14px;"
                placeholder="Type your markdown here..."
              ></textarea>
            </div>

            <div class="flex items-center justify-between text-xs text-zinc-400 mt-2 px-1">
              <span id="reading-time">0m read · 0m speak</span>
              <span class="text-zinc-500 text-[11px]">Ctrl+Enter to process</span>
            </div>
            <div id="letter-freq" tabindex="0" role="region" aria-label="Character frequency breakdown" class="mt-2 flex flex-wrap gap-1.5 hidden"></div>
          </div>

          <!-- Preview Column -->
          <div class="flex flex-col">
            <div class="flex items-center justify-between min-h-[38px] mb-2">
              <div class="flex items-center gap-2">
                <label class="text-xs font-semibold text-zinc-300">Preview</label>
                <span id="usage-badge" class="text-[11px] text-amber-300 font-mono bg-amber-500/10 px-2 py-0.5 rounded-md border border-amber-500/20">Live</span>
              </div>
              <div class="flex items-center gap-1.5 flex-wrap justify-end">
                <div class="flex items-center gap-0.5 bg-surface-2 p-0.5 rounded-lg border border-surface" role="group" aria-label="Preview mode">
                  <button type="button" class="preview-mode px-2.5 py-1 rounded text-xs font-medium text-zinc-300 hover:text-white transition-all aria-pressed:bg-amber-600 aria-pressed:text-accent-fg" data-mode="html" aria-pressed="true">HTML</button>
                  <button type="button" class="preview-mode px-2.5 py-1 rounded text-xs font-medium text-zinc-300 hover:text-white transition-all aria-pressed:bg-amber-600 aria-pressed:text-accent-fg" data-mode="pdf" aria-pressed="false">PDF page</button>
                </div>
                <button
                  id="share-btn"
                  class="text-xs font-medium text-zinc-300 hover:text-white px-2.5 py-1.5 rounded-lg border border-surface hover:bg-surface-2 transition-all"
                  title="Share"
                  aria-label="Share Markdown content">🔗</button
                >
                <select
                  id="export-format"
                  aria-label="Export file format"
                  title="Export file format"
                  class="bg-surface-2 border border-surface text-xs text-zinc-200 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-amber-500"
                >
                  <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option
                  ><option value="html">HTML</option>
                </select>
                <button
                  id="copy-html-btn"
                  class="text-xs font-medium text-zinc-300 hover:text-white px-2.5 py-1.5 rounded-lg border border-surface hover:bg-surface-2 transition-all"
                  >Copy HTML</button
                >
                <button
                  id="export-html-btn"
                  class="text-xs font-medium text-zinc-300 hover:text-white px-2.5 py-1.5 rounded-lg border border-surface hover:bg-surface-2 transition-all"
                  >Export HTML</button
                >
              </div>
            </div>

            <!-- The Preview Box (h-[520px]) -->
            <div
              id="md-preview"
              role="region"
              aria-label="Markdown Live Preview"
              tabindex="0"
              class="w-full h-[520px] overflow-y-auto bg-black/40 border border-surface rounded-xl px-4 py-3 text-sm text-zinc-200 prose prose-invert max-w-none focus:outline-none focus:ring-1 focus:ring-amber-500"
            >
            </div>

            <!-- PDF page preview (same rendering as Export PDF) -->
            <div
              id="pdf-preview-wrap"
              role="region"
              aria-label="PDF page preview"
              tabindex="0"
              class="hidden w-full h-[520px] overflow-y-auto rounded-xl bg-zinc-950/60 p-4 sm:p-6 border border-surface justify-center focus:outline-none focus:ring-1 focus:ring-amber-500"
            >
              <div
                id="pdf-paper-sheet"
                class="theme-github w-full max-w-[680px] bg-white text-zinc-900 p-6 sm:p-12 rounded-lg shadow-2xl min-h-full font-sans transition-all"
              >
                <div id="pdf-preview-content" class="markdown-body"><p>Loading PDF engine…</p></div>
              </div>
            </div>

            <div class="flex items-center justify-between text-xs text-zinc-400 mt-2 px-1">
              <span class="text-zinc-500 text-[11px]">Rendered in real-time</span>
              <span class="text-zinc-500 text-[11px]">Client-side only</span>
            </div>
          </div>
        </div>

        <!-- Info -->
        <div class="glass-card rounded-2xl p-4 text-xs text-muted leading-relaxed">
          <strong class="text-tertiary">Supports:</strong> H1-H6, bold, italic, strikethrough, links, images, ordered/unordered
          lists, blockquotes, inline code, fenced code blocks, horizontal rules, tables, and line breaks. Content auto-saves
          to your browser. <strong class="text-tertiary">PDF export</strong> also renders GitHub Flavored Markdown task lists,
          LaTeX math ($…$ and $$…$$), Mermaid diagrams and page breaks.
        </div>
      </div>

      <!-- FAQ -->
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="text-amber-400">Questions</span>
        </h2>
        <Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>

      <KeyboardHints
        hints={[
          { keys: 'Ctrl+B', label: 'Bold' },
          { keys: 'Ctrl+I', label: 'Italic' },
          { keys: 'Ctrl+P', label: 'Export PDF' },
          { keys: 'Ctrl+D', label: 'Download .md' },
          { keys: '⌘K', label: 'Open search' },
        ]}
      />

      <ToolContentSections
        toolSlug="markdown-editor"
        toolName="Markdown Editor & PDF Converter"
        category="Creator Tools"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />

      <!-- ─── CTA Section ─── -->
      <section class="mt-16 text-center">
        <div
          class="max-w-2xl mx-auto border border-amber-500/20 rounded-xl p-8 md:p-10 bg-amber-600/10"
        >
          <h2 class="text-2xl md:text-3xl font-black tracking-tight">
            Start Writing
            <span class="text-amber-400">
              Markdown Free</span
            >
          </h2>
          <p class="text-tertiary mt-3 max-w-lg mx-auto text-sm leading-relaxed">
            No sign-up required. No limits. Write, preview, and export markdown documents completely free.
          </p>
          <div class="mt-6 flex gap-3 justify-center flex-wrap">
            <button
              onclick="document.querySelector('#md-input')?.focus()"
              class="px-6 py-3 rounded-xl bg-amber-600 hover:bg-amber-500 text-accent-fg font-semibold text-sm transition-all active:scale-[0.97] shadow-lg shadow-amber-900/30"
            >
              Start Writing
            </button>
            <a
              href="#md-pdf-tools"
              class="px-6 py-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-semibold text-sm transition-all border border-zinc-700"
            >
              Convert Markdown to PDF
            </a>
          </div>
        </div>
      </section>

    </div>

    <!-- Print-only copy of the document for Export PDF (moved to <body> by the script) -->
    <div id="pdf-print-root" aria-hidden="true">
      <div id="pdf-print-sheet" class="theme-github bg-white text-zinc-900 font-sans">
        <div id="pdf-print-content" class="markdown-body"></div>
      </div>
    </div>
  </main>
</MainLayout>

<style is:global>
  /* ─── PDF export (same output as the retired Markdown to PDF page) ─── */
  #pdf-print-root {
    display: none;
  }
  @media print {
    html.md-pdf-printing body > *:not(#pdf-print-root) {
      display: none !important;
    }
    html.md-pdf-printing,
    html.md-pdf-printing body {
      background: white !important;
    }
    html.md-pdf-printing #pdf-print-root {
      display: block !important;
    }
    #pdf-print-sheet {
      width: 100% !important;
      max-width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
      box-shadow: none !important;
      background: white !important;
      color: black !important;
    }
    #pdf-print-sheet .page-break {
      page-break-before: always !important;
      break-before: page !important;
      height: 0 !important;
      margin: 0 !important;
      border: none !important;
    }
    #pdf-print-sheet .page-break::after {
      content: none !important;
    }
    #pdf-print-sheet pre,
    #pdf-print-sheet blockquote,
    #pdf-print-sheet table {
      page-break-inside: avoid !important;
      break-inside: avoid !important;
    }
  }

  /* ─── Document Theme Typography ─── */
  .theme-github {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    color: #1f2328;
    line-height: 1.6;
  }
  .theme-github h1,
  .theme-github h2,
  .theme-github h3 {
    color: #1f2328;
    font-weight: 600;
    border-bottom: 1px solid #d0d7de;
    padding-bottom: 0.3em;
    margin-top: 24px;
    margin-bottom: 16px;
  }
  .theme-github h1 { font-size: 2em; }
  .theme-github h2 { font-size: 1.5em; }
  .theme-github h3 { font-size: 1.25em; }
  .theme-github p { margin-bottom: 16px; }
  .theme-github code {
    background: #f6f8fa;
    padding: 0.2em 0.4em;
    border-radius: 6px;
    font-size: 85%;
    font-family: ui-monospace, SFMono-Regular, monospace;
  }
  .theme-github pre {
    background: #f6f8fa;
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    border: 1px solid #d0d7de;
    margin-bottom: 16px;
  }
  .theme-github table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 16px;
  }
  .theme-github th,
  .theme-github td {
    padding: 8px 14px;
    border: 1px solid #d0d7de;
    text-align: left;
  }
  .theme-github th {
    background: #f6f8fa;
    font-weight: 600;
  }
  .theme-github blockquote {
    padding: 0 1em;
    color: #656d76;
    border-left: 0.25em solid #d0d7de;
    margin: 0 0 16px 0;
  }

  /* Academic Serif Theme */
  .theme-academic {
    font-family: 'Times New Roman', Times, Georgia, serif;
    color: #111111;
    line-height: 1.7;
    font-size: 11pt;
  }
  .theme-academic h1 {
    font-size: 18pt;
    text-align: center;
    margin-bottom: 24px;
  }
  .theme-academic h2 {
    font-size: 14pt;
    margin-top: 20px;
    margin-bottom: 12px;
    border-bottom: 1px solid #333;
  }
  .theme-academic p {
    text-align: justify;
    margin-bottom: 14px;
  }

  /* Page Break Visual Divider in the PDF page preview */
  #pdf-paper-sheet .page-break {
    border-top: 2px dashed var(--accent);
    margin: 32px 0;
    position: relative;
  }
  #pdf-paper-sheet .page-break::after {
    content: 'PAGE BREAK';
    position: absolute;
    top: -10px;
    right: 16px;
    background: var(--accent);
    color: var(--accent-fg);
    font-size: 9px;
    font-family: monospace;
    padding: 2px 6px;
    border-radius: 4px;
  }
</style>

<script>
  import { initCodeHighlight } from '../../lib/codeHighlight';
  initCodeHighlight();

  import { setToolStatusSoon } from '../../lib/toolStatus';

  const input = document.getElementById('md-input') as HTMLTextAreaElement;
  const preview = document.getElementById('md-preview');
  const statsEl = document.getElementById('md-stats');
  const copyHtmlBtn = document.getElementById('copy-html-btn');
  const exportHtmlBtn = document.getElementById('export-html-btn');

  function escapeHtml(text: string): string {
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function renderMarkdown(src: string, isExport: boolean = false): string {
    let html = '';

    // Split into blocks, preserving order
    const lines = src.split('\n');
    let inCodeBlock = false;
    let inTable = false;
    let inUl = false;
    let inOl = false;
    let tableRows: string[] = [];
    let codeContent: string[] = [];
    let codeLang = '';

    function flushList() {
      if (inUl) {
        html += '</ul>\n';
        inUl = false;
      }
      if (inOl) {
        html += '</ol>\n';
        inOl = false;
      }
    }

    function flushTable() {
      if (tableRows.length > 0) {
        const headerCells = tableRows[0].split('|').filter(Boolean);
        const isHeader = tableRows.length > 1 && tableRows[1].trim().match(/^[\|:\s\-]+$/);
        let start = 0;
        if (isHeader) start = 2;
        html += '<div class="overflow-x-auto my-3"><table class="w-full text-left border-collapse text-xs text-zinc-200 border border-white/10"><thead class="bg-white/5 border-b border-white/10"><tr>';
        headerCells.forEach((c) => {
          html += `<th class="p-2 font-semibold text-white border-r border-white/10 last:border-r-0">${inlineMd(c.trim())}</th>`;
        });
        html += '</tr></thead><tbody>';
        for (let i = start; i < tableRows.length; i++) {
          const cells = tableRows[i].split('|').filter(Boolean);
          html += '<tr class="border-b border-white/5 last:border-b-0 hover:bg-white/[0.02]">' + cells.map((c) => `<td class="p-2 border-r border-white/5 last:border-r-0">${inlineMd(c.trim())}</td>`).join('') + '</tr>';
        }
        html += '</tbody></table></div>\n';
        tableRows = [];
      }
    }

    function inlineMd(text: string): string {
      let s = escapeHtml(text);
      // Images: only web addresses and inline data images
      s = s.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (_m: string, alt: string, src: string) =>
        /^(https?:|data:image\/)/i.test(src.trim())
          ? `<img src="${src.trim()}" alt="${alt}" class="max-w-full rounded-lg my-2 border border-white/10" />`
          : alt,
      );
      // Links: only web and mail addresses; other schemes (javascript:, data:) stay plain text
      s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_m: string, label: string, href: string) =>
        /^(https?:|mailto:)/i.test(href.trim())
          ? `<a href="${href.trim()}" class="text-amber-400 hover:text-amber-300 underline font-medium" target="_blank" rel="noopener noreferrer">${label}</a>`
          : label,
      );
      // Bold+Italic
      s = s.replace(/\*\*\*(.+?)\*\*\*/g, '<strong class="text-white font-bold"><em class="text-zinc-100">$1</em></strong>');
      // Bold
      s = s.replace(/\*\*(.+?)\*\*/g, '<strong class="text-white font-bold">$1</strong>');
      s = s.replace(/__(.+?)__/g, '<strong class="text-white font-bold">$1</strong>');
      // Italic
      s = s.replace(/\*(.+?)\*/g, '<em class="text-zinc-200 italic">$1</em>');
      s = s.replace(/_(.+?)_/g, '<em class="text-zinc-200 italic">$1</em>');
      // Strikethrough
      s = s.replace(/~~(.+?)~~/g, '<del class="text-zinc-500 line-through">$1</del>');
      // Inline code
      s = s.replace(/`([^`]+)`/g, '<code class="bg-white/10 text-amber-300 border border-white/10 px-1.5 py-0.5 rounded text-xs font-mono">$1</code>');
      return s;
    }

    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];

      // Code block
      if (line.trim().startsWith('```')) {
        if (!inCodeBlock) {
          flushList();
          flushTable();
          inCodeBlock = true;
          codeLang = line.trim().slice(3).trim();
          codeContent = [];
          continue;
        } else {
          const code = escapeHtml(codeContent.join('\n'));
          html += `<pre class="bg-zinc-950/80 border border-white/10 rounded-xl p-4 my-3 overflow-x-auto"><code class="text-sm text-zinc-200 font-mono">${code}</code></pre>\n`;
          inCodeBlock = false;
          continue;
        }
      }
      if (inCodeBlock) {
        codeContent.push(line);
        continue;
      }

      // Table
      if (line.includes('|') && line.trim().startsWith('|')) {
        flushList();
        inTable = true;
        tableRows.push(line);
        continue;
      } else if (inTable) {
        flushTable();
        inTable = false;
      }

      // Horizontal rule
      if (/^(-{3,}|\*{3,}|_{3,})\s*$/.test(line.trim())) {
        flushList();
        flushTable();
        html += '<hr class="border-white/10 my-4" />\n';
        continue;
      }

      // Headings
      const hMatch = line.match(/^(#{1,6})\s+(.+)$/);
      if (hMatch) {
        flushList();
        flushTable();
        const rawLevel = hMatch[1].length;
        // In the live page preview, map # -> h2, ## -> h3, etc. so the preview headings don't conflict with the page H1
        const level = isExport ? rawLevel : Math.min(6, rawLevel + 1);
        const sizeClasses = level <= 2 ? 'text-xl' : level === 3 ? 'text-lg' : 'text-base';
        html += `<h${level} class="font-bold text-white mt-5 mb-2 ${sizeClasses}">${inlineMd(hMatch[2])}</h${level}>\n`;
        continue;
      }

      // Blockquote
      if (line.trim().startsWith('> ')) {
        flushList();
        flushTable();
        const content = line.trim().slice(2);
        html += `<blockquote class="border-l-2 border-amber-500/60 pl-4 my-2 text-zinc-300 italic bg-white/[0.02] py-1 rounded-r">${inlineMd(content)}</blockquote>\n`;
        continue;
      }

      // Unordered list
      const ulMatch = line.match(/^(\s*)[*\-+]\s+(.+)$/);
      if (ulMatch) {
        flushTable();
        if (inOl) flushList();
        if (!inUl) {
          html += '<ul class="list-disc list-inside my-2 space-y-1">\n';
          inUl = true;
        }
        html += `<li class="ml-4 text-zinc-200">${inlineMd(ulMatch[2])}</li>\n`;
        continue;
      }

      // Ordered list
      const olMatch = line.match(/^(\s*)\d+\.\s+(.+)$/);
      if (olMatch) {
        flushTable();
        if (inUl) flushList();
        if (!inOl) {
          html += '<ol class="list-decimal list-inside my-2 space-y-1">\n';
          inOl = true;
        }
        html += `<li class="ml-4 text-zinc-200">${inlineMd(olMatch[2])}</li>\n`;
        continue;
      }

      // Empty line
      if (line.trim() === '') {
        flushList();
        html += '<div class="h-4" aria-hidden="true"></div>\n';
        continue;
      }

      // Regular paragraph
      flushList();
      flushTable();
      html += `<p class="my-1.5 text-zinc-200 leading-relaxed">${inlineMd(line)}</p>\n`;
    }

    flushList();
    if (inCodeBlock) {
      const code = escapeHtml(codeContent.join('\n'));
      html += `<pre class="bg-zinc-950/80 border border-white/10 rounded-xl p-4 my-3 overflow-x-auto"><code class="text-sm text-zinc-200 font-mono">${code}</code></pre>\n`;
    }
    if (inTable) flushTable();

    return html;
  }

  function triggerToast(message: string, variant: 'success' | 'error' | 'info' | 'warning' = 'success') {
    if ((window as any).__showToast) {
      (window as any).__showToast({ message, variant });
    }
  }

  function updatePreview() {
    const src = input.value;
    const html = renderMarkdown(src);
    preview.innerHTML = html;
    const words = src.trim() ? src.trim().split(/\s+/).length : 0;
    statsEl.textContent = `${words} words`;
    try {
      localStorage.setItem('nt_md_content', src);
    } catch {}
  }

  function getHtmlDocument(): string {
    const content = renderMarkdown(input.value, true);
    return `<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Markdown Export</title><style>body{max-width:800px;margin:0 auto;padding:2rem;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;line-height:1.6;color:#1a1a2e;background:#fff}h1,h2,h3{color:#111}code{background:#f0f0f0;padding:0.2em 0.4em;border-radius:3px;font-size:0.9em}pre{background:#f5f5f5;padding:1rem;border-radius:8px;overflow-x:auto}pre code{background:none;padding:0}img{max-width:100%;border-radius:8px}blockquote{border-left:3px solid #d99a2b;padding-left:1rem;color:#555;margin:1rem 0}table{border-collapse:collapse;width:100%;margin:1rem 0}th,td{border:1px solid #ddd;padding:0.5rem;text-align:left}th{background:#f5f5f5}ul,ol{margin:1rem 0;padding-left:1.5rem}</style></head><body>${content}</body></html>`;
  }

  input.addEventListener('input', () => {
    updatePreview();
    setToolStatusSoon('complete', `Preview updated, ${statsEl.textContent}.`);
  });

  // Toolbar
  document.querySelectorAll('.toolbar-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cmd = (btn as HTMLElement).dataset.cmd;
      const start = input.selectionStart;
      const end = input.selectionEnd;
      const selected = input.value.substring(start, end);
      const lineStart = input.value.lastIndexOf('\n', start - 1) + 1;
      const lineEnd = input.value.indexOf('\n', end);
      const fullLine = input.value.substring(lineStart, lineEnd === -1 ? input.value.length : lineEnd);

      let replacement = '';
      let cursorOffset = 0;

      switch (cmd) {
        case 'bold':
          replacement = `**${selected || 'bold'}**`;
          cursorOffset = selected ? 0 : 2;
          break;
        case 'italic':
          replacement = `*${selected || 'italic'}*`;
          cursorOffset = selected ? 0 : 1;
          break;
        case 'strike':
          replacement = `~~${selected || 'strikethrough'}~~`;
          cursorOffset = selected ? 0 : 2;
          break;
        case 'h1':
          replacement = `# ${fullLine.trim() || 'Heading 1'}`;
          cursorOffset = 2;
          break;
        case 'h2':
          replacement = `## ${fullLine.trim() || 'Heading 2'}`;
          cursorOffset = 3;
          break;
        case 'h3':
          replacement = `### ${fullLine.trim() || 'Heading 3'}`;
          cursorOffset = 4;
          break;
        case 'link':
          replacement = `[${selected || 'link text'}](url)`;
          cursorOffset = selected ? 0 : -1;
          break;
        case 'img':
          replacement = `![${selected || 'alt text'}](image-url)`;
          cursorOffset = selected ? 0 : -1;
          break;
        case 'ul':
          replacement = `- ${selected || 'list item'}`;
          cursorOffset = 2;
          break;
        case 'ol':
          replacement = `1. ${selected || 'list item'}`;
          cursorOffset = 3;
          break;
        case 'quote':
          replacement = `> ${selected || 'blockquote'}`;
          cursorOffset = 2;
          break;
        case 'code':
          replacement = '```\n' + (selected || 'code') + '\n```';
          cursorOffset = selected ? 0 : 1;
          break;
        case 'hr':
          replacement = '\n---\n';
          cursorOffset = 1;
          break;
        case 'table':
          replacement = '| Header 1 | Header 2 | Header 3 |\n| --- | --- | --- |\n| Cell 1 | Cell 2 | Cell 3 |';
          cursorOffset = 0;
          break;
      }

      if (cmd === 'h1' || cmd === 'h2' || cmd === 'h3') {
        const before = input.value.substring(0, lineStart);
        const after = input.value.substring(lineEnd === -1 ? input.value.length : lineEnd);
        input.value = before + replacement + after;
        input.selectionStart = input.selectionEnd = lineStart + replacement.length;
      } else {
        const before = input.value.substring(0, start);
        const after = input.value.substring(end);
        input.value = before + replacement + after;
        input.selectionStart = input.selectionEnd = start + replacement.length + (cursorOffset || 0);
      }
      input.focus();
      updatePreview();
      triggerToast(`Applied: ${cmd.toUpperCase()}`, 'info');
    });
  });

  copyHtmlBtn.addEventListener('click', () => {
    const html = getHtmlDocument();
    navigator.clipboard.writeText(html).then(() => {
      triggerToast('Rendered HTML copied to clipboard!', 'success');
    });
  });

  exportHtmlBtn.addEventListener('click', () => {
    const html = getHtmlDocument();
    const blob = new Blob([html], { type: 'text/html' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'markdown-export.html';
    a.click();
    URL.revokeObjectURL(url);
    triggerToast('HTML file exported successfully!', 'success');
  });

  const DEFAULT_CONTENT = `# Hello World

Start typing **markdown** on the left, see the *rendered* preview on the right.

## Features
- Headings (H1-H6)
- **Bold**, *italic*, ~~strikethrough~~
- [Links](https://example.com)
- Code blocks with \`inline code\`
- Tables, lists, and more
`;

  document.getElementById('clear-btn')?.addEventListener('click', () => {
    input.value = '';
    updatePreview();
    const n = document.getElementById('line-nums');
    if (n) n.textContent = '1';
    try {
      localStorage.removeItem('nt_md_content');
      localStorage.removeItem('nt_draft_markdown-editor');
    } catch {}
  });

  // Load saved content or set clean default
  try {
    const saved = localStorage.getItem('nt_md_content');
    if (saved && saved.trim()) {
      input.value = saved;
    } else {
      input.value = DEFAULT_CONTENT;
    }
  } catch {
    input.value = DEFAULT_CONTENT;
  }
  updatePreview();

  // Fullscreen toggle
  document.getElementById('fullscreen-btn')?.addEventListener('click', () => {
    const card = document.getElementById('fullscreen-btn').closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
      document.getElementById('fullscreen-btn').textContent = '⛶';
    } else {
      card.requestFullscreen?.() || card.webkitRequestFullscreen?.();
      document.getElementById('fullscreen-btn').textContent = '✕';
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const btn = document.getElementById('fullscreen-btn');
    if (btn) btn.textContent = document.fullscreenElement ? '✕' : '⛶';
  });

  // Auto-save draft
  const DRAFT_KEY = 'nt_draft_markdown-editor';
  (function () {
    const input = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
    if (!input) return;
    try {
      const saved = localStorage.getItem(DRAFT_KEY);
      if (saved && !input.value) {
        input.value = saved;
        input.dispatchEvent(new Event('input'));
      }
    } catch (e) {}
    let saveTimer;
    input.addEventListener('input', () => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        try {
          localStorage.setItem(DRAFT_KEY, input.value);
        } catch (e) {}
      }, 500);
    });
  })();

  // Feature 1: Font size
  const updateEditorFontSize = (newSize: number) => {
    const clamped = Math.max(10, Math.min(24, newSize));
    const lineHeight = Math.round(clamped * 1.7);
    document.querySelectorAll('textarea').forEach((t) => {
      t.style.fontSize = clamped + 'px';
      t.style.lineHeight = lineHeight + 'px';
    });
    const lineNums = document.getElementById('line-nums');
    if (lineNums) {
      lineNums.style.fontSize = clamped + 'px';
      lineNums.style.lineHeight = lineHeight + 'px';
    }
    try {
      localStorage.setItem('nt_fs', String(clamped));
    } catch (e) {}
  };

  document.querySelector('.font-inc')?.addEventListener('click', () => {
    const current = parseInt(getComputedStyle(input).fontSize) || 14;
    updateEditorFontSize(current + 2);
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    const current = parseInt(getComputedStyle(input).fontSize) || 14;
    updateEditorFontSize(current - 2);
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) updateEditorFontSize(parseInt(s));
  } catch (e) {}

  // Feature 2: Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b = document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      document.getElementById('clear-btn')?.click();
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });

  // Feature 3: Usage badge
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['markdown-editor']) b.textContent = 'Used ' + u['markdown-editor'] + '×';
  } catch (e) {}

  // Feature 4: Share button
  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('output-text') || document.querySelector("[id$='result']");
    const t = o?.value || o?.textContent || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof showToast === 'function') {
      playPing();
      showToast('Link copied!');
    }
  });

  // Feature 5: Reading time
  const rt = document.getElementById('md-input');
  if (rt) {
    rt.addEventListener('input', () => {
      const w = rt.value ? rt.value.trim().split(/\s+/).length : 0;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent = Math.max(1, Math.round(w / 200)) + 'm read · ' + Math.max(1, Math.round(w / 150)) + 'm speak';
    });
    rt.dispatchEvent(new Event('input'));
  }

  // Feature 6: Line numbers with toggle & bidirectional sync scroll
  (function () {
    const li = document.getElementById('md-input') as HTMLTextAreaElement | null;
    const n = document.getElementById('line-nums');
    const toggleBtn = document.getElementById('toggle-linenums-btn');
    if (!li || !n) return;

    let showLines = true;
    try {
      const saved = localStorage.getItem('nt_md_linenums');
      if (saved !== null) showLines = saved === 'true';
    } catch {}

    const applyState = () => {
      n.style.display = showLines ? 'block' : 'none';
      if (toggleBtn) {
        toggleBtn.textContent = showLines ? '# Numbers (On)' : '# Numbers (Off)';
        toggleBtn.classList.toggle('text-amber-400', showLines);
      }
    };

    const updateLineNums = () => {
      const count = (li.value || '').split('\n').length;
      n.textContent = Array.from({ length: Math.max(1, count) }, (_, i) => i + 1).join('\n');
    };

    toggleBtn?.addEventListener('click', () => {
      showLines = !showLines;
      applyState();
      try {
        localStorage.setItem('nt_md_linenums', String(showLines));
      } catch {}
    });

    li.addEventListener('input', updateLineNums);

    let isEditorScrolling = false;
    let isPreviewScrolling = false;

    li.addEventListener('scroll', () => {
      n.scrollTop = li.scrollTop;
      if (!isPreviewScrolling && preview) {
        isEditorScrolling = true;
        const maxInputScroll = li.scrollHeight - li.clientHeight;
        const maxPreviewScroll = preview.scrollHeight - preview.clientHeight;
        if (maxInputScroll > 0 && maxPreviewScroll > 0) {
          const ratio = li.scrollTop / maxInputScroll;
          preview.scrollTop = ratio * maxPreviewScroll;
        }
        setTimeout(() => {
          isEditorScrolling = false;
        }, 50);
      }
    });

    if (preview) {
      preview.addEventListener('scroll', () => {
        if (!isEditorScrolling && li) {
          isPreviewScrolling = true;
          const maxInputScroll = li.scrollHeight - li.clientHeight;
          const maxPreviewScroll = preview.scrollHeight - preview.clientHeight;
          if (maxInputScroll > 0 && maxPreviewScroll > 0) {
            const ratio = preview.scrollTop / maxPreviewScroll;
            li.scrollTop = ratio * maxInputScroll;
            n.scrollTop = li.scrollTop;
          }
          setTimeout(() => {
            isPreviewScrolling = false;
          }, 50);
        }
      });
    }

    applyState();
    updateLineNums();
  })();

  // Feature 7: Sound effects
  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }

  // Feature 8: Export format
  document.getElementById('export-format')?.addEventListener('change', function () {});

  // Feature 9: Letter frequency
  (function () {
    const lf = document.getElementById('md-input');
    if (lf) {
      lf.addEventListener('input', () => {
        const t = lf.value.toLowerCase().replace(/[^a-z]/g, '');
        if (!t) {
          document.getElementById('letter-freq')?.classList.add('hidden');
          return;
        }
        const f = {};
        for (const c of t) f[c] = (f[c] || 0) + 1;
        const s = Object.entries(f)
          .sort((a, b) => b[1] - a[1])
          .slice(0, 8);
        const m = s[0] ? s[0][1] : 1;
        const el = document.getElementById('letter-freq');
        el.classList.remove('hidden');
        el.innerHTML = s
          .map(
            ([c, n]) =>
              `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-xs font-mono"><strong class="text-amber-400 uppercase">${c}</strong><span class="text-zinc-400">${n}</span></span>`,
          )
          .join('');
      });
    }
  })();

</script>

<script>
  // ─── PDF export, PDF page preview, templates, page breaks and .md download ───
  import { renderPdfMarkdown, PDF_TEMPLATES } from '../../lib/markdownPdf';
  import { setToolStatus } from '../../lib/toolStatus';

  const mdInput = document.getElementById('md-input') as HTMLTextAreaElement;
  const templateSelect = document.getElementById('md-template-select') as HTMLSelectElement;
  const pageSizeSelect = document.getElementById('md-pagesize-select') as HTMLSelectElement;
  const themeSelect = document.getElementById('md-theme-select') as HTMLSelectElement;
  const exportBtn = document.getElementById('md-print-pdf-btn') as HTMLButtonElement;
  const exportLabel = document.getElementById('md-print-pdf-label');
  const htmlPreview = document.getElementById('md-preview');
  const pdfPreviewWrap = document.getElementById('pdf-preview-wrap');
  const paperSheet = document.getElementById('pdf-paper-sheet');
  const pdfPreviewContent = document.getElementById('pdf-preview-content');
  const printRoot = document.getElementById('pdf-print-root');
  const printSheet = document.getElementById('pdf-print-sheet');
  const printContent = document.getElementById('pdf-print-content');
  const modeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.preview-mode'));
  const THEMES = ['theme-github', 'theme-academic', 'theme-minimal'];

  // The print container must sit directly in <body> so everything else can be hidden while printing
  if (printRoot && printRoot.parentElement !== document.body) document.body.appendChild(printRoot);

  function toast(message: string, variant: 'success' | 'error' | 'info' | 'warning' = 'success') {
    (window as any).__showToast?.({ message, variant });
  }

  function applyTheme(el: HTMLElement | null) {
    if (!el) return;
    el.classList.remove(...THEMES);
    el.classList.add(themeSelect?.value || 'theme-github');
  }

  // ─── PDF page preview ───
  let pdfMode = false;
  let pdfTimer: ReturnType<typeof setTimeout> | undefined;

  async function renderPdfPreview() {
    if (!pdfMode || !pdfPreviewContent) return;
    try {
      await renderPdfMarkdown(pdfPreviewContent, mdInput.value);
    } catch {
      pdfPreviewContent.innerHTML =
        '<p style="color:#b42318">Could not load the PDF engine. Check your connection and try again.</p>';
    }
  }

  function setPreviewMode(pdf: boolean) {
    pdfMode = pdf;
    modeBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.mode === 'pdf') === pdf)));
    htmlPreview?.classList.toggle('hidden', pdf);
    pdfPreviewWrap?.classList.toggle('hidden', !pdf);
    pdfPreviewWrap?.classList.toggle('flex', pdf);
    if (pdf) renderPdfPreview();
  }

  modeBtns.forEach((b) => b.addEventListener('click', () => setPreviewMode(b.dataset.mode === 'pdf')));

  mdInput?.addEventListener('input', () => {
    if (!pdfMode) return;
    clearTimeout(pdfTimer);
    pdfTimer = setTimeout(renderPdfPreview, 120);
  });

  // ─── Templates (replace the editor content) ───
  templateSelect?.addEventListener('change', () => {
    const tpl = PDF_TEMPLATES[templateSelect.value];
    templateSelect.value = '';
    if (!tpl) return;
    if (mdInput.value.trim() && !window.confirm('Replace your current markdown with this template?')) return;
    mdInput.value = tpl;
    mdInput.dispatchEvent(new Event('input', { bubbles: true }));
    toast('Template inserted', 'info');
  });

  // ─── Page size and theme ───
  pageSizeSelect?.addEventListener('change', () => {
    if (paperSheet) paperSheet.style.maxWidth = pageSizeSelect.value === 'letter' ? '640px' : '680px';
  });
  themeSelect?.addEventListener('change', () => {
    applyTheme(paperSheet);
    applyTheme(printSheet);
  });

  // ─── Page break ───
  document.getElementById('md-insert-pagebreak')?.addEventListener('click', () => {
    const start = mdInput.selectionStart;
    const end = mdInput.selectionEnd;
    const breakTag = '\n\n<div class="page-break"></div>\n\n';
    mdInput.value = mdInput.value.substring(0, start) + breakTag + mdInput.value.substring(end);
    mdInput.focus();
    mdInput.selectionStart = mdInput.selectionEnd = start + breakTag.length;
    mdInput.dispatchEvent(new Event('input', { bubbles: true }));
  });

  // ─── Download raw markdown (.md) ───
  document.getElementById('download-btn')?.addEventListener('click', () => {
    const blob = new Blob([mdInput.value], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'document.md';
    a.click();
    URL.revokeObjectURL(url);
  });

  // ─── Export PDF: render into the print container, then open the print dialog ───
  let pageStyle: HTMLStyleElement | null = null;

  function endPrint() {
    document.documentElement.classList.remove('md-pdf-printing');
    pageStyle?.remove();
    pageStyle = null;
  }

  async function exportPdf() {
    if (!printContent || exportBtn.disabled) return;
    exportBtn.disabled = true;
    exportBtn.setAttribute('aria-busy', 'true');
    if (exportLabel) exportLabel.textContent = 'Preparing…';
    setToolStatus('processing', 'Preparing PDF…');
    try {
      applyTheme(printSheet);
      await renderPdfMarkdown(printContent, mdInput.value);
      pageStyle = document.createElement('style');
      pageStyle.textContent = `@page { size: ${pageSizeSelect?.value === 'letter' ? 'letter' : 'A4'}; margin: 16mm 14mm; }`;
      document.head.appendChild(pageStyle);
      document.documentElement.classList.add('md-pdf-printing');
      window.addEventListener('afterprint', endPrint, { once: true });
      setToolStatus('complete', 'Print dialog opened. Choose "Save as PDF" to download.');
      window.print();
    } catch {
      endPrint();
      setToolStatus('error', 'Could not load the PDF engine.');
      toast('Could not load the PDF engine. Check your connection and try again.', 'error');
    } finally {
      exportBtn.disabled = false;
      exportBtn.removeAttribute('aria-busy');
      if (exportLabel) exportLabel.textContent = 'Export PDF';
    }
  }

  exportBtn?.addEventListener('click', exportPdf);

  // Ctrl+P / Cmd+P exports the rendered document instead of printing the editor page
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && (e.key === 'p' || e.key === 'P')) {
      e.preventDefault();
      exportPdf();
    }
  });
</script>

