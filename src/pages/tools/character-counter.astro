---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";

const faqItems = [
  { question: "How do I count characters in my text?", answer: "Simply type or paste your text into the text area above. Character count, word count, and other stats update instantly as you type — no button clicking required." },
  { question: "What is the difference between characters with and without spaces?", answer: "Characters with spaces counts every character including spaces, tabs, and line breaks. Characters without spaces excludes all whitespace, giving you the actual letter/number count." },
  { question: "How is reading time calculated?", answer: "Reading time uses the average reading speed of 200 words per minute. Speaking time uses 150 words per minute. Both estimates update in real-time as you type." },
  { question: "What counts as a word?", answer: "A word is any sequence of characters separated by spaces or line breaks. Hyphenated words count as one word. Numbers and symbols are also counted as words when separated by spaces." },
  { question: "Is my text stored or uploaded?", answer: "No. All processing happens entirely in your browser. Your text is never sent to any server. We also save your text locally so you won't lose it if you refresh the page." },
];

const ccSchema = {
  name: "Character Counter Pro",
  applicationCategory: "Utilities",
  description: "Count characters with and without spaces, words, sentences, paragraphs, and lines in real-time. Free online text analyzer.",
  featureList: [
    "Real-time character count with and without spaces",
    "Word, sentence, paragraph, and line counting",
    "Reading time and speaking time estimates",
    "Top characters frequency analysis",
    "Privacy-first — all processing happens in your browser"
  ],
};
---

<MainLayout
  title="Character Counter - Free Online Character & Word Counter"
  description="Count characters, words, sentences, paragraphs, and lines in real-time. Free online character counter with and without spaces."
  keywords="character counter, character count, word count, letter counter, text analyzer, character counter online"
  toolSchema={ccSchema}
  faq={faqItems}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Tools", url: "/tools/" },
    { name: "Character Counter", url: "/tools/character-counter/" },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-5xl mx-auto">

      <ToolHeader
        title="Character Counter"
        gradient="Analyzer Pro"
        desc="Count characters, words, sentences, paragraphs, and lines in real-time. Includes reading time, speaking time, and character frequency analysis."
        badge="✦ New Tool"
        slug="character-counter"
      />

      <ShareBar />

      <div class="max-w-3xl mx-auto mt-10 space-y-5">

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" id="stats-bar">
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="stat-chars" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-400">Chars</span>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="stat-chars-ns" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-400">No Spaces</span>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="stat-words" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-400">Words</span>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="stat-sentences" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-400">Sentences</span>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="stat-paragraphs" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-400">Paragraphs</span>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="stat-lines" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-400">Lines</span>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="stat-read" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0m</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-400">Read Time</span>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span id="stat-speak" class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums">0m</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-zinc-400">Speak Time</span>
          </div>
        </div>

        <div class="relative rounded-2xl border border-white/[0.08] bg-white/[0.02] focus-within:border-purple-500/60 focus-within:shadow-[0_0_20px_-8px_#a855f7] transition-all duration-300 overflow-hidden">
          <textarea id="text-input" rows="10" placeholder="Start typing or paste your text here..." class="w-full bg-transparent text-white placeholder-zinc-600 p-5 pb-16 resize-none focus:outline-none text-sm leading-relaxed"></textarea>
          <div class="absolute bottom-3 right-3 flex items-center gap-2">
            <button id="clear-btn" class="bg-white/[0.04] hover:bg-zinc-700 text-zinc-400 hover:text-zinc-200 text-[10px] font-medium px-3 py-1.5 rounded-lg border border-white/[0.1] transition-all">Clear</button>
            <button id="copy-btn" class="bg-white/[0.04] hover:bg-zinc-700 text-zinc-400 hover:text-zinc-200 text-[10px] font-medium px-3 py-1.5 rounded-lg border border-white/[0.1] transition-all">Copy</button>
          </div>
        </div>

        <div class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-4">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-sm leading-none">📊</span>
            <span class="text-xs font-semibold text-zinc-300 uppercase tracking-wider">Character Frequency</span>
          </div>
          <div id="freq-list" class="flex flex-wrap gap-1.5 min-h-[24px]"></div>
          <p id="freq-empty" class="text-xs text-zinc-600 text-center py-6 hidden">Start typing to see character frequency...</p>
        </div>

        <div class="bg-white/[0.02] border border-white/[0.06] rounded-xl p-4">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-sm leading-none">📋</span>
            <span class="text-xs font-semibold text-zinc-300 uppercase tracking-wider">Text Details</span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
            <div class="bg-white/[0.03] border border-white/[0.04] rounded-lg p-3 text-center">
              <span id="detail-longest-word" class="block text-sm font-bold text-zinc-300 truncate">—</span>
              <span class="text-[9px] text-zinc-600 font-medium">Longest Word</span>
            </div>
            <div class="bg-white/[0.03] border border-white/[0.04] rounded-lg p-3 text-center">
              <span id="detail-avg-len" class="block text-sm font-bold text-zinc-300 tabular-nums">—</span>
              <span class="text-[9px] text-zinc-600 font-medium">Avg Word Len</span>
            </div>
            <div class="bg-white/[0.03] border border-white/[0.04] rounded-lg p-3 text-center">
              <span id="detail-unique" class="block text-sm font-bold text-zinc-300 tabular-nums">0</span>
              <span class="text-[9px] text-zinc-600 font-medium">Unique Words</span>
            </div>
            <div class="bg-white/[0.03] border border-white/[0.04] rounded-lg p-3 text-center">
              <span id="detail-avg-sent" class="block text-sm font-bold text-zinc-300 tabular-nums">—</span>
              <span class="text-[9px] text-zinc-600 font-medium">Words/Sentence</span>
            </div>
          </div>
        </div>
      </div>

      <section class="mt-20 max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Learn</span>
          <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">
            Why Character Count
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Matters</span>
          </h2>
        </div>
        <div class="space-y-4 text-sm text-zinc-400 leading-relaxed">
          <p>A <strong class="text-zinc-200">character counter</strong> is essential for anyone writing content with strict length limits — social media posts, SMS messages, meta descriptions, titles, and more. Knowing your exact character count helps you stay within platform limits while maximizing impact.</p>
          <p>Beyond simple counts, understanding your <strong class="text-zinc-200">character frequency</strong> helps improve readability and writing style. Seeing which characters and words you use most can guide you toward more varied, engaging content.</p>
        </div>
      </section>

      <RelatedTools current="character-counter" />

      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} />
      </div>
    </div>
  </main>
</MainLayout>

<script>
  const input = document.getElementById("text-input");
  const $ = (id) => document.getElementById(id);
  const statChars = $("stat-chars");
  const statCharsNs = $("stat-chars-ns");
  const statWords = $("stat-words");
  const statSentences = $("stat-sentences");
  const statParagraphs = $("stat-paragraphs");
  const statLines = $("stat-lines");
  const statRead = $("stat-read");
  const statSpeak = $("stat-speak");
  const freqList = $("freq-list");
  const freqEmpty = $("freq-empty");
  const detailLongest = $("detail-longest-word");
  const detailAvg = $("detail-avg-len");
  const detailUnique = $("detail-unique");
  const detailAvgSent = $("detail-avg-sent");

  function updateStats() {
    const text = input.value;
    const chars = text.length;
    const charsNs = text.replace(/\s/g, "").length;
    const words = text.trim() ? text.trim().split(/\s+/).filter(w => w.length > 0) : [];
    const wc = words.length;
    const sentences = text.split(/[.!?]+/).filter(s => s.trim().length > 0).length;
    const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0).length;
    const lines = text.split(/\n/).length;

    statChars.textContent = chars.toLocaleString();
    statCharsNs.textContent = charsNs.toLocaleString();
    statWords.textContent = wc.toLocaleString();
    statSentences.textContent = sentences.toLocaleString();
    statParagraphs.textContent = paragraphs.toLocaleString();
    statLines.textContent = lines.toLocaleString();
    statRead.textContent = wc > 0 ? Math.ceil(wc / 200) + "m" : "0m";
    statSpeak.textContent = wc > 0 ? Math.ceil(wc / 150) + "m" : "0m";

    if (wc > 0) {
      detailLongest.textContent = words.reduce((a, b) => a.length >= b.length ? a : b).substring(0, 18);
      detailAvg.textContent = (charsNs / wc).toFixed(1);
      detailUnique.textContent = new Set(words.map(w => w.toLowerCase())).size;
      detailAvgSent.textContent = sentences > 0 ? (wc / sentences).toFixed(1) : "—";
    } else {
      detailLongest.textContent = "—";
      detailAvg.textContent = "—";
      detailUnique.textContent = "0";
      detailAvgSent.textContent = "—";
    }

    if (chars > 0) {
      const freq = {};
      for (const ch of text.replace(/\s/g, "").toLowerCase()) {
        if (/[a-z0-9]/.test(ch)) freq[ch] = (freq[ch] || 0) + 1;
      }
      const sorted = Object.entries(freq).sort((a, b) => b[1] - a[1]).slice(0, 15);
      if (sorted.length > 0) {
        freqEmpty.classList.add("hidden");
        freqList.innerHTML = sorted.map(([ch, count]) =>
          `<span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-white/[0.03] border border-zinc-700/50 text-[10px] text-zinc-300">
            <span class="font-mono font-bold text-purple-400">"${ch}"</span>
            <span class="text-zinc-400">${count}</span>
          </span>`
        ).join("");
      }
    } else {
      freqEmpty.classList.remove("hidden");
      freqList.innerHTML = "";
    }
  }

  input.addEventListener("input", updateStats);

  try {
    const saved = localStorage.getItem("nt_cc_text");
    if (saved) { input.value = saved; }
  } catch {}
  updateStats();

  input.addEventListener("input", () => {
    try { localStorage.setItem("nt_cc_text", input.value); } catch {}
  });

  document.getElementById("clear-btn").addEventListener("click", () => {
    input.value = "";
    updateStats();
    input.focus();
    try { localStorage.removeItem("nt_cc_text"); } catch {}
    if ((window as any).__showToast) (window as any).__showToast({ message: "Text cleared", variant: "info" });
  });

  document.getElementById("copy-btn").addEventListener("click", async () => {
    if (!input.value.trim()) {
      if ((window as any).__showToast) (window as any).__showToast({ message: "Nothing to copy!", variant: "warning" });
      return;
    }
    await navigator.clipboard.writeText(input.value);
    if ((window as any).__showToast) (window as any).__showToast({ message: "Text copied!", variant: "success" });
  });
</script>
