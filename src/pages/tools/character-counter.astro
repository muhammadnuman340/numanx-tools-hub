---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'How do I count characters in my text?',
    answer:
      'Simply type or paste your text into the text area above. Character count, word count, and other stats update instantly as you type — no button clicking required.',
  },
  {
    question: 'What is the difference between characters with and without spaces?',
    answer:
      'Characters with spaces counts every character including spaces, tabs, and line breaks. Characters without spaces excludes all whitespace, giving you the actual letter/number count.',
  },
  {
    question: 'How is reading time calculated?',
    answer:
      'Reading time uses the average reading speed of 200 words per minute. Speaking time uses 150 words per minute. Both estimates update in real-time as you type.',
  },
  {
    question: 'What counts as a word?',
    answer:
      'A word is any sequence of characters separated by spaces or line breaks. Hyphenated words count as one word. Numbers and symbols are also counted as words when separated by spaces.',
  },
  {
    question: 'Is my text stored or uploaded?',
    answer:
      "No. All processing happens entirely in your browser. Your text is never sent to any server. We also save your text locally so you won't lose it if you refresh the page.",
  },
  {
    question: 'How does character counting help with SEO?',
    answer:
      'Title tags should be 50-60 characters and meta descriptions 150-160 characters for optimal search display. This tool helps you stay within those limits.',
  },
  {
    question: 'What counts as a sentence?',
    answer:
      'Sentences are counted by splitting text on periods, exclamation marks, and question marks. Each segment that contains at least one non-whitespace character counts as a sentence.',
  },
  {
    question: 'Why are character limits important on social media?',
    answer:
      'Twitter/X has a 280-character limit, Instagram captions allow 2,200 characters, and LinkedIn posts have a 3,000-character limit. Staying within bounds ensures your full message is visible.',
  },
];

const ccSchema = {
  name: 'Character Counter Pro',
  applicationCategory: 'Utilities',
  description:
    'Count characters with and without spaces, words, sentences, paragraphs, and lines in real-time. Free online text analyzer.',
  featureList: [
    'Real-time character count with and without spaces',
    'Word, sentence, paragraph, and line counting',
    'Reading time and speaking time estimates',
    'Top characters frequency analysis',
    'Privacy-first — all processing happens in your browser',
  ],
};

const benefits = [
  {
    icon: '📊',
    title: 'Complete Stats',
    desc: 'Track characters (with and without spaces), words, sentences, paragraphs, and lines. All stats update in real-time as you type.',
  },
  {
    icon: '⏱️',
    title: 'Reading & Speaking Time',
    desc: 'Know how long your text takes to read and speak. Estimates use 200 WPM for reading and 150 WPM for speaking.',
  },
  {
    icon: '🔤',
    title: 'Character Frequency',
    desc: 'See which characters appear most in your text. The frequency analysis helps identify patterns in your writing.',
  },
  {
    icon: '📋',
    title: 'Text Details',
    desc: 'View longest word, average word length, unique word count, and average words per sentence for deeper text analysis.',
  },
  {
    icon: '💾',
    title: 'Auto-Save Draft',
    desc: 'Your text is automatically saved to localStorage. Refresh or come back later — your content is always there.',
  },
  {
    icon: '🆓',
    title: 'Completely Free',
    desc: 'No sign-ups, no limits. Analyze unlimited text with all features including character frequency and text details.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Type or Paste',
    desc: 'Start typing or paste any text into the input area. All counters and stats update automatically as you enter text.',
  },
  {
    num: '2',
    title: 'Review Counts',
    desc: 'Check the stats dashboard for character counts (with/without spaces), word count, sentence count, paragraph count, and line count.',
  },
  {
    num: '3',
    title: 'Analyze Details',
    desc: 'View character frequency to see which characters you use most. Check text details like longest word and average word length.',
  },
  {
    num: '4',
    title: 'Copy or Export',
    desc: 'Copy your text to clipboard or download it in TXT, JSON, CSV, or HTML format for further use.',
  },
];

const useCases = [
  {
    icon: '📱',
    title: 'Social Media Posts',
    desc: 'Craft tweets, captions, and updates that fit within platform character limits. Know exact counts before posting.',
  },
  {
    icon: '✍️',
    title: 'Content Writing',
    desc: 'Track character and word counts for articles, blog posts, and newsletters. Ensure content meets publisher requirements.',
  },
  {
    icon: '📧',
    title: 'Email Marketing',
    desc: 'Optimize subject lines (recommended 40-60 chars) and preview text for better email open rates and deliverability.',
  },
  {
    icon: '🎓',
    title: 'Academic Writing',
    desc: 'Monitor character and word counts for essays, abstracts, and research papers with strict length requirements.',
  },
];
---

<MainLayout
  title="Character Counter - Free Online Character & Word Counter"
  description="Count characters, words, sentences, paragraphs, and lines in real-time. Free online character counter with and without spaces."
  keywords="character counter, character count, word count, letter counter, text analyzer, character counter online"
  toolSchema={ccSchema}
  faq={faqItems}
  howto={{
    name: 'How to Count Characters',
    description: 'Count characters, words, sentences, and analyze text details in 4 easy steps.',
    steps: howToSteps.map((s) => ({ title: s.title, text: s.desc })),
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Character Counter', url: '/tools/character-counter/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-5xl mx-auto">
      <ToolHeader
        title="Character Counter"
        gradient="Analyzer Pro"
        desc="Count characters, words, sentences, paragraphs, and lines in real-time. Includes reading time, speaking time, and character frequency analysis."
        badge="✦ New Tool"
        slug="character-counter"
      />

      <ShareBar />

      <div class="max-w-3xl mx-auto mt-10 space-y-5">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" id="stats-bar">
          <div class="glass-card rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span
              id="stat-chars"
              class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums"
              >0</span
            >
            <span class="text-[9px] font-semibold uppercase tracking-wider text-tertiary">Chars</span>
          </div>
          <div class="glass-card rounded-xl p-3 text-center hover:border-purple-500/30 transition-all">
            <span
              id="stat-chars-ns"
              class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums"
              >0</span
            >
            <span class="text-[9px] font-semibold uppercase tracking-wider text-tertiary">No Spaces</span>
          </div>
          <div
            class="bg-surface-1 border border-surface rounded-xl p-3 text-center hover:border-purple-500/30 transition-all"
          >
            <span
              id="stat-words"
              class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums"
              >0</span
            >
            <span class="text-[9px] font-semibold uppercase tracking-wider text-tertiary">Words</span>
          </div>
          <div
            class="bg-surface-1 border border-surface rounded-xl p-3 text-center hover:border-purple-500/30 transition-all"
          >
            <span
              id="stat-sentences"
              class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums"
              >0</span
            >
            <span class="text-[9px] font-semibold uppercase tracking-wider text-tertiary">Sentences</span>
          </div>
          <div
            class="bg-surface-1 border border-surface rounded-xl p-3 text-center hover:border-purple-500/30 transition-all"
          >
            <span
              id="stat-paragraphs"
              class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums"
              >0</span
            >
            <span class="text-[9px] font-semibold uppercase tracking-wider text-tertiary">Paragraphs</span>
          </div>
          <div
            class="bg-surface-1 border border-surface rounded-xl p-3 text-center hover:border-purple-500/30 transition-all"
          >
            <span
              id="stat-lines"
              class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums"
              >0</span
            >
            <span class="text-[9px] font-semibold uppercase tracking-wider text-tertiary">Lines</span>
          </div>
          <div
            class="bg-surface-1 border border-surface rounded-xl p-3 text-center hover:border-purple-500/30 transition-all"
          >
            <span
              id="stat-read"
              class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums"
              >0m</span
            >
            <span class="text-[9px] font-semibold uppercase tracking-wider text-tertiary">Read Time</span>
          </div>
          <div
            class="bg-surface-1 border border-surface rounded-xl p-3 text-center hover:border-purple-500/30 transition-all"
          >
            <span
              id="stat-speak"
              class="block text-xl sm:text-2xl font-extrabold bg-gradient-to-br from-purple-400 to-blue-500 bg-clip-text text-transparent tabular-nums"
              >0m</span
            >
            <span class="text-[9px] font-semibold uppercase tracking-wider text-tertiary">Speak Time</span>
          </div>
        </div>

        <div
          class="relative rounded-2xl border border-surface-2 bg-surface-1 focus-within:border-purple-500/60 focus-within:shadow-[0_0_20px_-8px_#a855f7] transition-all duration-300 overflow-hidden"
        >
          <div class="flex items-center justify-between px-5 pt-3">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
              <span id="usage-badge" class="text-xs text-muted"></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex gap-1">
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="purple"
                  style="background:#a855f7"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="blue"
                  style="background:#3b82f6"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="green"
                  style="background:#22c55e"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="pink"
                  style="background:#ec4899"></button>
              </div>
              <button
                id="fullscreen-btn"
                class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs"
                title="Fullscreen">⛶</button
              >
            </div>
          </div>
          <div class="flex items-center gap-1.5 px-5">
            <button
              class="font-dec p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all"
              >A−</button
            >
            <button
              class="font-inc p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all"
              >A+</button
            >
            <span class="text-xs text-muted ml-auto">Ctrl+Enter to process</span>
          </div>
          <div class="flex">
            <div
              id="line-nums"
              class="text-xs text-muted text-right pr-2 select-none overflow-hidden font-mono leading-relaxed pt-3"
              style="min-width:2.5em"
            >
              1
            </div>
            <textarea
              id="text-input"
              rows="10"
              placeholder="Start typing or paste your text here..."
              class="flex-1 bg-transparent text-white placeholder-zinc-600 p-5 pb-16 resize-none focus:outline-none text-sm leading-relaxed"
            ></textarea>
          </div>
          <div id="reading-time" class="text-xs text-muted px-5 -mt-2"></div>
          <div id="letter-freq" class="px-5 mt-2 space-y-0.5 max-h-24 overflow-y-auto hidden"></div>
          <div class="absolute bottom-3 right-3 flex items-center gap-2">
            <select
              id="export-format"
              class="bg-surface-2 border border-surface text-[10px] text-tertiary rounded-lg px-2 py-1.5"
            >
              <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option><option
                value="html">HTML</option
              >
            </select>
            <button
              id="download-btn"
              class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-[10px] font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              >Download</button
            >
            <button
              id="share-btn"
              class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-[10px] font-medium px-2.5 py-1.5 rounded-lg border border-surface-3 transition-all"
              title="Copy share link">🔗</button
            >
            <button
              id="clear-btn"
              class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-[10px] font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              >Clear</button
            >
            <button
              id="copy-btn"
              class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-[10px] font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
              >Copy</button
            >
          </div>
        </div>

        <div class="bg-surface-1 border border-surface rounded-xl p-4">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-sm leading-none">📊</span>
            <span class="text-xs font-semibold text-secondary uppercase tracking-wider">Character Frequency</span>
          </div>
          <div id="freq-list" class="flex flex-wrap gap-1.5 min-h-[24px]"></div>
          <p id="freq-empty" class="text-xs text-dim text-center py-6 hidden">
            Start typing to see character frequency...
          </p>
        </div>

        <div class="bg-surface-1 border border-surface rounded-xl p-4">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-sm leading-none">📋</span>
            <span class="text-xs font-semibold text-secondary uppercase tracking-wider">Text Details</span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
            <div class="glass-card rounded-lg p-3 text-center">
              <span id="detail-longest-word" class="block text-sm font-bold text-secondary truncate">—</span>
              <span class="text-[9px] text-dim font-medium">Longest Word</span>
            </div>
            <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center">
              <span id="detail-avg-len" class="block text-sm font-bold text-secondary tabular-nums">—</span>
              <span class="text-[9px] text-dim font-medium">Avg Word Len</span>
            </div>
            <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center">
              <span id="detail-unique" class="block text-sm font-bold text-secondary tabular-nums">0</span>
              <span class="text-[9px] text-dim font-medium">Unique Words</span>
            </div>
            <div class="bg-surface-1 border border-surface rounded-lg p-3 text-center">
              <span id="detail-avg-sent" class="block text-sm font-bold text-secondary tabular-nums">—</span>
              <span class="text-[9px] text-dim font-medium">Words/Sentence</span>
            </div>
          </div>
        </div>
      </div>

      <section class="mt-20 max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Learn</span>
          <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">
            Why Character Count
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Matters</span>
          </h2>
        </div>
        <div class="space-y-4 text-sm text-tertiary leading-relaxed">
          <p>
            A <strong class="text-primary">character counter</strong> is essential for anyone writing content with strict
            length limits — social media posts, SMS messages, meta descriptions, titles, and more. Knowing your exact character
            count helps you stay within platform limits while maximizing impact.
          </p>
          <p>
            Beyond simple counts, understanding your <strong class="text-primary">character frequency</strong> helps improve
            readability and writing style. Seeing which characters and words you use most can guide you toward more varied,
            engaging content.
          </p>
        </div>
      </section>

      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>

      <ToolContentSections
        toolSlug="character-counter"
        toolName="Character Counter"
        category="Utility Tools"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />

      <!-- ─── CTA Section ─── -->
      <section class="mt-16 text-center">
        <div
          class="max-w-2xl mx-auto bg-gradient-to-br from-purple-600/10 to-blue-600/5 border border-purple-500/20 rounded-2xl p-8 md:p-10"
        >
          <h2 class="text-2xl md:text-3xl font-black tracking-tight">
            Start Counting
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">
              Characters Free</span
            >
          </h2>
          <p class="text-tertiary mt-3 max-w-lg mx-auto text-sm leading-relaxed">
            No sign-up required. No limits. Count characters, words, and sentences with detailed text analysis
            completely free.
          </p>
          <div class="mt-6 flex gap-3 justify-center flex-wrap">
            <button
              onclick="document.querySelector('#text-input')?.focus()"
              class="px-6 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm transition-all active:scale-[0.97] shadow-lg shadow-purple-900/30"
            >
              Start Counting
            </button>
            <a
              href="/tools/percentage-calculator/"
              class="px-6 py-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-semibold text-sm transition-all border border-zinc-700"
            >
              Try Percentage Calculator
            </a>
          </div>
        </div>
      </section>

      <RelatedTools current="character-counter" />
    </div>
  </main>
</MainLayout>

<script>
  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }
  const input = document.getElementById('text-input');
  const $ = (id) => document.getElementById(id);
  const statChars = $('stat-chars');
  const statCharsNs = $('stat-chars-ns');
  const statWords = $('stat-words');
  const statSentences = $('stat-sentences');
  const statParagraphs = $('stat-paragraphs');
  const statLines = $('stat-lines');
  const statRead = $('stat-read');
  const statSpeak = $('stat-speak');
  const freqList = $('freq-list');
  const freqEmpty = $('freq-empty');
  const detailLongest = $('detail-longest-word');
  const detailAvg = $('detail-avg-len');
  const detailUnique = $('detail-unique');
  const detailAvgSent = $('detail-avg-sent');

  function updateStats() {
    const text = input.value;
    const chars = text.length;
    const charsNs = text.replace(/\s/g, '').length;
    const words = text.trim()
      ? text
          .trim()
          .split(/\s+/)
          .filter((w) => w.length > 0)
      : [];
    const wc = words.length;
    const sentences = text.split(/[.!?]+/).filter((s) => s.trim().length > 0).length;
    const paragraphs = text.split(/\n+/).filter((p) => p.trim().length > 0).length;
    const lines = text.split(/\n/).length;

    statChars.textContent = chars.toLocaleString();
    statCharsNs.textContent = charsNs.toLocaleString();
    statWords.textContent = wc.toLocaleString();
    statSentences.textContent = sentences.toLocaleString();
    statParagraphs.textContent = paragraphs.toLocaleString();
    statLines.textContent = lines.toLocaleString();
    statRead.textContent = wc > 0 ? Math.ceil(wc / 200) + 'm' : '0m';
    statSpeak.textContent = wc > 0 ? Math.ceil(wc / 150) + 'm' : '0m';

    if (wc > 0) {
      detailLongest.textContent = words.reduce((a, b) => (a.length >= b.length ? a : b)).substring(0, 18);
      detailAvg.textContent = (charsNs / wc).toFixed(1);
      detailUnique.textContent = new Set(words.map((w) => w.toLowerCase())).size;
      detailAvgSent.textContent = sentences > 0 ? (wc / sentences).toFixed(1) : '—';
    } else {
      detailLongest.textContent = '—';
      detailAvg.textContent = '—';
      detailUnique.textContent = '0';
      detailAvgSent.textContent = '—';
    }

    if (chars > 0) {
      const freq = {};
      for (const ch of text.replace(/\s/g, '').toLowerCase()) {
        if (/[a-z0-9]/.test(ch)) freq[ch] = (freq[ch] || 0) + 1;
      }
      const sorted = Object.entries(freq)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 15);
      if (sorted.length > 0) {
        freqEmpty.classList.add('hidden');
        freqList.innerHTML = sorted
          .map(
            ([ch, count]) =>
              `<span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-surface-1 border border-zinc-700/50 text-[10px] text-secondary">
            <span class="font-mono font-bold text-purple-400">"${ch}"</span>
            <span class="text-tertiary">${count}</span>
          </span>`,
          )
          .join('');
      }
    } else {
      freqEmpty.classList.remove('hidden');
      freqList.innerHTML = '';
    }
  }

  input.addEventListener('input', updateStats);

  try {
    const saved = localStorage.getItem('nt_cc_text');
    if (saved) {
      input.value = saved;
    }
  } catch {}
  updateStats();

  input.addEventListener('input', () => {
    try {
      localStorage.setItem('nt_cc_text', input.value);
    } catch {}
  });

  document.getElementById('clear-btn').addEventListener('click', () => {
    input.value = '';
    updateStats();
    input.focus();
    try {
      localStorage.removeItem('nt_cc_text');
    } catch {}
    playPing();
    if ((window as any).__showToast) (window as any).__showToast({ message: 'Text cleared', variant: 'info' });
  });

  document.getElementById('copy-btn').addEventListener('click', async () => {
    if (!input.value.trim()) {
      if ((window as any).__showToast) (window as any).__showToast({ message: 'Nothing to copy!', variant: 'warning' });
      return;
    }
    await navigator.clipboard.writeText(input.value);
    playPing();
    if ((window as any).__showToast) (window as any).__showToast({ message: 'Text copied!', variant: 'success' });
  });

  document.getElementById('download-btn')?.addEventListener('click', () => {
    const outputText = input.value.trim();
    if (!outputText) {
      if ((window as any).__showToast)
        (window as any).__showToast({ message: 'Nothing to download!', variant: 'warning' });
      return;
    }
    const fmt = (document.getElementById('export-format') as HTMLSelectElement)?.value || 'txt';
    let content = outputText;
    let mime = 'text/plain';
    let ext = 'txt';
    if (fmt === 'json') {
      content = JSON.stringify({ result: outputText, tool: 'character-counter', timestamp: new Date().toISOString() });
      mime = 'application/json';
      ext = 'json';
    }
    if (fmt === 'csv') {
      content = 'Result\n"' + outputText.replace(/"/g, '""') + '"';
      mime = 'text/csv';
      ext = 'csv';
    }
    if (fmt === 'html') {
      content = '<!DOCTYPE html><html><body><pre>' + outputText.replace(/</g, '&lt;') + '</pre></body></html>';
      mime = 'text/html';
      ext = 'html';
    }
    const blob = new Blob([content], { type: mime });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'character-count-output.' + ext;
    a.click();
    URL.revokeObjectURL(a.href);
    playPing();
    if ((window as any).__showToast) (window as any).__showToast({ message: 'Downloaded!', variant: 'success' });
  });

  document.getElementById('fullscreen-btn')?.addEventListener('click', () => {
    const card =
      document.getElementById('fullscreen-btn').closest('.bg-surface-1.border.border-surface.rounded-2xl') ||
      document.getElementById('fullscreen-btn').closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
      document.getElementById('fullscreen-btn').textContent = '⛶';
    } else {
      card.requestFullscreen?.() || card.webkitRequestFullscreen?.();
      document.getElementById('fullscreen-btn').textContent = '✕';
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const btn = document.getElementById('fullscreen-btn');
    if (btn) btn.textContent = document.fullscreenElement ? '✕' : '⛶';
  });

  const DRAFT_KEY = 'nt_draft_character-counter';
  (function () {
    const input = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
    if (!input) return;
    try {
      const saved = localStorage.getItem(DRAFT_KEY);
      if (saved && !input.value) {
        input.value = saved;
        input.dispatchEvent(new Event('input'));
      }
    } catch (e) {}
    let saveTimer;
    input.addEventListener('input', () => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        try {
          localStorage.setItem(DRAFT_KEY, input.value);
        } catch (e) {}
      }, 500);
    });
  })();

  document.querySelector('.font-inc')?.addEventListener('click', () => {
    document.querySelectorAll('textarea').forEach((t) => {
      let s = parseInt(getComputedStyle(t).fontSize);
      t.style.fontSize = Math.min(24, s + 2) + 'px';
    });
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    document.querySelectorAll('textarea').forEach((t) => {
      let s = parseInt(getComputedStyle(t).fontSize);
      t.style.fontSize = Math.max(10, s - 2) + 'px';
    });
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) document.querySelectorAll('textarea').forEach((t) => (t.style.fontSize = s + 'px'));
  } catch (e) {}

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b =
        document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])") ||
        document.querySelector("button[class*='bg-']:not([id*='full']):not([id*='paste'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      document.getElementById('clear-btn')?.click();
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });

  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['character-counter']) b.textContent = 'Used ' + u['character-counter'] + '×';
  } catch (e) {}

  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('text-input') || document.querySelector("[id$='result']");
    const t = o?.value || o?.textContent || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof (window as any).__showToast === 'function') (window as any).__showToast({ message: 'Link copied!' });
  });

  const rtInput = document.getElementById('text-input') || document.querySelector('textarea:not([readonly])');
  if (rtInput) {
    rtInput.addEventListener('input', () => {
      const w = rtInput.value ? rtInput.value.trim().split(/\s+/).length : 0;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent =
          Math.max(1, Math.round(w / 200)) + ' min read · ' + Math.max(1, Math.round(w / 150)) + ' min speak';
    });
    rtInput.dispatchEvent(new Event('input'));
  }

  const lnInput = document.getElementById('text-input');
  if (lnInput) {
    const updateLN = () => {
      const n = document.getElementById('line-nums');
      if (n) n.textContent = Array.from({ length: lnInput.value.split('\n').length }, (_, i) => i + 1).join('\n');
    };
    lnInput.addEventListener('input', updateLN);
    lnInput.addEventListener('scroll', () => {
      const n = document.getElementById('line-nums');
      if (n) n.scrollTop = lnInput.scrollTop;
    });
    updateLN();
  }

  const lfInput = document.getElementById('text-input');
  if (lfInput) {
    lfInput.addEventListener('input', () => {
      const t = lfInput.value.toLowerCase().replace(/[^a-z]/g, '');
      if (!t) {
        document.getElementById('letter-freq').classList.add('hidden');
        return;
      }
      const f = {};
      for (const c of t) f[c] = (f[c] || 0) + 1;
      const s = Object.entries(f)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8);
      const m = s[0] ? s[0][1] : 1;
      const el = document.getElementById('letter-freq');
      el.classList.remove('hidden');
      el.innerHTML = s
        .map(
          ([c, n]) =>
            `<div class="flex items-center gap-1.5 text-xs"><span class="w-3 text-center font-mono text-white">${c}</span><div class="h-2 rounded-full bg-purple-500/50" style="width:${(n / m) * 80 + 10}%"></div><span class="text-muted">${n}</span></div>`,
        )
        .join('');
    });
  }

  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      const map = { purple: '#a855f7', blue: '#3b82f6', green: '#22c55e', pink: '#ec4899', orange: '#f97316' };
      document.querySelectorAll("button[class*='bg-purple'], button[class*='bg-violet']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(purple|violet)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(purple|violet)-\d+/g, 'hover:bg-' + c + '-500')
          .replace(/from-(purple|violet)-\d+/g, 'from-' + c + '-500')
          .replace(/to-purple-\d+/g, 'to-' + c + '-600');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}
</script>
