---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'What is URL encoding?',
    answer:
      'URL encoding (percent-encoding) replaces special characters in a URL with a % followed by their hexadecimal ASCII value. For example, spaces become %20 and special characters like & or # are encoded to prevent URL parsing issues.',
  },
  {
    question: 'Why do I need to encode URLs?',
    answer:
      'URLs can only contain certain safe characters (A-Z, a-z, 0-9, and a few special characters). Encoding ensures special characters, spaces, and non-ASCII characters are transmitted safely without breaking the URL structure.',
  },
  {
    question: 'Is the encoding done on my device?',
    answer:
      "Yes. All encoding and decoding happens entirely in your browser using JavaScript's built-in encodeURIComponent and decodeURIComponent functions. Your data never leaves your device.",
  },
];
const schema = {
  name: 'URL Encoder / Decoder',
  applicationCategory: 'Developer Tools',
  description: 'Encode or decode URLs instantly using standard percent-encoding. Free online URL encoder/decoder tool.',
  featureList: [
    'URL encoding with encodeURIComponent',
    'URL decoding with decodeURIComponent',
    'One-click copy output',
    '100% client-side',
  ],
};
---

<MainLayout
  title="RFC 3986 URL Query String & URI Component Encoder/Decoder Online Free | NumanX Tools"
  description="Encode and decode URLs, query strings, and URI components using standard RFC 3986 percent-encoding. 100% free and client-side."
  keywords="rfc 3986 encoder, url encoder decoder, percent encoding online, query string encoder, uri component decoder"
  toolSchema={schema}
  faq={faqItems}
  howto={{
    name: 'How to Use URL Encoder/Decoder',
    description: 'Step-by-step guide for using URL Encoder/Decoder.',
    steps: [],
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'URL Encoder', url: '/tools/url-encoder/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="URL"
        gradient="Encoder Pro"
        desc="Encode or decode URLs instantly using standard percent-encoding. Perfect for API parameters and query strings."
        badge="✦ New Tool"
        slug="url-encoder"
      />
      <ShareBar />
      <div class="max-w-xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
              <span id="usage-badge" class="text-xs text-muted"></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex gap-1" role="group" aria-label="Theme color swatches">
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="purple"
                  aria-label="Set purple theme"
                  style="background:#a855f7"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="blue"
                  aria-label="Set blue theme"
                  style="background:#3b82f6"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="green"
                  aria-label="Set green theme"
                  style="background:#22c55e"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="pink"
                  aria-label="Set pink theme"
                  style="background:#ec4899"></button>
              </div>
              <button
                id="fullscreen-btn"
                aria-label="Toggle fullscreen"
                class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs"
                title="Fullscreen">⛶</button
              >
            </div>
          </div>
          <div class="flex items-center justify-between min-h-[32px] mb-2">
            <label for="input-text" class="text-xs font-semibold text-zinc-300">Input</label>
            <div class="flex items-center gap-1.5">
              <div class="flex items-center gap-0.5 bg-surface-2 p-0.5 rounded-lg border border-surface">
                <button
                  type="button"
                  aria-label="Decrease font size"
                  class="font-dec px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                  >A−</button
                >
                <button
                  type="button"
                  aria-label="Increase font size"
                  class="font-inc px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                  >A+</button
                >
              </div>
              <span class="text-xs text-muted ml-2">Ctrl+Enter to encode</span>
            </div>
          </div>
          <div class="flex h-[200px] rounded-xl bg-black/40 border border-surface focus-within:border-cyan-500 focus-within:ring-1 focus-within:ring-cyan-500 transition-all overflow-hidden relative">
            <div
              id="line-nums"
              class="w-12 shrink-0 h-full select-none overflow-hidden font-mono text-sm leading-6 text-right pr-3.5 py-3 text-zinc-500/80 bg-zinc-950/60 border-r border-white/5 whitespace-pre pointer-events-none tabular-nums"
              style="line-height: 24px; font-size: 14px;"
            >
              1
            </div>
            <textarea
              id="input-text"
              aria-label="URL input to encode or decode"
              class="flex-1 min-w-0 h-full bg-transparent text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 px-4 py-3 focus:outline-none font-mono resize-none border-0 overflow-y-auto"
              style="line-height: 24px; font-size: 14px;"
              placeholder="Type or paste text/URL here..."></textarea>
          </div>
          <div id="reading-time" class="text-xs text-muted mt-2"></div>
          <div id="letter-freq" tabindex="0" role="region" aria-label="Character frequency breakdown" class="mt-2 flex flex-wrap gap-1.5 hidden"></div>
          <div class="flex flex-wrap gap-2 mt-4">
            <button
              id="encode-btn"
              class="bg-cyan-600 hover:bg-cyan-500 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all active:scale-95"
              >Encode</button
            >
            <button
              id="decode-btn"
              class="bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all active:scale-95"
              >Decode</button
            >
            <button
              id="swap-btn"
              class="bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-xs font-medium px-3 py-2 rounded-xl transition-all active:scale-95"
              >&harr; Swap</button
            >
          </div>
          <div class="mt-6 pt-6 border-t border-surface">
            <label for="output-text" class="block text-xs font-semibold text-zinc-300 mb-1.5">Output</label>
            <textarea
              id="output-text"
              aria-label="Encoded or decoded URL output"
              class="w-full h-[200px] px-4 py-3 rounded-xl border border-surface bg-black/40 text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 focus:outline-none resize-none font-mono overflow-y-auto"
              style="line-height: 24px; font-size: 14px;"
              readonly
              placeholder="Result will appear here..."></textarea>
            <button
              id="copy-btn"
              class="mt-2 bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-xs font-medium px-4 py-1.5 rounded-lg transition-all"
              >Copy Result</button
            >
            <button
              id="share-btn"
              class="mt-2 bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-xs font-medium px-4 py-1.5 rounded-lg transition-all"
              title="Copy share link">🔗</button
            >
            <button
              id="download-btn"
              class="mt-2 bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-xs font-medium px-4 py-1.5 rounded-lg transition-all"
              >Download</button
            >
            <button
              id="clear-btn"
              class="mt-2 bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-xs font-medium px-4 py-1.5 rounded-lg transition-all"
              >Clear</button
            >
            <select
              id="export-format"
              class="mt-2 bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5"
            >
              <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option><option
                value="html">HTML</option
              >
            </select>
          </div>
        </div>
      </div>
      <RelatedTools current="url-encoder" />
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span class="bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent"
            >Questions</span
          >
        </h2><Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>
<script>
  const input = document.getElementById('input-text') as HTMLTextAreaElement;
  const output = document.getElementById('output-text') as HTMLTextAreaElement;
  const encodeBtn = document.getElementById('encode-btn');
  const decodeBtn = document.getElementById('decode-btn');
  const swapBtn = document.getElementById('swap-btn');
  const copyBtn = document.getElementById('copy-btn');

  function triggerToast(msg: string, variant: 'success' | 'error' | 'warning' = 'success') {
    if ((window as any).__showToast) (window as any).__showToast({ message: msg, variant });
  }

  encodeBtn.addEventListener('click', () => {
    try {
      output.value = encodeURIComponent(input.value);
      triggerToast('URL encoded!', 'success');
    } catch (e) {
      triggerToast('Encoding failed: ' + (e as Error).message, 'error');
    }
  });

  decodeBtn.addEventListener('click', () => {
    try {
      output.value = decodeURIComponent(input.value);
      triggerToast('URL decoded!', 'success');
    } catch {
      triggerToast('Invalid URL encoding — check your input', 'error');
    }
  });

  swapBtn.addEventListener('click', () => {
    const tmp = input.value;
    input.value = output.value;
    output.value = tmp;
  });

  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }
  document.getElementById('download-btn')?.addEventListener('click', () => {
    if (!output.value) return;
    const fmt = (document.getElementById('export-format') as HTMLSelectElement)?.value || 'txt';
    const mimes = { txt: 'text/plain', json: 'application/json', csv: 'text/csv', html: 'text/html' };
    const content = fmt === 'json' ? JSON.stringify(output.value) : output.value;
    const blob = new Blob([content], { type: mimes[fmt] || 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'url-output.' + fmt;
    a.click();
    playPing();
    URL.revokeObjectURL(a.href);
  });
  document.getElementById('clear-btn')?.addEventListener('click', () => {
    input.value = '';
    output.value = '';
    playPing();
  });
  copyBtn.addEventListener('click', async () => {
    if (!output.value) {
      triggerToast('Nothing to copy!', 'warning');
      return;
    }
    await navigator.clipboard.writeText(output.value);
    playPing();
    triggerToast('Copied!', 'success');
  });
  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('output-text');
    const t = o?.value || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof (window as any).__showToast === 'function')
      (window as any).__showToast({ message: 'Link copied!', variant: 'success' });
  });
  const updateEditorFontSize = (newSize: number) => {
    const clamped = Math.max(10, Math.min(24, newSize));
    const lineHeight = Math.round(clamped * 1.7);
    document.querySelectorAll('textarea').forEach((t) => {
      t.style.fontSize = clamped + 'px';
      t.style.lineHeight = lineHeight + 'px';
    });
    const lineNums = document.getElementById('line-nums');
    if (lineNums) {
      lineNums.style.fontSize = clamped + 'px';
      lineNums.style.lineHeight = lineHeight + 'px';
    }
    try {
      localStorage.setItem('nt_fs', String(clamped));
    } catch (e) {}
  };

  document.querySelector('.font-inc')?.addEventListener('click', () => {
    const ta = document.getElementById('input-text');
    const s = parseInt(getComputedStyle(ta as HTMLElement).fontSize) || 14;
    updateEditorFontSize(s + 2);
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    const ta = document.getElementById('input-text');
    const s = parseInt(getComputedStyle(ta as HTMLElement).fontSize) || 14;
    updateEditorFontSize(s - 2);
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) updateEditorFontSize(parseInt(s));
  } catch (e) {}
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b = document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      document.getElementById('clear-btn')?.click();
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['url']) b.textContent = 'Used ' + u['url'] + '×';
  } catch (e) {}
  const rt = document.getElementById('input-text');
  if (rt) {
    rt.addEventListener('input', () => {
      const w = rt.value ? rt.value.trim().split(/\s+/).length : 0;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent =
          Math.max(1, Math.round(w / 200)) + ' min read · ' + Math.max(1, Math.round(w / 150)) + ' min speak';
    });
    rt.dispatchEvent(new Event('input'));
  }
  const li = document.getElementById('input-text');
  if (li) {
    const ul = () => {
      const n = document.getElementById('line-nums');
      if (n) n.textContent = Array.from({ length: li.value.split('\n').length }, (_, i) => i + 1).join('\n');
    };
    li.addEventListener('input', ul);
    li.addEventListener('scroll', () => {
      const n = document.getElementById('line-nums');
      if (n) n.scrollTop = li.scrollTop;
    });
    ul();
  }
  const lf = document.getElementById('input-text');
  if (lf) {
    lf.addEventListener('input', () => {
      const t = lf.value.toLowerCase().replace(/[^a-z]/g, '');
      if (!t) {
        document.getElementById('letter-freq')?.classList.add('hidden');
        return;
      }
      const f = {};
      for (const c of t) f[c] = (f[c] || 0) + 1;
      const s = Object.entries(f)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8);
      const m = s[0] ? s[0][1] : 1;
      const el = document.getElementById('letter-freq');
      el.classList.remove('hidden');
      el.innerHTML = s
        .map(
          ([c, n]) =>
            `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-xs font-mono"><strong class="text-cyan-400 uppercase">${c}</strong><span class="text-zinc-400">${n}</span></span>`,
        )
        .join('');
    });
  }
  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      document.querySelectorAll("button[class*='bg-cyan'],button[class*='bg-sky']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(cyan|sky)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(cyan|sky)-\d+/g, 'hover:bg-' + c + '-500');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}

  // ─── Fullscreen ───
  (function() {
    var fsBtn = document.getElementById('fullscreen-btn');
    if (fsBtn) {
      fsBtn.addEventListener('click', function() {
        var el = document.querySelector('main') || document.documentElement;
        if (!document.fullscreenElement) { el.requestFullscreen && el.requestFullscreen(); }
        else { document.exitFullscreen && document.exitFullscreen(); }
      });
    }
    document.addEventListener('keydown', function(e) {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'f' || e.key === 'F') { if (fsBtn) fsBtn.click(); }
    });
  })();</script>
