---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";

const faqItems = [
  { question: "What is URL encoding?", answer: "URL encoding (percent-encoding) replaces special characters in a URL with a % followed by their hexadecimal ASCII value. For example, spaces become %20 and special characters like & or # are encoded to prevent URL parsing issues." },
  { question: "Why do I need to encode URLs?", answer: "URLs can only contain certain safe characters (A-Z, a-z, 0-9, and a few special characters). Encoding ensures special characters, spaces, and non-ASCII characters are transmitted safely without breaking the URL structure." },
  { question: "Is the encoding done on my device?", answer: "Yes. All encoding and decoding happens entirely in your browser using JavaScript's built-in encodeURIComponent and decodeURIComponent functions. Your data never leaves your device." },
];
const schema = { name: "URL Encoder / Decoder", applicationCategory: "Developer Tools", description: "Encode or decode URLs instantly using standard percent-encoding. Free online URL encoder/decoder tool.", featureList: ["URL encoding with encodeURIComponent", "URL decoding with decodeURIComponent", "One-click copy output", "100% client-side"] };
---
<MainLayout title="URL Encoder Decoder - Encode & Decode URLs Online Free" description="Encode or decode URLs instantly using percent-encoding. Free online URL encoder/decoder for developers." keywords="url encoder, url decoder, percent encoding, encode url, decode url, url tool" toolSchema={schema} faq={faqItems} breadcrumbs={[{name:"Home",url:"/"},{name:"Tools",url:"/tools/"},{name:"URL Encoder",url:"/tools/url-encoder/"}]}>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden"><div class="max-w-4xl mx-auto">
    <ToolHeader title="URL" gradient="Encoder Pro" desc="Encode or decode URLs instantly using standard percent-encoding. Perfect for API parameters and query strings." badge="✦ New Tool" slug="url-encoder" />
    <ShareBar />
    <div class="max-w-xl mx-auto mt-10">
      <div class="bg-surface-1 border border-surface rounded-2xl p-6">
        <label class="text-[10px] font-semibold text-muted uppercase tracking-wider mb-2 block">Input</label>
        <textarea id="input-text" class="w-full h-32 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-cyan-500/50 focus:outline-none transition-all resize-none font-mono" placeholder="Type or paste text/URL here..."></textarea>
        <div class="flex flex-wrap gap-2 mt-4">
          <button id="encode-btn" class="bg-cyan-600 hover:bg-cyan-500 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all active:scale-95">Encode</button>
          <button id="decode-btn" class="bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all active:scale-95">Decode</button>
          <button id="swap-btn" class="bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-xs font-medium px-3 py-2 rounded-xl transition-all active:scale-95">&harr; Swap</button>
        </div>
        <div class="mt-6 pt-6 border-t border-surface">
          <label class="text-[10px] font-semibold text-muted uppercase tracking-wider mb-2 block">Output</label>
          <textarea id="output-text" class="w-full h-32 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:outline-none transition-all resize-none font-mono" readonly placeholder="Result will appear here..."></textarea>
          <button id="copy-btn" class="mt-2 bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-xs font-medium px-4 py-1.5 rounded-lg transition-all">Copy Result</button>
        </div>
      </div>
    </div>
    <RelatedTools current="url-encoder" />
    <div class="mt-20 max-w-3xl mx-auto"><h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">Frequently Asked <span class="bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">Questions</span></h2><Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} /></div>
  </div></main>
</MainLayout>
<script>
  const input = document.getElementById("input-text") as HTMLTextAreaElement;
  const output = document.getElementById("output-text") as HTMLTextAreaElement;
  const encodeBtn = document.getElementById("encode-btn");
  const decodeBtn = document.getElementById("decode-btn");
  const swapBtn = document.getElementById("swap-btn");
  const copyBtn = document.getElementById("copy-btn");

  function triggerToast(msg: string, variant: "success" | "error" | "warning" = "success") {
    if ((window as any).__showToast) (window as any).__showToast({ message: msg, variant });
  }

  encodeBtn.addEventListener("click", () => {
    try {
      output.value = encodeURIComponent(input.value);
      triggerToast("URL encoded!", "success");
    } catch (e) {
      triggerToast("Encoding failed: " + (e as Error).message, "error");
    }
  });

  decodeBtn.addEventListener("click", () => {
    try {
      output.value = decodeURIComponent(input.value);
      triggerToast("URL decoded!", "success");
    } catch {
      triggerToast("Invalid URL encoding — check your input", "error");
    }
  });

  swapBtn.addEventListener("click", () => {
    const tmp = input.value;
    input.value = output.value;
    output.value = tmp;
  });

  copyBtn.addEventListener("click", async () => {
    if (!output.value) { triggerToast("Nothing to copy!", "warning"); return; }
    await navigator.clipboard.writeText(output.value);
    triggerToast("Copied!", "success");
  });
</script>
