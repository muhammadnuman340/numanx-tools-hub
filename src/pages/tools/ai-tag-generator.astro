  function extractWords(text) {
    return text.toLowerCase().match(/[a-z]+(?:'[a-z]+)?/g) || [];
  }

  function getBigrams(words) {
    const bigrams = [];
    for (let i = 0; i < words.length - 1; i++) {
      bigrams.push(words[i] + ' ' + words[i + 1]);
    }
    return bigrams;
  }

  function detectCategory(words) {
    let bestCat = null,
      bestScore = 0;
    for (const [cat, keywords] of Object.entries(categoryKeywords)) {
      let score = 0;
      for (const kw of keywords) {
        const parts = kw.split(' ');
        if (parts.length === 2) {
          for (let i = 0; i < words.length - 1; i++) {
            if (words[i] === parts[0] && words[i + 1] === parts[1]) score += 3;
          }
        } else {
          score += words.filter((w) => w === parts[0]).length * 2;
        }
      }
      if (score > bestScore) {
        bestScore = score;
        bestCat = cat;
      }
    }
    return bestScore > 0 ? bestCat : null;
  }

  function getCategoryTags(category) {
    const suggestions = {
      Programming: ['coding', 'webdev', 'programming', 'softwareengineering', 'tech'],
      Food: ['cooking', 'foodie', 'recipe', 'homemade', 'delicious'],
      Technology: ['tech', 'innovation', 'futuretech', 'digital', 'ai'],
      Health: ['wellness', 'healthyliving', 'fitness', 'selfcare', 'nutrition'],
      Travel: ['travelgram', 'wanderlust', 'adventure', 'explore', 'vacation'],
      Design: ['designthinking', 'creativity', 'visualdesign', 'uxdesign', 'art'],
      Business: ['entrepreneurship', 'businessgrowth', 'startup', 'marketing', 'success'],
      Education: ['learning', 'education', 'knowledge', 'studytips', 'elearning'],
    };
    return suggestions[category] || [];
  }

  function generateTags(text, count) {
    if (!text.trim()) return { tags: [], category: null };
    const words = extractWords(text);
    const filtered = words.filter((w) => !stopWords.has(w) && w.length > 1);
    if (filtered.length === 0) return { tags: [], category: null };

    const freq = {};
    for (const w of filtered) freq[w] = (freq[w] || 0) + 1;

    const bigrams = getBigrams(filtered);
    const biFreq = {};
    for (const b of bigrams) biFreq[b] = (biFreq[b] || 0) + 1;

    const scored = {};
    for (const [word, f] of Object.entries(freq)) {
      scored[word] = f / filtered.length;
    }
    for (const [bigram, f] of Object.entries(biFreq)) {
      if (f > 1) scored[bigram] = (f / filtered.length) * 1.5;
    }

    const sorted = Object.entries(scored).sort((a, b) => b[1] - a[1]);
    const maxScore = sorted.length > 0 ? sorted[0][1] : 1;

    const tags = [];
    for (const [term, score] of sorted) {
      if (tags.length >= count) break;
      const pct = Math.min(100, Math.round((score / maxScore) * 100));
      if (pct >= 10) {
        const hashtag = '#' + term.replace(/\s+/g, '');
        tags.push({ term, score: pct, hashtag });
      }
    }

    const category = detectCategory(filtered);
    if (category) {
      const catTags = getCategoryTags(category);
      for (const ct of catTags) {
        if (tags.length >= count) break;
        if (!tags.find((t) => t.hashtag === '#' + ct)) {
          tags.push({ term: ct, score: 60 + Math.floor(Math.random() * 25), hashtag: '#' + ct });
        }
      }
    }

    return { tags, category };
  }

  document.getElementById('generate-btn').addEventListener('click', () => {
    const text = document.getElementById('input-text').value;
    const count = parseInt(document.getElementById('tag-count').value);
    const results = generateTags(text, count);

    if (results.tags.length === 0) {
      if (window.__showToast)
        window.__showToast({ message: 'Please enter more content to generate tags', variant: 'warning' });
      return;
    }

    document.getElementById('results').classList.remove('hidden');

    const catBadge = document.getElementById('category-badge');
    if (results.category) {
      catBadge.classList.remove('hidden');
      catBadge.querySelector('span').textContent = '\uD83C\uDFC6 ' + results.category;
    } else {
