---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";
import ToolContentSections from "../../components/ToolContentSections.astro";

const faqItems = [
  { question: "What is the Fisher-Yates shuffle algorithm?", answer: "The Fisher-Yates shuffle is a mathematically optimal algorithm for generating a random permutation of a finite sequence. It works by iterating through the array from the last element to the first, swapping each element with a randomly selected earlier element, ensuring every permutation is equally likely." },
  { question: "Can I pick multiple random items at once?", answer: "Yes, use the 'Pick Random' button with the count input to specify how many random items you want selected from your list. The items are picked without replacement, so each item can only be selected once per pick." },
  { question: "What happens if my list has empty lines?", answer: "Empty lines are automatically filtered out. Only non-empty lines are considered as list items. This makes it easy to paste multi-line content without worrying about trailing or extra blank lines." },
];
const schema = { name: "List Randomizer", applicationCategory: "Utilities", description: "Randomize lists with Fisher-Yates shuffle. Shuffle items, pick random entries, and manage your lists easily.", featureList: ["Fisher-Yates shuffle", "Random item picker", "Custom pick count", "Clear and reset"] };
---
<MainLayout title="List Randomizer - Shuffle and Randomize Lists Online" description="Randomize lists with Fisher-Yates shuffle. Shuffle items, pick random entries, and manage your lists easily." keywords="list randomizer, shuffle list, random picker, fisher-yates shuffle, list shuffler" toolSchema={schema} faq={faqItems}
  howto={{
    name: "How to Use List Randomizer",
    description: "Step-by-step guide for using List Randomizer.",
    steps: [],
    totalTime: "PT1M",
  }}
  breadcrumbs={[{name:"Home",url:"/"},{name:"Tools",url:"/tools/"},{name:"List Randomizer",url:"/tools/list-randomizer/"}]}>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden"><div class="max-w-4xl mx-auto">
    <ToolHeader title="List" gradient="Randomizer Pro" desc="Randomize lists with Fisher-Yates shuffle. Shuffle items, pick random entries, and manage your lists easily." badge="✦ New Tool" slug="list-randomizer" />
    <ShareBar />
    <div class="max-w-xl mx-auto mt-10">
      <div class="bg-surface-1 border border-surface rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
            <span id="usage-badge" class="text-xs text-muted"></span>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex gap-1">
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="purple" style="background:#a855f7"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="blue" style="background:#3b82f6"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="green" style="background:#22c55e"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="pink" style="background:#ec4899"></button>
            </div>
            <button id="fullscreen-btn" class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs" title="Fullscreen">⛶</button>
          </div>
        </div>
        <label class="block text-xs font-medium text-tertiary mb-1.5">Enter List (one item per line)</label>
        <div class="flex items-center gap-1.5 mb-2">
          <button class="font-dec p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40">A−</button>
          <button class="font-inc p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40">A+</button>
          <span class="text-xs text-muted ml-auto">Ctrl+Enter to process</span>
        </div>
        <div class="flex">
          <div id="line-nums" class="text-xs text-muted text-right pr-2 select-none overflow-hidden font-mono leading-relaxed pt-3" style="min-width:2.5em">1</div>
          <textarea id="input-text" class="flex-1 h-32 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-teal-400/50 focus:outline-none transition-all resize-none font-mono" placeholder="Item 1&#10;Item 2&#10;Item 3"></textarea>
        </div>
        <div id="reading-time" class="text-xs text-muted mt-1"></div>
        <div class="flex items-center gap-2 mt-3 mb-4">
          <label class="text-xs text-tertiary">Pick count:</label>
          <input id="pick-count" type="number" min="1" value="1" class="w-16 px-2 py-1.5 rounded-lg border border-surface-2 bg-surface-1 text-white text-sm focus:border-teal-400/50 focus:outline-none transition-all" />
        </div>
        <div class="flex flex-wrap gap-2">
          <button id="shuffle-btn" class="bg-gradient-to-r from-teal-400 to-cyan-500 text-white font-bold text-xs px-4 py-2 rounded-xl hover:opacity-90 transition-all">Shuffle</button>
          <button id="pick-btn" class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-4 py-2 rounded-xl border border-surface-3 transition-all">Pick Random</button>
          <button id="copy-btn" class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-4 py-2 rounded-xl border border-surface-3 transition-all">Copy</button>
          <button id="download-btn" class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-4 py-2 rounded-xl border border-surface-3 transition-all">Download</button>
          <select id="export-format" class="bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5">
            <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option><option value="html">HTML</option>
          </select>
          <button id="clear-btn" class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-4 py-2 rounded-xl border border-surface-3 transition-all">Clear</button>
          <button id="share-btn" class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-4 py-2 rounded-xl border border-surface-3 transition-all" title="Share">🔗</button>
        </div>
        <div id="results-area" class="mt-6 pt-6 border-t border-surface hidden">
          <span class="text-xs font-medium text-tertiary mb-3 block">Results</span>
          <ol id="results-list" class="space-y-1.5 list-decimal list-inside"></ol>
          <div id="letter-freq" class="mt-2 space-y-0.5 max-h-24 overflow-y-auto hidden"></div>
        </div>
      </div>
    </div>
    <section class="mt-20 max-w-3xl mx-auto"><div class="text-center mb-8"><span class="text-xs font-semibold text-teal-400 uppercase tracking-wider">Learn</span><h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">List <span class="bg-gradient-to-r from-teal-400 to-cyan-500 bg-clip-text text-transparent">Randomization</span></h2></div><div class="space-y-4 text-sm text-tertiary leading-relaxed"><p>List randomization is essential for drawing winners, creating random groups, ordering items unbiasedly, and conducting fair selections. The Fisher-Yates shuffle ensures that every possible permutation of your list is equally likely, making it the gold standard for unbiased shuffling. Whether you need a completely shuffled list or just a few random picks, this tool provides both functionalities seamlessly.</p></div></section>
    <RelatedTools current="list-randomizer" />
    <div class="mt-20 max-w-3xl mx-auto"><h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">Frequently Asked <span class="bg-gradient-to-r from-teal-400 to-cyan-500 bg-clip-text text-transparent">Questions</span></h2><Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} /></div>
  </div></main>
</MainLayout>
<script>
  const listInput = document.getElementById("input-text");
  const pickCount = document.getElementById("pick-count");
  const shuffleBtn = document.getElementById("shuffle-btn");
  const pickBtn = document.getElementById("pick-btn");
  const clearBtn = document.getElementById("clear-btn");
  const resultsArea = document.getElementById("results-area");
  const resultsList = document.getElementById("results-list");

  function getItems() {
    return listInput.value.split("\n").filter(line => line.trim() !== "");
  }

  function shuffle(array) {
    const arr = [...array];
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function display(items) {
    resultsList.innerHTML = "";
    items.forEach((item, i) => {
      const li = document.createElement("li");
      li.className = "text-sm text-white font-mono bg-surface-2 border border-surface-3 rounded-lg px-3 py-2";
      li.textContent = item;
      resultsList.appendChild(li);
    });
    resultsArea.classList.remove("hidden");
  }

  shuffleBtn.addEventListener("click", () => {
    const items = getItems();
    if (items.length === 0) return;
    display(shuffle(items));
  });

  pickBtn.addEventListener("click", () => {
    const items = getItems();
    if (items.length === 0) return;
    const count = Math.min(parseInt(pickCount.value) || 1, items.length);
    const shuffled = shuffle(items);
    display(shuffled.slice(0, count));
  });

  clearBtn.addEventListener("click", () => {
    listInput.value = "";
    resultsList.innerHTML = "";
    resultsArea.classList.add("hidden");
  });

  // ─── Copy ───
  document.getElementById("copy-btn")?.addEventListener("click", () => {
    const items = [...resultsList.querySelectorAll("li")].map(li => li.textContent);
    if (items.length === 0) return;
    navigator.clipboard.writeText(items.join("\n")).catch(() => {});
    playPing();
    const btn = document.getElementById("copy-btn");
    btn.textContent = "Copied!";
    setTimeout(() => { btn.textContent = "Copy"; }, 2000);
  });

  // ─── Download with export format ───
  document.getElementById("download-btn")?.addEventListener("click", () => {
    const items = [...resultsList.querySelectorAll("li")].map(li => li.textContent);
    if (items.length === 0) return;
    const fmt = document.getElementById("export-format")?.value || "txt";
    let content, filename, mime;
    switch (fmt) {
      case "json":
        content = JSON.stringify(items, null, 2);
        filename = "randomized-list.json";
        mime = "application/json";
        break;
      case "csv":
        content = "Item\n" + items.map(i => `"${i.replace(/"/g,'""')}"`).join("\n");
        filename = "randomized-list.csv";
        mime = "text/csv";
        break;
      case "html":
        content = "<ol>" + items.map(i => `<li>${i.replace(/[<>&]/g,c=>c==='<'?'&lt;':c==='>'?'&gt;':'&amp;')}</li>`).join("") + "</ol>";
        filename = "randomized-list.html";
        mime = "text/html";
        break;
      default:
        content = items.join("\n");
        filename = "randomized-list.txt";
        mime = "text/plain";
    }
    const blob = new Blob([content], {type:mime});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = filename;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // ─── Fullscreen ───
  document.getElementById("fullscreen-btn")?.addEventListener("click", () => {
    const card = document.getElementById("fullscreen-btn").closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) { document.exitFullscreen(); document.getElementById("fullscreen-btn").textContent = "⛶"; }
    else { card.requestFullscreen?.() || card.webkitRequestFullscreen?.(); document.getElementById("fullscreen-btn").textContent = "✕"; }
  });
  document.addEventListener("fullscreenchange", () => {
    const btn = document.getElementById("fullscreen-btn");
    if (btn) btn.textContent = document.fullscreenElement ? "✕" : "⛶";
  });

  // ─── Auto-save draft ───
  const DRAFT_KEY = "nt_draft_list-randomizer";
  (function() {
    const input = document.getElementById("input-text") || document.querySelector("textarea:not([readonly])");
    if (!input) return;
    try {
      const saved = localStorage.getItem(DRAFT_KEY);
      if (saved && !input.value) { input.value = saved; input.dispatchEvent(new Event("input")); }
    } catch(e) {}
    let saveTimer;
    input.addEventListener("input", () => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => { try { localStorage.setItem(DRAFT_KEY, input.value); } catch(e) {} }, 500);
    });
  })();

  // ─── Font size ───
  document.querySelector(".font-inc")?.addEventListener("click",()=>{document.querySelectorAll("textarea").forEach(t=>{let s=parseInt(getComputedStyle(t).fontSize);t.style.fontSize=Math.min(24,s+2)+"px";});});
  document.querySelector(".font-dec")?.addEventListener("click",()=>{document.querySelectorAll("textarea").forEach(t=>{let s=parseInt(getComputedStyle(t).fontSize);t.style.fontSize=Math.max(10,s-2)+"px";});});
  try{const s=localStorage.getItem("nt_fs");if(s)document.querySelectorAll("textarea").forEach(t=>t.style.fontSize=s+"px");}catch(e){}

  // ─── Keyboard shortcuts ───
  document.addEventListener("keydown",e=>{if(e.ctrlKey&&e.key==="Enter"){e.preventDefault();const b=document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");if(b)b.click();}if(e.ctrlKey&&e.shiftKey&&(e.key==="C"||e.key==="c")){e.preventDefault();document.getElementById("clear-btn")?.click();}if(e.ctrlKey&&(e.key==="D"||e.key==="d")){e.preventDefault();document.getElementById("download-btn")?.click();}});

  // ─── Usage badge ───
  try{const u=JSON.parse(localStorage.getItem("nt_tool_usage")||"{}");const b=document.getElementById("usage-badge");if(b&&u["list-randomizer"])b.textContent="Used "+u["list-randomizer"]+"×";}catch(e){}

  // ─── Share button ───
  document.getElementById("share-btn")?.addEventListener("click",()=>{const o=document.getElementById("output-text")||document.querySelector("[id$='result']");const t=o?.value||o?.textContent||"";if(!t)return;const u=window.location.origin+window.location.pathname+"#result="+encodeURIComponent(t.substring(0,200));navigator.clipboard.writeText(u).catch(()=>{});if(typeof showToast==="function")showToast("Link copied!");});

  // ─── Sound effects ───
  function playPing(){try{const a=new(window.AudioContext||window.webkitAudioContext)();const o=a.createOscillator();const g=a.createGain();o.connect(g);g.connect(a.destination);o.frequency.value=800;g.gain.setValueAtTime(0.08,a.currentTime);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+0.12);o.start();o.stop(a.currentTime+0.12);}catch(e){}}

  // ─── Color theme picker ───
  document.querySelectorAll(".theme-swatch").forEach(s=>{s.addEventListener("click",()=>{const c=s.dataset.color;document.querySelectorAll("button[class*='bg-purple'],button[class*='bg-violet']").forEach(b=>{b.className=b.className.replace(/bg-(purple|violet)-\d+/g,"bg-"+c+"-600").replace(/hover:bg-(purple|violet)-\d+/g,"hover:bg-"+c+"-500");});try{localStorage.setItem("nt_theme",c);}catch(e){}});});
  try{const c=localStorage.getItem("nt_theme");if(c)document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();}catch(e){}

  // ─── Reading time ───
  const rt=document.getElementById("input-text")||document.querySelector("textarea:not([readonly])");if(rt){rt.addEventListener("input",()=>{const w=rt.value?rt.value.trim().split(/\s+/).length:0;const e=document.getElementById("reading-time");if(e)e.textContent=Math.max(1,Math.round(w/200))+"m read · "+Math.max(1,Math.round(w/150))+"m speak";});rt.dispatchEvent(new Event("input"));}

  // ─── Line numbers ───
  const li=document.getElementById("input-text");if(li){const ul=()=>{const n=document.getElementById("line-nums");if(n)n.textContent=Array.from({length:li.value.split("\n").length},(_,i)=>i+1).join("\n");};li.addEventListener("input",ul);li.addEventListener("scroll",()=>{const n=document.getElementById("line-nums");if(n)n.scrollTop=li.scrollTop;});ul();}

  // ─── Letter frequency ───
  const lf=document.getElementById("input-text");if(lf){lf.addEventListener("input",()=>{const t=lf.value.toLowerCase().replace(/[^a-z]/g,"");if(!t){document.getElementById("letter-freq")?.classList.add("hidden");return;}const f={};for(const c of t)f[c]=(f[c]||0)+1;const s=Object.entries(f).sort((a,b)=>b[1]-a[1]).slice(0,8);const m=s[0]?s[0][1]:1;const el=document.getElementById("letter-freq");el.classList.remove("hidden");el.innerHTML=s.map(([c,n])=>`<div class="flex items-center gap-1.5 text-xs"><span class="w-3 text-center font-mono text-white">${c}</span><div class="h-2 rounded-full bg-purple-500/50" style="width:${(n/m)*80+10}%"></div><span class="text-muted">${n}</span></div>`).join("");});}
</script>
