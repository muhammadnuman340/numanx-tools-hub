---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'What is the Fisher-Yates shuffle algorithm?',
    answer:
      'The Fisher-Yates shuffle is a mathematically optimal algorithm for generating a random permutation of a finite sequence. It works by iterating through the array from the last element to the first, swapping each element with a randomly selected earlier element, ensuring every permutation is equally likely.',
  },
  {
    question: 'Can I pick multiple random items at once?',
    answer:
      "Yes, use the 'Pick Random' button with the count input to specify how many random items you want selected from your list. The items are picked without replacement, so each item can only be selected once per pick.",
  },
  {
    question: 'What happens if my list has empty lines?',
    answer:
      'Empty lines are automatically filtered out. Only non-empty lines are considered as list items. This makes it easy to paste multi-line content without worrying about trailing or extra blank lines.',
  },
];
const schema = {
  name: 'List Randomizer',
  applicationCategory: 'Utilities',
  description:
    'Randomize lists with Fisher-Yates shuffle. Shuffle items, pick random entries, and manage your lists easily.',
  featureList: ['Fisher-Yates shuffle', 'Random item picker', 'Custom pick count', 'Clear and reset'],
};
---

<MainLayout
  title="Giveaway Winner Picker & Fisher-Yates Random List Shuffler Online | NumanX Tools"
  description="Randomize lists and pick unbiased giveaway winners using the Fisher-Yates shuffle algorithm. Free online random list shuffler and item picker."
  keywords="giveaway winner picker, random list shuffler, fisher yates shuffle, unbiased name wheel, random item picker"
  toolSchema={schema}
  faq={faqItems}
  howto={{
    name: 'How to Use List Randomizer',
    description: 'Step-by-step guide for using List Randomizer.',
    steps: [],
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'List Randomizer', url: '/tools/list-randomizer/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="List"
        gradient="Randomizer Pro"
        desc="Randomize lists with Fisher-Yates shuffle. Shuffle items, pick random entries, and manage your lists easily."
        badge="✦ New Tool"
        slug="list-randomizer"
      />
      <ShareBar />
      <div class="max-w-xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
              <span id="usage-badge" class="text-xs text-muted"></span>
            </div>
              <div class="flex gap-1" role="group" aria-label="Theme color swatches">
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="purple"
                  aria-label="Set purple theme"
                  style="background:#a855f7"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="blue"
                  aria-label="Set blue theme"
                  style="background:#3b82f6"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="green"
                  aria-label="Set green theme"
                  style="background:#22c55e"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="pink"
                  aria-label="Set pink theme"
                  style="background:#ec4899"></button>
              </div>
              <button
                id="fullscreen-btn"
                aria-label="Toggle fullscreen"
                class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs"
                title="Fullscreen">⛶</button
              >
            </div>
          </div>
          <div class="flex items-center justify-between min-h-[32px] mb-2">
            <label for="input-text" class="text-xs font-semibold text-zinc-300">Enter List (one item per line)</label>
            <div class="flex items-center gap-1.5">
              <div class="flex items-center gap-0.5 bg-surface-2 p-0.5 rounded-lg border border-surface">
                <button
                  type="button"
                  aria-label="Decrease font size"
                  class="font-dec px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                  >A−</button
                >
                <button
                  type="button"
                  aria-label="Increase font size"
                  class="font-inc px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                  >A+</button
                >
              </div>
              <span class="text-xs text-muted ml-2">Ctrl+Enter to process</span>
            </div>
          </div>
          <div class="flex h-[220px] rounded-xl bg-black/40 border border-surface focus-within:border-teal-400 focus-within:ring-1 focus-within:ring-teal-400 transition-all overflow-hidden relative">
            <div
              id="line-nums"
              class="w-12 shrink-0 h-full select-none overflow-hidden font-mono text-sm leading-6 text-right pr-3.5 py-3 text-zinc-500/80 bg-zinc-950/60 border-r border-white/5 whitespace-pre pointer-events-none tabular-nums"
              style="line-height: 24px; font-size: 14px;"
            >
              1
            </div>
            <textarea
              id="input-text"
              aria-label="List of items input"
              class="flex-1 min-w-0 h-full bg-transparent text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 px-4 py-3 focus:outline-none font-mono resize-none border-0 overflow-y-auto"
              style="line-height: 24px; font-size: 14px;"
              placeholder="Item 1
Item 2
Item 3"></textarea>
          </div>
          <div id="reading-time" class="text-xs text-muted mt-2"></div>
          <div class="flex items-center gap-2 mt-3 mb-4">
            <label class="text-xs text-tertiary">Pick count:</label>
            <input
              id="pick-count"
              type="number"
              min="1"
              value="1"
              class="w-16 px-2 py-1.5 rounded-lg border border-surface-2 bg-surface-1 text-white text-sm focus:border-teal-400/50 focus:outline-none transition-all"
            />
          </div>
          <div class="flex flex-wrap gap-2">
            <button
              id="shuffle-btn"
              class="bg-gradient-to-r from-teal-400 to-cyan-500 text-white font-bold text-xs px-4 py-2 rounded-xl hover:opacity-90 transition-all"
              >Shuffle</button
            >
            <button
              id="pick-btn"
              class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-4 py-2 rounded-xl border border-surface-3 transition-all"
              >Pick Random</button
            >
            <button
              id="copy-btn"
              class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-4 py-2 rounded-xl border border-surface-3 transition-all"
              >Copy</button
            >
            <button
              id="download-btn"
              class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-4 py-2 rounded-xl border border-surface-3 transition-all"
              >Download</button
            >
            <select
              id="export-format"
              class="bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5"
            >
              <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option><option
                value="html">HTML</option
              >
            </select>
            <button
              id="clear-btn"
              class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-4 py-2 rounded-xl border border-surface-3 transition-all"
              >Clear</button
            >
            <button
              id="share-btn"
              class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-4 py-2 rounded-xl border border-surface-3 transition-all"
              title="Share">🔗</button
            >
          </div>
          <div id="results-area" class="mt-6 pt-6 border-t border-surface hidden">
            <span class="text-xs font-medium text-tertiary mb-3 block">Results</span>
            <ol id="results-list" class="space-y-1.5 list-decimal list-inside"></ol>
            <div id="letter-freq" tabindex="0" role="region" aria-label="Character frequency breakdown" class="mt-2 flex flex-wrap gap-1.5 hidden"></div>
          </div>
        </div>
      </div>
      <section class="mt-20 max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-teal-400 uppercase tracking-wider">Learn</span><h2
            class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1"
          >
            List <span class="bg-gradient-to-r from-teal-400 to-cyan-500 bg-clip-text text-transparent"
              >Randomization</span
            >
          </h2>
        </div><div class="space-y-4 text-sm text-tertiary leading-relaxed">
          <p>
            List randomization is essential for drawing winners, creating random groups, ordering items unbiasedly, and
            conducting fair selections. The Fisher-Yates shuffle ensures that every possible permutation of your list is
            equally likely, making it the gold standard for unbiased shuffling. Whether you need a completely shuffled
            list or just a few random picks, this tool provides both functionalities seamlessly.
          </p>
        </div>
      </section>
      <RelatedTools current="list-randomizer" />
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span class="bg-gradient-to-r from-teal-400 to-cyan-500 bg-clip-text text-transparent"
            >Questions</span
          >
        </h2><Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>
<script>
  const listInput = document.getElementById('input-text');
  const pickCount = document.getElementById('pick-count');
  const shuffleBtn = document.getElementById('shuffle-btn');
  const pickBtn = document.getElementById('pick-btn');
  const clearBtn = document.getElementById('clear-btn');
  const resultsArea = document.getElementById('results-area');
  const resultsList = document.getElementById('results-list');

  function getItems() {
    return listInput.value.split('\n').filter((line) => line.trim() !== '');
  }

  function shuffle(array) {
    const arr = [...array];
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function display(items) {
    resultsList.innerHTML = '';
    items.forEach((item, i) => {
      const li = document.createElement('li');
      li.className = 'text-sm text-white font-mono bg-surface-2 border border-surface-3 rounded-lg px-3 py-2';
      li.textContent = item;
      resultsList.appendChild(li);
    });
    resultsArea.classList.remove('hidden');
  }

  shuffleBtn.addEventListener('click', () => {
    const items = getItems();
    if (items.length === 0) return;
    display(shuffle(items));
  });

  pickBtn.addEventListener('click', () => {
    const items = getItems();
    if (items.length === 0) return;
    const count = Math.min(parseInt(pickCount.value) || 1, items.length);
    const shuffled = shuffle(items);
    display(shuffled.slice(0, count));
  });

  clearBtn.addEventListener('click', () => {
    listInput.value = '';
    resultsList.innerHTML = '';
    resultsArea.classList.add('hidden');
  });

  // ─── Copy ───
  document.getElementById('copy-btn')?.addEventListener('click', () => {
    const items = [...resultsList.querySelectorAll('li')].map((li) => li.textContent);
    if (items.length === 0) return;
    navigator.clipboard.writeText(items.join('\n')).catch(() => {});
    playPing();
    const btn = document.getElementById('copy-btn');
    btn.textContent = 'Copied!';
    setTimeout(() => {
      btn.textContent = 'Copy';
    }, 2000);
  });

  // ─── Download with export format ───
  document.getElementById('download-btn')?.addEventListener('click', () => {
    const items = [...resultsList.querySelectorAll('li')].map((li) => li.textContent);
    if (items.length === 0) return;
    const fmt = document.getElementById('export-format')?.value || 'txt';
    let content, filename, mime;
    switch (fmt) {
      case 'json':
        content = JSON.stringify(items, null, 2);
        filename = 'randomized-list.json';
        mime = 'application/json';
        break;
      case 'csv':
        content = 'Item\n' + items.map((i) => `"${i.replace(/"/g, '""')}"`).join('\n');
        filename = 'randomized-list.csv';
        mime = 'text/csv';
        break;
      case 'html':
        content =
          '<ol>' +
          items
            .map((i) => `<li>${i.replace(/[<>&]/g, (c) => (c === '<' ? '&lt;' : c === '>' ? '&gt;' : '&amp;'))}</li>`)
            .join('') +
          '</ol>';
        filename = 'randomized-list.html';
        mime = 'text/html';
        break;
      default:
        content = items.join('\n');
        filename = 'randomized-list.txt';
        mime = 'text/plain';
    }
    const blob = new Blob([content], { type: mime });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = filename;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // ─── Fullscreen ───
  document.getElementById('fullscreen-btn')?.addEventListener('click', () => {
    const card = document.getElementById('fullscreen-btn').closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
      document.getElementById('fullscreen-btn').textContent = '⛶';
    } else {
      card.requestFullscreen?.() || card.webkitRequestFullscreen?.();
      document.getElementById('fullscreen-btn').textContent = '✕';
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const btn = document.getElementById('fullscreen-btn');
    if (btn) btn.textContent = document.fullscreenElement ? '✕' : '⛶';
  });

  // ─── Auto-save draft ───
  const DRAFT_KEY = 'nt_draft_list-randomizer';
  (function () {
    const input = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
    if (!input) return;
    try {
      const saved = localStorage.getItem(DRAFT_KEY);
      if (saved && !input.value) {
        input.value = saved;
        input.dispatchEvent(new Event('input'));
      }
    } catch (e) {}
    let saveTimer;
    input.addEventListener('input', () => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        try {
          localStorage.setItem(DRAFT_KEY, input.value);
        } catch (e) {}
      }, 500);
    });
  })();

  // ─── Font size ───
  const updateEditorFontSize = (newSize: number) => {
    const clamped = Math.max(10, Math.min(24, newSize));
    const lineHeight = Math.round(clamped * 1.7);
    document.querySelectorAll('textarea').forEach((t) => {
      t.style.fontSize = clamped + 'px';
      t.style.lineHeight = lineHeight + 'px';
    });
    const lineNums = document.getElementById('line-nums');
    if (lineNums) {
      lineNums.style.fontSize = clamped + 'px';
      lineNums.style.lineHeight = lineHeight + 'px';
    }
    try {
      localStorage.setItem('nt_fs', String(clamped));
    } catch (e) {}
  };

  document.querySelector('.font-inc')?.addEventListener('click', () => {
    const ta = document.getElementById('input-text');
    const s = parseInt(getComputedStyle(ta as HTMLElement).fontSize) || 14;
    updateEditorFontSize(s + 2);
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    const ta = document.getElementById('input-text');
    const s = parseInt(getComputedStyle(ta as HTMLElement).fontSize) || 14;
    updateEditorFontSize(s - 2);
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) updateEditorFontSize(parseInt(s));
  } catch (e) {}

  // ─── Keyboard shortcuts ───
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b = document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      document.getElementById('clear-btn')?.click();
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });

  // ─── Usage badge ───
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['list-randomizer']) b.textContent = 'Used ' + u['list-randomizer'] + '×';
  } catch (e) {}

  // ─── Share button ───
  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('output-text') || document.querySelector("[id$='result']");
    const t = o?.value || o?.textContent || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof showToast === 'function') showToast('Link copied!');
  });

  // ─── Sound effects ───
  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }

  // ─── Color theme picker ───
  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      document.querySelectorAll("button[class*='bg-purple'],button[class*='bg-violet']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(purple|violet)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(purple|violet)-\d+/g, 'hover:bg-' + c + '-500');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}

  // ─── Reading time ───
  const rt = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
  if (rt) {
    rt.addEventListener('input', () => {
      const w = rt.value ? rt.value.trim().split(/\s+/).length : 0;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent = Math.max(1, Math.round(w / 200)) + 'm read · ' + Math.max(1, Math.round(w / 150)) + 'm speak';
    });
    rt.dispatchEvent(new Event('input'));
  }

  // ─── Line numbers ───
  const li = document.getElementById('input-text');
  if (li) {
    const ul = () => {
      const n = document.getElementById('line-nums');
      if (n) n.textContent = Array.from({ length: li.value.split('\n').length }, (_, i) => i + 1).join('\n');
    };
    li.addEventListener('input', ul);
    li.addEventListener('scroll', () => {
      const n = document.getElementById('line-nums');
      if (n) n.scrollTop = li.scrollTop;
    });
    ul();
  }

  // ─── Letter frequency ───
  const lf = document.getElementById('input-text');
  if (lf) {
    lf.addEventListener('input', () => {
      const t = lf.value.toLowerCase().replace(/[^a-z]/g, '');
      if (!t) {
        document.getElementById('letter-freq')?.classList.add('hidden');
        return;
      }
      const f = {};
      for (const c of t) f[c] = (f[c] || 0) + 1;
      const s = Object.entries(f)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8);
      const m = s[0] ? s[0][1] : 1;
      const el = document.getElementById('letter-freq');
      el.classList.remove('hidden');
      el.innerHTML = s
        .map(
          ([c, n]) =>
            `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-xs font-mono"><strong class="text-teal-400 uppercase">${c}</strong><span class="text-zinc-400">${n}</span></span>`,
        )
        .join('');
    });
  }
</script>
