  function isStopWord(w) {
    return stopWords.has(w) || /^[0-9]+$/.test(w) || w.length < 2;
  }

  function extractKeywords(text) {
    const clean = text
      .toLowerCase()
      .replace(/[^a-z0-9\s'-]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
    const words = clean.split(/\s+/).filter((w) => w && !isStopWord(w));

    // Single word frequencies
    const freq = {};
    words.forEach((w) => {
      freq[w] = (freq[w] || 0) + 1;
    });

    // Bigram frequencies
    const bigramFreq = {};
    for (let i = 0; i < words.length - 1; i++) {
      if (!isStopWord(words[i]) && !isStopWord(words[i + 1])) {
        const bg = words[i] + ' ' + words[i + 1];
        bigramFreq[bg] = (bigramFreq[bg] || 0) + 1;
      }
    }

    // Filter out bigrams that appear only once
    const significantBigrams = Object.entries(bigramFreq)
      .filter(([, count]) => count > 1)
      .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

    const sorted = Object.entries(freq)
      .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
      .slice(0, 30);

    // Limit bigrams
    const topBigrams = significantBigrams.slice(0, 15);

    return { keywords: sorted, bigrams: topBigrams };
  }

  function getFontSize(count, maxCount, minCount) {
    const range = maxCount - minCount || 1;
    const normalized = (count - minCount) / range;
    return Math.round(10 + normalized * 26);
  }

  function getOpacity(count, maxCount, minCount) {
    const range = maxCount - minCount || 1;
    const normalized = (count - minCount) / range;
    return 0.5 + normalized * 0.5;
  }

  function getColor(i) {
    const colors = [
      'from-violet-400',
      'from-blue-400',
      'from-purple-400',
      'from-indigo-400',
      'from-fuchsia-400',
      'from-teal-400',
      'from-cyan-400',
      'from-rose-400',
      'from-pink-400',
      'from-sky-400',
    ];
    const toColors = [
      'to-purple-600',
      'to-indigo-600',
      'to-fuchsia-600',
      'to-blue-600',
      'to-pink-600',
      'to-teal-600',
      'to-cyan-600',
      'to-rose-600',
      'to-violet-600',
      'to-sky-600',
    ];
    return { from: colors[i % colors.length], to: toColors[i % toColors.length] };
  }

  function drawKeywordChart(canvasId, keywords) {
    const canvas = document.getElementById(canvasId);
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width,
      h = canvas.height;
    ctx.clearRect(0, 0, w, h);
    const top10 = keywords.slice(0, 8);
    const max = top10[0] ? top10[0][1] : 1;
    const barH = 14;
    const gap = 4;
    const startX = 70;
    const startY = 20;
    const colors = ['#a855f7', '#8b5cf6', '#7c3aed', '#6d28d9', '#5b21b6', '#4c1d95', '#3b0764', '#2e1065'];
    ctx.font = '10px sans-serif';
    top10.forEach(([word, count], i) => {
      const y = startY + i * (barH + gap);
      const barW = (count / max) * (w - startX - 20);
      ctx.fillStyle = '#a1a1aa';
      ctx.textAlign = 'right';
      ctx.fillText(word.length > 10 ? word.slice(0, 10) + '...' : word, startX - 5, y + 10);
      ctx.fillStyle = colors[i % colors.length];
      ctx.beginPath();
      const r = 3;
      ctx.moveTo(startX + r, y);
      ctx.lineTo(startX + Math.max(barW, 2) - r, y);
      ctx.arcTo(startX + Math.max(barW, 2), y, startX + Math.max(barW, 2), y + r, r);
      ctx.lineTo(startX + Math.max(barW, 2), y + barH - r);
      ctx.arcTo(startX + Math.max(barW, 2), y + barH, startX + Math.max(barW, 2) - r, y + barH, r);
      ctx.lineTo(startX + r, y + barH);
      ctx.arcTo(startX, y + barH, startX, y + barH - r, r);
      ctx.lineTo(startX, y + r);
      ctx.arcTo(startX, y, startX + r, y, r);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = '#e4e4e7';
      ctx.textAlign = 'left';
      ctx.font = 'bold 10px sans-serif';
      ctx.fillText(count + 'x', startX + barW + 5, y + 10);
      ctx.font = '10px sans-serif';
    });
  }

  extractBtn.addEventListener('click', () => {
    const text = inputEl.value.trim();
    if (!text) {
      triggerToast('Please enter some text to extract keywords', 'warning');
      return;
    }
    if (text.split(/\s+/).filter((w) => w).length < 5) {
      triggerToast('Please enter at least 5 words', 'warning');
      return;
    }

    const { keywords, bigrams } = extractKeywords(text);
    resultsArea.classList.remove('hidden');

    if (keywords.length === 0) {
      keywordsList.innerHTML =
        '<p class="text-xs text-dim text-center py-4">No significant keywords found. Try longer or more varied text.</p>';
      wordCloud.innerHTML = '';
      bigramsList.innerHTML = '';
      return;
    }

    const maxCount = keywords[0][1];
    const minCount = keywords[keywords.length - 1][1];

    keywordsList.innerHTML = keywords
      .slice(0, 20)
      .map(([word, count], i) => {
        const barW = (count / maxCount) * 100;
        return `<div class="flex items-center gap-3">
        <span class="text-xs text-dim w-5 text-right">${i + 1}</span>
        <span class="text-xs text-secondary font-medium w-32 truncate">${word}</span>
        <div class="flex-1 h-2 rounded-full bg-zinc-800 overflow-hidden">
          <div class="h-full rounded-full bg-gradient-to-r from-violet-500 to-purple-500 transition-all" style="width:${barW}%"></div>
        </div>
        <span class="text-xs text-dim w-12 text-right tabular-nums">${count}x</span>
      </div>`;
      })
      .join('');

    drawKeywordChart('keyword-chart', keywords);

    wordCloud.innerHTML = keywords
      .slice(0, 40)
      .map(([word, count], i) => {
        const size = getFontSize(count, maxCount, minCount);
        const opacity = getOpacity(count, maxCount, minCount);
        const c = getColor(i);
        return `<span class="inline-block bg-gradient-to-r ${c.from} ${c.to} bg-clip-text text-transparent font-bold transition-all hover:scale-110 cursor-default" style="font-size:${size}px;opacity:${opacity}">${word}</span>`;
      })
      .join('');

    if (bigrams.length > 0) {
      bigramsList.innerHTML = bigrams
        .map(
          ([phrase, count]) =>
            `<span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-surface-1 border border-surface-3 rounded-lg text-xs text-secondary font-medium">
          <span>${phrase}</span>
          <span class="text-xs text-violet-400 font-bold">${count}x</span>
        </span>`,
        )
        .join('');
    } else {
      bigramsList.innerHTML = '<span class="text-xs text-dim">No significant phrase repetitions found</span>';
    }

    triggerToast(`Extracted ${keywords.length} keywords!`, 'success');
  });

  copyKeywordsBtn.addEventListener('click', async () => {
    const text = inputEl.value.trim();
    if (!text) {
      triggerToast('Nothing to copy!', 'warning');
      return;
    }
    const { keywords, bigrams } = extractKeywords(text);
    const kwText = keywords.map(([w, c]) => `${w} (${c})`).join('\n');
    const bigramText = bigrams.length > 0 ? '\n\nBigrams:\n' + bigrams.map(([p, c]) => `${p} (${c})`).join('\n') : '';
    await navigator.clipboard.writeText('Keywords:\n' + kwText + bigramText);
    triggerToast('Keywords copied to clipboard!', 'success');
  });

  document.getElementById('download-btn')?.addEventListener('click', () => {
    const text = inputEl.value.trim();
    if (!text) {
      triggerToast('Nothing to download!', 'warning');
      return;
    }
    const { keywords, bigrams } = extractKeywords(text);
    const kwText = keywords.map(([w, c]) => `${w} (${c})`).join('\n');
    const bigramText = bigrams.length > 0 ? '\n\nBigrams:\n' + bigrams.map(([p, c]) => `${p} (${c})`).join('\n') : '';
    const outputText = 'Keywords:\n' + kwText + bigramText;
    const fmt = document.getElementById('export-format')?.value || 'txt';
    let content = outputText;
    let mime = 'text/plain';
    let ext = 'txt';
    if (fmt === 'json') {
      content = JSON.stringify({
        result: outputText,
        tool: 'ai-keyword-extractor',
        timestamp: new Date().toISOString(),
      });
      mime = 'application/json';
      ext = 'json';
    }
    if (fmt === 'csv') {
      content = 'Result\n"' + outputText.replace(/"/g, '""') + '"';
      mime = 'text/csv';
      ext = 'csv';
    }
    if (fmt === 'html') {
      content = '<!DOCTYPE html><html><body><pre>' + outputText.replace(/</g, '&lt;') + '</pre></body></html>';
      mime = 'text/html';
      ext = 'html';
    }
    const blob = new Blob([content], { type: mime });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'keywords-output.' + ext;
    a.click();
    URL.revokeObjectURL(a.href);
    playPing();
    triggerToast('Downloaded!', 'success');
  });

  document.getElementById('clear-btn')?.addEventListener('click', () => {
    inputEl.value = '';
    resultsArea.classList.add('hidden');
    inputEl.focus();
    playPing();
    triggerToast('Cleared!', 'info');
  });

  document.getElementById('fullscreen-btn')?.addEventListener('click', () => {
    const card =
      document.getElementById('fullscreen-btn').closest('.bg-surface-1.border.border-surface.rounded-2xl') ||
      document.getElementById('fullscreen-btn').closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
      document.getElementById('fullscreen-btn').textContent = '⛶';
    } else {
      card.requestFullscreen?.() || card.webkitRequestFullscreen?.();
      document.getElementById('fullscreen-btn').textContent = '✕';
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const btn = document.getElementById('fullscreen-btn');
    if (btn) btn.textContent = document.fullscreenElement ? '✕' : '⛶';
  });

  const DRAFT_KEY = 'nt_draft_ai-keyword-extractor';
  (function () {
    const input = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
    if (!input) return;
    try {
      const saved = localStorage.getItem(DRAFT_KEY);
      if (saved && !input.value) {
        input.value = saved;
        input.dispatchEvent(new Event('input'));
      }
    } catch (e) {}
    let saveTimer;
    input.addEventListener('input', () => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        try {
          localStorage.setItem(DRAFT_KEY, input.value);
        } catch (e) {}
      }, 500);
    });
  })();

  const updateEditorFontSize = (newSize: number) => {
    const clamped = Math.max(10, Math.min(24, newSize));
    const lineHeight = Math.round(clamped * 1.7);
    document.querySelectorAll('textarea').forEach((t) => {
      t.style.fontSize = clamped + 'px';
      t.style.lineHeight = lineHeight + 'px';
    });
    const lineNums = document.getElementById('line-nums');
    if (lineNums) {
      lineNums.style.fontSize = clamped + 'px';
      lineNums.style.lineHeight = lineHeight + 'px';
    }
    try {
      localStorage.setItem('nt_fs', String(clamped));
    } catch (e) {}
  };

  document.querySelector('.font-inc')?.addEventListener('click', () => {
    const firstArea = document.querySelector('textarea');
    const cur = firstArea ? parseInt(getComputedStyle(firstArea).fontSize) : 14;
    updateEditorFontSize(cur + 2);
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    const firstArea = document.querySelector('textarea');
    const cur = firstArea ? parseInt(getComputedStyle(firstArea).fontSize) : 14;
    updateEditorFontSize(cur - 2);
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) updateEditorFontSize(parseInt(s));
  } catch (e) {}

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b =
        document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])") ||
        document.querySelector("button[class*='bg-']:not([id*='full']):not([id*='paste'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      document.getElementById('clear-btn')?.click();
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });

  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['ai-keyword-extractor']) b.textContent = 'Used ' + u['ai-keyword-extractor'] + '×';
  } catch (e) {}

  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('keywords-list') || document.querySelector("[id$='result']");
    const t = o?.value || o?.textContent || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof triggerToast === 'function') triggerToast('Link copied!');
  });

  const rtInput = document.getElementById('input-text') || document.querySelector('textarea:not([readonly])');
  if (rtInput) {
    rtInput.addEventListener('input', () => {
      const w = rtInput.value ? rtInput.value.trim().split(/\s+/).length : 0;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent =
          Math.max(1, Math.round(w / 200)) + ' min read · ' + Math.max(1, Math.round(w / 150)) + ' min speak';
    });
    rtInput.dispatchEvent(new Event('input'));
  }

  const lnInput = document.getElementById('input-text');
  if (lnInput) {
    const updateLN = () => {
      const n = document.getElementById('line-nums');
      if (n) n.textContent = Array.from({ length: lnInput.value.split('\n').length }, (_, i) => i + 1).join('\n');
    };
    lnInput.addEventListener('input', updateLN);
    lnInput.addEventListener('scroll', () => {
      const n = document.getElementById('line-nums');
      if (n) n.scrollTop = lnInput.scrollTop;
    });
    updateLN();
  }

  const lfInput = document.getElementById('input-text');
  if (lfInput) {
    lfInput.addEventListener('input', () => {
      const t = lfInput.value.toLowerCase().replace(/[^a-z]/g, '');
      if (!t) {
        document.getElementById('letter-freq').classList.add('hidden');
        return;
      }
      const f = {};
      for (const c of t) f[c] = (f[c] || 0) + 1;
      const s = Object.entries(f)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8);
      const m = s[0] ? s[0][1] : 1;
      const el = document.getElementById('letter-freq');
      el.classList.remove('hidden');
      el.innerHTML = s
        .map(
          ([c, n]) =>
            `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-xs font-mono"><strong class="text-purple-400 uppercase">${c}</strong><span class="text-zinc-400">${n}</span></span>`,
        )
        .join('');
    });
  }

  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      const map = { purple: '#a855f7', blue: '#3b82f6', green: '#22c55e', pink: '#ec4899', orange: '#f97316' };
      document.querySelectorAll("button[class*='bg-purple'], button[class*='bg-violet']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(purple|violet)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(purple|violet)-\d+/g, 'hover:bg-' + c + '-500')
          .replace(/from-(purple|violet)-\d+/g, 'from-' + c + '-500')
          .replace(/to-purple-\d+/g, 'to-' + c + '-600');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}
</script>
