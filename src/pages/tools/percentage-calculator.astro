---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";

const faqItems = [
  { question: "How do I calculate X% of Y?", answer: "Use the first calculator mode. Enter the percentage (X) and the total value (Y), and we'll compute X% of Y instantly. For example, 15% of 200 = 30." },
  { question: "How do I calculate percentage change?", answer: "Use the 'Percentage Change' mode. Enter the original value and the new value. We'll calculate the increase or decrease as a percentage. For example, 50 to 75 is a 50% increase." },
  { question: "How do I find what percent X is of Y?", answer: "Use the 'X is what % of Y' mode. Enter X as the part and Y as the whole. The result shows X as a percentage of Y. For example, 30 is 15% of 200." },
  { question: "Is this calculator accurate?", answer: "Yes, all calculations are performed with full JavaScript number precision. Results are rounded to 2 decimal places for readability, but the underlying calculation uses exact values." },
  { question: "Is my data stored anywhere?", answer: "No. All calculations happen locally in your browser. None of your numbers are sent to any server or stored anywhere." },
];

const pctSchema = {
  name: "Percentage Calculator Pro",
  applicationCategory: "Utilities",
  description: "Calculate percentages quickly — find X% of Y, percentage change, what percent X is of Y, and percentage difference.",
  featureList: [
    "Four calculation modes: X% of Y, X is what % of Y, percentage change, percentage difference",
    "Instant results as you type",
    "Copy results to clipboard with one click",
    "100% accurate calculations",
    "Privacy-first — all processing in your browser"
  ],
};
---

<MainLayout
  title="Percentage Calculator - Free Online Percent Calculator"
  description="Calculate percentages: X% of Y, percentage change, what percent X is of Y, and percentage difference. Free online percentage calculator."
  keywords="percentage calculator, percent calculator, percentage change, calculate percentage, percent of, math calculator"
  toolSchema={pctSchema}
  faq={faqItems}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Tools", url: "/tools/" },
    { name: "Percentage Calculator", url: "/tools/percentage-calculator/" },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">

      <ToolHeader
        title="Percentage"
        gradient="Calculator Pro"
        desc="Calculate percentages in four different modes: X% of Y, X is what % of Y, percentage change, and percentage difference."
        badge="✦ New Tool"
        slug="percentage-calculator"
      />

      <ShareBar />

      <div class="max-w-xl mx-auto mt-10">
        <div class="bg-surface-1 border border-surface rounded-2xl p-6">

          <div class="flex gap-2 mb-6 overflow-x-auto" role="tablist" aria-label="Calculation mode">
            <button class="pct-mode px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-purple-600 text-white" data-mode="pct-of" role="tab" aria-selected="true">X% of Y</button>
            <button class="pct-mode px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary" data-mode="x-of-y" role="tab" aria-selected="false">X is what % of Y</button>
            <button class="pct-mode px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary" data-mode="change" role="tab" aria-selected="false">% Change</button>
            <button class="pct-mode px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-surface-2 text-tertiary hover:text-primary" data-mode="diff" role="tab" aria-selected="false">% Difference</button>
          </div>

          <div id="pct-of" class="pct-panel">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-medium text-tertiary mb-1.5">Percentage (%)</label>
                <input id="pct-val" type="number" value="15" class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-purple-500/50 focus:outline-none transition-all" />
              </div>
              <div>
                <label class="block text-xs font-medium text-tertiary mb-1.5">Total Value</label>
                <input id="pct-total" type="number" value="200" class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-purple-500/50 focus:outline-none transition-all" />
              </div>
            </div>
          </div>

          <div id="x-of-y" class="pct-panel hidden">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-medium text-tertiary mb-1.5">X Value</label>
                <input id="xoy-x" type="number" value="30" class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-purple-500/50 focus:outline-none transition-all" />
              </div>
              <div>
                <label class="block text-xs font-medium text-tertiary mb-1.5">Y Value</label>
                <input id="xoy-y" type="number" value="200" class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-purple-500/50 focus:outline-none transition-all" />
              </div>
            </div>
          </div>

          <div id="change" class="pct-panel hidden">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-medium text-tertiary mb-1.5">Original Value</label>
                <input id="chg-orig" type="number" value="50" class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-purple-500/50 focus:outline-none transition-all" />
              </div>
              <div>
                <label class="block text-xs font-medium text-tertiary mb-1.5">New Value</label>
                <input id="chg-new" type="number" value="75" class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-purple-500/50 focus:outline-none transition-all" />
              </div>
            </div>
          </div>

          <div id="diff" class="pct-panel hidden">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-medium text-tertiary mb-1.5">Value A</label>
                <input id="diff-a" type="number" value="100" class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-purple-500/50 focus:outline-none transition-all" />
              </div>
              <div>
                <label class="block text-xs font-medium text-tertiary mb-1.5">Value B</label>
                <input id="diff-b" type="number" value="150" class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-purple-500/50 focus:outline-none transition-all" />
              </div>
            </div>
          </div>

          <div class="mt-6 pt-6 border-t border-surface">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs font-medium text-muted uppercase tracking-wider">Result</span>
                <p id="result-value" class="text-3xl font-black bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent mt-1">15% of 200 = 30</p>
              </div>
              <button id="copy-result" class="bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-[10px] font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all">Copy</button>
            </div>
          </div>
        </div>
      </div>

      <section class="mt-20 max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Learn</span>
          <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">
            Why Use a
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Percentage Calculator?</span>
          </h2>
        </div>
        <div class="space-y-4 text-sm text-tertiary leading-relaxed">
          <p>Percentages are everywhere — discounts, taxes, tips, statistics, grades, and financial calculations. A <strong class="text-primary">percentage calculator</strong> saves time and eliminates mental math errors by computing exact values instantly.</p>
          <p>Whether you're figuring out a sale price, calculating investment returns, or analyzing data, having a reliable percentage calculator with multiple modes (X% of Y, percentage change, difference) ensures you always get accurate results.</p>
        </div>
      </section>

      <RelatedTools current="percentage-calculator" />

      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} />
      </div>
    </div>
  </main>
</MainLayout>

<script>
  const modeBtns = document.querySelectorAll(".pct-mode");
  const panels = {
    "pct-of": document.getElementById("pct-of"),
    "x-of-y": document.getElementById("x-of-y"),
    "change": document.getElementById("change"),
    "diff": document.getElementById("diff"),
  };
  const resultValue = document.getElementById("result-value");
  const copyBtn = document.getElementById("copy-result");

  const inputs = {
    "pct-of": [document.getElementById("pct-val"), document.getElementById("pct-total")],
    "x-of-y": [document.getElementById("xoy-x"), document.getElementById("xoy-y")],
    "change": [document.getElementById("chg-orig"), document.getElementById("chg-new")],
    "diff": [document.getElementById("diff-a"), document.getElementById("diff-b")],
  };

  let activeMode = "pct-of";

  function compute() {
    const [a, b] = inputs[activeMode].map(el => parseFloat(el.value) || 0);
    let label, result;
    switch (activeMode) {
      case "pct-of":
        result = (a / 100) * b;
        label = `${a}% of ${b} = ${result.toFixed(2)}`;
        break;
      case "x-of-y":
        result = b !== 0 ? (a / b) * 100 : 0;
        label = `${a} is ${result.toFixed(2)}% of ${b}`;
        break;
      case "change":
        result = b !== 0 ? ((b - a) / Math.abs(a)) * 100 : 0;
        const sign = result >= 0 ? "+" : "";
        label = `${sign}${result.toFixed(2)}% change (${a} → ${b})`;
        break;
      case "diff":
        const avg = (a + b) / 2;
        result = avg !== 0 ? (Math.abs(b - a) / Math.abs(avg)) * 100 : 0;
        label = `${result.toFixed(2)}% difference between ${a} and ${b}`;
        break;
    }
    resultValue.textContent = label;
  }

  modeBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      modeBtns.forEach(b => {
        b.classList.remove("bg-purple-600", "text-white");
        b.classList.add("bg-surface-2", "text-tertiary", "hover:text-primary");
        b.setAttribute("aria-selected", "false");
      });
      btn.classList.remove("bg-surface-2", "text-tertiary", "hover:text-primary");
      btn.classList.add("bg-purple-600", "text-white");
      btn.setAttribute("aria-selected", "true");
      Object.values(panels).forEach(p => p.classList.add("hidden"));
      const mode = btn.dataset.mode;
      activeMode = mode;
      panels[mode].classList.remove("hidden");
      compute();
    });
  });

  Object.values(inputs).forEach(pair => {
    pair.forEach(el => el.addEventListener("input", compute));
  });

  compute();

  copyBtn.addEventListener("click", async () => {
    await navigator.clipboard.writeText(resultValue.textContent);
    if ((window as any).__showToast) (window as any).__showToast({ message: "Result copied!", variant: "success" });
  });
</script>
