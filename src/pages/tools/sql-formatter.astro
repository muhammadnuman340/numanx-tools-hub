---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolHeader from "../../components/ToolHeader.astro";
import ShareBar from "../../components/ShareBar.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import Accordion from "../../components/ui/Accordion.astro";
import ToolContentSections from "../../components/ToolContentSections.astro";

const faqItems = [
  { question: "What does the SQL formatter do?", answer: "It takes raw SQL queries and formats them with proper indentation, line breaks before major clauses, and optional keyword capitalization for better readability." },
  { question: "Is my SQL sent to a server?", answer: "No. All formatting and minification happens entirely in your browser. Your query never leaves your device." },
  { question: "Can I switch between uppercase and lowercase keywords?", answer: "Yes. Use the toggle button above the output area to switch keywords between UPPERCASE (SELECT, FROM, WHERE) and lowercase (select, from, where)." },
];
const schema = { name: "SQL Formatter", applicationCategory: "Developer Tools", description: "Format and minify SQL queries with keyword capitalization, indentation, and line breaks. Free online SQL formatter.", featureList: ["Format SQL with proper indentation", "Minify SQL to a single line", "Uppercase/lowercase keyword toggle", "One-click copy output", "100% client-side"] };
---
<MainLayout title="SQL Formatter - Format SQL Queries Online Free" description="Format and minify SQL queries with proper indentation, keyword capitalization, and line breaks. Free online SQL formatter for developers." keywords="sql formatter, sql beautifier, sql pretty, format sql, sql tool, developer tools" toolSchema={schema} faq={faqItems}
  howto={{
    name: "How to Use SQL Formatter",
    description: "Step-by-step guide for using SQL Formatter.",
    steps: [],
    totalTime: "PT1M",
  }}
  breadcrumbs={[{name:"Home",url:"/"},{name:"Tools",url:"/tools/"},{name:"SQL Formatter",url:"/tools/sql-formatter/"}]}>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden"><div class="max-w-4xl mx-auto">
    <ToolHeader title="SQL" gradient="Formatter Pro" desc="Format and minify SQL queries with proper indentation, keyword capitalization, and clean layout." badge="✦ New Tool" slug="sql-formatter" />
    <ShareBar />
    <div class="max-w-3xl mx-auto mt-10">
      <div class="bg-surface-1 border border-surface rounded-2xl p-6 relative">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
            <span id="usage-badge" class="text-xs text-muted"></span>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex gap-1">
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="purple" style="background:#a855f7"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="blue" style="background:#3b82f6"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="green" style="background:#22c55e"></button>
              <button class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface" data-color="pink" style="background:#ec4899"></button>
            </div>
            <button id="fullscreen-btn" class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs" title="Fullscreen">⛶</button>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <button id="format-btn" class="bg-violet-600 hover:bg-violet-500 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all active:scale-95">Format</button>
          <button id="minify-btn" class="bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all active:scale-95">Minify</button>
          <button id="copy-btn" class="bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-sm font-medium px-4 py-2.5 rounded-xl transition-all active:scale-95">Copy</button>
          <button id="clear-btn" class="bg-surface-2 hover:bg-surface-3 border border-surface text-muted hover:text-white text-sm font-medium px-4 py-2.5 rounded-xl transition-all active:scale-95">Clear</button>
          <button id="download-btn" class="bg-surface-2 hover:bg-surface-3 border border-surface text-muted hover:text-white text-sm font-medium px-4 py-2.5 rounded-xl transition-all active:scale-95">Download</button>
          <button id="share-btn" class="bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-sm font-medium px-3 py-2.5 rounded-xl transition-all active:scale-95" title="Copy share link">🔗</button>
          <select id="export-format" class="bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5">
            <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option><option value="html">HTML</option>
          </select>
        </div>
        <div class="mt-4">
          <label class="text-[10px] font-semibold text-muted uppercase tracking-wider mb-2 block">Input SQL</label>
          <div class="flex items-center gap-1.5 mb-2">
            <button class="font-dec p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all">A−</button>
            <button class="font-inc p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all">A+</button>
            <span class="text-xs text-muted ml-auto">Ctrl+Enter to process</span>
          </div>
          <div class="flex">
            <div id="line-nums" class="text-xs text-muted text-right pr-2 select-none overflow-hidden font-mono leading-relaxed pt-3" style="min-width:2.5em">1</div>
            <textarea id="sql-input" class="flex-1 h-40 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-violet-500/50 focus:outline-none transition-all resize-none font-mono" placeholder="Paste your SQL query here..." spellcheck="false">SELECT id, name, email FROM users WHERE active = 1 ORDER BY created_at DESC</textarea>
          </div>
          <div id="reading-time" class="text-xs text-muted mt-1"></div>
          <div id="letter-freq" class="mt-2 space-y-0.5 max-h-24 overflow-y-auto hidden"></div>
        </div>
        <div class="mt-4">
          <div class="flex items-center justify-between mb-2">
            <label class="text-[10px] font-semibold text-muted uppercase tracking-wider">Output</label>
            <label class="flex items-center gap-2 text-xs text-muted cursor-pointer">
              <span>UPPERCASE</span>
              <div class="relative inline-block w-9 h-4">
                <input id="case-toggle" type="checkbox" class="sr-only peer" />
                <div class="absolute inset-0 rounded-full bg-surface-3 peer-checked:bg-violet-600 transition-colors"></div>
                <div class="absolute top-0.5 left-0.5 w-3 h-3 rounded-full bg-white peer-checked:translate-x-5 transition-transform"></div>
              </div>
              <span>lowercase</span>
            </label>
          </div>
          <textarea id="sql-output" class="w-full h-40 px-4 py-3 rounded-xl border border-surface-2 bg-black/40 text-white text-sm focus:outline-none transition-all resize-none font-mono" readonly placeholder="Click Format to begin..."></textarea>
        </div>
      </div>
    </div>
    <RelatedTools current="sql-formatter" />
    <div class="mt-20 max-w-3xl mx-auto"><h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">Frequently Asked <span class="bg-gradient-to-r from-violet-400 to-purple-500 bg-clip-text text-transparent">Questions</span></h2><Accordion items={faqItems.map(i => ({title: i.question, content: i.answer}))} /></div>
  </div></main>
</MainLayout>
<script>
  const sqlInput = document.getElementById("sql-input") as HTMLTextAreaElement;
  const sqlOutput = document.getElementById("sql-output") as HTMLTextAreaElement;
  const formatBtn = document.getElementById("format-btn");
  const minifyBtn = document.getElementById("minify-btn");
  const copyBtn = document.getElementById("copy-btn");
  const clearBtn = document.getElementById("clear-btn");
  const caseToggle = document.getElementById("case-toggle") as HTMLInputElement;

  const majorClauses = ["SELECT", "FROM", "WHERE", "AND", "OR", "ORDER BY", "GROUP BY", "HAVING", "LIMIT", "OFFSET", "SET", "VALUES", "INSERT INTO", "UPDATE", "DELETE", "CREATE TABLE", "ALTER TABLE", "DROP TABLE", "JOIN", "LEFT JOIN", "RIGHT JOIN", "INNER JOIN", "OUTER JOIN", "FULL JOIN", "CROSS JOIN", "ON", "UNION", "UNION ALL", "BETWEEN", "IN", "LIKE", "NOT", "EXISTS", "CASE", "WHEN", "THEN", "ELSE", "END", "ASC", "DESC"];
  const clausePriority = ["SELECT", "INSERT INTO", "UPDATE", "DELETE", "CREATE TABLE", "ALTER TABLE", "DROP TABLE", "SET", "VALUES", "FROM", "WHERE", "GROUP BY", "HAVING", "ORDER BY", "LIMIT", "OFFSET", "JOIN", "LEFT JOIN", "RIGHT JOIN", "INNER JOIN", "OUTER JOIN", "FULL JOIN", "CROSS JOIN", "UNION", "UNION ALL"];

  function escapeHtml(s: string): string {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function formatSQL(raw: string): string {
    let s = raw.trim();
    let lower = caseToggle.checked;
    if (!s) return "";
    s = s.replace(/\s+/g, " ").trim();
    clausePriority.forEach(clause => {
      const re = new RegExp("\\b" + clause.replace(/ /g, "\\s+") + "\\b", "gi");
      s = s.replace(re, (match) => {
        const kw = clause;
        return lower ? kw.toLowerCase() : kw;
      });
    });
    clausePriority.forEach(clause => {
      const kw = lower ? clause.toLowerCase() : clause;
      s = s.replace(new RegExp("(?<!\\S)" + kw.replace(/ /g, "\\s+") + "(?!\\S)", "gi"), "\n" + kw);
    });
    s = s.replace(/^[\s\n]+/, "");
    const lines = s.split("\n");
    let indentLevel = 0;
    const result: string[] = [];
    for (let i = 0; i < lines.length; i++) {
      let line = lines[i].trim();
      if (!line) continue;
      const upperLine = line.toUpperCase();
      if (upperLine.startsWith("SELECT") || upperLine.startsWith("INSERT") || upperLine.startsWith("UPDATE") || upperLine.startsWith("DELETE") || upperLine.startsWith("CREATE") || upperLine.startsWith("ALTER") || upperLine.startsWith("DROP")) {
        indentLevel = 0;
      }
      if (upperLine.startsWith(")") && indentLevel > 0) indentLevel--;
      const indent = "  ".repeat(indentLevel);
      result.push(indent + line);
      if (upperLine.startsWith("(") || upperLine.endsWith("(")) indentLevel++;
      if (upperLine.startsWith("SELECT ")) indentLevel = 1;
    }
    return result.join("\n");
  }

  function minifySQL(raw: string): string {
    return raw.trim().replace(/\s+/g, " ").trim();
  }

  function triggerToast(msg: string, variant: "success" | "error" | "warning" = "success") {
    if ((window as any).__showToast) (window as any).__showToast({ message: msg, variant });
  }

  formatBtn.addEventListener("click", () => {
    try {
      const result = formatSQL(sqlInput.value);
      if (!result) { triggerToast("Enter a SQL query first!", "warning"); return; }
      sqlOutput.value = result;
      triggerToast("SQL formatted!", "success");
    } catch { triggerToast("Failed to format SQL", "error"); }
  });

  minifyBtn.addEventListener("click", () => {
    const result = minifySQL(sqlInput.value);
    if (!result) { triggerToast("Enter a SQL query first!", "warning"); return; }
    sqlOutput.value = result;
    triggerToast("SQL minified!", "success");
  });

  function playPing(){try{const a=new(window.AudioContext||window.webkitAudioContext)();const o=a.createOscillator();const g=a.createGain();o.connect(g);g.connect(a.destination);o.frequency.value=800;g.gain.setValueAtTime(0.08,a.currentTime);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+0.12);o.start();o.stop(a.currentTime+0.12);}catch(e){}}
  copyBtn.addEventListener("click", async () => {
    if (!sqlOutput.value) { triggerToast("Nothing to copy!", "warning"); return; }
    await navigator.clipboard.writeText(sqlOutput.value);
    playPing();
    triggerToast("Copied!", "success");
  });

  document.getElementById("download-btn")?.addEventListener("click", () => {
    if (!sqlOutput.value) { triggerToast("Nothing to download!", "warning"); return; }
    const fmt = (document.getElementById("export-format") as HTMLSelectElement)?.value || "txt";
    const mimes = {txt:"text/plain",json:"application/json",csv:"text/csv",html:"text/html"};
    const content = fmt === "json" ? JSON.stringify(sqlOutput.value) : sqlOutput.value;
    const blob = new Blob([content], {type:mimes[fmt]||"text/plain"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "formatted." + fmt;
    a.click();
    playPing();
    URL.revokeObjectURL(a.href);
  });
  clearBtn.addEventListener("click", () => {
    sqlInput.value = "";
    sqlOutput.value = "";
    sqlInput.focus();
    playPing();
  });

  caseToggle.addEventListener("change", () => {
    if (sqlOutput.value) {
      const isLower = caseToggle.checked;
      const text = sqlOutput.value;
      if (isLower) {
        sqlOutput.value = text.replace(/\bSELECT\b|\bFROM\b|\bWHERE\b|\bAND\b|\bOR\b|\bORDER BY\b|\bGROUP BY\b|\bHAVING\b|\bLIMIT\b|\bOFFSET\b|\bSET\b|\bVALUES\b|\bINSERT INTO\b|\bUPDATE\b|\bDELETE\b|\bCREATE TABLE\b|\bALTER TABLE\b|\bDROP TABLE\b|\bJOIN\b|\bLEFT JOIN\b|\bRIGHT JOIN\b|\bINNER JOIN\b|\bFULL JOIN\b|\bON\b|\bUNION\b|\bNOT\b|\bIN\b|\bLIKE\b|\bBETWEEN\b|\bCASE\b|\bWHEN\b|\bTHEN\b|\bELSE\b|\bEND\b|\bASC\b|\bDESC\b/gi, (m) => m.toLowerCase());
      } else {
        sqlOutput.value = text.replace(/\bselect\b|\bfrom\b|\bwhere\b|\band\b|\bor\b|\border by\b|\bgroup by\b|\bhaving\b|\blimit\b|\boffset\b|\bset\b|\bvalues\b|\binsert into\b|\bupdate\b|\bdelete\b|\bcreate table\b|\balter table\b|\bdrop table\b|\bjoin\b|\bleft join\b|\bright join\b|\binner join\b|\bfull join\b|\bon\b|\bunion\b|\bnot\b|\bin\b|\blike\b|\bbetween\b|\bcase\b|\bwhen\b|\bthen\b|\belse\b|\bend\b|\basc\b|\bdesc\b/gi, (m) => m.toUpperCase());
      }
    }
  });
  document.getElementById("share-btn")?.addEventListener("click",()=>{const o=document.getElementById("sql-output");const t=o?.value||"";if(!t)return;const u=window.location.origin+window.location.pathname+"#result="+encodeURIComponent(t.substring(0,200));navigator.clipboard.writeText(u).catch(()=>{});if(typeof (window as any).__showToast==="function")(window as any).__showToast({message:"Link copied!",variant:"success"});});
  document.querySelector(".font-inc")?.addEventListener("click",()=>{document.querySelectorAll("textarea").forEach(t=>{let s=parseInt(getComputedStyle(t).fontSize);t.style.fontSize=Math.min(24,s+2)+"px";})});
  document.querySelector(".font-dec")?.addEventListener("click",()=>{document.querySelectorAll("textarea").forEach(t=>{let s=parseInt(getComputedStyle(t).fontSize);t.style.fontSize=Math.max(10,s-2)+"px";})});
  try{const s=localStorage.getItem("nt_fs");if(s)document.querySelectorAll("textarea").forEach(t=>t.style.fontSize=s+"px")}catch(e){}
  document.addEventListener("keydown",e=>{if(e.ctrlKey&&e.key==="Enter"){e.preventDefault();const b=document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");if(b)b.click();}if(e.ctrlKey&&e.shiftKey&&(e.key==="C"||e.key==="c")){e.preventDefault();document.getElementById("clear-btn")?.click();}if(e.ctrlKey&&(e.key==="D"||e.key==="d")){e.preventDefault();document.getElementById("download-btn")?.click();}});
  try{const u=JSON.parse(localStorage.getItem("nt_tool_usage")||"{}");const b=document.getElementById("usage-badge");if(b&&u["sql"])b.textContent="Used "+u["sql"]+"×"}catch(e){}
  const rt=document.getElementById("sql-input");if(rt){rt.addEventListener("input",()=>{const w=rt.value?rt.value.trim().split(/\s+/).length:0;const e=document.getElementById("reading-time");if(e)e.textContent=Math.max(1,Math.round(w/200))+" min read · "+Math.max(1,Math.round(w/150))+" min speak"});rt.dispatchEvent(new Event("input"));}
  const li=document.getElementById("sql-input");if(li){const ul=()=>{const n=document.getElementById("line-nums");if(n)n.textContent=Array.from({length:li.value.split("\n").length},(_,i)=>i+1).join("\n")};li.addEventListener("input",ul);li.addEventListener("scroll",()=>{const n=document.getElementById("line-nums");if(n)n.scrollTop=li.scrollTop});ul();}
  const lf=document.getElementById("sql-input");if(lf){lf.addEventListener("input",()=>{const t=lf.value.toLowerCase().replace(/[^a-z]/g,"");if(!t){document.getElementById("letter-freq")?.classList.add("hidden");return;}const f={};for(const c of t)f[c]=(f[c]||0)+1;const s=Object.entries(f).sort((a,b)=>b[1]-a[1]).slice(0,8);const m=s[0]?s[0][1]:1;const el=document.getElementById("letter-freq");el.classList.remove("hidden");el.innerHTML=s.map(([c,n])=>`<div class="flex items-center gap-1.5 text-xs"><span class="w-3 text-center font-mono text-white">${c}</span><div class="h-2 rounded-full bg-purple-500/50" style="width:${(n/m)*80+10}%"></div><span class="text-muted">${n}</span></div>`).join("")})}
  document.querySelectorAll(".theme-swatch").forEach(s=>{s.addEventListener("click",()=>{const c=s.dataset.color;document.querySelectorAll("button[class*='bg-violet'],button[class*='bg-purple']").forEach(b=>{b.className=b.className.replace(/bg-(violet|purple)-\d+/g,"bg-"+c+"-600").replace(/hover:bg-(violet|purple)-\d+/g,"hover:bg-"+c+"-500")});try{localStorage.setItem("nt_theme",c)}catch(e){}})});
  try{const c=localStorage.getItem("nt_theme");if(c)document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click()}catch(e){}
</script>
