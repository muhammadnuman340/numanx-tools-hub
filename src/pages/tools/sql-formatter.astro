---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'What does the SQL formatter do?',
    answer:
      'It takes raw SQL queries and formats them with proper indentation, line breaks before major clauses, and optional keyword capitalization for better readability.',
  },
  {
    question: 'Is my SQL sent to a server?',
    answer:
      'No. All formatting and minification happens entirely in your browser. Your query never leaves your device.',
  },
  {
    question: 'Can I switch between uppercase and lowercase keywords?',
    answer:
      'Yes. Use the toggle button above the output area to switch keywords between UPPERCASE (SELECT, FROM, WHERE) and lowercase (select, from, where).',
  },
];
const schema = {
  name: 'SQL Formatter',
  applicationCategory: 'Developer Tools',
  description:
    'Format and minify SQL queries with keyword capitalization, indentation, and line breaks. Free online SQL formatter.',
  featureList: [
    'Format SQL with proper indentation',
    'Minify SQL to a single line',
    'Uppercase/lowercase keyword toggle',
    'One-click copy output',
    '100% client-side',
  ],
};
---

<MainLayout
  title="SQL Formatter & Beautifier — Private & Online | NumanX"
  description="Format and beautify SQL for PostgreSQL, MySQL, BigQuery and SQLite with custom indentation. 100% in-browser."
  keywords="zero upload sql formatter, private sql beautifier, format postgresql mysql, bigquery sql formatter, clean sql online"
  toolSchema={schema}
  faq={faqItems}
  howto={{
    name: 'How to Use SQL Formatter',
    description: 'Step-by-step guide for using SQL Formatter.',
    steps: [],
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'SQL Formatter', url: '/tools/sql-formatter/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="SQL"
        gradient="Formatter Pro"
        desc="Format and minify SQL queries with proper indentation, keyword capitalization, and clean layout."
        badge="✦ New Tool"
        slug="sql-formatter"
      />
      <ShareBar />
      <div class="max-w-3xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6 relative">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
              <span id="usage-badge" class="text-xs text-muted"></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex gap-1">
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="purple"
                  style="background:#a855f7"
                  aria-label="Purple theme accent"
                  title="Purple theme accent"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="blue"
                  style="background:#3b82f6"
                  aria-label="Blue theme accent"
                  title="Blue theme accent"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="green"
                  style="background:#22c55e"
                  aria-label="Green theme accent"
                  title="Green theme accent"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="pink"
                  style="background:#ec4899"
                  aria-label="Pink theme accent"
                  title="Pink theme accent"></button>
              </div>
              <button
                id="fullscreen-btn"
                class="p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-purple-500/40 transition-all text-xs"
                title="Fullscreen"
                aria-label="Fullscreen">⛶</button
              >
            </div>
          </div>
          <div class="flex flex-wrap gap-2">
            <button
              id="format-btn"
              class="bg-violet-600 hover:bg-violet-500 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all active:scale-95"
              >Format</button
            >
            <button
              id="minify-btn"
              class="bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all active:scale-95"
              >Minify</button
            >
            <button
              id="copy-btn"
              class="bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-sm font-medium px-4 py-2.5 rounded-xl transition-all active:scale-95"
              >Copy</button
            >
            <button
              id="clear-btn"
              class="bg-surface-2 hover:bg-surface-3 border border-surface text-muted hover:text-white text-sm font-medium px-4 py-2.5 rounded-xl transition-all active:scale-95"
              >Clear</button
            >
            <button
              id="download-btn"
              class="bg-surface-2 hover:bg-surface-3 border border-surface text-muted hover:text-white text-sm font-medium px-4 py-2.5 rounded-xl transition-all active:scale-95"
              >Download</button
            >
            <button
              id="share-btn"
              class="bg-surface-2 hover:bg-surface-3 border border-surface text-secondary hover:text-white text-sm font-medium px-3 py-2.5 rounded-xl transition-all active:scale-95"
              title="Copy share link"
              aria-label="Share query">🔗</button
            >
            <select
              id="export-format"
              aria-label="Export format"
              title="Export format"
              class="bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5"
            >
              <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option><option
                value="html">HTML</option
              >
            </select>
          </div>
          <div class="mt-4">
            <div class="flex items-center justify-between min-h-[32px] mb-2">
              <label for="sql-input" class="text-xs font-semibold text-zinc-300">Input SQL</label>
              <div class="flex items-center gap-1.5">
                <div class="flex items-center gap-0.5 bg-surface-2 p-0.5 rounded-lg border border-surface">
                  <button
                    type="button"
                    aria-label="Decrease font size"
                    class="font-dec px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                    >A−</button
                  >
                  <button
                    type="button"
                    aria-label="Increase font size"
                    class="font-inc px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                    >A+</button
                  >
                </div>
                <span class="text-xs text-muted ml-2">Ctrl+Enter to process</span>
              </div>
            </div>
            <div class="flex h-[240px] rounded-xl bg-black/40 border border-surface focus-within:border-violet-500 focus-within:ring-1 focus-within:ring-violet-500 transition-all overflow-hidden relative">
              <div
                id="line-nums"
                class="w-12 shrink-0 h-full select-none overflow-hidden font-mono text-sm leading-6 text-right pr-3.5 py-3 text-zinc-500/80 bg-zinc-950/60 border-r border-white/5 whitespace-pre pointer-events-none tabular-nums"
                style="line-height: 24px; font-size: 14px;"
              >
                1
              </div>
              <textarea
                id="sql-input"
                aria-label="SQL query input"
                class="flex-1 min-w-0 h-full bg-transparent text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 px-4 py-3 focus:outline-none font-mono resize-none border-0 overflow-y-auto"
                style="line-height: 24px; font-size: 14px;"
                placeholder="Paste your SQL query here..."
                spellcheck="false">SELECT id, name, email FROM users WHERE active = 1 ORDER BY created_at DESC</textarea
              >
            </div>
            <div id="reading-time" class="text-xs text-muted mt-2"></div>
            <div id="letter-freq" tabindex="0" role="region" aria-label="Character frequency breakdown" class="mt-2 flex flex-wrap gap-1.5 hidden"></div>
          </div>
          <div class="mt-6 pt-6 border-t border-surface">
            <div class="flex items-center justify-between mb-2">
              <label for="sql-output" class="text-xs font-semibold text-zinc-300">Output</label>
              <label class="flex items-center gap-2 text-xs text-muted cursor-pointer">
                <span>UPPERCASE</span>
                <div class="relative inline-block w-9 h-4">
                  <input id="case-toggle" type="checkbox" class="sr-only peer" />
                  <div class="absolute inset-0 rounded-full bg-surface-3 peer-checked:bg-violet-600 transition-colors">
                  </div>
                  <div
                    class="absolute top-0.5 left-0.5 w-3 h-3 rounded-full bg-white peer-checked:translate-x-5 transition-transform"
                  >
                  </div>
                </div>
                <span>lowercase</span>
              </label>
            </div>
            <textarea
              id="sql-output"
              aria-label="Formatted SQL output"
              class="w-full h-[240px] px-4 py-3 rounded-xl border border-surface bg-black/40 text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 focus:outline-none transition-all resize-none font-mono overflow-y-auto"
              style="line-height: 24px; font-size: 14px;"
              readonly
              placeholder="Click Format to begin..."></textarea>
          </div>
        </div>
      </div>
      <RelatedTools current="sql-formatter" />
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span class="bg-gradient-to-r from-violet-400 to-purple-500 bg-clip-text text-transparent"
            >Questions</span
          >
        </h2><Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>
<script>
  const sqlInput = document.getElementById('sql-input') as HTMLTextAreaElement;
  const sqlOutput = document.getElementById('sql-output') as HTMLTextAreaElement;
  const formatBtn = document.getElementById('format-btn');
  const minifyBtn = document.getElementById('minify-btn');
  const copyBtn = document.getElementById('copy-btn');
  const clearBtn = document.getElementById('clear-btn');
  const caseToggle = document.getElementById('case-toggle') as HTMLInputElement;

  const majorClauses = [
    'SELECT',
    'FROM',
    'WHERE',
    'AND',
    'OR',
    'ORDER BY',
    'GROUP BY',
    'HAVING',
    'LIMIT',
    'OFFSET',
    'SET',
    'VALUES',
    'INSERT INTO',
    'UPDATE',
    'DELETE',
    'CREATE TABLE',
    'ALTER TABLE',
    'DROP TABLE',
    'JOIN',
    'LEFT JOIN',
    'RIGHT JOIN',
    'INNER JOIN',
    'OUTER JOIN',
    'FULL JOIN',
    'CROSS JOIN',
    'ON',
    'UNION',
    'UNION ALL',
    'BETWEEN',
    'IN',
    'LIKE',
    'NOT',
    'EXISTS',
    'CASE',
    'WHEN',
    'THEN',
    'ELSE',
    'END',
    'ASC',
    'DESC',
  ];
  const clausePriority = [
    'SELECT',
    'INSERT INTO',
    'UPDATE',
    'DELETE',
    'CREATE TABLE',
    'ALTER TABLE',
    'DROP TABLE',
    'SET',
    'VALUES',
    'FROM',
    'WHERE',
    'GROUP BY',
    'HAVING',
    'ORDER BY',
    'LIMIT',
    'OFFSET',
    'JOIN',
    'LEFT JOIN',
    'RIGHT JOIN',
    'INNER JOIN',
    'OUTER JOIN',
    'FULL JOIN',
    'CROSS JOIN',
    'UNION',
    'UNION ALL',
  ];

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function formatSQL(raw: string): string {
    let s = raw.trim();
    let lower = caseToggle.checked;
    if (!s) return '';
    s = s.replace(/\s+/g, ' ').trim();
    clausePriority.forEach((clause) => {
      const re = new RegExp('\\b' + clause.replace(/ /g, '\\s+') + '\\b', 'gi');
      s = s.replace(re, (match) => {
        const kw = clause;
        return lower ? kw.toLowerCase() : kw;
      });
    });
    clausePriority.forEach((clause) => {
      const kw = lower ? clause.toLowerCase() : clause;
      s = s.replace(new RegExp('(?<!\\S)' + kw.replace(/ /g, '\\s+') + '(?!\\S)', 'gi'), '\n' + kw);
    });
    s = s.replace(/^[\s\n]+/, '');
    const lines = s.split('\n');
    let indentLevel = 0;
    const result: string[] = [];
    for (let i = 0; i < lines.length; i++) {
      let line = lines[i].trim();
      if (!line) continue;
      const upperLine = line.toUpperCase();
      if (
        upperLine.startsWith('SELECT') ||
        upperLine.startsWith('INSERT') ||
        upperLine.startsWith('UPDATE') ||
        upperLine.startsWith('DELETE') ||
        upperLine.startsWith('CREATE') ||
        upperLine.startsWith('ALTER') ||
        upperLine.startsWith('DROP')
      ) {
        indentLevel = 0;
      }
      if (upperLine.startsWith(')') && indentLevel > 0) indentLevel--;
      const indent = '  '.repeat(indentLevel);
      result.push(indent + line);
      if (upperLine.startsWith('(') || upperLine.endsWith('(')) indentLevel++;
      if (upperLine.startsWith('SELECT ')) indentLevel = 1;
    }
    return result.join('\n');
  }

  function minifySQL(raw: string): string {
    return raw.trim().replace(/\s+/g, ' ').trim();
  }

  function triggerToast(msg: string, variant: 'success' | 'error' | 'warning' = 'success') {
    if ((window as any).__showToast) (window as any).__showToast({ message: msg, variant });
  }

  formatBtn.addEventListener('click', () => {
    try {
      const result = formatSQL(sqlInput.value);
      if (!result) {
        triggerToast('Enter a SQL query first!', 'warning');
        return;
      }
      sqlOutput.value = result;
      triggerToast('SQL formatted!', 'success');
    } catch {
      triggerToast('Failed to format SQL', 'error');
    }
  });

  minifyBtn.addEventListener('click', () => {
    const result = minifySQL(sqlInput.value);
    if (!result) {
      triggerToast('Enter a SQL query first!', 'warning');
      return;
    }
    sqlOutput.value = result;
    triggerToast('SQL minified!', 'success');
  });

  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }
  copyBtn.addEventListener('click', async () => {
    if (!sqlOutput.value) {
      triggerToast('Nothing to copy!', 'warning');
      return;
    }
    await navigator.clipboard.writeText(sqlOutput.value);
    playPing();
    triggerToast('Copied!', 'success');
  });

  document.getElementById('download-btn')?.addEventListener('click', () => {
    if (!sqlOutput.value) {
      triggerToast('Nothing to download!', 'warning');
      return;
    }
    const fmt = (document.getElementById('export-format') as HTMLSelectElement)?.value || 'txt';
    const mimes = { txt: 'text/plain', json: 'application/json', csv: 'text/csv', html: 'text/html' };
    const content = fmt === 'json' ? JSON.stringify(sqlOutput.value) : sqlOutput.value;
    const blob = new Blob([content], { type: mimes[fmt] || 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'formatted.' + fmt;
    a.click();
    playPing();
    URL.revokeObjectURL(a.href);
  });
  clearBtn.addEventListener('click', () => {
    sqlInput.value = '';
    sqlOutput.value = '';
    sqlInput.focus();
    playPing();
  });

  caseToggle.addEventListener('change', () => {
    if (sqlOutput.value) {
      const isLower = caseToggle.checked;
      const text = sqlOutput.value;
      if (isLower) {
        sqlOutput.value = text.replace(
          /\bSELECT\b|\bFROM\b|\bWHERE\b|\bAND\b|\bOR\b|\bORDER BY\b|\bGROUP BY\b|\bHAVING\b|\bLIMIT\b|\bOFFSET\b|\bSET\b|\bVALUES\b|\bINSERT INTO\b|\bUPDATE\b|\bDELETE\b|\bCREATE TABLE\b|\bALTER TABLE\b|\bDROP TABLE\b|\bJOIN\b|\bLEFT JOIN\b|\bRIGHT JOIN\b|\bINNER JOIN\b|\bFULL JOIN\b|\bON\b|\bUNION\b|\bNOT\b|\bIN\b|\bLIKE\b|\bBETWEEN\b|\bCASE\b|\bWHEN\b|\bTHEN\b|\bELSE\b|\bEND\b|\bASC\b|\bDESC\b/gi,
          (m) => m.toLowerCase(),
        );
      } else {
        sqlOutput.value = text.replace(
          /\bselect\b|\bfrom\b|\bwhere\b|\band\b|\bor\b|\border by\b|\bgroup by\b|\bhaving\b|\blimit\b|\boffset\b|\bset\b|\bvalues\b|\binsert into\b|\bupdate\b|\bdelete\b|\bcreate table\b|\balter table\b|\bdrop table\b|\bjoin\b|\bleft join\b|\bright join\b|\binner join\b|\bfull join\b|\bon\b|\bunion\b|\bnot\b|\bin\b|\blike\b|\bbetween\b|\bcase\b|\bwhen\b|\bthen\b|\belse\b|\bend\b|\basc\b|\bdesc\b/gi,
          (m) => m.toUpperCase(),
        );
      }
    }
  });
  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('sql-output');
    const t = o?.value || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof (window as any).__showToast === 'function')
      (window as any).__showToast({ message: 'Link copied!', variant: 'success' });
  });
  const updateEditorFontSize = (newSize: number) => {
    const clamped = Math.max(10, Math.min(24, newSize));
    const lineHeight = Math.round(clamped * 1.7);
    document.querySelectorAll('textarea').forEach((t) => {
      t.style.fontSize = clamped + 'px';
      t.style.lineHeight = lineHeight + 'px';
    });
    const lineNums = document.getElementById('line-nums');
    if (lineNums) {
      lineNums.style.fontSize = clamped + 'px';
      lineNums.style.lineHeight = lineHeight + 'px';
    }
    try {
      localStorage.setItem('nt_fs', String(clamped));
    } catch (e) {}
  };

  document.querySelector('.font-inc')?.addEventListener('click', () => {
    const ta = document.getElementById('sql-input');
    const s = parseInt(getComputedStyle(ta as HTMLElement).fontSize) || 14;
    updateEditorFontSize(s + 2);
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    const ta = document.getElementById('sql-input');
    const s = parseInt(getComputedStyle(ta as HTMLElement).fontSize) || 14;
    updateEditorFontSize(s - 2);
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) updateEditorFontSize(parseInt(s));
  } catch (e) {}
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b = document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      document.getElementById('clear-btn')?.click();
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['sql']) b.textContent = 'Used ' + u['sql'] + '×';
  } catch (e) {}
  const rt = document.getElementById('sql-input');
  if (rt) {
    rt.addEventListener('input', () => {
      const w = rt.value ? rt.value.trim().split(/\s+/).length : 0;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent =
          Math.max(1, Math.round(w / 200)) + ' min read · ' + Math.max(1, Math.round(w / 150)) + ' min speak';
    });
    rt.dispatchEvent(new Event('input'));
  }
  const li = document.getElementById('sql-input');
  if (li) {
    const ul = () => {
      const n = document.getElementById('line-nums');
      if (n) n.textContent = Array.from({ length: li.value.split('\n').length }, (_, i) => i + 1).join('\n');
    };
    li.addEventListener('input', ul);
    li.addEventListener('scroll', () => {
      const n = document.getElementById('line-nums');
      if (n) n.scrollTop = li.scrollTop;
    });
    ul();
  }
  const lf = document.getElementById('sql-input');
  if (lf) {
    lf.addEventListener('input', () => {
      const t = lf.value.toLowerCase().replace(/[^a-z]/g, '');
      if (!t) {
        document.getElementById('letter-freq')?.classList.add('hidden');
        return;
      }
      const f = {};
      for (const c of t) f[c] = (f[c] || 0) + 1;
      const s = Object.entries(f)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8);
      const m = s[0] ? s[0][1] : 1;
      const el = document.getElementById('letter-freq');
      el.classList.remove('hidden');
      el.innerHTML = s
        .map(
          ([c, n]) =>
            `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-xs font-mono"><strong class="text-purple-400 uppercase">${c}</strong><span class="text-zinc-400">${n}</span></span>`,
        )
        .join('');
    });
  }
  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      document.querySelectorAll("button[class*='bg-violet'],button[class*='bg-purple']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(violet|purple)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(violet|purple)-\d+/g, 'hover:bg-' + c + '-500');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}
</script>
