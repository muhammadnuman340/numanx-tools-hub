---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'How does the scanner authenticate?',
    answer:
      'This tool uses the Google Service Account configured in the backend environment variables. It can read sheets that have been shared with your service account email.',
  },
  {
    question: 'What kind of secrets does it detect?',
    answer:
      'The scanner currently detects AWS Keys, Google API Keys, Stripe Secrets, RSA Private Keys, and generic token/password patterns.',
  },
  {
    question: 'Is my data stored?',
    answer:
      'No. The spreadsheet data is briefly loaded into memory to perform the regular expression scans, and then immediately discarded. No data is logged or persisted.',
  },
];

const schema = {
  name: 'Google Sheets Secret Scanner',
  applicationCategory: 'Security',
  description: 'Scan your Google Sheets for exposed API keys, passwords, and sensitive tokens.',
  featureList: ['Regex Secret Matching', 'Google Sheets Integration', 'Cloud Service Account Auth'],
};

const benefits = [
  {
    icon: '🛡️',
    title: 'Proactive Security',
    desc: 'Identify exposed API keys and passwords before they are found by malicious actors or automated bots.',
  },
  {
    icon: '⚡',
    title: 'Instant Scanning',
    desc: 'Uses optimized regular expressions to scan thousands of cells in seconds without lagging your browser.',
  },
  {
    icon: '🔒',
    title: 'Privacy Preserving',
    desc: 'Sheet data is processed entirely in memory and immediately discarded. Your data is never logged or stored.',
  },
  {
    icon: '🤖',
    title: 'Wide Detection',
    desc: 'Automatically identifies AWS keys, Google Cloud credentials, Stripe secrets, and generic token patterns.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Share Document',
    desc: 'Ensure the target Google Sheet is shared with the specific Service Account email provided in the tool.',
  },
  {
    num: '2',
    title: 'Find ID',
    desc: 'Locate the long alphanumeric Sheet ID in your spreadsheet URL (between /d/ and /edit).',
  },
  {
    num: '3',
    title: 'Run Scanner',
    desc: 'Paste the ID into the input field and click "Start Scan" to initiate the deep inspection.',
  },
  {
    num: '4',
    title: 'Review Results',
    desc: 'Check the output list. If secrets are found, immediately rotate the compromised keys and delete them from the sheet.',
  },
];

const useCases = [
  {
    icon: '🏢',
    title: 'Corporate Auditing',
    desc: 'Regularly scan shared company spreadsheets to ensure employees haven\'t accidentally pasted production passwords.',
  },
  {
    icon: '💻',
    title: 'Developer Handoff',
    desc: 'Check configuration spreadsheets before sharing them with external contractors or open-sourcing projects.',
  },
  {
    icon: '🚨',
    title: 'Incident Response',
    desc: 'Quickly locate the source of a suspected credentials leak across multiple departmental Google Sheets.',
  },
];
---

<MainLayout
  title="Google Sheets Secret Scanner - Security Tools"
  description="Scan your Google Sheets for exposed API keys, passwords, and sensitive tokens securely."
  keywords="google sheets scanner, secret scanner, api key leak, sheet security"
  toolSchema={schema}
  faq={faqItems}
  howto={{
    name: 'How to use the Secret Scanner',
    description: 'Scan Google Sheets for exposed secrets.',
    steps: [
      {
        name: 'Share your sheet',
        text: 'Ensure your target Google Sheet is shared with the backend Google Service Account email.',
      },
      { name: 'Enter Sheet ID', text: "Locate the long Sheet ID in your spreadsheet's URL and paste it below." },
      { name: 'Scan!', text: 'Click scan to look for potential leaks.' },
    ],
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Sheet Secret Scanner', url: '/tools/sheet-secret-scanner/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="Google Sheets"
        gradient="Secret Scanner"
        desc="Proactively scan your Google Spreadsheets for exposed API keys, passwords, and tokens."
        badge="✦ Security Utility"
        slug="sheet-secret-scanner"
      />
      <ShareBar />

      <div class="max-w-2xl mx-auto mt-10">
        <div class="glass-card rounded-[2rem] p-6 relative">
          <div class="space-y-4">
            <label class="block text-xs font-semibold text-tertiary">Google Sheet ID</label>
            <input
              type="text"
              id="sheet-id-input"
              class="w-full px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-rose-500/50 focus:outline-none transition-all font-mono"
              placeholder="e.g. 1BxiMVs0XRYFgwnmALX..." aria-label="Google Sheet ID"
            />

            <div class="flex justify-between items-center">
              <span class="text-xs text-muted">Make sure to share the sheet with your Service Account.</span>
              <button
                id="scan-btn"
                class="bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm px-6 py-2.5 rounded-xl transition-all duration-200 shadow-lg shadow-purple-900/30"
              >
                Start Scan
              </button>
            </div>
            <p id="error-msg" class="text-xs text-rose-400 hidden mt-2"></p>
          </div>

          <div id="results-container" class="mt-8 pt-8 border-t border-surface hidden">
            <h2 class="text-sm font-bold text-white mb-4">Scan Results</h2>
            <div class="bg-surface-1 border border-surface-2 rounded-xl p-4">
              <p id="scan-summary" class="text-xs text-muted mb-4 font-mono"></p>

              <ul id="secrets-list" class="space-y-2">
                <!-- Results populated here -->
              </ul>
            </div>
          </div>
        </div>
      </div>

      <ToolContentSections
        toolSlug="sheet-secret-scanner"
        toolName="Sheet Secret Scanner"
        category="Security Tools"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />
      <RelatedTools current="sheet-secret-scanner" />

      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span
            class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent font-medium"
            >Questions</span
          >
        </h2>
        <Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>

<script>
  const scanBtn = document.getElementById('scan-btn');
  const idInput = document.getElementById('sheet-id-input') as HTMLInputElement;
  const errorMsg = document.getElementById('error-msg');
  const resultsContainer = document.getElementById('results-container');
  const secretsList = document.getElementById('secrets-list');
  const scanSummary = document.getElementById('scan-summary');

  scanBtn?.addEventListener('click', async () => {
    const sheetId = idInput?.value.trim();
    if (!sheetId) return;

    scanBtn.textContent = 'Scanning...';
    if (errorMsg) errorMsg.classList.add('hidden');
    if (resultsContainer) resultsContainer.classList.add('hidden');

    try {
      const res = await fetch('/api/scan-sheet', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sheetId }),
      });

      const data = await res.json();

      if (!data.success) {
        if (errorMsg) {
          errorMsg.textContent = data.error;
          errorMsg.classList.remove('hidden');
        }
      } else {
        if (resultsContainer && secretsList && scanSummary) {
          resultsContainer.classList.remove('hidden');
          scanSummary.textContent = `Scanned ${data.totalCellsScanned} cells. Found ${data.secretsFound.length} potential secrets.`;

          secretsList.innerHTML = '';
          if (data.secretsFound.length === 0) {
            secretsList.innerHTML = `<li class="text-xs text-emerald-400 font-mono flex items-center gap-2"><span>✓</span> All clear, no secrets detected!</li>`;
          } else {
            data.secretsFound.forEach((s: any) => {
              secretsList.innerHTML += `
                <li class="p-3 bg-[#111113] rounded-lg border border-rose-500/30 flex justify-between items-center group">
                  <div>
                    <span class="text-xs font-bold text-rose-400 uppercase tracking-wider block mb-1">${s.type}</span>
                    <span class="text-[10px] text-muted font-mono block">Row ${s.row}, Col ${s.col}</span>
                  </div>
                  <span class="text-xs text-white bg-surface-2 px-2 py-1 rounded font-mono">${s.preview}</span>
                </li>
              `;
            });
          }
        }
      }
    } catch (err: any) {
      if (errorMsg) {
        errorMsg.textContent = 'A network error occurred.';
        errorMsg.classList.remove('hidden');
      }
    } finally {
      scanBtn.textContent = 'Start Scan';
    }
  });

  // ─── Fullscreen ───
  (function() {
    var fsBtn = document.getElementById('fullscreen-btn');
    if (fsBtn) {
      fsBtn.addEventListener('click', function() {
        var el = document.querySelector('main') || document.documentElement;
        if (!document.fullscreenElement) { el.requestFullscreen && el.requestFullscreen(); }
        else { document.exitFullscreen && document.exitFullscreen(); }
      });
    }
    document.addEventListener('keydown', function(e) {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'f' || e.key === 'F') { if (fsBtn) fsBtn.click(); }
    });
  })();</script>
