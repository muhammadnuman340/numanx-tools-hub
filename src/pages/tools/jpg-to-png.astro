          fill="none"
          stroke="#a855f7"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="shrink-0"
        >
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
