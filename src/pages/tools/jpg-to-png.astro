          >
            <input id="file-input" type="file" accept=".jpg,.jpeg,image/jpeg" multiple class="hidden" />
            <div id="dropzone-content">
              <div
                class="w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-600/20 to-blue-600/20 flex items-center justify-center mx-auto mb-5 group-hover:scale-110 transition-transform duration-300"
              >
