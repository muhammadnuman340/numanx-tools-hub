              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#a855f7"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><polygon
                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
              ></polygon></svg
            >
          </div>
          <h3 class="text-sm font-semibold text-primary">Transparency Support</h3>
          <p class="text-xs text-muted mt-2 leading-relaxed">
            PNG format supports full alpha channel transparency, making it ideal for logos, icons, and overlays placed
            over different backgrounds.
          </p>
        </div>
