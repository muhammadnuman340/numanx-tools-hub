                <span>Download All</span>
              </button>
              <button
                id="copy-btn"
                class="hidden rounded-xl border border-surface-2 px-5 py-3.5 text-sm font-semibold text-secondary hover:text-white hover:border-purple-500/50 hover:bg-purple-600/10 transition-all duration-200 active:scale-[0.98] items-center justify-center gap-2"
