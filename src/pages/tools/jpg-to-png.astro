      <div class="overflow-x-auto rounded-2xl border border-surface bg-surface-1/80 backdrop-blur-md shadow-xl">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-900/90 text-xs font-mono uppercase text-slate-400 border-b border-surface">
