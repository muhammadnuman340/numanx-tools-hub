                <div
                  class="relative flex items-center justify-center gap-2.5 rounded-[11px] bg-gradient-to-r from-purple-600 to-blue-600 px-6 py-3.5 text-white font-semibold transition-all duration-300 hover:from-purple-500 hover:to-blue-500"
