---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import Tabs from '../../components/ui/Tabs.astro';

const faqItems = [
  {
    question: 'How are random numbers generated?',
    answer:
      "Random numbers are generated using the browser's built-in Math.random() function, which uses a pseudo-random number generator. For most everyday purposes like giveaways, games, and sampling, this provides sufficient randomness.",
  },
  {
    question: 'Can I allow duplicate numbers?',
    answer:
      "Yes, the 'Allow duplicates' option lets you control whether the generated numbers can repeat. When duplicates are disallowed, the generator will skip numbers already selected, which may limit results if the range is smaller than the requested count.",
  },
  {
    question: 'What is the maximum range I can set?',
    answer:
      'There is no practical limit on the range. You can set any minimum and maximum values, including negative numbers. However, if you disable duplicates and the range is smaller than the count, the generator will return as many unique numbers as possible.',
  },
  {
    question: 'How do I shuffle a list or pick a random winner?',
    answer:
      "Open the List tab, enter one item per line, then click 'Shuffle' to randomize the whole list or 'Pick Random' to draw winners. Set the pick count to draw more than one.",
  },
  {
    question: 'What is the Fisher-Yates shuffle algorithm?',
    answer:
      'The Fisher-Yates shuffle is a mathematically optimal algorithm for generating a random permutation of a finite sequence. It works by iterating through the array from the last element to the first, swapping each element with a randomly selected earlier element, ensuring every permutation is equally likely.',
  },
  {
    question: 'Can I pick multiple random items at once?',
    answer:
      "Yes, use the 'Pick Random' button with the count input to specify how many random items you want selected from your list. The items are picked without replacement, so each item can only be selected once per pick.",
  },
  {
    question: 'What happens if my list has empty lines?',
    answer:
      'Empty lines are automatically filtered out. Only non-empty lines are considered as list items. This makes it easy to paste multi-line content without worrying about trailing or extra blank lines.',
  },
];
const schema = {
  name: 'Random Number Generator & List Randomizer',
  applicationCategory: 'Utilities',
  description:
    'Generate random numbers within a custom range, or shuffle a list and pick random items with the Fisher-Yates shuffle. Free online random number generator and list randomizer.',
  featureList: [
    'Custom range support',
    'Duplicate control',
    'Multiple number generation with sorting',
    'List shuffle (Fisher-Yates) and random item picker with custom pick count',
    'Copy to clipboard and download as TXT, JSON, CSV or HTML',
  ],
};
const howToSteps = [
  { title: 'Choose Number or List', text: 'Use the Number tab for random numbers or the List tab to shuffle a list.' },
  { title: 'Set Your Options', text: 'Enter min, max and count (and duplicates or sort order), or paste one item per line and set a pick count.' },
  { title: 'Generate, Shuffle or Pick', text: "Click 'Generate', 'Shuffle' or 'Pick Random' to get the result." },
  { title: 'Copy or Download', text: 'Copy the result or download it as a TXT, JSON, CSV or HTML file.' },
];

const inputCls =
  'w-full px-3 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-amber-400/50 focus:outline-none transition-all';
const smallBtn =
  'bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all';
---

<MainLayout
  title="Random Number Generator & List Randomizer — Free | NumanX"
  description="Generate random numbers within a custom range, or shuffle a list and pick random giveaway winners with the Fisher-Yates shuffle. Set min, max, count and duplicates. Free and private."
  keywords="random number generator, random number, number generator, rng, list randomizer, random list shuffler, giveaway winner picker, random item picker, fisher yates shuffle, random name picker"
  toolSchema={schema}
  faq={faqItems}
  howto={{
    name: 'How to Generate Random Numbers or Shuffle a List',
    description: 'Generate random numbers or shuffle a list and pick random items in 4 steps.',
    steps: howToSteps,
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Random Number Generator & List Randomizer', url: '/tools/random-number-generator/' },
  ]}
>
  <main class="min-h-screen pt-6 sm:pt-8 pb-20 px-4 sm:px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="Random Number Generator"
        gradient="& List Randomizer"
        desc="Generate random numbers within a custom range — set min, max, count, duplicates and sort order. Or switch to the List tab to shuffle a list or pick random winners with the Fisher-Yates shuffle."
        updated="2026-11-02"
        badge="✦ New Tool"
        slug="random-number-generator"
      />
      <div class="max-w-xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6 relative">
          <button
            id="fullscreen-btn"
            class="absolute top-3 right-3 p-1.5 rounded-lg bg-surface-2 border border-surface text-tertiary hover:text-white hover:border-amber-500/40 transition-all text-xs"
            title="Fullscreen">⛶</button
          >
          <div class="flex items-center gap-2 mb-3 min-h-[20px]">
            <span id="usage-badge" class="text-xs text-muted"></span>
          </div>

          <Tabs
            class="mb-5"
            tabs={[
              { id: 'number', label: 'Number' },
              { id: 'list', label: 'List' },
            ]}
            activeTab="number"
          />

          <!-- ─── Number tab ─── -->
          <div id="tabpanel-number" role="tabpanel" aria-labelledby="tab-number">
            <div class="grid grid-cols-3 gap-3 mb-4">
              <div>
                <label for="min-input" class="block text-xs font-medium text-tertiary mb-1.5">Min</label><input
                  id="min-input"
                  type="number"
                  value="1"
                  class={inputCls}
                />
              </div>
              <div>
                <label for="max-input" class="block text-xs font-medium text-tertiary mb-1.5">Max</label><input
                  id="max-input"
                  type="number"
                  value="100"
                  class={inputCls}
                />
              </div>
              <div>
                <label for="count-input" class="block text-xs font-medium text-tertiary mb-1.5">Count</label><input
                  id="count-input"
                  type="number"
                  min="1"
                  value="1"
                  class={inputCls}
                />
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3 mb-4">
              <label class="flex items-center gap-2 cursor-pointer"
                ><input id="allow-dups" type="checkbox" checked class="accent-amber-500" /><span
                  class="text-xs text-tertiary">Allow duplicates</span
                ></label
              >
              <div class="flex items-center gap-2 ml-auto">
                <span class="text-xs text-tertiary font-medium">Sort:</span>
                <select
                  id="sort-order"
                  class="bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5 focus:outline-none"
                  aria-label="Sort order"
                >
                  <option value="none">None</option>
                  <option value="asc">Ascending</option>
                  <option value="desc">Descending</option>
                </select>
              </div>
            </div>
            <button
              id="generate-btn"
              class="w-full text-accent-fg font-bold text-sm px-6 py-3 rounded-xl hover:opacity-90 transition-all bg-amber-400"
              >Generate</button
            >
            <div id="results-area" class="mt-6 pt-6 border-t border-surface hidden">
              <div class="flex items-center justify-between mb-3 gap-2 flex-wrap">
                <span class="text-xs font-medium text-tertiary">Results</span>
                <div class="flex items-center gap-1.5 flex-wrap">
                  <select
                    id="export-format"
                    aria-label="Export file format"
                    class="bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5 focus:outline-none"
                  >
                    <option value="txt">TXT</option>
                    <option value="json">JSON</option>
                    <option value="csv">CSV</option>
                  </select>
                  <button id="share-btn" class={smallBtn} title="Share">🔗</button>
                  <button id="download-btn" class={smallBtn}>Download</button>
                  <button id="clear-btn" class={smallBtn}>Clear</button>
                  <button id="copy-btn" class={smallBtn}>Copy</button>
                </div>
              </div>
              <div id="results-list" class="flex flex-wrap gap-2"></div>
            </div>
          </div>

          <!-- ─── List tab ─── -->
          <div id="tabpanel-list" role="tabpanel" aria-labelledby="tab-list" class="hidden">
            <div class="flex items-center justify-between min-h-[32px] mb-2">
              <label for="list-input" class="text-xs font-semibold text-zinc-300">Enter List (one item per line)</label>
              <div class="flex items-center gap-0.5 bg-surface-2 p-0.5 rounded-lg border border-surface">
                <button
                  type="button"
                  aria-label="Decrease font size"
                  class="list-font-dec px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                  >A−</button
                >
                <button
                  type="button"
                  aria-label="Increase font size"
                  class="list-font-inc px-2 py-0.5 rounded text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
                  >A+</button
                >
              </div>
            </div>
            <div
              class="flex h-[220px] rounded-xl bg-black/40 border border-surface focus-within:border-amber-500 focus-within:ring-1 focus-within:ring-amber-500 transition-all overflow-hidden relative"
            >
              <div
                id="list-line-nums"
                class="w-12 shrink-0 h-full select-none overflow-hidden font-mono text-sm leading-6 text-right pr-3.5 py-3 text-zinc-500/80 bg-zinc-950/60 border-r border-white/5 whitespace-pre pointer-events-none tabular-nums"
                style="line-height: 24px; font-size: 14px;"
              >
                1
              </div>
              <textarea
                id="list-input"
                class="flex-1 min-w-0 h-full bg-transparent text-zinc-100 placeholder:text-zinc-500 text-sm leading-6 px-4 py-3 focus:outline-none font-mono resize-none border-0 overflow-y-auto"
                style="line-height: 24px; font-size: 14px;"
                placeholder="Item 1
Item 2
Item 3"></textarea>
            </div>
            <div class="flex items-center justify-between mt-2 text-xs text-muted">
              <span id="list-item-count">0 items</span>
              <span id="list-reading-time"></span>
            </div>
            <div class="flex items-center gap-2 mt-3 mb-4">
              <label for="pick-count" class="text-xs text-tertiary">Pick count:</label>
              <input
                id="pick-count"
                type="number"
                min="1"
                value="1"
                class="w-16 px-2 py-1.5 rounded-lg border border-surface-2 bg-surface-1 text-white text-sm focus:border-amber-400/50 focus:outline-none transition-all"
              />
            </div>
            <p id="list-empty-msg" class="hidden text-xs font-medium text-danger mb-3" role="alert">
              Add at least one item (one per line) first.
            </p>
            <div class="flex flex-wrap gap-2">
              <button
                id="list-shuffle-btn"
                type="button"
                class="text-accent-fg font-bold text-xs px-4 py-2 rounded-xl hover:opacity-90 transition-all bg-amber-400"
                >Shuffle</button
              >
              <button id="list-pick-btn" type="button" class={`${smallBtn} px-4 py-2 rounded-xl`}>Pick Random</button>
              <button id="list-copy-btn" type="button" class={`${smallBtn} px-4 py-2 rounded-xl`}>Copy</button>
              <button id="list-download-btn" type="button" class={`${smallBtn} px-4 py-2 rounded-xl`}>Download</button>
              <select
                id="list-export-format"
                aria-label="List export file format"
                class="bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5"
              >
                <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option><option
                  value="html">HTML</option
                >
              </select>
              <button id="list-clear-btn" type="button" class={`${smallBtn} px-4 py-2 rounded-xl`}>Clear</button>
            </div>
            <div id="list-results-area" class="mt-6 pt-6 border-t border-surface hidden">
              <span class="text-xs font-medium text-tertiary mb-3 block">Results</span>
              <ol id="list-results" class="space-y-1.5 list-decimal list-inside"></ol>
              <div
                id="list-letter-freq"
                tabindex="0"
                role="region"
                aria-label="Character frequency breakdown"
                class="mt-2 flex flex-wrap gap-1.5 hidden"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
      <section class="mt-20 max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider">Learn</span><h2
            class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1"
          >
            Random Number <span class="text-amber-400"
              >Generation</span
            >
          </h2>
        </div><div class="space-y-4 text-sm text-tertiary leading-relaxed">
          <p>
            Random number generation is a fundamental tool used in countless applications, from selecting lottery
            numbers and drawing contest winners to statistical sampling and game development. With a customizable range
            and duplicate control, you can adapt the output to virtually any use case requiring unbiased, unpredictable
            numbers.
          </p>
          <p>
            List randomization is essential for drawing winners, creating random groups, ordering items unbiasedly, and
            conducting fair selections. The Fisher-Yates shuffle used in the List tab ensures that every possible
            permutation of your list is equally likely. Whether you need a completely shuffled list or just a few random
            picks, the List tab does both.
          </p>
        </div>
      </section>
      <RelatedTools current="random-number-generator" />
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span class="text-amber-400"
            >Questions</span
          >
        </h2><Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>
<script>
  const minInput = document.getElementById('min-input');
  const maxInput = document.getElementById('max-input');
  const countInput = document.getElementById('count-input');
  const allowDups = document.getElementById('allow-dups');
  const generateBtn = document.getElementById('generate-btn');
  const resultsArea = document.getElementById('results-area');
  const resultsList = document.getElementById('results-list');
  const copyBtn = document.getElementById('copy-btn');

  generateBtn.addEventListener('click', () => {
    const min = parseInt(minInput.value) || 0;
    const max = parseInt(maxInput.value) || 100;
    const count = parseInt(countInput.value) || 1;
    const allowDuplicates = allowDups.checked;

    resultsList.innerHTML = '';
    resultsArea.classList.remove('hidden');

    const pool = [];
    const used = new Set();

    for (let i = 0; i < count; i++) {
      let attempts = 0;
      let num;
      do {
        num = Math.floor(Math.random() * (max - min + 1)) + min;
        attempts++;
        if (attempts > 10000) break;
      } while (!allowDuplicates && used.has(num));
      used.add(num);
      pool.push(num);
    }

    const sortVal = (document.getElementById('sort-order') as HTMLSelectElement).value;
    if (sortVal === 'asc') pool.sort((a, b) => a - b);
    if (sortVal === 'desc') pool.sort((a, b) => b - a);

    pool.forEach((num) => {
      const span = document.createElement('span');
      span.className = 'px-3 py-2 rounded-lg bg-surface-2 border border-surface-3 text-white text-sm font-mono';
      span.textContent = String(num);
      resultsList.appendChild(span);
    });
  });

  copyBtn.addEventListener('click', async () => {
    const nums = [...resultsList.querySelectorAll('span')].map((s) => s.textContent).join(', ');
    if (!nums) return;
    await navigator.clipboard.writeText(nums);
    if ((window as any).__showToast) (window as any).__showToast({ message: 'Copied!', variant: 'success' });
  });

  // ─── Download ───
  document.getElementById('download-btn')?.addEventListener('click', () => {
    const numsArray = [...resultsList.querySelectorAll('span')].map((s) => s.textContent);
    if (!numsArray.length) return;

    const fmt = (document.getElementById('export-format') as HTMLSelectElement).value;
    let content = '';
    let mime = '';
    let ext = '';

    if (fmt === 'json') {
      content = JSON.stringify(numsArray, null, 2);
      mime = 'application/json';
      ext = 'json';
    } else if (fmt === 'csv') {
      content = 'Number\n' + numsArray.join('\n');
      mime = 'text/csv';
      ext = 'csv';
    } else {
      content = numsArray.join('\n');
      mime = 'text/plain';
      ext = 'txt';
    }

    const blob = new Blob([content], { type: mime });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `random-numbers.${ext}`;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // ─── Clear ───
  document.getElementById('clear-btn')?.addEventListener('click', () => {
    minInput.value = '1';
    maxInput.value = '100';
    countInput.value = '1';
    resultsList.innerHTML = '';
    resultsArea.classList.add('hidden');
  });

  // ─── Fullscreen ───
  document.getElementById('fullscreen-btn')?.addEventListener('click', () => {
    const card = document.getElementById('fullscreen-btn').closest("[class*='bg-surface-1']");
    if (!card) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
      document.getElementById('fullscreen-btn').textContent = '⛶';
    } else {
      card.requestFullscreen?.() || card.webkitRequestFullscreen?.();
      document.getElementById('fullscreen-btn').textContent = '✕';
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const btn = document.getElementById('fullscreen-btn');
    if (btn) btn.textContent = document.fullscreenElement ? '✕' : '⛶';
  });

  // ─── Usage badge ───
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['random-number-generator']) b.textContent = 'Used ' + u['random-number-generator'] + '×';
  } catch (e) {}

  // ─── Share button ───
  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('output-text') || document.querySelector("[id$='result']");
    const t = o?.value || o?.textContent || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof showToast === 'function') showToast('Link copied!');
  });
</script>

<script>
  // ─── List tab (from the retired List Randomizer) and tab switching ───
  const listInput = document.getElementById('list-input') as HTMLTextAreaElement;
  const pickCount = document.getElementById('pick-count') as HTMLInputElement;
  const listResultsArea = document.getElementById('list-results-area');
  const listResults = document.getElementById('list-results');
  const listEmptyMsg = document.getElementById('list-empty-msg');
  const listItemCount = document.getElementById('list-item-count');

  function toast(message: string, variant: 'success' | 'error' | 'info' | 'warning' = 'success') {
    (window as any).__showToast?.({ message, variant });
  }

  // Short confirmation sound on copy (as on the old List Randomizer)
  function playPing() {
    try {
      const Ctx = window.AudioContext || (window as any).webkitAudioContext;
      const a = new Ctx();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch {}
  }

  function getItems(): string[] {
    return listInput.value.split('\n').filter((line) => line.trim() !== '');
  }

  // Fisher-Yates shuffle
  function shuffle<T>(array: T[]): T[] {
    const arr = [...array];
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function display(items: string[]) {
    if (!listResults || !listResultsArea) return;
    listResults.innerHTML = '';
    items.forEach((item) => {
      const li = document.createElement('li');
      li.className = 'text-sm text-white font-mono bg-surface-2 border border-surface-3 rounded-lg px-3 py-2';
      li.textContent = item;
      listResults.appendChild(li);
    });
    listResultsArea.classList.remove('hidden');
  }

  // Empty list: show why nothing happened instead of failing silently
  function itemsOrWarn(): string[] | null {
    const items = getItems();
    listEmptyMsg?.classList.toggle('hidden', items.length > 0);
    if (items.length === 0) {
      listInput.focus();
      return null;
    }
    return items;
  }

  function resultItems(): string[] {
    return [...(listResults?.querySelectorAll('li') || [])].map((li) => li.textContent || '');
  }

  document.getElementById('list-shuffle-btn')?.addEventListener('click', () => {
    const items = itemsOrWarn();
    if (items) display(shuffle(items));
  });

  document.getElementById('list-pick-btn')?.addEventListener('click', () => {
    const items = itemsOrWarn();
    if (!items) return;
    const count = Math.min(parseInt(pickCount.value) || 1, items.length);
    display(shuffle(items).slice(0, count));
  });

  document.getElementById('list-clear-btn')?.addEventListener('click', () => {
    listInput.value = '';
    listInput.dispatchEvent(new Event('input'));
    if (listResults) listResults.innerHTML = '';
    listResultsArea?.classList.add('hidden');
    listEmptyMsg?.classList.add('hidden');
  });

  document.getElementById('list-copy-btn')?.addEventListener('click', () => {
    const items = resultItems();
    if (items.length === 0) return;
    playPing();
    navigator.clipboard
      .writeText(items.join('\n'))
      .then(() => toast('Copied!'))
      .catch(() => toast('Could not copy. Select the results and copy them by hand.', 'error'));
    const btn = document.getElementById('list-copy-btn');
    if (btn) {
      btn.textContent = 'Copied!';
      setTimeout(() => (btn.textContent = 'Copy'), 2000);
    }
  });

  document.getElementById('list-download-btn')?.addEventListener('click', () => {
    const items = resultItems();
    if (items.length === 0) return;
    const fmt = (document.getElementById('list-export-format') as HTMLSelectElement)?.value || 'txt';
    let content: string, filename: string, mime: string;
    switch (fmt) {
      case 'json':
        content = JSON.stringify(items, null, 2);
        filename = 'randomized-list.json';
        mime = 'application/json';
        break;
      case 'csv':
        content = 'Item\n' + items.map((i) => `"${i.replace(/"/g, '""')}"`).join('\n');
        filename = 'randomized-list.csv';
        mime = 'text/csv';
        break;
      case 'html':
        content =
          '<ol>' +
          items
            .map((i) => `<li>${i.replace(/[<>&]/g, (c) => (c === '<' ? '&lt;' : c === '>' ? '&gt;' : '&amp;'))}</li>`)
            .join('') +
          '</ol>';
        filename = 'randomized-list.html';
        mime = 'text/html';
        break;
      default:
        content = items.join('\n');
        filename = 'randomized-list.txt';
        mime = 'text/plain';
    }
    const blob = new Blob([content], { type: mime });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = filename;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // Draft auto-save (same key as the old List Randomizer, so saved lists carry over)
  const DRAFT_KEY = 'nt_draft_list-randomizer';
  try {
    const saved = localStorage.getItem(DRAFT_KEY);
    if (saved && !listInput.value) listInput.value = saved;
  } catch {}
  let saveTimer: ReturnType<typeof setTimeout> | undefined;

  // Line numbers, item count, reading time and letter frequency
  const lineNums = document.getElementById('list-line-nums');
  const readingTime = document.getElementById('list-reading-time');
  const letterFreq = document.getElementById('list-letter-freq');

  function onListInput() {
    if (lineNums) lineNums.textContent = Array.from({ length: listInput.value.split('\n').length }, (_, i) => i + 1).join('\n');
    const n = getItems().length;
    if (listItemCount) listItemCount.textContent = `${n} item${n === 1 ? '' : 's'}`;
    if (n > 0) listEmptyMsg?.classList.add('hidden');
    const w = listInput.value.trim() ? listInput.value.trim().split(/\s+/).length : 0;
    if (readingTime) readingTime.textContent = `${Math.max(1, Math.round(w / 200))}m read · ${Math.max(1, Math.round(w / 150))}m speak`;

    const t = listInput.value.toLowerCase().replace(/[^a-z]/g, '');
    if (letterFreq) {
      letterFreq.classList.toggle('hidden', !t);
      const f: Record<string, number> = {};
      for (const c of t) f[c] = (f[c] || 0) + 1;
      letterFreq.innerHTML = Object.entries(f)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8)
        .map(
          ([c, count]) =>
            `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-xs font-mono"><strong class="text-amber-400 uppercase">${c}</strong><span class="text-zinc-400">${count}</span></span>`,
        )
        .join('');
    }

    clearTimeout(saveTimer);
    saveTimer = setTimeout(() => {
      try {
        localStorage.setItem(DRAFT_KEY, listInput.value);
      } catch {}
    }, 500);
  }
  listInput.addEventListener('input', onListInput);
  listInput.addEventListener('scroll', () => {
    if (lineNums) lineNums.scrollTop = listInput.scrollTop;
  });
  onListInput();

  // Font size (shared nt_fs setting, as on the old page)
  const setListFontSize = (newSize: number) => {
    const clamped = Math.max(10, Math.min(24, newSize));
    const lineHeight = Math.round(clamped * 1.7) + 'px';
    listInput.style.fontSize = clamped + 'px';
    listInput.style.lineHeight = lineHeight;
    if (lineNums) {
      lineNums.style.fontSize = clamped + 'px';
      lineNums.style.lineHeight = lineHeight;
    }
    try {
      localStorage.setItem('nt_fs', String(clamped));
    } catch {}
  };
  const currentFont = () => parseInt(getComputedStyle(listInput).fontSize) || 14;
  document.querySelector('.list-font-inc')?.addEventListener('click', () => setListFontSize(currentFont() + 2));
  document.querySelector('.list-font-dec')?.addEventListener('click', () => setListFontSize(currentFont() - 2));
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) setListFontSize(parseInt(s));
  } catch {}

  // ─── Tabs (also opens a tab from ?tab=number|list) ───
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"][data-tab-id]'));
  let activeTab = 'number';

  function selectTab(id: string, focus = false) {
    activeTab = id;
    tabs.forEach((tab) => {
      const on = tab.dataset.tabId === id;
      tab.setAttribute('aria-selected', String(on));
      tab.tabIndex = on ? 0 : -1;
      tab.type = 'button';
      document.getElementById(`tabpanel-${tab.dataset.tabId}`)?.classList.toggle('hidden', !on);
      if (on && focus) tab.focus();
    });
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => selectTab(tab.dataset.tabId || 'number'));
    tab.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      selectTab(next.dataset.tabId || 'number', true);
    });
  });
  selectTab(new URLSearchParams(window.location.search).get('tab') === 'list' ? 'list' : 'number');

  // ─── Keyboard shortcuts act on the open tab ───
  const ACTIONS: Record<string, { run: string; clear: string; download: string }> = {
    number: { run: 'generate-btn', clear: 'clear-btn', download: 'download-btn' },
    list: { run: 'list-shuffle-btn', clear: 'list-clear-btn', download: 'list-download-btn' },
  };
  document.addEventListener('keydown', (e) => {
    if (!e.ctrlKey) return;
    const ids = ACTIONS[activeTab];
    let id = '';
    if (e.key === 'Enter') id = ids.run;
    else if (e.shiftKey && (e.key === 'C' || e.key === 'c')) id = ids.clear;
    else if (!e.shiftKey && (e.key === 'D' || e.key === 'd')) id = ids.download;
    if (!id) return;
    e.preventDefault();
    document.getElementById(id)?.click();
  });
</script>
