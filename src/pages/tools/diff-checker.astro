---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ShareBar from '../../components/ShareBar.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ToolContentSections from '../../components/ToolContentSections.astro';

const faqItems = [
  {
    question: 'How does the diff checker work?',
    answer:
      'It compares two texts line by line. Lines present in one version but not the other are highlighted — added lines in green, removed lines in red, and unchanged lines in neutral.',
  },
  {
    question: 'Is my text sent to a server?',
    answer: 'No. All comparison happens entirely in your browser. Your text never leaves your device.',
  },
  {
    question: 'Can I compare large files?',
    answer:
      'The tool works well with most text sizes, but for very large files (thousands of lines) performance may vary since all processing is done client-side.',
  },
];
const schema = {
  name: 'Diff Checker',
  applicationCategory: 'Developer Tools',
  description: 'Compare two texts side-by-side and see added, removed, and unchanged lines highlighted instantly.',
  featureList: [
    'Side-by-side comparison',
    'Line-by-line diff highlighting',
    'Added (green) / removed (red) markers',
    '100% client-side',
  ],
};

const benefits = [
  {
    icon: '🔍',
    title: 'Precise Tracking',
    desc: 'Accurately identify added, removed, and modified lines between two versions of text.',
  },
  {
    icon: '⚡',
    title: 'Instant Comparison',
    desc: 'View differences in real-time as you paste your content, with no loading delays.',
  },
  {
    icon: '🎨',
    title: 'Clear Highlighting',
    desc: 'Easily spot changes with intuitive color-coded highlights (green for added, red for removed).',
  },
  {
    icon: '🔒',
    title: '100% Private',
    desc: 'All comparisons are processed locally in your browser. Your text is never stored or transmitted.',
  },
];

const howToSteps = [
  {
    num: '1',
    title: 'Input Original Text',
    desc: 'Paste the older or original version of your text into the left input panel.',
  },
  {
    num: '2',
    title: 'Input New Text',
    desc: 'Paste the modified or newer version of your text into the right input panel.',
  },
  {
    num: '3',
    title: 'Compare',
    desc: 'Click the Compare button to instantly generate a side-by-side diff view.',
  },
  {
    num: '4',
    title: 'Review Differences',
    desc: 'Scroll through the results below to see additions (green) and deletions (red).',
  },
];

const useCases = [
  {
    icon: '👨‍💻',
    title: 'Code Review',
    desc: 'Quickly compare two versions of a source code file before committing changes to a repository.',
  },
  {
    icon: '📝',
    title: 'Content Editing',
    desc: 'Review edits made by a colleague to an article, essay, or blog post to see exactly what changed.',
  },
  {
    icon: '⚙️',
    title: 'Config Management',
    desc: 'Compare configuration files (JSON, YAML) to identify small but critical changes.',
  },
];
---

<MainLayout
  title="Free Text Diff Checker Online — Compare Text & Code Differences Side-by-Side | NumanX Tools"
  description="Compare two texts side-by-side and see added, removed, and unchanged lines highlighted instantly. Free online text and code diff checker."
  keywords="diff checker, text comparison, compare text online, side by side diff, code difference tool"
  toolSchema={schema}
  faq={faqItems}
  howto={{
    name: 'How to Use Diff Checker',
    description: 'Step-by-step guide for using Diff Checker.',
    steps: [],
    totalTime: 'PT1M',
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Diff Checker', url: '/tools/diff-checker/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <ToolHeader
        title="Diff"
        gradient="Checker Pro"
        desc="Compare two texts side-by-side and instantly see added, removed, and unchanged lines highlighted."
        badge="✦ New Tool"
        slug="diff-checker"
      />
      <ShareBar />
      <div class="max-w-4xl mx-auto mt-10">
        <div class="glass-card rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Tool</span>
              <span id="usage-badge" class="text-xs text-muted"></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex gap-1">
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="purple"
                  style="background:#a855f7"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="blue"
                  style="background:#3b82f6"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="green"
                  style="background:#22c55e"></button>
                <button
                  class="theme-swatch w-3.5 h-3.5 rounded-full border border-surface"
                  data-color="pink"
                  style="background:#ec4899"></button>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-1.5 mb-2">
            <button
              class="font-dec p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all"
              >A−</button
            >
            <button
              class="font-inc p-1 px-1.5 rounded bg-surface-2 border border-surface text-xs text-tertiary hover:text-white hover:border-purple-500/40 transition-all"
              >A+</button
            >
            <span class="text-xs text-muted ml-auto">Ctrl+Enter to compare</span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="text-[10px] font-semibold text-muted uppercase tracking-wider mb-2 block"
                >Original Text</label
              >
              <div class="flex">
                <div
                  id="line-nums-left"
                  class="text-xs text-muted text-right pr-2 select-none overflow-hidden font-mono leading-relaxed pt-3"
                  style="min-width:2.5em"
                >
                  1
                </div>
                <textarea
                  id="text-left"
                  class="flex-1 h-48 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-green-500/50 focus:outline-none transition-all resize-none font-mono"
                  placeholder="Paste original text here..."></textarea>
              </div>
            </div>
            <div>
              <label class="text-[10px] font-semibold text-muted uppercase tracking-wider mb-2 block">New Text</label>
              <div class="flex">
                <div
                  id="line-nums-right"
                  class="text-xs text-muted text-right pr-2 select-none overflow-hidden font-mono leading-relaxed pt-3"
                  style="min-width:2.5em"
                >
                  1
                </div>
                <textarea
                  id="text-right"
                  class="flex-1 h-48 px-4 py-3 rounded-xl border border-surface-2 bg-surface-1 text-white text-sm focus:border-green-500/50 focus:outline-none transition-all resize-none font-mono"
                  placeholder="Paste new text here..."></textarea>
              </div>
            </div>
          </div>
          <div id="reading-time" class="text-xs text-muted mt-1"></div>
          <div id="letter-freq" class="mt-2 space-y-0.5 max-h-24 overflow-y-auto hidden"></div>
          <div class="flex justify-center mt-4">
            <button
              id="compare-btn"
              class="bg-green-600 hover:bg-green-500 text-white text-sm font-semibold px-8 py-2.5 rounded-xl transition-all active:scale-95"
              >Compare</button
            >
          </div>
          <div id="diff-result" class="mt-6 hidden">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="text-[10px] font-semibold text-muted uppercase tracking-wider mb-2 block">Original</label>
                <pre
                  id="diff-left"
                  class="w-full h-64 overflow-y-auto bg-black/40 border border-surface rounded-xl px-4 py-3 text-sm font-mono text-primary whitespace-pre-wrap">
                </pre>
              </div>
              <div>
                <label class="text-[10px] font-semibold text-muted uppercase tracking-wider mb-2 block">New</label>
                <pre
                  id="diff-right"
                  class="w-full h-64 overflow-y-auto bg-black/40 border border-surface rounded-xl px-4 py-3 text-sm font-mono text-primary whitespace-pre-wrap">
                </pre>
              </div>
            </div>
            <div class="flex items-center gap-3 mt-3 text-xs">
              <span class="flex items-center gap-1"
                ><span class="inline-block w-3 h-3 rounded bg-green-600/30 border border-green-600/50"></span> Added</span
              >
              <span class="flex items-center gap-1"
                ><span class="inline-block w-3 h-3 rounded bg-red-600/30 border border-red-600/50"></span> Removed</span
              >
              <span class="flex items-center gap-1"
                ><span class="inline-block w-3 h-3 rounded bg-surface-1 border border-surface-3"></span> Unchanged</span
              >
            </div>
            <div class="flex gap-2 mt-3">
              <button
                id="copy-btn"
                class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
                >Copy Diff</button
              >
              <button
                id="share-btn"
                class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
                title="Copy share link">🔗</button
              >
              <button
                id="download-btn"
                class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
                >Download</button
              >
              <button
                id="clear-btn"
                class="flex-1 bg-surface-2 hover:bg-zinc-700 text-tertiary hover:text-primary text-xs font-medium px-3 py-1.5 rounded-lg border border-surface-3 transition-all"
                >Clear</button
              >
              <select
                id="export-format"
                class="bg-surface-2 border border-surface text-xs text-tertiary rounded-lg px-2 py-1.5"
              >
                <option value="txt">TXT</option><option value="json">JSON</option><option value="csv">CSV</option
                ><option value="html">HTML</option>
              </select>
            </div>
          </div>
        </div>
      </div>
      <ToolContentSections
        toolSlug="diff-checker"
        toolName="Diff Checker"
        category="Developer Tools"
        {benefits}
        howToSteps={howToSteps}
        useCases={useCases}
      />
      <RelatedTools current="diff-checker" />
      <div class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight text-center mb-10">
          Frequently Asked <span class="bg-gradient-to-r from-green-400 to-emerald-500 bg-clip-text text-transparent"
            >Questions</span
          >
        </h2><Accordion items={faqItems.map((i) => ({ title: i.question, content: i.answer }))} />
      </div>
    </div>
  </main>
</MainLayout>
<script>
  const leftInput = document.getElementById('text-left') as HTMLTextAreaElement;
  const rightInput = document.getElementById('text-right') as HTMLTextAreaElement;
  const compareBtn = document.getElementById('compare-btn');
  const diffResult = document.getElementById('diff-result');
  const diffLeft = document.getElementById('diff-left');
  const diffRight = document.getElementById('diff-right');

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function simpleDiff(leftLines: string[], rightLines: string[]) {
    const m = leftLines.length,
      n = rightLines.length;
    const dp: number[][] = Array.from({ length: m + 1 }, () => Array(n + 1).fill(0));
    for (let i = 1; i <= m; i++)
      for (let j = 1; j <= n; j++)
        dp[i][j] = leftLines[i - 1] === rightLines[j - 1] ? dp[i - 1][j - 1] + 1 : Math.max(dp[i - 1][j], dp[i][j - 1]);
    const leftResult: { text: string; type: 'same' | 'removed' }[] = [];
    const rightResult: { text: string; type: 'same' | 'added' }[] = [];
    let i = m,
      j = n;
    while (i > 0 || j > 0) {
      if (i > 0 && j > 0 && leftLines[i - 1] === rightLines[j - 1]) {
        leftResult.unshift({ text: leftLines[i - 1], type: 'same' });
        rightResult.unshift({ text: rightLines[j - 1], type: 'same' });
        i--;
        j--;
      } else if (j > 0 && (i === 0 || dp[i][j - 1] >= dp[i - 1][j])) {
        rightResult.unshift({ text: rightLines[j - 1], type: 'added' });
        leftResult.unshift({ text: '', type: 'removed' });
        j--;
      } else {
        leftResult.unshift({ text: leftLines[i - 1], type: 'removed' });
        rightResult.unshift({ text: '', type: 'added' });
        i--;
      }
    }
    return { leftResult, rightResult };
  }

  function renderLine(text: string, type: string, side: 'left' | 'right'): string {
    if (text === '' && type === 'removed')
      return `<div class="bg-red-600/20 border-l-2 border-red-500 px-3 py-0.5 text-red-300 font-mono text-sm leading-relaxed">&nbsp;</div>`;
    if (text === '' && type === 'added')
      return `<div class="bg-green-600/20 border-l-2 border-green-500 px-3 py-0.5 text-green-300 font-mono text-sm leading-relaxed">&nbsp;</div>`;
    if (type === 'same')
      return `<div class="bg-transparent px-3 py-0.5 text-primary font-mono text-sm leading-relaxed">${escapeHtml(text)}</div>`;
    if (type === 'removed')
      return `<div class="bg-red-600/20 border-l-2 border-red-500 px-3 py-0.5 text-red-300 font-mono text-sm leading-relaxed">${escapeHtml(text)}</div>`;
    if (type === 'added')
      return `<div class="bg-green-600/20 border-l-2 border-green-500 px-3 py-0.5 text-green-300 font-mono text-sm leading-relaxed">${escapeHtml(text)}</div>`;
    return '';
  }

  function playPing() {
    try {
      const a = new (window.AudioContext || window.webkitAudioContext)();
      const o = a.createOscillator();
      const g = a.createGain();
      o.connect(g);
      g.connect(a.destination);
      o.frequency.value = 800;
      g.gain.setValueAtTime(0.08, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, a.currentTime + 0.12);
      o.start();
      o.stop(a.currentTime + 0.12);
    } catch (e) {}
  }
  document.getElementById('copy-btn')?.addEventListener('click', () => {
    const text = '=== Original ===\n' + leftInput.value + '\n\n=== New ===\n' + rightInput.value;
    if (!text.trim()) return;
    navigator.clipboard.writeText(text).catch(() => {});
    playPing();
    const btn = document.getElementById('copy-btn');
    btn.textContent = 'Copied!';
    setTimeout(() => {
      btn.textContent = 'Copy Diff';
    }, 2000);
  });
  document.getElementById('download-btn')?.addEventListener('click', () => {
    const content = '=== Original ===\n' + leftInput.value + '\n\n=== New ===\n' + rightInput.value;
    if (!content.trim()) return;
    const fmt = (document.getElementById('export-format') as HTMLSelectElement)?.value || 'txt';
    const mimes = { txt: 'text/plain', json: 'application/json', csv: 'text/csv', html: 'text/html' };
    const data = fmt === 'json' ? JSON.stringify(content) : content;
    const blob = new Blob([data], { type: mimes[fmt] || 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'diff-comparison.' + fmt;
    a.click();
    playPing();
    URL.revokeObjectURL(a.href);
  });
  document.getElementById('clear-btn')?.addEventListener('click', () => {
    leftInput.value = '';
    rightInput.value = '';
    diffResult.classList.add('hidden');
    playPing();
  });
  compareBtn.addEventListener('click', () => {
    const leftText = leftInput.value;
    const rightText = rightInput.value;
    if (!leftText && !rightText) {
      if ((window as any).__showToast)
        (window as any).__showToast({ message: 'Paste text in both fields', variant: 'warning' });
      return;
    }
    const leftLines = leftText.split('\n');
    const rightLines = rightText.split('\n');
    const { leftResult, rightResult } = simpleDiff(leftLines, rightLines);
    diffLeft.innerHTML = leftResult.map((r) => renderLine(r.text, r.type, 'left')).join('');
    diffRight.innerHTML = rightResult.map((r) => renderLine(r.text, r.type, 'right')).join('');
    diffResult.classList.remove('hidden');
  });
  document.getElementById('share-btn')?.addEventListener('click', () => {
    const o = document.getElementById('diff-left');
    const t = o?.textContent || '';
    if (!t) return;
    const u = window.location.origin + window.location.pathname + '#result=' + encodeURIComponent(t.substring(0, 200));
    navigator.clipboard.writeText(u).catch(() => {});
    if (typeof (window as any).__showToast === 'function')
      (window as any).__showToast({ message: 'Link copied!', variant: 'success' });
  });
  document.querySelector('.font-inc')?.addEventListener('click', () => {
    document.querySelectorAll('textarea').forEach((t) => {
      let s = parseInt(getComputedStyle(t).fontSize);
      t.style.fontSize = Math.min(24, s + 2) + 'px';
    });
  });
  document.querySelector('.font-dec')?.addEventListener('click', () => {
    document.querySelectorAll('textarea').forEach((t) => {
      let s = parseInt(getComputedStyle(t).fontSize);
      t.style.fontSize = Math.max(10, s - 2) + 'px';
    });
  });
  try {
    const s = localStorage.getItem('nt_fs');
    if (s) document.querySelectorAll('textarea').forEach((t) => (t.style.fontSize = s + 'px'));
  } catch (e) {}
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      e.preventDefault();
      const b = document.querySelector("button[id$='btn']:not([id*='full']):not([id*='paste']):not([id*='clear'])");
      if (b) b.click();
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c')) {
      e.preventDefault();
      document.getElementById('clear-btn')?.click();
    }
    if (e.ctrlKey && (e.key === 'D' || e.key === 'd')) {
      e.preventDefault();
      document.getElementById('download-btn')?.click();
    }
  });
  try {
    const u = JSON.parse(localStorage.getItem('nt_tool_usage') || '{}');
    const b = document.getElementById('usage-badge');
    if (b && u['diff']) b.textContent = 'Used ' + u['diff'] + '×';
  } catch (e) {}
  const rt = document.getElementById('text-left');
  if (rt) {
    const updateRt = () => {
      const w = (rt.value + ' ' + (document.getElementById('text-right') as HTMLTextAreaElement)?.value || '')
        .trim()
        .split(/\s+/)
        .filter(Boolean).length;
      const e = document.getElementById('reading-time');
      if (e)
        e.textContent =
          Math.max(1, Math.round(w / 200)) + ' min read · ' + Math.max(1, Math.round(w / 150)) + ' min speak';
    };
    rt.addEventListener('input', updateRt);
    document.getElementById('text-right')?.addEventListener('input', updateRt);
    updateRt();
  }
  const lf = document.getElementById('text-left');
  if (lf) {
    lf.addEventListener('input', () => {
      const t = lf.value.toLowerCase().replace(/[^a-z]/g, '');
      if (!t) {
        document.getElementById('letter-freq')?.classList.add('hidden');
        return;
      }
      const f = {};
      for (const c of t) f[c] = (f[c] || 0) + 1;
      const s = Object.entries(f)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8);
      const m = s[0] ? s[0][1] : 1;
      const el = document.getElementById('letter-freq');
      el.classList.remove('hidden');
      el.innerHTML = s
        .map(
          ([c, n]) =>
            `<div class="flex items-center gap-1.5 text-xs"><span class="w-3 text-center font-mono text-white">${c}</span><div class="h-2 rounded-full bg-purple-500/50" style="width:${(n / m) * 80 + 10}%"></div><span class="text-muted">${n}</span></div>`,
        )
        .join('');
    });
  }
  function setupLineNumbers(ta, ln) {
    const ul = () => {
      const n = document.getElementById(ln);
      if (n) n.textContent = Array.from({ length: ta.value.split('\n').length }, (_, i) => i + 1).join('\n');
    };
    ta.addEventListener('input', ul);
    ta.addEventListener('scroll', () => {
      const n = document.getElementById(ln);
      if (n) n.scrollTop = ta.scrollTop;
    });
    ul();
  }
  setupLineNumbers(document.getElementById('text-left'), 'line-nums-left');
  setupLineNumbers(document.getElementById('text-right'), 'line-nums-right');
  document.querySelectorAll('.theme-swatch').forEach((s) => {
    s.addEventListener('click', () => {
      const c = s.dataset.color;
      document.querySelectorAll("button[class*='bg-green'],button[class*='bg-emerald']").forEach((b) => {
        b.className = b.className
          .replace(/bg-(green|emerald)-\d+/g, 'bg-' + c + '-600')
          .replace(/hover:bg-(green|emerald)-\d+/g, 'hover:bg-' + c + '-500');
      });
      try {
        localStorage.setItem('nt_theme', c);
      } catch (e) {}
    });
  });
  try {
    const c = localStorage.getItem('nt_theme');
    if (c) document.querySelector(`.theme-swatch[data-color="${c}"]`)?.click();
  } catch (e) {}

  // ─── Fullscreen ───
  (function() {
    var fsBtn = document.getElementById('fullscreen-btn');
    if (fsBtn) {
      fsBtn.addEventListener('click', function() {
        var el = document.querySelector('main') || document.documentElement;
        if (!document.fullscreenElement) { el.requestFullscreen && el.requestFullscreen(); }
        else { document.exitFullscreen && document.exitFullscreen(); }
      });
    }
    document.addEventListener('keydown', function(e) {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'f' || e.key === 'F') { if (fsBtn) fsBtn.click(); }
    });
  })();</script>
