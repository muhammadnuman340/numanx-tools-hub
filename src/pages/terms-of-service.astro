---
import MainLayout from '../layouts/MainLayout.astro';
import AdUnit from '../components/AdUnit.astro';
---

<MainLayout title="Terms of Service - NumanX Tools" description="Read the Terms of Service for NumanX Tools. Understand the guidelines and conditions for using our free platform." keywords="terms of service, tos, guidelines, user agreement, numanx tools" canonical="https://numanx-tools.pages.dev/terms-of-service/">
  <main class="min-h-screen pt-16 pb-24 px-6 relative overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <!-- Hero -->
      <section class="text-center mb-16">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-zinc-700/50 bg-zinc-900/80 text-tertiary text-xs font-semibold tracking-wider uppercase mb-8"
        >
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
          </span>
          Legal
        </div>
        <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-none">
          Terms of
          <span
            class="block mt-2 bg-gradient-to-r from-purple-400 via-purple-500 to-blue-500 bg-clip-text text-transparent"
          >
            Service
          </span>
        </h1>
        <p class="mt-6 text-tertiary text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
          Simple, transparent rules for using NumanX Tools.
          <span class="text-secondary"> Last updated: May 2026.</span>
        </p>
      </section>

      <div class="max-w-4xl mx-auto mb-8">
        <AdUnit format="horizontal" />
      </div>

      <!-- Terms Content -->
      <div class="space-y-8">
        <div class="bg-zinc-900/30 border border-zinc-800/80 p-6 md:p-8 rounded-2xl shadow-xl">
          <h2 class="text-xl md:text-2xl font-bold text-white flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-lg bg-purple-600/10 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0"
              >1</span
            >
            1. Acceptance of Terms
          </h2>
          <p class="text-tertiary leading-relaxed">
            By accessing or using NumanX Tools ("the Platform"), you agree to be bound by these Terms of Service. If you
            do not agree with any part of these terms, you must not use the Platform. Continued use of the Platform
            constitutes acceptance of any updates to these terms.
          </p>
        </div>

        <div class="bg-zinc-900/30 border border-zinc-800/80 p-6 md:p-8 rounded-2xl shadow-xl">
          <h2 class="text-xl md:text-2xl font-bold text-white flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-lg bg-purple-600/10 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0"
              >2</span
            >
            2. Use of Services
          </h2>
          <p class="text-tertiary leading-relaxed">
            NumanX Tools provides free, browser-based utilities for image processing, text analysis, calculations, and
            more. All tools run entirely on the client side using the Canvas API and vanilla JavaScript — no data is
            uploaded to any server. You may use the tools for personal, educational, or commercial purposes as long as
            you comply with these terms.
          </p>
        </div>

        <div class="bg-zinc-900/30 border border-zinc-800/80 p-6 md:p-8 rounded-2xl shadow-xl">
          <h2 class="text-xl md:text-2xl font-bold text-white flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-lg bg-purple-600/10 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0"
              >3</span
            >
            3. User Responsibilities
          </h2>
          <p class="text-tertiary leading-relaxed">
            You agree not to misuse the Platform by attempting to disrupt its functionality, bypass security measures,
            or use the tools for unlawful purposes. You are responsible for verifying the accuracy of any results
            produced by the tools, especially for critical calculations or decisions.
          </p>
        </div>

        <div class="bg-zinc-900/30 border border-zinc-800/80 p-6 md:p-8 rounded-2xl shadow-xl">
          <h2 class="text-xl md:text-2xl font-bold text-white flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-lg bg-purple-600/10 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0"
              >4</span
            >
            4. Intellectual Property
          </h2>
          <p class="text-tertiary leading-relaxed">
            All tools, designs, code, and content on NumanX Tools are the intellectual property of NumanX unless
            otherwise stated. You may not copy, modify, distribute, or reverse-engineer the Platform's code without
            explicit permission. Output generated by the tools (e.g., converted images, QR codes) belongs to you.
          </p>
        </div>

        <div class="bg-zinc-900/30 border border-zinc-800/80 p-6 md:p-8 rounded-2xl shadow-xl">
          <h2 class="text-xl md:text-2xl font-bold text-white flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-lg bg-purple-600/10 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0"
              >5</span
            >
            5. Tool Availability
          </h2>
          <p class="text-tertiary leading-relaxed">
            The tools are provided on an "as-is" and "as-available" basis. We strive to maintain high uptime and
            performance, but we do not guarantee uninterrupted or error-free operation. Tools may be updated, modified,
            or discontinued at any time without prior notice. Results may vary depending on browser, device, and input
            data.
          </p>
        </div>

        <div class="bg-zinc-900/30 border border-zinc-800/80 p-6 md:p-8 rounded-2xl shadow-xl">
          <h2 class="text-xl md:text-2xl font-bold text-white flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-lg bg-purple-600/10 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0"
              >6</span
            >
            6. Third-Party Links
          </h2>
          <p class="text-tertiary leading-relaxed">
            The Platform may contain links to third-party websites or services. NumanX is not responsible for the
            content, privacy practices, or availability of those sites. Use them at your own risk.
          </p>
        </div>

        <div class="bg-zinc-900/30 border border-zinc-800/80 p-6 md:p-8 rounded-2xl shadow-xl">
          <h2 class="text-xl md:text-2xl font-bold text-white flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-lg bg-purple-600/10 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0"
              >7</span
            >
            7. Disclaimer of Warranties
          </h2>
          <p class="text-tertiary leading-relaxed">
            NumanX Tools are provided without any warranty, express or implied. We do not guarantee that the tools will
            meet your specific requirements, be error-free, or produce accurate results in all scenarios. Use the tools
            at your own discretion and verify critical outputs independently.
          </p>
        </div>

        <div class="bg-zinc-900/30 border border-zinc-800/80 p-6 md:p-8 rounded-2xl shadow-xl">
          <h2 class="text-xl md:text-2xl font-bold text-white flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-lg bg-purple-600/10 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0"
              >8</span
            >
            8. Limitation of Liability
          </h2>
          <p class="text-tertiary leading-relaxed">
            NumanX and its creator shall not be liable for any direct, indirect, incidental, or consequential damages
            arising from the use or inability to use the Platform. This includes but is not limited to data loss,
            financial loss, or business interruption, even if advised of the possibility of such damages.
          </p>
        </div>

        <div class="bg-zinc-900/30 border border-zinc-800/80 p-6 md:p-8 rounded-2xl shadow-xl">
          <h2 class="text-xl md:text-2xl font-bold text-white flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-lg bg-purple-600/10 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0"
              >9</span
            >
            9. Changes to Terms
          </h2>
          <p class="text-tertiary leading-relaxed">
            We reserve the right to modify these terms at any time. Changes will be posted on this page with an updated
            "Last updated" date. Continued use of the Platform after changes are posted constitutes acceptance of the
            new terms. We encourage you to review this page periodically.
          </p>
        </div>

        <div class="bg-zinc-900/30 border border-zinc-800/80 p-6 md:p-8 rounded-2xl shadow-xl">
          <h2 class="text-xl md:text-2xl font-bold text-white flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-lg bg-purple-600/10 flex items-center justify-center text-purple-400 text-sm font-bold shrink-0"
              >10</span
            >
            10. Contact Information
          </h2>
          <p class="text-tertiary leading-relaxed">
            If you have any questions about these Terms of Service, please reach out through the platforms associated
            with NumanX. We aim to respond to all inquiries promptly and transparently.
          </p>
        </div>
      </div>

      <div class="max-w-4xl mx-auto mb-8">
        <AdUnit format="horizontal" />
      </div>

      <!-- Browser Tools Notice -->
      <div class="mt-12 bg-zinc-900/30 border border-zinc-800/80 p-6 md:p-8 rounded-2xl shadow-xl">
        <h2 class="text-xl md:text-2xl font-bold text-white mb-4">Browser Tools Notice</h2>
        <ul class="space-y-3 text-tertiary text-sm leading-relaxed">
          <li class="flex items-start gap-3">
            <span class="text-purple-400 mt-0.5 shrink-0">&#8226;</span>
            <span
              >All tools are provided as-is and run entirely in your browser. No data is uploaded to any server.</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="text-purple-400 mt-0.5 shrink-0">&#8226;</span>
            <span
              >Results may vary depending on browser type, device capabilities, and input data. Always verify critical
              calculations independently.</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="text-purple-400 mt-0.5 shrink-0">&#8226;</span>
            <span
              >We do not guarantee uninterrupted availability of any tool. Service may be modified or discontinued at
              any time.</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="text-purple-400 mt-0.5 shrink-0">&#8226;</span>
            <span
              >Users should verify important outputs (e.g., cricket statistics, age calculations, image conversions)
              before relying on them for critical decisions.</span
            >
          </li>
        </ul>
      </div>

      <!-- Trust Section -->
      <div class="mt-16">
        <h2 class="text-3xl md:text-4xl font-black tracking-tight text-center mb-10">
          Our
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Commitment</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="glass-card rounded-xl p-5 text-center hover:border-zinc-700 transition-all duration-300 group">
            <div
              class="w-12 h-12 rounded-2xl bg-gradient-to-br from-purple-600/20 to-blue-600/20 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#a855f7"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg
              >
            </div>
            <h3 class="text-sm font-semibold text-primary">Fair Use</h3>
            <p class="text-xs text-muted mt-2 leading-relaxed">
              Free for everyone — no hidden limits, no paywalls, no surprises.
            </p>
          </div>
          <div
            class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 text-center hover:border-zinc-700 transition-all duration-300 group"
          >
            <div
              class="w-12 h-12 rounded-2xl bg-gradient-to-br from-purple-600/20 to-blue-600/20 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#a855f7"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                ></path></svg
              >
            </div>
            <h3 class="text-sm font-semibold text-primary">Transparency</h3>
            <p class="text-xs text-muted mt-2 leading-relaxed">
              Clear terms, no legalese. You always know what you're agreeing to.
            </p>
          </div>
          <div
            class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 text-center hover:border-zinc-700 transition-all duration-300 group"
          >
            <div
              class="w-12 h-12 rounded-2xl bg-gradient-to-br from-purple-600/20 to-blue-600/20 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#a855f7"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line
                  x1="12"
                  y1="17"
                  x2="12.01"
                  y2="17"></line></svg
              >
            </div>
            <h3 class="text-sm font-semibold text-primary">Accessibility</h3>
            <p class="text-xs text-muted mt-2 leading-relaxed">
              Designed for everyone — students, creators, developers, and fans.
            </p>
          </div>
          <div
            class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 text-center hover:border-zinc-700 transition-all duration-300 group"
          >
            <div
              class="w-12 h-12 rounded-2xl bg-gradient-to-br from-purple-600/20 to-blue-600/20 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#a855f7"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"
                ></path></svg
              >
            </div>
            <h3 class="text-sm font-semibold text-primary">Continuous Improvement</h3>
            <p class="text-xs text-muted mt-2 leading-relaxed">
              We're always building — new tools, better performance, more features.
            </p>
          </div>
        </div>
      </div>

      <!-- FAQ -->
      <div class="mt-16">
        <h2 class="text-3xl md:text-4xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Questions</span>
        </h2>
        <div class="max-w-3xl mx-auto space-y-3">
          <div
            class="faq-item rounded-xl border border-zinc-800 bg-zinc-900/40 overflow-hidden transition-all duration-300"
          >
            <button
              class="faq-toggle w-full flex items-center justify-between px-6 py-4 text-left text-primary font-medium hover:text-white transition-colors duration-200"
            >
              <span>Can I use NumanX Tools commercially?</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="faq-chevron shrink-0 transition-transform duration-300"
                ><polyline points="6 9 12 15 18 9"></polyline></svg
              >
            </button>
            <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="px-6 pb-4 text-sm text-tertiary leading-relaxed">
                Yes, you can use NumanX Tools for commercial purposes. All tools are free to use for personal,
                educational, and commercial projects with no restrictions. However, you may not copy, modify, or
                redistribute the tools themselves without permission.
              </div>
            </div>
          </div>
          <div
            class="faq-item rounded-xl border border-zinc-800 bg-zinc-900/40 overflow-hidden transition-all duration-300"
          >
            <button
              class="faq-toggle w-full flex items-center justify-between px-6 py-4 text-left text-primary font-medium hover:text-white transition-colors duration-200"
            >
              <span>Are the tools really free?</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="faq-chevron shrink-0 transition-transform duration-300"
                ><polyline points="6 9 12 15 18 9"></polyline></svg
              >
            </button>
            <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="px-6 pb-4 text-sm text-tertiary leading-relaxed">
                Yes, completely free. No sign-ups, no watermarks, no file limits, and no hidden charges. All processing
                happens in your browser — there are no server costs to pass on to users. This will always remain free.
              </div>
            </div>
          </div>
          <div
            class="faq-item rounded-xl border border-zinc-800 bg-zinc-900/40 overflow-hidden transition-all duration-300"
          >
            <button
              class="faq-toggle w-full flex items-center justify-between px-6 py-4 text-left text-primary font-medium hover:text-white transition-colors duration-200"
            >
              <span>Can the terms change?</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="faq-chevron shrink-0 transition-transform duration-300"
                ><polyline points="6 9 12 15 18 9"></polyline></svg
              >
            </button>
            <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="px-6 pb-4 text-sm text-tertiary leading-relaxed">
                Yes, we may update these terms as the platform grows. Changes will be posted on this page with an
                updated date. We recommend checking back occasionally. Continued use after changes means you accept the
                updated terms.
              </div>
            </div>
          </div>
          <div
            class="faq-item rounded-xl border border-zinc-800 bg-zinc-900/40 overflow-hidden transition-all duration-300"
          >
            <button
              class="faq-toggle w-full flex items-center justify-between px-6 py-4 text-left text-primary font-medium hover:text-white transition-colors duration-200"
            >
              <span>How can I contact NumanX?</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="faq-chevron shrink-0 transition-transform duration-300"
                ><polyline points="6 9 12 15 18 9"></polyline></svg
              >
            </button>
            <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="px-6 pb-4 text-sm text-tertiary leading-relaxed">
                You can reach out through the social platforms and channels associated with NumanX. We're active and
                responsive to questions, feedback, and suggestions from the community.
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-16 text-center">
        <div class="bg-zinc-900/30 border border-zinc-800/80 p-8 md:p-12 rounded-2xl shadow-xl">
          <h2 class="text-2xl md:text-3xl font-black tracking-tight">
            Explore the
            <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Platform</span>
          </h2>
          <p class="mt-3 text-tertiary max-w-lg mx-auto leading-relaxed">
            Start using free tools today. No sign-up, no uploads, no limits.
          </p>
          <div class="mt-6 flex items-center justify-center gap-4">
            <a
              href="/tools/"
              class="bg-purple-600 hover:bg-purple-700 text-white font-semibold text-sm px-6 py-3 rounded-xl transition-all duration-200 hover:-translate-y-0.5 shadow-lg shadow-purple-900/30"
            >
              Explore Tools
            </a>
            <a
              href="/about/"
              class="border border-zinc-700 hover:border-zinc-500 text-secondary hover:text-white font-semibold text-sm px-6 py-3 rounded-xl transition-all duration-200"
            >
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</MainLayout>

<script>
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const answer = item.querySelector('.faq-answer');
      const chevron = btn.querySelector('.faq-chevron');
      document.querySelectorAll('.faq-item').forEach((other) => {
        if (other !== item) {
          other.querySelector('.faq-answer').style.maxHeight = '0px';
          other.querySelector('.faq-chevron').classList.remove('rotate-180');
        }
      });
      const isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';
      if (isOpen) {
        answer.style.maxHeight = '0px';
        chevron.classList.remove('rotate-180');
      } else {
        answer.style.maxHeight = answer.scrollHeight + 'px';
        chevron.classList.add('rotate-180');
      }
    });
  });
</script>
