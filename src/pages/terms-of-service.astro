      <!-- FAQ -->
      <div class="mt-16">
        <h2 class="text-3xl md:text-4xl font-black tracking-tight text-center mb-10">
          Frequently Asked
          <span class="text-amber-400">Questions</span>
        </h2>
        <div class="max-w-3xl mx-auto space-y-3">
