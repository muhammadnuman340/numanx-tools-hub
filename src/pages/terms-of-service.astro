                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                style="stroke:var(--accent)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg
