---
import MainLayout from '../layouts/MainLayout.astro';
import ToolIcon from '../components/icons/ToolIcon.astro';
---

<MainLayout title="You're Offline | NumanX Tools" description="You are currently offline. NumanX Tools supports offline usage." keywords="offline, no internet, numanx tools" noindex={true}>
  <main class="min-h-screen pt-20 pb-24 px-6 relative overflow-hidden flex items-center justify-center">
    <!-- Background orbs -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div
        class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-purple-600/10 blur-3xl animate-pulse"
        style="animation-duration: 6s;"
      >
      </div>
      <div
        class="absolute -bottom-40 -left-40 w-80 h-80 rounded-full bg-blue-600/10 blur-3xl animate-pulse"
        style="animation-duration: 8s; animation-delay: 1s;"
      >
      </div>
    </div>

    <div class="max-w-2xl mx-auto text-center font-sans">
      <div class="flex justify-center mb-6">
        <div
          class="w-20 h-20 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-purple-400 shadow-xl"
        >
          <!-- Offline Wifi icon -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-10 h-10"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 3l18 18M18.364 5.636a9 9 0 011.085 11.517m-3.08-11.52A7 7 0 0118.5 12M5.636 18.364a9 9 0 01-1.085-11.517M8.72 15.68A7 7 0 015.5 12m10.05 3.05a3.5 3.5 0 01-4.89-.047m0 0a3.5 3.5 0 010-4.903"
            ></path>
          </svg>
        </div>
      </div>

      <h1 class="text-3xl md:text-4xl font-extrabold text-white">Offline Mode</h1>
      <p class="text-tertiary mt-3 max-w-md mx-auto leading-relaxed">
        You are currently offline. Fortunately, almost all of our utilities are <span
          class="text-purple-400 font-semibold">100% offline-first</span
        > and continue to work entirely inside your browser. No internet required!
      </p>

      <div class="flex items-center justify-center gap-4 mt-8">
        <a
          href="/"
          class="bg-purple-600 hover:bg-purple-700 text-white font-semibold text-sm px-6 py-3 rounded-xl transition-all duration-200"
        >
          Try Homepage
        </a>
        <a
          href="/tools/"
          class="border border-zinc-700 hover:border-zinc-500 text-secondary hover:text-white font-semibold text-sm px-6 py-3 rounded-xl transition-all duration-200"
        >
          Explore Saved Tools
        </a>
      </div>

      <div class="mt-16">
        <h2 class="text-sm font-semibold text-muted uppercase tracking-wider mb-5">Offline-Ready Utilities</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <a
            href="/tools/qr-generator/"
            class="group glass-card rounded-2xl p-4 text-center hover:border-purple-500/40 hover:-translate-y-1 transition-all duration-300"
          >
            <div class="text-purple-400 mx-auto w-fit mb-2"><ToolIcon name="qr" /></div>
            <p class="text-xs font-medium text-secondary group-hover:text-white transition-colors">QR Generator</p>
          </a>
          <a
            href="/tools/word-counter/"
            class="group glass-card rounded-2xl p-4 text-center hover:border-purple-500/40 hover:-translate-y-1 transition-all duration-300"
          >
            <div class="text-purple-400 mx-auto w-fit mb-2"><ToolIcon name="word" /></div>
            <p class="text-xs font-medium text-secondary group-hover:text-white transition-colors">Word Counter</p>
          </a>
          <a
            href="/tools/password-generator/"
            class="group glass-card rounded-2xl p-4 text-center hover:border-purple-500/40 hover:-translate-y-1 transition-all duration-300"
          >
            <div class="text-purple-400 mx-auto w-fit mb-2"><ToolIcon name="password" /></div>
            <p class="text-xs font-medium text-secondary group-hover:text-white transition-colors">
              Password Generator
            </p>
          </a>
          <a
            href="/tools/case-converter/"
            class="group glass-card rounded-2xl p-4 text-center hover:border-purple-500/40 hover:-translate-y-1 transition-all duration-300"
          >
            <div class="text-purple-400 mx-auto w-fit mb-2"><ToolIcon name="text" /></div>
            <p class="text-xs font-medium text-secondary group-hover:text-white transition-colors">Case Converter</p>
          </a>
        </div>
      </div>
    </div>
  </main>
</MainLayout>
