---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="You're Offline - NumanX Tools" description="You are currently offline. Some features may be unavailable until you reconnect.">
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="max-w-lg text-center">
      <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-surface-2 border border-surface flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted">
          <line x1="1" y1="1" x2="23" y2="23"/><path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"/><path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"/><path d="M10.71 5.05A16 16 0 0 1 22.56 9"/><path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>
        </svg>
      </div>
      <h1 class="text-3xl md:text-4xl font-black tracking-tight text-white mb-3">You're Offline</h1>
      <p class="text-tertiary mb-8 leading-relaxed">
        It looks like you've lost your internet connection. NumanX Tools runs entirely in your browser, so tools you've already loaded may still work.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="px-6 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-medium transition-all duration-200">Go Home</a>
        <button onclick="window.location.reload()" class="px-6 py-3 rounded-xl border border-surface bg-surface-1 hover:bg-surface-2 text-primary font-medium transition-all duration-200">Try Again</button>
      </div>
    </div>
  </main>
</MainLayout>
