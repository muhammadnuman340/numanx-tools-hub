---
import MainLayout from '../../layouts/MainLayout.astro';
import PostCard from '../../components/ui/PostCard.astro';
import AdUnit from '../../components/AdUnit.astro';

const comparisonModules = import.meta.glob('./*.md', { eager: true });
const comparisons = Object.entries(comparisonModules)
  .map(([path, mod]) => ({
    ...mod,
    slug: path.replace('./', '').replace('.md', ''),
  }))
  .sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));
---

<MainLayout
  title="Comparisons - NumanX Tools | File Format & Tool Face-offs"
  description="Side-by-side comparisons from NumanX Tools, starting with WebP vs PNG vs JPG: file size, quality, transparency, browser support and when to use each one."
  keywords="comparisons, vs, format comparison, jpg vs png, webp vs png, tool comparison, image format comparison"
  canonical="https://toolshub.numanxstudio.com/comparisons/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Comparisons', url: '/comparisons/' },
  ]}
>
  <main class="min-h-screen pt-8 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-6xl mx-auto">
      <div class="mb-10 pt-6">
        <p class="text-xs font-mono uppercase tracking-wider text-zinc-400 mb-3">
          {comparisons.length} {comparisons.length === 1 ? 'comparison' : 'comparisons'}
        </p>
        <h1 class="text-[length:var(--step-3)] font-bold tracking-[-0.02em] leading-tight text-primary">
          Format and tool comparisons
        </h1>
        <p class="mt-3 text-secondary text-lg max-w-[68ch] leading-relaxed">
          Side-by-side comparisons for when you have to pick one option, such as which image format to save in. Each
          one sets out the trade-offs in a table and ends with a plain recommendation you can try in a free tool.
        </p>
      </div>

      <div class="max-w-4xl mx-auto px-4 mb-8">
        <AdUnit format="horizontal" />
      </div>

      <div id="comparisons-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          comparisons.map((comparison) => (
            <PostCard
              url={'/comparisons/' + comparison.slug + '/'}
              title={comparison.frontmatter.title}
              desc={comparison.frontmatter.summary || comparison.frontmatter.description}
              tag={(comparison.frontmatter.tags || [])[0] || 'Comparison'}
              meta="Comparison"
              cta="Compare"
              headingLevel="h2"
            />
          ))
        }
      </div>

      <div class="max-w-4xl mx-auto my-8">
        <AdUnit format="horizontal" />
      </div>

      <div class="mt-16 bg-surface-1 border border-surface p-8 md:p-10 rounded-xl">
        <h2 class="text-2xl font-bold tracking-tight text-white">Try the formats yourself</h2>
        <p class="text-secondary mt-3 max-w-[60ch] text-sm">
          Convert or compress one of your own images and compare the file sizes. Everything runs in your browser.
        </p>
        <div class="mt-6 flex gap-3 flex-wrap">
          <a
            href="/tools/jpg-to-png/"
            class="px-6 py-3 rounded-xl bg-amber-600 hover:bg-amber-700 text-accent-fg font-semibold text-sm active:scale-[0.97] transition-all duration-200"
          >
            JPG to PNG
          </a>
          <a
            href="/tools/png-to-webp/"
            class="px-6 py-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-semibold text-sm active:scale-[0.97] transition-all duration-200 border border-zinc-700"
          >
            PNG to WebP
          </a>
          <a
            href="/tools/image-compressor/"
            class="px-6 py-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-semibold text-sm active:scale-[0.97] transition-all duration-200 border border-zinc-700"
          >
            Image Compressor
          </a>
        </div>
      </div>
    </div>
  </main>
</MainLayout>
