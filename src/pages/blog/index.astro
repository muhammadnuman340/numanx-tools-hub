---
import MainLayout from '../../layouts/MainLayout.astro';

const postModules = import.meta.glob('./*.md', { eager: true });
const blogPosts = Object.entries(postModules)
  .map(([path, mod]) => ({
    ...mod,
    slug: path.replace('./', '').replace('.md', ''),
  }))
  .sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));

const categories = ['All', 'AI Tools', 'Image Tools', 'Creator Tools', 'Cricket Tools', 'Productivity'];

// Category color mapping
const categoryColors: Record<string, { bg: string; text: string; border: string }> = {
  'AI Tools': { bg: 'bg-blue-500/15', text: 'text-blue-300', border: 'border-blue-500/30' },
  'Image Tools': { bg: 'bg-purple-500/15', text: 'text-purple-300', border: 'border-purple-500/30' },
  'Creator Tools': { bg: 'bg-pink-500/15', text: 'text-pink-300', border: 'border-pink-500/30' },
  'Cricket Tools': { bg: 'bg-amber-500/15', text: 'text-amber-300', border: 'border-amber-500/30' },
  'Productivity': { bg: 'bg-emerald-500/15', text: 'text-emerald-300', border: 'border-emerald-500/30' },
  'General': { bg: 'bg-zinc-500/15', text: 'text-zinc-300', border: 'border-zinc-500/30' },
};
---

<MainLayout
  title="Blog - NumanX Tools | Tips, Guides & Resources for Creators"
  description="Tips, guides, and resources for creators, students, and developers. Learn about image tools, AI productivity, cricket analytics, social media growth, and more."
  keywords="blog, numanx blog, creator tips, productivity guides, image tools guide, cricket analytics blog, AI tools blog, student productivity, social media tips, best online tools"
  canonical="https://numanx-tools.pages.dev/blog/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog/' },
  ]}
>
  <main class="min-h-screen pt-8 pb-20 px-6 relative overflow-hidden">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-1.5 text-xs sm:text-sm text-zinc-400">
          <li>
            <a href="/" class="hover:text-white transition-colors">Home</a>
          </li>
          <li class="text-zinc-600 select-none" aria-hidden="true">&gt;</li>
          <li class="text-zinc-200 font-semibold" aria-current="page">
            Blog
          </li>
        </ol>
      </nav>

      <!-- Header -->
      <div class="text-center mb-10">
        <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-none text-white">
          Blog
        </h1>
        <p class="mt-4 text-zinc-400 text-base md:text-lg max-w-xl mx-auto">
          Tips, guides, and resources to help you work smarter.
        </p>
      </div>

      <!-- Search Bar -->
      <div class="max-w-2xl mx-auto mb-6">
        <div class="relative">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500 pointer-events-none"
          ><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input
            id="search-input"
            type="text"
            placeholder="Search articles..."
            class="w-full bg-surface-1 border border-surface rounded-2xl py-3.5 pl-12 pr-12 text-white placeholder-zinc-500 text-sm focus:outline-none focus:border-purple-500/50 focus:ring-1 focus:ring-purple-500/30 transition-all duration-200" aria-label="Search articles"
          />
          <button
            id="search-clear"
            class="absolute right-4 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 transition-colors hidden"
            aria-label="Clear search"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="max-w-2xl mx-auto mb-10">
        <div id="category-filters" class="flex gap-2 flex-wrap justify-center">
          {
            categories.map((cat) => {
              const active = cat === 'All';
              return (
                <button
                  class={`cat-btn px-4 py-2 text-sm font-semibold rounded-full transition-all ${
                    active
                      ? 'bg-purple-600 text-white shadow-lg shadow-purple-900/30'
                      : 'bg-surface-1 text-zinc-400 border border-surface hover:border-zinc-600 hover:text-white'
                  }`}
                  data-category={cat}
                  data-active={active ? 'true' : 'false'}
                >
                  {cat}
                </button>
              );
            })
          }
        </div>
      </div>

      <!-- Blog Post Cards Grid -->
      <h2 class="sr-only">Latest articles</h2>
      <div
        id="cards-container-blog"
        class="grid grid-cols-1 sm:grid-cols-2 gap-5"
      >
        {
          blogPosts.map((post) => {
            const cat = post.frontmatter.category || 'General';
            const colors = categoryColors[cat] || categoryColors['General'];
            return (
              <a
                href={'/blog/' + post.slug + '/'}
                class="post-card group block bg-surface-1/80 border border-surface rounded-2xl p-6 hover:border-purple-500/30 hover:-translate-y-0.5 transition-all duration-300"
                data-category={cat}
              >
                <div class="flex items-center gap-3 mb-3">
                  <span class={`inline-flex px-2.5 py-0.5 rounded-full text-xs font-semibold border ${colors.bg} ${colors.text} ${colors.border}`}>
                    {cat}
                  </span>
                  <span class="text-xs text-zinc-500">{post.frontmatter.date}</span>
                  <span class="text-xs text-zinc-600">·</span>
                  <span class="text-xs text-zinc-500">{post.frontmatter.readingTime || '5 min read'}</span>
                </div>
                <h3 class="text-base font-bold text-white group-hover:text-purple-300 transition-colors duration-200 leading-snug mb-2">
                  {post.frontmatter.title}
                </h3>
                <p class="text-sm text-zinc-400 leading-relaxed line-clamp-2">
                  {post.frontmatter.description}
                </p>
              </a>
            );
          })
        }
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="hidden mt-10 text-center py-16">
        <div class="w-14 h-14 rounded-2xl bg-zinc-900/60 flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-600"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </div>
        <p class="text-zinc-400 text-sm font-medium">No articles found</p>
        <p class="text-zinc-600 text-xs mt-1">Try a different search term or category.</p>
      </div>

      <!-- Newsletter CTA -->
      <div class="mt-16 bg-surface-1/60 border border-surface p-8 md:p-10 rounded-2xl text-center">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight">
          Stay
          <span class="bg-gradient-to-r from-purple-400 to-blue-500 bg-clip-text text-transparent">Updated</span>
        </h2>
        <p class="text-zinc-400 mt-3 max-w-md mx-auto text-sm">
          Get the latest tools, tips, and guides delivered to your inbox.
        </p>
        <form class="blog-newsletter-form mt-6 max-w-md mx-auto flex flex-col sm:flex-row gap-3">
          <input
            id="newsletter-email"
            aria-label="Email address"
            type="email"
            placeholder="Enter your email"
            required
            class="flex-1 px-4 py-3 rounded-xl bg-zinc-950 border border-zinc-700 text-white placeholder-zinc-500 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/40 focus:border-purple-500/60 transition-all duration-200"
          />
          <button
            type="submit"
            class="px-6 py-3 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-semibold text-sm active:scale-[0.97] transition-all duration-200 shrink-0"
          >
            Subscribe
          </button>
        </form>
        <p id="nl-msg" class="hidden text-sm mt-3 font-medium" aria-live="polite"></p>
      </div>
    </div>
  </main>
</MainLayout>

<script>
  const initBlogPage = () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const searchClear = document.getElementById('search-clear');
    const catBtns = document.querySelectorAll('.cat-btn');
    const posts = document.querySelectorAll('.post-card');
    const emptyState = document.getElementById('empty-state');

    let activeCat = new URLSearchParams(window.location.search).get('category') || 'All';

    const updateBtnStyles = () => {
      catBtns.forEach((b: any) => {
        const isActive = b.dataset.active === 'true';
        if (isActive) {
          b.className = 'cat-btn px-4 py-2 text-sm font-semibold rounded-full transition-all bg-purple-600 text-white shadow-lg shadow-purple-900/30';
        } else {
          b.className = 'cat-btn px-4 py-2 text-sm font-semibold rounded-full transition-all bg-surface-1 text-zinc-400 border border-surface hover:border-zinc-600 hover:text-white';
        }
      });
    };

    // Set initial active category from URL
    if (activeCat !== 'All') {
      catBtns.forEach((b: any) => {
        b.dataset.active = b.dataset.category === activeCat ? 'true' : 'false';
      });
      updateBtnStyles();
    }

    function filterPosts() {
      if (!searchInput || !emptyState || !searchClear) return;
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;
      posts.forEach((card: any) => {
        const title = card.querySelector('h3')?.textContent?.toLowerCase() || '';
        const desc = card.querySelector('p')?.textContent?.toLowerCase() || '';
        const cat = card.dataset.category;
        const matchesSearch = !query || title.includes(query) || desc.includes(query);
        const matchesCat = activeCat === 'All' || cat === activeCat;
        const show = matchesSearch && matchesCat;
        card.style.display = show ? 'block' : 'none';
        if (show) visibleCount++;
      });
      emptyState.classList.toggle('hidden', visibleCount > 0);
      searchClear.classList.toggle('hidden', !query);
    }

    if (searchInput) {
      searchInput.addEventListener('input', filterPosts);
    }

    if (searchClear && searchInput) {
      searchClear.addEventListener('click', () => {
        searchInput.value = '';
        filterPosts();
        searchInput.focus();
      });
    }

    catBtns.forEach((btn: any) => {
      btn.addEventListener('click', () => {
        catBtns.forEach((b: any) => { b.dataset.active = 'false'; });
        btn.dataset.active = 'true';
        activeCat = btn.dataset.category || 'All';
        updateBtnStyles();
        filterPosts();
      });
    });

    // Run initial filter
    filterPosts();

    // Newsletter form
    document.querySelector('.blog-newsletter-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = (e.target as HTMLFormElement).querySelector("input[type='email']") as HTMLInputElement;
      const msgEl = document.getElementById('nl-msg');
      const email = input.value;
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          if (msgEl) {
            msgEl.textContent = data.message || 'Thanks for subscribing!';
            msgEl.classList.remove('hidden', 'text-red-400');
            msgEl.classList.add('text-emerald-400');
          }
          input.value = '';
          if (msgEl) setTimeout(() => msgEl.classList.add('hidden'), 5000);
        } else {
          if (msgEl) {
            msgEl.textContent = data.error || 'Subscription failed.';
            msgEl.classList.remove('hidden', 'text-emerald-400');
            msgEl.classList.add('text-red-400');
          }
        }
      } catch (err) {
        if (msgEl) {
          msgEl.textContent = 'Network error.';
          msgEl.classList.remove('hidden', 'text-emerald-400');
          msgEl.classList.add('text-red-400');
        }
      }
    });
  };
  document.addEventListener('astro:page-load', initBlogPage);
</script>
