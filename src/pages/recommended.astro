---
import MainLayout from '../layouts/MainLayout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AdUnit from '../components/AdUnit.astro';

interface AffiliateItem {
  name: string;
  description: string;
  url: string;
  category: string;
  reason: string;
  badge?: string;
}

const affiliates: AffiliateItem[] = [
  {
    name: 'Canva Pro',
    description: 'Design anything with drag-and-drop templates, brand kits, and AI-powered magic studio.',
    url: 'https://www.canva.com/join/',
    category: 'Design & Creative',
    reason: 'Best companion for our Image Tools — resize, enhance, and design all in one place.',
    badge: 'Popular',
  },
  {
    name: 'NordVPN',
    description: 'Third-party VPN service featuring AES-256 encryption, high-speed servers, and a no-logs policy.',
    url: 'https://nordvpn.com/',
    category: 'Privacy & Security',
    reason: 'Use our Password Generator to create strong passwords, then keep them safe with a VPN.',
    badge: 'Recommended',
  },
  {
    name: 'Hostinger',
    description: 'Affordable web hosting with 99.9% uptime, free SSL, and a custom control panel.',
    url: 'https://www.hostinger.com/',
    category: 'Web Hosting',
    reason: 'Perfect for launching your own projects — just like we built NumanX Tools.',
  },
  {
    name: 'Namecheap',
    description: 'Domain registration and hosting at competitive prices with free WHOIS privacy.',
    url: 'https://www.namecheap.com/',
    category: 'Web Hosting',
    reason: 'Great place to register a domain for your next project or portfolio.',
  },
  {
    name: 'Notion',
    description: 'All-in-one workspace for notes, docs, projects, and collaboration.',
    url: 'https://www.notion.so/',
    category: 'Productivity',
    reason: 'Organise your life alongside our Markdown Editor for quick drafts and notes.',
    badge: 'Popular',
  },
  {
    name: 'Visual Studio Code',
    description: 'Free, open-source code editor with thousands of extensions and built-in Git.',
    url: 'https://code.visualstudio.com/',
    category: 'Developer Tools',
    reason: 'The editor we use daily to build every tool on NumanX Tools.',
  },
  {
    name: 'Figma',
    description: 'Collaborative interface design tool with real-time editing and prototyping.',
    url: 'https://www.figma.com/',
    category: 'Design & Creative',
    reason: 'Design mockups and icons for your next big idea — free tier available.',
  },
  {
    name: 'Cloudflare',
    description: 'CDN, DNS, DDoS protection, and serverless compute — powers NumanX Tools.',
    url: 'https://www.cloudflare.com/',
    category: 'Developer Tools',
    reason: 'The platform behind NumanX Tools — fast, secure, and globally distributed.',
    badge: 'Recommended',
  },
  {
    name: 'Tailwind CSS',
    description: 'Utility-first CSS framework for rapidly building custom user interfaces.',
    url: 'https://tailwindcss.com/',
    category: 'Developer Tools',
    reason: 'The CSS framework we use to design every page on this site.',
  },
  {
    name: 'Astro',
    description: 'All-in-one web framework for building content-driven websites with less JavaScript.',
    url: 'https://astro.build/',
    category: 'Developer Tools',
    reason: 'The framework that powers NumanX Tools — fast by default.',
    badge: 'Recommended',
  },
];
---

<MainLayout
  title="Recommended Tools & Services — NumanX Tools"
  description="Our curated list of tools and services we recommend for creators, developers, and students. Some links are affiliate links."
  keywords="recommended tools, affiliate tools, best design tools, web hosting, vpn, productivity tools, numanx recommendations"
  canonical="https://toolshub.numanxstudio.com/recommended/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Recommended', url: '/recommended/' },
  ]}
>
  <main class="min-h-screen pt-16 pb-20 px-6 relative overflow-hidden">
    <div
      class="absolute top-[10%] right-[5%] w-[250px] h-[250px] rounded-full bg-amber-500/10 blur-[100px] pointer-events-none -z-10"
    >
    </div>
    <div class="max-w-5xl mx-auto">
      <!-- Hero -->
      <section class="text-center mb-16 pt-8">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-surface bg-surface-1 backdrop-blur-sm text-tertiary text-xs font-semibold tracking-wider uppercase mb-8"
        >
          <svg
            class="w-3.5 h-3.5 text-amber-400"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
          >
          Hand-Picked
        </div>
        <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-none">
          Recommended
          <span
            class="block mt-2 bg-gradient-to-r from-amber-300 via-amber-400 to-orange-400 bg-clip-text text-transparent"
            >Tools &amp; Services</span
          >
        </h1>
        <p class="mt-6 text-tertiary text-lg max-w-3xl mx-auto leading-relaxed">
          Tools and services we use and trust. Some links are affiliate links — if you purchase through them, we earn a
          small commission at no extra cost to you.
        </p>
      </section>

      <div class="max-w-4xl mx-auto mb-8">
        <AdUnit format="horizontal" />
      </div>

      <!-- Affiliate Disclosure -->
      <section class="mb-12 max-w-3xl mx-auto">
        <AffiliateDisclosure />
      </section>

      <!-- Filtered Sections -->
      <section class="mb-16">
        <div class="flex items-center gap-2 mb-8">
          <svg
            class="w-5 h-5 text-purple-400"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg
          >
          <h2 class="text-xl font-bold text-primary">All Recommendations</h2>
        </div>

        <div class="space-y-4">
          {
            affiliates.map((item) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="group block rounded-2xl border border-surface bg-surface-1 p-5 hover:border-amber-500/30 hover:bg-surface-2 hover:-translate-y-0.5 transition-all duration-300"
              >
                <div class="flex items-start justify-between gap-4">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2.5 flex-wrap">
                      <h3 class="text-base font-bold text-primary group-hover:text-white transition-colors">
                        {item.name}
                      </h3>
                      {item.badge && (
                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-400 border border-amber-500/20">
                          {item.badge}
                        </span>
                      )}
                      <span class="text-[10px] text-muted px-2 py-0.5 rounded-full bg-surface-2 border border-surface">
                        {item.category}
                      </span>
                    </div>
                    <p class="text-sm text-tertiary mt-1.5 leading-relaxed">{item.description}</p>
                    <p class="text-xs text-dim mt-2 flex items-center gap-1.5">
                      <svg
                        class="w-3.5 h-3.5 text-purple-400 shrink-0"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3" />
                      </svg>
                      {item.reason}
                    </p>
                  </div>
                  <svg
                    class="w-5 h-5 text-dim group-hover:text-amber-400 group-hover:translate-x-0.5 transition-all duration-200 shrink-0 mt-1"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </>
                  </svg>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <!-- Why Trust Us -->
      <section class="mb-16">
        <div class="relative rounded-2xl border border-surface bg-surface-1 p-6 md:p-8">
          <div class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-emerald-400 mt-0.5 shrink-0"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
            >
            <div>
              <h2 class="text-base font-bold text-primary">Why Trust Our Recommendations?</h2>
              <ul class="mt-3 space-y-2 text-sm text-tertiary leading-relaxed">
                <li class="flex items-start gap-2">
                  <svg
                    class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg
                  >
                  We only recommend products and services we personally use, trust, and believe add real value.
                </li>
                <li class="flex items-start gap-2">
                  <svg
                    class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg
                  >
                  Every tool listed here serves a real purpose for creators, students, developers, or privacy-conscious users.
                </li>
                <li class="flex items-start gap-2">
                  <svg
                    class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg
                  >
                  Affiliate commissions help keep NumanX Tools free and supported. You never pay extra.
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="text-center">
        <div class="rounded-2xl border border-surface bg-surface-1 p-8 md:p-10">
          <h2 class="text-2xl font-black tracking-tight text-primary">Have a Suggestion?</h2>
          <p class="mt-3 text-sm text-tertiary max-w-lg mx-auto leading-relaxed">
            Know a tool or service we should add? We're always looking for great recommendations.
          </p>
          <a
            href="/contact/"
            class="mt-5 inline-flex items-center gap-2 bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm px-6 py-3 rounded-xl transition-all duration-200 hover:-translate-y-0.5 shadow-lg shadow-purple-900/30"
          >
            Suggest a Tool
            <svg
              class="w-4 h-4"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              ><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg
            >
          </a>
        </div>
      </section>
    </div>
  </main>
</MainLayout>
